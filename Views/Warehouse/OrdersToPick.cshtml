@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Orders to Pick";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="content-wrapper warehouse-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Orders to Pick</h2>
            <p class="text-muted mb-0">Step 1: Verify inventory and start picking items from the shelves.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 border border-warning border-opacity-25">
                <i class="fas fa-clock me-2"></i> @Model.Count() Pending Pick
            </span>
            <form asp-action="ReconcileInventory" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Recalculate all reserved quantities?')">
                    <i class="fas fa-sync-alt me-1"></i> Reconcile
                </button>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card data-table py-5 text-center border-0 shadow-sm">
            <div class="opacity-25 mb-3">
                <i class="fas fa-clipboard-check fa-4x text-muted"></i>
            </div>
            <h5 class="fw-bold">All clear! No orders are currently awaiting picking.</h5>
            <p class="small opacity-75">New orders will appear here automatically when accepted by the supplier.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var po in Model)
            {
                <div class="col-12">
                    <div class="card overflow-hidden mb-3">
                        <div class="card-header bg-transparent border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-primary">PO #@po.PONumber</span>
                                <span class="mx-2 text-muted">|</span>
                                <span class="small fw-bold text-theme">@po.Retailer?.BusinessName</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="text-muted smaller">Issued: @po.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                <span class="badge bg-soft-secondary text-primary border border-theme rounded-pill">@po.Status</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="data-table align-middle mb-0">
                                    @if (ViewBag.PicklistFormat == "Minimal")
                                    {
                                        <thead class="bg-soft-secondary smaller text-muted">
                                            <tr>
                                                <th class="ps-4">PRODUCT SUMMARY</th>
                                                <th class="text-end pe-4">QTY</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in po.PurchaseOrderItems)
                                            {
                                                <tr class="border-bottom border-theme">
                                                    <td class="ps-4 py-2 small fw-bold text-theme">@item.Product?.ProductName</td>
                                                    <td class="text-end pe-4 fw-bold text-primary">@item.Quantity @item.Product?.Unit</td>
                                                </tr>
                                            }
                                        </tbody>
                                    }
                                    else if (ViewBag.PicklistFormat == "Summary")
                                    {
                                        <thead class="bg-soft-secondary smaller text-muted">
                                            <tr>
                                                <th class="ps-4">PRODUCT ITEM</th>
                                                <th>UNIT</th>
                                                <th class="text-end pe-4">QTY</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in po.PurchaseOrderItems)
                                            {
                                                <tr class="border-bottom border-theme">
                                                    <td class="ps-4 py-2">
                                                        <div class="fw-bold text-theme mb-0">@item.Product?.ProductName</div>
                                                        <div class="extra-small text-muted">SKU: @item.Product?.Id.ToString("D5")</div>
                                                    </td>
                                                    <td class="small text-muted">@item.Product?.Unit</td>
                                                    <td class="text-end pe-4 fw-bold text-theme">@item.Quantity</td>
                                                </tr>
                                            }
                                        </tbody>
                                    }
                                    else // Detailed
                                    {
                                        <thead class="bg-soft-secondary smaller text-muted">
                                            <tr>
                                                <th class="ps-4">PRODUCT ITEM</th>
                                                <th>SKU</th>
                                                <th>REQUIRED QTY</th>
                                                <th>AVAILABILITY</th>
                                                <th class="text-end pe-4">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in po.PurchaseOrderItems)
                                            {
                                                var reservation = po.InventoryReservations?.FirstOrDefault(r => r.ProductId == item.ProductId);
                                                var activeStatuses = new[] { ReservationStatus.Pending, ReservationStatus.Accepted, ReservationStatus.Confirmed, ReservationStatus.Picking };
                                                var isReserved = reservation != null && activeStatuses.Contains(reservation.Status);
                                                <tr class="border-bottom border-theme">
                                                    <td class="ps-4 py-3">
                                                        <div class="fw-bold text-theme">@item.Product?.ProductName</div>
                                                    </td>
                                                    <td><span class="text-muted small">@item.Product?.Id.ToString("D5")</span></td>
                                                    <td><span class="fw-bold text-theme">@item.Quantity @item.Product?.Unit</span></td>
                                                    <td>
                                                        @if (isReserved)
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">
                                                                <i class="fas fa-check-circle me-1"></i> Stock Reserved
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">
                                                                <i class="fas fa-exclamation-triangle me-1"></i> Not Reserved
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" @(isReserved ? "checked" : "") disabled>
                                                            <label class="form-check-label small text-muted">Verified</label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    }
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-soft-secondary border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <div class="text-muted smaller">
                                <i class="fas fa-info-circle me-1"></i> Confirming "Picked" will move this order to <strong>Packing</strong>.
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">View PO</a>
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@po.Id" />
                                    <input type="hidden" name="status" value="@POStatus.Picked" />
                                    <input type="hidden" name="returnAction" value="OrdersToPick" />
                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm fw-bold">
                                        <i class="fas fa-check-double me-2"></i> Confirm All Picked
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .content-wrapper {
        min-height: 100vh;
        width: 100%;
        padding: 2rem;
        background-color: var(--table-bg);
        color: var(--table-text);
    }

    .card-header {
        background-color: var(--table-header-bg) !important;
        border-bottom: 1px solid var(--table-border) !important;
    }

    .card-footer {
        background-color: var(--table-header-bg) !important;
        border-top: 1px solid var(--table-border) !important;
    }

    .text-primary { color: var(--accent-green) !important; }
    .text-theme { color: var(--table-text) !important; }
    .smaller { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
</style>
