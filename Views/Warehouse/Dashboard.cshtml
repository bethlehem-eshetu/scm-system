@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Warehouse Operational Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var manager = ViewBag.Manager as SCM_System.Models.Entities.SupplierEmployee;
    var warehouse = ViewBag.Warehouse as SCM_System.Models.Entities.Warehouse;
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1 fs-3">Operational Hub: @(warehouse?.Name ?? "Facility")</h2>
            <div class="d-flex align-items-center gap-3">
                <p class="text-muted small mb-0 fw-medium">
                    <i class="fas fa-map-marker-alt text-primary me-1"></i> @(ViewBag.WarehouseLocation ?? $"{warehouse?.City}, {warehouse?.Region}")
                </p>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill border py-2 px-3">
                    <i class="fas fa-barcode me-1"></i> Hub Code: @warehouse?.WarehouseCode
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (manager?.HubAccesses?.Count > 1)
            {
                <a asp-action="Dashboard" asp-route-warehouseId="" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-exchange-alt me-2"></i> Switch Hub
                </a>
            }
            <div class="bg-white border rounded-pill px-3 py-2 shadow-sm d-flex align-items-center">
                <div class="avatar-xs bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                    <i class="fas fa-user-shield" style="font-size: 0.7rem;"></i>
                </div>
                <span class="small fw-bold text-dark">@manager?.User?.FullName</span>
            </div>
            <a asp-action="AddStock" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i> New Stock In
            </a>
        </div>
    </div>

    <!-- 1️⃣ Summary Section Tiles -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 bg-gradient-light">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="fas fa-clipboard-list fs-4"></i>
                        </div>
                        <span class="badge bg-light text-primary border rounded-pill">Hub Load</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.TotalOrders ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Active Purchase Orders</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <i class="fas fa-hourglass-half fs-4"></i>
                        </div>
                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Picking Depth</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.PendingPrep ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Needs Picking/Packing</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="fas fa-box-check fs-4"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Staging Area</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.ReadyForPickup ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Packed & Awaiting Courier</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-info">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="fas fa-truck-moving fs-4"></i>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill">Outbound</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.InProgress ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">In Transit / Delivering</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 2️⃣ Orders Management Section -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Hub Worklist & SLA Tracking</h5>
                    <div class="d-flex gap-2">
                        <div class="input-group input-group-sm" style="width: 200px;">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control bg-light border-0" placeholder="PO # or Retailer...">
                        </div>
                        <a asp-action="OrdersToPick" class="btn btn-sm btn-outline-primary rounded-pill px-3">Full List</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 border-0">
                            <thead class="bg-light text-muted fw-bold" style="font-size: 0.75rem;">
                                <tr>
                                    <th class="ps-4 py-3">PO DETAILS</th>
                                    <th>STATUS</th>
                                    <th>SLA VELOCITY</th>
                                    <th>RETAILER</th>
                                    <th class="text-end pe-4">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var po in Model.OrderByDescending(p => p.CreatedAt).Take(8))
                                {
                                    var timeOpen = DateTime.Now - po.CreatedAt;
                                    var minutesOpen = timeOpen.TotalMinutes;
                                    var slaClass = minutesOpen > 120 ? "danger" : (minutesOpen > 30 ? "warning" : "success");
                                    var slaLabel = minutesOpen < 60 ? $"{(int)minutesOpen}m" : $"{(timeOpen.TotalHours):F1}h";
                                    
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@po.PONumber</div>
                                            <div class="text-muted extra-small">Received @po.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                        </td>
                                        <td>
                                            @{
                                                var (bg, txt) = po.Status switch {
                                                    POStatus.Issued => ("bg-warning-soft", "text-warning"),
                                                    POStatus.Processing => ("bg-primary-soft", "text-primary"),
                                                    POStatus.Picked => ("bg-info-soft", "text-info"),
                                                    POStatus.Packed => ("bg-success-soft", "text-success"),
                                                    POStatus.InTransit => ("bg-info", "text-white"),
                                                    POStatus.Delivered => ("bg-dark", "text-white"),
                                                    _ => ("bg-light", "text-muted")
                                                };
                                            }
                                            <span class="badge @bg @txt rounded-pill px-3">@po.Status</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-@slaClass me-2" style="width: 8px; height: 8px;" title="SLA Intensity"></div>
                                                <div class="small fw-bold @(slaClass == "danger" ? "text-danger" : "")">@slaLabel</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-bold small">@po.Retailer?.BusinessName</div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-light rounded-circle shadow-sm" title="View Details">
                                                    <i class="fas fa-eye text-primary"></i>
                                                </a>
                                                @if (po.Status == POStatus.Issued || po.Status == POStatus.Accepted || po.Status == POStatus.Picking) 
                                                {
                                                    var nextStatus = po.Status == POStatus.Picking ? POStatus.Picked : POStatus.Picking;
                                                    var btnIcon = po.Status == POStatus.Picking ? "fa-check-double" : "fa-hand-holding-box";
                                                    var btnTitle = po.Status == POStatus.Picking ? "Mark as Picked" : "Start Picking";
                                                    var btnClass = po.Status == POStatus.Picking ? "text-info" : "text-warning";

                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@po.Id" />
                                                        <input type="hidden" name="status" value="@nextStatus" />
                                                        <input type="hidden" name="returnAction" value="Dashboard" />
                                                        <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm" title="@btnTitle">
                                                            <i class="fas @btnIcon @btnClass"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3️⃣ Stock & Fleet Summary -->
        <div class="col-lg-4">
            <!-- Reserved Stock Summary -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-top border-4 border-primary">
                <div class="card-header bg-white border-0 py-4 px-4 border-start border-4 border-primary">
                    <h6 class="fw-bold mb-0">Inventory Capacity & Reserved Stock</h6>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="d-flex align-items-center justify-content-between mb-2 pt-3">
                        <div class="text-muted small">Hub Utilization</div>
                        <div class="fw-bold fs-5 text-primary">
                            @{
                                double capUsed = warehouse?.MaxCapacity > 0 ? (double)(ViewBag.TotalOnHand ?? 0) / warehouse.MaxCapacity * 100 : 0;
                            }
                            @capUsed.ToString("F0")%
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="text-muted small">Total Committed Items</div>
                        <div class="fw-bold fs-5 text-primary">@(ViewBag.TotalReserved ?? 0)</div>
                    </div>
                    <div class="progress mb-4" style="height: 10px; border-radius: 5px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar @(capUsed > 85 ? "bg-danger" : "bg-primary")" style="width: @capUsed%;"></div>
                    </div>
                    <div class="row text-center g-2 mb-4">
                        <div class="col-6 border-end">
                            <h4 class="fw-bold mb-0">@(ViewBag.TotalOnHand ?? 0)</h4>
                            <span class="text-muted smaller">Units On Hand</span>
                        </div>
                        <div class="col-6">
                            <h4 class="fw-bold mb-0 @((ViewBag.LowStockAlertCount ?? 0) > 0 ? "text-danger" : "text-success")">@(ViewBag.LowStockAlertCount ?? 0)</h4>
                            <span class="text-muted smaller">Replenish Alerts</span>
                        </div>
                    </div>
                    <a asp-action="Inventory" class="btn btn-outline-primary w-100 rounded-pill fw-bold small">Manage Inventory</a>
                </div>
            </div>

            <!-- Quick Stats: Fleet & Staff -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4">Logistics Resources</h6>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-truck fa-sm"></i>
                                </div>
                                <span class="small fw-bold">Available Fleet</span>
                            </div>
                            <span class="badge bg-light text-dark rounded-pill border">@(ViewBag.AvailableVehicles ?? 0) Units</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user-tie fa-sm"></i>
                                </div>
                                <span class="small fw-bold">Active Agents</span>
                            </div>
                            <span class="badge bg-light text-dark rounded-pill border">@(ViewBag.ActiveAgents ?? 0) Online</span>
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded-4 d-flex align-items-center">
                        <div class="me-3 fs-3 text-primary opacity-50">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div class="smaller text-muted fw-normal">
                            All resources are currently synced with the supplier's main pool.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hub Operational Log (Audit-Driven) -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="fas fa-history me-2"></i> Hub Activity Log</h6>
                    <span class="badge bg-primary">Live</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                        @if (ViewBag.RecentLogs != null && ((IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.RecentLogs).Any())
                        {
                            @foreach (var log in (IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.RecentLogs)
                            {
                                <div class="list-group-item p-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-bold small text-primary">@log.ActionType</span>
                                        <span class="text-muted extra-small">@log.PerformedAtUtc.ToLocalTime().ToString("HH:mm")</span>
                                    </div>
                                    <p class="text-muted mb-0 extra-small">@log.Notes</p>
                                    <div class="mt-1 extra-small text-info">
                                        <i class="fas fa-check-double me-1"></i> Hub Verified
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-list fa-2x mb-2 opacity-25"></i>
                                <p class="small">No hub activity recorded yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    
    .smaller { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.75rem; }
</style>
