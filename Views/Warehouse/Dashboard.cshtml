@model SCM_System.Models.Entities.SupplierEmployee

@{
    ViewData["Title"] = "Warehouse Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="glass-panel p-4 mb-4 position-relative overflow-hidden" style="background: var(--hero-bg);">
        <div class="animated-bg" style="opacity: 0.05;"></div>
        <div class="position-relative z-index-1">
            <h1 class="text-white mb-1 fw-bold">Warehouse Operations</h1>
            <p class="text-white-50 mb-0">Managing @Model.Supplier.CompanyName | @Model.User.FullName</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">Total Items</p>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalWarehouseItems</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="fas fa-boxes fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">Low Stock Alerts</p>
                        <h3 class="fw-bold mb-0 text-danger">@ViewBag.LowStockCount</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger text-opacity-75">
                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">Pending Orders</p>
                        <h3 class="fw-bold mb-0">@ViewBag.PendingOrders</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">System Health</p>
                        <h3 class="fw-bold mb-0">Optimal</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="fas fa-heartbeat fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Stock Levels & Inventory -->
        <div class="col-lg-8">
            <div class="glass-card h-100">
                <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary"><i class="fas fa-list me-2"></i>Inventory Overview</h6>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</button>
                </div>
                <div class="p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light opacity-75">
                                <tr>
                                    <th>Item Name</th>
                                    <th>Warehouse</th>
                                    <th>Stock Level</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="border-transparent">
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fas fa-info-circle me-2"></i> Fetching real-time inventory levels...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Alerts -->
        <div class="col-lg-4">
            <div class="glass-card mb-4">
                <div class="p-4 border-bottom border-light">
                    <h6 class="mb-0 fw-bold text-warning"><i class="fas fa-bolt me-2"></i>Quick Tasks</h6>
                </div>
                <div class="p-4">
                    <div class="list-group list-group-flush">
                        <button class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary me-3">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-semibold small">Generate Picking List</h6>
                                <p class="mb-0 text-muted tiny">For pending retailer orders</p>
                            </div>
                            <i class="fas fa-chevron-right ms-auto text-muted small"></i>
                        </button>
                        <button class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 p-2 rounded-3 text-success me-3">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-semibold small">Verify Packing Status</h6>
                                <p class="mb-0 text-muted tiny">Check items ready for shipping</p>
                            </div>
                            <i class="fas fa-chevron-right ms-auto text-muted small"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="glass-card h-100">
                <div class="p-4 border-bottom border-light">
                    <h6 class="mb-0 fw-bold text-danger"><i class="fas fa-bell me-2"></i>Low Stock Alerts</h6>
                </div>
                <div class="p-4">
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-0 rounded-4 text-danger mb-0">
                        <div class="d-flex">
                            <i class="fas fa-info-circle mt-1 me-2"></i>
                            <p class="small mb-0 fw-medium">You have @ViewBag.LowStockCount items below critical threshold. Please initiate restocking.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
