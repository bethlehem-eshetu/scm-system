@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Warehouse Operational Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var manager = ViewBag.Manager as SCM_System.Models.Entities.SupplierEmployee;
    var warehouse = ViewBag.Warehouse as SCM_System.Models.Entities.Warehouse;
}

<div class="container-fluid py-4 pb-5 px-4">
    <!-- Premium Operational Header (SCM Style) -->
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-premium border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1a3d31 0%, #0a2e24 100%);">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-lg-7 mb-4 mb-lg-0 text-white">
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#" class="text-white text-opacity-50 text-decoration-none small fw-bold text-uppercase tracking-widest">Warehouse</a></li>
                                <li class="breadcrumb-item active small fw-bold text-uppercase tracking-widest text-white" aria-current="page">Dashboard</li>
                            </ol>
                        </nav>
                        <h1 class="display-5 fw-bold mb-2">
                            Operational <span class="text-accent-green">Hub</span>
                        </h1>
                        <p class="text-white text-opacity-75 mb-0 fs-5">
                            <i class="fas fa-warehouse me-2 text-accent-green"></i>Facility: @(warehouse?.Name ?? "Main Hub")
                            <span class="mx-2 opacity-25">|</span>
                            <i class="fas fa-user-shield me-2 text-success"></i>Manager: @manager?.User?.FullName
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            @if (manager?.HubAccesses?.Count > 1)
                            {
                                <a asp-action="Dashboard" asp-route-warehouseId="" class="btn btn-glass px-4 py-3 fw-bold d-flex align-items-center gap-3">
                                    <div class="btn-icon bg-white bg-opacity-10 rounded-3">
                                        <i class="fas fa-exchange-alt text-white"></i>
                                    </div>
                                    <div class="text-start">
                                        <div class="extra-small text-white text-opacity-50 text-uppercase">Logistics</div>
                                        <div class="text-white">Switch Hub</div>
                                    </div>
                                </a>
                            }
                            <a asp-action="AddStock" class="btn btn-accent-green px-4 py-3 fw-bold d-flex align-items-center gap-3 shadow-lg border-0" style="color: #1a3d31;">
                                <div class="btn-icon bg-black bg-opacity-10 rounded-3">
                                    <i class="fas fa-plus"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-black text-opacity-50 text-uppercase">Inventory</div>
                                    <div class="text-black">New Stock In</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main KPI Grid (SCM Style) -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-faint-green p-3 rounded-4 text-dark-green">
                            <i class="fas fa-clipboard-list fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Hub Load</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@(ViewBag.TotalOrders ?? 0)</h3>
                        </div>
                    </div>
                    <p class="x-small text-muted mb-0 fw-bold">Active Purchase Orders</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-warning p-3 rounded-4 text-warning">
                            <i class="fas fa-hourglass-half fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Picking Depth</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@(ViewBag.PendingPrep ?? 0)</h3>
                        </div>
                    </div>
                    <p class="x-small text-warning mb-0 fw-bold">Needs Picking/Packing</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-success p-3 rounded-4 text-success">
                            <i class="fas fa-check-circle fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Staging Area</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@(ViewBag.ReadyForPickup ?? 0)</h3>
                        </div>
                    </div>
                    <p class="x-small text-success mb-0 fw-bold">Awaiting Courier</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-info p-3 rounded-4 text-info">
                            <i class="fas fa-truck-moving fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Outbound</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@(ViewBag.InProgress ?? 0)</h3>
                        </div>
                    </div>
                    <p class="x-small text-info mb-0 fw-bold">In Transit / Delivering</p>
                </div>
            </div>
        </div>
    </div>


    <div class="row g-4 mb-5">
        <!-- Hub Worklist Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
                <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark-green">Hub Worklist</h5>
                        <p class="x-small text-muted mb-0">SLA velocity and operational priority</p>
                    </div>
                    <a asp-action="OrdersToPick" class="btn btn-faint-green text-dark-green rounded-pill px-4 py-2 fw-bold small">Full List</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="bg-faint-green">
                            <tr>
                                <th class="ps-4 py-3 text-muted x-small text-uppercase fw-bold ls-1">PO Details</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Status</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">SLA Velocity</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Retailer</th>
                                <th class="pe-4 py-3 text-muted x-small text-uppercase fw-bold ls-1 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var po in Model.OrderByDescending(p => p.CreatedAt).Take(8))
                                {
                                    var timeOpen = DateTime.Now - po.CreatedAt;
                                    var minutesOpen = timeOpen.TotalMinutes;
                                    var slaClass = minutesOpen > 120 ? "danger" : (minutesOpen > 30 ? "warning" : "success");
                                    var slaLabel = minutesOpen < 60 ? $"{(int)minutesOpen}m" : $"{(timeOpen.TotalHours):F1}h";
                                    
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="fw-bold text-dark-green">#@po.PONumber</div>
                                            <div class="x-small text-muted">@po.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                        </td>
                                        <td>
                                            @{
                                                var (badgeStyle, textColor) = po.Status switch {
                                                    POStatus.Issued => ("bg-soft-warning", "text-warning"),
                                                    POStatus.Processing => ("bg-soft-primary", "text-primary"),
                                                    POStatus.Picked => ("bg-soft-info", "text-info"),
                                                    POStatus.Packed => ("bg-soft-success", "text-success"),
                                                    POStatus.InTransit => ("bg-soft-primary", "text-primary"),
                                                    POStatus.Delivered => ("bg-soft-dark", "text-dark-green"),
                                                    _ => ("bg-soft-secondary", "text-secondary")
                                                };
                                            }
                                            <span class="status-badge @badgeStyle @textColor">@po.Status</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-@slaClass" style="width: 8px; height: 8px;"></div>
                                                <div class="small fw-bold @(slaClass == "danger" ? "text-danger" : "text-dark-green")">@slaLabel</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-bold small text-dark-green">@po.Retailer?.BusinessName</div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-faint-green text-dark-green rounded-circle" style="width: 32px; height: 32px; padding: 0;">
                                                    <i class="fas fa-eye x-small"></i>
                                                </a>
                                                @if (po.Status == POStatus.Issued || po.Status == POStatus.Accepted || po.Status == POStatus.Picking) 
                                                {
                                                    var nextStatus = po.Status == POStatus.Picking ? POStatus.Picked : POStatus.Picking;
                                                    var btnIcon = po.Status == POStatus.Picking ? "fa-check-double" : "fa-hand-holding-box";
                                                    var btnClass = po.Status == POStatus.Picking ? "text-info" : "text-warning";

                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@po.Id" />
                                                        <input type="hidden" name="status" value="@nextStatus" />
                                                        <input type="hidden" name="returnAction" value="Dashboard" />
                                                        <button type="submit" class="btn btn-faint-green text-dark-green rounded-circle" style="width: 32px; height: 32px; padding: 0;">
                                                            <i class="fas @btnIcon x-small"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar Insights -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Inventory Capacity Card -->
                <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                    <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Hub Utilization</h6>
                    @{
                        double capUsed = warehouse?.MaxCapacity > 0 ? (double)(ViewBag.TotalOnHand ?? 0) / warehouse.MaxCapacity * 100 : 0;
                    }
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <div class="display-6 fw-bold text-dark-green">@capUsed.ToString("F0")%</div>
                        <div class="text-end text-dark-green">
                            <div class="small fw-bold">@(ViewBag.TotalOnHand ?? 0) Units</div>
                            <div class="extra-small opacity-75">of @(warehouse?.MaxCapacity ?? 0) capacity</div>
                        </div>
                    </div>
                    <div class="progress rounded-pill bg-faint-green mb-4" style="height: 10px;">
                        <div class="progress-bar @(capUsed > 85 ? "bg-danger" : "bg-dark-green") rounded-pill" style="width: @capUsed%;"></div>
                    </div>
                    <div class="p-3 bg-soft-danger rounded-4 d-flex justify-content-between align-items-center">
                        <div class="small fw-bold text-danger">Low Stock Alerts</div>
                        <div class="badge bg-danger rounded-pill">@(ViewBag.LowStockAlertCount ?? 0)</div>
                    </div>
                    <a asp-action="Inventory" class="btn btn-dark-green w-100 py-2 mt-4 fw-bold rounded-pill">Manage Inventory</a>
                </div>

                <!-- Logistics Resources -->
                <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                    <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Logistics Pool</h6>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-faint-green border border-faint">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white text-dark-green p-2 rounded-3 shadow-sm">
                                    <i class="fas fa-truck small"></i>
                                </div>
                                <div class="fw-bold small text-dark-green">Available Fleet</div>
                            </div>
                            <div class="fw-bold text-dark-green small">@(ViewBag.AvailableVehicles ?? 0) Units</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-faint-green border border-faint">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white text-success p-2 rounded-3 shadow-sm">
                                    <i class="fas fa-user-tie small"></i>
                                </div>
                                <div class="fw-bold small text-dark-green">Active Agents</div>
                            </div>
                            <div class="fw-bold text-dark-green small">@(ViewBag.ActiveAgents ?? 0) Online</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-faint-green { background-color: var(--faint-green); color: var(--dark-green); border: none; }

        .welcome-banner { position: relative; border-radius: 40px !important; }
        .banner-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.05; z-index: 1; }
        .banner-glow { position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(212, 240, 109, 0.1) 0%, transparent 70%); filter: blur(50px); z-index: 1; }
        .btn-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); color: white; border-radius: 20px; transition: all 0.3s; }
        .btn-glass:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }
        .tracking-widest { letter-spacing: 2px; }

        .status-badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }

        .animate-slide-up { animation: slideUp 0.6s ease-out; }
        @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
    </style>
}
