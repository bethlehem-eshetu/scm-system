@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Warehouse Operational Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var manager = ViewBag.Manager as SCM_System.Models.Entities.SupplierEmployee;
    var warehouse = ViewBag.Warehouse as SCM_System.Models.Entities.Warehouse;
}

<div class="container-fluid px-4 py-4">
    <!-- 1. Operational Hub Card -->
    <div class="operational-hub-card shadow-premium">
        <div class="p-2">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-10 text-white p-3 rounded-3 me-3">
                        <i class="fas fa-building fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-white">Operational Hub</h5>
                        <p class="text-white text-opacity-75 small mb-0 text-uppercase ls-1 fw-bold">Live System Status</p>
                    </div>
                </div>
                <div class="d-flex gap-5 flex-wrap">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-warehouse me-2 text-white fs-5 opacity-75"></i>
                        <div>
                            <div class="extra-small text-white text-opacity-50 text-uppercase fw-bold">Facility</div>
                            <div class="fw-bold text-white">@(warehouse?.Name ?? "Main Hub")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-shield me-2 text-white fs-5 opacity-75"></i>
                        <div>
                            <div class="extra-small text-white text-opacity-50 text-uppercase fw-bold">Active Manager</div>
                            <div class="fw-bold text-white">@manager?.User?.FullName</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. KPI Grid (4 Columns) -->
    <div class="row g-4 mb-4">
        <!-- Hub Load -->
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-4 h-100 theme-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-soft-primary p-3 rounded-3 text-primary">
                            <i class="fas fa-clipboard-list fs-4"></i>
                        </div>
                        <span class="badge bg-soft-primary text-primary rounded-pill px-3">Live</span>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark-green">@(ViewBag.TotalOrders ?? 0)</h3>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Hub Load</p>
                </div>
            </div>
        </div>
        <!-- Picking Depth -->
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-4 h-100 theme-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-soft-warning p-3 rounded-3 text-warning">
                            <i class="fas fa-hourglass-half fs-4"></i>
                        </div>
                        <span class="badge bg-soft-warning text-warning rounded-pill px-3">Pending</span>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark-green">@(ViewBag.PendingPrep ?? 0)</h3>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Picking Depth</p>
                </div>
            </div>
        </div>
        <!-- Staging Area -->
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-4 h-100 theme-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-soft-success p-3 rounded-3 text-success">
                            <i class="fas fa-check-circle fs-4"></i>
                        </div>
                        <span class="badge bg-soft-success text-success rounded-pill px-3">Ready</span>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark-green">@(ViewBag.ReadyForPickup ?? 0)</h3>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Staging Area</p>
                </div>
            </div>
        </div>
        <!-- Outbound -->
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-4 h-100 theme-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-soft-info p-3 rounded-3 text-info">
                            <i class="fas fa-truck-moving fs-4"></i>
                        </div>
                        <span class="badge bg-soft-info text-info rounded-pill px-3">Transit</span>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark-green">@(ViewBag.InProgress ?? 0)</h3>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Outbound</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Worklist Table Card -->
    <div class="card border-0 shadow-premium rounded-4 mb-4 theme-card">
        <div class="card-header bg-transparent border-0 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-dark-green">Hub Worklist</h5>
                    <p class="text-muted small mb-0">SLA velocity and operational priority</p>
                </div>
                <a asp-action="OrdersToPick" class="btn btn-faint-green text-dark-green rounded-pill px-4 fw-bold small">View All</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-faint-green border-0">
                    <tr>
                        <th class="ps-4 py-3 text-muted x-small text-uppercase fw-bold ls-1">PO Details</th>
                        <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Status</th>
                        <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">SLA Velocity</th>
                        <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Retailer</th>
                        <th class="pe-4 py-3 text-muted x-small text-uppercase fw-bold ls-1 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var po in Model.OrderByDescending(p => p.CreatedAt).Take(8))
                        {
                            var timeOpen = DateTime.Now - po.CreatedAt;
                            var minutesOpen = timeOpen.TotalMinutes;
                            var slaClass = minutesOpen > 120 ? "danger" : (minutesOpen > 30 ? "warning" : "success");
                            var slaLabel = minutesOpen < 60 ? $"{(int)minutesOpen}m" : $"{(timeOpen.TotalHours):F1}h";
                            
                            <tr>
                                <td class="ps-4 py-4">
                                    <div class="fw-bold text-dark-green">#@po.PONumber</div>
                                    <div class="extra-small text-muted">@po.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                </td>
                                <td>
                                    @{
                                        var (badgeStyle, textColor) = po.Status switch {
                                            POStatus.Issued => ("bg-soft-warning", "text-warning"),
                                            POStatus.Processing => ("bg-soft-primary", "text-primary"),
                                            POStatus.Picked => ("bg-soft-info", "text-info"),
                                            POStatus.Packed => ("bg-soft-success", "text-success"),
                                            POStatus.InTransit => ("bg-soft-primary", "text-primary"),
                                            POStatus.Delivered => ("bg-soft-dark", "text-dark-green"),
                                            _ => ("bg-soft-secondary", "text-secondary")
                                        };
                                    }
                                    <span class="status-badge @badgeStyle @textColor">@po.Status</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-@slaClass" style="width: 8px; height: 8px;"></div>
                                        <div class="small fw-bold @(slaClass == "danger" ? "text-danger" : "text-dark-green")">@slaLabel</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold small text-dark-green">@po.Retailer?.BusinessName</div>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-faint-green text-dark-green rounded-circle" style="width: 32px; height: 32px; padding: 0; line-height: 32px;">
                                        <i class="fas fa-eye x-small"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">No active orders in the worklist.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. Bottom Row: Resources & Alerts -->
    <div class="row g-4">
        <!-- Logistics Resources -->
        <div class="col-md-6">
            <div class="card border-0 shadow-premium rounded-4 p-4 available-fleet-card theme-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold mb-0 text-dark-green text-uppercase ls-1">Available Fleet</h6>
                    <i class="fas fa-truck text-accent-green fs-5"></i>
                </div>
                <div class="p-3 rounded-4 bg-faint-green theme-aware border border-faint d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark-green">Active Fleet Units</div>
                    <div class="display-6 fw-bold text-dark-green">@(ViewBag.AvailableVehicles ?? 0)</div>
                </div>
            </div>
        </div>
        <!-- Inventory Management -->
        <div class="col-md-6">
            <div class="card border-0 shadow-premium rounded-4 p-4 inventory-alert-card theme-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold mb-0 text-dark-green text-uppercase ls-1">Low Stock Alerts</h6>
                    <i class="fas fa-exclamation-triangle text-danger fs-5"></i>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="p-3 bg-soft-danger rounded-4 flex-grow-1 me-3">
                        <span class="fw-bold text-danger">@(ViewBag.LowStockAlertCount ?? 0) Critical Items</span>
                    </div>
                    <a asp-action="Inventory" class="btn btn-dark-green px-4 py-2 rounded-pill fw-bold">Manage Inventory</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }
        .extra-small { font-size: 0.65rem; }
        .status-badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
    </style>
}
