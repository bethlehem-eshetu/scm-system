@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Warehouse Operational Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var manager = ViewBag.Manager as SCM_System.Models.Entities.SupplierEmployee;
    var warehouse = ViewBag.Warehouse as SCM_System.Models.Entities.Warehouse;
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0 fs-3">@(ViewBag.Warehouse?.Name ?? "Warehouse")</h2>
            <p class="text-muted small mb-0 fw-medium">
                <i class="fas fa-map-marker-alt text-primary me-1"></i> @(ViewBag.WarehouseLocation)
            </p>
        </div>
        <div class="d-flex gap-2">
            <div class="bg-white border rounded-pill px-3 py-2 shadow-sm d-flex align-items-center">
                <div class="avatar-xs bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                    <i class="fas fa-user-shield" style="font-size: 0.7rem;"></i>
                </div>
                <span class="small fw-bold text-dark">@manager?.User?.FullName</span>
            </div>
            <a asp-action="AddStock" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i> New Stock In
            </a>
        </div>
    </div>

    <!-- 1️⃣ Summary Section Tiles -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 bg-gradient-light">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="fas fa-clipboard-list fs-4"></i>
                        </div>
                        <span class="badge bg-light text-primary border rounded-pill">Total Assigned</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.TotalOrders ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Active Purchase Orders</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <i class="fas fa-hourglass-half fs-4"></i>
                        </div>
                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Awaiting Prep</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.PendingPrep ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Needs Picking/Packing</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="fas fa-box-check fs-4"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Ready for Pickup</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.ReadyForPickup ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">Awaiting Courier</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden border-start border-4 border-info">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="fas fa-truck-moving fs-4"></i>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill">In Logistics</span>
                    </div>
                    <h2 class="fw-bold mb-1">@(ViewBag.InProgress ?? 0)</h2>
                    <p class="text-muted smaller mb-0 fw-bold">In Transit / Delivering</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 2️⃣ Orders Management Section -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Assigned Orders Worklist</h5>
                    <div class="d-flex gap-2">
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control bg-light border-0" placeholder="Search PO # or Retailer...">
                        </div>
                        <a asp-action="OrdersToPick" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Full List</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 border-0">
                            <thead class="bg-light text-muted fw-bold" style="font-size: 0.75rem;">
                                <tr>
                                    <th class="ps-4 py-3">PO NUMBER</th>
                                    <th>RETAILER</th>
                                    <th>LOCATION</th>
                                    <th>STATUS</th>
                                    <th>DELIVERY DATE</th>
                                    <th class="text-end pe-4">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var po in Model.OrderByDescending(p => p.CreatedAt).Take(8))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@po.PONumber</div>
                                            <div class="text-muted extra-small">@po.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@po.Retailer?.BusinessName</div>
                                            <div class="text-muted extra-small">@po.PurchaseOrderItems.Count Items</div>
                                        </td>
                                        <td><div class="text-muted small">@po.Order?.DeliveryAddress?.Split(',')[0]</div></td>
                                        <td>
                                            @{
                                                var (bg, txt) = po.Status switch {
                                                    POStatus.Issued => ("bg-warning-soft", "text-warning"),
                                                    POStatus.Processing => ("bg-primary-soft", "text-primary"),
                                                    POStatus.Picked => ("bg-info-soft", "text-info"),
                                                    POStatus.Packed => ("bg-success-soft", "text-success"),
                                                    POStatus.InTransit => ("bg-info", "text-white"),
                                                    POStatus.Delivered => ("bg-dark", "text-white"),
                                                    _ => ("bg-light", "text-muted")
                                                };
                                            }
                                            <span class="badge @bg @txt rounded-pill px-3">@po.Status</span>
                                        </td>
                                        <td><div class="small fw-bold">@po.Order?.ExpectedDeliveryDate?.ToString("MMM dd")</div></td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-light rounded-circle shadow-sm" title="View Details">
                                                    <i class="fas fa-eye text-primary"></i>
                                                </a>
                                                @if (po.Status == POStatus.Issued || po.Status == POStatus.Accepted) 
                                                {
                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@po.Id" />
                                                        <input type="hidden" name="status" value="@POStatus.Processing" />
                                                        <input type="hidden" name="returnAction" value="Dashboard" />
                                                        <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Start Picking">
                                                            <i class="fas fa-hand-holding-box text-warning"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3️⃣ Stock & Fleet Summary -->
        <div class="col-lg-4">
            <!-- Reserved Stock Summary -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 border-start border-4 border-primary">
                    <h6 class="fw-bold mb-0">Reserved Stock Summary</h6>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="d-flex align-items-center justify-content-between mb-3 pt-3">
                        <div class="text-muted small">Total Committed Items</div>
                        <div class="fw-bold fs-5 text-primary">@(ViewBag.TotalReserved ?? 0)</div>
                    </div>
                    <div class="progress mb-4" style="height: 10px; border-radius: 5px; background: rgba(0,0,0,0.05);">
                        @{
                            double reserveRatio = ViewBag.TotalOnHand > 0 ? (double)ViewBag.TotalReserved / ViewBag.TotalOnHand * 100 : 0;
                        }
                        <div class="progress-bar bg-primary" style="width: @(reserveRatio)%;"></div>
                    </div>
                    <div class="row text-center g-2 mb-4">
                        <div class="col-6 border-end">
                            <h4 class="fw-bold mb-0">@(ViewBag.TotalOnHand ?? 0)</h4>
                            <span class="text-muted smaller">On Hand</span>
                        </div>
                        <div class="col-6">
                            <h4 class="fw-bold mb-0 @((ViewBag.LowStockAlertCount ?? 0) > 0 ? "text-danger" : "text-success")">@(ViewBag.LowStockAlertCount ?? 0)</h4>
                            <span class="text-muted smaller">Low Stock Alerts</span>
                        </div>
                    </div>
                    <a asp-action="Inventory" class="btn btn-outline-primary w-100 rounded-pill fw-bold small">Manage Inventory</a>
                </div>
            </div>

            <!-- Quick Stats: Fleet & Staff -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4">Logistics Resources</h6>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-truck fa-sm"></i>
                                </div>
                                <span class="small fw-bold">Available Fleet</span>
                            </div>
                            <span class="badge bg-light text-dark rounded-pill border">@(ViewBag.AvailableVehicles ?? 0) Units</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user-tie fa-sm"></i>
                                </div>
                                <span class="small fw-bold">Active Agents</span>
                            </div>
                            <span class="badge bg-light text-dark rounded-pill border">@(ViewBag.ActiveAgents ?? 0) Online</span>
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded-4 d-flex align-items-center">
                        <div class="me-3 fs-3 text-primary opacity-50">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div class="smaller text-muted fw-normal">
                            All resources are currently synced with the supplier's main pool.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications / Recent Updates -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white border-0 py-3 px-4">
                    <h6 class="fw-bold mb-0"><i class="fas fa-bell me-2"></i> Recent Activity</h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var alert in (ViewBag.RecentAlerts as List<SCM_System.Models.Entities.PurchaseOrder>))
                        {
                            <div class="list-group-item p-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold small">PO #@alert.PONumber</span>
                                    <span class="text-muted extra-small">@alert.UpdatedAt.ToString("HH:mm")</span>
                                </div>
                                <p class="text-muted mb-0 extra-small">Status transitioned to <strong>@alert.Status</strong> for @alert.Retailer?.BusinessName</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    
    .smaller { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.75rem; }
</style>
