@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Account & Operational Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-5">
    <div class="row mb-4">
        <div class="col-12 text-center text-lg-start">
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-sliders-h me-2 text-primary"></i> Control Center</h2>
            <p class="text-muted">Manage your personal identity, security protocols, and warehouse logic.</p>
        </div>
    </div>

    <form asp-action="OperationalSettings" method="post" id="settingsForm">
        <input type="hidden" asp-for="EmployeeId" />
        
        <div class="row g-4 justify-content-center">
            <!-- Section 3: Operations -->
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden border-top border-warning border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light d-flex align-items-center">
                        <div class="icon-box bg-warning-soft text-warning me-3 rounded-3 p-2">
                            <i class="fas fa-warehouse fa-lg"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Operations</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="DefaultWarehouseLocation" class="form-label small fw-bold text-muted" data-bs-toggle="tooltip" title="Default rack/zone for incoming inventory"></label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-map-pin text-muted"></i></span>
                                <input asp-for="DefaultWarehouseLocation" class="form-control bg-light border-0" placeholder="e.g. Zone A, Rack 01" />
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label asp-for="LowStockThreshold" class="form-label small fw-bold text-muted" data-bs-toggle="tooltip" title="Alert trigger quantity"></label>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                    <input asp-for="LowStockThreshold" type="number" class="form-control bg-light border-0 text-center fw-bold" />
                                </div>
                            </div>
                            <div class="col-6">
                                <label asp-for="PicklistFormat" class="form-label small fw-bold text-muted" data-bs-toggle="tooltip" title="Picking sheet layout"></label>
                                <select asp-for="PicklistFormat" class="form-select bg-light border-0 shadow-sm rounded-3">
                                    <option value="Detailed">Detailed</option>
                                    <option value="Summary">Summary</option>
                                    <option value="Minimal">Minimal</option>
                                </select>
                            </div>
                        </div>

                        <div class="automation-switches p-3 bg-light rounded-4 border border-white">
                            <div class="form-check form-switch mb-3 custom-switch d-flex justify-content-between align-items-center ps-0">
                                <div class="switch-label">
                                    <label asp-for="AutoAcceptPickTasks" class="form-check-label small fw-bold d-block"></label>
                                    <span class="extra-small text-muted" data-bs-toggle="tooltip" title="Advance orders to Pick instantly">Autonomous Picking</span>
                                </div>
                                <input asp-for="AutoAcceptPickTasks" class="form-check-input" type="checkbox" role="switch">
                            </div>
                            <div class="form-check form-switch custom-switch d-flex justify-content-between align-items-center ps-0">
                                <div class="switch-label">
                                    <label asp-for="NotifyLowStock" class="form-check-label small fw-bold d-block"></label>
                                    <span class="extra-small text-muted" data-bs-toggle="tooltip" title="Live dashboard push alerts">Stock Watcher</span>
                                </div>
                                <input asp-for="NotifyLowStock" class="form-check-input" type="checkbox" role="switch">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12 text-center text-lg-end">
                <a asp-action="Dashboard" class="btn btn-link text-muted text-decoration-none fw-bold me-4" id="discardBtn">Discard Changes</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg hvr-grow" id="saveBtn">
                    <i class="fas fa-cloud-upload-alt me-2"></i> Deploy Preferences
                </button>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .profile-preview-circle { transition: transform 0.3s ease; }
        .profile-upload-wrapper:hover .profile-preview-circle { transform: scale(1.02); }
        .bg-primary-soft { background-color: rgba(13, 110, 253, 0.08); }
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.08); }
        .bg-warning-soft { background-color: rgba(255, 193, 7, 0.08); }
        .extra-small { font-size: 0.72rem; }
        .custom-switch .form-check-input { width: 3em; height: 1.5em; cursor: pointer; margin-left: 0; }
        .form-control:focus, .form-select:focus { background-color: #fff !important; border: 1px solid var(--bs-primary) !important; box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.05) !important; }
        .hvr-grow { transition: transform .2s ease-in-out; }
        .hvr-grow:hover { transform: scale(1.05); }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        // 1. Tooltips Initialization
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        const tooltipList = tooltipTriggerList.map(t => new bootstrap.Tooltip(t));

        // 2. Profile Image Preview
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#profileImagePreview').html(`<img src="${e.target.result}" class="img-fluid h-100 w-100 object-fit-cover" />`);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 3. Password Strength Meter
        $('#newPasswordInput').on('input', function() {
            const val = $(this).val();
            const wrapper = $('#passwordStrengthWrapper');
            if (val.length === 0) {
                wrapper.hide();
                return;
            }
            wrapper.show();

            const strength = calculateStrength(val);
            const meter = $('#strengthMeter');
            const text = $('#strengthText');

            meter.css('width', strength.percent + '%');
            meter.removeClass('bg-danger bg-warning bg-success');
            meter.addClass(strength.class);
            text.text(strength.label).removeClass('text-danger text-warning text-success').addClass('text-' + strength.class.replace('bg-', ''));
        });

        function calculateStrength(p) {
            let score = 0;
            if (p.length >= 6) score++;
            if (p.length >= 10) score++;
            if (/[A-Z]/.test(p)) score++;
            if (/[0-9]/.test(p)) score++;
            if (/[^A-Za-z0-9]/.test(p)) score++;

            if (score <= 2) return { percent: 33, class: 'bg-danger', label: 'Weak Protocol' };
            if (score <= 4) return { percent: 66, class: 'bg-warning', label: 'Medium Protocol' };
            return { percent: 100, class: 'bg-success', label: 'Optimum Protocol' };
        }

        // 4. Unsaved Changes Warning
        let isDirty = false;
        $('#settingsForm input, #settingsForm select').on('change input', function() {
            isDirty = true;
        });

        $(window).on('beforeunload', function() {
            if (isDirty) return "You have unsaved changes!";
        });

        $('#settingsForm').on('submit', function() {
            isDirty = false;
        });

        // 5. Toastr Notifications
        toastr.options = { 
            "closeButton": true, 
            "progressBar": true, 
            "positionClass": "toast-bottom-right",
            "timeOut": "5000"
        };
        
        @if (TempData["SuccessMessage"] != null)
        {
            <text>toastr.success('@TempData["SuccessMessage"]');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>toastr.error('@TempData["ErrorMessage"]');</text>
        }
    </script>
}
