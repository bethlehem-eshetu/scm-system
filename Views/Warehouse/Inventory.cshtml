@model IEnumerable<SCM_System.Models.Entities.Inventory>
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Inventory Management</h2>
            <p class="text-muted mb-0">Live stock monitoring and allocation tracking for @ViewBag.WarehouseName</p>
        </div>
        <div class="d-flex gap-2">
            <div class="bg-white border rounded-pill px-3 py-2 shadow-sm d-flex align-items-center">
                <span class="small fw-bold text-muted me-2 text-uppercase">Total Skus:</span>
                <span class="small fw-bold text-primary">@Model.Count()</span>
            </div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#auditModal">
                <i class="fas fa-clipboard-check me-2"></i> Inventory Audit
            </button>
        </div>
    </div>

    <!-- Inventory Alerts -->
    @{
        var lowStockItems = Model.Where(i => i.QuantityAvailable < 20).ToList();
    }
    @if (lowStockItems.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 p-3 d-flex align-items-center">
            <div class="flex-shrink-0 bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                <i class="fas fa-exclamation-triangle fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-warning">Low Stock Critical Alert</h6>
                <p class="mb-0 small text-dark">There are <strong>@lowStockItems.Count</strong> items below the safety threshold (20 units). Immediate replenishment required.</p>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted fw-bold" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4 py-3">PRODUCT DETAILS</th>
                            <th class="text-center">ON HAND</th>
                            <th class="text-center">RESERVED</th>
                            <th class="text-center">AVAILABLE</th>
                            <th>LOCATION</th>
                            <th>LAST UPDATED</th>
                            <th class="text-end pe-4">QUICK ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.QuantityAvailable < 20 ? "text-danger fw-bold" : (item.QuantityAvailable < 50 ? "text-warning fw-bold" : "text-success fw-bold");
                            var bgClass = item.QuantityAvailable < 20 ? "bg-danger-soft" : "";
                            
                            <tr class="@bgClass">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                    <div class="text-muted extra-small">SKU: @(item.Product?.SKU ?? item.Product?.Id.ToString("D5"))</div>
                                </td>
                                <td class="text-center"><span class="fw-bold fs-6">@item.QuantityOnHand</span></td>
                                <td class="text-center"><span class="text-primary fw-bold">@item.QuantityReserved</span></td>
                                <td class="text-center @statusClass"><span class="fs-6">@item.QuantityAvailable</span></td>
                                <td><span class="badge bg-light text-dark border">@item.WarehouseLocation</span></td>
                                <td><div class="small text-muted">@item.LastUpdated.ToString("MMM dd, HH:mm")</div></td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-action="UpdateInventory" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="change" value="10" />
                                            <input type="hidden" name="action" value="add" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-none">
                                                <i class="fas fa-plus me-1"></i> 10
                                            </button>
                                        </form>
                                        <form asp-action="UpdateInventory" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="change" value="10" />
                                            <input type="hidden" name="action" value="sub" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-none">
                                                <i class="fas fa-minus me-1"></i> 10
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Audit -->
<div class="modal fade" id="auditModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Inventory Audit Notice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 py-3">
                <p class="text-muted mb-0">System-wide inventory reconciliation is scheduled for every Friday. Manual adjustments are logged for supplier verification.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-dismiss="modal">I Understand</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.05); }
    .extra-small { font-size: 0.75rem; }
    .smaller { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
</style>
