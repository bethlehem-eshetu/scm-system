@model IEnumerable<SCM_System.Models.Entities.Warehouse>
@{
    ViewData["Title"] = "Select Operational Hub";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="display-5 fw-bold text-dark mb-2">Welcome Back, Manager</div>
        <p class="text-muted fs-5">Please select the operational hub you wish to oversee today.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var hub in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="hub-icon bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                                <i class="fas fa-warehouse fs-3"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-0">@hub.Name</h4>
                                <span class="badge bg-light text-primary border rounded-pill small">@hub.WarehouseCode</span>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-2 text-muted">
                                <i class="fas fa-map-marker-alt me-2" style="width: 20px;"></i>
                                <span class="small">@hub.City, @hub.Region</span>
                            </div>
                            <div class="d-flex align-items-center text-muted">
                                <i class="fas fa-boxes me-2" style="width: 20px;"></i>
                                <span class="small">Capacity: @hub.MaxCapacity.ToString("N0") Units</span>
                            </div>
                        </div>

                        <a asp-action="Dashboard" asp-route-warehouseId="@hub.Id" class="btn btn-primary w-100 rounded-pill fw-bold py-3 shadow-sm stretched-link">
                            Manage Facility <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hub-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .hub-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
        border-color: var(--bs-primary) !important;
    }
    .hub-icon {
        transition: transform 0.3s ease;
    }
    .hub-card:hover .hub-icon {
        transform: scale(1.1);
    }
</style>
