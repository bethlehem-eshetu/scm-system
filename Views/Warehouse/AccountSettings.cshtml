@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-5">
    <div class="row mb-4">
        <div class="col-12 text-center text-lg-start">
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-user-cog me-2 text-primary"></i> Account Settings</h2>
            <p class="text-muted">Manage your personal identity, security protocols, and active sessions.</p>
        </div>
    </div>

    <form asp-action="AccountSettings" method="post" enctype="multipart/form-data" id="settingsForm">
        <input type="hidden" asp-for="EmployeeId" />
        
        <div class="row g-4">
            <!-- Left Column: Identity & Password -->
            <div class="col-lg-5">
                <!-- Profile & Identity -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-primary border-5 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-user-circle me-2 text-primary"></i> Identity</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="profile-upload-wrapper position-relative d-inline-block">
                                <div class="profile-preview-circle shadow-sm border border-3 border-white overflow-hidden rounded-circle" id="profileImagePreview" style="width: 140px; height: 140px; margin: 0 auto; background: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                                    {
                                        <img src="@Model.ExistingProfileImage" class="img-fluid h-100 w-100 object-fit-cover" alt="Profile" />
                                    }
                                    else
                                    {
                                        <div class="text-muted"><i class="fas fa-user fa-3x"></i></div>
                                    }
                                </div>
                                <label for="ProfilePicture" class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 shadow-lg p-2" style="width: 35px; height: 35px;" data-bs-toggle="tooltip" title="Upload photo">
                                    <i class="fas fa-camera"></i>
                                </label>
                                <input type="file" asp-for="ProfilePicture" class="d-none" accept="image/*" onchange="previewImage(this)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="FullName" class="form-control bg-light border-0" placeholder="Full name" />
                            <span asp-validation-for="FullName" class="text-danger extra-small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="Email" class="form-control bg-light border-0" readonly />
                        </div>

                        <div class="mb-0">
                            <label asp-for="Phone" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="Phone" class="form-control bg-light border-0" placeholder="+251..." />
                            <span asp-validation-for="Phone" class="text-danger extra-small"></span>
                        </div>
                    </div>
                </div>

                <!-- Password Change -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-success border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-key me-2 text-success"></i> Password Security</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="CurrentPassword" type="password" class="form-control bg-light border-0" placeholder="Required for changes" />
                            <span asp-validation-for="CurrentPassword" class="text-danger extra-small"></span>
                        </div>
                        <hr class="my-4 opacity-25" />
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="NewPassword" type="password" class="form-control bg-light border-0" placeholder="New password" />
                            <span asp-validation-for="NewPassword" class="text-danger extra-small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-0" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger extra-small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Security, Sessions, Notifications -->
            <div class="col-lg-7">
                <!-- 2FA -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-info border-5 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light d-flex align-items-center justify-content-between">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-shield-alt me-2 text-info"></i> Two-Factor Authentication</h5>
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="tfaToggle" @(ViewBag.TfaEnabled ? "checked" : "") onchange="toggle2FA(this)">
                        </div>
                    </div>
                    <div class="card-body p-4" id="tfaSection">
                        @if (ViewBag.TfaEnabled)
                        {
                            <div class="d-flex align-items-center text-success">
                                <i class="fas fa-check-circle fa-2x me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">2FA Protected</h6>
                                    <p class="small text-muted mb-0">Your account is secured with Google Authenticator.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row align-items-center" id="tfaSetupArea" style="display:none;">
                                <div class="col-md-7">
                                    <p class="small text-muted mb-3">1. Scan this QR code with Google Authenticator.</p>
                                    <div class="mb-3">
                                        <code id="manualKey" class="bg-light p-2 rounded d-block text-center fw-bold"></code>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="tfaVerifyCode" class="form-control text-center" placeholder="6-digit code">
                                        <button class="btn btn-info text-white" type="button" onclick="verifyAndEnable2FA()">Verify</button>
                                    </div>
                                </div>
                                <div class="col-md-5 text-center">
                                    <img id="qrCodeImg" src="" class="img-fluid border rounded p-2 bg-white" style="max-width: 140px;" />
                                </div>
                            </div>
                            <div id="tfaDisabledMsg" class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i> Two-factor authentication is currently disabled. Toggle to start setup.
                            </div>
                        }
                    </div>
                </div>

                <!-- Notification Preferences -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-warning border-5 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-bell me-2 text-warning"></i> Notification Preferences</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="automation-switches">
                            <div class="form-check form-switch custom-switch d-flex justify-content-between align-items-center ps-0 mb-3">
                                <div>
                                    <label asp-for="EnableTaskAlerts" class="form-check-label fw-bold small d-block"></label>
                                    <span class="extra-small text-muted">Push notifications for new assignments</span>
                                </div>
                                <input asp-for="EnableTaskAlerts" class="form-check-input" type="checkbox" role="switch">
                            </div>
                            <div class="form-check form-switch custom-switch d-flex justify-content-between align-items-center ps-0 mb-3">
                                <div>
                                    <label asp-for="NotifyLowStock" class="form-check-label fw-bold small d-block"></label>
                                    <span class="extra-small text-muted">Alerts when inventory hits critical levels</span>
                                </div>
                                <input asp-for="NotifyLowStock" class="form-check-input" type="checkbox" role="switch">
                            </div>
                            <div class="form-check form-switch custom-switch d-flex justify-content-between align-items-center ps-0">
                                <div>
                                    <label asp-for="EnableReminders" class="form-check-label fw-bold small d-block"></label>
                                    <span class="extra-small text-muted">Daily summary and pending task reminders</span>
                                </div>
                                <input asp-for="EnableReminders" class="form-check-input" type="checkbox" role="switch">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Sessions -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-desktop me-2 text-secondary"></i> Active Sessions</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 extra-small-table">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Device</th>
                                        <th>IP Address</th>
                                        <th class="text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in ViewBag.ActiveSessions)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold small truncate-text" style="max-width: 150px;" title="@session.UserAgent">@session.UserAgent</div>
                                                <div class="extra-small text-muted">@session.LastActivityTime.ToString("g")</div>
                                            </td>
                                            <td class="small">@session.IpAddress</td>
                                            <td class="text-end pe-4">
                                                @if (session.SessionToken != Context.Session.Id)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0" onclick="revokeSession('@session.SessionToken')">Revoke</button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-soft text-success rounded-pill">Active</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Login History -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0"><i class="fas fa-history me-2 text-dark"></i> Recent Login History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 extra-small-table">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Timestamp</th>
                                        <th>IP</th>
                                        <th>Device</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in ViewBag.LoginHistory)
                                    {
                                        <tr>
                                            <td class="ps-4 small">@log.PerformedAtUtc.ToString("MM/dd HH:mm")</td>
                                            <td class="small">@log.IpAddress</td>
                                            <td class="small truncate-text" style="max-width: 150px;">@log.UserAgent</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-danger border-5 mb-5">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <h5 class="card-title fw-bold mb-0 text-danger"><i class="fas fa-exclamation-triangle me-2"></i> Danger Zone</h5>
                    </div>
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Deactivate Account</h6>
                            <p class="extra-small text-muted mb-0">Temporary suspension of your hub access.</p>
                        </div>
                        <button type="button" class="btn btn-danger rounded-pill px-4" onclick="showDeactivateModal()">Deactivate</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3 mb-5">
            <div class="col-12 text-center text-lg-end">
                <a asp-action="Dashboard" class="btn btn-link text-muted text-decoration-none fw-bold me-4">Discard</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg hvr-grow">
                    <i class="fas fa-save me-2"></i> Update Account
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Deactivation Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body p-4 text-center">
                <div class="icon-box bg-danger-soft text-danger rounded-circle p-4 d-inline-block mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-user-slash fa-2x"></i>
                </div>
                <h4 class="fw-bold mb-2">Confirm Deactivation</h4>
                <p class="text-muted small mb-4">Enter your password to temporarily deactivate your account.</p>
                <input type="password" id="deactivatePassword" class="form-control rounded-pill py-2 text-center mb-3" placeholder="Current Password">
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" onclick="confirmDeactivation()">Deactivate Now</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .profile-preview-circle { transition: transform 0.3s ease; }
        .profile-upload-wrapper:hover .profile-preview-circle { transform: scale(1.02); }
        .bg-primary-soft { background-color: rgba(13, 110, 253, 0.08); }
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.08); }
        .bg-warning-soft { background-color: rgba(255, 193, 7, 0.08); }
        .bg-info-soft { background-color: rgba(13, 202, 240, 0.08); }
        .bg-danger-soft { background-color: rgba(220, 53, 69, 0.08); }
        .extra-small { font-size: 0.72rem; }
        .extra-small-table { font-size: 0.75rem; }
        .custom-switch .form-check-input { width: 3em; height: 1.5em; cursor: pointer; margin-left: 0; }
        .form-control:focus { background-color: #fff !important; border: 1px solid var(--bs-primary) !important; box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.05) !important; }
        .hvr-grow { transition: transform .2s ease-in-out; }
        .hvr-grow:hover { transform: scale(1.05); }
        .truncate-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        // Profile Image Preview
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#profileImagePreview').html(`<img src="${e.target.result}" class="img-fluid h-100 w-100 object-fit-cover" />`);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 2FA Logic
        function toggle2FA(checkbox) {
            if (checkbox.checked) {
                $.post('/Warehouse/Toggle2FA', { enable: true }, function(data) {
                    if (data.success) {
                        $('#qrCodeImg').attr('src', data.qrCodeUri);
                        $('#manualKey').text(data.manualEntryKey);
                        $('#tfaSetupArea').fadeIn();
                        $('#tfaDisabledMsg').hide();
                        toastr.info("Please scan the QR code to finish setup.");
                    } else {
                        checkbox.checked = false;
                        toastr.error(data.message);
                    }
                });
            } else {
                if (confirm("Disable 2FA? This reduces security.")) {
                    $.post('/Warehouse/Toggle2FA', { enable: false }, function(data) {
                        if (data.success) location.reload();
                        else { checkbox.checked = true; toastr.error(data.message); }
                    });
                } else checkbox.checked = true;
            }
        }

        function verifyAndEnable2FA() {
            const code = $('#tfaVerifyCode').val();
            if (code.length !== 6) { toastr.warning("Enter 6-digit code."); return; }
            $.post('/Warehouse/Verify2FA', { code: code }, function(data) {
                if (data.success) {
                    toastr.success("2FA enabled!");
                    setTimeout(() => location.reload(), 1500);
                } else toastr.error(data.message);
            });
        }

        // Session Revocation
        function revokeSession(sessionId) {
            if (confirm("Terminate this session?")) {
                $.post('/Warehouse/RevokeSession', { sessionId: sessionId }, function(data) {
                    if (data.success) { toastr.success("Session revoked."); location.reload(); }
                    else toastr.error(data.message);
                });
            }
        }

        // Deactivation
        function showDeactivateModal() { $('#deactivateModal').modal('show'); }
        function confirmDeactivation() {
            const password = $('#deactivatePassword').val();
            if (!password) { toastr.warning("Password required."); return; }
            $.post('/Warehouse/DeactivateAccount', { password: password }, function(data) {
                if (data.success) {
                    toastr.success("Deactivated. Logging out...");
                    setTimeout(() => window.location.href = '/Account/Login', 2000);
                } else toastr.error(data.message);
            });
        }

        // Unsaved changes
        let isDirty = false;
        $('#settingsForm input, #settingsForm select').on('change input', function() { isDirty = true; });
        $(window).on('beforeunload', function() { if (isDirty) return "Unsaved changes!"; });
        $('#settingsForm').on('submit', function() { isDirty = false; });

        // Toastr
        toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right" };
        @if (TempData["SuccessMessage"] != null) { <text>toastr.success('@TempData["SuccessMessage"]');</text> }
        @if (TempData["ErrorMessage"] != null) { <text>toastr.error('@TempData["ErrorMessage"]');</text> }
    </script>
}
