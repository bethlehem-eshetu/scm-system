@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-5">
    <div class="row mb-4">
        <div class="col-12 text-center text-lg-start">
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-user-cog me-2 text-primary"></i> Account Settings</h2>
            <p class="text-muted">Manage your personal identity, security protocols, and active sessions.</p>
        </div>
    </div>

    <form asp-action="AccountSettings" method="post" enctype="multipart/form-data" id="settingsForm">
        <input type="hidden" asp-for="EmployeeId" />
        
        <div class="row g-4">
            <!-- Section 1: Profile & Identity -->
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden border-top border-primary border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light d-flex align-items-center">
                        <div class="icon-box bg-primary-soft text-primary me-3 rounded-3 p-2">
                            <i class="fas fa-user-circle fa-lg"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Identity</h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Profile Image Area -->
                        <div class="text-center mb-4">
                            <div class="profile-upload-wrapper position-relative d-inline-block">
                                <div class="profile-preview-circle shadow-sm border border-3 border-white overflow-hidden rounded-circle" id="profileImagePreview" style="width: 140px; height: 140px; margin: 0 auto; background: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                                    {
                                        <img src="@Model.ExistingProfileImage" class="img-fluid h-100 w-100 object-fit-cover" alt="Profile" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            <i class="fas fa-user fa-3x"></i>
                                        </div>
                                    }
                                </div>
                                <label for="ProfilePicture" class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 shadow-lg p-2" style="width: 35px; height: 35px;" data-bs-toggle="tooltip" title="Upload new photo">
                                    <i class="fas fa-camera"></i>
                                </label>
                                <input type="file" asp-for="ProfilePicture" class="d-none" accept="image/*" onchange="previewImage(this)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-id-card text-muted"></i></span>
                                <input asp-for="FullName" class="form-control bg-light border-0" placeholder="Full name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger extra-small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-0" readonly />
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Phone" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-phone text-muted"></i></span>
                                <input asp-for="Phone" class="form-control bg-light border-0" placeholder="+251..." />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger extra-small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Security -->
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden border-top border-success border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light d-flex align-items-center">
                        <div class="icon-box bg-success-soft text-success me-3 rounded-3 p-2">
                            <i class="fas fa-shield-alt fa-lg"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Password & Security</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-lock text-muted"></i></span>
                                <input asp-for="CurrentPassword" type="password" class="form-control bg-light border-0" placeholder="Current password" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger extra-small"></span>
                        </div>

                        <hr class="my-4 opacity-25" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-key text-muted"></i></span>
                                <input asp-for="NewPassword" type="password" class="form-control bg-light border-0" placeholder="New password" id="newPasswordInput" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger extra-small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-shield-virus text-muted"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-0" placeholder="Repeat new password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger extra-small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Two-Factor Authentication -->
            <div class="col-lg-12 mt-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-info border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-info-soft text-info me-3 rounded-3 p-2">
                                <i class="fas fa-mobile-alt fa-lg"></i>
                            </div>
                            <h5 class="card-title fw-bold mb-0">Two-Factor Authentication</h5>
                        </div>
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="tfaToggle" @(ViewBag.TfaEnabled ? "checked" : "") onchange="toggle2FA(this)">
                        </div>
                    </div>
                    <div class="card-body p-4" id="tfaSection">
                        @if (ViewBag.TfaEnabled)
                        {
                            <div class="d-flex align-items-center text-success">
                                <i class="fas fa-check-circle fa-2x me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">2FA is currently active</h6>
                                    <p class="small text-muted mb-0">Your account is protected by an additional security layer.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-2">Enable 2FA with Google Authenticator</h6>
                                    <p class="small text-muted mb-3">Add an extra layer of security to your account by requiring a verification code from your mobile device.</p>
                                    <ol class="small text-muted ps-3">
                                        <li>Install Google Authenticator from Play Store or App Store.</li>
                                        <li>Scan the QR code on the right with the app.</li>
                                        <li>Enter the 6-digit code provided by the app to verify.</li>
                                    </ol>
                                </div>
                                <div class="col-md-4 text-center" id="qrContainer" style="display:none;">
                                    <img id="qrCodeImg" src="" class="img-fluid border rounded p-2 bg-white mb-2" style="max-width: 150px;" />
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" id="tfaVerifyCode" class="form-control text-center fw-bold" placeholder="000000" maxlength="6" />
                                        <button class="btn btn-primary" type="button" onclick="verifyAndEnable2FA()">Verify</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Section 4: Active Sessions -->
            <div class="col-lg-12 mt-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-secondary-soft text-secondary me-3 rounded-3 p-2">
                                <i class="fas fa-desktop fa-lg"></i>
                            </div>
                            <h5 class="card-title fw-bold mb-0">Active Sessions</h5>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 border-0 extra-small text-uppercase">Device / Browser</th>
                                        <th class="border-0 extra-small text-uppercase">IP Address</th>
                                        <th class="border-0 extra-small text-uppercase">Last Activity</th>
                                        <th class="border-0 extra-small text-uppercase text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in ViewBag.ActiveSessions)
                                     {
                                         <tr>
                                             <td class="ps-4">
                                                 <div class="d-flex align-items-center">
                                                     @{
                                                         var ua = session.UserAgent ?? "";
                                                         var icon = ua.Contains("Mobile") || ua.Contains("Android") || ua.Contains("iPhone") ? "fa-mobile-alt" : "fa-laptop";
                                                     }
                                                     <i class="fas @icon text-muted me-3"></i>
                                                     <div>
                                                         <div class="fw-bold small truncate-text" style="max-width: 250px;">@session.UserAgent</div>
                                                         @if (session.SessionToken == Context.Session.Id)
                                                         {
                                                             <span class="badge bg-success-soft text-success rounded-pill extra-small">Current Session</span>
                                                         }
                                                     </div>
                                                 </div>
                                             </td>
                                             <td class="small">@session.IpAddress</td>
                                             <td class="small text-muted">@session.LastActivityTime.ToString("g")</td>
                                             <td class="text-end pe-4">
                                                 @if (session.SessionToken != Context.Session.Id)
                                                 {
                                                     <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="revokeSession('@session.SessionToken')">Revoke</button>
                                                 }
                                             </td>
                                         </tr>
                                     }
                                 </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 5: Login History -->
            <div class="col-lg-12 mt-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-dark-soft text-dark me-3 rounded-3 p-2">
                                <i class="fas fa-history fa-lg"></i>
                            </div>
                            <h5 class="card-title fw-bold mb-0">Recent Login History</h5>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 border-0 extra-small text-uppercase">Timestamp</th>
                                        <th class="border-0 extra-small text-uppercase">Action</th>
                                        <th class="border-0 extra-small text-uppercase">IP Address</th>
                                        <th class="border-0 extra-small text-uppercase">User Agent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in ViewBag.LoginHistory)
                                    {
                                        <tr>
                                            <td class="ps-4 small fw-bold">@log.PerformedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td><span class="badge bg-primary-soft text-primary rounded-pill">@log.ActionType</span></td>
                                            <td class="small">@log.IpAddress</td>
                                            <td class="small text-muted truncate-text" style="max-width: 300px;" title="@log.UserAgent">@log.UserAgent</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 6: Danger Zone -->
            <div class="col-lg-12 mt-4 mb-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-danger border-5">
                    <div class="card-header bg-white py-3 border-bottom border-light">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-danger-soft text-danger me-3 rounded-3 p-2">
                                <i class="fas fa-exclamation-triangle fa-lg"></i>
                            </div>
                            <h5 class="card-title fw-bold mb-0 text-danger">Danger Zone</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1 text-danger">Deactivate Account</h6>
                                <p class="small text-muted mb-0">Once you deactivate your account, you will no longer have access to the hub until an admin reactivates it.</p>
                            </div>
                            <button type="button" class="btn btn-danger rounded-pill px-4" onclick="showDeactivateModal()">Deactivate</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3 mb-5">
            <div class="col-12 text-center text-lg-end">
                <a asp-action="Dashboard" class="btn btn-link text-muted text-decoration-none fw-bold me-4">Discard Changes</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg hvr-grow">
                    <i class="fas fa-save me-2"></i> Save Account Details
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Deactivation Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="icon-box bg-danger-soft text-danger rounded-circle p-4 d-inline-block mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-user-slash fa-2x"></i>
                </div>
                <h4 class="fw-bold mb-2">Confirm Deactivation</h4>
                <p class="text-muted mb-4">Please enter your current password to confirm deactivation of your account.</p>
                <div class="mb-3">
                    <input type="password" id="deactivatePassword" class="form-control rounded-pill py-2 text-center" placeholder="Confirm your password">
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0 justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" onclick="confirmDeactivation()">Confirm Deactivate</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .profile-preview-circle { transition: transform 0.3s ease; }
        .profile-upload-wrapper:hover .profile-preview-circle { transform: scale(1.02); }
        .bg-primary-soft { background-color: rgba(13, 110, 253, 0.08); }
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.08); }
        .bg-warning-soft { background-color: rgba(255, 193, 7, 0.08); }
        .bg-info-soft { background-color: rgba(13, 202, 240, 0.08); }
        .bg-danger-soft { background-color: rgba(220, 53, 69, 0.08); }
        .bg-secondary-soft { background-color: rgba(108, 117, 125, 0.08); }
        .bg-dark-soft { background-color: rgba(33, 37, 41, 0.08); }
        .extra-small { font-size: 0.72rem; }
        .custom-switch .form-check-input { width: 3em; height: 1.5em; cursor: pointer; margin-left: 0; }
        .form-control:focus { background-color: #fff !important; border: 1px solid var(--bs-primary) !important; box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.05) !important; }
        .hvr-grow { transition: transform .2s ease-in-out; }
        .hvr-grow:hover { transform: scale(1.05); }
        .truncate-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        // Profile Image Preview
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#profileImagePreview').html(`<img src="${e.target.result}" class="img-fluid h-100 w-100 object-fit-cover" />`);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 2FA Logic
        function toggle2FA(checkbox) {
            if (checkbox.checked) {
                // Generate QR Code
                $.post('/Warehouse/Toggle2FA', { enable: true }, function(data) {
                    if (data.success) {
                        $('#qrCodeImg').attr('src', data.qrCodeUri);
                        $('#qrContainer').fadeIn();
                        toastr.info("Please scan the QR code to finish setup.");
                    } else {
                        checkbox.checked = false;
                        toastr.error(data.message);
                    }
                });
            } else {
                if (confirm("Are you sure you want to disable 2FA? This will reduce your account security.")) {
                    $.post('/Warehouse/Toggle2FA', { enable: false }, function(data) {
                        if (data.success) {
                            location.reload();
                        } else {
                            checkbox.checked = true;
                            toastr.error(data.message);
                        }
                    });
                } else {
                    checkbox.checked = true;
                }
            }
        }

        function verifyAndEnable2FA() {
            const code = $('#tfaVerifyCode').val();
            if (code.length !== 6) {
                toastr.warning("Please enter a valid 6-digit code.");
                return;
            }
            $.post('/Warehouse/Verify2FA', { code: code }, function(data) {
                if (data.success) {
                    toastr.success("2FA enabled successfully!");
                    setTimeout(() => location.reload(), 1500);
                } else {
                    toastr.error(data.message);
                }
            });
        }

        // Session Revocation
        function revokeSession(sessionId) {
            if (confirm("Are you sure you want to terminate this session? The device will be logged out immediately.")) {
                $.post('/Warehouse/RevokeSession', { sessionId: sessionId }, function(data) {
                    if (data.success) {
                        toastr.success("Session revoked successfully.");
                        location.reload();
                    } else {
                        toastr.error(data.message);
                    }
                });
            }
        }

        // Deactivation
        function showDeactivateModal() {
            $('#deactivateModal').modal('show');
        }

        function confirmDeactivation() {
            const password = $('#deactivatePassword').val();
            if (!password) {
                toastr.warning("Please enter your password to confirm.");
                return;
            }
            $.post('/Warehouse/DeactivateAccount', { password: password }, function(data) {
                if (data.success) {
                    toastr.success("Account deactivated. Logging out...");
                    setTimeout(() => window.location.href = '/Account/Login', 2000);
                } else {
                    toastr.error(data.message);
                }
            });
        }

        // Toastr Config
        toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right" };
        @if (TempData["SuccessMessage"] != null) { <text>toastr.success('@TempData["SuccessMessage"]');</text> }
        @if (TempData["ErrorMessage"] != null) { <text>toastr.error('@TempData["ErrorMessage"]');</text> }
    </script>
}
