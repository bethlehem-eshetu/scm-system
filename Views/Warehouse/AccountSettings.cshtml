@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Control Center";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Glass Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-panel p-4 position-relative overflow-hidden shadow-lg border-0" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); border-radius: 1.5rem;">
                <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="text-white mb-1 fw-bold"><i class="fas fa-tools me-2"></i>Control Center</h2>
                        <p class="text-white-50 mb-0">Unified management for identity, operational logic, and system security.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-white btn-sm rounded-pill px-4 shadow-sm fw-bold" onclick="location.reload()">
                            <i class="fas fa-sync-alt me-1 text-primary"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-3 fa-lg"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top overflow-hidden" style="top: 20px;">
                <div class="p-4 text-center border-bottom border-light bg-light-subtle">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 110px; height: 110px; border: 4px solid #fff;">
                            @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                            {
                                <img src="@Model.ExistingProfileImage" id="sidebarProfilePreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Profile" />
                            }
                            else
                            {
                                <i class="fas fa-user-tie fa-3x text-muted"></i>
                            }
                        </div>
                        <div class="position-absolute bottom-0 end-0 bg-success border border-white border-3 rounded-circle" style="width: 20px; height: 20px;"></div>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.FullName</h5>
                    <span class="badge bg-soft-primary text-primary rounded-pill px-3 py-1">Warehouse Manager</span>
                </div>
                <div class="p-3">
                    <div class="nav flex-column nav-pills nav-pills-custom" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2" id="v-pills-identity-tab" data-bs-toggle="pill" data-bs-target="#v-pills-identity" type="button" role="tab">
                            <i class="fas fa-id-card me-2 w-20px text-center"></i>Identity & Profile
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-operational-tab" data-bs-toggle="pill" data-bs-target="#v-pills-operational" type="button" role="tab">
                            <i class="fas fa-warehouse me-2 w-20px text-center"></i>Operational Logic
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                            <i class="fas fa-shield-alt me-2 w-20px text-center"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-2 text-danger" id="v-pills-danger-tab" data-bs-toggle="pill" data-bs-target="#v-pills-danger" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle me-2 w-20px text-center"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <form id="unifiedSettingsForm" asp-action="AccountSettings" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="EmployeeId" />
                <input type="hidden" asp-for="ExistingProfileImage" />

                <div class="tab-content" id="v-pills-tabContent">
                    
                    <!-- 1. Identity & Profile -->
                    <div class="tab-pane fade show active" id="v-pills-identity" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h5 class="mb-0 fw-bold text-primary">Identity & Profile</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4">
                                    <div class="col-12 text-center mb-4">
                                        <div class="position-relative d-inline-block">
                                            <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 130px; height: 130px; border: 5px solid #fff;">
                                                @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                                                {
                                                    <img src="@Model.ExistingProfileImage" id="mainProfilePreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Profile" />
                                                }
                                                else
                                                {
                                                    <i class="fas fa-user-tie fa-4x text-muted" id="profilePlaceholder"></i>
                                                    <img id="mainProfilePreview" class="img-fluid h-100 w-100 object-fit-cover d-none" alt="Profile" />
                                                }
                                            </div>
                                            <label for="ProfilePicture" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow-sm p-2" style="cursor: pointer; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-camera"></i>
                                            </label>
                                            <input asp-for="ProfilePicture" type="file" class="d-none" accept="image/*" onchange="previewImage(this)" />
                                        </div>
                                        <p class="text-muted small mt-2 fw-bold">Update Profile Photo</p>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="form-label small fw-bold text-muted">Legal Full Name</label>
                                        <input asp-for="FullName" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="FullName" class="text-danger extra-small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label small fw-bold text-muted">System Email (Read Only)</label>
                                        <input asp-for="Email" class="form-control rounded-pill bg-light border-0 px-4" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label small fw-bold text-muted">Contact Number</label>
                                        <input asp-for="Phone" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="Phone" class="text-danger extra-small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted">Notifications</label>
                                        <div class="d-flex gap-3 pt-2">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="EnableTaskAlerts">
                                                <label class="form-check-label small fw-bold" asp-for="EnableTaskAlerts">Task Alerts</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="EnableReminders">
                                                <label class="form-check-label small fw-bold" asp-for="EnableReminders">Reminders</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Operational Logic -->
                    <div class="tab-pane fade" id="v-pills-operational" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h5 class="mb-0 fw-bold text-warning">Warehouse Operational Logic</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label asp-for="DefaultWarehouseLocation" class="form-label small fw-bold text-muted">Default Intake Zone</label>
                                        <input asp-for="DefaultWarehouseLocation" class="form-control rounded-pill bg-light border-0 px-4" placeholder="e.g. Zone A-1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="LowStockThreshold" class="form-label small fw-bold text-muted">Low Stock Trigger</label>
                                        <input asp-for="LowStockThreshold" type="number" class="form-control rounded-pill bg-light border-0 px-4 text-center fw-bold" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="PicklistFormat" class="form-label small fw-bold text-muted">Picklist Format</label>
                                        <select asp-for="PicklistFormat" class="form-select rounded-pill bg-light border-0 px-4">
                                            <option value="Detailed">Detailed</option>
                                            <option value="Summary">Summary</option>
                                            <option value="Minimal">Minimal</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted mb-3">Zone Responsibilities</label>
                                        <div class="p-3 bg-light rounded-4 border border-white">
                                            <div class="row g-2">
                                                @foreach (var zone in new[] { "Cold Storage", "Bulk Area", "Packing Station", "Loading Dock", "Hazardous Goods" })
                                                {
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="AssignedZones" value="@zone" id="zone_@zone.Replace(" ", "")" @(Model.AssignedZones.Contains(zone) ? "checked" : "")>
                                                            <label class="form-check-label small" for="zone_@zone.Replace(" ", "")">@zone</label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted mb-3">Workflow Automation</label>
                                        <div class="list-group list-group-flush rounded-4 overflow-hidden border">
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                <div>
                                                    <h6 class="mb-0 small fw-bold">Auto-Accept Pick Tasks</h6>
                                                    <p class="extra-small text-muted mb-0">Advance orders to Picking instantly</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" asp-for="AutoAcceptPickTasks">
                                                </div>
                                            </div>
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                <div>
                                                    <h6 class="mb-0 small fw-bold">Low Stock Notifications</h6>
                                                    <p class="extra-small text-muted mb-0">Live push alerts for threshold breaches</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" asp-for="NotifyLowStock">
                                                </div>
                                            </div>
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                <div>
                                                    <h6 class="mb-0 small fw-bold">Voice-Guided Picking</h6>
                                                    <p class="extra-small text-muted mb-0">Enable hands-free headset protocols</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" asp-for="EnableVoicePicking">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Security Hub -->
                    <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                        <div class="row g-4">
                            <!-- Password & Theme -->
                            <div class="col-12">
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-header bg-white py-3 border-bottom border-light">
                                        <h5 class="mb-0 fw-bold text-dark">Security & Preferences</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="mb-4 pb-4 border-bottom border-light">
                                            <partial name="_ThemeToggle" />
                                        </div>
                                        
                                        <h6 class="fw-bold mb-3"><i class="fas fa-key me-2 text-primary"></i>Change Password</h6>
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label asp-for="CurrentPassword" class="form-label small fw-bold text-muted">Current Password</label>
                                                <input asp-for="CurrentPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" placeholder="Required for security changes" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="NewPassword" class="form-label small fw-bold text-muted">New Password</label>
                                                <input asp-for="NewPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Confirm New Password</label>
                                                <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2FA & Sessions -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-header bg-white py-3 border-bottom border-light">
                                        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-shield-alt me-2"></i>Two-Factor Auth</h5>
                                    </div>
                                    <div class="card-body p-4 text-center">
                                        <div class="icon-shape bg-soft-primary text-primary rounded-circle p-3 mb-3 d-inline-flex">
                                            <i class="fas fa-lock fa-2x"></i>
                                        </div>
                                        <p class="text-muted small mb-4">Protect your account with an additional layer of security via Google Authenticator.</p>
                                        
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input" type="checkbox" id="tfaToggle" @(ViewBag.TfaEnabled ? "checked" : "") onchange="handle2FAToggle(this)" style="width: 3rem; height: 1.5rem;">
                                            <label class="form-check-label fw-bold ms-2 mt-1" for="tfaToggle" id="tfaStatusLabel">
                                                @(ViewBag.TfaEnabled ? "2FA Active" : "Enable 2FA")
                                            </label>
                                        </div>

                                        <div id="tfaSetupArea" class="mt-4 p-3 bg-light rounded-4 d-none">
                                            <p class="small fw-bold mb-3">Scan QR Code</p>
                                            <img id="qrCodeImg" src="" class="img-fluid rounded shadow-sm mb-3" style="max-width: 150px;" />
                                            <div class="input-group input-group-sm mb-3">
                                                <span class="input-group-text bg-white border-0 small">Manual Key</span>
                                                <input type="text" id="manualKey" class="form-control bg-white border-0 text-center fw-bold" readonly />
                                            </div>
                                            <div class="input-group">
                                                <input type="text" id="verifyCode" class="form-control rounded-start-pill text-center" placeholder="6-digit code" />
                                                <button type="button" class="btn btn-primary rounded-end-pill px-3" onclick="verify2FA()">Verify</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-header bg-white py-3 border-bottom border-light">
                                        <h5 class="mb-0 fw-bold text-info"><i class="fas fa-desktop me-2"></i>Active Sessions</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="list-group list-group-flush rounded-bottom-4">
                                            @if (ViewBag.ActiveSessions != null)
                                            {
                                                foreach (var session in (IEnumerable<SCM_System.Models.Entities.UserSession>)ViewBag.ActiveSessions)
                                                {
                                                    <div class="list-group-item border-0 px-4 py-3 bg-transparent">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="d-flex align-items-center">
                                                                <div class="icon-shape bg-soft-info text-info rounded-pill p-2 me-3">
                                                                    <i class="fas fa-laptop small"></i>
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold small mb-0">@session.IpAddress</div>
                                                                    <small class="text-muted extra-small">Last active @session.LastActivityTime.ToString("MMM dd, HH:mm")</small>
                                                                </div>
                                                            </div>
                                                            <button type="button" class="btn btn-sm btn-soft-danger rounded-pill" onclick="revokeSession('@session.SessionToken')">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-header bg-white py-3 border-bottom border-light">
                                        <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-history me-2"></i>Login History</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="px-4 py-3 border-0 small text-muted text-uppercase">Time (UTC)</th>
                                                        <th class="py-3 border-0 small text-muted text-uppercase">IP Address</th>
                                                        <th class="py-3 border-0 small text-muted text-uppercase">Device / Browser</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (ViewBag.LoginHistory != null)
                                                    {
                                                        foreach (var log in (IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.LoginHistory)
                                                        {
                                                            <tr>
                                                                <td class="px-4 small">@log.PerformedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                                                                <td class="small fw-bold">@log.IpAddress</td>
                                                                <td><span class="extra-small text-muted text-truncate d-inline-block" style="max-width: 300px;" title="@log.UserAgent">@log.UserAgent</span></td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Danger Zone -->
                    <div class="tab-pane fade" id="v-pills-danger" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-4 border-top border-danger border-4">
                            <div class="card-header bg-white py-3 border-bottom border-light">
                                <h5 class="mb-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Critical Actions</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-4 border-bottom border-light gap-3">
                                    <div>
                                        <h6 class="fw-bold mb-1">Archive System Audit</h6>
                                        <p class="text-muted small mb-0">Export a comprehensive log of your activities and system changes.</p>
                                    </div>
                                    <button type="button" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                                        <i class="fas fa-download me-2"></i>Export Logs
                                    </button>
                                </div>

                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <h6 class="text-danger fw-bold mb-1">Deactivate Manager Access</h6>
                                        <p class="text-muted small mb-0">Request immediate suspension of your system credentials.</p>
                                    </div>
                                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="$('#deactivateModal').modal('show')">
                                        Deactivate Account
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Global Save Button -->
                <div class="text-end mt-4 pt-3">
                    <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-lg py-3 fw-bold hvr-grow">
                        <i class="fas fa-save me-2"></i>Deploy All Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title fw-bold">Confirm Suspension</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="icon-shape bg-soft-danger text-danger rounded-circle p-4 mb-4 d-inline-flex">
                    <i class="fas fa-user-slash fa-3x"></i>
                </div>
                <h5 class="fw-bold text-danger">Are you sure?</h5>
                <p class="text-muted">This will revoke your access to the Warehouse Management System immediately.</p>
                <div class="mb-4 text-start">
                    <label class="form-label small fw-bold text-muted">Verify with Password</label>
                    <input type="password" id="deactivatePwd" class="form-control rounded-pill bg-light border-0 px-4" placeholder="Enter password" />
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-pill flex-grow-1 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-pill flex-grow-1 py-2 fw-bold" onclick="confirmDeactivate()">Deactivate Now</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        :root { --bs-primary-rgb: 13, 110, 253; }
        .bg-soft-primary { background-color: rgba(13, 110, 253, 0.1); }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .glass-panel { border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); }
        .nav-pills-custom .nav-link {
            border-radius: 0.75rem;
            padding: 0.8rem 1.2rem;
            color: #6c757d;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .nav-pills-custom .nav-link:hover { background-color: #f8f9fa; color: var(--bs-primary); }
        .nav-pills-custom .nav-link.active {
            background-color: var(--bs-primary);
            color: white;
            box-shadow: 0 4px 15px rgba(var(--bs-primary-rgb), 0.2);
        }
        .w-20px { width: 20px; display: inline-block; }
        .extra-small { font-size: 0.75rem; }
        .object-fit-cover { object-fit: cover; }
        .icon-shape { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; }
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.1);
            background-color: #fff !important;
        }
        .hvr-grow { transition: transform .2s ease-in-out; }
        .hvr-grow:hover { transform: scale(1.02); }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function() {
            // Unsaved Changes warning
            let formChanged = false;
            $('#unifiedSettingsForm').on('change input', 'input, select, textarea', function() { formChanged = true; });
            $('#unifiedSettingsForm').submit(function() { formChanged = false; });
            window.addEventListener('beforeunload', function (e) {
                if (formChanged) {
                    var confirmationMessage = 'Unsaved changes will be lost.';
                    e.returnValue = confirmationMessage;
                    return confirmationMessage;
                }
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#mainProfilePreview').attr('src', e.target.result).removeClass('d-none');
                    $('#sidebarProfilePreview').attr('src', e.target.result);
                    $('#profilePlaceholder').addClass('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 2FA Handlers
        function handle2FAToggle(checkbox) {
            const enable = $(checkbox).is(':checked');
            $.post('/Warehouse/Toggle2FA', { enable: enable }, function(res) {
                if (res.success) {
                    if (enable) {
                        $('#qrCodeImg').attr('src', res.qrCodeUri);
                        $('#manualKey').val(res.manualEntryKey);
                        $('#tfaSetupArea').removeClass('d-none');
                        $('#tfaStatusLabel').text('Verify to Enable');
                        toastr.info('Scan the QR code and enter verification code.');
                    } else {
                        $('#tfaSetupArea').addClass('d-none');
                        $('#tfaStatusLabel').text('Enable 2FA');
                        toastr.success('2FA disabled.');
                    }
                } else {
                    $(checkbox).prop('checked', !enable);
                    toastr.error(res.message);
                }
            });
        }

        function verify2FA() {
            const code = $('#verifyCode').val();
            if (!code) { toastr.warning('Enter code.'); return; }
            $.post('/Warehouse/Verify2FA', { code: code }, function(res) {
                if (res.success) {
                    $('#tfaSetupArea').addClass('d-none');
                    $('#tfaStatusLabel').text('2FA Active');
                    toastr.success('2FA enabled successfully!');
                } else {
                    toastr.error(res.message);
                }
            });
        }

        function revokeSession(id) {
            if (confirm('Revoke this session?')) {
                $.post('/Warehouse/RevokeSession', { sessionId: id }, function(res) {
                    if (res.success) { location.reload(); }
                });
            }
        }

        function confirmDeactivate() {
            const pwd = $('#deactivatePwd').val();
            if (!pwd) { toastr.warning('Password required.'); return; }
            $.post('/Warehouse/DeactivateAccount', { password: pwd }, function(res) {
                if (res.success) {
                    window.location.href = '/Account/Login';
                } else {
                    toastr.error(res.message);
                }
            });
        }
    </script>
}
