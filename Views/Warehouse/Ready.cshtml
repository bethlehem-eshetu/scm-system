@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "Ready for Delivery";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3 content-wrapper warehouse-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Ready for Delivery</h2>
            <p class="text-muted mb-0">Packed orders awaiting courier assignment or pickup</p>
        </div>
        <div class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
            <i class="fas fa-box-check me-2"></i> @Model.Count() Orders Ready
        </div>
    </div>

    <div class="card bg-ready-dispatch border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 border-0 dispatch-table">
                    <thead class="small text-muted">
                        <tr>
                            <th class="ps-4">PO NUMBER</th>
                            <th>RETAILER</th>
                            <th>DESTINATION</th>
                            <th>ITEMS</th>
                            <th>STATUS</th>
                            <th class="text-end pe-4">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-shipping-fast fa-4x"></i>
                                    </div>
                                    <h5 class="text-muted">No orders are ready for pickup</h5>
                                </td>
                            </tr>
                        }
                        @foreach (var po in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-bold">#@po.PONumber</td>
                                <td>@po.Retailer?.BusinessName</td>
                                <td><i class="fas fa-map-marker-alt me-1 text-danger"></i> @(po.Order?.DeliveryAddress ?? "N/A")</td>
                                <td>@po.PurchaseOrderItems.Count Items</td>
                                <td>
                                    <span class="badge bg-soft-success text-success rounded-pill">@POStatus.Packed</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="card-footer border-0 bg-transparent p-4 pt-2">
                                        <a asp-action="AssignDelivery" asp-route-id="@po.Id" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm">
                                            <i class="fas fa-truck me-2"></i> Assign to Dispatch
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --bg-page: #F1F5F9;
        --bg-card: #FFFFFF;
        --bg-table-header: #F8FAFC;
        --border: #E2E8F0;
        --text-primary: #1A2C26;
        --text-secondary: #4B5E55;
    }

    body.dark-mode {
        --bg-page: #0A0F0D;
        --bg-card: #1A1F1D;
        --bg-table-header: #252B28;
        --border: #2A3530;
        --text-primary: #EDEDED;
        --text-secondary: #B8C5BE;
    }

    /* Layout - Universal */
    .content-wrapper {
        min-height: 100vh;
        width: 100%;
        padding: 2rem;
    }

    .bg-ready-dispatch {
        border-radius: 1.25rem;
        width: 100%;
        margin-bottom: 2rem;
    }

    .dispatch-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .dispatch-table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05rem;
        padding: 1.25rem 1rem;
        font-weight: 700;
    }

    .dispatch-table tbody td {
        padding: 1.25rem 1rem;
    }

    /* Theme Colors - Dynamic */
    .content-wrapper { background-color: var(--bg-page); color: var(--text-primary); }
    .bg-ready-dispatch { background-color: var(--bg-card) !important; border: 1px solid var(--border) !important; }
    .dispatch-table { color: var(--text-primary); }
    .dispatch-table thead th { background-color: var(--bg-table-header) !important; border-bottom: 1px solid var(--border) !important; }
    .dispatch-table tbody td, .dispatch-table tbody tr { background-color: var(--bg-card) !important; border-color: var(--border) !important; }
    .table-hover tbody tr:hover td { background-color: var(--bg-table-header) !important; }
    .text-muted { color: var(--text-secondary) !important; }
    .bg-soft-success { background-color: rgba(46, 156, 122, 0.1); color: var(--primary-color); }
</style>
