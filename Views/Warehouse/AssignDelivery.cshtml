@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Dispatch Center";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var agents = ViewBag.Agents as IEnumerable<SCM_System.Models.Entities.SupplierEmployee>;
    var vehicles = ViewBag.Vehicles as IEnumerable<SCM_System.Models.Entities.Vehicle>;
    var suggestedVehicles = ViewBag.SuggestedVehicles as IEnumerable<SCM_System.Models.ViewModels.VehicleSuggestion>;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Dispatch Control Center</h2>
            <p class="text-muted mb-0">Step 3: Assign a professional delivery agent and a suitable vehicle to finalize dispatch.</p>
        </div>
        <div class="d-flex gap-2 text-end">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25">
                <i class="fas fa-truck-loading me-2"></i> @Model.Count() Ready for Dispatch
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 py-5 text-center">
            <div class="opacity-25 mb-3">
                <i class="fas fa-shipping-fast fa-4x text-muted"></i>
            </div>
            <h5 class="text-muted">Dispatch queue is empty.</h5>
            <p class="small text-secondary">Orders will appear here once they are "Packed" and ready for transit.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var po in Model)
            {
                var orderWeight = po.PurchaseOrderItems.Sum(i => i.Quantity * (i.Product.ShippingWeight ?? 0));
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden d-flex flex-column">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary text-white rounded-pill px-2 me-2">#@po.PONumber</span>
                                <span class="fw-bold text-dark">@po.Retailer?.BusinessName</span>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">READY FOR PICKUP</span>
                        </div>
                        <div class="card-body p-4 pt-0 flex-grow-1">
                            <div class="row g-4 mb-4 pt-3">
                                <div class="col-md-7">
                                    <div class="mb-4">
                                        <label class="smaller text-muted d-block mb-1">DELIVERY DESTINATION</label>
                                        <div class="d-flex align-items-start">
                                            <i class="fas fa-map-marker-alt text-danger me-2 mt-1"></i>
                                            <span class="text-dark small fw-medium">@(po.Order?.DeliveryAddress ?? "No address provided")</span>
                                        </div>
                                    </div>
                                    <label class="smaller text-muted d-block mb-2">SHIPMENT PREVIEW</label>
                                    <div class="bg-light bg-opacity-50 p-3 rounded-4">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var item in po.PurchaseOrderItems.Take(3))
                                            {
                                                <li class="small mb-1 d-flex justify-content-between">
                                                    <span>@item.Product?.ProductName</span>
                                                    <span class="fw-bold text-muted">x@item.Quantity</span>
                                                </li>
                                            }
                                        </ul>
                                        <div class="mt-3 p-2 bg-white bg-opacity-75 rounded-3 border border-light small">
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">Total Order Weight:</span>
                                                <span class="fw-bold text-primary">@orderWeight KG</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <form asp-action="AssignDelivery" method="post" class="h-100 d-flex flex-column" data-order-weight="@orderWeight">
                                        <input type="hidden" name="id" value="@po.Id" />
                                        
                                        <div class="mb-3">
                                            <label class="smaller text-muted d-block fw-bold mb-2">SELECT AGENT</label>
                                            <select name="agentId" class="form-select border-0 bg-light rounded-3 shadow-none py-2" required>
                                                <option value="">-- Choose Agent --</option>
                                                @if (ViewBag.SortedAgents != null)
                                                {
                                                    var sortedAgents = (IEnumerable<dynamic>)ViewBag.SortedAgents;
                                                    bool firstRecommended = true;
                                                    foreach (var item in sortedAgents)
                                                    {
                                                        var agent = item.Agent;
                                                        string labelPrefix = "";
                                                        if (item.IsPhysicsViolation) { labelPrefix = "🚫 [NOT SUITABLE] "; }
                                                        else if (item.ProjectedScore > 100) { labelPrefix = "⚠️ [OVERLOADED] "; }
                                                        else if (firstRecommended && !item.IsPhysicsViolation) { labelPrefix = "⭐ [RECOMMENDED] "; firstRecommended = false; }

                                                        if (firstRecommended == false && labelPrefix.Contains("⭐"))
                                                        {
                                                            <option value="@agent.Id" 
                                                                    data-vehicle-id="@item.VehicleId"
                                                                    class="@(item.IsPhysicsViolation ? "text-muted" : "") @(item.ProjectedScore > 100 ? "text-danger" : "text-success")"
                                                                    selected>
                                                                @labelPrefix @(agent.User?.FullName ?? "Staff") (@agent.Phone) - @(item.ProjectedScore)% Load
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@agent.Id" 
                                                                    data-vehicle-id="@item.VehicleId"
                                                                    class="@(item.IsPhysicsViolation ? "text-muted" : "") @(item.ProjectedScore > 100 ? "text-danger" : "text-success")">
                                                                @labelPrefix @(agent.User?.FullName ?? "Staff") (@agent.Phone) - @(item.ProjectedScore)% Load
                                                            </option>
                                                        }
                                                    }
                                                }
                                                else if (agents != null)
                                                {
                                                    foreach (var agent in agents)
                                                    {
                                                        <option value="@agent.Id" data-vehicle-id="@agent.VehicleId">@(agent.User?.FullName ?? "Staff") (@agent.Phone)</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <div class="mb-4">
                                            <label class="smaller text-muted d-block fw-bold mb-2">SELECT VEHICLE</label>
                                            <select name="vehicleId" class="form-select border-0 bg-light rounded-3 shadow-none py-2" required>
                                                <option value="">-- Choose Vehicle --</option>
                                                @if (vehicles != null)
                                                {
                                                    foreach (var vehicle in vehicles)
                                                    {
                                                        var suggestion = suggestedVehicles?.FirstOrDefault(s => s.VehicleId == vehicle.Id);
                                                        <option value="@vehicle.Id">
                                                            @vehicle.LicensePlate (@vehicle.VehicleType)
                                                            @if (suggestion != null && suggestion.Rank <= 3)
                                                            {
                                                                @: (AI Rank #@suggestion.Rank)
                                                            }
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold py-2 shadow-sm mt-auto">
                                            <i class="fas fa-truck-loading me-2"></i> Confirm Dispatch
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="vehicle-info-container" style="display:none;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('select[name="agentId"]').on('change', function() {
                const employeeId = $(this).val();
                const form = $(this).closest('form');
                const vehicleSelect = form.find('select[name="vehicleId"]');
                const infoDiv = form.closest('.card-body').find('.vehicle-info-container');
                
                if (!employeeId) {
                    infoDiv.fadeOut();
                    return;
                }

                const orderWeight = form.data('order-weight') || 0;
                $.ajax({
                    url: '/Workforce/GetDriverDetails',
                    data: { employeeId: employeeId, newOrderWeightKg: orderWeight },
                    success: function(driverData) {
                        if (driverData.vehicleId) {
                            vehicleSelect.val(driverData.vehicleId);
                            
                            let statusColor = driverData.loadStatus === 'Critical' ? 'danger' : (driverData.loadStatus === 'High Risk' ? 'warning' : 'success');
                            let statusIcon = driverData.loadStatus === 'Critical' ? 'fa-exclamation-triangle' : 'fa-check-circle';
                            
                            let alertHtml = '';
                            if (driverData.isPhysicsViolation) {
                                alertHtml = `<div class="alert alert-danger mt-2 py-2 smaller shadow-sm border-0 rounded-3">
                                    <i class="fas fa-ban me-1"></i> <strong>PHYSICS VIOLATION:</strong> Too heavy!
                                </div>`;
                                form.find('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-ban me-2"></i> Invalid Payload');
                            } else if (driverData.workloadScore > 100) {
                                alertHtml = `<div class="alert alert-warning mt-2 py-2 smaller shadow-sm border-0 rounded-3">
                                    <i class="fas fa-exclamation-triangle me-1"></i> <strong>OVERLOADED:</strong> High risk delay.
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="overrideToggle" name="isOverride" value="true">
                                        <label class="form-check-label fw-bold" for="overrideToggle">Override</label>
                                    </div>
                                    <div class="mt-1 d-none" id="overrideReasonDiv">
                                        <input type="text" class="form-control form-control-sm" name="overrideReason" placeholder="Reason...">
                                    </div>
                                </div>`;
                                form.find('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-ban me-2"></i> Overloaded');
                            } else {
                                form.find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-truck-loading me-2"></i> Confirm Dispatch');
                            }

                            infoDiv.html(`
                                <div class="alert alert-info border-0 shadow-sm rounded-4 mt-3 mb-0">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-truck me-2 text-primary"></i>
                                        <div>
                                            <div class="small fw-bold">${driverData.licensePlate} (${driverData.vehicleType})</div>
                                            <div class="smaller">Max Payload: ${driverData.maxLoadCapacity} KG</div>
                                        </div>
                                    </div>
                                    <div class="bg-white bg-opacity-50 p-2 rounded-3">
                                        <div class="d-flex justify-content-between smaller mb-1">
                                            <span>Projected Load:</span>
                                            <strong>${driverData.projectedLoad} / ${driverData.maxLoadCapacity} KG</strong>
                                        </div>
                                        <div class="progress" style="height: 4px;">
                                            <div class="progress-bar bg-${statusColor}" style="width: ${Math.min(100, driverData.workloadScore)}%;"></div>
                                        </div>
                                        <div class="mt-2 small fw-bold">Score: ${driverData.workloadScore}% (${driverData.loadStatus})</div>
                                        ${alertHtml}
                                    </div>
                                </div>`).fadeIn();
                        }
                    }
                });
            });

            $(document).on('change', '#overrideToggle', function() {
                const isChecked = $(this).is(':checked');
                const form = $(this).closest('form');
                const reasonDiv = form.find('#overrideReasonDiv');
                if (isChecked) {
                    reasonDiv.removeClass('d-none');
                    form.find('button[type="submit"]').prop('disabled', false).addClass('btn-danger').html('Confirm Override');
                } else {
                    reasonDiv.addClass('d-none');
                    form.find('button[type="submit"]').prop('disabled', true).removeClass('btn-danger').html('Overloaded');
                }
            });
        });
    </script>
}
