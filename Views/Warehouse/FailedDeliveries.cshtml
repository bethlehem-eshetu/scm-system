@model IEnumerable<SCM_System.Models.Entities.DeliveryFailure>
@{
    ViewData["Title"] = "Failed Deliveries Resolution";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">Failed Deliveries Hub</h1>
            <p class="text-muted small mb-0">Manage and resolve reported delivery issues.</p>
        </div>
        <div class="bg-faint-green p-2 rounded-circle shadow-sm" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-exclamation-triangle text-danger"></i>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var failure in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <div class="col-lg-4 p-4 border-end bg-faint-green bg-opacity-30">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-white text-dark-green border border-light rounded-pill px-3 mb-2 small fw-bold">#@failure.PurchaseOrder.PONumber</span>
                                            <h4 class="fw-bold text-dark-green mb-0">@failure.PurchaseOrder.Retailer?.BusinessName</h4>
                                        </div>
                                        <span class="badge bg-danger rounded-pill px-3 py-2 small fw-bold text-uppercase">@failure.Status</span>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <div class="small text-uppercase fw-bold text-muted ls-1 mb-1">Failure Reason</div>
                                        <div class="text-danger fw-bold">@failure.FailureReason</div>
                                        @if (!string.IsNullOrEmpty(failure.Notes))
                                        {
                                            <div class="mt-2 p-2 bg-white rounded-3 small border border-light">
                                                <i class="fas fa-comment-dots text-muted me-1"></i> @failure.Notes
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-4 pt-4 border-top border-light">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-map-marker-alt text-dark-green me-2 small"></i>
                                            <span class="small fw-medium">@failure.PurchaseOrder.DeliveryAddress</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-clock text-muted me-2 small"></i>
                                            <span class="small text-muted">Reported @failure.ReportedAt.ToString("MMM dd, HH:mm")</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-8 p-4 d-flex flex-column">
                                    <h5 class="fw-bold text-dark-green mb-4">Resolution Options</h5>
                                    
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="card border border-light rounded-4 h-100 hover-shadow transition">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-center mb-3">
                                                        <div class="bg-faint-green p-2 rounded-3 me-3">
                                                            <i class="fas fa-calendar-alt text-dark-green"></i>
                                                        </div>
                                                        <h6 class="fw-bold mb-0">Reschedule</h6>
                                                    </div>
                                                    <p class="small text-muted mb-4">Retry delivery with a new date or different agent.</p>
                                                    <button class="btn btn-dark-green w-100 rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@failure.Id">
                                                        Select Date & Agent
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-6">
                                            <div class="card border border-light rounded-4 h-100 hover-shadow transition">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-center mb-3">
                                                        <div class="bg-soft-danger p-2 rounded-3 me-3">
                                                            <i class="fas fa-ban text-danger"></i>
                                                        </div>
                                                        <h6 class="fw-bold mb-0">Request Cancellation</h6>
                                                    </div>
                                                    <p class="small text-muted mb-4">Send cancellation request to Supplier for approval.</p>
                                                    <button class="btn btn-outline-danger w-100 rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#cancelModal-@failure.Id">
                                                        Cancel Order
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reschedule Modal -->
                <div class="modal fade" id="rescheduleModal-@failure.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-header bg-dark-green text-white border-0 py-3">
                                <h5 class="modal-title fw-bold">Reschedule Delivery</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="RescheduleDelivery" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="failureId" value="@failure.Id" />
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted text-uppercase">New Delivery Date</label>
                                        <input type="datetime-local" name="newDate" class="form-control border-0 bg-faint-green rounded-3 p-3" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted text-uppercase">Assign Agent (Optional)</label>
                                        <select name="newAgentId" class="form-select border-0 bg-faint-green rounded-3 p-3">
                                            <option value="">Keep current agent</option>
                                            @* In a real app, you'd populate this with available agents *@
                                        </select>
                                    </div>
                                    <div class="alert bg-soft-primary text-primary border-0 rounded-4 small">
                                        <i class="fas fa-info-circle me-2"></i> The retailer will be notified of the new schedule.
                                    </div>
                                </div>
                                <div class="modal-footer bg-faint-green border-0 px-4 py-3">
                                    <button type="button" class="btn btn-white border-0 rounded-pill px-4 text-muted small fw-bold" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-dark-green rounded-pill px-4 shadow-sm fw-bold">Update Schedule</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Cancellation Modal -->
                <div class="modal fade" id="cancelModal-@failure.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-header bg-danger text-white border-0 py-3">
                                <h5 class="modal-title fw-bold">Request Cancellation</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="RequestCancellation" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="failureId" value="@failure.Id" />
                                <div class="modal-body p-4">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Cancellation Reason</label>
                                    <textarea name="reason" class="form-control border-0 bg-faint-green rounded-3 p-3" rows="3" required placeholder="Explain why this order should be cancelled..."></textarea>
                                    <div class="alert bg-soft-warning text-warning border-0 rounded-4 mt-3 small">
                                        <i class="fas fa-exclamation-triangle me-2"></i> This request requires approval from the Supplier.
                                    </div>
                                </div>
                                <div class="modal-footer bg-faint-green border-0 px-4 py-3">
                                    <button type="button" class="btn btn-white border-0 rounded-pill px-4 text-muted small fw-bold" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">Send Request</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white p-5 rounded-5 shadow-sm border border-light">
                    <i class="fas fa-check-circle fa-4x text-success opacity-25 mb-4"></i>
                    <h4 class="fw-bold text-dark-green">All Clear!</h4>
                    <p class="text-muted">No failed deliveries requiring resolution at this time.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .shadow-premium { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important; }
    .rounded-5 { border-radius: 24px !important; }
    .ls-1 { letter-spacing: 1px; }
    .hover-shadow:hover { box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05) !important; }
    .transition { transition: all 0.2s ease; }
    .bg-soft-danger { background-color: rgba(220, 53, 69, 0.08); }
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.08); }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.08); }
</style>
