@model SCM_System.Models.Entities.Warehouse
@{
    ViewData["Title"] = "Warehouse Profile";
    Layout = "_DashboardLayout";

    // Status Badge Logic
    string statusClass = Model.Status.ToString() == "Active" ? "status-active" : "status-inactive";
}

<style>
    :root {
        --bg-page: #F1F5F9;
        --bg-card: #FFFFFF;
        --bg-sidebar: #0B3B2F;
        --bg-input: #FFFFFF;
        --bg-table-header: #F8FAFC;
        --bg-hover: #F0F4F2;
        --text-primary: #1A2C26;
        --text-secondary: #4A5C55;
        --text-muted: #6F7E78;
        --text-white: #FFFFFF;
        --border-light: #E2E8E4;
        --border-medium: #CDD6D1;
        --success: #2E9C7A;
        --warning: #E67E22;
        --danger: #E05A5A;
        --info: #5B8FF9;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    }

    body.dark-mode {
        --bg-page: #0A0F0D;
        --bg-card: #1A1F1D;
        --bg-sidebar: #06261E;
        --bg-input: #252B28;
        --bg-table-header: #252B28;
        --bg-hover: #2A3530;
        --text-primary: #EDEDED;
        --text-secondary: #C5CDC8;
        --text-muted: #9EABA5;
        --border-light: #2A3530;
        --border-medium: #3A4840;
        --shadow-sm: none;
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.3);
    }

    .profile-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 32px;
        background-color: var(--bg-page);
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .page-header p {
        color: var(--text-muted);
        font-size: 15px;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background-color: var(--success);
        color: white;
    }

    .btn-primary:hover {
        background-color: #247A5E;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(46, 156, 122, 0.3);
    }

    .btn-secondary {
        background-color: transparent;
        border: 1.5px solid var(--border-medium);
        color: var(--text-secondary);
    }

    .btn-secondary:hover {
        background-color: var(--bg-hover);
        border-color: var(--success);
        color: var(--success);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-active {
        background-color: rgba(46, 156, 122, 0.15);
        color: var(--success);
    }

    .status-inactive {
        background-color: rgba(224, 90, 90, 0.15);
        color: var(--danger);
    }

    .two-col-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 32px;
        margin-bottom: 24px;
    }

    .profile-card {
        background: var(--bg-card);
        border-radius: 20px;
        border: 1px solid var(--border-light);
        overflow: hidden;
        height: fit-content;
        box-shadow: var(--shadow-sm);
    }

    .profile-photo {
        padding: 32px;
        text-align: center;
        border-bottom: 1px solid var(--border-light);
        background: linear-gradient(to bottom, var(--bg-hover) 0%, transparent 100%);
    }

    .avatar-circle {
        width: 120px;
        height: 120px;
        background: var(--success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        box-shadow: 0 8px 24px rgba(46, 156, 122, 0.2);
    }

    .avatar-circle span {
        font-size: 48px;
        color: white;
    }

    .supplier-info {
        padding: 24px;
    }

    .supplier-info h4 {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 16px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 14px;
    }

    .info-label {
        color: var(--text-muted);
    }

    .info-value {
        color: var(--text-primary);
        font-weight: 600;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .info-card {
        background: var(--bg-card);
        border-radius: 20px;
        border: 1px solid var(--border-light);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s;
    }

    .info-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .info-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-grid {
        display: grid;
        gap: 20px;
    }

    .info-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .info-field .label {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .info-field .value {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .value.muted {
        color: var(--text-muted);
        font-style: italic;
        font-weight: 400;
    }

    .last-updated {
        text-align: right;
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid var(--border-light);
    }

    /* Modal Styles */
    .modal-content {
        background-color: var(--bg-card);
        border-radius: 24px;
        border: 1px solid var(--border-light);
        color: var(--text-primary);
    }
    .modal-header {
        border-bottom: 1px solid var(--border-light);
        padding: 24px;
    }
    .modal-footer {
        border-top: 1px solid var(--border-light);
        padding: 20px 24px;
    }
    .form-control {
        background-color: var(--bg-input);
        border: 1.5px solid var(--border-light);
        color: var(--text-primary);
        border-radius: 12px;
        padding: 12px 16px;
    }
    .form-control:focus {
        border-color: var(--success);
        box-shadow: 0 0 0 4px rgba(46, 156, 122, 0.1);
        background-color: var(--bg-input);
        color: var(--text-primary);
    }
    .form-label {
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
        color: var(--text-secondary);
    }

    @@media (max-width: 1100px) {
        .two-col-grid {
            grid-template-columns: 1fr;
        }
        .profile-card {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .details-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="profile-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h1>Warehouse Profile</h1>
            <p>Comprehensive facility configuration and contact matrix</p>
        </div>
        <div class="action-buttons">
            <a href="@Url.Action("ExportProfile", "Warehouse")" class="btn btn-secondary">
                <i class="fas fa-file-export"></i> Export Data
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="fas fa-edit"></i> Edit Facility
            </button>
        </div>
    </div>

    <!-- MAIN TWO COLUMN LAYOUT -->
    <div class="two-col-grid">
        <!-- LEFT COLUMN: PROFILE PHOTO + SUPPLIER INFO -->
        <div class="profile-card">
            <div class="profile-photo">
                <div class="avatar-circle">
                    <span>🏭</span>
                </div>
                <h3 style="color: var(--text-primary); margin-top: 12px; font-weight: 700;">@Model.Name</h3>
                <span class="status-badge @statusClass">
                    @Model.Status.ToString()
                </span>
            </div>
            <div class="supplier-info">
                <h4>Network Ownership</h4>
                <div class="info-row">
                    <span class="info-label">Upstream Supplier</span>
                    <span class="info-value">@(Model.Supplier?.CompanyName ?? "Independent")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Supplier ID</span>
                    <span class="info-value">#@Model.SupplierId.ToString("D4")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Facility Type</span>
                    <span class="info-value text-success">@Model.HubType.ToString()</span>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: DETAILS GRID -->
        <div class="details-grid">
            <!-- FACILITY OVERVIEW -->
            <div class="info-card">
                <h3><i class="fas fa-building text-success"></i> Facility Overview</h3>
                <div class="info-grid">
                    <div class="info-field">
                        <span class="label">Warehouse Name</span>
                        <span class="value">@Model.Name</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Warehouse ID</span>
                        <span class="value">#@Model.Id.ToString("D5")</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Internal Code</span>
                        <span class="value">@(Model.WarehouseCode ?? "N/A")</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Registration Date</span>
                        <span class="value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- LOCATION & CONTACT -->
            <div class="info-card">
                <h3><i class="fas fa-map-marker-alt text-success"></i> Location & Contact</h3>
                <div class="info-grid">
                    <div class="info-field">
                        <span class="label">Street Address</span>
                        <span class="value">@Model.Address</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Geographic Region</span>
                        <span class="value">@Model.City, @Model.Region, @Model.Country</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Primary Manager</span>
                        <span class="value @(Model.PrimaryManager == null ? "muted" : "")">
                            @(Model.PrimaryManager?.User?.FullName ?? "Not Assigned")
                        </span>
                    </div>
                    <div class="info-field">
                        <span class="label">Contact Channels</span>
                        <span class="value small">
                            <i class="fas fa-phone-alt me-1 text-muted"></i> @(Model.PrimaryManager?.Phone ?? "No Phone")<br>
                            <i class="fas fa-envelope me-1 text-muted"></i> @(Model.PrimaryManager?.User?.Email ?? "No Email")
                        </span>
                    </div>
                </div>
            </div>

            <!-- OPERATIONS & SCHEDULE -->
            <div class="info-card">
                <h3><i class="fas fa-clock text-success"></i> Operations & Schedule</h3>
                <div class="info-grid">
                    <div class="info-field">
                        <span class="label">Operating Window</span>
                        <span class="value">@(Model.OperatingHoursFrom?.ToString(@"hh\:mm") ?? "08:00") - @(Model.OperatingHoursTo?.ToString(@"hh\:mm") ?? "18:00")</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Active Workdays</span>
                        <span class="value">@(Model.WorkingDays ?? "Monday - Friday")</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Capacity Matrix</span>
                        <span class="value">@Model.MaxCapacity.ToString("N0") Max Units</span>
                    </div>
                </div>
            </div>

            <!-- GOVERNANCE & DATA -->
            <div class="info-card">
                <h3><i class="fas fa-shield-alt text-success"></i> Governance</h3>
                <div class="info-grid">
                    <div class="info-field">
                        <span class="label">Master Supplier</span>
                        <span class="value">@(Model.Supplier?.CompanyName ?? "Independent")</span>
                    </div>
                    <div class="info-field">
                        <span class="label">Data Sync Status</span>
                        <span class="value">
                            <span class="badge bg-soft-success text-success rounded-pill px-2">Synchronized</span>
                        </span>
                    </div>
                    <div class="info-field">
                        <span class="label">Last Data Audit</span>
                        <span class="value small">
                             @(Model.UpdatedAt?.ToString("MMM dd, yyyy 'at' HH:mm") ?? DateTime.Now.ToString("MMM dd, yyyy"))
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LAST UPDATED TIMESTAMP -->
    <div class="last-updated">
        <i class="fas fa-info-circle me-1"></i> This profile is a verified system record. Last modified: @(Model.UpdatedAt?.ToString("MMMM dd, yyyy") ?? Model.CreatedAt.ToString("MMMM dd, yyyy"))
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2 text-success"></i> Edit Facility Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Warehouse Name</label>
                            <input type="text" name="name" class="form-control" value="@Model.Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <input type="text" name="address" class="form-control" value="@Model.Address" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">City</label>
                            <input type="text" name="city" class="form-control" value="@Model.City" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Region</label>
                            <input type="text" name="region" class="form-control" value="@Model.Region" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Phone</label>
                            <input type="text" name="phone" class="form-control" value="@Model.PrimaryManager?.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Email</label>
                            <input type="email" name="email" class="form-control" value="@Model.PrimaryManager?.User?.Email" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Working Days</label>
                            <input type="text" name="workingDays" class="form-control" value="@Model.WorkingDays" placeholder="e.g. Monday - Friday" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Operating Hours From</label>
                            <input type="time" name="operatingHoursFrom" class="form-control" value="@(Model.OperatingHoursFrom?.ToString(@"hh\:mm") ?? "08:00")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Operating Hours To</label>
                            <input type="time" name="operatingHoursTo" class="form-control" value="@(Model.OperatingHoursTo?.ToString(@"hh\:mm") ?? "18:00")" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
