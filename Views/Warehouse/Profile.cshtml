@model SCM_System.Models.Entities.Warehouse
@{
    ViewData["Title"] = "Warehouse Profile";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-5 bg-gradient-dark text-white">
            <div class="row align-items-center">
                <div class="col-md-2 text-center text-md-start mb-4 mb-md-0">
                    <div class="avatar-xl bg-primary rounded-4 shadow-lg mx-auto mx-md-0 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                        <i class="fas fa-warehouse fs-1"></i>
                    </div>
                </div>
                <div class="col-md-7 text-center text-md-start">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1">Facility Management</h6>
                    <h1 class="fw-bold mb-2">@Model.Name</h1>
                    <p class="lead text-white-50 mb-0"><i class="fas fa-map-marker-alt me-2"></i> @Model.Address, @Model.City, @Model.Region</p>
                </div>
                <div class="col-md-3 text-center text-md-end">
                    <div class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-4 py-2 mb-2">Operational</div>
                    <div class="text-white-50 small">Part of @Model.Supplier?.CompanyName Network</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Live Inventory - Stocked Products</h5>
                    <button class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-plus me-2"></i> Adjust Stock
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted fw-bold" style="font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4 py-3">PRODUCT</th>
                                <th>CATEGORY</th>
                                <th>STOCK ON HAND</th>
                                <th>RESERVED</th>
                                <th>AVAILABLE</th>
                                <th class="text-end pe-4">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Inventories)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@inv.Product?.ProductName</div>
                                        <div class="extra-small text-muted">SKU: @inv.ProductId</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@inv.Product?.Category</span></td>
                                    <td class="fw-bold">@inv.QuantityOnHand @inv.Product?.Unit</td>
                                    <td class="text-warning fw-bold">@inv.QuantityReserved</td>
                                    <td class="text-primary fw-bold">@(inv.QuantityOnHand - inv.QuantityReserved)</td>
                                    <td class="text-end pe-4">
                                        @if (inv.QuantityOnHand - inv.QuantityReserved < 20)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3">Stable</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-dark { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }
    .extra-small { font-size: 0.65rem; }
</style>
