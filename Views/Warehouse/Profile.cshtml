@model SCM_System.Models.Entities.Warehouse
@{
    ViewData["Title"] = "Warehouse Profile";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-md-2 text-center text-md-start mb-4 mb-md-0">
                        <div class="avatar-xl bg-white bg-opacity-10 text-white rounded-4 shadow-lg mx-auto mx-md-0 d-flex align-items-center justify-content-center border border-white border-opacity-25" style="width: 100px; height: 100px;">
                            <i class="fas fa-warehouse fs-1 text-gradient-gold"></i>
                        </div>
                    </div>
                    <div class="col-md-7 text-center text-md-start">
                        <h6 class="text-white-50 text-uppercase fw-bold mb-1 tracking-widest">Facility Management</h6>
                        <h1 class="fw-bold mb-2 text-white">@Model.Name</h1>
                        <p class="lead text-white-50 mb-0"><i class="fas fa-map-marker-alt me-2 text-info"></i> @Model.Address, @Model.City, @Model.Region</p>
                    </div>
                    <div class="col-md-3 text-center text-md-end">
                        <div class="badge bg-success bg-opacity-25 text-white border border-success border-opacity-50 rounded-pill px-4 py-2 mb-2 shadow-sm">Operational</div>
                        <div class="text-white-50 small fw-bold">Part of @Model.Supplier?.CompanyName Network</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Live Inventory - Stocked Products</h5>
                    <button class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-plus me-2"></i> Adjust Stock
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted fw-bold" style="font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4 py-3">PRODUCT</th>
                                <th>CATEGORY</th>
                                <th>STOCK ON HAND</th>
                                <th>RESERVED</th>
                                <th>AVAILABLE</th>
                                <th class="text-end pe-4">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Inventories)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@inv.Product?.ProductName</div>
                                        <div class="extra-small text-muted">SKU: @inv.ProductId</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@inv.Product?.Category</span></td>
                                    <td class="fw-bold">@inv.QuantityOnHand @inv.Product?.Unit</td>
                                    <td class="text-warning fw-bold">@inv.QuantityReserved</td>
                                    <td class="text-primary fw-bold">@(inv.QuantityOnHand - inv.QuantityReserved)</td>
                                    <td class="text-end pe-4">
                                        @if (inv.QuantityOnHand - inv.QuantityReserved < 20)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3">Stable</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Header Styles */
    .welcome-banner {
        background: linear-gradient(135deg, #0B3B2F 0%, #1A4D3A 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .banner-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: url('https://www.transparenttextures.com/patterns/cubes.png');
        opacity: 0.05; z-index: 1;
    }
    .banner-glow {
        position: absolute; top: -50%; right: -20%; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(46, 156, 122, 0.2) 0%, transparent 70%);
        filter: blur(50px); z-index: 1;
    }
    .text-gradient-gold {
        background: linear-gradient(to right, #f1c40f, #f39c12);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
    .z-index-2 { z-index: 2; }
    .tracking-widest { letter-spacing: 2px; }
    .animate-slide-up { animation: slideUp 0.6s ease-out forwards; }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .extra-small { font-size: 0.65rem; }
</style>
