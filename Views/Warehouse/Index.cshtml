@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Warehouse Fulfillment";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Warehouse Fulfillment</h2>
            <p class="text-muted mb-0">Manage picking, packing, and delivery dispatch</p>
        </div>
        <div>
            <span class="badge bg-primary rounded-pill px-3">@Model.Count() POs Pending</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase small fw-bold">PO #</th>
                            <th class="text-uppercase small fw-bold">Retailer</th>
                            <th class="text-uppercase small fw-bold">Items</th>
                            <th class="text-uppercase small fw-bold">Status</th>
                            <th class="text-uppercase small fw-bold">Date</th>
                            <th class="text-end pe-4 text-uppercase small fw-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var po in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@po.PONumber</td>
                                    <td>
                                        <div class="fw-medium">@po.Order?.Retailer?.BusinessName</div>
                                        <div class="text-muted small">@po.Order?.Retailer?.City</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            @po.PurchaseOrderItems?.Count Items
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(po.Status == "PO Issued" ? "bg-info" : (po.Status == "In Progress" ? "bg-warning" : "bg-primary")) rounded-pill px-3">
                                            @po.Status
                                        </span>
                                    </td>
                                    <td>@po.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#packModal-@po.Id">
                                            <i class="fas fa-box-open me-1"></i> Pack & Dispatch
                                        </button>
                                    </td>
                                </tr>

                                <!-- Pack Modal -->
                                <div class="modal fade" id="packModal-@po.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Pack PO @po.PONumber</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="MarkReady" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                                <div class="modal-body p-4">
                                                    <div class="mb-4">
                                                        <label class="form-label small fw-bold text-uppercase">Items to Pack</label>
                                                        <ul class="list-group list-group-flush">
                                                            @foreach (var item in po.PurchaseOrderItems)
                                                            {
                                                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                                    <span>@item.Product?.ProductName</span>
                                                                    <span class="fw-bold">x @item.Quantity</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-uppercase">Assign Delivery Agent (Optional)</label>
                                                        <select name="deliveryAgentId" class="form-select rounded-3">
                                                            <option value="">-- Select Agent --</option>
                                                            <!-- Note: Ensure ViewBag.DeliveryAgents is populated in controller if using this -->
                                                        </select>
                                                        <div class="form-text">You can assign an agent later if needed.</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                                                        <i class="fas fa-check-circle me-1"></i> Confirm Ready
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-clipboard-check fa-3x"></i>
                                    </div>
                                    <h5 class="text-muted">No POs pending fulfillment.</h5>
                                    <p class="text-muted small">All specific POs assigned to this warehouse have been processed.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
