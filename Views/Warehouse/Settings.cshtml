@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Hub Control Settings";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4 min-vh-100 warehouse-container">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-5 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="text-white mb-1 fw-bold"><i class="fas fa-warehouse text-accent-green me-3"></i>Hub Control Center</h2>
                            <p class="text-white-50 mb-0 opacity-75">Configure logistics parameters, manage inventory zones, and update security protocols.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-white bg-opacity-10 text-white border-0 rounded-pill px-4 py-2 shadow-sm fw-bold" onclick="location.reload()">
                                <i class="fas fa-sync-alt me-2"></i> Sync Hub Data
                            </button>
                        </div>
                    </div>
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-boxes fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <form asp-action="Settings" method="post" enctype="multipart/form-data" id="warehouseSettingsForm">
        <div class="row g-5">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="card border-0 shadow-premium rounded-5 sticky-top bg-white overflow-hidden" style="top: 20px;">
                    <div class="p-5 text-center border-bottom border-faint bg-faint-green">
                        <div class="position-relative d-inline-block mb-4">
                            <div class="bg-white rounded-circle shadow-premium d-flex align-items-center justify-content-center overflow-hidden border border-4 border-white" style="width: 120px; height: 120px; margin: 0 auto;">
                                <img src="@(string.IsNullOrEmpty(Model.ExistingProfilePhoto) ? "/img/avatars/default.png" : Model.ExistingProfilePhoto)" 
                                     id="sidebarPreview" 
                                     class="img-fluid h-100 w-100 object-fit-cover" 
                                     alt="Profile" />
                            </div>
                            <label for="ProfilePicture" class="btn btn-dark-green btn-sm position-absolute bottom-0 end-0 rounded-circle shadow-premium p-2 border border-2 border-white" style="cursor: pointer;">
                                <i class="fas fa-camera text-accent-green extra-small"></i>
                            </label>
                            <input asp-for="ProfilePicture" type="file" class="d-none" accept="image/*" onchange="previewImage(this)" />
                        </div>
                        <h5 class="fw-bold text-dark-green mb-1">@Model.FullName</h5>
                        <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 extra-small ls-1 uppercase fw-bold">Hub Manager</span>
                    </div>
                    <div class="p-4 bg-white">
                        <div class="nav flex-column nav-pills scm-pills" id="v-pills-tab" role="tablist">
                            <button class="nav-link active text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" data-bs-toggle="pill" data-bs-target="#v-pills-operational" type="button" role="tab">
                                <i class="fas fa-cog me-3 opacity-75"></i>Operations
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" data-bs-toggle="pill" data-bs-target="#v-pills-zones" type="button" role="tab">
                                <i class="fas fa-map-marked-alt me-3 opacity-75"></i>Inventory Zones
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                                <i class="fas fa-shield-alt me-3 opacity-75"></i>Security
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" data-bs-toggle="pill" data-bs-target="#v-pills-notifications" type="button" role="tab">
                                <i class="fas fa-bell me-3 opacity-75"></i>Alerts
                            </button>
                        </div>
                        <div class="mt-4 pt-4 border-top border-faint">
                            <button type="submit" class="btn btn-dark-green w-100 rounded-pill py-3 fw-bold shadow-premium">
                                <i class="fas fa-save me-2 text-accent-green"></i>Commit Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="tab-content">
                    <!-- Operational Parameters -->
                    <div class="tab-pane fade show active" id="v-pills-operational" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-tools text-accent-green me-2"></i>Logistics Configuration</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Manager Name</label>
                                        <input asp-for="FullName" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Electronic Mail</label>
                                        <input asp-for="Email" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="LowStockThreshold" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Global Low Stock Alarm</label>
                                        <input asp-for="LowStockThreshold" type="number" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DailyCutoffTime" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Dispatch Cutoff Window</label>
                                        <input asp-for="DailyCutoffTime" type="time" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DefaultWarehouseLocation" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Primary Receiving Dock</label>
                                        <input asp-for="DefaultWarehouseLocation" class="form-control scm-input" placeholder="e.g. Dock 4 / Main Floor" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DefaultPackingPriority" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Standard Prep Priority</label>
                                        <select asp-for="DefaultPackingPriority" class="form-select scm-input">
                                            <option value="Normal">Normal Operational</option>
                                            <option value="High">High Priority / Express</option>
                                            <option value="Urgent">Strategic Urgent</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Zones -->
                    <div class="tab-pane fade" id="v-pills-zones" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-layer-group text-accent-green me-2"></i>Strategic Zoning</h5>
                            </div>
                            <div class="card-body p-5">
                                <p class="text-muted small fw-bold mb-4 opacity-75">Define operational zones for specialized asset storage and picking workflows.</p>
                                <div class="row g-4">
                                        @{
                                            var allZones = new[] { "Cold Storage", "Hazardous Materials", "Bulk Assets", "Express Picking", "Secure Vault", "Returns Processing" };
                                            var selectedZones = Model.AssignedZones ?? new List<string>();
                                        }
                                    @foreach (var zone in allZones)
                                    {
                                        <div class="col-md-4">
                                            <div class="form-check custom-zone-check p-0">
                                                <input type="checkbox" name="AssignedZones" value="@zone" id="zone_@zone" class="d-none" @(selectedZones.Contains(zone) ? "checked" : "") />
                                                <label for="zone_@zone" class="zone-label border rounded-5 p-4 text-center d-block cursor-pointer transition-all">
                                                    <i class="fas @(zone.Contains("Cold") ? "fa-snowflake" : zone.Contains("Hazard") ? "fa-biohazard" : "fa-box") mb-3 fa-2x opacity-50"></i>
                                                    <span class="d-block fw-bold text-dark-green extra-small uppercase">@zone</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Security Hub -->
                    <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-key text-accent-green me-2"></i>Access Protocol</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label asp-for="CurrentPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Verify Identity</label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control scm-input" placeholder="Current master password" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">New Access Code</label>
                                        <input asp-for="NewPassword" type="password" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Repeat Code</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control scm-input" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerts & Notifications -->
                    <div class="tab-pane fade" id="v-pills-notifications" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-broadcast-tower text-accent-green me-2"></i>Hub Intelligence</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="list-group list-group-flush border-0">
                                    <div class="list-group-item px-0 py-4 border-faint bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Operational Task Alerts</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">Notify when new dispatch requests are issued.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="EnableTaskAlerts" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-4 border-faint bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Critical Reminders</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">System alerts for expiring batches or overdue prep tasks.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="EnableReminders" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-4 border-0 bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Voice-Guided Picking</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">Enable operational voice feedback for warehouse staff.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="EnableVoicePicking" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        .uppercase { text-transform: uppercase; }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .scm-pills .nav-link { color: var(--dark-green); border: 1px solid transparent; opacity: 0.7; }
        .scm-pills .nav-link:hover { background-color: var(--faint-green); opacity: 1; }
        .scm-pills .nav-link.active { background-color: var(--dark-green); color: var(--accent-green); opacity: 1; box-shadow: 0 5px 15px rgba(26, 61, 49, 0.2); }

        .scm-input { 
            background-color: var(--faint-green); 
            border: 2px solid transparent; 
            border-radius: 100px; 
            padding: 0.8rem 1.5rem; 
            font-weight: 600; 
            color: var(--dark-green);
            transition: all 0.3s ease;
        }
        .scm-input:focus { 
            background-color: white; 
            border-color: var(--accent-green); 
            box-shadow: 0 5px 20px rgba(212, 240, 109, 0.15); 
            outline: none;
        }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        .fa-spin-slow { animation: fa-spin 10s infinite linear; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.05); color: #198754; }

        .zone-label { cursor: pointer; border-color: var(--faint-green); background: white; }
        .custom-zone-check input:checked + .zone-label { 
            background: var(--dark-green); 
            border-color: var(--dark-green); 
            color: var(--accent-green) !important; 
        }
        .custom-zone-check input:checked + .zone-label i, 
        .custom-zone-check input:checked + .zone-label span { 
            color: var(--accent-green) !important; 
            opacity: 1 !important; 
        }

        .object-fit-cover { object-fit: cover; }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#sidebarPreview').attr('src', e.target.result);
                    toastr.info('Identity preview updated. Commit changes to save.');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
