@model SCM_System.Models.ViewModels.WarehouseManagerSettingsViewModel
@{
    ViewData["Title"] = "Warehouse Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-3 px-4 border-0">
                    <h5 class="fw-bold mb-0 text-white"><i class="fas fa-cog me-2"></i> Operational Settings</h5>
                    <p class="text-white-50 mb-0 small">Customize your warehouse management experience</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Settings" method="post">
                        <input type="hidden" asp-for="EmployeeId" />

                        <!-- Location Settings -->
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Location & Facilities</h6>
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label asp-for="DefaultWarehouseLocation" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="fas fa-map-marker-alt text-primary"></i></span>
                                    <input asp-for="DefaultWarehouseLocation" class="form-control bg-light border-0" placeholder="e.g. Zone A, Rack 42" />
                                </div>
                                <span asp-validation-for="DefaultWarehouseLocation" class="text-danger small"></span>
                                <div class="form-text extra-small mt-1 text-muted">This location will be defaulted for new stock in tasks.</div>
                            </div>
                        </div>

                        <!-- Inventory Controls -->
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Inventory Logic</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="LowStockThreshold" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="fas fa-exclamation-triangle text-warning"></i></span>
                                    <input asp-for="LowStockThreshold" type="number" class="form-control bg-light border-0" />
                                </div>
                                <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                                <div class="form-text extra-small mt-1 text-muted">Alerts will trigger when items fall below this quantity.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PicklistFormat" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="fas fa-file-invoice text-info"></i></span>
                                    <select asp-for="PicklistFormat" class="form-select bg-light border-0">
                                        <option value="Detailed">Detailed (Full Info)</option>
                                        <option value="Summary">Summary (Compact)</option>
                                        <option value="Minimal">Minimal (Ids Only)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="PicklistFormat" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Automation & Notifications -->
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Automation & Alerts</h6>
                        <div class="card bg-light border-0 rounded-3 mb-4">
                            <div class="card-body p-3">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="AutoAcceptPickTasks" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="AutoAcceptPickTasks" class="form-check-label small fw-bold text-dark">Auto-Accept Incoming Pick Tasks</label>
                                    <p class="mb-0 extra-small text-muted">Enable to skip manual acceptance of assigned purchase orders.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="NotifyLowStock" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="NotifyLowStock" class="form-check-label small fw-bold text-dark">Real-time Low Stock Notifications</label>
                                    <p class="mb-0 extra-small text-muted">Receive dashboard alerts immediately when threshold is hit.</p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                            <a asp-action="Dashboard" class="btn btn-light rounded-pill px-4 fw-bold">
                                <i class="fas fa-arrow-left me-2"></i> Back to Hub
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">
                                <i class="fas fa-save me-2"></i> Save Preferences
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
