@{
    ViewData["Title"] = "Data Privacy Framework";
}

<!-- Hero Section -->
<div class="policy-hero bg-primary text-white position-relative overflow-hidden py-5 mb-5 rounded-bottom-5">
    <!-- Decorative background -->
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background: radial-gradient(circle at 10% 20%, #fff 0%, transparent 40%);"></div>
    <div class="container position-relative z-index-2 py-4 text-center">
        <div class="badge bg-white bg-opacity-25 text-white rounded-pill px-4 py-2 mb-4 fs-6" data-aos="fade-down" style="backdrop-filter: blur(5px);">
            <i class="fas fa-shield-alt me-2 text-warning"></i> Verified Secure Framework
        </div>
        <h1 class="display-4 fw-bolder mb-3 text-shadow-sm" data-aos="fade-up">EthioChain Privacy Policy</h1>
        <p class="lead text-white text-opacity-75 mb-0 fw-light" data-aos="fade-up" data-aos-delay="100">Our absolute commitment to Ethiopian Data Sovereignty.</p>
        <p class="small text-white text-opacity-50 mt-3 letter-spacing-1 text-uppercase fw-bold" data-aos="fade-up" data-aos-delay="200">Effective: April 2026</p>
    </div>
</div>

<div class="container mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="row g-4">
                
                <!-- Section 1 -->
                <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift policy-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="icon-wrapper bg-primary bg-opacity-10 text-primary rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fas fa-server fs-3"></i>
                            </div>
                            <h4 class="fw-bold mb-3 text-dark">Data Localization</h4>
                            <p class="text-muted lh-lg mb-0 text-justify">EthioChain SCM is committed to Ethiopian data sovereignty. All critical supply chain telemetry, business licensing documents, and transaction records are encrypted and hosted on secure servers residing strictly within Ethiopia, complying fully with the Ethiopian Data Protection Proclamation.</p>
                        </div>
                    </div>
                </div>

                <!-- Section 2 -->
                <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift policy-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="icon-wrapper bg-success bg-opacity-10 text-success rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fas fa-fingerprint fs-3"></i>
                            </div>
                            <h4 class="fw-bold mb-3 text-dark">Fayda Registry Data</h4>
                            <p class="text-muted lh-lg mb-0 text-justify">When you verify your identity via the Fayda system, EthioChain securely receives only essential verification attributes (Full Name, Date of Birth). This data is never sold to third parties and is exclusively used to maintain a highly trusted B2B logistics ecosystem.</p>
                        </div>
                    </div>
                </div>

                <!-- Section 3 -->
                <div class="col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift policy-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="icon-wrapper bg-info bg-opacity-10 text-info rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fas fa-map-marked-alt fs-3"></i>
                            </div>
                            <h4 class="fw-bold mb-3 text-dark">Supply Chain Tracking</h4>
                            <p class="text-muted lh-lg mb-0 text-justify">To provide real-time updates to retailers and vendors, operational tracking data such as milestone completions and warehouse checkpoints are securely recorded. This data is strictly used for ensuring delivery transparency across regional routes and calculated procurement paths.</p>
                        </div>
                    </div>
                </div>

                <!-- Section 4 -->
                <div class="col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift policy-card">
                        <div class="card-body p-4 p-lg-5">
                            <div class="icon-wrapper bg-warning bg-opacity-10 text-warning rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fas fa-user-lock fs-3"></i>
                            </div>
                            <h4 class="fw-bold mb-3 text-dark">Enterprise Rights</h4>
                            <p class="text-muted lh-lg mb-0 text-justify">You reserve the right to request a complete export of your enterprise's transaction ledger, inventory history, and data profile. Requests for account deletion will be processed within the legally mandated timeframe, preserving only data strictly required for financial auditing under ERCA.</p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="text-center mt-5 pt-4" data-aos="zoom-in" data-aos-delay="500">
                <hr class="border-secondary opacity-10 mb-4" />
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <img src="~/images/ethiochain-logo.jpg" alt="Logo" class="rounded-3 shadow-sm" style="width: 32px; height: 32px;" />
                </div>
                <p class="small text-muted fw-bold">© 2026 EthioChain SCM. Your digital supply chain, secured.</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        .policy-hero {
            background: linear-gradient(135deg, #0b3d60 0%, #07253b 100%);
            box-shadow: 0 10px 30px rgba(11, 61, 96, 0.4);
        }
        .text-shadow-sm { text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
        .letter-spacing-1 { letter-spacing: 1px; }
        .hover-lift {
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        }
        .hover-lift:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.1) !important;
        }
        .policy-card {
            border-top: 4px solid transparent !important;
            transition: all 0.3s;
            background-color: #ffffff;
        }
        .policy-card:hover { border-top-color: #0b3d60 !important; }
        .text-justify { text-align: justify; }
        p { font-size: 0.95rem; }
        .z-index-2 { z-index: 2; }
    </style>
}
@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
}