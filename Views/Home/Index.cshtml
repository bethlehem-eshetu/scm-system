@{
    ViewData["Title"] = "EthioChain SCM - The Central Nervous System of African Trade";
}

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --ethio-blue: #0b3d60;
            --ethio-blue-dark: #07253b;
            --ethio-gold: #cba052;
            --ethio-gold-light: #e6c587;
            --bg-surface: #f8f9fc;
        }

        /* Fullscreen Video Background */
        .video-background {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
        }
        .video-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, rgba(7, 37, 59, 0.85) 0%, rgba(11, 61, 96, 0.70) 50%, rgba(7, 37, 59, 0.95) 100%);
            z-index: -1;
        }

        /* Hero Section */
        .hero-section {
            position: relative; min-height: 100vh; display: flex; align-items: center; padding: 120px 0 80px; z-index: 1;
        }
        .hero-title { font-size: 4rem; line-height: 1.1; letter-spacing: -0.02em; text-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        @@media (max-width: 991.98px) { .hero-title { font-size: 3rem; } }
        
        .text-gradient-gold {
            background: linear-gradient(90deg, var(--ethio-gold-light) 0%, var(--ethio-gold) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* Buttons */
        .btn-brand {
            background: linear-gradient(135deg, var(--ethio-gold) 0%, #a67c33 100%);
            color: #fff !important; border: none; font-weight: 700;
            padding: 1rem 2.5rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 1px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 20px rgba(203, 160, 82, 0.3);
        }
        .btn-brand:hover { transform: translateY(-3px); box-shadow: 0 15px 25px rgba(203, 160, 82, 0.5); }
        
        .btn-outline-glass {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2);
            color: #fff !important; font-weight: 700; padding: 1rem 2.5rem; border-radius: 50px;
            text-transform: uppercase; letter-spacing: 1px;  backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }
        .btn-outline-glass:hover { background: rgba(255,255,255,1); color: var(--ethio-blue-dark) !important; transform: translateY(-3px); }

        /* Trust Badges */
        .trust-badge-group { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2rem; margin-top: 4rem; }
        .trust-element { filter: grayscale(1) brightness(2); opacity: 0.6; transition: all 0.3s; font-family: monospace; font-size: 1.5rem; }
        .trust-element:hover { filter: grayscale(0) brightness(1); opacity: 1; transform: scale(1.05); }

        /* Sections */
        .bg-light-surface { background-color: var(--bg-surface); position: relative; z-index: 2; padding: 100px 0; }
        .bg-white-pure { background-color: #ffffff; position: relative; z-index: 2; padding: 100px 0; }

        /* Feature Cards */
        .premium-card {
            background: #fff; border-radius: 20px; border: none; padding: 3rem 2rem;
            box-shadow: 0 20px 40px -10px rgba(11, 61, 96, 0.08);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .premium-card:hover { transform: translateY(-10px); box-shadow: 0 30px 60px -15px rgba(11, 61, 96, 0.15); }
        .icon-circle {
            width: 80px; height: 80px; border-radius: 50%;
            background: linear-gradient(135deg, rgba(11, 61, 96, 0.05) 0%, rgba(11, 61, 96, 0.15) 100%);
            display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;
            color: var(--ethio-blue); font-size: 2rem;
        }

        /* Timeline / Pipeline */
        .timeline-step { text-align: center; position: relative; z-index: 2; }
        .timeline-icon {
            width: 70px; height: 70px; margin: 0 auto 1.5rem; border-radius: 50%;
            background: #fff; box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; color: var(--ethio-gold); border: 2px solid var(--ethio-gold);
            position: relative; z-index: 2; transition: all 0.3s ease;
        }
        .timeline-step:hover .timeline-icon { background: var(--ethio-gold); color: #fff; transform: scale(1.1); }
        .timeline-line {
            position: absolute; top: 35px; left: 50%; width: 100%; height: 2px;
            background: linear-gradient(90deg, var(--ethio-gold) 0%, rgba(203, 160, 82, 0.2) 100%);
            z-index: 1;
        }

        /* CTA */
        .cta-box {
            background: linear-gradient(135deg, var(--ethio-blue) 0%, var(--ethio-blue-dark) 100%);
            border-radius: 30px; padding: 4rem; position: relative; overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(11, 61, 96, 0.5);
        }
        .cta-bg-motif {
            position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(203, 160, 82, 0.1) 0%, transparent 60%); z-index: 0;
            animation: rotateSlow 30s linear infinite;
        }
        @@keyframes rotateSlow { 100% { transform: rotate(360deg); } }
    </style>
}

<!-- Fullscreen Video Background -->
<video class="video-background" autoplay muted loop playsinline>
    <source src="~/videos/HOME.mp4" type="video/mp4">
</video>
<div class="video-overlay"></div>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container position-relative z-index-2">
        <div class="row align-items-center">
            <div class="col-lg-8" data-aos="fade-up" data-aos-duration="1000">
                <div class="badge bg-white bg-opacity-10 text-white px-4 py-2 rounded-pill mb-4 border border-white border-opacity-25" style="backdrop-filter: blur(5px);">
                    <i class="fas fa-shield-alt me-2 text-warning"></i> National Supply Chain Network
                </div>
                <h1 class="fw-bolder hero-title text-white mb-4">
                    The Central Nervous System of <br />
                    <span class="text-gradient-gold">African Trade.</span>
                </h1>
                <p class="lead text-white text-opacity-75 mb-5 fw-light" style="max-width: 650px; font-size: 1.25rem;">
                    Empowering retailers and suppliers across Ethiopia with high-fidelity milestone tracking, intelligent procurement deployment, and automated logistics validation.
                </p>
                <div class="d-flex flex-wrap gap-4">
                    @if (Context.Session.GetInt32("UserId") == null)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-brand">
                            <i class="fas fa-building me-2"></i> Onboard Now
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-glass">
                            <i class="fas fa-desktop me-2"></i> Command Center
                        </a>
                    }
                    else
                    {
                        <a href="/@Context.Session.GetString("UserRole")/Dashboard" class="btn btn-brand">
                            <i class="fas fa-columns me-2"></i> Access Dashboard
                        </a>
                    }
                </div>
                
                <div class="trust-badge-group">
                    <p class="small fw-bold text-white text-opacity-50 text-uppercase letter-spacing-1 mb-4">Integrated with core infrastructures</p>
                    <div class="d-flex align-items-center flex-wrap gap-4 gap-md-5">
                        <div class="trust-element text-white fw-bold"><i class="fas fa-university me-2"></i>NBE</div>
                        <div class="trust-element text-white fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i>ERCA</div>
                        <div class="trust-element text-white fw-bold"><i class="fas fa-id-card me-2"></i>FAYDA</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Grid -->
<section class="bg-light-surface">
    <div class="container">
        <div class="text-center mb-5 pb-4" data-aos="fade-up">
            <h2 class="display-5 fw-bolder text-dark-blue mb-3">System Core Capabilities</h2>
            <p class="text-muted lead mx-auto" style="max-width: 700px;">Experience a seamlessly integrated digital ecosystem engineered for unprecedented operational speed and end-to-end transparency.</p>
        </div>
        <div class="row g-5">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Smart Bidding</h4>
                    <p class="text-muted mb-0">Broadcast procurement tenders instantly and receive competitive bids with algorithmic tracking of performance.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Network Hub</h4>
                    <p class="text-muted mb-0">Total multi-facility visibility. Manage complex stock allocations, digital manifests, and strictly controlled routing.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-route"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Logistics Pulse</h4>
                    <p class="text-muted mb-0">Zero-blindspot delivery records. Deploy agents, monitor milestone checklists, and execute electronic handshakes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="bg-white-pure">
    <div class="container">
        <div class="text-center mb-5 pb-5" data-aos="fade-up">
            <h2 class="display-5 fw-bolder text-dark-blue mb-3">The Fulfillment Pipeline</h2>
            <p class="text-muted lead mx-auto" style="max-width: 600px;">The definitive standard protocol for converting operational friction into automated delivery.</p>
        </div>
        <div class="row g-4 justify-content-center px-4">
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="100">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-file-contract fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">1. Initiate</h5>
                    <p class="small text-muted">Submit secure B2B request.</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="200">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-clipboard-check fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">2. Approve</h5>
                    <p class="small text-muted">Issue PO verification.</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="300">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-box-open fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">3. Stage</h5>
                    <p class="small text-muted">Warehouse pack & manifest.</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="400">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-truck-loading fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">4. Dispatch</h5>
                    <p class="small text-muted">Secure transit verification.</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="500">
                <div class="timeline-step">
                    <div class="timeline-icon"><i class="fas fa-satellite-dish fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">5. Monitor</h5>
                    <p class="small text-muted">Live synchronization.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="bg-light-surface">
    <div class="container" data-aos="zoom-in">
        <div class="cta-box text-center text-white">
            <div class="cta-bg-motif"></div>
            <div class="position-relative z-index-2">
                <h2 class="display-5 fw-bolder mb-4">Digitize your supply chain.</h2>
                <p class="lead text-white text-opacity-75 mb-5 mx-auto" style="max-width: 600px;">
                    Integrate your enterprise into Ethiopia's most secure and expansive B2B logistics network today.
                </p>
                <div class="d-flex justify-content-center gap-4">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-brand btn-lg">
                        Execute Onboarding
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>
}