@{
    ViewData["Title"] = "Home - EthioChain SCM";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="hero-tagline">
                    <i class="fas fa-bolt"></i>
                    <span>ELEVATE YOUR SUPPLY CHAIN WITH US</span>
                </div>
                <h1 class="hero-title">
                    Empowering Your <br />
                    Success with <span>Digital SCM.</span>
                </h1>
                <p class="hero-desc">
                    Streamline your procurement, inventory, and logistics with Ethiopia's most intuitive digital supply chain platform built specifically for SMEs.
                </p>
                <div class="hero-btns">
                    <a href="/Account/Register" class="btn btn-explore btn-lg">Explore More <i class="fas fa-arrow-right ms-2"></i></a>
                    <a href="#features" class="btn btn-view-all btn-lg">View All Services</a>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="hero-bento mt-5 mt-lg-0">
                    <div class="bento-item bento-1">
                        <img src="~/images/anime-warehouse.png" alt="Warehouse">
                        <div class="bento-badge">SMART STORAGE</div>
                    </div>
                    <div class="bento-item bento-2">
                        <img src="~/images/anime-delivery.png" alt="Delivery">
                        <div class="bento-badge">FAST LOGISTICS</div>
                    </div>
                    <div class="bento-item bento-3">
                        <img src="~/images/anime-analytics.png" alt="Analytics">
                        <div class="bento-badge">LIVE INSIGHTS</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section" id="features">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <h2 class="mb-4">Everything you need to grow</h2>
            <p>From manual chaos to digital clarity — our tools are built to help you scale.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-handshake"></i></div>
                    <h4 class="fw-bold mb-3">Smart Bidding</h4>
                    <p class="text-muted">Post procurement requests and compare quotes instantly. Save up to 40% on sourcing costs.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-warehouse"></i></div>
                    <h4 class="fw-bold mb-3">Inventory Hub</h4>
                    <p class="text-muted">Real-time stock tracking across multiple locations. Never lose track of your inventory again.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-route"></i></div>
                    <h4 class="fw-bold mb-3">Delivery Tracker</h4>
                    <p class="text-muted">GPS-verified logistics. Share real-time status with your customers for ultimate transparency.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="about-section" id="about">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <img src="~/images/anime-analytics.png" alt="About EthioChain" class="about-img">
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0 ps-lg-5" data-aos="fade-left">
                <h2 class="fw-bold mb-4" style="color: var(--brand-green-dark); font-size: 2.5rem;">Who We Are</h2>
                <p class="lead mb-4">EthioChain is Ethiopia's leading digital supply chain ecosystem, built to empower SMEs with enterprise-grade tools.</p>
                <p class="text-muted mb-5">We bridge the gap between local retailers and global-standard logistics. Our mission is to digitize every step of the supply chain, ensuring transparency, efficiency, and growth for every business in our network.</p>
                <a asp-controller="Home" asp-action="About" class="btn btn-demo px-4 py-2">Learn More About Our Journey</a>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section" data-aos="zoom-in">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3>500+</h3>
                    <p>Active Retailers</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3>200+</h3>
                    <p>Verified Suppliers</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3>2.5K</h3>
                    <p>Monthly Orders</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <h3>99%</h3>
                    <p>Delivery Rate</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="contact-section" id="contact">
    <div class="container">
        <div class="contact-card" data-aos="fade-up">
            <div class="row">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <h2 class="fw-bold mb-4" style="color: var(--brand-green-dark);">Get in touch</h2>
                    <p class="text-muted mb-5">Have questions? Our team is here to help you get onboarded and scale your operations.</p>
                    <div class="d-flex align-items-center mb-4">
                        <div class="feature-icon mb-0 me-3"><i class="fas fa-envelope"></i></div>
                        <div>
                            <h6 class="fw-bold mb-0">Email us</h6>
                            <span class="text-muted">support@ethiochain.com</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="feature-icon mb-0 me-3"><i class="fas fa-phone"></i></div>
                        <div>
                            <h6 class="fw-bold mb-0">Call us</h6>
                            <span class="text-muted">+251 911 223344</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <form>
                        <div class="mb-3">
                            <input type="text" class="form-control" placeholder="Your Name">
                        </div>
                        <div class="mb-3">
                            <input type="email" class="form-control" placeholder="Your Email">
                        </div>
                        <div class="mb-3">
                            <textarea class="form-control" rows="4" placeholder="Your Message"></textarea>
                        </div>
                        <button type="submit" class="btn btn-demo w-100 py-3">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container" data-aos="flip-up">
        <div class="cta-container">
            <h2 class="display-5 fw-bold mb-4">Ready to modernize your business?</h2>
            <p class="lead mb-5 opacity-75">Join hundreds of Ethiopian SMEs already scaling with EthioChain.</p>
            <a href="/Account/Register" class="btn btn-explore btn-lg px-5 py-3">Start Your Free Trial</a>
        </div>
    </div>
</section>

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        :root {
            --brand-green: #4da699;
            --brand-green-dark: #1a3d31;
            --brand-green-light: #e0f2ef;
            --brand-green-hue: #f4fcfb;
            --text-dark: #1a1a1a;
            --text-muted: #666666;
            --font-main: 'Plus Jakarta Sans', sans-serif;
        }

        /* Hero Section */
        .hero-section {
            padding: 80px 0 120px;
            background: radial-gradient(circle at top right, #e6f7f4, var(--brand-green-hue));
            position: relative;
            overflow: hidden;
        }

        .hero-tagline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--brand-green-light);
            color: var(--brand-green-dark);
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 25px;
        }

        .hero-title {
            font-size: 4rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 25px;
            color: var(--brand-green-dark);
        }
        .hero-title span { color: var(--brand-green); }

        .hero-desc {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            max-width: 550px;
            line-height: 1.6;
        }

        .hero-btns { display: flex; gap: 20px; }
        .btn-explore {
            background: var(--brand-green-dark);
            color: white !important;
            padding: 15px 35px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 20px 40px rgba(26, 61, 49, 0.2);
            text-decoration: none;
        }
        .btn-view-all {
            background: transparent;
            color: var(--brand-green-dark) !important;
            padding: 15px 35px;
            border-radius: 50px;
            font-weight: 700;
            border: 2px solid transparent;
            text-decoration: none;
        }
        .btn-view-all:hover { color: var(--brand-green) !important; }

        /* Bento Grid */
        .hero-bento {
            position: relative;
            height: 550px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 20px;
        }
        .bento-item {
            position: relative;
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.1);
            background: #ffffff;
        }
        .bento-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }
        .bento-item:hover img { transform: scale(1.05); }

        .bento-1 { grid-row: span 2; }
        .bento-2 { grid-column: span 1; }
        .bento-3 { grid-column: span 1; }

        .bento-badge {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: white;
            padding: 10px 20px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.75rem;
            color: var(--brand-green-dark);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            z-index: 2;
        }

        /* Features Section */
        .features-section { padding: 100px 0; background: #ffffff; }
        .section-header { text-align: center; margin-bottom: 60px; }
        .section-header h2 { font-size: 3rem; font-weight: 800; color: var(--brand-green-dark); }
        .section-header p { color: var(--text-muted); font-size: 1.1rem; }

        .feature-card {
            padding: 40px;
            border-radius: 30px;
            background: #ffffff;
            border: 1px solid #e0f2ef;
            transition: all 0.3s;
            height: 100%;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 60px rgba(77, 166, 153, 0.1);
            border-color: var(--brand-green);
        }
        .feature-icon {
            width: 60px;
            height: 60px;
            background: var(--brand-green-light);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--brand-green);
            margin-bottom: 25px;
        }

        /* About Section */
        .about-section { padding: 100px 0; background: var(--brand-green-hue); }
        .about-img { border-radius: 40px; box-shadow: 0 30px 60px rgba(0,0,0,0.1); width: 100%; }

        /* Stats Section */
        .stats-section { padding: 80px 0; background: var(--brand-green-dark); color: white; border-radius: 50px; margin: 0 20px 80px; }
        .stat-item h3 { font-size: 3rem; font-weight: 800; margin-bottom: 5px; color: var(--brand-green); }
        .stat-item p { font-size: 1rem; opacity: 0.8; }

        /* Contact Section */
        .contact-section { padding: 100px 0; background: #ffffff; }
        .contact-card { background: var(--brand-green-hue); border-radius: 40px; padding: 50px; }
        .form-control { border-radius: 15px; padding: 15px; border: 2px solid #e0f2ef; }
        .form-control:focus { border-color: var(--brand-green); box-shadow: none; }

        /* CTA Section */
        .cta-section { padding: 80px 0; text-align: center; }
        .cta-container {
            background: linear-gradient(135deg, var(--brand-green-dark) 0%, #122921 100%);
            padding: 80px 40px;
            border-radius: 40px;
            color: white;
            position: relative;
            overflow: hidden;
        }

        @@media (max-width: 992px) {
            .hero-title { font-size: 2.5rem; }
            .hero-bento { height: auto; grid-template-columns: 1fr; grid-template-rows: auto; }
            .bento-1 { grid-row: auto; height: 300px; }
            .bento-2, .bento-3 { height: 200px; }
            .hero-btns { flex-direction: column; }
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
        
        window.addEventListener('scroll', function() {
            const nav = document.querySelector('.navbar');
            if (nav && window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else if (nav) {
                nav.classList.remove('scrolled');
            }
        });
    </script>
}
