@{
    ViewData["Title"] = "EthioChain SCM - The Digital Backbone for SMEs";
}

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --ethio-blue: #0b3d60;
            --ethio-blue-dark: #07253b;
            --ethio-gold: #cba052;
            --ethio-gold-light: #e6c587;
            --bg-surface: #f8f9fc;
        }

        /* Fullscreen Video Background */
        .video-background {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
        }
        .video-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, rgba(7, 37, 59, 0.85) 0%, rgba(11, 61, 96, 0.70) 50%, rgba(7, 37, 59, 0.95) 100%);
            z-index: -1;
        }

        /* Hero Section */
        .hero-section {
            position: relative; min-height: 100vh; display: flex; align-items: center; padding: 120px 0 80px; z-index: 1;
        }
        .hero-title { font-size: 4rem; line-height: 1.1; letter-spacing: -0.02em; text-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        @@media (max-width: 991.98px) { .hero-title { font-size: 3rem; } }
        
        .text-gradient-gold {
            background: linear-gradient(90deg, var(--ethio-gold-light) 0%, var(--ethio-gold) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* Buttons */
        .btn-brand {
            background: linear-gradient(135deg, var(--ethio-gold) 0%, #a67c33 100%);
            color: #fff !important; border: none; font-weight: 700;
            padding: 1rem 2.5rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 1px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 20px rgba(203, 160, 82, 0.3);
        }
        .btn-brand:hover { transform: translateY(-3px); box-shadow: 0 15px 25px rgba(203, 160, 82, 0.5); }
        
        .btn-outline-glass {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2);
            color: #fff !important; font-weight: 700; padding: 1rem 2.5rem; border-radius: 50px;
            text-transform: uppercase; letter-spacing: 1px;  backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }
        .btn-outline-glass:hover { background: rgba(255,255,255,1); color: var(--ethio-blue-dark) !important; transform: translateY(-3px); }

        /* Trust Badges */
        .trust-badge-group { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2rem; margin-top: 4rem; }
        .trust-element { filter: grayscale(1) brightness(2); opacity: 0.6; transition: all 0.3s; font-family: monospace; font-size: 1.5rem; }
        .trust-element:hover { filter: grayscale(0) brightness(1); opacity: 1; transform: scale(1.05); }

        /* Sections */
        .bg-light-surface { background-color: var(--bg-surface); position: relative; z-index: 2; padding: 100px 0; }
        .bg-white-pure { background-color: #ffffff; position: relative; z-index: 2; padding: 100px 0; }

        /* Feature Cards */
        .premium-card {
            background: #fff; border-radius: 20px; border: none; padding: 3rem 2rem;
            box-shadow: 0 20px 40px -10px rgba(11, 61, 96, 0.08);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .premium-card:hover { transform: translateY(-10px); box-shadow: 0 30px 60px -15px rgba(11, 61, 96, 0.15); }
        .icon-circle {
            width: 80px; height: 80px; border-radius: 50%;
            background: linear-gradient(135deg, rgba(11, 61, 96, 0.05) 0%, rgba(11, 61, 96, 0.15) 100%);
            display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;
            color: var(--ethio-blue); font-size: 2rem;
        }

        /* Timeline / Pipeline */
        .timeline-step { text-align: center; position: relative; z-index: 2; }
        .timeline-icon {
            width: 70px; height: 70px; margin: 0 auto 1.5rem; border-radius: 50%;
            background: #fff; box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; color: var(--ethio-gold); border: 2px solid var(--ethio-gold);
            position: relative; z-index: 2; transition: all 0.3s ease;
        }
        .timeline-step:hover .timeline-icon { background: var(--ethio-gold); color: #fff; transform: scale(1.1); }
        .timeline-line {
            position: absolute; top: 35px; left: 50%; width: 100%; height: 2px;
            background: linear-gradient(90deg, var(--ethio-gold) 0%, rgba(203, 160, 82, 0.2) 100%);
            z-index: 1;
        }

        /* CTA */
        .cta-box {
            background: linear-gradient(135deg, var(--ethio-blue) 0%, var(--ethio-blue-dark) 100%);
            border-radius: 30px; padding: 4rem; position: relative; overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(11, 61, 96, 0.5);
        }
        .cta-bg-motif {
            position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(203, 160, 82, 0.1) 0%, transparent 60%); z-index: 0;
            animation: rotateSlow 30s linear infinite;
        }
        @@keyframes rotateSlow { 100% { transform: rotate(360deg); } }
        
        /* SME-specific badge */
        .sme-badge {
            background: rgba(203, 160, 82, 0.2);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(203, 160, 82, 0.4);
        }
        .sme-stat-card {
            transition: all 0.3s ease;
        }
        .sme-stat-card:hover {
            transform: translateY(-5px);
        }
    </style>
}

<!-- Fullscreen Video Background -->
<video class="video-background" autoplay muted loop playsinline>
    <source src="~/videos/HOME.mp4" type="video/mp4">
</video>
<div class="video-overlay"></div>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container position-relative z-index-2">
        <div class="row align-items-center">
            <div class="col-lg-8" data-aos="fade-up" data-aos-duration="1000">
                <div class="sme-badge badge bg-white bg-opacity-10 text-white px-4 py-2 rounded-pill mb-4 border border-white border-opacity-25" style="backdrop-filter: blur(5px);">
                    <i class="fas fa-chart-line me-2 text-warning"></i> Built for Small & Medium Enterprises
                </div>
                <h1 class="fw-bolder hero-title text-white mb-4">
                    The Digital Backbone for <br />
                    <span class="text-gradient-gold">Small & Medium Supply Chains.</span>
                </h1>
                <p class="lead text-white text-opacity-75 mb-5 fw-light" style="max-width: 650px; font-size: 1.25rem;">
                    Empowering retailers, distributors, and local suppliers across Ethiopia with accessible milestone tracking, smart procurement, and automated logistics — no enterprise overhead required.
                </p>
                <div class="d-flex flex-wrap gap-4">
                    @if (Context.Session.GetInt32("UserId") == null)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-brand">
                            <i class="fas fa-building me-2"></i> Start Free Trial
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-glass">
                            <i class="fas fa-desktop me-2"></i> Business Login
                        </a>
                    }
                    else
                    {
                        <a href="/@Context.Session.GetString("UserRole")/Dashboard" class="btn btn-brand">
                            <i class="fas fa-columns me-2"></i> Access Dashboard
                        </a>
                    }
                </div>
                
                <!-- SME Trust Indicators -->
                <div class="trust-badge-group">
                    <p class="small fw-bold text-white text-opacity-50 text-uppercase letter-spacing-1 mb-4">Trusted by growing businesses across Ethiopia</p>
                    <div class="row g-3 mt-2">
                        <div class="col-sm-4">
                            <div class="d-flex align-items-center gap-2 text-white">
                                <i class="fas fa-store fs-4 text-gold"></i>
                                <div><small class="d-block text-white text-opacity-75">Retailers</small><strong class="fs-5">500+</strong></div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="d-flex align-items-center gap-2 text-white">
                                <i class="fas fa-truck fs-4 text-gold"></i>
                                <div><small class="d-block text-white text-opacity-75">Suppliers</small><strong class="fs-5">200+</strong></div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="d-flex align-items-center gap-2 text-white">
                                <i class="fas fa-chart-simple fs-4 text-gold"></i>
                                <div><small class="d-block text-white text-opacity-75">Monthly Orders</small><strong class="fs-5">2.5K+</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SME Value Proposition -->
<section class="bg-light-surface">
    <div class="container">
        <div class="text-center mb-5 pb-4" data-aos="fade-up">
            <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-3">Why SMEs Choose EthioChain</div>
            <h2 class="display-5 fw-bolder text-dark-blue mb-3">From manual chaos to digital clarity</h2>
            <p class="text-muted lead mx-auto" style="max-width: 700px;">We level the playing field — giving small businesses the same supply chain superpowers as industry giants.</p>
        </div>
        <div class="row g-5">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-coins"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Pay-as-you-grow</h4>
                    <p class="text-muted mb-0">No massive upfront costs. Scale your plan as your business expands — from single warehouse to multi-location operations.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Mobile-first design</h4>
                    <p class="text-muted mb-0">Manage your entire supply chain from your phone — perfect for business owners on the move across Ethiopia.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Amharic support</h4>
                    <p class="text-muted mb-0">Full platform support in Amharic and English, with local customer service and onboarding assistance.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Features Grid -->
<section class="bg-white-pure">
    <div class="container">
        <div class="text-center mb-5 pb-4" data-aos="fade-up">
            <h2 class="display-5 fw-bolder text-dark-blue mb-3">Everything you need to grow</h2>
            <p class="text-muted lead mx-auto" style="max-width: 700px;">Powerful tools designed specifically for Ethiopian SMEs — no complexity, no bloat.</p>
        </div>
        <div class="row g-5">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Smart Bidding</h4>
                    <p class="text-muted mb-0">Post procurement requests and compare supplier quotes. Find the best prices without endless phone calls.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Inventory Hub</h4>
                    <p class="text-muted mb-0">Know exactly what's in stock, what's moving, and what needs reordering — simple dashboards for real decisions.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="premium-card text-center h-100">
                    <div class="icon-circle shadow-sm">
                        <i class="fas fa-route"></i>
                    </div>
                    <h4 class="fw-bold text-dark-blue mb-3">Delivery Tracker</h4>
                    <p class="text-muted mb-0">Real-time visibility on every shipment. Share tracking links with customers and reduce "where's my order?" calls.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="bg-light-surface">
    <div class="container">
        <div class="text-center mb-5 pb-5" data-aos="fade-up">
            <h2 class="display-5 fw-bolder text-dark-blue mb-3">Simple as 1-2-3-4-5</h2>
            <p class="text-muted lead mx-auto" style="max-width: 600px;">From order to delivery — watch your business run like clockwork.</p>
        </div>
        <div class="row g-4 justify-content-center px-4">
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="100">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-file-contract fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">1. Request</h5>
                    <p class="small text-muted">Post what you need</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="200">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-clipboard-check fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">2. Compare</h5>
                    <p class="small text-muted">Review supplier bids</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="300">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-box-open fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">3. Pack</h5>
                    <p class="small text-muted">Warehouse prepares</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="400">
                <div class="timeline-step">
                    <div class="timeline-line d-none d-lg-block"></div>
                    <div class="timeline-icon"><i class="fas fa-truck-loading fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">4. Ship</h5>
                    <p class="small text-muted">Driver confirms pickup</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="500">
                <div class="timeline-step">
                    <div class="timeline-icon"><i class="fas fa-check-circle fs-4"></i></div>
                    <h5 class="fw-bold text-dark-blue">5. Receive</h5>
                    <p class="small text-muted">Digital proof of delivery</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Success Stats Section -->
<section class="bg-white-pure">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="100">
                <div class="sme-stat-card">
                    <div class="display-4 fw-bold text-gold mb-2">40%</div>
                    <p class="text-muted mb-0">Average cost reduction</p>
                    <small class="text-success">through smart bidding</small>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="200">
                <div class="sme-stat-card">
                    <div class="display-4 fw-bold text-gold mb-2">60%</div>
                    <p class="text-muted mb-0">Faster order processing</p>
                    <small class="text-success">from request to delivery</small>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="300">
                <div class="sme-stat-card">
                    <div class="display-4 fw-bold text-gold mb-2">99%</div>
                    <p class="text-muted mb-0">On-time delivery rate</p>
                    <small class="text-success">verified by GPS tracking</small>
                </div>
            </div>
            <div class="col-md-3 col-6" data-aos="fade-up" data-aos-delay="400">
                <div class="sme-stat-card">
                    <div class="display-4 fw-bold text-gold mb-2">24/7</div>
                    <p class="text-muted mb-0">Local support team</p>
                    <small class="text-success">Amharic & English</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="bg-light-surface">
    <div class="container" data-aos="zoom-in">
        <div class="cta-box text-center text-white">
            <div class="cta-bg-motif"></div>
            <div class="position-relative z-index-2">
                <h2 class="display-5 fw-bolder mb-4">Ready to grow your business?</h2>
                <p class="lead text-white text-opacity-75 mb-5 mx-auto" style="max-width: 600px;">
                    Join hundreds of Ethiopian SMEs already using EthioChain to streamline their supply chain and boost profits.
                </p>
                <div class="d-flex justify-content-center gap-4 flex-wrap">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-brand btn-lg px-5">
                        <i class="fas fa-rocket me-2"></i> Start Free Trial
                    </a>
                    <a href="#" class="btn btn-outline-glass btn-lg px-5" data-bs-toggle="modal" data-bs-target="#demoModal">
                        <i class="fas fa-calendar-alt me-2"></i> Book a Demo
                    </a>
                </div>
                <p class="mt-4 text-white text-opacity-50 small">No credit card required • Free 14-day trial • Cancel anytime</p>
            </div>
        </div>
    </div>
</section>

<!-- Demo Request Modal (Placeholder) -->
<div class="modal fade" id="demoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Schedule a free demo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Our team will reach out within 24 hours to schedule your personalized walkthrough.</p>
                <form>
                    <div class="mb-3">
                        <input type="text" class="form-control" placeholder="Your name">
                    </div>
                    <div class="mb-3">
                        <input type="email" class="form-control" placeholder="Email address">
                    </div>
                    <div class="mb-3">
                        <input type="tel" class="form-control" placeholder="Phone number">
                    </div>
                    <div class="mb-3">
                        <select class="form-select">
                            <option>Retail business</option>
                            <option>Wholesale / Distribution</option>
                            <option>Manufacturing</option>
                            <option>Logistics provider</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-brand w-100">Request Demo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
    </script>
}