@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-hero container-fluid p-0 overflow-hidden position-relative min-vh-100 d-flex align-items-center">
    <!-- Fullscreen Video Background -->
    <video class="position-absolute w-100 h-100" autoplay muted loop playsinline style="top: 0; left: 0; object-fit: cover; z-index: 0;">
        <source src="~/videos/HOME.mp4" type="video/mp4">
    </video>
    <!-- Dark Blue Overlay -->
    <div class="position-absolute w-100 h-100" style="top: 0; left: 0; background: linear-gradient(135deg, rgba(7, 37, 59, 0.85) 0%, rgba(11, 61, 96, 0.70) 50%, rgba(7, 37, 59, 0.95) 100%); z-index: 1;"></div>

    <div class="container position-relative z-index-2 py-5 mt-5">
        <div class="text-center mb-5 pb-3" data-aos="fade-down">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <div class="d-inline-flex align-items-center bg-white bg-opacity-75 px-4 py-2 rounded-pill mb-4 shadow-sm border border-white">
                <i class="fas fa-headset text-primary me-2 fs-5"></i>
                <span class="fw-bold tracking-wide text-uppercase text-primary small">Get In Touch</span>
            </div>
            <h1 class="display-4 fw-bolder text-white mb-3 hero-title">
                Let's Build the <span class="text-gradient">Future of Supply</span>
            </h1>
            <p class="lead text-white-50 mx-auto fw-light" style="max-width: 650px; font-size: 1.25rem;">
                Have questions about integrating with EthioChain SCM? Our enterprise support team is ready to help you optimize your operations.
            </p>
        </div>

        <div class="row g-5 mt-2 justify-content-center">
            <div class="col-lg-4" data-aos="fade-right" data-aos-delay="200">
                <div class="contact-info-card text-white p-5 rounded-5 h-100 shadow-lg position-relative overflow-hidden">
                    <div class="card-bg-overlay"></div>
                    <div class="position-relative z-index-2">
                        <h3 class="fw-bold mb-4">Contact Hub</h3>
                        <p class="mb-5 text-white-50 fw-medium">Direct channels to our technical and enterprise support teams.</p>
                        
                        <div class="d-flex align-items-center mb-4 contact-item group-hover">
                            <div class="icon-circle bg-white bg-opacity-10 p-3 rounded-circle me-4 shadow-sm transition-all">
                                <i class="fas fa-map-marker-alt fs-5 text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 tracking-wide text-uppercase small text-white-50">Headquarters</h6>
                                <p class="mb-0 fw-medium text-white">Addis Ababa, Ethiopia<br>Bole Sub-city, Woreda 03</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center mb-4 contact-item group-hover">
                            <div class="icon-circle bg-white bg-opacity-10 p-3 rounded-circle me-4 shadow-sm transition-all">
                                <i class="fas fa-phone-alt fs-5 text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 tracking-wide text-uppercase small text-white-50">Direct Line</h6>
                                <p class="mb-0 fw-medium text-white">+251 11 123 4567<br>+251 91 123 4567</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center contact-item group-hover">
                            <div class="icon-circle bg-white bg-opacity-10 p-3 rounded-circle me-4 shadow-sm transition-all">
                                <i class="fas fa-envelope fs-5 text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 tracking-wide text-uppercase small text-white-50">Digital Drop</h6>
                                <p class="mb-0 fw-medium text-white">support@ethiochain.com<br>info@ethiochain.com</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8" data-aos="fade-left" data-aos-delay="400">
                <div class="glass-panel p-5 rounded-5 shadow-lg border border-white h-100 d-flex flex-column justify-content-center text-center">
                    <div class="icon-circle bg-white bg-opacity-25 p-4 rounded-circle mx-auto mb-4 shadow-sm" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="fab fa-twitter fs-1 text-white"></i>
                    </div>
                    <h3 class="fw-bold mb-3 text-dark">We are on X</h3>
                    <p class="text-muted fw-medium mb-4">
                        For the fastest response, direct message our enterprise support team on X (formerly Twitter). Our specialists are standing by to assist you.
                    </p>
                    <a href="https://x.com/Ethiochain51103" target="_blank" rel="noopener noreferrer" class="btn btn-brand w-100 py-3 rounded-pill fw-bold text-uppercase tracking-wide shadow-brand btn-hover-effect position-relative overflow-hidden mt-auto">
                        <span class="position-relative z-index-2"><i class="fab fa-twitter me-2"></i> Message us on X <i class="fas fa-arrow-right ms-2 transition-transform"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        .contact-hero {
            background-color: transparent;
        }

        @@keyframes float {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(-30px) scale(1.05); }
        }

        .hero-title { letter-spacing: -0.02em; }
        .text-gradient {
            background: linear-gradient(90deg, #cba052 0%, #e6c587 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* Glassmorphism */
        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .contact-info-card {
            background: linear-gradient(135deg, #0b3d60 0%, #07253b 100%);
        }
        .card-bg-overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at top right, rgba(203, 160, 82, 0.2) 0%, transparent 60%);
            z-index: 1;
        }

        .group-hover:hover .icon-circle {
            background-color: #cba052 !important;
            transform: scale(1.1);
        }
        .group-hover:hover .icon-circle i {
            color: #0b3d60 !important;
        }

        /* Form Inputs */
        .custom-input {
            border: 1px solid rgba(11, 61, 96, 0.1);
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 12px;
            transition: all 0.3s ease;
            color: #0b3d60;
        }
        .custom-input:focus {
            background-color: #fff;
            border-color: #0b3d60;
            box-shadow: 0 0 0 4px rgba(11, 61, 96, 0.1);
        }

        /* Button */
        .btn-brand {
            background: linear-gradient(135deg, #0b3d60 0%, #07253b 100%);
            color: white; border: none; transition: all 0.4s ease;
        }
        .shadow-brand { box-shadow: 0 10px 25px -5px rgba(11, 61, 96, 0.4); }
        .btn-hover-effect::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease; z-index: 1;
        }
        .btn-hover-effect:hover::before { left: 100%; }
        .btn-hover-effect:hover {
            transform: translateY(-2px); color: white;
            box-shadow: 0 15px 30px -5px rgba(11, 61, 96, 0.5);
        }
        .btn-hover-effect:hover .transition-transform { transform: translateX(5px); }

        .transition-all { transition: all 0.3s ease; }
        .tracking-wide { letter-spacing: 0.1em; }
        .z-index-2 { z-index: 2; }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });
    </script>
}
