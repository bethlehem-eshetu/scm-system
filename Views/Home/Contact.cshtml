@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-page position-relative overflow-hidden">
    <!-- Hero Section with Original Video Feature -->
    <div class="contact-hero container-fluid p-0 overflow-hidden position-relative min-vh-75 d-flex align-items-center">
        <video class="position-absolute w-100 h-100" autoplay muted loop playsinline style="top: 0; left: 0; object-fit: cover; z-index: 0;">
            <source src="~/videos/HOME.mp4" type="video/mp4">
        </video>
        <!-- Green Theme Overlay -->
        <div class="position-absolute w-100 h-100" style="top: 0; left: 0; background: linear-gradient(135deg, rgba(26, 61, 49, 0.9) 0%, rgba(94, 158, 148, 0.7) 100%); z-index: 1;"></div>

        <div class="container position-relative z-index-2 py-5 text-center">
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 px-4 py-2 rounded-pill mb-4 shadow-sm border border-white border-opacity-25">
                <i class="fas fa-headset text-white me-2 fs-5"></i>
                <span class="fw-bold tracking-wide text-uppercase text-white small">Get In Touch</span>
            </div>
            <h1 class="display-3 fw-bolder text-white mb-3 hero-title">
                Let's Build the <span class="text-accent">Future of Supply</span>
            </h1>
            <p class="lead text-white-50 mx-auto fw-light" style="max-width: 650px; font-size: 1.25rem;">
                Have questions about integrating with EthioChain SCM? Our enterprise support team is ready to help you optimize your operations.
            </p>
        </div>
    </div>

    <!-- Info Cards Section (Influenca Style) -->
    <section class="info-cards-section py-5 mt-n5 position-relative z-index-3">
        <div class="container">
            <div class="row g-4 justify-content-center">
                <div class="col-md-4">
                    <div class="info-card p-5 rounded-5 h-100 shadow-premium bg-white">
                        <div class="info-icon mb-4 text-accent-green">
                            <i class="fas fa-phone-alt fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Direct Line</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">+251 11 123 4567</h4>
                        <p class="text-muted small mt-2">+251 91 123 4567</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="info-card p-5 rounded-5 h-100 shadow-premium bg-dark-green text-white">
                        <div class="info-icon mb-4 text-accent-green">
                            <i class="fas fa-envelope fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-uppercase small text-white-50 mb-2">Digital Drop</h6>
                        <h4 class="fw-bold mb-0">support@@ethiochain.com</h4>
                        <p class="text-white-50 small mt-2">info@@ethiochain.com</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="info-card p-5 rounded-5 h-100 shadow-premium bg-white">
                        <div class="info-icon mb-4 text-accent-green">
                            <i class="fas fa-map-marker-alt fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Headquarters</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">Addis Ababa, Ethiopia</h4>
                        <p class="text-muted small mt-2">Bole Sub-city, Woreda 03</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Message on X Section (Premium Style) -->
    <section class="social-section py-5">
        <div class="container">
            <div class="glass-panel p-5 rounded-5 shadow-lg border border-white d-flex flex-column align-items-center text-center bg-white bg-opacity-75">
                <div class="icon-circle bg-dark-green p-4 rounded-circle mb-4 shadow-sm" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                    <i class="fab fa-twitter fs-1 text-white"></i>
                </div>
                <h3 class="fw-bold mb-3 text-dark-green">We are on X</h3>
                <p class="text-muted fw-medium mb-4 mx-auto" style="max-width: 600px;">
                    For the fastest response, direct message our enterprise support team on X (formerly Twitter). Our specialists are standing by to assist you with real-time updates and support.
                </p>
                <a href="https://x.com/Ethiochain51103" target="_blank" rel="noopener noreferrer" class="btn btn-brand px-5 py-3 rounded-pill fw-bold text-uppercase tracking-wide shadow-brand btn-hover-effect">
                    <span><i class="fab fa-twitter me-2"></i> Message us on X <i class="fas fa-arrow-right ms-2"></i></span>
                </a>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #5e9e94;
            --light-bg: #f5f9f8;
            --white: #ffffff;
        }

        body {
            background-color: var(--light-bg);
        }

        .min-vh-75 { min-height: 75vh; }
        .mt-n5 { margin-top: -5rem; }
        .z-index-2 { z-index: 2; }
        .z-index-3 { z-index: 3; }

        .text-dark-green { color: var(--dark-green); }
        .text-accent-green { color: var(--accent-green); }
        .bg-dark-green { background-color: var(--dark-green); }
        .text-accent { color: var(--accent-green); }

        .hero-title { letter-spacing: -0.02em; }

        /* Card Styles */
        .shadow-premium {
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border: 1px solid rgba(0, 0, 0, 0.02);
        }

        .info-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.08);
        }

        /* Glassmorphism */
        .glass-panel {
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Button */
        .btn-brand {
            background: var(--dark-green);
            color: white;
            border: none;
            transition: all 0.4s ease;
        }

        .btn-brand:hover {
            background: var(--accent-green);
            color: white;
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(94, 158, 148, 0.3);
        }

        .tracking-wide { letter-spacing: 0.1em; }
    </style>
}
