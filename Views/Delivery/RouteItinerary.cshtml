@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Smart Route Itinerary";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    
    // Prepare destinations for the optimizer
    var destinationsList = new List<object>();
    var random = new Random();
    var index = 0;
    foreach (var po in Model)
    {
        destinationsList.Add(new {
            id = po.Id,
            poNumber = po.PONumber,
            businessName = po.Order?.Retailer?.BusinessName ?? "Retailer",
            address = po.DeliveryAddress ?? "Address not set",
            lat = 9.02 + (index * 0.12) + (random.NextDouble() * 0.05),
            lng = 38.75 + (index * 0.09) + (random.NextDouble() * 0.03),
            priority = po.Status == "In Transit" ? "High" : "Normal"
        });
        index++;
    }
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-route text-primary me-2"></i>Smart Route Itinerary
            </h2>
            <p class="text-muted mb-0">AI-powered route optimization for efficient deliveries</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary rounded-pill px-3" id="stopCount">@Model.Count() Stops Remaining</span>
            <button class="btn btn-sm btn-outline-primary" onclick="optimizeRoute()" id="optimizeBtn">
                <i class="fas fa-magic me-1"></i> Optimize Route
            </button>
            <button class="btn btn-sm btn-outline-secondary" onclick="centerUserLocation()">
                <i class="fas fa-location-dot me-1"></i> My Location
            </button>
        </div>
    </div>

    <!-- AI Recommendation Banner -->
    <div id="aiRecommendationBanner" class="alert alert-primary border-0 rounded-4 shadow-sm mb-4 animate-slide-down" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: none;">
        <div class="d-flex align-items-center gap-3">
            <div class="ai-icon">
                <i class="fas fa-robot fa-2x text-white"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="text-white mb-1 fw-bold">
                    <i class="fas fa-brain me-1"></i> AI Route Recommendation
                </h6>
                <p id="aiRecommendationText" class="text-white-50 mb-0 small">Optimizing route based on distance and priority...</p>
            </div>
            <button class="btn btn-sm btn-light rounded-pill" onclick="applyOptimizedRoute()">
                <i class="fas fa-check me-1"></i> Apply
            </button>
            <button class="btn-close btn-close-white" onclick="closeRecommendation()"></button>
        </div>
    </div>

    <!-- Status Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                            <i class="fas fa-truck text-primary fs-4"></i>
                        </div>
                        <div>
                            <div class="small text-muted">Your Status</div>
                            <div class="fw-bold" id="gpsStatus">Acquiring GPS...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-10 p-2 rounded-3">
                            <i class="fas fa-route text-success fs-4"></i>
                        </div>
                        <div>
                            <div class="small text-muted">Optimal Route</div>
                            <div class="fw-bold" id="optimalDistance">Calculating...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-info bg-opacity-10 p-2 rounded-3">
                            <i class="fas fa-hourglass-half text-info fs-4"></i>
                        </div>
                        <div>
                            <div class="small text-muted">Estimated Time</div>
                            <div class="fw-bold" id="etaDisplay">-- min</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning bg-opacity-10 p-2 rounded-3">
                            <i class="fas fa-chart-line text-warning fs-4"></i>
                        </div>
                        <div>
                            <div class="small text-muted">Saved Time</div>
                            <div class="fw-bold text-success" id="savedTimeDisplay">--</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Container -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div id="fullRouteMap" style="height: 55vh; width: 100%;"></div>
    </div>

    <!-- Route Summary Card -->
    <div class="card border-0 shadow-sm mt-4" style="border-radius: 16px;">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold">
                <i class="fas fa-list me-2 text-primary"></i>Optimized Delivery Sequence
                <span class="badge bg-primary ms-2" id="sequenceCount">0 stops</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush" id="optimizedSequenceList">
                <div class="list-group-item text-center py-4 text-muted">
                    <i class="fas fa-spinner fa-spin me-2"></i> Calculating optimal route...
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .driver-marker {
            width: 20px;
            height: 20px;
            background-color: #0d6efd;
            border-radius: 50%;
            box-shadow: 0 0 0 rgba(13, 110, 253, 0.4);
            animation: pulse-blue 1.5s infinite;
            border: 3px solid white;
        }

        @@keyframes pulse-blue {
            0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
            70% { box-shadow: 0 0 0 15px rgba(13, 110, 253, 0); }
            100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
        }
        
        .destination-marker {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .destination-marker:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 0 5px rgba(13, 110, 253, 0.5));
        }
        
        .route-highlight {
            stroke: #0d6efd;
            stroke-width: 4;
            stroke-dasharray: 8, 8;
        }
        
        .animate-slide-down {
            animation: slideDown 0.4s ease-out;
        }
        
        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .sequence-item {
            transition: all 0.2s ease;
        }
        
        .sequence-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .priority-high {
            border-left: 3px solid #dc3545;
        }
        
        .priority-normal {
            border-left: 3px solid #ffc107;
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Destination data from server
        var destinationsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(destinationsList));
        
        let map;
        let currentMarker;
        let watchId;
        let currentLat = 9.03;
        let currentLng = 38.74;
        let routeLine;
        let destMarkers = [];
        let optimizedOrder = [];
        let basicDistance = 0;
        let optimizedDistance = 0;
        
        // ============ AI ROUTE OPTIMIZATION ALGORITHM ============
        
        // Calculate distance between two points (Haversine formula)
        function calculateDistance(lat1, lng1, lat2, lng2) {
            const R = 6371; // Earth's radius in km
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLng = (lng2 - lng1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLng/2) * Math.sin(dLng/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }
        
        // Calculate total route distance
        function calculateTotalDistance(order, startLat, startLng) {
            let total = 0;
            let currentLat = startLat;
            let currentLng = startLng;
            
            for (let i = 0; i < order.length; i++) {
                const dest = order[i];
                total += calculateDistance(currentLat, currentLng, dest.lat, dest.lng);
                currentLat = dest.lat;
                currentLng = dest.lng;
            }
            return total;
        }
        
        // Nearest Neighbor algorithm for route optimization
        function optimizeRouteNearestNeighbor(destinations, startLat, startLng) {
            if (!destinations.length) return [];
            
            const unvisited = [...destinations];
            const optimized = [];
            let currentLat = startLat;
            let currentLng = startLng;
            
            // Sort by priority (High priority first)
            unvisited.sort((a, b) => {
                if (a.priority === 'High' && b.priority !== 'High') return -1;
                if (a.priority !== 'High' && b.priority === 'High') return 1;
                return 0;
            });
            
            while (unvisited.length > 0) {
                let nearestIndex = 0;
                let nearestDistance = calculateDistance(currentLat, currentLng, unvisited[0].lat, unvisited[0].lng);
                
                for (let i = 1; i < unvisited.length; i++) {
                    const dist = calculateDistance(currentLat, currentLng, unvisited[i].lat, unvisited[i].lng);
                    if (dist < nearestDistance) {
                        nearestDistance = dist;
                        nearestIndex = i;
                    }
                }
                
                const nearest = unvisited[nearestIndex];
                optimized.push(nearest);
                currentLat = nearest.lat;
                currentLng = nearest.lng;
                unvisited.splice(nearestIndex, 1);
            }
            
            return optimized;
        }
        
        // Calculate estimated time based on distance (assuming 50 km/h average speed)
        function calculateETAFromDistance(distanceKm) {
            const avgSpeedKmh = 50;
            const minutes = Math.round((distanceKm / avgSpeedKmh) * 60);
            return minutes;
        }
        
        // Show AI recommendation
        function showAIRecommendation(optimized, original) {
            const optimizedDist = calculateTotalDistance(optimized, currentLat, currentLng);
            const originalDist = calculateTotalDistance(original, currentLat, currentLng);
            const savedKm = Math.round((originalDist - optimizedDist) * 10) / 10;
            const savedMinutes = calculateETAFromDistance(originalDist - optimizedDist);
            
            optimizedDistance = optimizedDist;
            basicDistance = originalDist;
            
            const banner = document.getElementById('aiRecommendationBanner');
            const text = document.getElementById('aiRecommendationText');
            const savedTimeDisplay = document.getElementById('savedTimeDisplay');
            
            if (savedKm > 0.5) {
                text.innerHTML = `AI suggests a better route! Save ${savedKm} km (approximately ${savedMinutes} minutes) by following the optimized sequence.`;
                banner.style.display = 'block';
                savedTimeDisplay.innerHTML = `-${savedMinutes} min`;
                savedTimeDisplay.className = 'fw-bold text-success';
            } else {
                text.innerHTML = `Current route is already optimal. No significant savings detected.`;
                savedTimeDisplay.innerHTML = '0 min';
                savedTimeDisplay.className = 'fw-bold text-muted';
            }
            
            document.getElementById('optimalDistance').innerHTML = `${Math.round(optimizedDist)} km`;
        }
        
        // Apply optimized route to map
        function applyOptimizedRoute() {
            if (optimizedOrder.length > 0) {
                updateRouteWithOrder(optimizedOrder);
                updateSequenceList(optimizedOrder);
                
                // Update ETA
                const totalDist = calculateTotalDistance(optimizedOrder, currentLat, currentLng);
                const etaMinutes = calculateETAFromDistance(totalDist);
                document.getElementById('etaDisplay').innerHTML = `${etaMinutes} min`;
                
                // Close banner
                closeRecommendation();
                
                // Show success toast
                showToast('Route optimized! Follow the highlighted sequence.', 'success');
            }
        }
        
        function closeRecommendation() {
            document.getElementById('aiRecommendationBanner').style.display = 'none';
        }
        
        function showToast(message, type) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} position-fixed bottom-0 end-0 m-3 animate-slide-down`;
            toast.style.zIndex = '10000';
            toast.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'info'} me-2"></i>${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        // Optimize route on demand
        function optimizeRoute() {
            if (destinationsData.length === 0) {
                showToast('No destinations to optimize', 'warning');
                return;
            }
            
            const originalOrder = [...destinationsData];
            const optimized = optimizeRouteNearestNeighbor(destinationsData, currentLat, currentLng);
            optimizedOrder = optimized;
            
            // Calculate savings
            const originalDist = calculateTotalDistance(originalOrder, currentLat, currentLng);
            const optimizedDist = calculateTotalDistance(optimized, currentLat, currentLng);
            
            showAIRecommendation(optimized, originalOrder);
            
            // Highlight optimize button
            const btn = document.getElementById('optimizeBtn');
            btn.innerHTML = '<i class="fas fa-check me-1"></i> Optimized!';
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-magic me-1"></i> Optimize Route';
            }, 3000);
        }
        
        // Update route with specific order
        function updateRouteWithOrder(order) {
            const points = [[currentLat, currentLng]];
            for (let i = 0; i < order.length; i++) {
                points.push([order[i].lat, order[i].lng]);
            }
            
            if (routeLine) {
                routeLine.setLatLngs(points);
            } else {
                routeLine = L.polyline(points, {
                    color: '#0d6efd',
                    weight: 4,
                    opacity: 0.8,
                    className: 'route-highlight'
                }).addTo(map);
            }
            
            // Fit bounds to show all points
            if (points.length > 1) {
                const bounds = L.latLngBounds(points);
                map.fitBounds(bounds, { padding: [50, 50] });
            }
        }
        
        // Update sequence list in UI
        function updateSequenceList(order) {
            const container = document.getElementById('optimizedSequenceList');
            if (!order.length) {
                container.innerHTML = '<div class="list-group-item text-center py-4 text-muted">No destinations found</div>';
                document.getElementById('sequenceCount').innerHTML = '0 stops';
                return;
            }
            
            let html = '';
            for (let i = 0; i < order.length; i++) {
                const dest = order[i];
                const isHighPriority = dest.priority === 'High';
                html += `
                    <div class="list-group-item sequence-item ${isHighPriority ? 'priority-high' : 'priority-normal'}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="sequence-number rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    ${i + 1}
                                </div>
                                <div>
                                    <div class="fw-bold">${dest.businessName}</div>
                                    <div class="small text-muted">PO: ${dest.poNumber}</div>
                                    <div class="small text-muted">${dest.address.substring(0, 40)}${dest.address.length > 40 ? '...' : ''}</div>
                                </div>
                            </div>
                            <div class="text-end">
                                ${isHighPriority ? '<span class="badge bg-danger mb-1">Priority</span><br>' : ''}
                                <button class="btn btn-sm btn-outline-primary rounded-pill mt-1" onclick="focusOnDestination(${dest.id})">
                                    <i class="fas fa-map-pin me-1"></i> Locate
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }
            container.innerHTML = html;
            document.getElementById('sequenceCount').innerHTML = `${order.length} stop${order.length !== 1 ? 's' : ''}`;
        }
        
        // Update basic route (original order)
        function updateBasicRoute() {
            updateRouteWithOrder(destinationsData);
            updateSequenceList(destinationsData);
            
            const totalDist = calculateTotalDistance(destinationsData, currentLat, currentLng);
            const etaMinutes = calculateETAFromDistance(totalDist);
            document.getElementById('etaDisplay').innerHTML = `${etaMinutes} min`;
            document.getElementById('optimalDistance').innerHTML = `${Math.round(totalDist)} km`;
        }
        
        // ============ MAP AND GPS FUNCTIONS ============
        
        function getUserLocation() {
            if (!navigator.geolocation) {
                document.getElementById('gpsStatus').innerHTML = '<span class="text-danger">GPS not supported</span>';
                return;
            }
            
            document.getElementById('gpsStatus').innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Acquiring GPS...';
            
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    currentLat = position.coords.latitude;
                    currentLng = position.coords.longitude;
                    
                    if (map) {
                        map.setView([currentLat, currentLng], 13);
                        updateDriverMarker(currentLat, currentLng);
                        updateBasicRoute();
                    }
                    
                    startWatchingPosition();
                    document.getElementById('gpsStatus').innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>GPS Active</span>';
                },
                function(error) {
                    document.getElementById('gpsStatus').innerHTML = '<span class="text-danger">GPS unavailable</span>';
                    currentLat = 9.03;
                    currentLng = 38.74;
                    if (map) {
                        map.setView([currentLat, currentLng], 12);
                        updateDriverMarker(currentLat, currentLng);
                        updateBasicRoute();
                    }
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        }
        
        function startWatchingPosition() {
            if (watchId) navigator.geolocation.clearWatch(watchId);
            watchId = navigator.geolocation.watchPosition(
                function(position) {
                    currentLat = position.coords.latitude;
                    currentLng = position.coords.longitude;
                    updateDriverMarker(currentLat, currentLng);
                    if (optimizedOrder.length > 0) {
                        updateRouteWithOrder(optimizedOrder);
                    } else {
                        updateBasicRoute();
                    }
                },
                function(error) {},
                { enableHighAccuracy: true, maximumAge: 5000, timeout: 10000 }
            );
        }
        
        function updateDriverMarker(lat, lng) {
            const driverIcon = L.divIcon({ className: 'driver-marker', iconSize: [20, 20], iconAnchor: [10, 10], popupAnchor: [0, -10] });
            if (currentMarker) {
                currentMarker.setLatLng([lat, lng]);
            } else {
                currentMarker = L.marker([lat, lng], { icon: driverIcon }).addTo(map);
                currentMarker.bindPopup('<b>Your Location</b><br>Current position').openPopup();
            }
        }
        
        function createDestinationMarkers() {
            const destIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41]
            });
            
            destMarkers.forEach(m => map.removeLayer(m));
            destMarkers = [];
            
            destinationsData.forEach(dest => {
                const marker = L.marker([dest.lat, dest.lng], { icon: destIcon }).addTo(map);
                marker.bindPopup(`<b>${dest.businessName}</b><br>PO: ${dest.poNumber}<br>${dest.address}`);
                destMarkers.push(marker);
            });
        }
        
        function initMap() {
            map = L.map('fullRouteMap').setView([currentLat, currentLng], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 20
            }).addTo(map);
            L.control.zoom({ position: 'bottomright' }).addTo(map);
            L.control.scale({ metric: true, imperial: false, position: 'bottomleft' }).addTo(map);
            createDestinationMarkers();
        }
        
        window.centerUserLocation = function() {
            if (currentMarker) {
                map.setView(currentMarker.getLatLng(), 15);
            } else if (currentLat) {
                map.setView([currentLat, currentLng], 15);
            }
        };
        
        window.focusOnDestination = function(id) {
            const dest = destinationsData.find(d => d.id === id);
            if (dest) {
                map.setView([dest.lat, dest.lng], 15);
                const marker = destMarkers[destinationsData.findIndex(d => d.id === id)];
                if (marker) marker.openPopup();
            }
        };
        
        window.optimizeRoute = optimizeRoute;
        window.applyOptimizedRoute = applyOptimizedRoute;
        window.closeRecommendation = closeRecommendation;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            getUserLocation();
        });
    </script>
}