@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Smart Route Itinerary";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4 pb-5 px-4 h-100">
    <div class="row h-100 g-0 rounded-25 overflow-hidden shadow-premium bg-white">
        <!-- Sidebar: Stop List -->
        <div class="col-xl-4 col-lg-5 d-flex flex-column border-end bg-white" style="max-height: 85vh;">
            <div class="p-4 border-bottom">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h4 class="fw-bold text-dark-green mb-1">Route Planner</h4>
                        <p class="text-muted extra-small mb-0"><i class="fas fa-magic me-1"></i> AI-Optimized for fuel efficiency</p>
                    </div>
                    <span class="badge bg-soft-green text-dark-green rounded-pill px-3">@(Model.Count()) Stops</span>
                </div>
                <div class="d-grid">
                    <button class="btn btn-dark-green rounded-pill fw-bold shadow-sm py-2">
                        <i class="fas fa-play me-2"></i> START NAVIGATION
                    </button>
                </div>
            </div>

            <div class="flex-grow-1 overflow-auto p-4 custom-scrollbar">
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var po in Model)
                    {
                        <div class="route-stop mb-4 position-relative">
                            <div class="d-flex gap-3">
                                <div class="stop-number bg-dark-green text-white rounded-circle">@i</div>
                                <div class="stop-content flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="fw-bold text-dark mb-0">@po.Retailer?.BusinessName</h6>
                                        <span class="text-muted extra-small">#@po.PONumber</span>
                                    </div>
                                    <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1"></i> @po.Retailer?.BusinessAddress</p>
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-light text-dark extra-small py-1"><i class="fas fa-clock me-1 text-muted"></i> By 4:00 PM</span>
                                        <span class="badge bg-light text-dark extra-small py-1"><i class="fas fa-weight-hanging me-1 text-muted"></i> @(po.PurchaseOrderItems?.Sum(x => x.Quantity) ?? 0) Items</span>
                                    </div>
                                </div>
                            </div>
                            @if (i < Model.Count())
                            {
                                <div class="stop-line"></div>
                            }
                        </div>
                        i++;
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-route fa-3x text-light mb-3"></i>
                        <p class="text-muted">No active items to route.</p>
                    </div>
                }
            </div>

            <div class="p-4 bg-light-green-subtle border-top mt-auto">
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <p class="text-muted extra-small mb-0">EST. DISTANCE</p>
                        <h6 class="fw-bold mb-0">12.4 KM</h6>
                    </div>
                    <div class="col-6 border-start">
                        <p class="text-muted extra-small mb-0">EST. TIME</p>
                        <h6 class="fw-bold mb-0">45 MINS</h6>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Map Area -->
        <div class="col-xl-8 col-lg-7 position-relative">
            <div id="routeMap" style="height: 85vh; width: 100%; z-index: 1;"></div>
            
            <!-- Map Overlay UI -->
            <div class="position-absolute bottom-0 start-0 p-4 w-100" style="z-index: 2;">
                <div class="card border-0 rounded-20 shadow-premium bg-white bg-opacity-90 backdrop-blur p-3">
                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <div class="icon-shape bg-dark-green text-white rounded-circle">
                                <i class="fas fa-location-arrow"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h6 class="fw-bold mb-0">Bole Road Traffic Warning</h6>
                            <p class="text-muted extra-small mb-0">Rerouting via Old Airport suggested to avoid 15m delay.</p>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-soft-green btn-sm rounded-pill fw-bold">REROUTE</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Float Navigation Tool -->
            <div class="position-absolute top-0 end-0 p-4" style="z-index: 2;">
                <div class="d-flex flex-column gap-2 text-center">
                    <button class="btn btn-white shadow-sm rounded-circle p-0" style="width: 45px; height: 45px;"><i class="fas fa-plus"></i></button>
                    <button class="btn btn-white shadow-sm rounded-circle p-0" style="width: 45px; height: 45px;"><i class="fas fa-minus"></i></button>
                    <button class="btn btn-white shadow-sm rounded-circle p-0" style="width: 45px; height: 45px;"><i class="fas fa-layer-group"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LEAFLET INTEGRATION (CDN) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Map (Centered on Addis Ababa as default for SCM)
        const map = L.map('routeMap').setView([9.0192, 38.7525], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // Simulated Route Markers
        const stops = [
            { lat: 9.02, lng: 38.75, name: "Start Hub" },
            { lat: 9.04, lng: 38.76, name: "Stop 1: Retailer A" },
            { lat: 9.03, lng: 38.78, name: "Stop 2: Retailer B" }
        ];

        stops.forEach((stop, index) => {
            const icon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background-color: #2e7d32; color: white; width: 30px; height: 30px; border-radius: 50%; border: 3px solid white; display:flex; align-items:center; justify-content:center; font-weight:bold; box-shadow:0 4px 10px rgba(0,0,0,0.2)">${index + 1}</div>`,
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });

            L.marker([stop.lat, stop.lng], {icon: icon}).addTo(map)
                .bindPopup(`<b>${stop.name}</b><br>Priority: High`);
        });

        // Draw Simulated Route Core
        const latlngs = stops.map(s => [s.lat, s.lng]);
        const polyline = L.polyline(latlngs, {color: '#2e7d32', weight: 5, opacity: 0.7, dashArray: '10, 10'}).addTo(map);
        map.fitBounds(polyline.getBounds());
    });
</script>

<style>
    .rounded-25 { border-radius: 25px !important; }
    .rounded-20 { border-radius: 20px !important; }
    .shadow-premium { box-shadow: 0 15px 50px rgba(0,0,0,0.08) !important; }
    .bg-light-green-subtle { background-color: #f8faf9 !important; }
    .text-dark-green { color: #2e7d32 !important; }
    .btn-dark-green { background: #2e7d32 !important; border: none; color: white; }
    .btn-soft-green { background: rgba(46, 125, 50, 0.1) !important; color: #2e7d32 !important; border: none; }
    .extra-small { font-size: 0.7rem !important; }
    .icon-shape { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
    .backdrop-blur { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .btn-white { background: white; border: none; }
    
    /* Stop Component */
    .stop-number {
        width: 28px;
        height: 28px;
        min-width: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
        z-index: 2;
    }
    .stop-line {
        position: absolute;
        left: 13px;
        top: 28px;
        bottom: -24px;
        width: 2px;
        background: #e9ecef;
        z-index: 1;
    }
    
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e0e0e0; border-radius: 10px; }
    
    .animate-slide-up {
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 0.6s forwards;
    }
    @@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
</style>