@model SCM_System.Models.Entities.SupplierEmployee

@{
    ViewData["Title"] = "Delivery Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="glass-panel p-4 mb-4 position-relative overflow-hidden" style="background: var(--hero-bg);">
        <div class="animated-bg" style="opacity: 0.05;"></div>
        <div class="position-relative z-index-1">
            <h1 class="text-white mb-1 fw-bold">Delivery Portal</h1>
            <p class="text-white-50 mb-0">Logistics and Fulfillment | @Model.User.FullName</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">Assigned</p>
                        <h3 class="fw-bold mb-0">@ViewBag.AssignedDeliveries</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="fas fa-truck-loading fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="glass-card p-4 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">On The Way</p>
                        <h3 class="fw-bold mb-0">0</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="fas fa-route fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="glass-card p-4 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-1">Completed</p>
                        <h3 class="fw-bold mb-0">@ViewBag.CompletedDeliveries</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="fas fa-check-double fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Deliveries -->
        <div class="col-lg-8">
            <div class="glass-card h-100">
                <div class="p-4 border-bottom border-light">
                    <h6 class="mb-0 fw-bold text-primary"><i class="fas fa-map-marked-alt me-2"></i>Assigned Deliveries</h6>
                </div>
                <div class="p-4">
                    <div class="alert alert-info bg-primary bg-opacity-10 border-0 rounded-4 text-primary mb-4 p-3 hstack gap-3">
                        <i class="fas fa-info-circle fa-lg"></i>
                        <span class="small fw-medium">Check your route details before departure. Ensure proof of delivery is captured.</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light opacity-75">
                                <tr>
                                    <th>Order #</th>
                                    <th>Destination</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="border-transparent">
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fas fa-truck fa-2x mb-3 d-block opacity-25"></i>
                                        Searching for active delivery assignments...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Route & Support -->
        <div class="col-lg-4">
            <div class="glass-card mb-4 position-relative overflow-hidden" style="min-height: 200px;">
                <div class="p-4 border-bottom border-light">
                    <h6 class="mb-0 fw-bold text-info"><i class="fas fa-location-arrow me-2"></i>Active Route</h6>
                </div>
                <div class="p-4 d-flex flex-column justify-content-center align-items-center" style="height: calc(100% - 60px);">
                    <div class="text-muted text-center py-4">
                        <i class="fas fa-map-signs fa-3x mb-3 opacity-25"></i>
                        <p class="small mb-0">No active route selected. Select a delivery to begin navigation.</p>
                    </div>
                </div>
            </div>

            <div class="glass-card">
                <div class="p-4 border-bottom border-light">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-headset me-2"></i>Delivery Support</h6>
                </div>
                <div class="p-4">
                    <button class="btn btn-primary w-100 rounded-pill mb-3">
                        <i class="fas fa-phone-alt me-2"></i> Contact Dispatch
                    </button>
                    <button class="btn btn-outline-secondary w-100 rounded-pill">
                        <i class="fas fa-question-circle me-2"></i> Help Center
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
