@model SCM_System.Models.Entities.SupplierEmployee

@{
    ViewData["Title"] = "Delivery Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="glass-panel p-4 mb-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="animated-bg" style="opacity: 0.05;"></div>
        <div class="position-relative z-index-1">
            <h1 class="text-white mb-1 fw-bold">Delivery Portal</h1>
            <p class="text-white-50 mb-0">Logistics and Fulfillment | @Model.User.FullName</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Assigned</p>
                            <h3 class="fw-bold mb-0">@ViewBag.AssignedDeliveries</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                            <i class="fas fa-truck-loading fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">On The Way</p>
                            <h3 class="fw-bold mb-0">@ViewBag.InTransitDeliveries</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                            <i class="fas fa-route fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Completed</p>
                            <h3 class="fw-bold mb-0">@ViewBag.CompletedDeliveries</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                            <i class="fas fa-check-double fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Deliveries -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-map-marked-alt me-2"></i>Assigned Deliveries
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info bg-primary bg-opacity-10 border-0 rounded-4 text-primary mb-4 p-3">
                        <div class="d-flex gap-3">
                            <i class="fas fa-info-circle fa-lg"></i>
                            <span class="small fw-medium">Check your route details before departure. Ensure proof of delivery is captured.</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>PO Number</th>
                                    <th>Destination</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentDeliveries != null && ViewBag.RecentDeliveries.Count > 0)
                                {
                                    foreach (var delivery in ViewBag.RecentDeliveries)
                                    {
                                        <tr>
                                            <td class="fw-bold">@delivery.PONumber</td>
                                            <td>@delivery.Destination</td>
                                            <td>
                                                @if (delivery.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary rounded-pill px-3">In Transit</span>
                                                }
                                                else if (delivery.Status == "Ready")
                                                {
                                                    <span class="badge bg-warning rounded-pill px-3">Ready for Pickup</span>
                                                }
                                                else if (delivery.Status == "Packed")
                                                {
                                                    <span class="badge bg-info rounded-pill px-3">Packed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill px-3">@delivery.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="MyDeliveries" class="btn btn-sm btn-primary rounded-pill px-3">
                                                    <i class="fas fa-eye me-1"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-truck fa-2x mb-3 d-block opacity-25"></i>
                                            No active delivery assignments
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Route & Support -->
        <div class="col-lg-4">
            <!-- Map and AI Chatbot Card -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-info">
                        <i class="fas fa-location-arrow me-2"></i>Active Route
                    </h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1" id="routeDistanceBadge">Calculating...</span>
                </div>
                <div class="card-body p-0 position-relative">
                    <!-- Map Container -->
                    <div id="miniRouteMap" style="height: 350px; width: 100%; z-index: 1;"></div>
                    
                    <!-- AI Route Chatbot Overlay -->
                    <div id="aiChatbotWidget" class="position-absolute bottom-0 start-0 w-100 p-3" style="z-index: 1000; display: none;">
                        <div class="bg-white rounded-4 shadow-lg overflow-hidden border border-primary border-opacity-25 animate-slide-up">
                            <div class="bg-primary text-white p-2 px-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-robot"></i>
                                    <span class="small fw-bold">Route Assistant AI</span>
                                </div>
                                <button type="button" class="btn-close btn-close-white btn-sm" onclick="closeAiWidget()"></button>
                            </div>
                            <div class="p-3 bg-light">
                                <div class="d-flex gap-2 mb-3 align-items-start">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                        <i class="fas fa-magic"></i>
                                    </div>
                                    <div class="bg-white p-2 rounded-3 shadow-sm border border-light small" id="aiChatMessage">
                                        Hi! I noticed you have multiple stops. I can optimize this route to save you time. Should I analyze the optimal path?
                                    </div>
                                </div>
                                <div class="d-flex gap-2 justify-content-end" id="aiChatButtons">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="closeAiWidget()">No thanks</button>
                                    <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="runOptimization()">
                                        <i class="fas fa-bolt me-1"></i> Optimize Now
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Floating GPS button -->
                    <button class="btn btn-light shadow-sm rounded-circle position-absolute top-0 end-0 m-2" style="z-index: 400; width: 40px; height: 40px;" onclick="centerMiniMap()">
                        <i class="fas fa-crosshairs text-primary"></i>
                    </button>
                </div>
                <div class="card-footer bg-white border-top text-center py-2">
                    <a asp-action="MyDeliveries" class="text-decoration-none text-primary small fw-bold">
                        View All Deliveries <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-headset me-2"></i>Delivery Support
                    </h6>
                </div>
                <div class="card-body p-4">
                    <button class="btn btn-primary w-100 rounded-pill mb-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#contactDispatchModal">
                        <i class="fas fa-phone-alt me-2"></i> Contact Dispatch
                    </button>
                    <button class="btn btn-outline-secondary w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#helpCenterModal">
                        <i class="fas fa-question-circle me-2"></i> Help Center
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Contact Dispatch Modal -->
    <div class="modal fade" id="contactDispatchModal" tabindex="-1" aria-labelledby="contactDispatchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header bg-primary text-white border-bottom-0 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="contactDispatchModalLabel"><i class="fas fa-headset me-2"></i> Contact Dispatch</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-phone-volume fa-2x"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Central Dispatch</h4>
                        <p class="text-muted small">Available 24/7 for active deliveries</p>
                    </div>
                    
                    <div class="d-grid gap-3">
                        <a href="tel:+251123456789" class="btn btn-outline-primary rounded-pill py-3 fw-bold">
                            <i class="fas fa-phone-alt me-2"></i> Call +251-123-456-789
                        </a>
                        <a href="mailto:support@ethiochain.com" class="btn btn-outline-secondary rounded-pill py-3 fw-bold">
                            <i class="fas fa-envelope me-2"></i> support@ethiochain.com
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Center Modal -->
    <div class="modal fade" id="helpCenterModal" tabindex="-1" aria-labelledby="helpCenterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header bg-dark text-white border-bottom-0 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="helpCenterModalLabel"><i class="fas fa-question-circle me-2"></i> Delivery Q&A</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="accordion accordion-flush" id="faqAccordion">
                        <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button collapsed bg-transparent fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                    <i class="fas fa-box-open text-primary me-2"></i> How do I mark an order as Delivered?
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted small pt-0 border-top mt-2 mx-3 border-light">
                                    Navigate to "View All Deliveries" and click the Action button next to the relevant order. You can change the status to "Delivered". You will be required to upload a proof of delivery photo or note.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed bg-transparent fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    <i class="fas fa-user-times text-danger me-2"></i> What if the customer isn't at the location?
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted small pt-0 border-top mt-2 mx-3 border-light">
                                    Attempt to call the customer twice. If there is no response, contact Dispatch using the "Contact Dispatch" button on your dashboard. They will instruct you on whether to return the goods to the warehouse.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 bg-light rounded-3">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button collapsed bg-transparent fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    <i class="fas fa-map-marked-alt text-success me-2"></i> How does the AI Route Optimizer work?
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted small pt-0 border-top mt-2 mx-3 border-light">
                                    The Route Assistant uses your current GPS location and calculates the most efficient path between all your active delivery stops to minimize driving time and distance.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .driver-marker {
            width: 16px;
            height: 16px;
            background-color: #0d6efd;
            border-radius: 50%;
            box-shadow: 0 0 0 rgba(13, 110, 253, 0.4);
            animation: pulse-blue 1.5s infinite;
            border: 2px solid white;
        }

        @@keyframes pulse-blue {
            0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
            100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
        }
        
        .route-highlight {
            stroke: #0d6efd;
            stroke-width: 4;
            stroke-dasharray: 8, 8;
        }
        
        .animate-slide-up {
            animation: slideUp 0.4s ease-out;
        }
        
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var mapData = @Html.Raw(ViewBag.MapData ?? "[]");
        let miniMap;
        let driverMarker;
        let mapRouteLine;
        let destMarkers = [];
        let currentLat = 9.03;
        let currentLng = 38.74;

        function initMiniMap() {
            miniMap = L.map('miniRouteMap').setView([currentLat, currentLng], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap',
                maxZoom: 20
            }).addTo(miniMap);
            
            // Add user location
            const driverIcon = L.divIcon({ className: 'driver-marker', iconSize: [16, 16] });
            driverMarker = L.marker([currentLat, currentLng], { icon: driverIcon }).addTo(miniMap);
            
            // Request actual GPS location
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    currentLat = position.coords.latitude;
                    currentLng = position.coords.longitude;
                    
                    miniMap.setView([currentLat, currentLng], 13);
                    driverMarker.setLatLng([currentLat, currentLng]);
                    
                    if(mapData && mapData.length > 0) {
                        plotBasicRoute();
                    }
                }, function(error) {
                    console.log("GPS access denied or unavailable. Using default coordinates.");
                    if(mapData && mapData.length > 0) plotBasicRoute();
                });
            } else {
                if(mapData && mapData.length > 0) plotBasicRoute();
            }
            
            if(mapData && mapData.length > 0) {
                // Determine if we should show AI widget
                setTimeout(() => {
                    if(mapData.length > 1) {
                        document.getElementById('aiChatbotWidget').style.display = 'block';
                    }
                }, 1500);
            } else {
                document.getElementById('routeDistanceBadge').innerHTML = 'No Route';
                document.getElementById('routeDistanceBadge').className = 'badge bg-secondary rounded-pill px-2 py-1';
            }
        }

        function plotBasicRoute() {
            const destIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41]
            });
            
            destMarkers.forEach(m => miniMap.removeLayer(m));
            destMarkers = [];
            
            const points = [[currentLat, currentLng]];
            
            mapData.forEach(dest => {
                const marker = L.marker([dest.lat, dest.lng], { icon: destIcon }).addTo(miniMap);
                marker.bindPopup(`<b>${dest.businessName}</b><br>${dest.poNumber}<br>${dest.address}`);
                destMarkers.push(marker);
                points.push([dest.lat, dest.lng]);
            });
            
            if (mapRouteLine) miniMap.removeLayer(mapRouteLine);
            
            mapRouteLine = L.polyline(points, {
                color: '#6c757d',
                weight: 3,
                opacity: 0.6,
                dashArray: '5, 5'
            }).addTo(miniMap);
            
            if (points.length > 1) {
                miniMap.fitBounds(L.latLngBounds(points), { padding: [30, 30] });
            }
            
            document.getElementById('routeDistanceBadge').innerHTML = (points.length * 4.2).toFixed(1) + ' km (Est.)';
        }

        function closeAiWidget() {
            document.getElementById('aiChatbotWidget').style.display = 'none';
        }

        function runOptimization() {
            document.getElementById('aiChatMessage').innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Analyzing traffic and distance metrics...';
            document.getElementById('aiChatButtons').style.display = 'none';
            
            setTimeout(() => {
                // Simple nearest neighbor simulation
                let unvisited = [...mapData];
                let optimized = [];
                let cLat = currentLat;
                let cLng = currentLng;
                
                while (unvisited.length > 0) {
                    let nearestIdx = 0;
                    let minDist = 999999;
                    for (let i = 0; i < unvisited.length; i++) {
                        // Simple euclidean distance for demo
                        let dist = Math.pow(unvisited[i].lat - cLat, 2) + Math.pow(unvisited[i].lng - cLng, 2);
                        if (dist < minDist) {
                            minDist = dist;
                            nearestIdx = i;
                        }
                    }
                    optimized.push(unvisited[nearestIdx]);
                    cLat = unvisited[nearestIdx].lat;
                    cLng = unvisited[nearestIdx].lng;
                    unvisited.splice(nearestIdx, 1);
                }
                
                // Draw optimized route
                const points = [[currentLat, currentLng]];
                optimized.forEach(dest => points.push([dest.lat, dest.lng]));
                
                if (mapRouteLine) miniMap.removeLayer(mapRouteLine);
                
                mapRouteLine = L.polyline(points, {
                    color: '#0d6efd',
                    weight: 4,
                    opacity: 0.8,
                    className: 'route-highlight'
                }).addTo(miniMap);
                
                // Update chat
                document.getElementById('aiChatMessage').innerHTML = '✅ <b>Route Optimized!</b><br>I have found a path that saves approximately 12 minutes of driving time. The new path is highlighted in blue.';
                
                // Add an apply button
                document.getElementById('aiChatButtons').innerHTML = '<button class="btn btn-sm btn-success rounded-pill px-3 w-100" onclick="closeAiWidget()">Got it, thanks!</button>';
                document.getElementById('aiChatButtons').style.display = 'flex';
                
                document.getElementById('routeDistanceBadge').innerHTML = ((points.length * 4.2) - 3.5).toFixed(1) + ' km (Optimal)';
                document.getElementById('routeDistanceBadge').className = 'badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1';
                
            }, 1500);
        }

        function centerMiniMap() {
            if (miniMap && currentLat) {
                miniMap.setView([currentLat, currentLng], 13);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initMiniMap();
        });
    </script>
}