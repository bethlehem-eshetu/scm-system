@model SCM_System.Models.Entities.SupplierEmployee
@{
    ViewData["Title"] = "Delivery Portal";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5">
    <!-- Premium Enhanced Header -->
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#" class="text-white text-opacity-50 text-decoration-none small fw-bold text-uppercase tracking-widest">Logistics</a></li>
                                <li class="breadcrumb-item active small fw-bold text-uppercase tracking-widest text-white" aria-current="page">Portal</li>
                            </ol>
                        </nav>
                        <h1 class="display-5 fw-bold text-white mb-2">
                            Delivery <span class="text-gradient-gold">Fulfillment Center</span>
                        </h1>
                        <p class="text-white text-opacity-75 mb-0 fs-5">
                            <i class="fas fa-id-card me-2 text-info"></i>Agent: @Model.User.FullName
                            <span class="mx-2 opacity-25">|</span>
                            <i class="fas fa-truck me-2 text-success"></i>System synced for active dispatch.
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <button class="btn btn-glass px-4 py-3 fw-bold d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#contactDispatchModal">
                                <div class="btn-icon bg-white bg-opacity-10 rounded-3">
                                    <i class="fas fa-headset text-white"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-white text-opacity-50 text-uppercase">Support</div>
                                    <div class="text-white">Dispatch</div>
                                </div>
                            </button>
                            <a asp-action="MyDeliveries" class="btn btn-gold px-4 py-3 fw-bold d-flex align-items-center gap-3 shadow-lg">
                                <div class="btn-icon bg-black bg-opacity-20 rounded-3">
                                    <i class="fas fa-list-check"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-black text-opacity-50 text-uppercase">Fulfillment</div>
                                    <div class="text-black">All Tasks</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main KPI Grid -->
    <div class="row g-4 mb-5">
        <div class="col-xl-4 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-warning-soft text-warning">
                    <i class="fas fa-truck-loading"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Assigned</div>
                    <div class="kpi-value">@ViewBag.AssignedDeliveries</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-warning fw-bold">Pending Pickup/Ready</span>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-primary-soft text-primary">
                    <i class="fas fa-route"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">In Transit</div>
                    <div class="kpi-value">@ViewBag.InTransitDeliveries</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-primary fw-bold">Live on the Road</span>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-12">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-success-soft text-success">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Completed</div>
                    <div class="kpi-value">@ViewBag.CompletedDeliveries</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-success fw-bold">Succesfully Fulfilled</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Deliveries Table -->
        <div class="col-lg-8">
            <div class="section-card">
                <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                    <div>
                        <h5 class="fw-bold mb-0">Active Dispatch List</h5>
                        <p class="extra-small text-muted mb-0">Immediate tasks and route details</p>
                    </div>
                    <div class="badge-soft badge-soft-info p-2 px-3">
                        <i class="fas fa-info-circle me-1"></i> Proof of delivery required
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="admin-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">PO Number</th>
                                <th>Destination</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentDeliveries != null && ViewBag.RecentDeliveries.Count > 0)
                            {
                                foreach (var delivery in ViewBag.RecentDeliveries)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">#@delivery.PONumber</td>
                                        <td>
                                            <div class="fw-bold small text-dark">@delivery.Destination</div>
                                        </td>
                                        <td>
                                            @{
                                                var statusBadge = delivery.Status switch {
                                                    "In Transit" => "badge-soft-primary",
                                                    "Ready" => "badge-soft-warning",
                                                    "Packed" => "badge-soft-info",
                                                    _ => "badge-soft-secondary"
                                                };
                                            }
                                            <span class="badge-soft @statusBadge">@delivery.Status</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="MyDeliveries" class="btn btn-sm btn-icon-sm btn-outline-card">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="empty-state opacity-50">
                                            <i class="fas fa-truck fa-3x mb-3"></i>
                                            <h6 class="fw-bold">No active assignments</h6>
                                            <p class="extra-small mb-0">New tasks will appear here when assigned by dispatch.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Route Assistant & Maps -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark-card">
                    <div class="card-header bg-white dark-card py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fas fa-location-arrow me-2 text-primary"></i>Route Assistant
                        </h6>
                        <span class="badge-soft badge-soft-primary" id="routeDistanceBadge">Initializing...</span>
                    </div>
                    <div class="card-body p-0 position-relative">
                        <div id="miniRouteMap" style="height: 380px; width: 100%; z-index: 1;"></div>
                        
                        <!-- AI Assistant Overlay -->
                        <div id="aiChatbotWidget" class="position-absolute bottom-0 start-0 w-100 p-3" style="z-index: 1000; display: none;">
                            <div class="glass-assistant rounded-4 shadow-lg overflow-hidden animate-slide-up">
                                <div class="p-2 px-3 d-flex justify-content-between align-items-center bg-primary bg-opacity-75 text-white">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-robot"></i>
                                        <span class="extra-small fw-bold uppercase">Route Intelligence</span>
                                    </div>
                                    <button type="button" class="btn-close btn-close-white btn-sm" onclick="closeAiWidget()"></button>
                                </div>
                                <div class="p-3">
                                    <div class="d-flex gap-2 mb-3">
                                        <div class="small fw-medium text-dark" id="aiChatMessage">
                                            Optimize your delivery sequence to save time.
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2" id="aiChatButtons">
                                        <button class="btn btn-sm btn-outline-card flex-grow-1 rounded-pill" onclick="closeAiWidget()">Later</button>
                                        <button class="btn btn-sm btn-primary flex-grow-1 rounded-pill shadow-sm" onclick="runOptimization()">
                                            <i class="fas fa-bolt me-1"></i> Optimize
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Support Center -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark-card">
                    <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">System Support</h6>
                    <div class="d-grid gap-3">
                        <button class="btn btn-outline-card text-start p-3 rounded-4 d-flex align-items-center justify-content-between" data-bs-toggle="modal" data-bs-target="#helpCenterModal">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-question-circle text-muted"></i>
                                <span class="small fw-bold">Delivery Guide</span>
                            </div>
                            <i class="fas fa-chevron-right extra-small opacity-25"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="contactDispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-5 shadow-2xl overflow-hidden">
            <div class="modal-header bg-dark text-white p-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-headset me-2"></i> Central Dispatch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <i class="fas fa-phone-volume fa-2x"></i>
                </div>
                <h4 class="fw-bold">Contact Support</h4>
                <p class="text-muted small mb-4">Our logistics team is available 24/7 for active delivery assistance.</p>
                <div class="d-grid gap-3">
                    <a href="tel:+251123456789" class="btn btn-primary rounded-pill py-3 fw-bold shadow-lg">
                        <i class="fas fa-phone-alt me-2"></i> Call Dispatch
                    </a>
                    <a href="mailto:logistics@scm.com" class="btn btn-outline-card rounded-pill py-3 fw-bold">
                        <i class="fas fa-envelope me-2"></i> Email Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .welcome-banner { background: linear-gradient(135deg, #0B3B2F 0%, #1A4D3A 100%); border: 1px solid rgba(255, 255, 255, 0.1); }
        .banner-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.05; z-index: 1; }
        .banner-glow { position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(46, 156, 122, 0.2) 0%, transparent 70%); filter: blur(50px); z-index: 1; }
        .text-gradient-gold { background: linear-gradient(to right, #f1c40f, #f39c12); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; }
        
        .kpi-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 24px; display: flex; flex-wrap: wrap; align-items: center; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); transition: transform 0.2s, box-shadow 0.2s; }
        .kpi-icon-box { width: 54px; height: 54px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .kpi-label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }
        .kpi-value { font-size: 1.85rem; font-weight: 700; color: var(--text-color); line-height: 1.2; }
        
        .section-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 24px; overflow: hidden; }
        .bg-primary-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
        .bg-warning-soft { background: rgba(230, 126, 34, 0.1); color: #E67E22; }
        .bg-success-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
        .bg-info-soft { background: rgba(91, 143, 249, 0.1); color: #5B8FF9; }
        
        .glass-assistant { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(0,0,0,0.05); }
        .dark-mode .glass-assistant { background: rgba(26, 31, 29, 0.9); border-color: rgba(255,255,255,0.05); }
        
        .driver-marker { width: 16px; height: 16px; background-color: #2E9C7A; border-radius: 50%; box-shadow: 0 0 0 rgba(46, 156, 122, 0.4); animation: pulse-green 1.5s infinite; border: 2px solid white; }
        @@keyframes pulse-green { 0% { box-shadow: 0 0 0 0 rgba(46, 156, 122, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(46, 156, 122, 0); } 100% { box-shadow: 0 0 0 0 rgba(46, 156, 122, 0); } }
        
        .btn-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); color: white; border-radius: 16px; }
        .btn-gold { background: linear-gradient(135deg, #f1c40f 0%, #f39c12 100%); border-radius: 16px; color: #000; }
        .btn-icon { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var mapData = @Html.Raw(ViewBag.MapData ?? "[]");
        let miniMap;
        let driverMarker;
        let mapRouteLine;
        let currentLat = 9.03;
        let currentLng = 38.74;

        function initMiniMap() {
            miniMap = L.map('miniRouteMap').setView([currentLat, currentLng], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(miniMap);
            
            const driverIcon = L.divIcon({ className: 'driver-marker', iconSize: [16, 16] });
            driverMarker = L.marker([currentLat, currentLng], { icon: driverIcon }).addTo(miniMap);
            
            if(mapData && mapData.length > 0) {
                plotBasicRoute();
                setTimeout(() => { if(mapData.length > 1) $('#aiChatbotWidget').fadeIn(); }, 1500);
            } else {
                $('#routeDistanceBadge').text('No Active Route').addClass('badge-soft-secondary');
            }
        }

        function plotBasicRoute() {
            const destIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41]
            });
            
            const points = [[currentLat, currentLng]];
            mapData.forEach(dest => {
                L.marker([dest.lat, dest.lng], { icon: destIcon }).addTo(miniMap)
                    .bindPopup(`<b>${dest.businessName}</b><br>${dest.poNumber}`);
                points.push([dest.lat, dest.lng]);
            });
            
            if (mapRouteLine) miniMap.removeLayer(mapRouteLine);
            mapRouteLine = L.polyline(points, { color: '#6c757d', weight: 3, opacity: 0.6, dashArray: '5, 5' }).addTo(miniMap);
            if (points.length > 1) miniMap.fitBounds(L.latLngBounds(points), { padding: [30, 30] });
            $('#routeDistanceBadge').text((points.length * 4.2).toFixed(1) + ' km (Est.)');
        }

        function runOptimization() {
            $('#aiChatMessage').html('<i class="fas fa-spinner fa-spin me-2"></i> Optimizing sequence...');
            $('#aiChatButtons').hide();
            
            // Map current mapData to request format
            const requestData = {
                CurrentPoints: mapData.map(d => ({
                    Lat: d.lat,
                    Lng: d.lng,
                    PoId: d.id
                }))
            };

            $.ajax({
                url: '/Delivery/OptimizeRoute',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                success: function(response) {
                    if (response.success) {
                        $('#aiChatMessage').html('✅ <b>Sequence Optimized!</b><br>Path updated for maximum efficiency. <br><small>Est. Distance: ' + response.estimatedDistanceKm + ' km</small>');
                        $('#aiChatButtons').html('<button class="btn btn-sm btn-success rounded-pill px-4 w-100" onclick="closeAiWidget()">Excellent</button>').show();
                        if (mapRouteLine) mapRouteLine.setStyle({ color: '#2E9C7A', dashArray: null, weight: 4, opacity: 0.8 });
                    } else {
                        $('#aiChatMessage').html('❌ <b>Optimization Failed!</b><br>' + response.message);
                        $('#aiChatButtons').show();
                    }
                },
                error: function() {
                    $('#aiChatMessage').html('❌ <b>Connection Error!</b><br>Could not reach the routing service.');
                    $('#aiChatButtons').show();
                }
            });
        }

        function closeAiWidget() { $('#aiChatbotWidget').fadeOut(); }

        $(document).ready(() => initMiniMap());
    </script>
}