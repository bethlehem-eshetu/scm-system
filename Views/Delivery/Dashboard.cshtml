@model SCM_System.Models.Entities.SupplierEmployee
@{
    ViewData["Title"] = "Delivery Fulfillment Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5 px-4">
    <!-- Premium Header (SCM Style) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5 animate-slide-up">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">Delivery Fulfillment Center</h1>
            <p class="text-muted small mb-0"><i class="fas fa-id-card me-2"></i>Agent: @Model.User.FullName | System synced for active dispatch.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center">
            <button class="btn btn-white rounded-pill shadow-sm px-4 fw-bold text-dark-green border" data-bs-toggle="modal" data-bs-target="#contactDispatchModal">
                <i class="fas fa-headset me-2"></i> Dispatch
            </button>
            <a asp-action="MyDeliveries" class="btn btn-dark-green rounded-pill shadow-premium px-4 fw-bold text-white">
                <i class="fas fa-list-check me-2"></i> All Tasks
            </a>
        </div>
    </div>

    <!-- Main KPI Grid (SCM Style) -->
    <div class="row g-4 mb-5">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-soft-warning p-3 rounded-4">
                        <i class="fas fa-truck-loading text-warning fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Assigned</p>
                        <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.AssignedDeliveries</h3>
                    </div>
                </div>
                <div class="x-small text-muted fw-bold">Pending Pickup / Ready</div>
            </div>
        </div>
        
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 rounded-5 bg-dark-green text-white shadow-premium h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-white bg-opacity-10 p-3 rounded-4">
                        <i class="fas fa-route text-accent-green fs-4"></i>
                    </div>
                    <div>
                        <p class="text-white-50 small text-uppercase fw-bold ls-1 mb-0">In Transit</p>
                        <h3 class="fw-bold mb-0 text-accent-green">@ViewBag.InTransitDeliveries</h3>
                    </div>
                </div>
                <div class="x-small text-white-50 fw-bold">Live on the Road</div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-soft-success p-3 rounded-4">
                        <i class="fas fa-check-double text-success fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Completed</p>
                        <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.CompletedDeliveries</h3>
                    </div>
                </div>
                <div class="x-small text-muted fw-bold">Successfully Fulfilled</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Assigned Deliveries Table -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-5 bg-white shadow-premium overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark-green">Active Dispatch List</h5>
                        <p class="x-small text-muted mb-0">Immediate tasks and route details</p>
                    </div>
                    <div class="status-badge bg-soft-info text-info">
                        Live Tracking Active
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="bg-faint-green">
                            <tr>
                                <th class="ps-4 py-3 text-muted x-small text-uppercase fw-bold ls-1">PO Details</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Recipient</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Destination</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Status</th>
                                <th class="pe-4 py-3 text-muted x-small text-uppercase fw-bold ls-1 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ActiveDeliveries != null && ((IEnumerable<dynamic>)ViewBag.ActiveDeliveries).Any())
                            {
                                foreach (var del in ViewBag.ActiveDeliveries)
                                {
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="fw-bold text-dark-green">#@del.PurchaseOrder.PONumber</div>
                                            <div class="x-small text-muted">@del.PurchaseOrder.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark-green">@del.PurchaseOrder.Retailer.BusinessName</div>
                                            <div class="x-small text-muted">@del.PurchaseOrder.Retailer.Phone</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark-green">@del.PurchaseOrder.Warehouse.City</div>
                                            <div class="x-small text-muted text-truncate" style="max-width: 150px;">@del.PurchaseOrder.Warehouse.Region</div>
                                        </td>
                                        <td>
                                            @{
                                                var (badgeClass, textColor) = del.Status switch {
                                                    "Assigned" => ("bg-soft-warning", "text-warning"),
                                                    "In Transit" => ("bg-soft-primary", "text-primary"),
                                                    "Delivered" => ("bg-soft-success", "text-success"),
                                                    _ => ("bg-soft-secondary", "text-secondary")
                                                };
                                            }
                                            <span class="status-badge @badgeClass @textColor">@del.Status</span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <a asp-action="Tracking" asp-route-id="@del.Id" class="btn btn-dark-green rounded-pill px-3 py-1 fw-bold extra-small shadow-sm">
                                                Track & Update
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 opacity-50">
                                         <i class="fas fa-truck fa-3x mb-3 text-dark-green"></i>
                                         <h6 class="fw-bold text-dark-green">No active assignments</h6>
                                         <p class="small text-muted mb-0">Wait for dispatch to assign new routes.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- AI Route Assistant Widget (Themed Green) -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-5 bg-white shadow-premium p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-dark-green text-accent-green p-3 rounded-circle shadow-sm">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark-green mb-0">Route Assistant</h6>
                        <span class="badge bg-soft-success text-success x-small">AI-Powered</span>
                    </div>
                </div>
                
                <div class="assistant-content p-3 bg-faint-green rounded-4 mb-4 border border-faint shadow-inner">
                    <p class="small text-dark-green mb-0 fw-bold">
                        <i class="fas fa-info-circle me-2 opacity-50"></i>
                        Optimizing sequence for @(ViewBag.AssignedDeliveries) pending stops. Weather: Clear. Traffic: Moderate in Central Region.
                    </p>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-white border border-faint shadow-sm">
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-dark-green opacity-50">
                                <i class="fas fa-gas-pump"></i>
                            </div>
                            <div class="fw-bold small text-dark-green">Nearest Fuel</div>
                        </div>
                        <div class="fw-bold text-dark-green small">2.4 km</div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-white border border-faint shadow-sm">
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-dark-green opacity-50">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="fw-bold small text-dark-green">Est. Completion</div>
                        </div>
                        <div class="fw-bold text-dark-green small">@DateTime.Now.AddHours(3).ToString("HH:mm")</div>
                    </div>
                </div>

                <button class="btn btn-dark-green w-100 py-3 mt-4 fw-bold rounded-pill shadow-premium">
                    <i class="fas fa-map-marked-alt me-2 text-accent-green"></i> Start Optimized Route
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .btn-white { background-color: white; color: var(--dark-green); border: 1px solid #eee; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .shadow-inner { box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }
        .extra-small { font-size: 0.7rem; }
        
        .status-badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.1); }
        .bg-soft-secondary { background-color: rgba(108, 117, 125, 0.1); }

        .animate-slide-up { animation: slideUp 0.6s ease-out; }
        @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
    </style>
}