@model SCM_System.Models.Entities.SupplierEmployee
@{
    ViewData["Title"] = "Delivery Fulfillment Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5 px-4">
    <!-- Premium Header (SCM Style) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5 animate-slide-up">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">Delivery Fulfillment Center</h1>
            <p class="text-muted small mb-0"><i class="fas fa-id-card me-2"></i>Agent: @Model.User.FullName | System synced for active dispatch.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center">
            <button class="btn btn-outline-dark-green rounded-pill shadow-sm px-4 fw-bold">
                <i class="fas fa-history me-2"></i> Dispatch Log
            </button>
            <a asp-action="MyDeliveries" class="btn btn-dark-green rounded-pill shadow-premium px-4 fw-bold text-white">
                <i class="fas fa-list-check me-2"></i> All Tasks
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Live Status Card -->
        <div class="col-xl-3 col-md-6 animate-slide-up" style="animation-delay: 0.1s;">
            <div class="card border-0 rounded-20 shadow-premium h-100 overflow-hidden bg-white">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="icon-shape bg-soft-green text-dark-green rounded-circle">
                            <i class="fas fa-signal"></i>
                        </div>
                        <span class="badge bg-soft-green text-dark-green rounded-pill px-3">Live</span>
                    </div>
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Current Status</h6>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="mb-0 fw-bold @(Model.IsOnDuty ? "text-success" : "text-danger")">@(Model.IsOnDuty ? "On Duty" : "Offline")</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Card -->
        <div class="col-xl-3 col-md-6 animate-slide-up" style="animation-delay: 0.2s;">
            <div class="card border-0 rounded-20 shadow-premium h-100 bg-white">
                <div class="card-body p-4">
                    <div class="icon-shape bg-soft-green text-dark-green rounded-circle mb-4">
                        <i class="fas fa-star"></i>
                    </div>
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Service Rating</h6>
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="mb-0 fw-bold text-dark">4.9</h2>
                        <div class="text-warning small">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Card: Active Dispatches -->
        <div class="col-xl-3 col-md-6 animate-slide-up" style="animation-delay: 0.3s;">
            <div class="card border-0 rounded-20 shadow-premium h-100 bg-white">
                <div class="card-body p-4">
                    <div class="icon-shape bg-soft-green text-dark-green rounded-circle mb-4">
                        <i class="fas fa-box"></i>
                    </div>
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Active Deliveries</h6>
                    <h2 class="mb-0 fw-bold text-dark">@ViewBag.InTransitDeliveries</h2>
                </div>
            </div>
        </div>

        <!-- Metric Card: Vehicle -->
        <div class="col-xl-3 col-md-6 animate-slide-up" style="animation-delay: 0.4s;">
            <div class="card border-0 rounded-20 shadow-premium h-100 bg-white">
                <div class="card-body p-4">
                    <div class="icon-shape bg-soft-green text-dark-green rounded-circle mb-4">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Assigned Vehicle</h6>
                    <h2 class="mb-0 fw-bold text-dark small text-truncate">@(Model.Vehicle?.LicensePlate ?? "No Asset")</h2>
                    <p class="text-muted extra-small mb-0 mt-1">@Model.Vehicle?.VehicleType - Health Check: Green</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Content Area: Active Dispatch Management -->
        <div class="col-xl-8 animate-slide-up" style="animation-delay: 0.5s;">
            <div class="card border-0 rounded-20 shadow-premium h-100 bg-white">
                <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Active Dispatch List</h5>
                    <button class="btn btn-soft-green btn-sm rounded-pill px-3">Refresh</button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-scm-table">
                            <thead class="bg-light-green-subtle">
                                <tr>
                                    <th class="ps-4">PO INFO</th>
                                    <th>DESTINATION</th>
                                    <th>PHONE</th>
                                    <th>STATUS</th>
                                    <th class="pe-4 text-end">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ActiveDeliveries != null)
                                {
                                    foreach (var del in ViewBag.ActiveDeliveries)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="status-indicator @(del.Status == "In Transit" ? "bg-success" : "bg-warning")"></div>
                                                    <div>
                                                        <a href="#" class="text-dark-green fw-bold d-block text-decoration-none">#@del.PONumber</a>
                                                        <span class="text-muted extra-small">Added: @del.CreatedAt.ToString("MMM dd")</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-dark small d-block">@del.Retailer?.BusinessName</span>
                                                <span class="text-muted extra-small"><i class="fas fa-map-marker-alt me-1"></i> @del.Retailer?.BusinessAddress</span>
                                            </td>
                                            <td><span class="text-muted small">@del.Retailer?.ContactPersonPhone</span></td>
                                            <td>
                                                <span class="badge @(del.Status == "In Transit" ? "bg-soft-success text-success" : "bg-soft-warning text-warning") rounded-pill px-3 py-2 fw-medium">
                                                    @del.Status
                                                </span>
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a asp-action="Tracking" asp-route-id="@del.Id" class="btn btn-dark-green rounded-pill px-3 py-1 fw-bold extra-small shadow-sm">
                                                    Track & Update
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <p class="text-muted mb-0">No active dispatches assigned yet.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Area: AI Route Assistant & Tools -->
        <div class="col-xl-4 animate-slide-up" style="animation-delay: 0.6s;">
            <div class="card border-0 rounded-20 shadow-premium bg-white mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4">AI Route Assistant</h5>
                    <div class="p-3 bg-light-green-subtle rounded-15 border border-dashed-green mb-4">
                        <div class="d-flex gap-3">
                            <div class="icon-shape bg-white text-dark-green rounded-circle shadow-sm">
                                <i class="fas fa-brain"></i>
                            </div>
                            <div>
                                <p class="text-dark small fw-bold mb-1">Weather Alert: Light Rain</p>
                                <p class="text-muted extra-small mb-0">Route via Bole Road is 12m faster due to traffic.</p>
                            </div>
                        </div>
                    </div>
                    <a asp-action="RouteItinerary" class="btn btn-dark-green w-100 py-3 mt-4 fw-bold rounded-pill shadow-premium">
                        <i class="fas fa-map-marked-alt me-2 text-accent-green"></i> Start Optimized Route
                    </a>
                </div>
            </div>

            <div class="card border-0 rounded-20 shadow-premium bg-dark-green text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <h5 class="fw-bold mb-3">Quick Support</h5>
                    <p class="text-white-50 small">Encountered an issue during fulfillment? Contact our ops center instantly.</p>
                    <button class="btn btn-light rounded-pill px-4 fw-bold w-100 text-dark-green mt-2" data-bs-toggle="modal" data-bs-target="#quickSupportModal">
                        <i class="fas fa-headset me-2"></i> Immediate Help
                    </button>
                    <!-- Decorative Circle -->
                    <div class="position-absolute" style="right: -20px; bottom: -20px; opacity: 0.1;">
                        <i class="fas fa-life-ring fa-5x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_SupportModal", (IEnumerable<SCM_System.Models.Entities.PurchaseOrder>)ViewBag.ActiveDeliveries)

<style>
    .rounded-20 { border-radius: 20px !important; }
    .rounded-15 { border-radius: 15px !important; }
    .shadow-premium { box-shadow: 0 10px 30px rgba(0,0,0,0.05) !important; }
    .bg-light-green-subtle { background-color: #f0f7f4 !important; }
    .bg-soft-green { background-color: rgba(46, 125, 50, 0.1) !important; }
    .text-dark-green { color: #2e7d32 !important; }
    .btn-dark-green { background: #2e7d32 !important; border: none; transition: all 0.3s ease; }
    .btn-dark-green:hover { background: #1b5e20 !important; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(46, 125, 50, 0.3); }
    .btn-soft-green { background: rgba(46, 125, 50, 0.1) !important; color: #2e7d32 !important; border: none; }
    .icon-shape { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; }
    .extra-small { font-size: 0.75rem !important; }
    .status-indicator { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .bg-soft-success { background-color: rgba(46, 125, 50, 0.1); }
    .bg-soft-warning { background-color: rgba(255, 179, 0, 0.1); }
    .border-dashed-green { border-style: dashed !important; border-color: #2e7d32 !important; }
    
    .animate-slide-up {
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 0.6s forwards;
    }

    @@keyframes slideUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .custom-scm-table th {
        font-size: 0.7rem;
        letter-spacing: 0.5px;
        color: #5c7063;
        padding-top: 15px;
        padding-bottom: 15px;
    }
    
    .custom-scm-table td {
        padding-top: 20px;
        padding-bottom: 20px;
    }
</style>