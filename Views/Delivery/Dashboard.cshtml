@model SCM_System.Models.Entities.SupplierEmployee

@{
    ViewData["Title"] = "Delivery Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="glass-panel p-4 mb-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="animated-bg" style="opacity: 0.05;"></div>
        <div class="position-relative z-index-1">
            <h1 class="text-white mb-1 fw-bold">Delivery Portal</h1>
            <p class="text-white-50 mb-0">Logistics and Fulfillment | @Model.User.FullName</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Assigned</p>
                            <h3 class="fw-bold mb-0">@ViewBag.AssignedDeliveries</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                            <i class="fas fa-truck-loading fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">On The Way</p>
                            <h3 class="fw-bold mb-0">@ViewBag.InTransitDeliveries</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                            <i class="fas fa-route fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small text-uppercase fw-bold mb-1">Completed</p>
                            <h3 class="fw-bold mb-0">@ViewBag.CompletedDeliveries</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                            <i class="fas fa-check-double fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Deliveries -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-map-marked-alt me-2"></i>Assigned Deliveries
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info bg-primary bg-opacity-10 border-0 rounded-4 text-primary mb-4 p-3">
                        <div class="d-flex gap-3">
                            <i class="fas fa-info-circle fa-lg"></i>
                            <span class="small fw-medium">Check your route details before departure. Ensure proof of delivery is captured.</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>PO Number</th>
                                    <th>Destination</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentDeliveries != null && ViewBag.RecentDeliveries.Count > 0)
                                {
                                    foreach (var delivery in ViewBag.RecentDeliveries)
                                    {
                                        <tr>
                                            <td class="fw-bold">@delivery.PONumber</td>
                                            <td>@delivery.Destination</td>
                                            <td>
                                                @if (delivery.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary rounded-pill px-3">In Transit</span>
                                                }
                                                else if (delivery.Status == "Ready")
                                                {
                                                    <span class="badge bg-warning rounded-pill px-3">Ready for Pickup</span>
                                                }
                                                else if (delivery.Status == "Packed")
                                                {
                                                    <span class="badge bg-info rounded-pill px-3">Packed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill px-3">@delivery.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="MyDeliveries" class="btn btn-sm btn-primary rounded-pill px-3">
                                                    <i class="fas fa-eye me-1"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-truck fa-2x mb-3 d-block opacity-25"></i>
                                            No active delivery assignments
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Route & Support -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-info">
                        <i class="fas fa-location-arrow me-2"></i>Active Route
                    </h6>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="text-muted py-4">
                        <i class="fas fa-map-signs fa-3x mb-3 opacity-25"></i>
                        <p class="small mb-0">No active route selected. Select a delivery to begin navigation.</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-headset me-2"></i>Delivery Support
                    </h6>
                </div>
                <div class="card-body p-4">
                    <button class="btn btn-primary w-100 rounded-pill mb-3" onclick="alert('Contact dispatch at: support@scm.com or call +251-XXX-XXXX')">
                        <i class="fas fa-phone-alt me-2"></i> Contact Dispatch
                    </button>
                    <button class="btn btn-outline-secondary w-100 rounded-pill" onclick="window.open('https://help.scm.com', '_blank')">
                        <i class="fas fa-question-circle me-2"></i> Help Center
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>