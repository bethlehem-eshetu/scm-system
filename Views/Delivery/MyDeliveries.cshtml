@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "My Deliveries";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Deliveries</h2>
            <p class="text-muted mb-0">Track and update assigned delivery routes</p>
        </div>
        <div>
            <span class="badge bg-primary rounded-pill px-3">@Model.Count() Active Deliveries</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var po in Model)
            {
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm h-100 position-relative overflow-hidden">
                        <!-- Status indicator bar -->
                        <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: @(po.Status == "ReadyForPickup" ? "var(--bs-warning)" : (po.Status == "InTransit" ? "var(--bs-primary)" : "var(--bs-success)"));"></div>
                        
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <div class="d-flex align-items-center mb-1">
                                        <h5 class="fw-bold mb-0 me-2 text-dark">@po.PONumber</h5>
                                        <span class="badge @(po.Status == "ReadyForPickup" ? "bg-warning" : (po.Status == "InTransit" ? "bg-primary" : "bg-success")) rounded-pill px-3">
                                            @po.Status
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Assigned: @po.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-primary">@po.PurchaseOrderItems?.Count Items</div>
                                    <div class="text-muted small">@po.TotalAmount.ToString("C")</div>
                                </div>
                            </div>

                            <div class="bg-light rounded-3 p-3 mb-4">
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="text-uppercase small fw-bold text-muted mb-1">Destination</div>
                                        <div class="fw-medium text-dark"><i class="fas fa-building text-primary me-2"></i>@po.Order?.Retailer?.BusinessName</div>
                                        <div class="small mt-1"><i class="fas fa-map-marker-alt text-muted me-2"></i>@po.DeliveryAddress</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="text-uppercase small fw-bold text-muted mb-1">Contact</div>
                                        <div class="fw-medium text-dark"><i class="fas fa-user text-primary me-2"></i>@po.Order?.Retailer?.User?.FullName</div>
                                        <div class="small mt-1"><i class="fas fa-phone-alt text-muted me-2"></i>@po.Order?.Retailer?.User?.PhoneNumber</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end mt-auto">
                                @if (po.Status == "ReadyForPickup")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                        <input type="hidden" name="status" value="InTransit" />
                                        <button type="submit" class="btn btn-primary rounded-pill px-4" onclick="return confirm('Confirm you have picked up this order and are beginning transit?');">
                                            <i class="fas fa-truck-loading me-2"></i> Start Transit
                                        </button>
                                    </form>
                                }
                                else if (po.Status == "InTransit")
                                {
                                    <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deliveryModal-@po.Id">
                                        <i class="fas fa-check-circle me-2"></i> Complete Delivery
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Complete Delivery Modal (Requires Proof) -->
                @if (po.Status == "InTransit")
                {
                    <div class="modal fade" id="deliveryModal-@po.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Sign-off Delivery @po.PONumber</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                    <input type="hidden" name="status" value="Delivered" />
                                    
                                    <div class="modal-body p-4">
                                        <div class="alert alert-info border-0 rounded-3 mb-4">
                                            <i class="fas fa-info-circle me-2"></i> Proof of delivery is required to finalize this drop-off.
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Receiver Signature / Proof Code <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text border-end-0 bg-light"><i class="fas fa-signature text-muted"></i></span>
                                                <input type="text" name="proofData" class="form-control border-start-0 ps-0 text-dark font-monospace" placeholder="e.g. Received by John Doe or Code #4192" required />
                                            </div>
                                            <div class="form-text mt-2">Enter the name of the receiver or validation code provided by the retailer.</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-success rounded-pill px-4">
                                            <i class="fas fa-flag-checkered me-2"></i> Confirm Delivery
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <div class="opacity-25 mb-4">
                            <i class="fas fa-route fa-4x text-primary"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">No Active Deliveries</h4>
                        <p class="text-muted mb-0">You currently have no purchase orders assigned for delivery. Check back later.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
