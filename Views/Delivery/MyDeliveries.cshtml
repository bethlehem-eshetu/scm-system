@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "My Deliveries";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark mb-1">Logistics Operations</h2>
            <p class="text-muted mb-0">Professional delivery fulfillment and verification hub.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
                <div class="small fw-bold text-dark">@User.Identity.Name</div>
                <div class="smaller text-muted">Delivery Professional</div>
            </div>
            <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                <i class="fas fa-truck text-primary fa-lg"></i>
            </div>
        </div>
    </div>

    <!-- Active Delivery Cards -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var po in Model)
            {
                var isFailed = po.Status == POStatus.Failed;
                var isDelivered = po.Status == POStatus.Delivered || po.Status == POStatus.Completed;
                
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <!-- Status Line -->
                                <div class="col-12" style="height: 4px; background: @(isFailed ? "var(--bs-danger)" : (isDelivered ? "var(--bs-success)" : "var(--bs-primary)"));"></div>
                                
                                <!-- Info Panel -->
                                <div class="col-lg-4 p-4 border-end bg-light bg-opacity-25">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-indigo bg-opacity-10 text-#17a2b8 rounded-pill px-3 mb-2">@po.PONumber</span>
                                            <h4 class="fw-bold text-dark mb-0">@po.Order?.Retailer?.BusinessName</h4>
                                        </div>
                                        @if (isFailed)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3"><i class="fas fa-exclamation-circle me-1"></i> FAILED</span>
                                        }
                                        else
                                        {
                                            <span class="badge @(po.Status == POStatus.InTransit ? "bg-primary" : "bg-warning") rounded-pill px-3">@po.Status</span>
                                        }
                                    </div>
                                    
                                    <div class="space-y-3 mt-4">
                                        <div class="d-flex align-items-center text-muted">
                                            <div class="bg-white shadow-sm p-2 rounded-3 me-3" style="width: 38px; text-align: center;">
                                                <i class="fas fa-map-marker-alt text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="smaller text-uppercase fw-bold ls-1">Delivery Address</div>
                                                <div class="text-dark fw-medium small">@po.DeliveryAddress</div>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex align-items-center text-muted mt-3">
                                            <div class="bg-white shadow-sm p-2 rounded-3 me-3" style="width: 38px; text-align: center;">
                                                <i class="fas fa-user-circle text-info"></i>
                                            </div>
                                            <div>
                                                <div class="smaller text-uppercase fw-bold ls-1">Recipient</div>
                                                <div class="text-dark fw-medium small">@po.Order?.Retailer?.User?.FullName (@po.Order?.Retailer?.User?.PhoneNumber)</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-4 border-top">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Items Count</span>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">@po.PurchaseOrderItems?.Count Items</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <span class="text-muted small">Total Value</span>
                                            <span class="fw-bold text-dark">@po.TotalAmount.ToString("N2") ETB</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Panel -->
                                <div class="col-lg-8 p-4 d-flex flex-column">
                                    <!-- Delivery Timeline -->
                                    <div class="delivery-timeline mb-5 mt-2 px-3">
                                        <div class="timeline-step @(po.Status == POStatus.Accepted || po.Status == POStatus.Issued ? "active" : "completed")">
                                            <div class="step-icon"><i class="fas fa-clipboard-check"></i></div>
                                            <div class="step-label">Assigned</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.Picking ? "active" : (po.PickedAt.HasValue ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-box-open"></i></div>
                                            <div class="step-label">Picked</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.Packed ? "active" : (po.PackedAt.HasValue ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-box shadow-sm"></i></div>
                                            <div class="step-label">Packed</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.InTransit ? "active" : (isDelivered ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-truck"></i></div>
                                            <div class="step-label">Transit</div>
                                        </div>
                                        <div class="timeline-step @(isDelivered ? "completed" : "pending")">
                                            <div class="step-icon"><i class="fas fa-home"></i></div>
                                            <div class="step-label">Arrived</div>
                                        </div>
                                    </div>

                                    <div class="mt-auto d-flex flex-wrap gap-3 justify-content-end p-2">
                                        @if (po.Status == POStatus.Ready || po.Status == POStatus.Packed)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                                <input type="hidden" name="status" value="@POStatus.InTransit" />
                                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                                    <i class="fas fa-play me-2"></i> START OUT FOR DELIVERY
                                                </button>
                                            </form>
                                        }
                                        else if (po.Status == POStatus.InTransit)
                                        {
                                            <button class="btn btn-outline-danger btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#failModal-@po.Id">
                                                <i class="fas fa-times-circle me-2"></i> Report Failure
                                            </button>
                                            <button class="btn btn-success btn-lg rounded-pill px-5 shadow-sm" data-bs-toggle="modal" data-bs-target="#deliverModal-@po.Id">
                                                <i class="fas fa-check-double me-2"></i> COMPLETE DELIVERY
                                            </button>
                                        }
                                        else if (isFailed)
                                        {
                                            <div class="alert alert-soft-danger py-2 px-3 rounded-pill mb-0">
                                                <i class="fas fa-info-circle me-1"></i> Awaiting manager reassignment. Reasoning: @po.FailureReason
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DELIVERY SUCCESS MODAL (ELITE) -->
                <div class="modal fade" id="deliverModal-@po.Id" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                            <div class="modal-header bg-success text-white py-3 px-4">
                                <h5 class="modal-title fw-bold"><i class="fas fa-check-circle me-2"></i>Complete Delivery - @po.PONumber</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data" id="form-@po.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                <input type="hidden" name="status" value="@POStatus.Delivered" />
                                <input type="hidden" name="signatureData" id="sigData-@po.Id" />
                                
                                <div class="modal-body p-4">
                                    <!-- 1. Verification Section -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-4 h-100 bg-light bg-opacity-50">
                                                <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 1: Identity Verification</label>
                                                <div class="d-grid gap-2">
                                                    <button type="button" class="btn btn-white border shadow-sm rounded-pill text-primary fw-bold" 
                                                            data-bs-toggle="modal" data-bs-target="#qrScannerModal-@po.Id">
                                                        <i class="fas fa-qrcode me-2"></i> Scan Customer QR
                                                    </button>
                                                    <div id="qrStatus-@po.Id" class="text-center mt-2 small @(po.IsQRVerified ? "text-success" : "text-muted")">
                                                        @if (po.IsQRVerified) { <i class="fas fa-check-circle"></i> <span>Verified</span> } else { <span>Not yet verified</span> }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-4 h-100 bg-light bg-opacity-50">
                                                <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 2: Security Checklist</label>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" id="check1-@po.Id" required>
                                                    <label class="form-check-label small" for="check1-@po.Id">Package condition checked</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" id="check2-@po.Id" required>
                                                    <label class="form-check-label small" for="check2-@po.Id">Correct address verified</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="checklistVerified" value="true" id="checkFinal-@po.Id" required>
                                                    <label class="form-check-label small fw-bold" for="checkFinal-@po.Id">Recipient confirmed present</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Evidence Section -->
                                    <div class="row g-4">
                                        <div class="col-md-7">
                                            <div class="p-3 border rounded-4 bg-light bg-opacity-50">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <label class="form-label fw-bold small text-muted text-uppercase ls-1 mb-0">Step 3: Digital Signature</label>
                                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" onclick="clearSignature(@po.Id)">Clear</button>
                                                </div>
                                                <canvas id="pad-@po.Id" class="bg-white border rounded-3 w-100 shadow-inner" style="height: 180px; cursor: crosshair;"></canvas>
                                                <div class="smaller text-muted mt-1">Please ask the customer to sign above</div>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="p-3 border rounded-4 bg-light bg-opacity-50 h-100">
                                                <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 4: Photo Proof</label>
                                                <div class="border-dashed-custom rounded-3 text-center py-4 bg-white" onclick="document.getElementById('img-@po.Id').click()" style="cursor: pointer;">
                                                    <input type="file" name="proofImage" id="img-@po.Id" class="d-none" accept="image/*" onchange="previewImg(@po.Id)">
                                                    <div id="previewBox-@po.Id">
                                                        <i class="fas fa-camera fa-2x text-muted mb-2"></i>
                                                        <div class="smaller fw-bold text-primary">UPLOAD PHOTO</div>
                                                    </div>
                                                    <img id="previewImg-@po.Id" src="#" class="img-fluid rounded d-none" style="max-height: 120px;">
                                                </div>
                                                <textarea name="deliveryNotes" class="form-control form-control-sm mt-3 border-0 bg-white" rows="2" placeholder="Delivery notes (optional)..."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-0 px-4 py-3">
                                    <button type="button" class="btn btn-white border rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success rounded-pill px-5 shadow-sm" onclick="return finalizeDelivery(@po.Id)">
                                        <i class="fas fa-check-double me-2"></i>SUBMIT COMPLETE DELIVERY
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- DELIVERY FAILURE MODAL -->
                <div class="modal fade" id="failModal-@po.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow rounded-4">
                            <div class="modal-header bg-danger text-white border-0">
                                <h5 class="modal-title fw-bold">Report Delivery Failure</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="MarkAsFailed" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                <div class="modal-body p-4">
                                    <label class="form-label fw-bold">Reason for Failure</label>
                                    <select name="reason" class="form-select border-0 bg-light" required>
                                        <option value="">Select a reason...</option>
                                        <option value="Customer Unavailable">Customer Unavailable</option>
                                        <option value="Wrong Address">Wrong Address/Address Not Found</option>
                                        <option value="Customer Refused">Customer Refused Goods</option>
                                        <option value="Vehicle Breakdown">Logistics/Vehicle Failure</option>
                                        <option value="Safety Issue">Safety/Security Issue</option>
                                    </select>
                                    <div class="form-text mt-3">This will hold the order for reassignment or retry by your manager.</div>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Confirm Failure</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <!-- QR SCANNER PARTIAL -->
                @await Html.PartialAsync("_QRCodeReader", po.Id)
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-light bg-opacity-50 p-5 rounded-5 border border-dashed-custom">
                    <i class="fas fa-clipboard-list fa-4x text-muted mb-4"></i>
                    <h4 class="fw-bold text-dark">No Active Route Found</h4>
                    <p class="text-muted">You have no pending deliveries assigned. Enjoy your break!</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bg-indigo { background: #4f46e5; }
    .text-indigo { color: #4f46e5; }
    .ls-1 { letter-spacing: 1px; }
    .smaller { font-size: 0.75rem; }
    .space-y-3 > * + * { margin-top: 0.75rem; }

    /* Timeline Styling */
    .delivery-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    .delivery-timeline::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 50px;
        right: 50px;
        height: 2px;
        background: #e5e7eb;
        z-index: 0;
    }
    .timeline-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100px;
    }
    .step-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: white;
        border: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        transition: all 0.3s ease;
        margin-bottom: 8px;
    }
    .step-label { font-size: 0.7rem; font-weight: 600; color: #9ca3af; text-transform: uppercase; }
    
    .timeline-step.completed .step-icon { background: #10b981; border-color: #10b981; color: white; }
    .timeline-step.completed .step-label { color: #10b981; }
    
    .timeline-step.active .step-icon { background: #4f46e5; border-color: #4f46e5; color: white; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); }
    .timeline-step.active .step-label { color: #4f46e5; }

    .border-dashed-custom { border: 2px dashed #e5e7eb; transition: all 0.2s; }
    .border-dashed-custom:hover { border-color: #4f46e5; background: #f9fafb !important; }

    canvas { touch-action: none; }
</style>

@section Scripts {
    <script>
        const pads = {};

        function initCanvas(poId) {
            const canvas = document.getElementById('pad-' + poId);
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            let drawing = false;

            // Set canvas size
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;

            ctx.lineWidth = 3;
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#1e293b';

            const start = (e) => {
                drawing = true;
                ctx.beginPath();
                const pos = getPos(e, canvas);
                ctx.moveTo(pos.x, pos.y);
            };

            const draw = (e) => {
                if (!drawing) return;
                const pos = getPos(e, canvas);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
            };

            const end = () => drawing = false;

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', draw);
            window.addEventListener('mouseup', end);

            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                start(e.touches[0]);
            });
            canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                draw(e.touches[0]);
            });
            canvas.addEventListener('touchend', end);

            pads[poId] = { canvas, ctx, empty: true };
            
            // Mark not empty on stroke
            canvas.addEventListener('mousedown', () => pads[poId].empty = false);
            canvas.addEventListener('touchstart', () => pads[poId].empty = false);
        }

        function getPos(e, canvas) {
            const rect = canvas.getBoundingClientRect();
            return {
                x: e.clientX - rect.left,
                y: e.clientY - rect.top
            };
        }

        function clearSignature(poId) {
            const pad = pads[poId];
            if (pad) {
                pad.ctx.clearRect(0, 0, pad.canvas.width, pad.canvas.height);
                pad.empty = true;
            }
        }

        function previewImg(poId) {
            const input = document.getElementById('img-' + poId);
            const preview = document.getElementById('previewImg-' + poId);
            const icon = document.getElementById('previewBox-' + poId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    icon.classList.add('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function finalizeDelivery(poId) {
            const pad = pads[poId];
            const dataInput = document.getElementById('sigData-' + poId);
            const photoInput = document.getElementById('img-' + poId);
            const qrVerified = @Html.Raw(Json.Serialize(Model.ToDictionary(m => m.Id, m => m.IsQRVerified)));
            
            // Capture signature if not empty
            if (pad && !pad.empty) {
                dataInput.value = pad.canvas.toDataURL();
            }

            // Proof Validation (1/3 required)
            const hasSig = dataInput.value !== "";
            const hasPhoto = photoInput.files.length > 0;
            const hasQR = qrVerified[poId] === true;

            if (!hasSig && !hasPhoto && !hasQR) {
                alert("CRITICAL: You must provide at least ONE piece of evidence (Signature, Photo, or QR Code).");
                return false;
            }

            return true;
        }

        // Initialize canvases when modals open
        document.addEventListener('shown.bs.modal', function (event) {
            const modalId = event.target.id;
            if (modalId.startsWith('deliverModal-')) {
                const poId = modalId.split('-')[1];
                initCanvas(poId);
            }
        });
        
        // QR Verification callback logic
        window.onQRVerified = function(poId) {
            const btn = document.querySelector(`#deliverModal-${poId} [data-bs-target^="#qrScannerModal"]`);
            const status = document.getElementById(`qrStatus-${poId}`);
            if (btn && status) {
                btn.classList.replace('btn-white', 'btn-success');
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> QR VERIFIED';
                status.innerHTML = '<i class="fas fa-check-circle text-success"></i> <span class="text-success">Verified</span>';
                // Trigger auto-submit maybe? No, let user confirm notes/checklist.
            }
        };
    </script>
}