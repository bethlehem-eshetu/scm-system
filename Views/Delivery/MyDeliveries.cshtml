@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@using SCM_System.Models.Constants
@{
    ViewData["Title"] = "My Deliveries";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">Logistics Operations</h1>
            <p class="text-muted small mb-0">Professional delivery fulfillment and verification hub.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-action="RouteItinerary" class="btn btn-accent-green rounded-pill px-4 shadow-sm fw-bold d-none d-lg-flex align-items-center text-dark-green">
                <i class="fas fa-magic me-2"></i> SMART ROUTE
            </a>
            <div class="bg-faint-green p-2 rounded-circle shadow-sm" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-truck text-dark-green"></i>
            </div>
        </div>
    </div>

    <!-- Advanced Filtering Section -->
    <div class="card border-0 shadow-premium rounded-5 mb-5 overflow-hidden bg-white">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-lg-5">
                    <div class="input-group input-group-lg bg-faint-green rounded-pill px-3 py-1 border-0">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control bg-transparent border-0 shadow-none text-dark-green small fw-medium" 
                               placeholder="Search Retailer, Supplier, or PO#..." value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-lg-3">
                    <select name="status" class="form-select form-select-lg bg-faint-green border-0 rounded-pill px-4 py-2 text-dark-green small fw-medium shadow-none">
                        <option value="">All Statuses</option>
                        <option value="@POStatus.Ready" selected="@(ViewBag.Status == POStatus.Ready)">Ready to Ship</option>
                        <option value="@POStatus.InTransit" selected="@(ViewBag.Status == POStatus.InTransit)">In Transit</option>
                        <option value="@POStatus.Failed" selected="@(ViewBag.Status == POStatus.Failed)">Failed</option>
                        <option value="@POStatus.Delivered" selected="@(ViewBag.Status == POStatus.Delivered)">Delivered</option>
                    </select>
                </div>
                <div class="col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-dark-green rounded-pill px-4 fw-bold flex-grow-1 shadow-sm">
                        <i class="fas fa-filter me-2"></i> Apply Filter
                    </button>
                    <a asp-action="MyDeliveries" class="btn btn-white border rounded-pill px-3 fw-bold text-muted shadow-sm">
                        <i class="fas fa-redo"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>


    <!-- Active Delivery Cards -->
    <div class="row g-4" id="deliveryCardsContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var po in Model)
            {
                var isFailed = po.Status == POStatus.Failed;
                var isDelivered = po.Status == POStatus.Delivered || po.Status == POStatus.Completed;
                
                <div class="col-12 delivery-card" 
                     data-retailer="@(po.Order?.Retailer?.BusinessName?.ToLower() ?? "")" 
                     data-supplier="@(po.Supplier?.CompanyName?.ToLower() ?? "")" 
                     data-ponumber="@po.PONumber.ToLower()" 
                     data-status="@po.Status">
                    <div class="card border-0 shadow-premium rounded-5 overflow-hidden mb-4 bg-white">

                        <div class="card-body p-0">
                            <div class="row g-0">
                                <!-- Status Line -->
                                <div class="col-12" style="height: 6px; background: @(isFailed ? "#dc3545" : (isDelivered ? "#198754" : "var(--dark-green)"));"></div>
                                
                                <!-- Info Panel -->
                                <div class="col-lg-4 p-4 border-end bg-faint-green bg-opacity-50">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-white text-dark-green border border-light rounded-pill px-3 mb-2 small fw-bold">#@po.PONumber</span>
                                            <h4 class="fw-bold text-dark-green mb-0">@po.Order?.Retailer?.BusinessName</h4>
                                        </div>
                                        @if (isFailed)
                                        {
                                            <span class="status-badge bg-soft-danger text-danger"><i class="fas fa-exclamation-circle me-1"></i> FAILED</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge @(po.Status == POStatus.InTransit ? "bg-soft-success text-success" : "bg-soft-warning text-warning")">@po.Status</span>
                                        }
                                    </div>
                                    
                                    <div class="space-y-3 mt-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white shadow-sm p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-map-marker-alt text-dark-green"></i>
                                            </div>
                                            <div>
                                                <div class="x-small text-uppercase fw-bold text-muted ls-1">Delivery Address</div>
                                                <div class="text-dark-green fw-bold small">@po.DeliveryAddress</div>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex align-items-center mt-3">
                                            <div class="bg-white shadow-sm p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user text-accent-green"></i>
                                            </div>
                                            <div>
                                                <div class="x-small text-uppercase fw-bold text-muted ls-1">Recipient</div>
                                                <div class="text-dark-green fw-bold small">@po.Order?.Retailer?.User?.FullName</div>
                                                <div class="x-small text-muted">@po.Order?.Retailer?.User?.PhoneNumber</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-4 border-top border-light">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Items Count</span>
                                            <span class="badge bg-white text-dark-green rounded-pill px-2 py-1 small border border-light">@po.PurchaseOrderItems?.Count Items</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <span class="text-muted small">Total Value</span>
                                            <span class="fw-bold text-dark-green">@po.TotalAmount.ToString("N2") ETB</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Panel -->
                                <div class="col-lg-8 p-4 d-flex flex-column">
                                    <!-- Delivery Timeline -->
                                    <div class="delivery-timeline mb-5 mt-2 px-3">
                                        <div class="timeline-step @(po.Status == POStatus.Accepted || po.Status == POStatus.Issued ? "active" : "completed")">
                                            <div class="step-icon"><i class="fas fa-clipboard-check"></i></div>
                                            <div class="step-label">Assigned</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.Picking ? "active" : (po.PickedAt.HasValue ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-box-open"></i></div>
                                            <div class="step-label">Picked</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.Packed ? "active" : (po.PackedAt.HasValue ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-box"></i></div>
                                            <div class="step-label">Packed</div>
                                        </div>
                                        <div class="timeline-step @(po.Status == POStatus.InTransit ? "active" : (isDelivered ? "completed" : "pending"))">
                                            <div class="step-icon"><i class="fas fa-truck"></i></div>
                                            <div class="step-label">Transit</div>
                                        </div>
                                        <div class="timeline-step @(isDelivered ? "completed" : "pending")">
                                            <div class="step-icon"><i class="fas fa-home"></i></div>
                                            <div class="step-label">Arrived</div>
                                        </div>
                                    </div>

                                    <div class="mt-auto d-flex flex-wrap gap-3 justify-content-end p-2">
                                        @if (po.Status == POStatus.Ready || po.Status == POStatus.Packed)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                                <input type="hidden" name="status" value="@POStatus.InTransit" />
                                                <button type="submit" class="btn btn-dark-green btn-lg rounded-pill px-5 shadow-premium fw-bold">
                                                    <i class="fas fa-play me-2"></i> START DELIVERY
                                                </button>
                                            </form>
                                        }
                                        else if (po.Status == POStatus.InTransit)
                                        {
                                            <button class="btn btn-faint-green text-danger btn-lg rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#failModal-@po.Id">
                                                <i class="fas fa-times-circle me-2"></i> Fail
                                            </button>
                                            <button class="btn btn-accent-green text-dark-green btn-lg rounded-pill px-5 shadow-premium fw-bold" data-bs-toggle="modal" data-bs-target="#deliverModal-@po.Id">
                                                <i class="fas fa-check-double me-2"></i> COMPLETE
                                            </button>
                                        }
                                        else if (isFailed)
                                        {
                                            <div class="alert bg-soft-danger text-danger border-0 py-2 px-4 rounded-pill mb-0 small fw-bold">
                                                <i class="fas fa-info-circle me-2"></i> Awaiting reassignment. Reasoning: @po.FailureReason
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DELIVERY SUCCESS MODAL -->
                <div class="modal fade" id="deliverModal-@po.Id" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-header bg-dark-green text-white py-4 px-4 border-0">
                                <h5 class="modal-title fw-bold"><i class="fas fa-check-circle me-2"></i>Complete Delivery - #@po.PONumber</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data" id="form-@po.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                <input type="hidden" name="status" value="@POStatus.Delivered" />
                                <input type="hidden" name="signatureData" id="sigData-@po.Id" />
                                
                                <div class="modal-body p-4">
                                    <!-- 1. Verification Section -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-4 h-100 bg-light bg-opacity-50">
                                                <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 1: Identity Verification</label>
                                                <div class="d-grid gap-2">
                                                    <button type="button" class="btn btn-white border shadow-sm rounded-pill text-dark-green fw-bold" 
                                                            data-bs-toggle="modal" data-bs-target="#qrScannerModal-@po.Id">
                                                        <i class="fas fa-qrcode me-2"></i> Scan Customer QR
                                                    </button>
                                                    <div id="qrStatus-@po.Id" class="text-center mt-2 small @(po.IsQRVerified ? "text-success" : "text-muted")">
                                                        @if (po.IsQRVerified) { <i class="fas fa-check-circle"></i> <span>Verified</span> } else { <span>Not yet verified</span> }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-4 h-100 bg-light bg-opacity-50">
                                                <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 2: Security Checklist</label>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" id="check1-@po.Id" required>
                                                    <label class="form-check-label small" for="check1-@po.Id">Package condition checked</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" id="check2-@po.Id" required>
                                                    <label class="form-check-label small" for="check2-@po.Id">Correct address verified</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="checklistVerified" value="true" id="checkFinal-@po.Id" required>
                                                    <label class="form-check-label small fw-bold" for="checkFinal-@po.Id">Recipient confirmed present</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Evidence Section -->
                                     <div class="row g-4">
                                         <div class="col-md-7">
                                             <div class="p-3 border rounded-4 bg-light bg-opacity-50">
                                                 <div class="d-flex justify-content-between align-items-center mb-2">
                                                     <label class="form-label fw-bold small text-muted text-uppercase ls-1 mb-0">Step 3: Digital Signature</label>
                                                     <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none x-small" onclick="clearSignature(@po.Id)">Clear</button>
                                                 </div>
                                                <canvas id="pad-@po.Id" class="bg-white border rounded-4 w-100 shadow-sm" style="height: 180px; cursor: crosshair;"></canvas>
                                                <div class="x-small text-muted mt-2">Please ask the customer to sign above</div>
                                             </div>
                                         </div>
                                         <div class="col-md-5">
                                             <div class="p-3 border rounded-4 bg-light bg-opacity-50 h-100">
                                                 <label class="form-label fw-bold small text-muted text-uppercase ls-1">Step 4: Photo Proof</label>
                                                <div class="border-dashed-custom rounded-4 text-center py-4 bg-white" onclick="document.getElementById('img-@po.Id').click()" style="cursor: pointer;">
                                                     <input type="file" name="proofImage" id="img-@po.Id" class="d-none" accept="image/*" onchange="previewImg(@po.Id)">
                                                     <div id="previewBox-@po.Id">
                                                         <i class="fas fa-camera fa-2x text-muted mb-2"></i>
                                                        <div class="x-small fw-bold text-dark-green">UPLOAD PHOTO</div>
                                                     </div>
                                                     <img id="previewImg-@po.Id" src="#" class="img-fluid rounded d-none" style="max-height: 120px;">
                                                 </div>
                                                <textarea name="deliveryNotes" class="form-control form-control-sm mt-3 border-0 bg-white rounded-3 p-3" rows="2" placeholder="Delivery notes..."></textarea>
                                             </div>
                                         </div>
                                     </div>
                                </div>
                                <div class="modal-footer bg-faint-green border-0 px-4 py-4">
                                    <button type="button" class="btn btn-white border-0 rounded-pill px-4 text-muted small fw-bold" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-dark-green rounded-pill px-5 shadow-premium fw-bold" onclick="return finalizeDelivery(@po.Id)">
                                        <i class="fas fa-check-double me-2"></i>SUBMIT COMPLETE DELIVERY
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- DELIVERY FAILURE MODAL -->
                <div class="modal fade" id="failModal-@po.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-header bg-danger text-white border-0">
                                <h5 class="modal-title fw-bold">Report Delivery Failure</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="MarkAsFailed" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                <div class="modal-body p-4">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Reason for Failure</label>
                                    <select name="reason" class="form-select border-0 bg-faint-green rounded-3 p-3" required>
                                        <option value="">Select a reason...</option>
                                        <option value="Customer Unavailable">Customer Unavailable</option>
                                        <option value="Wrong Address">Wrong Address/Address Not Found</option>
                                        <option value="Customer Refused">Customer Refused Goods</option>
                                        <option value="Vehicle Breakdown">Logistics/Vehicle Failure</option>
                                        <option value="Safety Issue">Safety/Security Issue</option>
                                    </select>
                                    <div class="x-small text-muted mt-3">This will hold the order for reassignment or retry by your manager.</div>
                                </div>
                                <div class="modal-footer bg-faint-green border-0 px-4 py-3">
                                    <button type="button" class="btn btn-white border-0 rounded-pill px-4 text-muted small fw-bold" data-bs-modal="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">Confirm Failure</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <!-- QR SCANNER PARTIAL -->
                @await Html.PartialAsync("_QRCodeReader", po.Id)
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-faint-green p-5 rounded-5 border border-dashed-custom">
                    <i class="fas fa-clipboard-list fa-4x text-dark-green opacity-25 mb-4"></i>
                    <h4 class="fw-bold text-dark-green">No Active Route Found</h4>
                    <p class="text-muted">You have no pending deliveries assigned. Enjoy your break!</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --dark-green: #1a3d31;
        --accent-green: #d4f06d;
        --faint-green: #f2f6f6;
    }

    .text-dark-green { color: var(--dark-green) !important; }
    .bg-dark-green { background-color: var(--dark-green) !important; }
    .bg-accent-green { background-color: var(--accent-green) !important; }
    .text-accent-green { color: var(--accent-green) !important; }
    .bg-faint-green { background-color: var(--faint-green) !important; }
    .shadow-premium { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important; }
    .rounded-5 { border-radius: 24px !important; }
    .x-small { font-size: 0.7rem; }

    .ls-1 { letter-spacing: 1px; }
    .space-y-3 > * + * { margin-top: 0.75rem; }

    .status-badge {
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.1); }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
    .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }

    /* Timeline Styling */
    .delivery-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    .delivery-timeline::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 50px;
        right: 50px;
        height: 2px;
        background: var(--faint-green);
        z-index: 0;
    }
    .timeline-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100px;
    }
    .step-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: white;
        border: 2px solid var(--faint-green);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        transition: all 0.3s ease;
        margin-bottom: 8px;
    }
    .step-label { font-size: 0.65rem; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .timeline-step.completed .step-icon { background: var(--dark-green); border-color: var(--dark-green); color: white; }
    .timeline-step.completed .step-label { color: var(--dark-green); }
    
    .timeline-step.active .step-icon { background: var(--accent-green); border-color: var(--accent-green); color: var(--dark-green); box-shadow: 0 0 0 4px rgba(212, 240, 109, 0.2); }
    .timeline-step.active .step-label { color: var(--dark-green); }

    .border-dashed-custom { border: 2px dashed var(--faint-green); transition: all 0.2s; }
    .border-dashed-custom:hover { border-color: var(--dark-green); background: white !important; }

    canvas { touch-action: none; }
</style>

@section Scripts {
    <script>
        const pads = {};

        function initCanvas(poId) {
            const canvas = document.getElementById('pad-' + poId);
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            let drawing = false;

            // Set canvas size
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;

            ctx.lineWidth = 3;
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#1e293b';

            const start = (e) => {
                drawing = true;
                ctx.beginPath();
                const pos = getPos(e, canvas);
                ctx.moveTo(pos.x, pos.y);
            };

            const draw = (e) => {
                if (!drawing) return;
                const pos = getPos(e, canvas);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
            };

            const end = () => drawing = false;

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', draw);
            window.addEventListener('mouseup', end);

            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                start(e.touches[0]);
            });
            canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                draw(e.touches[0]);
            });
            canvas.addEventListener('touchend', end);

            pads[poId] = { canvas, ctx, empty: true };
            
            // Mark not empty on stroke
            canvas.addEventListener('mousedown', () => pads[poId].empty = false);
            canvas.addEventListener('touchstart', () => pads[poId].empty = false);
        }

        function getPos(e, canvas) {
            const rect = canvas.getBoundingClientRect();
            return {
                x: e.clientX - rect.left,
                y: e.clientY - rect.top
            };
        }

        function clearSignature(poId) {
            const pad = pads[poId];
            if (pad) {
                pad.ctx.clearRect(0, 0, pad.canvas.width, pad.canvas.height);
                pad.empty = true;
            }
        }

        function previewImg(poId) {
            const input = document.getElementById('img-' + poId);
            const preview = document.getElementById('previewImg-' + poId);
            const icon = document.getElementById('previewBox-' + poId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    icon.classList.add('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function finalizeDelivery(poId) {
            const pad = pads[poId];
            const dataInput = document.getElementById('sigData-' + poId);
            const photoInput = document.getElementById('img-' + poId);
            const qrVerified = @Html.Raw(Json.Serialize(Model.ToDictionary(m => m.Id, m => m.IsQRVerified)));
            
            // Capture signature if not empty
            if (pad && !pad.empty) {
                dataInput.value = pad.canvas.toDataURL();
            }

            // Proof Validation (1/3 required)
            const hasSig = dataInput.value !== "";
            const hasPhoto = photoInput.files.length > 0;
            const hasQR = qrVerified[poId] === true;

            if (!hasSig && !hasPhoto && !hasQR) {
                alert("CRITICAL: You must provide at least ONE piece of evidence (Signature, Photo, or QR Code).");
                return false;
            }

            return true;
        }

        // Initialize canvases when modals open
        document.addEventListener('shown.bs.modal', function (event) {
            const modalId = event.target.id;
            if (modalId.startsWith('deliverModal-')) {
                const poId = modalId.split('-')[1];
                initCanvas(poId);
            }
        });
        
        // QR Verification callback logic
        window.onQRVerified = function(poId) {
            const btn = document.querySelector(`#deliverModal-${poId} [data-bs-target^="#qrScannerModal"]`);
            const status = document.getElementById(`qrStatus-${poId}`);
            if (btn && status) {
                btn.classList.replace('btn-white', 'btn-success');
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> QR VERIFIED';
                status.innerHTML = '<i class="fas fa-check-circle text-success"></i> <span class="text-success">Verified</span>';
                // Trigger auto-submit maybe? No, let user confirm notes/checklist.
            }
        };

        // Live Filtering Logic
        $(document).ready(function() {
            const $searchInput = $('input[name="searchTerm"]');
            const $statusSelect = $('select[name="status"]');
            const $cards = $('.delivery-card');
            const $container = $('#deliveryCardsContainer');
            
            // Create No Results element if it doesn't exist
            if ($('.no-results').length === 0) {
                const noResultsHtml = `
                    <div class="col-12 text-center py-5 no-results" style="display:none;">
                        <div class="bg-faint-green p-5 rounded-5 border border-dashed-custom">
                            <i class="fas fa-search fa-4x text-dark-green opacity-25 mb-4"></i>
                            <h4 class="fw-bold text-dark-green">No matches found</h4>
                            <p class="text-muted">Try adjusting your search or filters.</p>
                        </div>
                    </div>`;
                $container.append(noResultsHtml);
            }
            
            const $noResults = $('.no-results');

            function filterCards() {
                const term = ($searchInput.val() || "").toLowerCase().trim();
                const status = ($statusSelect.val() || "").trim();
                let visibleCount = 0;

                $cards.each(function() {
                    const $card = $(this);
                    const retailer = ($card.attr('data-retailer') || "").toLowerCase();
                    const supplier = ($card.attr('data-supplier') || "").toLowerCase();
                    const poNumber = ($card.attr('data-ponumber') || "").toLowerCase();
                    const cardStatus = $card.attr('data-status') || "";

                    const matchesSearch = term === "" || 
                                          retailer.indexOf(term) !== -1 || 
                                          supplier.indexOf(term) !== -1 || 
                                          poNumber.indexOf(term) !== -1;
                    
                    const matchesStatus = status === "" || cardStatus === status;

                    if (matchesSearch && matchesStatus) {
                        $card.show();
                        visibleCount++;
                    } else {
                        $card.hide();
                    }
                });

                if (visibleCount === 0 && $cards.length > 0) {
                    $noResults.show();
                } else {
                    $noResults.hide();
                }
            }

            // Bind events for live filtering
            $searchInput.on('input keyup change', filterCards);
            $statusSelect.on('change', filterCards);
            
            // Prevent form submission for GET forms to keep it live
            $('form').on('submit', function(e) {
                if ($(this).attr('method')?.toLowerCase() === 'get') {
                    e.preventDefault();
                    filterCards();
                }
            });

            // Run once on load
            filterCards();
        });
    </script>


}