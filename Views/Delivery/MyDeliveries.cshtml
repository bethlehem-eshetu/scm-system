@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "My Deliveries";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Deliveries</h2>
            <p class="text-muted mb-0">Track and update assigned delivery routes</p>
        </div>
        <div>
            <span class="badge bg-primary rounded-pill px-3">@Model.Count() Active Deliveries</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var po in Model)
            {
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm h-100 position-relative overflow-hidden">
                        <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: @(po.Status == "Ready" ? "var(--bs-warning)" : (po.Status == "In Transit" ? "var(--bs-primary)" : "var(--bs-success)"));"></div>
                        
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <div class="d-flex align-items-center mb-1">
                                        <h5 class="fw-bold mb-0 me-2 text-dark">@po.PONumber</h5>
                                        <span class="badge @(po.Status == "Ready" ? "bg-warning" : (po.Status == "In Transit" ? "bg-primary" : "bg-success")) rounded-pill px-3">
                                            @po.Status
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Assigned: @po.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-primary">@po.PurchaseOrderItems?.Count Items</div>
                                    <div class="text-muted small">@po.TotalAmount.ToString("C")</div>
                                </div>
                            </div>

                            <div class="bg-light rounded-3 p-3 mb-4">
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="text-uppercase small fw-bold text-muted mb-1">Destination</div>
                                        <div class="fw-medium text-dark"><i class="fas fa-building text-primary me-2"></i>@po.Order?.Retailer?.BusinessName</div>
                                        <div class="small mt-1"><i class="fas fa-map-marker-alt text-muted me-2"></i>@po.DeliveryAddress</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="text-uppercase small fw-bold text-muted mb-1">Contact</div>
                                        <div class="fw-medium text-dark"><i class="fas fa-user text-primary me-2"></i>@po.Order?.Retailer?.User?.FullName</div>
                                        <div class="small mt-1"><i class="fas fa-phone-alt text-muted me-2"></i>@po.Order?.Retailer?.User?.PhoneNumber</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end mt-auto">
                                @if (po.Status == "Ready" || po.Status == "Packed")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                        <input type="hidden" name="status" value="In Transit" />
                                        <button type="submit" class="btn btn-primary rounded-pill px-4" onclick="return confirm('Confirm you have picked up this order and are beginning transit?');">
                                            <i class="fas fa-truck-loading me-2"></i> Start Transit
                                        </button>
                                    </form>
                                }
                                else if (po.Status == "In Transit")
                                {
                                    <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deliveryModal-@po.Id">
                                        <i class="fas fa-check-circle me-2"></i> Complete Delivery
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Complete Delivery Modal with QR Code & Image Upload -->
                @if (po.Status == "In Transit")
                {
                    <div class="modal fade" id="deliveryModal-@po.Id" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-success text-white border-0">
                                    <h5 class="modal-title fw-bold">
                                        <i class="fas fa-check-circle me-2"></i>Complete Delivery - @po.PONumber
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data" id="deliveryForm-@po.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="purchaseOrderId" value="@po.Id" />
                                    <input type="hidden" name="status" value="Delivered" />
                                    
                                    <div class="modal-body p-4">
                                        <div class="alert alert-info border-0 rounded-3 mb-4">
                                            <i class="fas fa-info-circle me-2"></i>
                                            <strong>Proof of Delivery Required</strong><br>
                                            Please either scan the customer's QR code OR provide a delivery photo/signature.
                                        </div>
                                        
                                        <!-- QR CODE VERIFICATION SECTION -->
                                        <div class="mb-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <label class="form-label fw-bold mb-0">
                                                    <i class="fas fa-qrcode me-2 text-primary"></i>QR Code Verification
                                                </label>
                                                <span class="badge bg-info text-white">Fast & Contactless</span>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary w-100 py-2 rounded-pill"
                                                    data-bs-toggle="modal" data-bs-target="#qrScannerModal-@po.Id"
                                                    style="border-style: dashed;"
                                                    onclick="event.preventDefault();">
                                                <i class="fas fa-qrcode me-2"></i>
                                                Scan Customer QR Code
                                            </button>
                                            <div class="form-text mt-2">Ask customer to show their order QR code for instant verification</div>
                                        </div>

                                        <hr class="my-3">

                                        <!-- DELIVERY PHOTO SECTION -->
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">
                                                <i class="fas fa-camera me-2 text-primary"></i>Upload Delivery Photo
                                            </label>
                                            <div class="border rounded-3 p-3 text-center bg-light" id="dropzone-@po.Id" style="cursor: pointer;">
                                                <input type="file" name="proofImage" id="proofImage-@po.Id" accept="image/jpeg,image/png,image/gif,application/pdf" class="d-none" />
                                                <div class="text-center">
                                                    <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-2"></i>
                                                    <p class="mb-1">Click or drag to upload delivery proof</p>
                                                    <small class="text-muted">Supports: JPG, PNG, GIF, PDF (Max 5MB)</small>
                                                </div>
                                                <div id="preview-@po.Id" class="mt-3 d-none">
                                                    <img id="previewImage-@po.Id" src="#" alt="Preview" class="img-fluid rounded" style="max-height: 150px;" />
                                                    <button type="button" class="btn btn-sm btn-danger mt-2" onclick="clearImage(@po.Id)">Remove</button>
                                                </div>
                                            </div>
                                            <div class="form-text">Take a clear photo of the delivered package at the destination.</div>
                                        </div>
                                        
                                        <!-- MANUAL SIGNATURE SECTION -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fas fa-signature me-2 text-primary"></i>Or Enter Signature / Receipt Code
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text border-end-0 bg-light"><i class="fas fa-pen text-muted"></i></span>
                                                <input type="text" name="proofData" id="proofData-@po.Id" class="form-control border-start-0" placeholder="e.g., Received by John Doe or Code #4192" />
                                            </div>
                                            <div class="form-text mt-2">If no photo available, enter the receiver's name or receipt code.</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0 pb-4">
                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </button>
                                        <button type="submit" class="btn btn-success rounded-pill px-4" onclick="return validateForm(@po.Id)">
                                            <i class="fas fa-flag-checkered me-2"></i>Confirm Delivery
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <div class="opacity-25 mb-4">
                            <i class="fas fa-route fa-4x text-primary"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">No Active Deliveries</h4>
                        <p class="text-muted mb-0">You currently have no purchase orders assigned for delivery. Check back later.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- QR Code Scanner Modal Template - Rendered for each In Transit PO -->
@foreach (var po in Model.Where(p => p.Status == "In Transit"))
{
    @await Html.PartialAsync("_QRCodeReader", po.Id)
}

<script>
    // Handle file input click
    document.querySelectorAll('[id^="dropzone-"]').forEach(zone => {
        zone.addEventListener('click', function() {
            var id = this.id.split('-')[1];
            document.getElementById('proofImage-' + id).click();
        });
    });
    
    // Handle file selection and preview
    document.querySelectorAll('[id^="proofImage-"]').forEach(input => {
        input.addEventListener('change', function(e) {
            var id = this.id.split('-')[1];
            var file = e.target.files[0];
            
            if (file) {
                // Clear text input if image is selected
                document.getElementById('proofData-' + id).value = '';
                
                // Show preview
                var reader = new FileReader();
                reader.onload = function(event) {
                    var previewImg = document.getElementById('previewImage-' + id);
                    previewImg.src = event.target.result;
                    document.getElementById('preview-' + id).classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        });
    });
    
    function clearImage(id) {
        document.getElementById('proofImage-' + id).value = '';
        document.getElementById('preview-' + id).classList.add('d-none');
    }
    
    function validateForm(id) {
        var imageInput = document.getElementById('proofImage-' + id);
        var textInput = document.getElementById('proofData-' + id);
        
        if (!imageInput.files.length && !textInput.value.trim()) {
            alert('Please provide either a delivery photo, signature, or scan the QR code.');
            return false;
        }
        return true;
    }
    
    // Auto-fill proof data when QR is verified (this will be called from QR reader)
    window.setQRProofData = function(poId, qrValue, isManual = false) {
        const proofDataInput = document.getElementById('proofData-' + poId);
        if (proofDataInput) {
            if (isManual) {
                proofDataInput.value = `Manual delivery confirmation at ${new Date().toLocaleString()}`;
            } else {
                proofDataInput.value = `QR Verified: ${qrValue} at ${new Date().toLocaleString()}`;
            }
        }
        
        // Auto-submit the form
        const deliveryForm = document.getElementById('deliveryForm-' + poId);
        if (deliveryForm) {
            setTimeout(() => {
                deliveryForm.submit();
            }, 1000);
        }
    };
</script>

<style>
    /* Custom styles for delivery cards */
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
    
    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: white;
        border-style: solid !important;
    }
    
    .modal-content {
        border-radius: 16px;
    }
    
    .modal-header {
        border-radius: 16px 16px 0 0;
    }
</style>