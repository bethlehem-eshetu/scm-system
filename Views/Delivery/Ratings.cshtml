@{
    ViewData["Title"] = "My Ratings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Performance Ratings</h2>
        <p class="text-muted">Track your delivery satisfaction scores</p>
    </div>

    <!-- Rating Overview Card -->
    <div class="card border-0 shadow-sm text-center p-5 mb-4 bg-primary text-white position-relative overflow-hidden" style="border-radius: 16px;">
        <i class="fas fa-star fa-10x position-absolute opacity-10" style="right: -20px; top: -30px;"></i>
        <i class="fas fa-star fa-4x text-warning mb-3"></i>
        <h1 class="display-3 fw-bold mb-0">4.9</h1>
        <div class="text-warning mb-2 fs-5">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
        </div>
        <p class="opacity-75 mb-0">Average Delivery Rating (Based on 142 reviews)</p>
    </div>
    
    <div class="row">
        <!-- Recent Feedback -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-header bg-white py-3 border-0 pt-4 px-4">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-comments me-2 text-primary"></i>Recent Feedback</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item p-4 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                </div>
                                <small class="text-muted">2 hours ago</small>
                            </div>
                            <p class="mb-2 text-dark">"Extremely professional and fast. Packages arrived beautifully packed!"</p>
                            <small class="text-muted fw-bold"><i class="fas fa-store me-1"></i> Addis Premium Groceries</small>
                        </li>
                        <li class="list-group-item p-4 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                </div>
                                <small class="text-muted">Yesterday</small>
                            </div>
                            <p class="mb-2 text-dark">"Great driver. Very polite and unloaded everything exactly where I asked."</p>
                            <small class="text-muted fw-bold"><i class="fas fa-store me-1"></i> Sheger Mega Mart</small>
                        </li>
                        <li class="list-group-item p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i>
                                </div>
                                <small class="text-muted">3 days ago</small>
                            </div>
                            <p class="mb-2 text-dark">"Delivery was slightly delayed due to traffic, but communication was great."</p>
                            <small class="text-muted fw-bold"><i class="fas fa-store me-1"></i> Bole Electronics Sales</small>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    <div class="mb-4 text-success">
                        <i class="fas fa-medal fa-4x mb-3"></i>
                        <h4 class="fw-bold">Top 5% Agent</h4>
                    </div>
                    <p class="text-muted">You are currently ranked in the top 5% of all delivery drivers in the region this month based on customer satisfaction.</p>
                    <button class="btn btn-outline-primary rounded-pill mt-3 w-100">View Detailed Metrics</button>
                </div>
            </div>
        </div>
    </div>
</div>
