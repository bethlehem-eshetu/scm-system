@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>

<!-- Quick Support Modal -->
<div class="modal fade" id="quickSupportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-20 overflow-hidden">
            <div class="modal-header bg-dark-green text-white p-4 border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-headset me-2 text-accent-green"></i>Immediate Fulfillment Support
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="supportRequestForm">
                <div class="modal-body p-4 bg-light-green-subtle bg-opacity-25">
                    <div class="alert bg-white border-0 shadow-sm rounded-15 mb-4">
                        <p class="small text-muted mb-0">
                            <strong>Policy:</strong> Your request will be sent directly to the <strong>Warehouse Manager</strong> assigned to your current route.
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark-green text-uppercase ls-1">1. Select Active Delivery</label>
                        <select id="supportPOId" class="form-select form-select-lg border-0 shadow-sm rounded-pill px-4 py-2 small fw-medium" required>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var po in Model)
                                {
                                    <option value="@po.Id">Order #@po.PONumber - @po.Retailer?.BusinessName</option>
                                }
                            }
                            else
                            {
                                <option value="">No Active Deliveries Found</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark-green text-uppercase ls-1">2. Issue Type</label>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="issueType" id="issue1" value="Traffic/Delay" required checked>
                            <label class="btn btn-outline-dark-green rounded-pill btn-sm px-3 fw-medium extra-small" for="issue1">Traffic/Delay</label>

                            <input type="radio" class="btn-check" name="issueType" id="issue2" value="Vehicle Issue">
                            <label class="btn btn-outline-dark-green rounded-pill btn-sm px-3 fw-medium extra-small" for="issue2">Vehicle Issue</label>

                            <input type="radio" class="btn-check" name="issueType" id="issue3" value="Address Problem">
                            <label class="btn btn-outline-dark-green rounded-pill btn-sm px-3 fw-medium extra-small" for="issue3">Address Problem</label>

                            <input type="radio" class="btn-check" name="issueType" id="issue4" value="Customer Unavailable">
                            <label class="btn btn-outline-dark-green rounded-pill btn-sm px-3 fw-medium extra-small" for="issue4">Customer Unavailable</label>
                            
                            <input type="radio" class="btn-check" name="issueType" id="issue5" value="Damaged Goods">
                            <label class="btn btn-outline-dark-green rounded-pill btn-sm px-3 fw-medium extra-small" for="issue5">Damaged Goods</label>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-bold text-dark-green text-uppercase ls-1">3. Additional Notes</label>
                        <textarea id="supportNotes" class="form-control border-0 shadow-sm rounded-15 p-3 small" rows="3" placeholder="Describe the situation briefly..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-white border-0 px-4 py-4">
                    <button type="button" class="btn btn-soft-green rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark-green rounded-pill px-5 fw-bold shadow-premium" id="sendSupportBtn">
                        <i class="fas fa-paper-plane me-2"></i> Send Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('supportRequestForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btn = document.getElementById('sendSupportBtn');
        const poId = document.getElementById('supportPOId').value;
        const issueType = document.querySelector('input[name="issueType"]:checked').value;
        const notes = document.getElementById('supportNotes').value;

        if (!poId) {
            alert('Please select a delivery order.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Sending...';

        fetch('/Delivery/RequestSupport', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({
                PurchaseOrderId: parseInt(poId),
                IssueType: issueType,
                Notes: notes
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                $('#quickSupportModal').modal('hide');
                document.getElementById('supportRequestForm').reset();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An unexpected error occurred.');
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Send Request';
        });
    });
</script>

<style>
    .ls-1 { letter-spacing: 1px; }
    .extra-small { font-size: 0.7rem !important; }
    .rounded-20 { border-radius: 20px !important; }
    .rounded-15 { border-radius: 15px !important; }
    .bg-light-green-subtle { background-color: #f0f7f4 !important; }
    .text-dark-green { color: #2e7d32 !important; }
    .btn-dark-green { background: #2e7d32 !important; color: white !important; }
    .btn-soft-green { background: rgba(46, 125, 50, 0.1) !important; color: #2e7d32 !important; border: none; }
    .btn-outline-dark-green { border-color: #2e7d32 !important; color: #2e7d32 !important; }
    .btn-check:checked + .btn-outline-dark-green { background-color: #2e7d32 !important; color: white !important; }
</style>
