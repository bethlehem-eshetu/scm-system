@model SCM_System.Models.Entities.SupplierEmployee
@{
    ViewData["Title"] = "Vehicle Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4 pb-5 px-4 h-100">
    <div class="row g-4 h-100">
        <!-- Asset Overview Card -->
        <div class="col-xl-4 animate-slide-up">
            <div class="card border-0 rounded-25 shadow-premium bg-white h-100 overflow-hidden">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="asset-avatar-wrapper mb-4">
                            <div class="asset-avatar bg-soft-green text-dark-green rounded-circle mx-auto d-flex align-items-center justify-content-center">
                                <i class="fas fa-truck fa-3x"></i>
                            </div>
                            <div class="status-badge bg-success border-4 border-white"></div>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@(Model.Vehicle?.LicensePlate ?? "Unassigned")</h4>
                        <p class="text-muted small">Asset ID: V-@(Model.Vehicle?.Id.ToString("D4") ?? "0000")</p>
                    </div>

                    <div class="asset-stats mb-5">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Model</span>
                            <span class="fw-bold small">@Model.Vehicle?.VehicleType</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Fuel Range</span>
                            <span class="text-dark small fw-bold">120 KM Remaining</span>
                        </div>
                        <div class="progress rounded-pill bg-light" style="height: 6px;">
                            <div class="progress-bar bg-success rounded-pill" style="width: 75%"></div>
                        </div>
                    </div>

                    <div class="p-4 bg-light rounded-20">
                        <h6 class="fw-bold small mb-3">Live Telemetry</h6>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-sm bg-white rounded-circle shadow-sm text-success"><i class="fas fa-thermometer-half"></i></div>
                            <div>
                                <p class="extra-small text-muted mb-0">Engine Temp</p>
                                <p class="small fw-bold mb-0">88°C (Normal)</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-sm bg-white rounded-circle shadow-sm text-info"><i class="fas fa-tachometer-alt"></i></div>
                            <div>
                                <p class="extra-small text-muted mb-0">Odometer</p>
                                <p class="small fw-bold mb-0">12,450 KM</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Settings Form -->
        <div class="col-xl-8 animate-slide-up" style="animation-delay: 0.2s;">
            <div class="card border-0 rounded-25 shadow-premium bg-white h-100">
                <div class="card-header bg-white border-0 p-5 pb-0">
                    <h4 class="fw-bold text-dark mb-1">Hardware & Sync Settings</h4>
                    <p class="text-muted small">Configure how your vehicle interacts with the SCM dispatch system.</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="UpdateVehicleSettings" method="post">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">TRANSMISSION MODE</label>
                                <select class="form-select rounded-pill border-0 shadow-sm px-4 bg-light" name="gpsMode">
                                    <option value="high">High Frequency GPS (Every 5s)</option>
                                    <option value="eco">Battery Saver (Every 60s)</option>
                                    <option value="smart">Smart Sync (Adaptive)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">DIAGNOSTIC STATUS</label>
                                <select class="form-select rounded-pill border-0 shadow-sm px-4 bg-light" name="status">
                                    <option value="nominal">System Nominal</option>
                                    <option value="warning">Maintenance Required</option>
                                    <option value="critical">Critical (Disable Dispatch)</option>
                                </select>
                            </div>
                            <div class="col-12 mt-5">
                                <hr class="my-4 opacity-5">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h5 class="fw-bold mb-1">Push Notifications</h5>
                                        <p class="text-muted extra-small mb-0">Get alerted for new deliveries via hardware screen.</p>
                                    </div>
                                    <div class="form-check form-switch custom-switch">
                                        <input class="form-check-input" type="checkbox" checked>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h5 class="fw-bold mb-1">Auto-Accept Rerouting</h5>
                                        <p class="text-muted extra-small mb-0">Allow AI Assistant to push new routes directly to GPS.</p>
                                    </div>
                                    <div class="form-check form-switch custom-switch">
                                        <input class="form-check-input" type="checkbox" checked>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 text-end mt-5">
                                <button type="submit" class="btn btn-dark-green rounded-pill px-5 py-3 fw-bold shadow-premium text-white">SAVE HARDWARE PROFILE</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-25 { border-radius: 25px !important; }
    .rounded-20 { border-radius: 20px !important; }
    .shadow-premium { box-shadow: 0 15px 50px rgba(0,0,0,0.06) !important; }
    .bg-soft-green { background-color: rgba(46, 125, 50, 0.1) !important; }
    .text-dark-green { color: #2e7d32 !important; }
    .btn-dark-green { background: #2e7d32 !important; border: none; color: white; transition: all 0.3s ease; }
    .btn-dark-green:hover { background: #1b5e20 !important; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(46,125,50,0.2); }
    
    .asset-avatar-wrapper { position: relative; width: 120px; height: 120px; margin: 0 auto; }
    .asset-avatar { width: 120px; height: 120px; }
    .status-badge { position: absolute; bottom: 5px; right: 5px; width: 25px; height: 25px; border-radius: 50%; }
    
    .icon-sm { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
    .extra-small { font-size: 0.7rem !important; }

    /* Custom Switch */
    .custom-switch .form-check-input { width: 45px; height: 24px; cursor: pointer; }
    .custom-switch .form-check-input:checked { background-color: #2e7d32; border-color: #2e7d32; }
    
    .animate-slide-up {
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 0.6s forwards;
    }
    @@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
</style>
