@model int  // PurchaseOrder ID

<!-- QR Code Scanner Modal -->
<div class="modal fade" id="qrScannerModal-@Model" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-qrcode me-2"></i>Scan Customer QR Code
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info border-0 rounded-3 mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>QR Code Verification</strong><br>
                    Ask the customer to show their order QR code and scan it below. This will automatically verify delivery.
                </div>
                
                <!-- Video container for QR scanner -->
                <div id="qr-reader-@Model" style="width: 100%;"></div>
                <div id="qr-reader-results-@Model" class="mt-3"></div>
                
                <!-- Manual fallback -->
                <div class="mt-4 pt-3 border-top">
                    <div class="text-center text-muted mb-3">
                        <span class="badge bg-light text-dark">OR</span>
                    </div>
                    <label class="form-label fw-bold">
                        <i class="fas fa-keyboard me-2 text-primary"></i>Manual QR Code Entry
                    </label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0 bg-light"><i class="fas fa-qrcode text-muted"></i></span>
                        <input type="text" id="manualQRCode-@Model" class="form-control border-start-0" placeholder="Enter QR code manually or type 'VERIFY'" />
                        <button type="button" class="btn btn-outline-primary" onclick="verifyManualQRCode(@Model)">
                            <i class="fas fa-check me-1"></i>Verify
                        </button>
                    </div>
                    <div class="form-text mt-2">If scanner doesn't work, type the <strong>Order ID</strong> (e.g. ORDER-SO-000001) shown on the customer's dashboard, or just type "VERIFY" to confirm receipt.</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Include QR Scanner Library -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<script>
    if (typeof startQRScanner !== 'function') {
        window.startQRScanner = function(poId) {
            const qrReaderId = `qr-reader-${poId}`;
            const resultContainerId = `qr-reader-results-${poId}`;
            
            const html5QrCode = new Html5Qrcode(qrReaderId);
            window[`html5QrCode_${poId}`] = html5QrCode;
            
            const config = {
                fps: 10,
                qrbox: { width: 250, height: 250 },
                aspectRatio: 1.0
            };
            
            html5QrCode.start(
                { facingMode: "environment" },
                config,
                (decodedText, decodedResult) => {
                    console.log(`QR Code scanned: ${decodedText}`);
                    handleQRScanResult(poId, decodedText);
                },
                (errorMessage) => {
                    // console.log(`QR Scan error: ${errorMessage}`);
                }
            ).catch(err => {
                console.log(`Unable to start scanning: ${err}`);
                const resDiv = document.getElementById(resultContainerId);
                if (resDiv) {
                    resDiv.innerHTML = `
                    <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Unable to access camera. Please check permissions or use manual entry.
                    </div>
                    `;
                }
            });
        };

        window.stopQRScanner = function(poId) {
            const html5QrCode = window[`html5QrCode_${poId}`];
            if (html5QrCode) {
                html5QrCode.stop().then(() => {
                    delete window[`html5QrCode_${poId}`];
                }).catch(err => {
                    console.log(`Error stopping scanner: ${err}`);
                });
            }
        };

        window.handleQRScanResult = function(poId, qrValue) {
            stopQRScanner(poId);
            
            fetch('@Url.Action("VerifyQRCode", "Delivery")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                body: JSON.stringify({
                    purchaseOrderId: poId,
                    qrCode: qrValue
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#qrScannerModal-' + poId).modal('hide');
                    
                    if (typeof window.onQRVerified === 'function') {
                        window.onQRVerified(poId);
                    }
                } else {
                    const resultDiv = document.getElementById('qr-reader-results-' + poId);
                    if (resultDiv) {
                        resultDiv.innerHTML = `
                            <div class="alert alert-danger">
                                <i class="fas fa-times-circle me-2"></i>
                                ${data.message || 'QR Code verification failed. Please try again or use manual entry.'}
                            </div>
                        `;
                    }
                    setTimeout(() => startQRScanner(poId), 3000);
                }
            })
            .catch(error => {
                console.error('Error verifying QR:', error);
            });
        };

        window.verifyManualQRCode = function(poId) {
            const manualInput = document.getElementById('manualQRCode-' + poId);
            const qrValue = manualInput.value.trim();
            
            if (!qrValue) {
                alert('Please enter the QR code value or type "VERIFY" to confirm delivery');
                return;
            }
            
            const isManualConfirm = qrValue.toUpperCase() === 'VERIFY';
            
            fetch('@Url.Action("VerifyQRCode", "Delivery")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                body: JSON.stringify({
                    purchaseOrderId: poId,
                    qrCode: qrValue,
                    isManual: isManualConfirm
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#qrScannerModal-' + poId).modal('hide');
                    
                    if (typeof window.onQRVerified === 'function') {
                        window.onQRVerified(poId);
                    }
                } else {
                    alert(data.message || 'Verification failed. Please check the QR code.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        };
    }
    
    $('#qrScannerModal-@Model').on('hidden.bs.modal', function () {
        stopQRScanner(@Model);
    });
    
    $('#qrScannerModal-@Model').on('shown.bs.modal', function () {
        startQRScanner(@Model);
    });
</script>