@model SCM_System.Models.Entities.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "_DashboardLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i> Edit Product: @Model.ProductName
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="row g-4">
                            <!-- Basic Information -->
                            <div class="col-md-7">
                                <h5 class="text-primary border-bottom pb-2 mb-3">Basic Information</h5>
                                
                                <div class="mb-3">
                                    <label asp-for="ProductName" class="form-label fw-bold">Product Name <span class="text-danger">*</span></label>
                                    <input asp-for="ProductName" class="form-control" required />
                                    <span asp-validation-for="ProductName" class="text-danger"></span>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label asp-for="CategoryId" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                            <option value="">-- Select Category --</option>
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SKU" class="form-label fw-bold">SKU (Optional)</label>
                                        <input asp-for="SKU" class="form-control" />
                                        <span asp-validation-for="SKU" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">Full Description</label>
                                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Pricing & Inventory -->
                            <div class="col-md-5">
                                <h5 class="text-primary border-bottom pb-2 mb-3">Pricing & Inventory</h5>
                                
                                <div class="mb-3">
                                    <label asp-for="BasePrice" class="form-label fw-bold">Base Price <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">ETB</span>
                                        <input asp-for="BasePrice" class="form-control" type="number" step="0.01" min="0" required />
                                    </div>
                                    <span asp-validation-for="BasePrice" class="text-danger"></span>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label asp-for="Unit" class="form-label fw-bold">Unit <span class="text-danger">*</span></label>
                                        <input asp-for="Unit" class="form-control" required />
                                        <span asp-validation-for="Unit" class="text-danger"></span>
                                    </div>
                                </div>

                                <h5 class="text-primary border-bottom pb-2 mt-4 mb-3">Product Image</h5>
                                
                                <div class="mb-3">
                                    <label for="imageFile" class="form-label fw-bold">Update Image</label>
                                    <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" onchange="previewImage(this)" />
                                    <small class="text-muted d-block mt-1">Leave empty to keep current image. Recommended size: 800x800px</small>
                                </div>
                                
                                <div class="text-center mt-3 @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" id="imagePreviewContainer">
                                    <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "#" : Model.ImageUrl)" alt="Image Preview" class="img-thumbnail shadow-sm" style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                                    
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <div class="mt-2 text-muted fw-bold" id="currentImageLabel">Current Image</div>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <!-- Gallery Images Section -->
                        <div class="mt-4">
                            <h5 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-images me-2"></i>Gallery Images</h5>
                            
                            @if (ViewBag.GalleryImages != null && ((List<SCM_System.Models.ViewModels.GalleryImageViewModel>)ViewBag.GalleryImages).Any())
                            {
                                <div class="d-flex flex-wrap gap-2 mb-3" id="existingGalleryContainer">
                                    @foreach (var img in (List<SCM_System.Models.ViewModels.GalleryImageViewModel>)ViewBag.GalleryImages)
                                    {
                                        <div class="position-relative" id="gallery-img-@img.Id" style="width:100px;height:100px;">
                                            <img src="@img.ImageUrl" class="rounded-3 shadow-sm" style="width:100px;height:100px;object-fit:cover;" />
                                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 rounded-circle p-0" 
                                                    style="width:24px;height:24px;line-height:24px;font-size:12px;"
                                                    onclick="deleteGalleryImage(@img.Id)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div class="bg-light border-2 border-dashed p-3 rounded-4 text-center position-relative">
                                <input type="file" name="GalleryImages" class="form-control position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor:pointer;" multiple accept="image/*" onchange="previewNewGallery(this)" />
                                <i class="fas fa-plus-circle text-muted mb-1"></i>
                                <p class="mb-0 small fw-bold">Add more images</p>
                                <small class="text-muted">Max 10 total</small>
                            </div>
                            <div id="newGalleryPreview" class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>

                        <hr class="mt-4 mb-4" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="MyProducts" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function previewImage(input) {
            const previewContainer = document.getElementById('imagePreviewContainer');
            const previewImage = document.getElementById('imagePreview');
            const currentLabel = document.getElementById('currentImageLabel');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                    if (currentLabel) {
                        currentLabel.textContent = "New Image Preview";
                        currentLabel.classList.replace('text-muted', 'text-success');
                    }
                }
                
                reader.readAsDataURL(input.files[0]);
            } else {
                const originalUrl = "@Model.ImageUrl";
                if (originalUrl) {
                    previewImage.src = originalUrl;
                    previewContainer.classList.remove('d-none');
                    if (currentLabel) {
                        currentLabel.textContent = "Current Image";
                        currentLabel.classList.replace('text-success', 'text-muted');
                    }
                } else {
                    previewContainer.classList.add('d-none');
                    previewImage.src = '#';
                }
            }
        }

        function deleteGalleryImage(imageId) {
            if (!confirm('Remove this gallery image?')) return;
            fetch('/Product/DeleteGalleryImage?imageId=' + imageId, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        var el = document.getElementById('gallery-img-' + imageId);
                        if (el) el.remove();
                    } else {
                        alert('Failed to delete image.');
                    }
                })
                .catch(err => alert('Error: ' + err));
        }

        function previewNewGallery(input) {
            var container = document.getElementById('newGalleryPreview');
            container.innerHTML = '';
            if (input.files) {
                Array.from(input.files).forEach(function(file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        var div = document.createElement('div');
                        div.style.width = '80px';
                        div.style.height = '80px';
                        div.innerHTML = '<img src="' + e.target.result + '" class="rounded-3 shadow-sm" style="width:80px;height:80px;object-fit:cover;" />';
                        container.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>
}
