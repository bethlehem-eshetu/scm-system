@model IEnumerable<SCM_System.Models.Entities.Product>

@{
    ViewData["Title"] = "Product Intelligence Catalog";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 product-management-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark-green mb-1"><i class="fas fa-boxes me-2"></i>Product Management</h4>
            <p class="text-muted extra-small mb-0">Manage your high-fidelity product catalog and distributed inventory</p>
        </div>
        <div class="d-flex gap-2">
            <div class="search-bar-premium position-relative">
                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="productSearch" class="form-control border-0 bg-white rounded-pill ps-5 shadow-sm small" placeholder="Search SKU or Name..." style="width: 260px; height: 38px;">
            </div>
            <a asp-action="Create" class="btn btn-dark-green rounded-pill px-3 shadow-premium fw-bold d-flex align-items-center small">
                <i class="fas fa-plus me-2"></i> Add Product
            </a>
        </div>
    </div>


    <!-- Product Grid -->
    <div class="row g-3" id="productGrid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var totalStock = item.Inventories?.Sum(i => i.QuantityOnHand) ?? 0;
                var reservedStock = item.Inventories?.Sum(i => i.QuantityReserved) ?? 0;
                var availableStock = totalStock - reservedStock;
                var isLowStock = availableStock < (item.ReorderLevel ?? 10);
                
                <div class="col-xl-3 col-lg-4 col-md-6 product-card" data-name="@item.ProductName" data-sku="@item.SKU">
                    <div class="card h-100 border-0 shadow-premium rounded-5 overflow-hidden hover-lift position-relative bg-white">
                        <!-- Stock Status Badge -->
                        <div class="position-absolute top-0 end-0 m-3 z-index-2">
                            @if (availableStock <= 0)
                            {
                                <span class="status-badge bg-soft-danger text-danger">Out of Stock</span>
                            }
                            else if (isLowStock)
                            {
                                <span class="status-badge bg-soft-warning text-warning">Low Stock</span>
                            }
                            else
                            {
                                <span class="status-badge bg-soft-success text-success">In Stock</span>
                            }
                        </div>

                        <!-- Product Image Area -->
                        <div class="product-image-container bg-faint-green position-relative" style="height: 180px;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="w-100 h-100 object-fit-cover transition-all" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-dark-green opacity-25">
                                    <i class="fas fa-box fa-3x mb-2"></i>
                                    <span class="small fw-bold">NO PREVIEW</span>
                                </div>
                            }
                            
                            <!-- Quick Action Overlay -->
                            <div class="product-overlay d-flex align-items-center justify-content-center gap-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-icon rounded-circle shadow-premium">
                                    <i class="fas fa-pencil-alt text-dark-green"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-icon rounded-circle shadow-premium">
                                    <i class="fas fa-eye text-dark-green"></i>
                                </a>
                                <button type="button" class="btn btn-white btn-icon rounded-circle shadow-premium text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <div class="mb-2">
                                <span class="badge bg-faint-green text-dark-green fw-bold rounded-pill px-3 py-2 small">@item.Category?.CategoryName</span>
                            </div>
                            <h5 class="fw-bold mb-1 text-dark-green text-truncate">@item.ProductName</h5>
                            <p class="text-muted extra-small mb-3">SKU: @(item.SKU ?? "N/A")</p>

                            <div class="d-flex justify-content-between align-items-end mb-4">
                                <div>
                                    <p class="text-muted extra-small mb-0">Base Price</p>
                                    <h4 class="fw-bold text-dark-green mb-0">@item.BasePrice.ToString("C")</h4>
                                </div>
                                <div class="text-end">
                                    <p class="text-muted extra-small mb-0">Available</p>
                                    <h5 class="fw-bold mb-0 @(availableStock <= 0 ? "text-danger" : "text-dark-green")">@availableStock @item.Unit</h5>
                                </div>
                            </div>

                            <!-- Inventory Health -->
                            <div class="p-2 bg-faint-green rounded-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="extra-small text-muted fw-bold">Reserved: <span class="text-warning">@reservedStock</span></span>
                                    <span class="extra-small text-muted fw-bold">System: <span class="text-dark-green">@totalStock</span></span>
                                </div>
                                <div class="progress rounded-pill shadow-sm" style="height: 4px; background-color: rgba(0,0,0,0.05);">
                                    @{
                                        var percent = totalStock > 0 ? (availableStock * 100 / totalStock) : 0;
                                        var barColor = availableStock <= 0 ? "bg-danger" : (isLowStock ? "bg-warning" : "bg-dark-green");
                                    }
                                    <div class="progress-bar @barColor rounded-pill" style="width: @percent%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 p-3 pt-0">
                            <button type="button" class="btn btn-faint-green w-100 rounded-pill fw-bold text-dark-green py-2 shadow-sm extra-small" data-bs-toggle="modal" data-bs-target="#stockModal-@item.Id">
                                <i class="fas fa-warehouse me-2"></i> Update Stock
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Stock Update Modal (Nexus Style) -->
                <div class="modal fade" id="stockModal-@item.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-header bg-dark-green text-white py-4 px-4 border-0">
                                <h5 class="modal-title fw-bold"><i class="fas fa-warehouse me-2"></i> Inventory Control</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="UpdateStock" method="post">
                                <div class="modal-body p-4">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    
                                    <div class="p-4 bg-faint-green rounded-5 text-center mb-4 border-dashed-custom">
                                        <p class="text-muted small mb-1">Product Being Adjusted</p>
                                        <h4 class="fw-bold text-dark-green mb-0">@item.ProductName</h4>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-dark-green small text-uppercase ls-1">Select Warehouse Hub</label>
                                        <select name="warehouseId" class="form-select rounded-4 p-3 shadow-none border-0 bg-faint-green text-dark-green fw-bold" asp-items="ViewBag.Warehouses" required>
                                            <option value="">-- Locate Hub --</option>
                                        </select>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark-green small text-uppercase ls-1">Adjustment</label>
                                            <select name="action" class="form-select rounded-4 p-3 shadow-none border-0 bg-faint-green text-dark-green fw-bold">
                                                <option value="increase">Restock (+)</option>
                                                <option value="decrease">Audit Out (-)</option>
                                                <option value="set">Force Sync (=)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark-green small text-uppercase ls-1">Quantity</label>
                                            <div class="input-group">
                                                <input type="number" name="stockChange" class="form-control rounded-4 p-3 shadow-none border-0 bg-faint-green text-dark-green fw-bold" min="0" required />
                                                <span class="input-group-text bg-transparent border-0 text-dark-green fw-bold">@item.Unit</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 p-4 pt-0">
                                    <button type="button" class="btn btn-white rounded-pill px-4" data-bs-dismiss="modal">Discard</button>
                                    <button type="submit" class="btn btn-dark-green rounded-pill px-4 fw-bold shadow-premium">Commit Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Delete Modal (Nexus Style) -->
                <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
                            <div class="modal-body p-5 text-center">
                                <div class="bg-soft-danger text-danger rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <i class="fas fa-trash-alt fs-2"></i>
                                </div>
                                <h4 class="fw-bold text-dark-green mb-2">Delete Product?</h4>
                                <p class="text-muted mb-4 small">You are about to remove <strong>@item.ProductName</strong>. This will disable all active listings across warehouses.</p>
                                <div class="d-flex gap-3 justify-content-center">
                                    <button type="button" class="btn btn-faint-green rounded-pill px-5 fw-bold text-dark-green" data-bs-dismiss="modal">Cancel</button>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">Confirm</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-faint-green rounded-5 p-5 border-dashed-custom">
                    <i class="fas fa-box-open fa-4x text-dark-green opacity-25 mb-4"></i>
                    <h4 class="fw-bold text-dark-green">No Products in Catalog</h4>
                    <p class="text-muted mb-4">Start your supply chain by adding your first product listing.</p>
                    <a asp-action="Create" class="btn btn-dark-green rounded-pill px-5 fw-bold shadow-premium">
                        Create First Listing
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination (Nexus Style) -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5">
            <nav>
                <ul class="pagination pagination-premium gap-3">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;" asp-action="MyProducts" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center @(ViewBag.CurrentPage == i ? "bg-dark-green text-white" : "bg-white text-dark-green")" style="width: 45px; height: 45px;" asp-action="MyProducts" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;" asp-action="MyProducts" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Styles {
    <style>
        .product-management-container {
            zoom: 0.92;
            max-width: 1450px;
            margin: auto;
        }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .product-image-container { position: relative; overflow: hidden; }
        .product-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(26, 61, 49, 0.6);
            backdrop-filter: blur(8px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 10;
        }
        .product-card:hover .product-overlay { opacity: 1; }
        .product-card:hover img { transform: scale(1.1); }
        
        .btn-icon { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .btn-icon:hover { transform: scale(1.1) translateY(-2px); }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('productSearch');
            const productCards = document.querySelectorAll('.product-card');

            searchInput.addEventListener('input', function() {
                const term = this.value.toLowerCase();
                productCards.forEach(card => {
                    const name = card.dataset.name.toLowerCase();
                    const sku = card.dataset.sku.toLowerCase();
                    if (name.includes(term) || sku.includes(term)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    </script>
}
