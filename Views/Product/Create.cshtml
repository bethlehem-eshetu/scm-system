@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function generateSKU() {
            var productName = document.getElementById('ProductName').value;
            var categoryId = document.getElementById('CategoryId').value;
            if (productName) {
                fetch(`/Product/GenerateSku?productName=${encodeURIComponent(productName)}&categoryId=${categoryId}`)
                    .then(response => response.json())
                    .then(data => { document.getElementById('SKU').value = data.sku; });
            } else { alert('Please enter product name first.'); }
        }
        
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('mainImagePreview').src = e.target.result;
                    document.getElementById('mainImagePreview').style.display = 'block';
                    document.getElementById('noImagePlaceholder').style.display = 'none';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        function calculateSellingPrice() {
            var basePrice = parseFloat(document.getElementById('BasePrice').value) || 0;
            var discount = parseFloat(document.getElementById('DiscountPercentage').value) || 0;
            var tax = parseFloat(document.getElementById('TaxRate').value) || 0;
            var afterDiscount = basePrice * (1 - discount / 100);
            var finalPrice = afterDiscount * (1 + tax / 100);
            document.getElementById('sellingPriceDisplay').innerText = finalPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        
        ['BasePrice', 'DiscountPercentage', 'TaxRate'].forEach(id => {
            var el = document.getElementById(id);
            if(el) el.addEventListener('input', calculateSellingPrice);
        });
        
        function saveAndAddAnother() {
            var form = document.getElementById('productForm');
            form.action += '?addAnother=true';
            form.submit();
        }

        document.getElementById('CategoryId').addEventListener('change', function() {
            var categoryId = this.value;
            var container = document.getElementById('dynamicAttributesContainer');
            var subCategorySelect = document.getElementById('subCategorySelect');
            
            if (subCategorySelect) {
                subCategorySelect.innerHTML = '<option value="">-- Pick a Type --</option>';
                if (categoryId) {
                    fetch(`/Product/GetSubCategories?categoryId=${categoryId}`)
                        .then(response => response.json())
                        .then(data => {
                            data.forEach(sub => {
                                var option = document.createElement('option');
                                option.value = sub.id; option.text = sub.categoryName;
                                subCategorySelect.appendChild(option);
                            });
                        });
                }
            }
            
            if (!categoryId) {
                container.innerHTML = '<div class="col-12 text-center py-5"><div class="bg-faint-green rounded-5 p-5 border-dashed-custom"><i class="fas fa-microchip fa-3x text-dark-green opacity-25 mb-3"></i><p class="text-dark-green fw-bold mb-0">Pick a Product Group above to see extra details.</p></div></div>';
                return;
            }
            
            container.innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-dark-green" role="status"></div></div>';
            
            fetch(`/Product/GetCategoryAttributes?categoryId=${categoryId}`)
                .then(response => response.json())
                .then(attributes => {
                    if (attributes.length === 0) {
                        container.innerHTML = '<div class="col-12 text-center py-5"><p class="text-muted">No extra details for this group.</p></div>';
                        return;
                    }
                    var html = '';
                    attributes.forEach(attr => {
                        var inputType = attr.dataType && attr.dataType.toLowerCase() === 'number' ? 'number' : 'text';
                        html += `
                            <div class="col-md-6">
                                <label class="form-label text-dark-green fw-bold small text-uppercase ls-1">${attr.attributeName} ${attr.isRequired ? '<span class="text-danger">*</span>' : ''}</label>
                                <div class="input-group">
                                    <input type="${inputType}" name="DynamicAttributes[${attr.id}]" class="form-control nexus-input ${attr.unit ? 'border-end-0' : ''}" ${attr.isRequired ? 'required' : ''} />
                                    ${attr.unit ? `<span class="input-group-text bg-faint-green border-0 text-dark-green fw-bold small">${attr.unit}</span>` : ''}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                });
        });
        
        let customAttributeIndex = 0;
        function addCustomAttribute() {
            const container = document.getElementById('customAttributesContainer');
            const col = document.createElement('div');
            col.className = 'col-12 custom-attribute-item';
            col.id = `customAttrCol_${customAttributeIndex}`;
            col.innerHTML = `
                <div class="row g-3 align-items-end p-3 bg-faint-green rounded-4 mb-2" style="background-color: var(--faint-green);">
                    <div class="col-md-4">
                        <label class="form-label text-dark-green fw-bold extra-small text-uppercase">Detail Name</label>
                        <input type="text" name="NewAttributes[${customAttributeIndex}].Name" class="form-control nexus-input" required placeholder="e.g., Material" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-dark-green fw-bold extra-small text-uppercase">Detail Value</label>
                        <input type="text" name="NewAttributes[${customAttributeIndex}].Value" class="form-control nexus-input" required placeholder="e.g., Steel" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-dark-green fw-bold extra-small text-uppercase">Unit (if any)</label>
                        <input type="text" name="NewAttributes[${customAttributeIndex}].Unit" class="form-control nexus-input" placeholder="e.g., mm" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-soft-danger text-danger rounded-circle p-0" style="width:40px; height:40px;" onclick="removeCustomAttribute(${customAttributeIndex})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(col);
            customAttributeIndex++;
        }
        
        function removeCustomAttribute(index) { document.getElementById(`customAttrCol_${index}`).remove(); }
        
        function previewGallery(input) {
            var container = document.getElementById('galleryPreviewContainer');
            container.innerHTML = '';
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    var reader = new FileReader();
                    reader.onload = e => {
                        var div = document.createElement('div');
                        div.className = 'position-relative';
                        div.style.width = '70px'; div.style.height = '70px';
                        div.innerHTML = `<img src="${e.target.result}" class="rounded-4 shadow-sm" style="width:70px;height:70px;object-fit:cover;" />`;
                        container.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>
}