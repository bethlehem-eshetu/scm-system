@model IEnumerable<SCM_System.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "System Audit Logs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold"><i class="fas fa-shield-alt text-primary me-2"></i>Security & Audit Vault</h1>
            <p class="text-muted small mb-0">Immutable record of administrative actions and system events.</p>
        </div>
        <div>
            <button onclick="window.location.reload()" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-sync-alt me-2"></i> Sync Logs
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                <div class="card-body text-white p-4 position-relative overflow-hidden">
                    <i class="fas fa-fingerprint position-absolute text-white opacity-25" style="font-size: 5rem; right: -10px; bottom: -10px;"></i>
                    <div class="fw-bold text-uppercase mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">Total Entries</div>
                    <div class="display-5 fw-bold mb-0">@Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">Approvals</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.Count(l => l.ActionType == "Approved")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-times-circle fa-2x text-danger"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-muted text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">Rejections</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.Count(l => l.ActionType == "Rejected" || l.ActionType == "Suspended")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="auditSearch" class="form-control bg-light border-0" placeholder="Search by operator, entity, or details...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="actionFilter" class="form-select bg-light border-0">
                        <option value="">All Actions</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Verified">Verified</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetAuditFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#auditSearch, #actionFilter").on("keyup change", function() {
                var searchText = $("#auditSearch").val().toLowerCase();
                var action = $("#actionFilter").val().toLowerCase();

                $("#auditLogsTable tbody tr").filter(function() {
                    var rowText = $(this).text().toLowerCase();
                    var rowAction = $(this).find("td:nth-child(3)").text().toLowerCase();

                    var matchesSearch = rowText.indexOf(searchText) > -1;
                    var matchesAction = action === "" || rowAction.indexOf(action) > -1;

                    $(this).toggle(matchesSearch && matchesAction);
                });
            });
        });

        function resetAuditFilters() {
            $("#auditSearch").val("");
            $("#actionFilter").val("");
            $("#auditLogsTable tbody tr").show();
        }
    </script>
}

<style>
    .table-hover tbody tr:hover { background-color: #f8f9fa; transition: background-color 0.2s ease; }
    .bg-gradient-primary { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
</style>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-dark">Event Ledger</h6>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="fas fa-filter me-2 text-primary"></i>Last 100 Events</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 border-top" id="auditLogsTable">

                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 py-3 text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Timestamp</th>
                            <th class="border-0 py-3 text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Operator</th>
                            <th class="border-0 py-3 text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Action</th>
                            <th class="border-0 py-3 text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Target Entity</th>
                            <th class="border-0 py-3 text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Details</th>
                            <th class="border-0 py-3 text-uppercase text-muted text-end pe-4" style="font-size: 0.75rem; letter-spacing: 0.5px;">Network IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="fas fa-folder-open fa-3x text-muted opacity-25 mb-3 d-block"></i>
                                        <p class="text-muted fw-medium mb-0">The audit vault is currently empty.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <div class="fw-bold text-dark" style="font-size: 0.85rem;">@log.PerformedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;"><i class="far fa-clock me-1"></i>@log.PerformedAtUtc.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-gradient-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; font-size: 0.8rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                                @(log.PerformedByUser?.FullName?.Substring(0, 1) ?? "S")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">@(log.PerformedByUser?.FullName ?? "System Auto")</div>
                                                <div class="text-muted font-monospace" style="font-size: 0.7rem;">UID: @log.PerformedByUserId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = log.ActionType switch
                                            {
                                                "Approved" => "bg-success text-white",
                                                "Rejected" => "bg-danger text-white",
                                                "Verified" => "bg-info text-white",
                                                "Suspended" => "bg-warning text-dark",
                                                "Restore" => "bg-secondary text-white",
                                                _ => "bg-light text-dark border"
                                            };
                                            
                                            var iconClass = log.ActionType switch
                                            {
                                                "Approved" => "fa-check",
                                                "Rejected" => "fa-times",
                                                "Suspended" => "fa-ban",
                                                _ => "fa-bolt"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-2 shadow-sm" style="font-size: 0.7rem; font-weight: 600;">
                                            <i class="fas @iconClass me-1"></i> @log.ActionType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light p-2 rounded-3 me-2 text-secondary">
                                                <i class="fas @(log.EntityType == "User" ? "fa-user" : "fa-cube")" style="font-size: 0.8rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">@log.EntityType</div>
                                                <div class="text-muted font-monospace" style="font-size: 0.7rem;">EID: @log.EntityId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.Notes))
                                        {
                                            <div class="text-muted text-truncate" style="max-width: 250px; font-size: 0.8rem;" title="@log.Notes">
                                                @log.Notes
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 0.8rem; font-style: italic;">No additional context</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <code class="text-primary bg-primary bg-opacity-10 px-2 py-1 rounded-3" style="font-size: 0.75rem;">@log.IpAddress</code>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover { background-color: #f8f9fa; transition: background-color 0.2s ease; }
    .bg-gradient-primary { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
</style>
