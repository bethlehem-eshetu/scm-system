@model IEnumerable<SCM_System.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "System Audit Logs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">System Audit Logs</h1>
            <p class="text-muted small mb-0">Track all administrative actions and security events.</p>
        </div>
        <div>
            <button onclick="window.location.reload()" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="fas fa-sync-alt me-1"></i> Refresh Logs
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white py-3 border-0">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-history me-2"></i> Operational History</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 py-3 text-uppercase small fw-bold">Timestamp</th>
                            <th class="border-0 py-3 text-uppercase small fw-bold">Admin</th>
                            <th class="border-0 py-3 text-uppercase small fw-bold">Action</th>
                            <th class="border-0 py-3 text-uppercase small fw-bold">Target User</th>
                            <th class="border-0 py-3 text-uppercase small fw-bold">Reason/Notes</th>
                            <th class="border-0 py-3 text-uppercase small fw-bold">IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                                    No audit logs found yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 small">
                                        <div class="fw-bold">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.7rem;">
                                                @(log.PerformedByAdmin?.FullName?.Substring(0, 1) ?? "A")
                                            </div>
                                            <div>
                                                <div class="fw-bold small">@(log.PerformedByAdmin?.FullName ?? "System")</div>
                                                <div class="text-muted extra-small">ID: @log.PerformedBy</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = log.Action switch
                                            {
                                                "Approved" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "Verified" => "bg-info",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3" style="font-size: 0.7rem;">@log.Action</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold small">@(log.User?.FullName ?? "N/A")</div>
                                        <div class="text-muted extra-small">@(log.User?.Email ?? "N/A")</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.Reason))
                                        {
                                            <span class="text-muted small text-truncate d-inline-block" style="max-width: 200px;" title="@log.Reason">@log.Reason</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">None</span>
                                        }
                                    </td>
                                    <td>
                                        <code class="extra-small text-muted bg-light px-2 py-1 rounded">@log.IpAddress</code>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 text-center">
            <p class="text-muted small mb-0">Showing last 100 system events.</p>
        </div>
    </div>
</div>

<style>
    .extra-small { font-size: 0.7rem; }
    .italic { font-style: italic; }
    .table-hover tbody tr:hover { background-color: rgba(13, 110, 253, 0.02); }
</style>
