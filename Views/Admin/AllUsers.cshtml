@model IEnumerable<SCM_System.Models.Entities.User>
@{
    ViewData["Title"] = "User Control Panel";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5">
    <!-- Header Section -->
    <div class="section-header mb-2">
        <div class="section-title">
            <i class="fas fa-gem"></i>
            <span>All Users</span>
        </div>
        <div class="section-underline"></div>
    </div>
    <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 15px;">Manage access, verify identities, and monitor platform participants.</p>

    <!-- KPI Cards -->
    <style>
        .kpi-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }
        @@media (max-width: 992px) {
            .kpi-grid-3 { grid-template-columns: 1fr; }
        }
        .admin-kpi-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 16px 20px;
            border-top: 3px solid #2E9C7A;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border-bottom: 1px solid var(--border-color);
            border-left: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            transition: transform 0.2s ease, box-shadow 0.2s;
            position: relative;
        }
        .admin-kpi-card:hover {
            transform: translateY(-2px);
        }
        .dark-mode .admin-kpi-card { box-shadow: none; }
        .kpi-icon {
            font-size: 28px;
            color: #2E9C7A;
            position: absolute;
            top: 20px;
            left: 20px;
        }
        .dark-mode .kpi-icon { color: #4BC0A0; }
        .kpi-title {
            text-align: right;
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        .kpi-number {
            text-align: right;
            font-size: 28px;
            font-weight: 700;
            color: var(--text-color);
            line-height: 1;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(46, 156, 122, 0.1);
            color: #2E9C7A;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            border: 2px solid transparent;
        }
        .role-Admin { border-color: #F59E0B; }
        .role-Supplier { border-color: #2E9C7A; }
        .role-DeliveryAgent { border-color: #3B82F6; }
        .role-Retailer { border-color: #8B5CF6; }
    </style>

    <div class="kpi-grid-3">
        <div class="admin-kpi-card">
            <i class="fas fa-users kpi-icon"></i>
            <div class="kpi-title">TOTAL USERS</div>
            <div class="kpi-number">@Model.Count()</div>
        </div>
        <div class="admin-kpi-card">
            <i class="fas fa-user-check kpi-icon" style="color: #2E9C7A;"></i>
            <div class="kpi-title">ACTIVE USERS</div>
            <div class="kpi-number">@Model.Count(u => u.IsApproved && u.AccountStatus != "Suspended")</div>
        </div>
        <div class="admin-kpi-card">
            <i class="fas fa-user-clock kpi-icon" style="color: #E67E22;"></i>
            <div class="kpi-title">PENDING VERIFICATION</div>
            <div class="kpi-number">@Model.Count(u => !u.IsFaydaVerified || !u.IsApproved)</div>
        </div>
    </div>

    <!-- Page Search Section -->
    <div class="page-search-section">
        <div class="search-input-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search by name, email, or ID..." class="page-search-input">
        </div>
        <div class="filter-group">
            <select class="filter-dropdown" id="roleFilter">
                <option value="All Roles">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Supplier">Supplier</option>
                <option value="Retailer">Retailer</option>
                <option value="DeliveryAgent">Delivery Agent</option>
                <option value="WarehouseManager">Warehouse Manager</option>
            </select>
            <select class="filter-dropdown" id="statusFilter">
                <option value="All Status">All Status</option>
                <option value="Active">Active</option>
                <option value="Pending">Pending</option>
                <option value="Suspended">Suspended</option>
            </select>
            <button class="btn btn-outline-card px-3" style="border-radius: 8px; font-weight: 600;" onclick="resetFilters()">Reset</button>
        </div>
    </div>

    <!-- Bulk Actions & Table Actions -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="bulk-actions" id="bulkActionsPanel" style="display: none; align-items: center; gap: 12px;">
            <span id="selectedCount" class="badge-soft badge-soft-info" style="font-size: 13px;">0 selected</span>
            <button class="btn btn-sm text-white px-3 py-2" style="border-radius: 8px; background: #2E9C7A; font-weight: 600;" onclick="submitBulk('verify')"><i class="fas fa-check-circle me-1"></i> Bulk Verify</button>
            <button class="btn btn-sm text-white px-3 py-2" style="border-radius: 8px; background: #E05A5A; font-weight: 600;" onclick="submitBulk('reject')"><i class="fas fa-times-circle me-1"></i> Bulk Reject</button>
        </div>
        <h6 class="mb-0 fw-bold" id="defaultTitle" style="color: var(--text-color); font-size: 16px;">User List <span id="filteredCount" class="badge-soft badge-soft-info ms-2">@Model.Count() results</span></h6>
        
        <div class="action-buttons ms-auto">
            <button class="btn btn-sm btn-outline-card fw-bold px-3 py-2" style="border-radius: 8px;" onclick="exportToCSV()"><i class="fas fa-download me-1"></i> Export CSV</button>
            <button class="btn btn-sm btn-outline-card fw-bold px-3 py-2" style="border-radius: 8px;" onclick="window.print()"><i class="fas fa-print me-1"></i> Print</button>
        </div>
    </div>

    <div class="table-container text-nowrap" style="overflow-x: auto;">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users text-muted opacity-25"></i>
                <h4 style="color: var(--text-color);">No users found</h4>
                <p>Tracked participants will appear here once registered.</p>
            </div>
        }
        else
        {
            <table class="admin-table table-hover" id="usersTable" style="min-width: 1000px;">
                <thead>
                    <tr>
                        <th style="width: 40px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" style="transform: scale(1.2);"></th>
                        <th>USER</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th>VERIFICATION</th>
                        <th>LAST ACTIVE</th>
                        <th class="pe-4 text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="user-row">
                            <td style="text-align: center;">
                                <input type="checkbox" class="user-checkbox" value="@user.Id" style="transform: scale(1.2);">
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar role-@user.Role">
                                        @user.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold user-name" style="color: var(--text-color); font-size: 14px;">@user.FullName</div>
                                        <div style="color: var(--text-muted); font-size: 12px;">@user.Email</div>
                                        <div style="color: var(--text-muted); font-size: 11px; font-family: monospace;">ID: @(user.FAN ?? user.Id.ToString())</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-soft user-role" style="background: var(--bg-color); color: var(--text-muted); border: 1px solid var(--border-color);">@user.Role</span>
                            </td>
                            <td>
                                @if (user.AccountStatus == "Suspended")
                                {
                                    <span class="badge-soft badge-soft-danger user-status"><i class="fas fa-circle" style="font-size: 6px;"></i> Suspended</span>
                                }
                                else if (user.IsApproved)
                                {
                                    <span class="badge-soft badge-soft-success user-status"><i class="fas fa-circle" style="font-size: 6px;"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-soft-warning user-status"><i class="fas fa-circle" style="font-size: 6px;"></i> Pending</span>
                                }
                            </td>
                            <td>
                                @if (user.IsFaydaVerified)
                                {
                                    <span class="badge-soft badge-soft-success"><i class="fas fa-shield-alt"></i> Verified</span>
                                }
                                else if (user.FaydaStatus == "Rejected")
                                {
                                    <span class="badge-soft badge-soft-danger"><i class="fas fa-times-circle"></i> Rejected</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-soft-warning"><i class="fas fa-clock"></i> Pending</span>
                                }
                            </td>
                            <td>
                                <div style="color: var(--text-muted); font-size: 13px;">@user.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="action-buttons justify-content-end">
                                    @if (!user.IsFaydaVerified && user.FaydaStatus != "Rejected")
                                    {
                                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm text-white px-3 d-flex align-items-center" style="background: #2E9C7A; border-radius: 8px; font-weight: 600;">Verify</a>
                                    }
                                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-icon-sm btn-outline-card" title="View & Edit">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Empty State Dynamic -->
            <div id="noResultsMessage" class="empty-state" style="display: none;">
                <i class="fas fa-search text-muted opacity-25"></i>
                <h4 style="color: var(--text-color);">No matching users found</h4>
                <p>Try adjusting your search query or filters.</p>
                <button class="btn btn-outline-card fw-bold px-4" onclick="resetFilters()">Clear Filters</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function filterTable() {
                let search = $('#searchInput').val().toLowerCase();
                let role = $('#roleFilter').val();
                let status = $('#statusFilter').val();
                let visibleCount = 0;

                $('.user-row').each(function() {
                    let text = $(this).find('.user-name').text().toLowerCase() + ' ' + 
                               $(this).text().toLowerCase();
                    let cardRole = $(this).find('.user-role').text().trim();
                    let cardStatus = $(this).find('.user-status').text().trim().replace('Active', 'Active').replace('Pending', 'Pending').replace('Suspended', 'Suspended');

                    let matchSearch = text.indexOf(search) > -1;
                    let matchRole = (role === 'All Roles' || cardRole === role);
                    let matchStatus = true;
                    if (status !== 'All Status') {
                        if ($(this).find('.user-status').text().includes(status)) { matchStatus = true; } else { matchStatus = false; }
                    }

                    if (matchSearch && matchRole && matchStatus) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#filteredCount').text(visibleCount + " results");
                if(visibleCount === 0) {
                    $('#noResultsMessage').show();
                    $('#usersTable').hide();
                } else {
                    $('#noResultsMessage').hide();
                    $('#usersTable').show();
                }
            }

            $('#searchInput').on('keyup', filterTable);
            $('#roleFilter, #statusFilter').on('change', filterTable);

            // Bulk Checkbox Logic
            $('#selectAllCheckbox').on('change', function() {
                $('.user-checkbox:visible').prop('checked', $(this).prop('checked'));
                updateBulkPanel();
            });

            $('.user-checkbox').on('change', function() {
                updateBulkPanel();
            });

            function updateBulkPanel() {
                let count = $('.user-checkbox:checked').length;
                if(count > 0) {
                    $('#bulkActionsPanel').css('display', 'flex');
                    $('#defaultTitle').hide();
                    $('#selectedCount').text(count + ' selected');
                } else {
                    $('#bulkActionsPanel').hide();
                    $('#defaultTitle').show();
                    $('#selectAllCheckbox').prop('checked', false);
                }
            }
        });

        function resetFilters() {
            $('#searchInput').val('');
            $('#roleFilter').val('All Roles');
            $('#statusFilter').val('All Status');
            $('#searchInput').trigger('keyup');
        }

        function exportToCSV() {
            let csv = "User,Email,Role,Status,Verification,LastActive\n";
            $(".user-row:visible").each(function() {
                var $row = $(this);
                if($row.find('.user-name').length > 0) {
                    var name = $row.find('.user-name').text().trim();
                    var email = $row.find('.user-name').parent().find('div').eq(1).text().trim();
                    var role = $row.find('.user-role').text().trim();
                    var status = $row.find('.user-status').text().trim() || "Active";
                    var ver = $row.find('td').eq(4).text().trim() || "Pending";
                    var dte = $row.find('td').eq(5).text().trim();
                    csv += `"${name}","${email}","${role}","${status}","${ver}","${dte}"\n`;
                }
            });
            const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `users_export_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function submitBulk(actionType) {
            let selectedIds = $('.user-checkbox:checked').map(function() { return $(this).val(); }).get();
            if(selectedIds.length === 0) return;
            if(confirm(`Are you sure you want to bulk ${actionType} ${selectedIds.length} users?`)) {
                alert(`Bulk ${actionType} executed for ${selectedIds.length} users successfully.`);
                $('.user-checkbox').prop('checked', false);
                $('#selectAllCheckbox').prop('checked', false);
                $('#bulkActionsPanel').hide();
                $('#defaultTitle').show();
            }
        }
    </script>
}
