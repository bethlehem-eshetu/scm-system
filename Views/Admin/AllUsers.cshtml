@model IEnumerable<SCM_System.Models.Entities.User>
@{
    ViewData["Title"] = "All Users | Enterprise Management";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
}

<div class="dashboard-wrapper pb-5">
    <!-- Header & Page Title (Restructured) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-title-section">
            <h2 class="fw-bold mb-0" style="color: var(--primary-color);">◆ All Users</h2>
            <div class="section-underline mt-1" style="width: 120px; height: 3px; background: var(--primary-color);"></div>
        </div>
    </div>

    <!-- KPI Cards Section (Premium) -->
    <div class="kpi-container">
        <div class="kpi-card shadow-sm border-0">
            <div class="kpi-icon bg-success bg-opacity-10 text-success">
                <i class="fas fa-users"></i>
            </div>
            <div class="kpi-data">
                <h3 id="totalUsersKPI">@Model.Count()</h3>
                <p>Total Users</p>
                <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> 8%</div>
            </div>
        </div>
        <div class="kpi-card shadow-sm border-0">
            <div class="kpi-icon bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="kpi-data">
                <h3>@Model.Count(u => u.AccountStatus == "Active")</h3>
                <p>Active</p>
                <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> 12%</div>
            </div>
        </div>
        <div class="kpi-card shadow-sm border-0">
            <div class="kpi-icon bg-warning bg-opacity-10 text-warning">
                <i class="fas fa-user-clock"></i>
            </div>
            <div class="kpi-data">
                <h3>@Model.Count(u => u.AccountStatus == "Pending")</h3>
                <p>Pending</p>
                <div class="kpi-trend down"><i class="fas fa-arrow-down"></i> 5%</div>
            </div>
        </div>
        <div class="kpi-card shadow-sm border-0">
            <div class="kpi-icon bg-danger bg-opacity-10 text-danger">
                <i class="fas fa-user-slash"></i>
            </div>
            <div class="kpi-data">
                <h3>@Model.Count(u => u.AccountStatus == "Suspended")</h3>
                <p>Suspended</p>
                <div class="kpi-trend neutral"><i class="fas fa-minus"></i> 0%</div>
            </div>
        </div>
    </div>

    <!-- Integrated Search & Filter Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="search-bar-integrated mb-4">
                <div class="input-group flex-grow-1" style="max-width: 600px;">
                    <span class="input-group-text border-0 bg-light px-3"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-0 bg-light py-2" placeholder="Search by name, email, or user ID..." style="font-size: 15px;">
                </div>
                <div class="d-flex gap-2">
                    <select class="form-select border-0 bg-light fw-medium" id="roleFilter" style="width: 140px; border-radius: 10px;">
                        <option value="All">All Roles</option>
                        <option value="Admin">Admin</option>
                        <option value="Supplier">Supplier</option>
                        <option value="Retailer">Retailer</option>
                        <option value="DeliveryAgent">Delivery</option>
                        <option value="WarehouseManager">Warehouse</option>
                    </select>
                    <select class="form-select border-0 bg-light fw-medium" id="statusFilter" style="width: 140px; border-radius: 10px;">
                        <option value="All">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Pending">Pending</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                    <select class="form-select border-0 bg-light fw-medium" id="lastActiveFilter" style="width: 140px; border-radius: 10px;">
                        <option value="All">Last Active</option>
                        <option value="Today">Today</option>
                        <option value="ThisWeek">This Week</option>
                    </select>
                    <button class="btn btn-primary px-4 fw-bold rounded-3">Apply Filters</button>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <span class="small fw-bold text-muted text-uppercase ls-1">Quick Filters:</span>
                <div class="d-flex gap-2">
                    <button class="filter-pill active" data-role="All">All</button>
                    <button class="filter-pill" data-role="Admin">Admin</button>
                    <button class="filter-pill" data-role="Supplier">Supplier</button>
                    <button class="filter-pill" data-role="Retailer">Retailer</button>
                    <button class="filter-pill" data-role="DeliveryAgent">Delivery</button>
                </div>
            </div>
        </div>
    </div>

    <!-- User List Section -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0 text-dark">User List <span class="text-muted small fw-normal ms-2" id="resultsCount">@Model.Count() results</span></h5>
            <button id="exportBtn" class="btn btn-sm btn-outline-success fw-bold px-3 py-2 rounded-3">
                <i class="fas fa-file-export me-2"></i> Export CSV
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="bg-light bg-opacity-50">
                    <tr>
                        <th style="width: 50px;" class="ps-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="selectAll">
                            </div>
                        </th>
                        <th class="small fw-bold text-muted text-uppercase py-3">User</th>
                        <th class="small fw-bold text-muted text-uppercase py-3">Contact Info</th>
                        <th class="small fw-bold text-muted text-uppercase py-3">Role</th>
                        <th class="small fw-bold text-muted text-uppercase py-3">Status</th>
                        <th class="small fw-bold text-muted text-uppercase py-3">Last Active</th>
                        <th class="small fw-bold text-muted text-uppercase py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <!-- Data loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Controls -->
    <div id="paginationArea" class="pagination-container px-2">
        <div class="text-muted small">
            Showing <span id="startRange" class="fw-bold">0</span> to <span id="endRange" class="fw-bold">0</span> of <span id="totalCount" class="fw-bold">0</span> users
        </div>
        <div class="d-flex align-items-center gap-1" id="paginationControls">
            <!-- Pagination buttons -->
        </div>
    </div>
</div>

<!-- Floating Bulk Action Bar -->
<div id="bulkActionBar" class="bulk-action-bar shadow-lg">
    <div class="d-flex align-items-center gap-3 pe-3 border-end">
        <span class="bulk-count" id="bulkUserCount">0</span>
        <span class="fw-medium">Selected</span>
    </div>
    <div class="bulk-actions ps-2">
        <button id="bulkVerifyBtn" class="bulk-btn btn-success-soft">
            <i class="fas fa-check-circle"></i> Bulk Verify
        </button>
        <button id="bulkSuspendBtn" class="bulk-btn">
            <i class="fas fa-user-slash"></i> Bulk Suspend
        </button>
        <button id="bulkRejectBtn" class="bulk-btn btn-danger-soft">
            <i class="fas fa-times-circle"></i> Bulk Reject
        </button>
    </div>
    <button class="btn btn-sm btn-link text-white text-decoration-none ms-2" onclick="selectedUsers=[]; updateBulkBar(); $('.user-checkbox').prop('checked', false);">
        <i class="fas fa-times"></i>
    </button>
</div>

<!-- Include Partial Modals -->
<partial name="_UserModals" />

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}
