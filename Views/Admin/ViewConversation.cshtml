@model SCM_System.Models.Entities.Conversation

@{
    ViewData["Title"] = "Conversation Details";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/conversation.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="conversation-container">

        <!-- Back Nav -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="MessageLog" class="back-nav-btn">
                <i class="fas fa-arrow-left"></i> Back to Message Monitoring
            </a>
            <a asp-action="BlockedMessages" class="back-nav-btn">
                <i class="fas fa-ban"></i> Blocked Messages
            </a>
        </div>

        <!-- Participants Section -->
        <div class="conv-section">
            <div class="conv-section-title">
                <i class="fas fa-users"></i> Participants
            </div>
            <div class="participants-grid">
                <!-- Supplier -->
                <div class="participant-card supplier">
                    <span class="participant-role-badge">🏭 Supplier</span>
                    <div class="participant-name">@(Model.Supplier?.User?.FullName ?? "Unknown Supplier")</div>
                    <div class="participant-company">@(Model.Supplier?.CompanyName ?? "—")</div>
                    <div class="participant-email">@(Model.Supplier?.User?.Email ?? "—")</div>
                </div>
                <!-- Retailer -->
                <div class="participant-card retailer">
                    <span class="participant-role-badge">🏪 Retailer</span>
                    <div class="participant-name">@(Model.Retailer?.User?.FullName ?? "Unknown Retailer")</div>
                    <div class="participant-company">@(Model.Retailer?.BusinessName ?? "—")</div>
                    <div class="participant-email">@(Model.Retailer?.User?.Email ?? "—")</div>
                </div>
            </div>
        </div>

        <!-- Message History -->
        <div class="conv-section">
            <div class="conv-section-title">
                <i class="fas fa-comments"></i> Message History
                <span class="badge-soft badge-soft-info ms-2">@(Model.Messages?.Count ?? 0) messages</span>
            </div>

            @if (Model.Messages == null || !Model.Messages.Any())
            {
                <div class="text-center py-5" style="color: var(--text-muted);">
                    <i class="fas fa-comment-slash fa-3x opacity-25 mb-3 d-block"></i>
                    <p>No messages in this conversation.</p>
                </div>
            }
            else
            {
                <div class="messages-list">
                    @foreach (var message in Model.Messages.OrderBy(m => m.CreatedAt))
                    {
                        var isSupplier = message.Sender?.Role == "Supplier";
                        var rowClass = isSupplier ? "row-supplier" : "row-retailer";
                        var isFlagged = message.IsBlocked;

                        <div class="msg-row @rowClass">
                            <div class="msg-body">
                                <div class="msg-meta">
                                    <span class="msg-sender-name">@message.Sender?.FullName</span>
                                    <span class="msg-time">(@message.Sender?.Role) · @message.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div class="msg-bubble @(isFlagged ? "flagged" : "")">
                                    @if (isFlagged)
                                    {
                                        <span style="color:#E67E22; margin-right:6px;">⚠️</span>
                                    }
                                    @message.MessageText
                                </div>
                                <div class="msg-footer">
                                    @if (isFlagged)
                                    {
                                        <span class="flag-badge"><i class="fas fa-flag"></i> Flagged for review</span>
                                    }
                                    @if (message.IsRead)
                                    {
                                        <span class="read-badge"><i class="fas fa-check-double"></i> Read</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-check"></i> Delivered</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>