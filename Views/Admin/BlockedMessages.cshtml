@model List<SCM_System.Models.ViewModels.BlockedMessageViewModel>

@{
    ViewData["Title"] = "Blocked Messages";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-ban text-warning me-2"></i>Blocked Messages
        </h1>
        <a asp-action="MessageLog" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Message Log
        </a>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="tableSearch" class="form-control bg-light border-0" placeholder="Search by sender or content...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="roleFilter" class="form-select bg-light border-0">
                        <option value="">All Roles</option>
                        <option value="Supplier">Supplier</option>
                        <option value="Retailer">Retailer</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="violationFilter" class="form-select bg-light border-0">
                        <option value="">All Violations</option>
                        <option value="Contact Information">Contact Information</option>
                        <option value="Off-platform Payment">Off-platform Payment</option>
                        <option value="Inappropriate Content">Inappropriate Content</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-exclamation-triangle me-2 text-warning"></i>
                Detected Violations
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No blocked messages</h5>
                    <p class="text-muted">All messages are following platform guidelines</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="blockedMessagesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th>Sender</th>
                                <th>Role</th>
                                <th>Violation Type</th>
                                <th>Original Message</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var msg in Model)
                            {
                                <tr data-role="@msg.SenderRole" data-violation="@msg.ViolationType">
                                    <td><small>@msg.CreatedAt.ToString("MMM dd, HH:mm")</small></td>
                                    <td><strong>@msg.SenderName</strong></td>
                                    <td><span class="badge bg-@(msg.SenderRole == "Supplier" ? "primary" : "info")">@msg.SenderRole</span></td>
                                    <td>
                                        <span class="badge bg-danger">@msg.ViolationType</span>
                                    </td>
                                    <td>
                                        <span class="text-muted fst-italic">@msg.Content</span>
                                    </td>

                                    <td>
                                        <a asp-action="ViewConversation" asp-route-id="@msg.ConversationId"
                                               class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

    <script>
        $(document).ready(function() {
            $("#tableSearch, #roleFilter, #violationFilter").on("keyup change", function() {
                var searchText = $("#tableSearch").val().toLowerCase();
                var role = $("#roleFilter").val().toLowerCase();
                var violation = $("#violationFilter").val().toLowerCase();

                $("#blockedMessagesTable tbody tr").each(function() {
                    var row = $(this);
                    var rowText = row.text().toLowerCase();
                    var rowRole = row.attr("data-role").toLowerCase();
                    var rowViolation = row.attr("data-violation").toLowerCase();

                    var matchesSearch = rowText.indexOf(searchText) > -1;
                    var matchesRole = role === "" || rowRole === role;
                    var matchesViolation = violation === "" || rowViolation === violation;

                    row.toggle(matchesSearch && matchesRole && matchesViolation);
                });
            });
        });

        function resetFilters() {
            $("#tableSearch").val("");
            $("#roleFilter").val("");
            $("#violationFilter").val("");
            $("#blockedMessagesTable tbody tr").show();
        }
    </script>

</div>