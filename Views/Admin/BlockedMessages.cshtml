@model List<SCM_System.Models.ViewModels.BlockedMessageViewModel>

@{
    ViewData["Title"] = "Blocked Messages";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-ban text-warning me-2"></i>Blocked Messages
        </h1>
        <a asp-action="MessageLog" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Message Log
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2 text-warning"></i>
                Messages Blocked by Contact Detection
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No blocked messages</h5>
                    <p class="text-muted">All messages are following platform guidelines</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Sender</th>
                                <th>Role</th>
                                <th>Violation Type</th>
                                <th>Original Message</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var msg in Model)
                            {
                                <tr>
                                    <td><small>@msg.CreatedAt.ToString("MMM dd, HH:mm")</small></td>
                                    <td><strong>@msg.SenderName</strong></td>
                                    <td><span class="badge bg-@(msg.SenderRole == "Supplier" ? "primary" : "info")">@msg.SenderRole</span></td>
                                    <td>
                                        <span class="badge bg-danger">@msg.ViolationType</span>
                                    </td>
                                    <td>
                                        <span class="text-muted fst-italic">@msg.Content</span>
                                    </td>
                                    <td>
                                        @if (msg.IsResolved)
                                        {
                                            <span class="badge bg-success">Resolved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ViewConversation" asp-route-id="@msg.ConversationId"
                                               class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>