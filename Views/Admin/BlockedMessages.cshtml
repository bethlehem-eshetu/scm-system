@model List<SCM_System.Models.ViewModels.BlockedMessageViewModel>

@{
    ViewData["Title"] = "Blocked Messages";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-ban text-warning me-2"></i>Blocked Messages
        </h1>
        <a asp-action="MessageLog" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Message Log
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Total Blocked</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="fas fa-ban fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Pending Review</h6>
                            <h3 class="mb-0">@Model.Count(m => !m.IsResolved)</h3>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Resolved</h6>
                            <h3 class="mb-0">@Model.Count(m => m.IsResolved)</h3>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="tableSearch" class="form-control bg-light border-0" placeholder="Search by sender or content...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="roleFilter" class="form-select bg-light border-0">
                        <option value="">All Roles</option>
                        <option value="Supplier">Supplier</option>
                        <option value="Retailer">Retailer</option>
                       
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="violationFilter" class="form-select bg-light border-0">
                        <option value="">All Violations</option>
                        <option value="Contact Information">📞 Contact Information</option>
                        <option value="Off-platform Payment">💳 Off-platform Payment</option>
                        <option value="Inappropriate Content">⚠️ Inappropriate Content</option>
                        <option value="Email">📧 Email Address</option>
                        <option value="EthiopianPhone">📱 Phone Number</option>
                       
                        <option value="SocialMedia">🌐 Social Media</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-exclamation-triangle me-2 text-warning"></i>
                Detected Violations
            </h5>
            <span id="filteredCount" class="badge bg-secondary">@Model.Count</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No blocked messages</h5>
                    <p class="text-muted">All messages are following platform guidelines</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="blockedMessagesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th>Sender</th>
                                <th>Role</th>
                                <th>Violation Type</th>
                                <th>Original Message</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var msg in Model)
                            {
                                <tr data-sender-name="@msg.SenderName"
                                    data-sender-role="@msg.SenderRole"
                                    data-violation-type="@msg.ViolationType"
                                    data-content="@msg.Content"
                                    data-resolved="@msg.IsResolved.ToString().ToLower()">
                                    <td class="ps-4">
                                        <small>@msg.CreatedAt.ToString("MMM dd, yyyy")</small><br />
                                        <small class="text-muted">@msg.CreatedAt.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <strong>@msg.SenderName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(msg.SenderRole == "Supplier" ? "primary" : "info")">
                                            @msg.SenderRole
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">
                                            @if (msg.ViolationType.Contains("Email"))
                                            {
                                                <i class="fas fa-envelope"></i>
                                            }
                                            else if (msg.ViolationType.Contains("Phone"))
                                            {
                                                <i class="fas fa-phone"></i>
                                            }
                                            else if (msg.ViolationType.Contains("Telegram") || msg.ViolationType.Contains("WhatsApp"))
                                            {
                                                <i class="fab fa-whatsapp"></i>
                                            }
                                            else if (msg.ViolationType.Contains("Payment"))
                                            {
                                                <i class="fas fa-credit-card"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-exclamation-triangle"></i>
                                            }
                                            @msg.ViolationType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="message-preview" data-full-message="@Html.Raw(msg.Content?.Replace("\"", "&quot;"))">
                                            @(msg.Content?.Length > 60 ? msg.Content.Substring(0, 60) + "..." : msg.Content)
                                            @if (msg.Content?.Length > 60)
                                            {
                                                <a href="#" class="text-primary" onclick="showFullMessage(this); return false;">
                                                    <i class="fas fa-expand-alt ms-1"></i> more
                                                </a>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (msg.IsResolved)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock"></i> Pending
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="ViewConversation" asp-route-id="@msg.ConversationId"
                                                   class="btn btn-outline-primary" title="View Conversation">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!msg.IsResolved)
                                            {
                                                <button type="button" class="btn btn-outline-success"
                                                        onclick="resolveViolation(@msg.ViolationId)" title="Mark as Resolved">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-danger"
                                                    onclick="deleteMessage(@msg.MessageId)" title="Delete Message">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- No results message (hidden by default) -->
                <div id="noResultsRow" style="display: none;" class="text-center py-5">
                    <i class="fas fa-search fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No matching blocked messages found</h5>
                    <p class="text-muted">Try adjusting your search or filter criteria</p>
                    <button class="btn btn-primary mt-2" onclick="resetFilters()">
                        <i class="fas fa-undo me-1"></i> Reset Filters
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Full Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-ban me-2"></i>Blocked Message Content
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Violation Detected:</strong> This message was blocked for sharing prohibited content.
                </div>
                <p id="fullMessageText" class="mb-0 p-3 bg-light rounded"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Show full message in modal
        function showFullMessage(element) {
        const previewDiv = element.closest('.message-preview');
        if (previewDiv) {
        const fullMessage = previewDiv.getAttribute('data-full-message');
        document.getElementById('fullMessageText').innerText = fullMessage;
        new bootstrap.Modal(document.getElementById('messageModal')).show();
        }
        }
        
        // Resolve violation
        function resolveViolation(violationId) {
        if (confirm('Mark this violation as resolved? This will remove it from the pending list.')) {
        $.ajax({
        url: '@Url.Action("ResolveViolation", "Admin")',
        type: 'POST',
        data: { id: violationId },
        headers: {
        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
        if (result.success) {
        location.reload();
        } else {
        alert('Error: ' + (result.message || 'Could not resolve violation'));
        }
        },
        error: function() {
        alert('An error occurred. Please try again.');
        }
        });
        }
        }
        
        // Delete message
        function deleteMessage(messageId) {
        if (confirm('⚠️ WARNING: This will permanently delete the message. This action cannot be undone. Continue?')) {
        $.ajax({
        url: '@Url.Action("DeleteMessage", "Admin")',
        type: 'POST',
        data: { id: messageId },
        headers: {
        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
        if (result.success) {
        location.reload();
        } else {
        alert('Error: ' + (result.message || 'Could not delete message'));
        }
        },
        error: function() {
        alert('An error occurred. Please try again.');
        }
        });
        }
        }
        
        // Filtering functionality
        $(document).ready(function() {
        function applyFilters() {
        var searchText = $("#tableSearch").val().toLowerCase().trim();
        var role = $("#roleFilter").val().toLowerCase();
        var violation = $("#violationFilter").val().toLowerCase();
                
        var visibleCount = 0;
                
        $("#blockedMessagesTable tbody tr").each(function() {
        var $row = $(this);
                    
        // Get row data from data attributes
        var senderName = ($row.attr("data-sender-name") || "").toLowerCase();
        var senderRole = ($row.attr("data-sender-role") || "").toLowerCase();
        var violationType = ($row.attr("data-violation-type") || "").toLowerCase();
        var content = ($row.attr("data-content") || "").toLowerCase();
        var isResolved = $row.attr("data-resolved") === "true";
                    
        // Check search (sender name or content)
        var matchesSearch = searchText === "" ||
        senderName.indexOf(searchText) > -1 ||
        content.indexOf(searchText) > -1;
                    
        // Check role filter
        var matchesRole = role === "" || senderRole === role;
                    
        // Check violation filter
        var matchesViolation = violation === "" || violationType.indexOf(violation) > -1;
                    
        var isVisible = matchesSearch && matchesRole && matchesViolation;
                    
        if (isVisible) {
        $row.show();
        visibleCount++;
        } else {
        $row.hide();
        }
        });
                
        // Update filtered count
        $("#filteredCount").text(visibleCount);
                
        // Show/hide "no results" message
        if (visibleCount === 0) {
        $("#noResultsRow").show();
        } else {
        $("#noResultsRow").hide();
        }
        }
            
        // Bind filter events
        $("#tableSearch, #roleFilter, #violationFilter").on("keyup change", function() {
        applyFilters();
        });
            
        // Initial filter application
        applyFilters();
        });
        
        // Reset all filters
        function resetFilters() {
        $("#tableSearch").val("");
        $("#roleFilter").val("");
        $("#violationFilter").val("");
        $("#tableSearch").trigger("keyup");
        }
    </script>
}