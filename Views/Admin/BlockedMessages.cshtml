@model List<SCM_System.Models.ViewModels.BlockedMessageViewModel>

@{
    ViewData["Title"] = "Blocked Messages";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-messages.css" asp-append-version="true" />
}

<div class="container-fluid py-4 blocked-container">
    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card active" id="kpiTotalBlocked">
            <i class="fas fa-exclamation-triangle kpi-icon"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.TotalBlockedCount</div>
                <div class="kpi-label">Total Blocked</div>
            </div>
        </div>
        <div class="kpi-card" id="kpiPending">
            <i class="fas fa-clock kpi-icon" style="color: #E67E22;"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.PendingCount</div>
                <div class="kpi-label">Pending Review</div>
            </div>
        </div>
        <div class="kpi-card" id="kpiResolved">
            <i class="fas fa-check-circle kpi-icon" style="color: #2E9C7A;"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.ResolvedCount</div>
                <div class="kpi-label">Resolved</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search by sender or blocked content...">
                </div>
            </div>
            <div class="col-lg-2">
                <select id="roleFilter" class="form-select filter-select">
                    <option value="all">All Roles</option>
                    <option value="Supplier">Supplier</option>
                    <option value="Retailer">Retailer</option>
                </select>
            </div>
            <div class="col-lg-2">
                <select id="timeRangeFilter" class="form-select filter-select">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                </select>
            </div>
            <div class="col-lg-3 text-end">
                <button id="refreshBtn" class="btn btn-refresh ms-auto">
                    <i class="fas fa-sync-alt"></i> Refresh Logs
                </button>
            </div>
        </div>
    </div>

    <!-- Table Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <h6 class="mb-0 fw-bold" style="color: var(--text-primary); font-size: 16px;">
            Detected Violations
            <span id="filteredCount" class="badge-soft badge-soft-info ms-2">Loading...</span>
        </h6>
        <div class="d-flex gap-2">
            <a asp-action="MessageLog" class="btn btn-sm btn-refresh px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Logs
            </a>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-container text-nowrap rounded-4 overflow-hidden border">
        <table class="table admin-table table-hover mb-0" id="blockedMessagesTable">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Detected On</th>
                    <th>Sender</th>
                    <th>Role</th>
                    <th>Violation Type</th>
                    <th>Blocked Content</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="blockedMessagesTableBody">
                <!-- Data populated by AJAX -->
                <tr>
                    <td colspan="7" class="text-center py-5">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary opacity-25"></i>
                        <p class="mt-2 text-muted">Checking violation records...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-messages.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Initial load
            applyFilters();
        });

        function resolveViolation(violationId) {
            if (confirm('Mark this violation as resolved?')) {
                fetch('/Admin/ResolveViolation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${violationId}`
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        applyFilters();
                    } else {
                        alert('Error: ' + data.message);
                    }
                });
            }
        }
    </script>
}