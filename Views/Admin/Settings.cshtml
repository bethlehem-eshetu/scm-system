@model SCM_System.Models.ViewModels.AdminSettingsViewModel
@{
    ViewData["Title"] = "SCM Platform Settings";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-5 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="text-white mb-1 fw-bold"><i class="fas fa-microchip text-accent-green me-3"></i>SCM Kernel Configuration</h2>
                            <p class="text-white-50 mb-0 opacity-75">Global platform variables, security hierarchies, and strategic operational parameters.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-white bg-opacity-10 text-white border-0 rounded-pill px-4 py-2 shadow-sm fw-bold" onclick="location.reload()">
                                <i class="fas fa-sync-alt me-2"></i> Refresh Kernel
                            </button>
                        </div>
                    </div>
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-cogs fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-premium border-0 rounded-4 mb-5 p-4 bg-white" role="alert">
            <div class="d-flex align-items-center">
                <div class="bg-soft-success text-success rounded-circle p-3 me-3">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <div class="fw-bold text-dark-green">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close mt-2 me-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Settings" asp-controller="Admin" method="post" enctype="multipart/form-data" id="adminSettingsForm">
        <div class="row g-5">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                <div class="card border-0 shadow-premium rounded-5 sticky-top bg-white overflow-hidden" style="top: 20px;">
                    <div class="p-5 text-center border-bottom border-faint bg-faint-green">
                        <div class="position-relative d-inline-block mb-4">
                            <div class="bg-white rounded-circle shadow-premium d-flex align-items-center justify-content-center overflow-hidden border border-4 border-white" style="width: 120px; height: 120px; margin: 0 auto;">
                                <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/images/default-avatar.png" : Model.ProfilePicture)" 
                                     class="img-fluid h-100 w-100 object-fit-cover" id="profileImagePreview" />
                                <label for="ProfilePictureFile" class="btn btn-dark-green btn-sm position-absolute bottom-0 end-0 rounded-circle shadow-premium p-2 border border-2 border-white" style="cursor: pointer;">
                                    <i class="fas fa-camera text-accent-green extra-small"></i>
                                </label>
                                <input type="file" asp-for="ProfilePictureFile" id="ProfilePictureFile" class="d-none" accept="image/*" onchange="previewImage(event)">
                            </div>
                            <h5 class="fw-bold text-dark-green mb-1 mt-3">@Model.FullName</h5>
                            <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 extra-small ls-1 uppercase fw-bold">Root Admin</span>
                        </div>
                    </div>
                    <div class="p-4 overflow-auto" style="max-height: 60vh;">
                        <div class="nav flex-column nav-pills scm-pills" id="settingsTabs" role="tablist">
                            <button class="nav-link active text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-profile" data-bs-toggle="pill" data-bs-target="#pane-profile" type="button" role="tab">
                                <i class="fas fa-user me-3 opacity-75"></i>Identity
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-password" data-bs-toggle="pill" data-bs-target="#pane-password" type="button" role="tab">
                                <i class="fas fa-key me-3 opacity-75"></i>Security Code
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-security" data-bs-toggle="pill" data-bs-target="#pane-security" type="button" role="tab">
                                <i class="fas fa-shield-alt me-3 opacity-75"></i>Vault Setup
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-sessions" data-bs-toggle="pill" data-bs-target="#pane-sessions" type="button" role="tab">
                                <i class="fas fa-desktop me-3 opacity-75"></i>Active Links
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-history" data-bs-toggle="pill" data-bs-target="#pane-history" type="button" role="tab">
                                <i class="fas fa-history me-3 opacity-75"></i>Access Logs
                            </button>
                            <div class="my-3 border-top border-faint"></div>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-commissions" data-bs-toggle="pill" data-bs-target="#pane-commissions" type="button" role="tab">
                                <i class="fas fa-percentage me-3 opacity-75"></i>Treasury Cuts
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-penalties" data-bs-toggle="pill" data-bs-target="#pane-penalties" type="button" role="tab">
                                <i class="fas fa-gavel me-3 opacity-75"></i>Compliance Rules
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-operations" data-bs-toggle="pill" data-bs-target="#pane-operations" type="button" role="tab">
                                <i class="fas fa-truck-loading me-3 opacity-75"></i>Operations Hub
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-onboarding" data-bs-toggle="pill" data-bs-target="#pane-onboarding" type="button" role="tab">
                                <i class="fas fa-user-plus me-3 opacity-75"></i>Onboarding
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-system" data-bs-toggle="pill" data-bs-target="#pane-system" type="button" role="tab">
                                <i class="fas fa-globe me-3 opacity-75"></i>Global Logic
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all" id="tab-payment" data-bs-toggle="pill" data-bs-target="#pane-payment" type="button" role="tab">
                                <i class="fas fa-credit-card me-3 opacity-75"></i>Chapa Gateway
                            </button>
                            <button class="nav-link text-start mb-2 rounded-pill px-4 py-3 fw-bold transition-all text-danger" id="tab-danger" data-bs-toggle="pill" data-bs-target="#pane-danger" type="button" role="tab">
                                <i class="fas fa-exclamation-triangle me-3 opacity-75"></i>System Reset
                            </button>
                        </div>
                        <div class="mt-4 pt-4 border-top border-faint">
                            <button type="submit" class="btn btn-dark-green w-100 rounded-pill py-3 fw-bold shadow-premium">
                                <i class="fas fa-save me-2 text-accent-green"></i>Commit All Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">
                <div class="tab-content" id="settingsTabContent">
                    
                    <!-- 1. Identity -->
                    <div class="tab-pane fade show active" id="pane-profile" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-user-circle text-accent-green me-2"></i>Personal Metadata</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Legal Name</label>
                                        <input asp-for="FullName" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Primary Email (Locked)</label>
                                        <input asp-for="Email" class="form-control scm-input opacity-75 bg-faint-green" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Contact Link</label>
                                        <input asp-for="Phone" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6 pt-4">
                                        <div class="bg-faint-green rounded-pill p-3 px-4 d-flex align-items-center justify-content-between shadow-inner">
                                            <span class="fw-bold text-dark-green extra-small">Visual Environment</span>
                                            <partial name="_ThemeToggle" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Password -->
                    <div class="tab-pane fade" id="pane-password" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-key text-accent-green me-2"></i>Access Rotation</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Current Verification</label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">New Security Hash</label>
                                        <input asp-for="NewPassword" type="password" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Confirm Hash</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control scm-input" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Vault Setup -->
                    <div class="tab-pane fade" id="pane-security" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-shield-alt text-accent-green me-2"></i>Multi-Layer Identity</h5>
                            </div>
                            <div class="card-body p-5 text-center">
                                <div class="bg-faint-green rounded-pill p-4 mb-5 d-flex align-items-center justify-content-between shadow-inner">
                                    <div class="text-start">
                                        <h6 class="fw-bold text-dark-green mb-1">Two-Factor Authentication</h6>
                                        <p class="extra-small text-muted mb-0 fw-bold">Critical platform security layer.</p>
                                    </div>
                                    <div class="form-check form-switch p-0">
                                        <input class="form-check-input ms-0" type="checkbox" asp-for="TwoFactorEnabled" id="twoFactorSwitch" style="width: 3.5rem; height: 1.75rem;">
                                    </div>
                                </div>
                                
                                @if (!Model.TwoFactorEnabled && ViewBag.QrCodeImageUrl != null)
                                {
                                    <div class="p-5 bg-faint-green rounded-5 border border-faint shadow-inner" id="setup2faDiv">
                                        <i class="fas fa-qrcode fa-3x text-dark-green opacity-25 mb-4"></i>
                                        <h6 class="fw-bold text-dark-green mb-4">Synchronization Required</h6>
                                        <div class="mb-4">
                                            <img src="@ViewBag.QrCodeImageUrl" alt="QR Code" class="img-fluid border border-4 border-white rounded-4 shadow-premium" style="max-width: 180px;" />
                                            <p class="small text-muted font-monospace mt-3 fw-bold">@ViewBag.ManualSetupKey</p>
                                        </div>
                                        <div class="input-group mx-auto" style="max-width: 300px;">
                                            <input type="text" id="pin2fa" class="form-control scm-input rounded-end-0 border-end" placeholder="AUTH CODE" />
                                            <button type="button" class="btn btn-dark-green px-4 rounded-pill rounded-start-0" onclick="verify2FA()">VERIFY</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 4. Active Links -->
                    <div class="tab-pane fade" id="pane-sessions" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-link text-accent-green me-2"></i>Live Deployment Links</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-faint-green">
                                            <tr>
                                                <th class="ps-5 py-3 border-0 extra-small fw-bold text-muted uppercase">Terminal Agent</th>
                                                <th class="py-3 border-0 extra-small fw-bold text-muted uppercase">IP Segment</th>
                                                <th class="py-3 border-0 extra-small fw-bold text-muted uppercase">Activity</th>
                                                <th class="pe-5 py-3 border-0 text-end extra-small fw-bold text-muted uppercase">Control</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var session in Model.ActiveSessions)
                                            {
                                                <tr>
                                                    <td class="ps-5 py-4 fw-bold text-dark-green small">@session.UserAgent</td>
                                                    <td class="small opacity-75">@session.IpAddress</td>
                                                    <td class="extra-small fw-bold">@session.LastActivityTime.ToString("MMM dd, HH:mm")</td>
                                                    <td class="pe-5 text-end">
                                                        <button type="button" class="btn btn-sm btn-faint-green text-danger rounded-circle p-2 shadow-sm" onclick="revokeSession(@session.Id)">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Access Logs -->
                    <div class="tab-pane fade" id="pane-history" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-stream text-accent-green me-2"></i>Authentication Ledger</h5>
                                <a href="/Admin/ExportAuditLogs" class="btn btn-dark-green btn-sm rounded-pill px-4 fw-bold extra-small">
                                    <i class="fas fa-download me-2 text-accent-green"></i>Secure Export
                                </a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <tbody>
                                            @foreach (var log in Model.LoginHistory)
                                            {
                                                <tr class="border-bottom border-faint">
                                                    <td class="ps-5 py-4">
                                                        <div class="fw-bold text-dark-green small">@log.PerformedAtUtc.ToLocalTime().ToString("MMM dd, HH:mm")</div>
                                                        <div class="extra-small text-muted opacity-75">@log.IpAddress</div>
                                                    </td>
                                                    <td class="small opacity-50">@log.UserAgent</td>
                                                    <td class="pe-5 text-end">
                                                        <span class="badge bg-soft-success text-success rounded-pill px-3 py-1 extra-small">AUTH_PASS</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Treasury Cuts -->
                    <div class="tab-pane fade" id="pane-commissions" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-chart-line text-accent-green me-2"></i>Strategic Revenue Splits</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="bg-faint-green p-4 rounded-5 border border-faint shadow-inner">
                                            <label class="extra-small text-muted fw-bold uppercase ls-1 d-block mb-3">Bronze Tier Commission</label>
                                            <div class="input-group">
                                                <input asp-for="CommissionBronze" type="number" step="0.1" class="form-control scm-input rounded-end-0" />
                                                <span class="input-group-text bg-dark-green text-accent-green border-0 rounded-pill rounded-start-0 px-4 fw-bold">%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-faint-green p-4 rounded-5 border border-faint shadow-inner">
                                            <label class="extra-small text-muted fw-bold uppercase ls-1 d-block mb-3">Silver Tier Commission</label>
                                            <div class="input-group">
                                                <input asp-for="CommissionSilver" type="number" step="0.1" class="form-control scm-input rounded-end-0" />
                                                <span class="input-group-text bg-dark-green text-accent-green border-0 rounded-pill rounded-start-0 px-4 fw-bold">%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-faint-green p-4 rounded-5 border border-faint shadow-inner">
                                            <label class="extra-small text-muted fw-bold uppercase ls-1 d-block mb-3">Gold Tier Commission</label>
                                            <div class="input-group">
                                                <input asp-for="CommissionGold" type="number" step="0.1" class="form-control scm-input rounded-end-0" />
                                                <span class="input-group-text bg-dark-green text-accent-green border-0 rounded-pill rounded-start-0 px-4 fw-bold">%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-faint-green p-4 rounded-5 border border-faint shadow-inner">
                                            <label class="extra-small text-muted fw-bold uppercase ls-1 d-block mb-3">Platinum Tier Commission</label>
                                            <div class="input-group">
                                                <input asp-for="CommissionPlatinum" type="number" step="0.1" class="form-control scm-input rounded-end-0" />
                                                <span class="input-group-text bg-dark-green text-accent-green border-0 rounded-pill rounded-start-0 px-4 fw-bold">%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 7. Compliance Rules -->
                    <div class="tab-pane fade" id="pane-penalties" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-gavel text-accent-green me-2"></i>Network Compliance Thresholds</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Warning Trigger (Violation Count)</label>
                                        <input asp-for="PenaltyWarningThreshold" type="number" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Auto-Suspension Window (Days)</label>
                                        <input asp-for="PenaltySuspensionDays" type="number" class="form-control scm-input" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 8. Operations Hub -->
                    <div class="tab-pane fade" id="pane-operations" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-sliders-h text-accent-green me-2"></i>Global Operation Constants</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Low Stock Default</label>
                                        <input asp-for="LowStockDefaultThreshold" type="number" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Max Tender Lifespan (Days)</label>
                                        <input asp-for="MaxTenderDays" type="number" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Escrow Release (Days)</label>
                                        <input asp-for="AutoReleaseEscrowDays" type="number" class="form-control scm-input" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 9. Onboarding -->
                    <div class="tab-pane fade" id="pane-onboarding" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-id-badge text-accent-green me-2"></i>Entrance Protocol</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="list-group list-group-flush border-0">
                                    <div class="list-group-item px-0 py-4 border-faint bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Supplier Vetting</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">Require manual root approval for new supply entities.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="RequireSupplierApproval" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-4 border-faint bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Retailer Vetting</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">Require manual root approval for new retail nodes.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="RequireRetailerApproval" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                    <div class="list-group-item px-0 py-4 border-0 bg-transparent d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark-green mb-1">Digital ID (Fayda) Integration</h6>
                                            <p class="text-muted extra-small mb-0 fw-bold">Enforce Ethiopian Digital ID verification for all business stakeholders.</p>
                                        </div>
                                        <div class="form-check form-switch p-0">
                                            <input asp-for="EnableFaydaVerification" class="form-check-input ms-0" type="checkbox" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 11. Global Logic -->
                    <div class="tab-pane fade" id="pane-system" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-globe-africa text-accent-green me-2"></i>Nexus Environment Variable</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Base Application URL</label>
                                        <input asp-for="AppUrl" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Global Support Link</label>
                                        <input asp-for="SupportEmail" type="email" class="form-control scm-input" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Time Matrix</label>
                                        <select asp-for="Timezone" class="form-select scm-input">
                                            <option value="Africa/Addis_Ababa">Africa/Addis (EAT)</option>
                                            <option value="UTC">Universal (UTC)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Primary Currency</label>
                                        <select asp-for="Currency" class="form-select scm-input">
                                            <option value="ETB">ETB (Birr)</option>
                                            <option value="USD">USD (Dollar)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Chronology Mask</label>
                                        <input asp-for="DateFormat" class="form-control scm-input" placeholder="dd MMM yyyy" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 12. Chapa Gateway -->
                    <div class="tab-pane fade" id="pane-payment" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                            <div class="card-header bg-faint-green py-4 px-5 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-credit-card text-accent-green me-2"></i>Chapa Financial Bridge</h5>
                                <div class="form-check form-switch p-0">
                                    <input class="form-check-input ms-0" type="checkbox" asp-for="ChapaTestMode" id="testModeSwitch" style="width: 3rem; height: 1.5rem;">
                                    <label class="extra-small fw-bold text-dark-green ms-2 pt-1" for="testModeSwitch">TEST MODE</label>
                                </div>
                            </div>
                            <div class="card-body p-5">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Strategic Secret Key</label>
                                        <div class="input-group">
                                            <input asp-for="ChapaSecretKey" type="password" id="chapaSecret" class="form-control scm-input rounded-end-0" />
                                            <button class="btn btn-dark-green border-0 rounded-pill rounded-start-0 px-4" type="button" onclick="togglePassword('chapaSecret')"><i class="fas fa-eye text-accent-green"></i></button>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Webhook Identity Token</label>
                                        <div class="input-group">
                                            <input asp-for="ChapaWebhookSecret" type="password" id="chapaWebhook" class="form-control scm-input rounded-end-0" />
                                            <button class="btn btn-dark-green border-0 rounded-pill rounded-start-0 px-4" type="button" onclick="togglePassword('chapaWebhook')"><i class="fas fa-eye text-accent-green"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 13. System Reset -->
                    <div class="tab-pane fade" id="pane-danger" role="tabpanel">
                        <div class="card border-0 shadow-premium rounded-5 border-top border-5 border-danger bg-white overflow-hidden">
                            <div class="card-header bg-soft-danger py-4 px-5 border-0">
                                <h5 class="mb-0 fw-bold text-danger"><i class="fas fa-skull-crossbones me-2"></i>Strategic Termination</h5>
                            </div>
                            <div class="card-body p-5">
                                <div class="p-4 bg-faint-green rounded-5 mb-5 shadow-inner border border-faint">
                                    <h6 class="fw-bold text-dark-green mb-2">Root API Key Regeneration</h6>
                                    <p class="text-muted extra-small mb-4 fw-bold opacity-75">Invalidates all current external links. High impact action.</p>
                                    <button type="button" class="btn btn-dark-green rounded-pill px-5 py-3 fw-bold shadow-premium" onclick="generateApiKey()">
                                        <i class="fas fa-key me-2 text-accent-green"></i>Rotate Root Key
                                    </button>
                                </div>
                                
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
                                    <div class="max-w-500">
                                        <h6 class="text-danger fw-bold mb-1">Administrative Deactivation</h6>
                                        <p class="text-muted extra-small mb-0 fw-bold opacity-75">Lock platform access for this administrative entity. Requires physical server access to revert.</p>
                                    </div>
                                    <button type="button" class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow-premium" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                        Terminate Root Access
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5">
            <div class="modal-header border-0 p-5 pb-0">
                <h5 class="modal-title fw-bold text-danger">Root Identity Verification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-5 text-center">
                <div class="bg-soft-danger text-danger rounded-circle p-4 mb-4 d-inline-flex shadow-inner">
                    <i class="fas fa-user-shield fa-3x"></i>
                </div>
                <p class="fw-bold text-dark-green mb-4">Enter your master password to authorize platform access termination.</p>
                <form action="/Admin/DeleteAccount" method="post" id="deactivateForm">
                    @Html.AntiForgeryToken()
                    <input type="password" name="confirmPassword" class="form-control scm-input text-center" placeholder="MASTER PASSWORD" required />
                </form>
            </div>
            <div class="modal-footer border-0 p-5 pt-0">
                <button type="button" class="btn btn-white rounded-pill px-4 py-2 border fw-bold text-muted" data-bs-dismiss="modal">Abort</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="document.getElementById('deactivateForm').submit()">Authorize Termination</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .shadow-inner { box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        .uppercase { text-transform: uppercase; }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .scm-pills .nav-link { color: var(--dark-green); border: 1px solid transparent; opacity: 0.7; }
        .scm-pills .nav-link:hover { background-color: var(--faint-green); opacity: 1; }
        .scm-pills .nav-link.active { background-color: var(--dark-green); color: var(--accent-green); opacity: 1; box-shadow: 0 5px 15px rgba(26, 61, 49, 0.2); }

        .scm-input { 
            background-color: var(--faint-green); 
            border: 2px solid transparent; 
            border-radius: 100px; 
            padding: 0.8rem 1.5rem; 
            font-weight: 600; 
            color: var(--dark-green);
            transition: all 0.3s ease;
        }
        .scm-input:focus { 
            background-color: white; 
            border-color: var(--accent-green); 
            box-shadow: 0 5px 20px rgba(212, 240, 109, 0.15); 
            outline: none;
        }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        .btn-white { background: white; color: var(--dark-green); border: 1px solid #eee; }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; transform: translateY(-2px); }

        .fa-spin-slow { animation: fa-spin 10s infinite linear; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.05); color: #198754; }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; }
        
        .max-w-500 { max-width: 500px; }
        .object-fit-cover { object-fit: cover; }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Tab persistence
            var activeTab = localStorage.getItem('adminSettingsTab');
            if (activeTab) {
                var tab = new bootstrap.Tab(document.querySelector('#' + activeTab));
                tab.show();
            }

            $('button[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
                localStorage.setItem('adminSettingsTab', e.target.id);
            });
        });

        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('profileImagePreview');
                output.src = reader.result;
                toastr.info("Identity preview updated.");
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        function togglePassword(inputId) {
            var x = document.getElementById(inputId);
            x.type = x.type === "password" ? "text" : "password";
        }

        function verify2FA() {
            var pin = $('#pin2fa').val();
            if(!pin) return toastr.warning("Protocol code required.");
            
            $.post('/Admin/Verify2FA', { pin: pin, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                toastr.success("Identity verified. Re-syncing kernel...");
                setTimeout(() => location.reload(), 1000);
            }).fail(function() {
                toastr.error("Verification mismatch.");
            });
        }

        function revokeSession(id) {
            if(!confirm("Authorize termination of this link?")) return;
            $.post('/Admin/RevokeSession', { sessionId: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res) {
                if(res.success) {
                    toastr.success("Link terminated.");
                    setTimeout(()=>location.reload(), 1000);
                } else {
                    toastr.error(res.message);
                }
            });
        }

        function generateApiKey() {
            if(!confirm("Authorize rotation of Root API key?")) return;
            $.post('/Admin/GenerateApiKey', function(res) {
                if(res.success) {
                    prompt("CRITICAL: Save this key. It will not be shown again.", res.key);
                }
            });
        }
    </script>
}
