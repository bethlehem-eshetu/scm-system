@model IEnumerable<SCM_System.Models.Entities.EmailLog>
@{
    ViewData["Title"] = "Communication Audit Logs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px; background: linear-gradient(135deg, #37474f 0%, #263238 100%);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="fw-bold text-white mb-2"><i class="fas fa-envelope-open-text me-3"></i>Communication Audit</h2>
                        <p class="text-white text-opacity-75 mb-0">Full traceability of automated system notifications and verification emails.</p>
                    </div>
                    <div class="text-end text-white">
                        <div class="display-6 fw-bold">@Model.Count()</div>
                        <div class="small text-uppercase opacity-75">Logs Captured</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="emailSearch" class="form-control bg-light border-0" placeholder="Search by recipient, subject, or message...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="emailStatusFilter" class="form-select bg-light border-0">
                        <option value="">All Status</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Failed">Failed</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetEmailFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom px-4">
            <h5 class="mb-0 fw-bold"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Email Transmission History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="emailLogsTable">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="ps-4">Recipient</th>
                            <th>Subject</th>
                            <th>Sent At</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@log.To</div>
                                    <div class="text-muted small">ID: #@log.Id</div>
                                </td>
                                <td>
                                    <div class="fw-medium">@log.Subject</div>
                                </td>
                                <td>
                                    <div class="text-dark">@log.SentAt.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@log.SentAt.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    @if (log.IsSuccess)
                                    {
                                        <span class="badge bg-success-soft text-success rounded-pill px-3">
                                            <i class="fas fa-check-circle me-1"></i> Delivered
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-soft text-danger rounded-pill px-3" title="@log.ErrorMessage">
                                            <i class="fas fa-times-circle me-1"></i> Failed
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" 
                                            data-bs-toggle="modal" data-bs-target="#emailContentModal"
                                            data-subject="@log.Subject"
                                            data-to="@log.To"
                                            data-sentat="@log.SentAt.ToString("MMM dd, yyyy HH:mm:ss")"
                                            data-type="@log.Type"
                                            data-success="@log.IsSuccess.ToString().ToLower()"
                                            data-error="@log.ErrorMessage">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fas fa-history fa-3x text-muted opacity-25 mb-3"></i>
                                    <p class="text-muted mb-0">No communication logs recorded yet.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Email Content Modal -->
<div class="modal fade" id="emailContentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Email Details</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="card border-0 bg-light p-3 rounded-4 mb-3">
                    <div class="row mb-2">
                        <div class="col-sm-3 text-muted small fw-bold text-uppercase">Subject:</div>
                        <div class="col-sm-9 fw-bold text-dark" id="modalSubject"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3 text-muted small fw-bold text-uppercase">Recipient:</div>
                        <div class="col-sm-9 text-primary fw-medium" id="modalTo"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3 text-muted small fw-bold text-uppercase">Date Sent:</div>
                        <div class="col-sm-9" id="modalSentAt"></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3 text-muted small fw-bold text-uppercase">Category:</div>
                        <div class="col-sm-9"><span class="badge bg-secondary rounded-pill px-3" id="modalType"></span></div>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <div id="modalStatusIcon" class="me-3"></div>
                    <h6 class="mb-0 fw-bold" id="modalStatusText"></h6>
                </div>
                
                <div id="modalErrorContainer" class="alert alert-danger border-0 rounded-4 d-none mb-3">
                    <div class="fw-bold small text-uppercase mb-1"><i class="fas fa-exclamation-triangle me-1"></i>Error Details:</div>
                    <div id="modalErrorMessage" class="small font-monospace text-wrap" style="word-break: break-all;"></div>
                </div>
                
                <div class="alert alert-info border-0 rounded-4 small mb-0">
                    <i class="fas fa-info-circle me-2"></i><strong>Note:</strong> The system currently logs the metadata of outbound communications for audit purposes. Full HTML body content is not persisted to save storage space.
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal">Close Window</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: rgba(46, 125, 50, 0.1) !important; }
    .bg-danger-soft { background-color: rgba(211, 47, 47, 0.1) !important; }
    .table-hover tbody tr:hover { background-color: rgba(0,0,0,0.01); }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var emailModal = document.getElementById('emailContentModal');
        if (emailModal) {
            emailModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var subject = button.getAttribute('data-subject');
                var to = button.getAttribute('data-to');
                var sentat = button.getAttribute('data-sentat');
                var type = button.getAttribute('data-type');
                var success = button.getAttribute('data-success');
                var error = button.getAttribute('data-error');

                document.getElementById('modalSubject').textContent = subject;
                document.getElementById('modalTo').textContent = to;
                document.getElementById('modalSentAt').textContent = sentat;
                document.getElementById('modalType').textContent = type || 'General';

                var statusIcon = document.getElementById('modalStatusIcon');
                var statusText = document.getElementById('modalStatusText');
                var errorContainer = document.getElementById('modalErrorContainer');
                var errorMessage = document.getElementById('modalErrorMessage');

                if (success === 'true') {
                    statusIcon.innerHTML = '<i class="fas fa-check-circle fa-2x text-success"></i>';
                    statusText.textContent = 'Delivery Successful';
                    statusText.className = 'mb-0 fw-bold text-success';
                    errorContainer.classList.add('d-none');
                } else {
                    statusIcon.innerHTML = '<i class="fas fa-times-circle fa-2x text-danger"></i>';
                    statusText.textContent = 'Delivery Failed';
                    statusText.className = 'mb-0 fw-bold text-danger';
                    errorContainer.classList.remove('d-none');
                    errorMessage.textContent = error || 'Unknown error occurred during transmission.';
                }
            });
        }
    });
</script>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#emailSearch, #emailStatusFilter").on("keyup change", function() {
                var searchText = $("#emailSearch").val().toLowerCase();
                var status = $("#emailStatusFilter").val().toLowerCase();

                $("#emailLogsTable tbody tr").filter(function() {
                    var rowText = $(this).text().toLowerCase();
                    var rowStatus = $(this).find("td:nth-child(4)").text().toLowerCase();

                    var matchesSearch = rowText.indexOf(searchText) > -1;
                    var matchesStatus = status === "" || rowStatus.indexOf(status) > -1;

                    $(this).toggle(matchesSearch && matchesStatus);
                });
            });
        });

        function resetEmailFilters() {
            $("#emailSearch").val("");
            $("#emailStatusFilter").val("");
            $("#emailLogsTable tbody tr").show();
        }
    </script>
}
