@model IEnumerable<SCM_System.Models.Entities.EmailLog>
@{
    ViewData["Title"] = "Communication Audit Logs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px; background: linear-gradient(135deg, #37474f 0%, #263238 100%);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="fw-bold text-white mb-2"><i class="fas fa-envelope-open-text me-3"></i>Communication Audit</h2>
                        <p class="text-white text-opacity-75 mb-0">Full traceability of automated system notifications and verification emails.</p>
                    </div>
                    <div class="text-end text-white">
                        <div class="display-6 fw-bold">@Model.Count()</div>
                        <div class="small text-uppercase opacity-75">Logs Captured</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 20px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="ps-4">Recipient</th>
                            <th>Subject</th>
                            <th>Sent At</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@log.To</div>
                                    <div class="text-muted small">ID: #@log.Id</div>
                                </td>
                                <td>
                                    <div class="fw-medium">@log.Subject</div>
                                </td>
                                <td>
                                    <div class="text-dark">@log.SentAt.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@log.SentAt.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    @if (log.IsSuccess)
                                    {
                                        <span class="badge bg-success-soft text-success rounded-pill px-3">
                                            <i class="fas fa-check-circle me-1"></i> Delivered
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-soft text-danger rounded-pill px-3" title="@log.ErrorMessage">
                                            <i class="fas fa-times-circle me-1"></i> Failed
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" onclick="viewEmailContent(@log.Id)">
                                        <i class="fas fa-eye me-1"></i> View Content
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fas fa-history fa-3x text-muted opacity-25 mb-3"></i>
                                    <p class="text-muted mb-0">No communication logs recorded yet.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: rgba(46, 125, 50, 0.1) !important; }
    .bg-danger-soft { background-color: rgba(211, 47, 47, 0.1) !important; }
    .table-hover tbody tr:hover { background-color: rgba(0,0,0,0.01); }
</style>

<script>
    function viewEmailContent(id) {
        // In a real app, this would fetch content via AJAX and show a modal
        alert("Email content viewer for log #" + id + " would open here.");
    }
</script>
