@model IEnumerable<SCM_System.Models.Entities.Commission>
@{
    ViewData["Title"] = "Finance Control Tower";
    Layout = "_DashboardLayout";
    var grossSales = ViewBag.GrossSales ?? 0m;
    var platformRevenue = ViewBag.PlatformRevenue ?? 0m;
    var supplierPayables = ViewBag.SupplierPayables ?? 0m;
    var failedPayments = ViewBag.FailedPayments ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center fin-page-header">
        <div>
            <div class="fin-page-title">Finance Control Tower</div>
            <div class="fin-page-subtitle">Real-time marketplace revenue, settlements, and commission tracking.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportCommissions" class="fin-action-btn">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
            <a asp-action="Transactions" class="fin-action-btn primary">
                <i class="fas fa-exchange-alt"></i> All Transactions
            </a>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="finance-kpi-grid">
        <div class="fin-kpi-card">
            <i class="fas fa-shopping-cart fin-kpi-icon"></i>
            <div>
                <div class="fin-kpi-value">@grossSales.ToString("C0")</div>
                <div class="fin-kpi-label">Gross Sales (inc. VAT)</div>
                <div class="fin-kpi-trend positive"><i class="fas fa-arrow-up"></i> 12.5%</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #5B8FF9;">
            <i class="fas fa-hand-holding-usd fin-kpi-icon" style="color:#5B8FF9;"></i>
            <div>
                <div class="fin-kpi-value">@platformRevenue.ToString("C0")</div>
                <div class="fin-kpi-label">Platform Revenue</div>
                <div class="fin-kpi-trend positive"><i class="fas fa-arrow-up"></i> Target Met</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #E67E22;">
            <i class="fas fa-university fin-kpi-icon" style="color:#E67E22;"></i>
            <div>
                <div class="fin-kpi-value">@supplierPayables.ToString("C0")</div>
                <div class="fin-kpi-label">Supplier Payables</div>
                <div class="fin-kpi-trend neutral"><i class="fas fa-arrow-right"></i> Processing</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #E05A5A;">
            <i class="fas fa-exclamation-triangle fin-kpi-icon" style="color:#E05A5A;"></i>
            <div>
                <div class="fin-kpi-value">@failedPayments</div>
                <div class="fin-kpi-label">Failed Settlements</div>
                <div class="fin-kpi-trend @(failedPayments > 0 ? "negative" : "positive")">
                    @(failedPayments > 0 ? "Review Required" : "All Clear")
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Revenue Trend Chart -->
        <div class="col-lg-8">
            <div class="chart-wrapper h-100">
                <div class="chart-title">
                    <span><i class="fas fa-chart-line me-2" style="color:#2E9C7A;"></i>Revenue Trends</span>
                    <div class="d-flex gap-2">
                        <span class="type-pill active" style="cursor:pointer;">Weekly</span>
                        <span class="type-pill" style="cursor:pointer;">Monthly</span>
                    </div>
                </div>
                <canvas id="revenueTrendChart" style="height: 260px;"></canvas>
            </div>
        </div>
        <!-- Settlement Health -->
        <div class="col-lg-4">
            <div class="chart-wrapper h-100">
                <div class="chart-title">
                    <span><i class="fas fa-heartbeat me-2" style="color:#2E9C7A;"></i>Settlement Health</span>
                </div>
                <div style="max-width: 200px; margin: 0 auto 20px;">
                    <canvas id="statusPieChart"></canvas>
                </div>
                <div class="health-item">
                    <div class="health-label">Cleared Payments <span class="health-val">85%</span></div>
                    <div class="health-bar"><div class="health-fill" style="width:85%; background:#2E9C7A;"></div></div>
                </div>
                <div class="health-item">
                    <div class="health-label">Pending Payouts <span class="health-val">12%</span></div>
                    <div class="health-bar"><div class="health-fill" style="width:12%; background:#E67E22;"></div></div>
                </div>
                <div class="health-item" style="margin-bottom:0;">
                    <div class="health-label">Failed / Expired <span class="health-val">3%</span></div>
                    <div class="health-bar"><div class="health-fill" style="width:3%; background:#E05A5A;"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Top Suppliers + Recent Transactions -->
    <div class="row g-4">
        <!-- Top Earning Suppliers -->
        <div class="col-lg-4">
            <div class="fin-panel h-100">
                <div class="fin-panel-header">
                    <span class="fin-panel-title"><i class="fas fa-trophy me-2" style="color:#2E9C7A;"></i>Top Earning Suppliers</span>
                </div>
                @{
                    int rank = 1;
                    foreach (var supplier in (dynamic)ViewBag.TopSuppliers)
                    {
                        <div class="supplier-rank-item">
                            <div class="supplier-rank-num">#@rank</div>
                            <div>
                                <div class="supplier-rank-name">@supplier.Name</div>
                                <div class="supplier-rank-sub">Marketplace Partner</div>
                            </div>
                            <div class="supplier-rank-amount">@supplier.Revenue.ToString("C0")</div>
                        </div>
                        rank++;
                    }
                }
            </div>
        </div>
        <!-- Recent Commissions -->
        <div class="col-lg-8">
            <div class="fin-panel h-100">
                <div class="fin-panel-header">
                    <span class="fin-panel-title"><i class="fas fa-stream me-2" style="color:#2E9C7A;"></i>Recent Commission Activity</span>
                    <a asp-action="Transactions" class="fin-action-btn" style="font-size:13px; padding:7px 14px;">View All →</a>
                </div>
                <div class="table-responsive">
                    <table class="table admin-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Type</th>
                                <th>Supplier</th>
                                <th>Amount</th>
                                <th class="pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Take(8))
                            {
                                <tr>
                                    <td class="ps-4" style="color:var(--text-muted); font-size:13px; font-weight:700;">#@c.Id</td>
                                    <td>
                                        @if (c.PaymentType?.Contains("Order") == true) { <span class="txn-type txn-type-order">OrderPayment</span> }
                                        else if (c.PaymentType?.Contains("Commission") == true) { <span class="txn-type txn-type-commission">Commission</span> }
                                        else { <span class="txn-type txn-type-payout">Payout</span> }
                                    </td>
                                    <td style="color:var(--text-muted); font-size:13px;">@(c.Supplier?.CompanyName ?? "Platform")</td>
                                    <td style="font-weight:800; color:#2E9C7A;">@c.CommissionAmount.ToString("C")</td>
                                    <td class="pe-4">
                                        @if (c.Status == "Paid") { <span class="txn-status txn-status-paid"><i class="fas fa-check-circle"></i> Cleared</span> }
                                        else if (c.Status == "Pending") { <span class="txn-status txn-status-pending"><i class="fas fa-clock"></i> Pending</span> }
                                        else { <span class="txn-status txn-status-failed"><i class="fas fa-times-circle"></i> Failed</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const isDark = document.body.classList.contains('dark-mode');
        const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
        const labelColor = isDark ? '#9EABA5' : '#6F7E78';

        // Revenue Trend
        const tCtx = document.getElementById('revenueTrendChart').getContext('2d');
        const grad = tCtx.createLinearGradient(0, 0, 0, 300);
        grad.addColorStop(0, 'rgba(46,156,122,0.25)');
        grad.addColorStop(1, 'rgba(46,156,122,0)');
        new Chart(tCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.TrendLabels)),
                datasets: [{
                    label: 'Platform Revenue',
                    data: @Html.Raw(Json.Serialize(ViewBag.TrendAmounts)),
                    borderColor: '#2E9C7A',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: grad,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#2E9C7A',
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: labelColor } },
                    x: { grid: { display: false }, ticks: { color: labelColor } }
                }
            }
        });

        // Settlement Donut
        const sCtx = document.getElementById('statusPieChart').getContext('2d');
        new Chart(sCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.StatusLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.StatusCounts)),
                    backgroundColor: ['#2E9C7A', '#E67E22', '#E05A5A', '#5B8FF9'],
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                cutout: '72%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16, color: labelColor }
                    }
                }
            }
        });
    </script>
}
