@model IEnumerable<SCM_System.Models.Entities.Commission>
@{
    ViewData["Title"] = "Finance Control Tower";
    Layout = "_DashboardLayout";

    // KPI mapping
    var grossSales = ViewBag.GrossSales ?? 0m;
    var platformRevenue = ViewBag.PlatformRevenue ?? 0m;
    var supplierPayables = ViewBag.SupplierPayables ?? 0m;
    var failedPayments = ViewBag.FailedPayments ?? 0;
}

<!-- Premium Finance Header -->
<div class="container-fluid py-4 min-vh-100 bg-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Finance Control Tower</h1>
            <p class="text-muted small mb-0">Real-time marketplace revenue, settlements, and commission tracking.</p>
        </div>
        <div class="d-flex gap-3">
            <div class="dropdown">
                <button class="btn btn-white shadow-sm border rounded-pill px-4 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download me-2 text-primary"></i>Export Report
                </button>
                <ul class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" href="#" onclick="handlePdfExport()"><i class="fas fa-file-pdf me-2 text-danger"></i>PDF Report</a></li>
                    <li><a class="dropdown-item" asp-action="ExportCommissions"><i class="fas fa-file-excel me-2 text-success"></i>Excel Ledger</a></li>
                </ul>
            </div>
            <button class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-sync me-2"></i>Sync Payouts
            </button>
        </div>
    </div>

    <!-- Tier 1 KPIs: Global Liquidity -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-primary h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">+12.5%</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Gross Sales (inc. VAT)</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.GrossSales.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-success h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-hand-holding-usd fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Target Met</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Platform Revenue</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.PlatformRevenue.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-info h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-university fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Processing</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Supplier Payables</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.SupplierPayables.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-danger h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-exclamation-triangle fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Review Required</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Failed Settlements</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.FailedPayments</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Intelligence Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Marketplace Revenue Dynamics</h5>
                    <div class="btn-group btn-group-sm rounded-pill overflow-hidden border">
                        <button class="btn btn-light active">Revenue</button>
                        <button class="btn btn-light">Volume</button>
                    </div>
                </div>
                <div class="card-body p-4">
                    <canvas id="revenueTrendChart" style="min-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">Settlement Health</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                    <div style="max-width: 250px; width: 100%;">
                        <canvas id="statusPieChart"></canvas>
                    </div>
                    <div class="mt-4 w-100">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Cleared Payments</span>
                            <span class="fw-bold">85%</span>
                        </div>
                        <div class="progress rounded-pill mb-3" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: 85%"></div>
                        </div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Pending Payouts</span>
                            <span class="fw-bold">12%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 6px;">
                            <div class="progress-bar bg-warning" style="width: 12%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lower Intelligence: Top Suppliers & Alerts -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="min-height: 400px; max-height: 400px; overflow-y: auto;">
                <div class="card-header bg-white py-3 border-0 border-bottom sticky-top">
                    <h5 class="fw-bold mb-0">Top Earning Suppliers</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var supplier in (dynamic)ViewBag.TopSuppliers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3">
                                        <i class="fas fa-store"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@supplier.Name</h6>
                                        <small class="text-muted">Marketplace Leader</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-success">+@supplier.Revenue.ToString("C0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
             <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="min-height: 400px; max-height: 400px; overflow-y: auto;">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom sticky-top flex-wrap gap-3">
                    <h5 class="fw-bold mb-0 text-dark">Global Transaction Stream</h5>
                    <div class="d-flex gap-3 align-items-center">
                        <div class="btn-group btn-group-sm rounded-pill overflow-hidden border">
                            <button class="btn btn-light px-3 admin-filter active" data-status="all">All</button>
                            <button class="btn btn-light px-3 admin-filter" data-status="Paid">Cleared</button>
                            <button class="btn btn-light px-3 admin-filter" data-status="Pending">Pending</button>
                        </div>
                        <div class="search-mini position-relative">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted extra-small"></i>
                            <input type="text" id="adminTransSearch" class="form-control form-control-sm border-0 bg-light rounded-pill ps-5" placeholder="Search ledger..." style="width: 180px;">
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 text-muted small fw-bold">TRANSACTION</th>
                                <th class="text-muted small fw-bold">SUPPLIER</th>
                                <th class="text-muted small fw-bold">AMOUNT</th>
                                <th class="text-muted small fw-bold text-center">STATUS</th>
                                <th class="text-muted small fw-bold text-end pe-4">ACTIVITY</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Take(10))
                            {
                                <tr class="admin-trans-row" data-status="@c.Status">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@c.PaymentType</div>
                                        <small class="text-muted">ID: #@c.Id | @c.CreatedAt.ToString("MMM dd HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-secondary bg-opacity-10 rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-briefcase small text-secondary"></i>
                                            </div>
                                            <span>@(c.Supplier?.CompanyName ?? "Platform")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(c.PaymentType == "PlatformCommission" ? "text-success" : (c.PaymentType == "SupplierPayout" ? "text-primary" : "text-dark"))">
                                            @c.CommissionAmount.ToString("C")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (c.Status == "Paid") { <span class="badge bg-success bg-opacity-20 text-success rounded-pill px-3">Cleared</span> }
                                        else if (c.Status == "Pending") { <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">Pending</span> }
                                        else { <span class="badge bg-danger bg-opacity-20 text-danger rounded-pill px-3">Failed</span> }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="small">@(c.Status == "Paid" ? "Success" : "In Pipeline")</div>
                                        <div class="extra-small text-muted">@c.Notes</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Filtration Logic
        $('.admin-filter').click(function() {
            var status = $(this).data('status');
            $('.admin-filter').removeClass('active btn-primary text-white').addClass('btn-light');
            $(this).removeClass('btn-light').addClass('active btn-primary text-white');

            if (status === 'all') {
                $('.admin-trans-row').fadeIn();
            } else {
                $('.admin-trans-row').hide();
                $('.admin-trans-row[data-status="' + status + '"]').fadeIn();
            }
        });

        // Search Logic
        $('#adminTransSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.admin-trans-row').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        function handlePdfExport() {
            window.print();
        }

        // Set default font family for Chart.js
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Revenue Trend Chart
        const trendCtx = document.getElementById('revenueTrendChart').getContext('2d');
        const gradient = trendCtx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(78, 115, 223, 0.2)');
        gradient.addColorStop(1, 'rgba(78, 115, 223, 0)');

        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.TrendLabels)),
                datasets: [{
                    label: 'Platform Commission',
                    data: @Html.Raw(Json.Serialize(ViewBag.TrendAmounts)),
                    borderColor: '#4e73df',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: gradient,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#4e73df',
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [5, 5], drawBorder: false }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Status Pie Chart
        const statusCtx = document.getElementById('statusPieChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.StatusLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.StatusCounts)),
                    backgroundColor: ['#1cc88a', '#f6c23e', '#e74a3b', '#4e73df'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                cutout: '75%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 20 }
                    }
                }
            }
        });
    </script>
}

<style>
    .bg-gradient-primary { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
    .bg-gradient-success { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); }
    .bg-gradient-info { background: linear-gradient(135deg, #36b9cc 0%, #258391 100%); }
    .bg-gradient-danger { background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%); }
    
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
    
    .extra-small { font-size: 0.75rem; }
    
    .badge { font-weight: 600; }

    @@media print {
        .btn, .dropdown, .sidebar, .navbar, .btn-group, .sticky-top {
            display: none !important;
        }
        .container-fluid {
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            background: white !important;
        }
        .card {
            border: 1px solid #eee !important;
            box-shadow: none !important;
            break-inside: avoid;
            transform: none !important;
        }
        .bg-gradient-primary, .bg-gradient-success, .bg-gradient-info, .bg-gradient-danger {
            background: transparent !important;
            color: black !important;
            border: 1px solid #ccc !important;
        }
        .text-white { color: black !important; }
        .opacity-75 { opacity: 1 !important; }
        canvas { max-width: 100% !important; height: auto !important; }
        .min-vh-100 { min-height: auto !important; }
    }
</style>
