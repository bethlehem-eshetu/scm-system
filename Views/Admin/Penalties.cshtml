@model List<SCM_System.Models.Entities.Penalty>

@{
    ViewData["Title"] = "Penalty Management";
    Layout = "_DashboardLayout";
    var pendingAppeals = Model.Where(p => p.HasAppealed && string.IsNullOrEmpty(p.AppealResponse)).ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-gavel text-danger me-2"></i>Penalty Management
        </h1>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Total Penalties</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="fas fa-gavel fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Active Penalties</h6>
                            <h3 class="mb-0">@ViewBag.ActivePenaltiesCount</h3>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Suspended Users</h6>
                            <h3 class="mb-0">@Model.Count(p => p.PenaltyType == "Account Suspension" && p.IsActive && (!p.ExpiresAt.HasValue || p.ExpiresAt > DateTime.Now))</h3>
                        </div>
                        <i class="fas fa-ban fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white opacity-75 fw-bold mb-2">Pending Appeals</h6>
                            <h3 class="mb-0">@pendingAppeals.Count</h3>
                        </div>
                        <i class="fas fa-file-signature fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="penaltySearch" class="form-control bg-light border-0" placeholder="Search user or reason...">
                    </div>
                </div>
                <div class="col-md-2">
                    <select id="penaltyRoleFilter" class="form-select bg-light border-0">
                        <option value="">All Roles</option>
                        <option value="Supplier">Supplier</option>
                        <option value="Retailer">Retailer</option>
                        <option value="Buyer">Buyer</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="penaltyTypeFilter" class="form-select bg-light border-0">
                        <option value="">All Penalty Types</option>
                        <option value="Warning">⚠️ Warning</option>
                        <option value="Message Restriction">📨 Message Restriction</option>
                        <option value="Account Suspension">🚫 Account Suspension</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select id="penaltyStatusFilter" class="form-select bg-light border-0">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetPenaltyFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- All Penalties Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-list me-2 text-primary"></i>All Penalties
                <span id="filteredCount" class="badge bg-secondary ms-2">@Model.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No penalties found</h5>
                    <p class="text-muted">All users are following platform guidelines</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="penaltiesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>User</th>
                                <th>Role</th>
                                <th>Penalty Type</th>
                                <th>Reason</th>
                                <th>Date</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Appeal</th>
                                <th class="pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var penalty in Model)
                            {
                                bool isExpired = penalty.ExpiresAt.HasValue && penalty.ExpiresAt.Value < DateTime.Now;
                                bool isActive = penalty.IsActive && !isExpired;
                                
                                <tr data-user-name="@(penalty.User?.FullName?.ToLower() ?? "")"
                                    data-user-role="@(penalty.User?.Role ?? "")"
                                    data-penalty-type="@penalty.PenaltyType"
                                    data-status="@(isActive ? "active" : "expired")"
                                    data-reason="@(penalty.Reason?.ToLower() ?? "")">
                                    <td class="ps-4">#@penalty.Id</td>
                                    <td>
                                        <strong>@(penalty.User?.FullName ?? "Unknown")</strong>
                                        <br>
                                        <small class="text-muted">ID: @penalty.UserId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(penalty.User?.Role == "Supplier" ? "primary" : penalty.User?.Role == "Retailer" ? "info" : "secondary")">
                                            @(penalty.User?.Role ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        @if (penalty.PenaltyType == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">⚠️ Warning</span>
                                        }
                                        else if (penalty.PenaltyType == "Message Restriction")
                                        {
                                            <span class="badge bg-info">📨 Restricted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">🚫 Suspended</span>
                                        }
                                    </td>
                                    <td>
                                        <span title="@penalty.Reason">
                                            @(penalty.Reason != null && penalty.Reason.Length > 50 ? penalty.Reason.Substring(0, 50) + "..." : penalty.Reason)
                                        </span>
                                    </td>
                                    <td>@penalty.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (penalty.ExpiresAt.HasValue)
                                        {
                                            @penalty.ExpiresAt.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-danger">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                    </td>
                                    <td>
                                        @if (penalty.HasAppealed)
                                        {
                                            if (!string.IsNullOrEmpty(penalty.AppealResponse))
                                            {
                                                <span class="badge bg-info">Reviewed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending Review</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No appeal</span>
                                        }
                                    </td>
                                    <td class="pe-4">
                                        <div class="btn-group btn-group-sm">
                                            @if (penalty.HasAppealed && string.IsNullOrEmpty(penalty.AppealResponse))
                                            {
                                                <button class="btn btn-primary me-1"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#appealModal"
                                                        data-penalty-id="@penalty.Id"
                                                        data-appeal-reason="@penalty.AppealReason"
                                                        title="Review Appeal">
                                                    <i class="fas fa-gavel"></i> Review
                                                </button>
                                            }
                                            <a asp-action="UserPenalties" asp-route-userId="@penalty.UserId"
                                                   class="btn btn-outline-info" title="View all penalties for this user">
                                                <i class="fas fa-history"></i>
                                            </a>
                                            @if (isActive && !penalty.HasAppealed)
                                            {
                                                <button class="btn btn-outline-success"
                                                        onclick="clearPenalty(@penalty.Id)" title="Clear penalty">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Appeal Review Modal -->
<div class="modal fade" id="appealModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-gavel me-2"></i>Review Appeal
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResolveAppeal" method="post">
                <div class="modal-body">
                    <input type="hidden" name="penaltyId" id="appealPenaltyId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">User's Appeal Reason</label>
                        <div class="alert alert-info">
                            <i class="fas fa-quote-left me-2"></i>
                            <span id="appealReasonText"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Response</label>
                        <textarea name="response" class="form-control" rows="4" required
                                  placeholder="Explain your decision to the user..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Decision</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="approve" value="true" id="approveYes">
                                <label class="form-check-label text-success" for="approveYes">
                                    <i class="fas fa-check-circle me-1"></i> Approve - Remove Penalty
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="approve" value="false" id="approveNo" checked>
                                <label class="form-check-label text-danger" for="approveNo">
                                    <i class="fas fa-times-circle me-1"></i> Deny - Keep Penalty
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Clear penalty function
        function clearPenalty(penaltyId) {
        if (confirm('Are you sure you want to clear this penalty? It will be marked as expired.')) {
        $.post('@Url.Action("ClearPenalty", "Admin")', { penaltyId: penaltyId }, function(result) {
        if (result.success) {
        location.reload();
        } else {
        alert('Error: ' + result.message);
        }
        });
        }
        }

        // Appeal modal handling
        var appealModal = document.getElementById('appealModal');
        if (appealModal) {
        appealModal.addEventListener('show.bs.modal', function(event) {
        var button = event.relatedTarget;
        var penaltyId = button.getAttribute('data-penalty-id');
        var appealReason = button.getAttribute('data-appeal-reason');
                
        document.getElementById('appealPenaltyId').value = penaltyId;
        document.getElementById('appealReasonText').innerText = appealReason || 'No reason provided';
        });
        }

        // Filtering functionality
        $(document).ready(function() {
        function applyFilters() {
        var searchText = $("#penaltySearch").val().toLowerCase().trim();
        var role = $("#penaltyRoleFilter").val().toLowerCase();
        var type = $("#penaltyTypeFilter").val().toLowerCase();
        var status = $("#penaltyStatusFilter").val().toLowerCase();
                
        var visibleCount = 0;
                
        $("#penaltiesTable tbody tr").each(function() {
        var $row = $(this);
                    
        // Get row data
        var userName = $row.attr("data-user-name") || "";
        var userRole = ($row.attr("data-user-role") || "").toLowerCase();
        var penaltyType = ($row.attr("data-penalty-type") || "").toLowerCase();
        var rowStatus = ($row.attr("data-status") || "").toLowerCase();
        var reason = $row.attr("data-reason") || "";
                    
        // Check search (name or reason)
        var matchesSearch = searchText === "" ||
        userName.indexOf(searchText) > -1 ||
        reason.indexOf(searchText) > -1;
                    
        // Check role filter
        var matchesRole = role === "" || userRole === role;
                    
        // Check type filter
        var matchesType = type === "" || penaltyType.toLowerCase().indexOf(type) > -1;
                    
        // Check status filter
        var matchesStatus = status === "" || rowStatus === status;
                    
        var isVisible = matchesSearch && matchesRole && matchesType && matchesStatus;
                    
        if (isVisible) {
        $row.show();
        visibleCount++;
        } else {
        $row.hide();
        }
        });
                
        // Update filtered count
        $("#filteredCount").text(visibleCount);
                
        // Show/hide "no results" message
        if (visibleCount === 0) {
        if ($("#noResultsRow").length === 0) {
        $("#penaltiesTable tbody").append(
        '<tr id="noResultsRow"><td colspan="10" class="text-center py-5">' +
        '<i class="fas fa-search fa-3x text-muted mb-3"></i>' +
        '<h5 class="text-muted">No matching penalties found</h5>' +
        '<p class="text-muted">Try adjusting your filters</p></td></tr>'
        );
        }
        } else {
        $("#noResultsRow").remove();
        }
        }
            
        // Bind filter events
        $("#penaltySearch, #penaltyRoleFilter, #penaltyTypeFilter, #penaltyStatusFilter").on("keyup change", function() {
        applyFilters();
        });
            
        // Initial filter count
        applyFilters();
        });
        
        // Reset all filters
        function resetPenaltyFilters() {
        $("#penaltySearch").val("");
        $("#penaltyRoleFilter").val("");
        $("#penaltyTypeFilter").val("");
        $("#penaltyStatusFilter").val("");
            
        // Trigger the filter to show all rows
        $("#penaltySearch").trigger("keyup");
        }
    </script>
}