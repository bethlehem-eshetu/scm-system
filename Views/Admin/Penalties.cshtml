@model List<SCM_System.Models.Entities.Penalty>

@{
    ViewData["Title"] = "Penalty Management";
    Layout = "_DashboardLayout";
    var pendingAppeals = Model.Where(p => p.HasAppealed && string.IsNullOrEmpty(p.AppealResponse)).ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-gavel text-danger me-2"></i>Penalty Management
        </h1>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Total Penalties</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="fas fa-gavel fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Active Penalties</h6>
                            <h3 class="mb-0">@ViewBag.ActivePenaltiesCount</h3>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Suspended Users</h6>
                            <h3 class="mb-0">@Model.Count(p => p.PenaltyType == "Account Suspension" && p.IsActive)</h3>
                        </div>
                        <i class="fas fa-ban fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Pending Appeals</h6>
                            <h3 class="mb-0">@pendingAppeals.Count</h3>
                        </div>
                        <i class="fas fa-file-signature fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Appeals Section -->
    @if (pendingAppeals.Any())
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning bg-opacity-10 py-3">
                <h5 class="mb-0 text-warning">
                    <i class="fas fa-file-signature me-2"></i>Pending Appeals - Action Required
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Role</th>
                                <th>Penalty Type</th>
                                <th>Original Reason</th>
                                <th>Appeal Reason</th>
                                <th>Appeal Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var penalty in pendingAppeals)
                            {
                                <tr>
                                    <td>#@penalty.Id</td>
                                    <td>
                                        <strong>@(penalty.User?.FullName ?? "Unknown")</strong>
                                        <br>
                                        <small class="text-muted">ID: @penalty.UserId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(penalty.User?.Role == "Supplier" ? "primary" : "info")">
                                            @(penalty.User?.Role ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        @if (penalty.PenaltyType == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">Warning</span>
                                        }
                                        else if (penalty.PenaltyType == "Message Restriction")
                                        {
                                            <span class="badge bg-info">Restricted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Suspended</span>
                                        }
                                    </td>
                                    <td>@penalty.Reason</td>
                                    <td>
                                        <div style="max-width: 300px;">
                                            <small class="text-muted">@penalty.AppealReason</small>
                                        </div>
                                    </td>
                                    <td>@penalty.AppealDate?.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary"
                                                onclick="showAppealModal(@penalty.Id, '@(penalty.AppealReason?.Replace("'", "\\'") ?? "")')">
                                            <i class="fas fa-gavel me-1"></i>Review Appeal
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- All Penalties Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-list me-2 text-primary"></i>All Penalties
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No penalties found</h5>
                    <p class="text-muted">All users are following platform guidelines</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Role</th>
                                <th>Penalty Type</th>
                                <th>Reason</th>
                                <th>Date</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Appeal</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var penalty in Model)
                            {
                                bool isExpired = penalty.ExpiresAt.HasValue && penalty.ExpiresAt.Value < DateTime.Now;
                                bool isActive = penalty.IsActive && !isExpired;
                                
                                <tr>
                                    <td>#@penalty.Id</td>
                                    <td>
                                        <strong>@(penalty.User?.FullName ?? "Unknown")</strong>
                                        <br>
                                        <small class="text-muted">ID: @penalty.UserId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(penalty.User?.Role == "Supplier" ? "primary" : "info")">
                                            @(penalty.User?.Role ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        @if (penalty.PenaltyType == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">Warning</span>
                                        }
                                        else if (penalty.PenaltyType == "Message Restriction")
                                        {
                                            <span class="badge bg-info">Restricted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Suspended</span>
                                        }
                                    </td>
                                    <td>
                                        <span title="@penalty.Reason">
                                            @(penalty.Reason.Length > 50 ? penalty.Reason.Substring(0, 50) + "..." : penalty.Reason)
                                        </span>
                                    </td>
                                    <td>@penalty.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (penalty.ExpiresAt.HasValue)
                                        {
                                            @penalty.ExpiresAt.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-danger">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                    </td>
                                    <td>
                                        @if (penalty.HasAppealed)
                                        {
                                            if (!string.IsNullOrEmpty(penalty.AppealResponse))
                                            {
                                                <span class="badge bg-info">Appeal @(string.IsNullOrEmpty(penalty.AppealResponse) ? "Pending" : "Reviewed")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Appeal Pending</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No appeal</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="UserPenalties" asp-route-userId="@penalty.UserId"
                                                   class="btn btn-outline-info" title="View all penalties for this user">
                                                <i class="fas fa-history"></i>
                                            </a>
                                            @if (isActive && !penalty.HasAppealed)
                                            {
                                                <button class="btn btn-outline-success"
                                                        onclick="clearPenalty(@penalty.Id)" title="Clear penalty">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Appeal Review Modal -->
<div class="modal fade" id="appealModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-gavel me-2"></i>Review Appeal
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResolveAppeal" method="post">
                <div class="modal-body">
                    <input type="hidden" name="penaltyId" id="appealPenaltyId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">User's Appeal Reason</label>
                        <div class="alert alert-info">
                            <i class="fas fa-quote-left me-2"></i>
                            <span id="appealReasonText"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Response</label>
                        <textarea name="response" class="form-control" rows="4" required
                                  placeholder="Explain your decision to the user..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Decision</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="approve" value="true" id="approveYes">
                                <label class="form-check-label text-success" for="approveYes">
                                    <i class="fas fa-check-circle me-1"></i> Approve - Remove Penalty
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="approve" value="false" id="approveNo" checked>
                                <label class="form-check-label text-danger" for="approveNo">
                                    <i class="fas fa-times-circle me-1"></i> Deny - Keep Penalty
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearPenalty(penaltyId) {
            if (confirm('Are you sure you want to clear this penalty? It will be marked as expired.')) {
                $.post('@Url.Action("ClearPenalty", "Admin")', { penaltyId: penaltyId }, function(result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                });
            }
        }

        function showAppealModal(penaltyId, appealReason) {
            document.getElementById('appealPenaltyId').value = penaltyId;
            document.getElementById('appealReasonText').innerText = appealReason;
            new bootstrap.Modal(document.getElementById('appealModal')).show();
        }
    </script>
}