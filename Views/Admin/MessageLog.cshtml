@model List<SCM_System.Models.ViewModels.AdminMessageViewModel>

@{
    ViewData["Title"] = "Message Monitoring";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5">
    <!-- Header Section -->
    <div class="section-header mb-2">
        <div class="section-title">
            <i class="fas fa-gem"></i>
            <span>Message Monitoring</span>
        </div>
        <div class="section-underline"></div>
    </div>
    <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 15px;">Track and monitor all communications across the platform.</p>

    <!-- Custom KPI Grid -->
    <style>
        .kpi-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }
        @@media (max-width: 992px) {
            .kpi-grid-3 { grid-template-columns: 1fr; }
        }
        .admin-kpi-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 16px 20px;
            border-top: 3px solid #2E9C7A;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border-bottom: 1px solid var(--border-color);
            border-left: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            transition: transform 0.2s ease, box-shadow 0.2s;
            position: relative;
        }
        .admin-kpi-card:hover {
            transform: translateY(-2px);
        }
        .dark-mode .admin-kpi-card { box-shadow: none; }
        .kpi-icon {
            font-size: 28px;
            color: #2E9C7A;
            position: absolute;
            top: 20px;
            left: 20px;
        }
        .dark-mode .kpi-icon { color: #4BC0A0; }
        .kpi-title {
            text-align: right;
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        .kpi-number {
            text-align: right;
            font-size: 28px;
            font-weight: 700;
            color: var(--text-color);
            line-height: 1;
        }
    </style>

    <div class="kpi-grid-3">
        <div class="admin-kpi-card">
            <i class="fas fa-comment-dots kpi-icon"></i>
            <div class="kpi-title">Total Messages</div>
            <div class="kpi-number">@(ViewBag.TotalMessagesCount ?? 0)</div>
        </div>
        <div class="admin-kpi-card">
            <i class="fas fa-ban kpi-icon" style="color: #E05A5A;"></i>
            <div class="kpi-title">Blocked Violations</div>
            <div class="kpi-number">@(ViewBag.BlockedMessagesCount ?? 0)</div>
        </div>
        <div class="admin-kpi-card">
            <i class="fas fa-gavel kpi-icon" style="color: #E67E22;"></i>
            <div class="kpi-title">Active Penalties</div>
            <div class="kpi-number">@(ViewBag.ActivePenaltiesCount ?? 0)</div>
        </div>
    </div>

    <!-- Page Search & Filters -->
    <div class="page-search-section">
        <div class="search-input-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" id="liveSearch" placeholder="Search by sender name or content keyword..." class="page-search-input">
        </div>
        <div class="filter-group">
            <div class="d-flex gap-2">
                <button class="chip active" onclick="setDateFilter('all', this)">All Time</button>
                <button class="chip" onclick="setDateFilter('today', this)">Today</button>
                <button class="chip" onclick="setDateFilter('last7days', this)">This Week</button>
                <button class="chip" onclick="setDateFilter('last30days', this)">This Month</button>
            </div>
            <select id="liveSenderRole" class="filter-dropdown ms-2">
                <option value="">All Roles</option>
                <option value="Supplier">Supplier</option>
                <option value="Retailer">Retailer</option>
            </select>
            <button class="btn btn-outline-card px-3" style="border-radius: 8px; font-weight: 600;" onclick="resetLiveFilters()">Reset</button>
        </div>
    </div>

    <!-- Table Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 fw-bold" style="color: var(--text-color); font-size: 16px;">Recent Conversations <span id="filteredCount" class="badge-soft badge-soft-info ms-2">@Model.Count results</span></h6>
        <div class="action-buttons">
            <button class="btn btn-sm btn-outline-card fw-bold px-3 py-2" style="border-radius: 8px;" onclick="exportToCSV()"><i class="fas fa-download me-1"></i> Export CSV</button>
            <button class="btn btn-sm btn-outline-card fw-bold px-3 py-2" style="border-radius: 8px;" onclick="window.print()"><i class="fas fa-print me-1"></i> Print</button>
        </div>
    </div>
    <div class="table-container text-nowrap" style="overflow-x: auto;">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-envelope-open text-muted opacity-25"></i>
                <h4 style="color: var(--text-color);">No messages generated yet</h4>
                <p>Tracked communications will appear here once initiated.</p>
            </div>
        }
        else
        {
            <table class="admin-table table-hover" id="messagesTable" style="min-width: 900px;">
                <thead>
                    <tr>
                        <th style="cursor: pointer;" onclick="sortTable(0)">Time <i class="fas fa-sort ms-1"></i></th>
                        <th style="cursor: pointer;" onclick="sortTable(1)">Sender <i class="fas fa-sort ms-1"></i></th>
                        <th>Role</th>
                        <th>Between</th>
                        <th>Message Preview</th>
                        <th>Flag</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                            <tr data-sender-name="@msg.SenderName.ToLower()"
                                data-sender-role="@msg.SenderRole"
                                data-conversation="@msg.ConversationBetween.ToLower()"
                                data-content="@msg.Content.ToLower()"
                                data-date="@msg.SentAt.ToString("yyyy-MM-dd")">
                                <td>
                                    <div class="fw-bold" style="color: var(--text-color); font-size: 13px;">@msg.TimeAgo</div>
                                    <div style="color: var(--text-muted); font-size: 12px;">@msg.SentAt.ToString("MMM dd, HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold" style="color: var(--text-color); font-size: 13px;">@msg.SenderName</div>
                                    @if (!string.IsNullOrEmpty(msg.SenderEmail))
                                    {
                                        <div style="color: var(--text-muted); font-size: 12px;">@msg.SenderEmail</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge-soft @(msg.SenderRole == "Supplier" ? "badge-soft-success" : msg.SenderRole == "Retailer" ? "badge-soft-info" : "badge-soft-warning")">
                                        @msg.SenderRole
                                    </span>
                                </td>
                                <td><div style="color: var(--text-muted); font-size: 13px;">@msg.ConversationBetween</div></td>
                                <td>
                                    <div class="message-preview" data-full-message="@Html.Raw(msg.Content?.Replace("\"", "&quot;"))">
                                        <span style="color: var(--text-color); font-size: 13px;">@(msg.Content?.Length > 40 ? msg.Content.Substring(0, 40) + "..." : msg.Content)</span>
                                        @if ((msg.Content?.Length ?? 0) > 40)
                                        {
                                            <a href="#" style="color: #2E9C7A; font-size: 11px; font-weight: 700; text-decoration: none;" onclick="showFullMessage(this); return false;">EXPAND</a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (msg.ContainsFlaggedWords)
                                    {
                                        <span class="badge-soft badge-soft-danger"><i class="fas fa-exclamation-triangle"></i> Flagged</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="action-buttons justify-content-end">
                                        <a asp-action="ViewConversation" asp-route-id="@msg.ConversationId" class="btn btn-sm btn-outline-card" style="border-radius: 8px;">
                                            <i class="fas fa-eye text-primary me-1"></i> View
                                        </a>
                                        @if(msg.ContainsFlaggedWords)
                                        {
                                            <button class="btn btn-sm" style="border-radius: 8px; background: rgba(220, 38, 38, 0.1); color: #DC2626; border: 1px solid rgba(220, 38, 38, 0.2);" title="Mark Resolved">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                </tr>
                            }
                        </tbody>
            </table>
        }

        <!-- No results message -->
        <div id="noResultsMessage" class="empty-state" style="display: none;">
            <i class="fas fa-search text-muted opacity-25"></i>
            <h4 style="color: var(--text-color);">No matching messages found</h4>
            <p>Try adjusting your search query or filters to see more results.</p>
            <button class="btn btn-outline-card fw-bold px-4" onclick="resetLiveFilters()">Clear Filters</button>
        </div>
    </div>
</div>

<!-- Full Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Full Message Content</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p id="fullMessageText" class="text-muted lh-base mb-0"></p>
            </div>
            <div class="modal-footer border-top-0 pb-4 px-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Global date Filter Variable
        var activeDateFilter = "all";

        function setDateFilter(filterVal, element) {
            $('.chip').removeClass('active');
            $(element).addClass('active');
            activeDateFilter = filterVal;
            applyLiveFilters();
        }

        $(document).ready(function() {
            // Live filtering on inputs
            $("#liveSearch, #liveSenderRole").on("keyup change", function() {
                applyLiveFilters();
            });
            
            // Initial filter application
            applyLiveFilters();
        });
        
        function applyLiveFilters() {
            var quickSearch = $("#liveSearch").val().toLowerCase().trim();
            var senderRole = $("#liveSenderRole").val();
            var dateFilter = activeDateFilter;
            
        var visibleCount = 0;
        var today = new Date();
        today.setHours(0, 0, 0, 0);
            
        $("#messagesTable tbody tr").each(function() {
        var $row = $(this);
        var showRow = true;
                
        // Get row data
        var rowSenderName = $row.attr("data-sender-name") || "";
        var rowSenderRole = $row.attr("data-sender-role") || "";
        var rowContent = $row.attr("data-content") || "";
        var rowDate = $row.attr("data-date") || "";
        var rowConversation = $row.attr("data-conversation") || "";
        var rowFullText = rowSenderName + " " + rowContent + " " + rowConversation;
                
        // Filter by quick search (searches everything)
        if (showRow && quickSearch && rowFullText.indexOf(quickSearch) === -1) {
            showRow = false;
        }
                
        // Filter by date range
        if (showRow && dateFilter !== "all") {
        var rowDateObj = new Date(rowDate);
        var isMatch = false;
                    
        switch(dateFilter) {
        case "today":
        isMatch = rowDate === today.toISOString().split('T')[0];
        break;
        case "yesterday":
        var yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        isMatch = rowDate === yesterday.toISOString().split('T')[0];
        break;
        case "last7days":
        var sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
        isMatch = rowDateObj >= sevenDaysAgo;
        break;
        case "last30days":
        var thirtyDaysAgo = new Date(today);
        thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
        isMatch = rowDateObj >= thirtyDaysAgo;
        break;
        }
                    
        if (!isMatch) showRow = false;
        }
                
        // Show/hide row
        if (showRow) {
        $row.show();
        visibleCount++;
        } else {
        $row.hide();
        }
        });
            
        // Update filtered count
        $("#filteredCount").text(visibleCount + " results");
            
        // Show/hide no results message
        if (visibleCount === 0) {
        $("#noResultsMessage").show();
        } else {
        $("#noResultsMessage").hide();
        }
        }
        
        function resetLiveFilters() {
            $("#liveSearch").val("");
            $("#liveSenderRole").val("");
            setDateFilter("all", $('.chip:first-child'));
        }
        
        function showFullMessage(element) {
        const previewDiv = element.closest('.message-preview');
        const fullMessage = previewDiv.getAttribute('data-full-message');
        document.getElementById('fullMessageText').innerText = fullMessage;
        new bootstrap.Modal(document.getElementById('messageModal')).show();
        }
        
        function exportToCSV() {
        let csv = "Time,Sender,Sender Email,Role,Conversation,Message\n";
        $("#messagesTable tbody tr:visible").each(function() {
        var $row = $(this);
        var cells = $row.find("td");
                
        var time = cells.eq(0).find('.text-muted').text().trim();
        var sender = cells.eq(1).find('.fw-bold').text().trim();
        var senderEmail = cells.eq(1).find('.text-muted').text().trim();
        var role = cells.eq(2).text().trim();
        var conversation = cells.eq(3).text().trim();
        var message = cells.eq(4).find('.text-dark').text().trim();
                
        csv += `"${time}","${sender}","${senderEmail}","${role}","${conversation}","${message.replace(/"/g, '""')}"\n`;
        });
            
        const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `messages_export_${new Date().toISOString().split('T')[0]}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        }

        let sortDirection = {};
        
        function sortTable(columnIndex) {
        const table = document.getElementById("messagesTable");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr:visible"));
            
        // Toggle sort direction for this column
        sortDirection[columnIndex] = sortDirection[columnIndex] === "asc" ? "desc" : "asc";
        const direction = sortDirection[columnIndex];
            
        // Sort rows
        rows.sort((a, b) => {
        let aValue = "";
        let bValue = "";
                
        if (columnIndex === 0) {
        // Sort by date
        aValue = a.cells[columnIndex]?.querySelector('.text-muted')?.innerText || "";
        bValue = b.cells[columnIndex]?.querySelector('.text-muted')?.innerText || "";
        } else if (columnIndex === 1) {
        // Sort by sender name
        aValue = a.cells[columnIndex]?.querySelector('.fw-bold')?.innerText || "";
        bValue = b.cells[columnIndex]?.querySelector('.fw-bold')?.innerText || "";
        } else {
        aValue = a.cells[columnIndex]?.innerText.trim() || "";
        bValue = b.cells[columnIndex]?.innerText.trim() || "";
        }
                
        if (direction === "asc") {
        return aValue.localeCompare(bValue);
        } else {
        return bValue.localeCompare(aValue);
        }
        });
            
        // Reorder rows
        rows.forEach(row => tbody.appendChild(row));
            
        // Update sort icons
        const headers = table.querySelectorAll("thead th");
        headers.forEach((header, idx) => {
        const icon = header.querySelector("i");
        if (icon) {
        if (idx === columnIndex) {
        icon.className = direction === "asc" ? "fas fa-sort-up ms-1" : "fas fa-sort-down ms-1";
        } else {
        icon.className = "fas fa-sort ms-1";
        }
        }
        });
        }
    </script>
}