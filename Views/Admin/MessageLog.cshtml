@model List<SCM_System.Models.ViewModels.AdminMessageViewModel>

@{
    ViewData["Title"] = "Message Monitoring";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-messages.css" asp-append-version="true" />
}

<div class="container-fluid py-4 messages-container">
    <!-- Header Section (Clean, no title) -->
    
    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card active" id="kpiTotalMessages">
            <i class="fas fa-comment-dots kpi-icon"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.TotalMessagesCount</div>
                <div class="kpi-label">Total Messages</div>
            </div>
        </div>
        <div class="kpi-card" id="kpiBlockedViolations">
            <i class="fas fa-ban kpi-icon" style="color: #E05A5A;"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.BlockedMessagesCount</div>
                <div class="kpi-label">Blocked Violations</div>
            </div>
        </div>
        <div class="kpi-card" id="kpiActivePenalties">
            <i class="fas fa-gavel kpi-icon" style="color: #E67E22;"></i>
            <div class="kpi-content">
                <div class="kpi-value">@ViewBag.ActivePenaltiesCount</div>
                <div class="kpi-label">Active Penalties</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search by sender name or message content...">
                </div>
            </div>
            <div class="col-lg-2">
                <select id="roleFilter" class="form-select filter-select">
                    <option value="all">All Roles</option>
                    <option value="Supplier">Supplier</option>
                    <option value="Retailer">Retailer</option>
                </select>
            </div>
            <div class="col-lg-2">
                <select id="timeRangeFilter" class="form-select filter-select">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                </select>
            </div>
            <div class="col-lg-3 text-end">
                <button id="refreshBtn" class="btn btn-refresh ms-auto">
                    <i class="fas fa-sync-alt"></i> Refresh Reports
                </button>
            </div>
        </div>
    </div>

    <!-- Table Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <h6 class="mb-0 fw-bold" style="color: var(--text-primary); font-size: 16px;">
            Recent Communications 
            <span id="filteredCount" class="badge-soft badge-soft-info ms-2">Loading...</span>
        </h6>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-refresh fw-bold px-3" onclick="window.print()">
                <i class="fas fa-print me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-container text-nowrap rounded-4 overflow-hidden border">
        <table class="table admin-table table-hover mb-0" id="messagesTable">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Time</th>
                    <th>Sender</th>
                    <th>Role</th>
                    <th>Between</th>
                    <th>Content Preview</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="messagesTableBody">
                <!-- Data populated by AJAX -->
                <tr>
                    <td colspan="7" class="text-center py-5">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary opacity-25"></i>
                        <p class="mt-2 text-muted">Fetching latest communications...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-messages.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Initial load
            applyFilters();
        });
    </script>
}