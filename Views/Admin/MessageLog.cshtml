@model List<SCM_System.Models.ViewModels.AdminMessageViewModel>

@{
    ViewData["Title"] = "Message Monitoring";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-envelope-open-text text-primary me-2"></i>Message Monitoring
        </h1>
        <div>
            <a asp-action="BlockedMessages" class="btn btn-warning me-2">
                <i class="fas fa-ban me-1"></i> Blocked Messages
                @if (ViewBag.BlockedMessagesCount > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.BlockedMessagesCount</span>
                }
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Total Messages</h6>
                            <h3 class="mb-0">@ViewBag.TotalMessagesCount</h3>
                        </div>
                        <i class="fas fa-envelope fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Blocked Messages</h6>
                            <h3 class="mb-0">@ViewBag.BlockedMessagesCount</h3>
                        </div>
                        <i class="fas fa-ban fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-2">Active Penalties</h6>
                            <h3 class="mb-0">@ViewBag.ActivePenaltiesCount</h3>
                        </div>
                        <i class="fas fa-gavel fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-list me-2 text-primary"></i>Recent Messages
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-envelope fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No messages found</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Sender</th>
                                <th>Role</th>
                                <th>Conversation</th>
                                <th>Message</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var msg in Model)
                            {
                                <tr>
                                    <td><small>@msg.TimeAgo</small></td>
                                    <td><strong>@msg.SenderName</strong></td>
                                    <td><span class="badge bg-@(msg.SenderRole == "Supplier" ? "primary" : "info")">@msg.SenderRole</span></td>
                                    <td><small>@msg.ConversationBetween</small></td>
                                    <td>@(msg.Content.Length > 50 ? msg.Content.Substring(0, 50) + "..." : msg.Content)</td>
                                    <td>
                                        <a asp-action="ViewConversation" asp-route-id="@msg.ConversationId"
                                               class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>