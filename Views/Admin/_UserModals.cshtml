<!-- _UserModals.cshtml -->

<!-- Single User Verify Modal -->
<div class="modal fade" id="verifyUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background-color: var(--card-bg);">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle" style="width: 60px; height: 60px;">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2" style="color: var(--text-color);">Verify User?</h4>
                <p class="text-muted mb-4">This will approve the user's account and notify them via system alert.</p>
                
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light flex-grow-1 py-2 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmVerifyBtn" class="btn btn-success flex-grow-1 py-2 rounded-3 fw-bold">Confirm Verify</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Single User Suspend Modal -->
<div class="modal fade" id="suspendUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background-color: var(--card-bg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: var(--text-color);"><i class="fas fa-user-slash me-2 text-warning"></i> Suspend Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Reason for Suspension</label>
                    <select id="suspendReason" class="form-select border-0 bg-light py-2">
                        <option value="Policy Violation">Policy Violation</option>
                        <option value="Suspicious Activity">Suspicious Activity</option>
                        <option value="Incomplete Profile">Incomplete Profile</option>
                        <option value="Unprofessional Behavior">Unprofessional Behavior</option>
                        <option value="Other">Other (Specify below)</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">Additional Details</label>
                    <textarea id="suspendComments" class="form-control border-0 bg-light" rows="3" placeholder="Provide details for the user..."></textarea>
                </div>
                
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light flex-grow-1 py-2 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmSuspendBtn" class="btn btn-warning flex-grow-1 py-2 rounded-3 fw-bold text-white">Suspend Account</button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Bulk Action Confirmation Modal -->
<div class="modal fade" id="bulkActionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background-color: var(--card-bg);">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <div id="bulkActionIcon" class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px;">
                        <!-- Icon injected by JS -->
                    </div>
                </div>
                <h4 id="bulkActionTitle" class="fw-bold mb-2">Bulk Action</h4>
                <p id="bulkActionMessage" class="text-muted mb-4">Are you sure you want to proceed with this action for <span id="bulkUserCount">0</span> selected users?</p>
                
                <div id="bulkReasonGroup" class="mb-4 text-start d-none">
                    <label class="form-label small fw-bold text-muted">Reason (optional)</label>
                    <textarea id="bulkActionReason" class="form-control border-0 bg-light" rows="2" placeholder="Provide a reason..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light flex-grow-1 py-2 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmBulkActionBtn" class="btn flex-grow-1 py-2 rounded-3 fw-bold text-white">Execute Action</button>
                </div>
            </div>
        </div>
    </div>
</div>
