@model SCM_System.Models.ViewModels.SupplierDetailsViewModel
@{
    var companyName = Model?.CompanyName ?? "Unknown Supplier";
    ViewData["Title"] = "Supplier Profile | " + companyName;
    Layout = "_DashboardLayout";
}

<style>
    .supplier-details {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px 24px;
    }

    .error-state {
        text-align: center;
        padding: 60px 20px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        margin-top: 40px;
    }
    .error-state i {
        font-size: 48px;
        color: #E67E22;
        margin-bottom: 20px;
        opacity: 0.8;
    }
    .error-state h3 {
        color: var(--text-color);
        font-weight: 700;
        margin-bottom: 12px;
    }
    .error-state p {
        color: var(--text-muted);
        margin-bottom: 24px;
    }

    .two-column-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }
    @@media (max-width: 768px) {
        .two-column-grid { grid-template-columns: 1fr; }
    }

    .full-width-card {
        margin-bottom: 20px;
    }
    
    .detail-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--card-shadow);
        height: 100%;
    }

    .card-heading {
        font-weight: 800;
        font-size: 11px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .profile-completion {
        margin-top: 16px;
    }
    .completion-label {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 8px;
    }
    .completion-percent { color: #2E9C7A; }

    .progress-bar-bg {
        height: 8px;
        background: var(--hover-state);
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: #2E9C7A;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .info-label {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 4px;
    }
    
    .info-value {
        font-size: 14px;
        color: var(--text-color);
        font-weight: 600;
        margin-bottom: 16px;
    }

    .category-badge {
        background: var(--hover-state);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-color);
    }

    .fayda-registry-info {
        background: var(--hover-state);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
    }
    
    .confidence-metric {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 8px;
    }

    .tin-validated {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fdf4;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #bbf7d0;
        width: fit-content;
    }
    .tin-number {
        font-family: monospace;
        font-weight: 700;
        color: #166534;
    }
    .validated-badge {
        background: #166534;
        color: white;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .document-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .document-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .document-item:hover { background: var(--hover-state); }
    .document-info { flex-grow: 1; }
    .document-name { display: block; font-size: 13px; font-weight: 700; }
    .document-filename { display: block; font-size: 11px; color: var(--text-muted); }
    .preview-icon { color: var(--text-muted); }

    .upload-date {
        margin-top: 15px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .timeline-item {
        position: relative;
        padding-left: 24px;
        margin-bottom: 16px;
    }
    .timeline-time {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-top: 24px;
    }
    .action-btn {
        padding: 10px 32px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        cursor: pointer;
    }
    .btn-approve { background: #2E9C7A; color: white; }
    .btn-reject { background: #E05A5A; color: white; }
</style>

<div class="supplier-details pb-5">
    @if (Model == null)
    {
        <div class="error-state">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>Supplier Not Found</h3>
            <p>The supplier you're looking for doesn't exist or has been removed.</p>
        </div>
    }
    else
    {
        <a asp-action="PendingUsers" class="text-decoration-none mb-3 d-inline-block" style="color: var(--text-muted); font-size: 13px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i> Back to Verification Hub
        </a>

        <div class="detail-card full-width-card">
            <div class="d-flex align-items-center gap-4 mb-3">
                <div style="width: 72px; height: 72px; border-radius: 16px; background: var(--hover-state); border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 28px;">
                    🏭
                </div>
                <div>
                    <h3 class="fw-bold mb-1" style="color: var(--text-color); letter-spacing: -0.5px;">@Model.CompanyName</h3>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span style="font-size: 13px; font-weight: 600; color: var(--text-muted);">Account #@Model.Id</span>
                        <span style="color: var(--border-color);">•</span>
                        @{ 
                            string badgeClass = Model.Status == "Verified" ? "badge-soft-success" : (Model.Status == "Rejected" ? "badge-soft-danger" : "badge-soft-warning");
                        }
                        <span class="badge-soft @badgeClass" style="font-size: 12px; padding: 4px 10px;">@Model.Status</span>
                        <span style="color: var(--border-color);">•</span>
                        <span style="font-size: 13px; font-weight: 500; color: var(--text-muted);">Member since: @Model.MemberSince.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>
            
            <div class="profile-completion">
                <div class="completion-label">
                    <span>Profile Completion</span>
                    <span class="completion-percent">@(Model.Status == "Verified" ? "100%" : "75%")</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-fill" style="width: @(Model.Status == "Verified" ? "100" : "75")%;"></div>
                </div>
            </div>
        </div>

        <div class="two-column-grid">
            <div class="detail-card">
                <div class="card-heading"><i class="fas fa-phone"></i> CONTACT INFORMATION</div>
                <div style="height: 1px; width: 100%; background: var(--border-color); margin-bottom: 20px;"></div>
                
                <div class="info-label">Account Owner:</div>
                <div class="info-value">@Model.AccountOwner</div>

                <div class="info-label">Email Address:</div>
                <div class="info-value">@Model.Email</div>

                <div class="info-label">Phone Number:</div>
                <div class="info-value">@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "Not provided")</div>
            </div>
            
            <div class="detail-card">
                <div class="card-heading"><i class="fas fa-building"></i> BUSINESS INFORMATION</div>
                <div style="height: 1px; width: 100%; background: var(--border-color); margin-bottom: 20px;"></div>
                
                <div class="info-label">Business Type / Category:</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.BusinessCategory) && Model.BusinessCategory != "Not specified")
                    {
                        <span class="category-badge">@Model.BusinessCategory</span>
                    }
                    else
                    {
                        <span class="text-muted italic">Not specified</span>
                    }
                </div>

                <div class="info-label">HQ Location:</div>
                <div class="info-value">@(string.IsNullOrEmpty(Model.Headquarters) ? "Unknown" : Model.Headquarters)</div>

                <div class="info-label">Detailed Address:</div>
                <div class="info-value">@(!string.IsNullOrEmpty(Model.DetailedAddress) ? Model.DetailedAddress : "Not provided")</div>
            </div>
        </div>

        <div class="detail-card full-width-card">
            <div class="card-heading"><i class="fas fa-fingerprint"></i> FAYDA IDENTITY</div>
            <div style="height: 1px; width: 100%; background: var(--border-color); margin-bottom: 20px;"></div>
            
            @if (Model.FaydaVerified) {
                <div class="fayda-registry-info">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <div class="info-label">Verification Status</div>
                            <span class="badge-soft badge-soft-success px-3" style="font-size: 13px;"><i class="fas fa-check-circle me-1"></i> VERIFIED MATCH</span>
                        </div>
                        <div class="text-end">
                            <div class="info-label">Registry Match</div>
                            <div class="fw-bold text-success">@Model.FaydaRegistryName ✅</div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="info-label">Fayda ID (FAN)</div>
                            <div class="info-value mb-0 font-monospace" style="letter-spacing: 1px;">@Model.FaydaId</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Date of Birth</div>
                            <div class="info-value mb-0">@Model.FaydaDOB?.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Confidence Score</div>
                            <div class="confidence-metric">
                                <div class="progress-bar-bg flex-grow-1" style="height: 10px;">
                                    <div class="progress-fill" style="width: @Model.FaydaConfidenceScore%; background: #2E9C7A;"></div>
                                </div>
                                <span class="fw-bold" style="color: #2E9C7A; width: 40px;">@Model.FaydaConfidenceScore%</span>
                            </div>
                        </div>
                    </div>
                </div>
            } else {
                <div class="p-4 text-center rounded-3" style="background: var(--hover-state); border: 1px dashed var(--border-color);">
                    <i class="fas fa-fingerprint fa-3x mb-3 text-muted opacity-25"></i>
                    <h5 class="fw-bold text-muted">Fayda Verification Pending</h5>
                    <p class="small text-muted mb-0">Biometric integration layer waiting for user synchronization.</p>
                </div>
            }
        </div>

        <div class="detail-card full-width-card">
            <div class="card-heading"><i class="fas fa-file-contract"></i> COMPLIANCE DOCUMENTS</div>
            <div style="height: 1px; width: 100%; background: var(--border-color); margin-bottom: 20px;"></div>
            
            <div class="row">
                <div class="col-md-12">
                    <!-- Tax ID as NUMBER, not document -->
                    <div class="tin-section" style="background: rgba(46, 156, 122, 0.05); border-radius: 12px; padding: 20px; margin-bottom: 24px; border-left: 4px solid #2E9C7A;">
                        <div class="info-label mb-2">
                            <i class="fas fa-id-card me-2" style="color: #2E9C7A;"></i>
                            <span>Tax Identification Number (TIN):</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="tin-number" style="font-family: 'Courier New', monospace; font-size: 24px; font-weight: 800; letter-spacing: 2px; color: var(--text-color);">@Model.TaxId</span>
                            <span class="badge" style="background: #2E9C7A; color: white; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 700;">
                                <i class="fas fa-check-circle me-1"></i> VALIDATED
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-label mb-3">Submitted Documents</div>
            <div class="document-list">
                @if(!string.IsNullOrEmpty(Model.BusinessLicensePath)) {
                    <div class="document-item" onclick="previewDocument('License.pdf', @Model.Id, 'Supplier')">
                        <i class="fas fa-file-pdf fa-lg" style="color: #E05A5A;"></i>
                        <div class="document-info">
                            <span class="document-name">Business License Certificate</span>
                            <span class="document-filename">License.pdf</span>
                        </div>
                        <div class="d-flex gap-2">
                            <i class="fas fa-eye preview-icon"></i>
                            <i class="fas fa-download text-muted small"></i>
                        </div>
                    </div>
                }
                
                @if(!string.IsNullOrEmpty(Model.PermitPath)) {
                    <div class="document-item" onclick="previewDocument('BusinessPermit.jpg', @Model.Id, 'Supplier')">
                        <i class="fas fa-file-image fa-lg" style="color: #3BAE86;"></i>
                        <div class="document-info">
                            <span class="document-name">Business Permit / Operation Certificate</span>
                            <span class="document-filename">BusinessPermit.jpg</span>
                        </div>
                        <div class="d-flex gap-2">
                            <i class="fas fa-eye preview-icon"></i>
                            <i class="fas fa-download text-muted small"></i>
                        </div>
                    </div>
                }
            </div>
            <div class="upload-date">
                <i class="fas fa-calendar-alt me-1"></i>
                <span>Documents Verified on @Model.DocumentUploadDate.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        <div class="detail-card full-width-card">
            <div class="card-heading"><i class="fas fa-history"></i> AUDIT HISTORY</div>
            <div style="height: 1px; width: 100%; background: var(--border-color); margin-bottom: 20px;"></div>
            
            @if (Model.AuditHistory != null && Model.AuditHistory.Any())
            {
                <div class="timeline">
                    @foreach (var audit in Model.AuditHistory)
                    {
                        <div class="timeline-item">
                            <div class="timeline-desc">
                                <span class="fw-bold">@audit.Action:</span> @audit.Details 
                                <span class="text-muted ms-1" style="font-size: 11px;">- by @audit.PerformedBy</span>
                            </div>
                            <div class="timeline-time">@audit.Timestamp.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="timeline-item">
                    <div class="timeline-desc">Profile created and pending initial review</div>
                    <div class="timeline-time">@Model.MemberSince.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            }
        </div>

        @if (Model.Status == "Pending")
        {
            <div class="action-buttons">
                <form asp-action="ApproveUser" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="action-btn btn-approve">
                        ✅ Approve Application
                    </button>
                </form>
                <button type="button" class="action-btn btn-reject" onclick="openRejectModal(@Model.Id, '@Html.Raw(Model.CompanyName.Replace("'", "\\'"))')">
                    ❌ Reject Application
                </button>
            </div>
        }
    }
</div>

<div class="modal fade" id="documentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border-radius: 16px; background: var(--card-bg); border: 1px solid var(--border-color);">
            <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" style="color: var(--text-color);">
                    📄 <span id="docTitle">Document.pdf</span>
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" style="filter: var(--invert-close-btn);"></button>
            </div>
            <div class="modal-body p-4">
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-outline-card px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn px-4 text-white btn-primary" style="background:#2E9C7A; border:none;"><i class="fas fa-download me-2"></i>Download Original</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/verification-hub.js"></script>
}