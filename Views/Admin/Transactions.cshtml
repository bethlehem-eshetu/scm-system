@{
    ViewData["Title"] = "Transactions";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="fas fa-exchange-alt me-2 text-primary"></i> All Transactions</h2>
    <!-- Filter Section -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="transactionSearch" class="form-control bg-light border-0" placeholder="Search by ID, Supplier or Retailer...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="typeFilter" class="form-select bg-light border-0">
                        <option value="">All Types</option>
                        <option value="OrderPayment">Order Payment</option>
                        <option value="PlatformCommission">Commission</option>
                        <option value="SupplierPayout">Payout</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select bg-light border-0">
                        <option value="">All Status</option>
                        <option value="Cleared">Cleared</option>
                        <option value="Pending">Pending</option>
                        <option value="Failed">Failed</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-light w-100 rounded-3" onclick="resetTransactionFilters()">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">Transaction Stream</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="transactionsTable">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-muted small fw-bold">TRANSACTION ID</th>
                        <th class="text-muted small fw-bold">DATE</th>
                        <th class="text-muted small fw-bold">TYPE</th>
                        <th class="text-muted small fw-bold">ENTITIES</th>
                        <th class="text-muted small fw-bold">AMOUNT</th>
                        <th class="text-muted small fw-bold pe-4 text-center">STATUS</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">
                                    @(string.IsNullOrEmpty(t.ChapaTransactionId) ? (t.PaymentType != null && t.PaymentType.Contains("Order") ? $"PAY-{t.Id.ToString().PadLeft(6, '0')}" : t.PaymentType != null && t.PaymentType.Contains("Commission") ? $"COMM-{t.Id.ToString().PadLeft(6, '0')}" : $"TXN-{t.Id.ToString().PadLeft(6, '0')}") : t.ChapaTransactionId)
                                </div>
                            </td>
                            <td>
                                <div class="text-muted">@t.CreatedAt.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@t.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-3">@t.PaymentType</span>
                            </td>
                            <td>
                                @if(t.Retailer != null) { 
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fas fa-store text-info me-2 small"></i>
                                        <span class="small fw-medium">@t.Retailer.BusinessName</span>
                                    </div>
                                }
                                @if(t.Supplier != null) { 
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-building text-primary me-2 small"></i>
                                        <span class="small fw-medium">@t.Supplier.CompanyName</span>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="fw-bold @(t.Status == "Paid" ? "text-success" : (t.Status == "Failed" ? "text-danger" : "text-dark"))">
                                    @t.CommissionAmount.ToString("C")
                                </span>
                            </td>
                            <td class="pe-4 text-center">
                                @if (t.Status == "Paid") { <span class="badge bg-success bg-opacity-20 text-success rounded-pill px-3 py-2">Cleared</span> }
                                else if (t.Status == "Pending") { <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3 py-2">Pending</span> }
                                else { <span class="badge bg-danger bg-opacity-20 text-danger rounded-pill px-3 py-2">Failed</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#transactionSearch, #typeFilter, #statusFilter").on("keyup change", function() {
                var searchText = $("#transactionSearch").val().toLowerCase();
                var type = $("#typeFilter").val().toLowerCase();
                var status = $("#statusFilter").val().toLowerCase();

                $("#transactionsTable tbody tr").filter(function() {
                    var rowText = $(this).text().toLowerCase();
                    var rowType = $(this).find("td:nth-child(3)").text().toLowerCase();
                    var rowStatus = $(this).find("td:nth-child(6)").text().toLowerCase();

                    var matchesSearch = rowText.indexOf(searchText) > -1;
                    var matchesType = type === "" || rowType.indexOf(type) > -1;
                    var matchesStatus = status === "" || rowStatus.indexOf(status) > -1;

                    $(this).toggle(matchesSearch && matchesType && matchesStatus);
                });
            });
        });

        function resetTransactionFilters() {
            $("#transactionSearch").val("");
            $("#typeFilter").val("");
            $("#statusFilter").val("");
            $("#transactionsTable tbody tr").show();
        }
    </script>
}
