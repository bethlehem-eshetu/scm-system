@model IEnumerable<SCM_System.Models.Entities.Commission>
@{
    ViewData["Title"] = "Transaction Ledger";
    Layout = "_DashboardLayout";
    var allItems = Model.ToList();
    var totalAmt = allItems.Sum(t => t.CommissionAmount);
    var successAmt = allItems.Where(t => t.Status == "Paid").Sum(t => t.CommissionAmount);
    var pendingAmt = allItems.Where(t => t.Status == "Pending").Sum(t => t.CommissionAmount);
    var failedAmt  = allItems.Where(t => t.Status == "Failed").Sum(t => t.CommissionAmount);
    var initialType = ViewBag.InitialTypeFilter as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center fin-page-header">
        <div>
            <div class="fin-page-title">Transaction Ledger</div>
            <div class="fin-page-subtitle">Track and manage all financial transactions across the platform.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ExportFinancials" class="fin-action-btn">
                <i class="fas fa-file-csv"></i> Export CSV
            </a>
            <a asp-action="CommissionOverview" class="fin-action-btn primary">
                <i class="fas fa-chart-bar"></i> Financial Dashboard
            </a>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="finance-kpi-grid">
        <div class="fin-kpi-card">
            <i class="fas fa-coins fin-kpi-icon"></i>
            <div>
                <div class="fin-kpi-value">@totalAmt.ToString("C0")</div>
                <div class="fin-kpi-label">Total Volume</div>
                <div class="fin-kpi-trend positive">@allItems.Count transactions</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #2E9C7A;">
            <i class="fas fa-check-circle fin-kpi-icon"></i>
            <div>
                <div class="fin-kpi-value">@successAmt.ToString("C0")</div>
                <div class="fin-kpi-label">Cleared / Paid</div>
                <div class="fin-kpi-trend positive">@allItems.Count(t => t.Status == "Paid") txns</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #E67E22;">
            <i class="fas fa-clock fin-kpi-icon" style="color:#E67E22;"></i>
            <div>
                <div class="fin-kpi-value">@pendingAmt.ToString("C0")</div>
                <div class="fin-kpi-label">Pending</div>
                <div class="fin-kpi-trend neutral">@allItems.Count(t => t.Status == "Pending") txns</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #E05A5A;">
            <i class="fas fa-times-circle fin-kpi-icon" style="color:#E05A5A;"></i>
            <div>
                <div class="fin-kpi-value">@failedAmt.ToString("C0")</div>
                <div class="fin-kpi-label">Failed</div>
                <div class="fin-kpi-trend @(failedAmt > 0 ? "negative" : "positive")">@allItems.Count(t => t.Status == "Failed") txns</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="finance-filter-bar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="fin-search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="transactionSearch" placeholder="Search by ID, supplier, or retailer...">
                </div>
            </div>
            <div class="col-lg-2">
                <select id="typeFilter" class="form-select fin-filter-select" onchange="applyTxnFilters()">
                    <option value="">All Types</option>
                    <option value="OrderPayment">Order Payment</option>
                    <option value="PlatformCommission">Commission</option>
                    <option value="SupplierPayout">Payout</option>
                </select>
            </div>
            <div class="col-lg-2">
                <select id="statusFilter" class="form-select fin-filter-select" onchange="applyTxnFilters()">
                    <option value="">All Status</option>
                    <option value="Paid">Cleared</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-lg-3 text-end d-flex gap-2 justify-content-end">
                <button class="fin-action-btn" onclick="resetTxnFilters()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Filters -->
    <div class="type-filter-tabs">
        <button class="type-pill @(string.IsNullOrEmpty(initialType) ? "active" : "")" onclick="quickFilter('', this)">All</button>
        <button class="type-pill @(initialType == "OrderPayment" ? "active" : "")" onclick="quickFilter('OrderPayment', this)">💳 OrderPayment</button>
        <button class="type-pill @(initialType == "SupplierPayout" ? "active" : "")" onclick="quickFilter('SupplierPayout', this)">💸 SupplierPayout</button>
        <button class="type-pill @(initialType == "PlatformCommission" ? "active" : "")" onclick="quickFilter('PlatformCommission', this)">📊 Commission</button>
    </div>

    <!-- Table -->
    <div class="table-results-bar">
        <span class="results-count">Transaction Stream <span id="txnCount" class="badge-soft badge-soft-info ms-1">@allItems.Count results</span></span>
    </div>

    <div class="fin-panel">
        <div class="table-responsive">
            <table class="table admin-table table-hover mb-0" id="transactionsTable">
                <thead>
                    <tr>
                        <th class="ps-4">Transaction ID</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Entities</th>
                        <th>Amount</th>
                        <th class="pe-4 text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in allItems)
                    {
                        var txnId = string.IsNullOrEmpty(t.ChapaTransactionId)
                            ? (t.PaymentType?.Contains("Order") == true ? $"PAY-{t.Id:D6}"
                               : t.PaymentType?.Contains("Commission") == true ? $"COMM-{t.Id:D6}"
                               : $"TXN-{t.Id:D6}")
                            : t.ChapaTransactionId;

                        <tr data-type="@t.PaymentType" data-status="@t.Status"
                            data-search="@txnId @(t.Supplier?.CompanyName) @(t.Retailer?.BusinessName)".ToLower()>
                            <td class="ps-4">
                                <span class="fw-bold" style="font-family: monospace; color: var(--text-color);">@txnId</span>
                            </td>
                            <td>
                                <div style="color: var(--text-color); font-size: 13px;">@t.CreatedAt.ToString("MMM dd, yyyy")</div>
                                <div style="color: var(--text-muted); font-size: 11px;">@t.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (t.PaymentType?.Contains("Order") == true) { <span class="txn-type txn-type-order">OrderPayment</span> }
                                else if (t.PaymentType?.Contains("Commission") == true) { <span class="txn-type txn-type-commission">Commission</span> }
                                else { <span class="txn-type txn-type-payout">Payout</span> }
                            </td>
                            <td>
                                @if (t.Retailer != null)
                                {
                                    <div style="font-size:13px; color:var(--text-color);"><i class="fas fa-store me-1" style="color:#5B8FF9;"></i>@t.Retailer.BusinessName</div>
                                }
                                @if (t.Supplier != null)
                                {
                                    <div style="font-size:13px; color:var(--text-muted);"><i class="fas fa-building me-1" style="color:#2E9C7A;"></i>@t.Supplier.CompanyName</div>
                                }
                            </td>
                            <td>
                                <span style="font-weight: 800; color: @(t.Status == "Paid" ? "#2E9C7A" : t.Status == "Failed" ? "#E05A5A" : "var(--text-color)");">
                                    @t.CommissionAmount.ToString("C")
                                </span>
                            </td>
                            <td class="pe-4 text-center">
                                @if (t.Status == "Paid") { <span class="txn-status txn-status-paid"><i class="fas fa-check-circle"></i> Cleared</span> }
                                else if (t.Status == "Pending") { <span class="txn-status txn-status-pending"><i class="fas fa-clock"></i> Pending</span> }
                                else { <span class="txn-status txn-status-failed"><i class="fas fa-times-circle"></i> Failed</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applyTxnFilters() {
            const search = document.getElementById('transactionSearch').value.toLowerCase();
            const type = document.getElementById('typeFilter').value;
            const status = document.getElementById('statusFilter').value;
            let count = 0;
            document.querySelectorAll('#transactionsTable tbody tr').forEach(row => {
                const rowType = row.dataset.type || '';
                const rowStatus = row.dataset.status || '';
                const rowSearch = row.dataset.search || '';
                const show = (!search || rowSearch.includes(search))
                    && (!type || rowType.includes(type))
                    && (!status || rowStatus === status);
                row.style.display = show ? '' : 'none';
                if (show) count++;
            });
            document.getElementById('txnCount').textContent = `${count} results`;
        }

        function quickFilter(type, el) {
            document.querySelectorAll('.type-pill').forEach(p => p.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('typeFilter').value = type;
            applyTxnFilters();
        }

        function resetTxnFilters() {
            document.getElementById('transactionSearch').value = '';
            document.getElementById('typeFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.querySelectorAll('.type-pill').forEach(p => p.classList.remove('active'));
            document.querySelector('.type-pill').classList.add('active');
            applyTxnFilters();
        }

        document.getElementById('transactionSearch').addEventListener('input', applyTxnFilters);

        // Auto-apply initial filter from URL parameter (e.g. redirected from /Admin/Payouts)
        document.addEventListener('DOMContentLoaded', function() {
            const initialType = '@Html.Raw(initialType)';
            if (initialType) {
                document.getElementById('typeFilter').value = initialType;
                applyTxnFilters();
            }
        });
    </script>
}
