@model SCM_System.Models.ViewModels.PendingUsersViewModel
@{
    ViewData["Title"] = "Unified Verification Hub";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/verification-hub.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="verification-hub">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold">Verification Hub</h1>
            <p class="text-muted small mb-0">Centralized approval dashboard for all system roles</p>
        </div>
        <div class="text-end">
            <span class="badge bg-soft-primary text-primary border border-primary px-3 py-2 rounded-pill">
                <i class="fas fa-clock me-2"></i>Last Updated: @DateTime.Now.ToString("HH:mm")
            </span>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card" id="kpiPending" onclick="filterByQuickStatus('Pending')">
            <div class="kpi-icon bg-soft-warning" style="background-color: #fffbeb; color: #d97706;">
                <i class="fas fa-user-clock"></i>
            </div>
            <div class="kpi-info">
                <h4>Pending Review</h4>
                <span class="kpi-value">@Model.TotalPendingCount</span>
            </div>
        </div>
        <div class="kpi-card" id="kpiVerified" onclick="filterByQuickStatus('Verified')">
            <div class="kpi-icon" style="background-color: #ecfdf5; color: #059669;">
                <i class="fas fa-shield-check"></i>
            </div>
            <div class="kpi-info">
                <h4>Verified Users</h4>
                <span class="kpi-value">@Model.VerifiedTodayCount</span>
            </div>
        </div>
        <div class="kpi-card" id="kpiRejected" onclick="filterByQuickStatus('Rejected')">
            <div class="kpi-icon" style="background-color: #fef2f2; color: #dc2626;">
                <i class="fas fa-user-times"></i>
            </div>
            <div class="kpi-info">
                <h4>Rejected Today</h4>
                <span class="kpi-value">@Model.RejectedTodayCount</span>
            </div>
        </div>
    </div>

    <!-- Hub Controls -->
    <div class="hub-controls">
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" id="hubSearch" placeholder="Search by name, ID or company..." oninput="handleSearchInput()" value="@ViewContext.HttpContext.Request.Query["searchTerm"]">
        </div>
        
        <div class="select-wrapper">
            <select id="roleFilter" class="form-select border-0 bg-light" onchange="applyFilters()">
                <option value="">All Roles</option>
                <option value="Supplier">Suppliers</option>
                <option value="Retailer">Retailers</option>
                <option value="WarehouseManager">Warehouse Managers</option>
                <option value="DeliveryAgent">Delivery Agents</option>
            </select>
        </div>

        <div class="select-wrapper">
            <select id="statusFilter" class="form-select border-0 bg-light" onchange="applyFilters()">
                <option value="">All Risk Levels</option>
                <option value="Low">Low Risk</option>
                <option value="Medium">Medium Risk</option>
                <option value="High">High Risk</option>
            </select>
        </div>

        <button class="btn btn-outline-secondary border-0" onclick="window.location.href='/Admin/PendingUsers'">
            <i class="fas fa-sync-alt"></i>
        </button>
    </div>

    <!-- User Cards Grid -->
    <div class="user-grid">
        @if (!Model.PendingUsers.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-check-circle fa-4x text-muted mb-3 opacity-25"></i>
                <h4 class="text-muted">No pending verification requests</h4>
                <p>All users have been processed. Great job!</p>
            </div>
        }
        else
        {
            @foreach (var user in Model.PendingUsers)
            {
                <div class="user-card" data-role="@user.Role" data-risk="@user.RiskScore">
                    <div class="user-card-header">
                        <div class="user-main-info">
                            <div class="user-avatar">
                                @(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName.Substring(0, 1))
                            </div>
                            <div class="user-title">
                                <h3>@user.FullName</h3>
                                <span class="user-role-badge role-@user.Role.ToLower()">@user.Role</span>
                            </div>
                        </div>
                        <span class="risk-tag risk-@user.RiskScore.ToLower()">@user.RiskScore Risk</span>
                    </div>

                    <div class="user-card-body">
                        <div class="info-row">
                            <span class="info-label">Applied</span>
                            <span class="info-value">@user.AppliedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(user.CompanyName))
                        {
                            <div class="info-row">
                                <span class="info-label">Company</span>
                                <span class="info-value">@user.CompanyName</span>
                            </div>
                        }
                        
                        <div class="fayda-section mt-3 p-3 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-muted">🔗 FAYDA IDENTITY</span>
                                @if (user.IsFaydaVerified)
                                {
                                    <span class="badge bg-success-soft text-success small" style="background: rgba(46, 156, 122, 0.1); color: #2E9C7A !important;"><i class="fas fa-check-circle me-1"></i> VERIFIED</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-soft text-warning small"><i class="fas fa-clock me-1"></i> PENDING</span>
                                }
                            </div>
                            
                            <div class="info-row x-small mb-1" style="font-size: 0.75rem;">
                                <span class="info-label text-muted">ID:</span>
                                <span class="info-value fw-bold">@(string.IsNullOrEmpty(user.FaydaId) ? "NOT LINKED" : user.FaydaId)</span>
                            </div>
                            
                            <div class="info-row x-small mb-2" style="font-size: 0.75rem;">
                                <span class="info-label text-muted">Registry:</span>
                                @if (user.ConfidenceScore >= 80)
                                {
                                    <span class="registry-verified"><i class="fas fa-check-circle"></i> @user.FullName ✅</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold"><i class="fas fa-times-circle"></i> UNMATCHED</span>
                                }
                            </div>

                            <!-- Confidence Match Indicator -->
                            <div class="confidence-bar-wrapper">
                                <div class="confidence-header">
                                    <span class="text-muted">ID Match Confidence</span>
                                    <span class="fw-bold @(user.ConfidenceScore >= 80 ? "text-success" : "text-warning")">@user.ConfidenceScore%</span>
                                </div>
                                <div class="confidence-bg">
                                    <div class="confidence-fill fill-@(user.ConfidenceScore >= 80 ? "high" : (user.ConfidenceScore > 40 ? "medium" : "low"))" style="width: @user.ConfidenceScore%;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Documents Section -->
                        <div class="documents-section">
                            <label>📎 SUBMITTED DOCUMENTS</label>
                            <div class="document-list">
                                <!-- License Document -->
                                <div class="document-item" onclick="previewDocument('License.pdf', @user.UserId, '@user.Role')">
                                    <i class="fas fa-file-pdf"></i>
                                    <div class="document-info">
                                        <span class="document-name">Business License</span>
                                    </div>
                                    <i class="fas fa-eye preview-icon"></i>
                                </div>
                                
                                <!-- Tax ID Display (Number, not document) -->
                                @if (!string.IsNullOrEmpty(user.TaxId))
                                {
                                    <div class="tin-display">
                                        <i class="fas fa-id-card"></i>
                                        <div class="document-info">
                                            <span class="document-name">Tax ID (TIN): <strong>@user.TaxId</strong></span>
                                        </div>
                                        <span class="validated-badge">VALIDATED</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="user-card-footer">
                        <button class="btn-approve" onclick="openApproveModal(@user.UserId, '@user.FullName.Replace("'", "\\'")')">
                            <i class="fas fa-check-circle"></i> Approve
                        </button>
                        <button class="btn-reject" onclick="openRejectModal(@user.UserId, '@user.FullName.Replace("'", "\\'")')">
                            <i class="fas fa-times-circle"></i> Reject
                        </button>
                        <button class="btn-details" onclick="window.location.href='/Admin/UserDetails/@user.UserId'">
                            <i class="fas fa-eye"></i> Details
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Approval Modal -->
<div id="approveModal" class="hub-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h4 id="approveModalTitle" class="mb-0 fw-bold">Approve Application</h4>
        </div>
        <form id="approveForm" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <p>Are you sure you want to approve this user? This will grant them full access to the platform based on their role.</p>
                <div class="alert alert-info py-2 small">
                    <i class="fas fa-info-circle me-2"></i> An automated approval email will be sent to the user.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-close-modal">Cancel</button>
                <button type="submit" class="btn btn-primary fw-bold">Confirm Approval</button>
            </div>
        </form>
    </div>
</div>

<!-- Rejection Modal -->
<div id="rejectModal" class="hub-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h4 id="rejectModalTitle" class="mb-0 fw-bold text-danger">Reject Application</h4>
        </div>
        <form id="rejectForm" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Rejection Reason <span class="text-danger">*</span></label>
                    <select name="reason" class="form-select" required>
                        <option value="">Select a reason...</option>
                        <option value="Incomplete Documentation">Incomplete Documentation</option>
                        <option value="Invalid Business License">Invalid Business License</option>
                        <option value="Fayda Identity Verification Failed">Fayda Identity Verification Failed</option>
                        <option value="Duplicate Account Detected">Duplicate Account Detected</option>
                        <option value="Ineligible Business Category">Ineligible Business Category</option>
                        <option value="Other">Other (Specify in notes)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Internal Notes (Optional)</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Additional details for audit trail..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-close-modal">Cancel</button>
                <button type="submit" class="btn btn-danger fw-bold">Submit Rejection</button>
            </div>
        </form>
    </div>
</div>

<!-- Document Preview Modal -->
<div id="documentModal" class="hub-modal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header d-flex justify-content-between align-items-center">
            <h4 id="documentModalTitle" class="mb-0 fw-bold">Document Preview</h4>
            <button type="button" class="btn-close btn-close-modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center p-5">
            <div id="documentPreviewContent">
                <i class="fas fa-file-pdf fa-5x text-danger mb-4"></i>
                <h5 id="documentFileName" class="mb-3">Document Name</h5>
                <p class="text-muted mb-4">The document is ready for review. You can download it for full inspection or view it using the browser's PDF viewer.</p>
                <div class="d-flex justify-content-center gap-3">
                    <button id="downloadBtn" class="btn btn-primary px-4">
                        <i class="fas fa-download me-2"></i> Download
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 btn-close-modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/verification-hub.js"></script>
    <script>
        // Sync filter dropdowns with query params on load
        document.addEventListener('DOMContentLoaded', function() {
            const params = new URLSearchParams(window.location.search);
            if (params.has('roleFilter')) document.getElementById('roleFilter').value = params.get('roleFilter');
            if (params.has('statusFilter')) document.getElementById('statusFilter').value = params.get('statusFilter');
        });
    </script>
}
