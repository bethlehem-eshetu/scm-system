@model SCM_System.Models.Entities.Retailer
@{
    ViewData["Title"] = "Retailer Profile | " + Model.BusinessName;
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-5" style="background-color: #f8f9fa; min-height: 100vh;">
    <!-- Top Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
                <div class="card-body p-0">
                    <div class="bg-success p-4 text-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="avatar-xl bg-white text-success rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                                @Model.BusinessName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <h2 class="fw-bold mb-0">@Model.BusinessName</h2>
                                <p class="mb-0 text-white-50"><i class="fas fa-store me-2"></i>Retailer Account #@Model.Id</p>
                            </div>
                        </div>
                        <div class="text-end">
                            @{
                                var isApproved = Model.User?.IsApproved == true;
                                var accountStatus = Model.User?.AccountStatus;
                            }
                            <span class="badge @(isApproved ? "bg-white text-success" : (accountStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")) rounded-pill px-4 py-2 fs-6 shadow-sm">
                                <i class="fas @(isApproved ? "fa-check-circle" : (accountStatus == "Rejected" ? "fa-times-circle" : "fa-clock")) me-2"></i>
                                @(isApproved ? "Approved" : (accountStatus == "Rejected" ? "Rejected" : "Pending Approval"))
                            </span>
                            <div class="mt-2 text-white-50 small">Retailer Status</div>
                        </div>
                    </div>
                    <div class="p-3 bg-white d-flex justify-content-between align-items-center">
                        <div class="ms-3">
                            <a asp-action="PendingUsers" class="btn btn-link text-decoration-none text-muted fw-bold">
                                <i class="fas fa-arrow-left me-2"></i>Back to Verification Hub
                            </a>
                        </div>
                        <div class="me-3">
                            @if (Model.User != null && !Model.User.IsApproved && Model.User.AccountStatus != "Rejected")
                            {
                                <form asp-action="ApproveUser" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.UserId" />
                                    <button type="submit" class="btn btn-success px-4 rounded-3 fw-bold shadow-sm me-2">
                                        <i class="fas fa-check-circle me-2"></i>Approve Retailer
                                    </button>
                                </form>
                                <button type="button" class="btn btn-outline-danger px-4 rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="fas fa-times-circle me-2"></i>Reject
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-4">
             <!-- Fayda Identity Card -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-soft-success p-2 rounded-3 me-3">
                            <i class="fas fa-fingerprint fa-2x text-success"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Identity Snapshot</h5>
                    </div>
                    
                    @if (Model.User?.FaydaVerification != null)
                    {
                        var vf = Model.User.FaydaVerification;
                        <div class="p-3 rounded-4" style="background-color: #f1f8f1; border: 1px dashed #28a745;">
                            <div class="text-center mb-3">
                                @if (Model.User.IsFaydaVerified)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill border border-info border-opacity-25 shadow-sm">
                                        <i class="fas fa-check-shield me-2"></i>Verified Identity
                                    </span>
                                }
                                else if (Model.User.FaydaStatus == "Rejected")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill border border-danger border-opacity-25 shadow-sm">
                                        <i class="fas fa-times-circle me-2"></i>Identity Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill border border-warning border-opacity-25 shadow-sm">
                                        <i class="fas fa-clock me-2"></i>Identity Pending
                                    </span>
                                }
                            </div>
                            
                            <div class="mb-3">
                                <label class="text-muted small text-uppercase fw-bold d-block mb-1">Fan Account Number</label>
                                <div class="p-2 bg-white rounded-3 border fw-bold font-monospace">@Model.User.FAN</div>
                            </div>

                            <div class="list-group list-group-flush small">
                                <div class="list-group-item bg-transparent border-0 px-0 d-flex justify-content-between">
                                    <span class="text-muted">Verified Name:</span>
                                    <span class="fw-bold">@vf.VerifiedName</span>
                                </div>
                                <div class="list-group-item bg-transparent border-0 px-0 d-flex justify-content-between">
                                    <span class="text-muted">Date of Birth:</span>
                                    <span class="fw-bold">@vf.VerifiedDob?.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="list-group-item bg-transparent border-0 px-0 d-flex justify-content-between">
                                    <span class="text-muted">Registry Phone:</span>
                                    <span class="fw-bold">@vf.VerifiedPhone</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-4">
                            <i class="fas fa-id-card-alt fa-3x text-muted opacity-25 mb-3"></i>
                            <p class="text-muted small mb-0">Waiting for biometric link...</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Contact Card -->
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Contact Profile</h5>
                    <div class="space-y-4">
                        <div class="d-flex align-items-start mb-3">
                            <div class="bg-light p-2 rounded-circle me-3"><i class="fas fa-user text-muted"></i></div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.65rem;">Account Holder</small>
                                <span class="fw-bold text-dark">@Model.User?.FullName</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <div class="bg-light p-2 rounded-circle me-3"><i class="fas fa-envelope text-muted"></i></div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.65rem;">Email Address</small>
                                <a href="mailto:@Model.User?.Email" class="text-success text-decoration-none fw-bold">@Model.User?.Email</a>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <div class="bg-light p-2 rounded-circle me-3"><i class="fas fa-phone text-muted"></i></div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.65rem;">Direct Phone</small>
                                <span class="fw-bold text-dark">@Model.User?.PhoneNumber</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-8">
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 20px;">
                        <div class="display-6 fw-bold text-success">@Model.PurchaseOrders.Count</div>
                        <div class="text-muted small text-uppercase fw-bold">Purchase Orders</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 20px;">
                        <div class="display-6 fw-bold text-primary">@Model.Orders.Count</div>
                        <div class="text-muted small text-uppercase fw-bold">Customer Orders</div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <ul class="nav nav-tabs nav-justified mb-4 border-0" id="retailerTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold border-0 bg-transparent text-muted text-success" id="about-tab" data-bs-toggle="tab" data-bs-target="#about" type="button">
                                <i class="fas fa-info-circle me-2"></i>Business Info
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold border-0 bg-transparent text-muted" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button">
                                <i class="fas fa-history me-2"></i>Order Trace
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!-- Business Info -->
                        <div class="tab-pane fade show active" id="about">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-4 border mb-3">
                                        <h6 class="text-muted small text-uppercase fw-bold mb-2">Branch Category</h6>
                                        <span class="badge @(Model.StoreSize == "Large" ? "bg-success" : (Model.StoreSize == "Medium" ? "bg-warning" : "bg-info")) px-3">@Model.StoreSize Segment</span>
                                        <div class="mt-2 fw-bold text-dark">@Model.BusinessType</div>
                                    </div>
                                    <div class="p-3 bg-light rounded-4 border">
                                        <h6 class="text-muted small text-uppercase fw-bold mb-2">HQ Address</h6>
                                        <p class="small mb-1">@Model.BusinessAddress</p>
                                        <p class="fw-bold small mb-0">@Model.City, @Model.Country</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-4 border mb-3 h-100">
                                        <h6 class="text-muted small text-uppercase fw-bold mb-2">Legal Credentials</h6>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="small text-muted">License:</span>
                                            <span class="fw-bold font-monospace">@Model.BusinessLicenseNumber</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="small text-muted">TIN:</span>
                                            <span class="fw-bold font-monospace">@Model.TaxIdentificationNumber</span>
                                        </div>
                                        <hr>
                                        <p class="small text-muted italic">@(string.IsNullOrEmpty(Model.Description) ? "No business description provided." : Model.Description)</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Orders Trace -->
                        <div class="tab-pane fade" id="orders">
                            @if (Model.PurchaseOrders.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead>
                                            <tr class="text-muted small">
                                                <th>PO #</th>
                                                <th>Supplier</th>
                                                <th>Amount</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var po in Model.PurchaseOrders.OrderByDescending(p => p.OrderDate).Take(10))
                                            {
                                                <tr>
                                                    <td class="fw-bold text-dark">@po.PONumber</td>
                                                    <td class="small">@po.Supplier?.CompanyName</td>
                                                    <td class="fw-bold text-success">$@po.TotalAmount.ToString("N2")</td>
                                                    <td>
                                                        <span class="badge bg-soft-success text-success rounded-pill px-3">@po.Status</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-ghost fa-3x text-muted opacity-25 mb-3"></i>
                                    <p class="text-muted mb-0">No transaction records found for this branch.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
            <div class="modal-header border-0 pb-0">
                <h4 class="modal-title fw-bold">Reject Retailer</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectUser" asp-route-id="@Model.UserId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted mb-4">You are rejecting <strong>@Model.BusinessName</strong>. This action is recorded.</p>
                    <div class="form-group">
                        <label class="form-label fw-bold small text-muted text-uppercase">Reason for Rejection</label>
                        <textarea class="form-control bg-light border-0 rounded-4 p-3 shadow-none" name="reason" rows="4" required placeholder="Explain the decision..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-soft-success { background-color: rgba(46, 125, 50, 0.05) !important; }
    .bg-success-soft { background-color: rgba(46, 125, 50, 0.1) !important; }
    .nav-tabs .nav-link.active { border-bottom: 3px solid #28a745 !important; color: #28a745 !important; }
    .avatar-xl { border: 4px solid rgba(255,255,255,0.2); }
</style>