@model IEnumerable<SCM_System.Models.Entities.Commission>
@{
    ViewData["Title"] = "Payouts";
    Layout = "_DashboardLayout";
    var allPayouts = Model?.Where(c => c.PaymentType == "SupplierPayout").ToList() ?? new List<SCM_System.Models.Entities.Commission>();
    var totalPayout  = allPayouts.Sum(c => c.CommissionAmount);
    var paidPayout   = allPayouts.Where(c => c.Status == "Paid").Sum(c => c.CommissionAmount);
    var pendingPayout = allPayouts.Where(c => c.Status == "Pending").Sum(c => c.CommissionAmount);
    var processingPayout = allPayouts.Where(c => c.Status == "Processing").Sum(c => c.CommissionAmount);
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center fin-page-header">
        <div>
            <div class="fin-page-title">Supplier & Retailer Payouts</div>
            <div class="fin-page-subtitle">Manage and track payouts to platform partners.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CommissionOverview" class="fin-action-btn">
                <i class="fas fa-chart-bar"></i> Finance Overview
            </a>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="finance-kpi-grid">
        <div class="fin-kpi-card">
            <i class="fas fa-money-bill-wave fin-kpi-icon"></i>
            <div>
                <div class="fin-kpi-value">@totalPayout.ToString("C0")</div>
                <div class="fin-kpi-label">Total Payouts</div>
                <div class="fin-kpi-trend neutral">@allPayouts.Count records</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #2E9C7A;">
            <i class="fas fa-check-circle fin-kpi-icon"></i>
            <div>
                <div class="fin-kpi-value">@paidPayout.ToString("C0")</div>
                <div class="fin-kpi-label">Paid Out</div>
                <div class="fin-kpi-trend positive">@allPayouts.Count(c => c.Status == "Paid") completed</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #E67E22;">
            <i class="fas fa-clock fin-kpi-icon" style="color:#E67E22;"></i>
            <div>
                <div class="fin-kpi-value">@pendingPayout.ToString("C0")</div>
                <div class="fin-kpi-label">Pending</div>
                <div class="fin-kpi-trend neutral">@allPayouts.Count(c => c.Status == "Pending") queued</div>
            </div>
        </div>
        <div class="fin-kpi-card" style="--accent: #5B8FF9;">
            <i class="fas fa-sync-alt fin-kpi-icon" style="color:#5B8FF9;"></i>
            <div>
                <div class="fin-kpi-value">@processingPayout.ToString("C0")</div>
                <div class="fin-kpi-label">Processing</div>
                <div class="fin-kpi-trend neutral">@allPayouts.Count(c => c.Status == "Processing") in pipeline</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="finance-filter-bar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-6">
                <div class="fin-search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="payoutSearch" placeholder="Search by supplier or retailer...">
                </div>
            </div>
            <div class="col-lg-3">
                <select id="payoutStatusFilter" class="form-select fin-filter-select" onchange="applyPayoutFilters()">
                    <option value="">All Status</option>
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                    <option value="Processing">Processing</option>
                </select>
            </div>
            <div class="col-lg-3 text-end">
                <button class="fin-action-btn" onclick="resetPayoutFilters()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Payout Table -->
    <div class="table-results-bar">
        <span class="results-count">
            Payout Records
            <span id="payoutCount" class="badge-soft badge-soft-info ms-1">@allPayouts.Count records</span>
        </span>
    </div>

    <div class="fin-panel">
        @if (!allPayouts.Any())
        {
            <div class="text-center py-5" style="color: var(--text-muted);">
                <i class="fas fa-money-check-alt fa-3x opacity-25 mb-3 d-block" style="color:#2E9C7A;"></i>
                <p>No payout records found.</p>
                <small>Payouts are generated automatically when orders are fulfilled.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table table-hover mb-0" id="payoutsTable">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Supplier / Entity</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Expires / Due</th>
                            <th class="pe-4 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in allPayouts.OrderByDescending(c => c.CreatedAt))
                        {
                            <tr data-status="@p.Status"
                                data-search="@(p.Supplier?.CompanyName) @(p.Retailer?.BusinessName)".ToLower()>
                                <td class="ps-4 fw-bold" style="font-family:monospace; color:var(--text-muted);">TXN-@p.Id.ToString("D6")</td>
                                <td>
                                    @if (p.Supplier != null)
                                    {
                                        <div style="font-weight:700; color:var(--text-color); font-size:14px;">
                                            <i class="fas fa-building me-2" style="color:#2E9C7A;"></i>@p.Supplier.CompanyName
                                        </div>
                                    }
                                    else if (p.Retailer != null)
                                    {
                                        <div style="font-weight:700; color:var(--text-color); font-size:14px;">
                                            <i class="fas fa-store me-2" style="color:#5B8FF9;"></i>@p.Retailer.BusinessName
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="color:var(--text-muted);">Platform</div>
                                    }
                                </td>
                                <td style="font-weight:800; color:#2E9C7A; font-size:15px;">@p.CommissionAmount.ToString("C")</td>
                                <td style="color:var(--text-muted); font-size:13px;">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td style="color:var(--text-muted); font-size:13px;">
                                    @if (p.PaidAt.HasValue) { @p.PaidAt.Value.ToString("MMM dd, yyyy") }
                                    else { <span>—</span> }
                                </td>
                                <td class="pe-4 text-center">
                                    @if (p.Status == "Paid") { <span class="payout-status-paid"><i class="fas fa-check"></i> Paid</span> }
                                    else if (p.Status == "Processing") { <span class="payout-status-processing"><i class="fas fa-sync-alt fa-spin"></i> Processing</span> }
                                    else { <span class="payout-status-pending"><i class="fas fa-clock"></i> Pending</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function applyPayoutFilters() {
            const search = document.getElementById('payoutSearch').value.toLowerCase();
            const status = document.getElementById('payoutStatusFilter').value;
            let count = 0;
            document.querySelectorAll('#payoutsTable tbody tr').forEach(row => {
                const rowStatus = row.dataset.status || '';
                const rowSearch = row.dataset.search || '';
                const show = (!search || rowSearch.includes(search)) && (!status || rowStatus === status);
                row.style.display = show ? '' : 'none';
                if (show) count++;
            });
            const el = document.getElementById('payoutCount');
            if (el) el.textContent = `${count} records`;
        }

        function resetPayoutFilters() {
            document.getElementById('payoutSearch').value = '';
            document.getElementById('payoutStatusFilter').value = '';
            applyPayoutFilters();
        }

        document.getElementById('payoutSearch')?.addEventListener('input', applyPayoutFilters);
    </script>
}
