@model List<SCM_System.Models.Entities.Commission>

@{
    ViewData["Title"] = "Financial Dashboard";
    Layout = "_DashboardLayout";
    var labels = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartLabels);
    var data = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartData);
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold">
                <i class="fas fa-chart-line text-primary me-2"></i>Financial Dashboard
            </h1>
            <p class="text-muted small mb-0">Real-time overview of platform revenue, commissions, and payouts.</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-download me-2"></i> Export Reports
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2">
                <li><a class="dropdown-item py-2" href="#" onclick="handlePdfExport()"><i class="fas fa-file-pdf me-2 text-danger"></i> Export as PDF</a></li>
                <li><a class="dropdown-item py-2" asp-action="ExportFinancials"><i class="fas fa-file-excel me-2 text-success"></i> Export as Excel</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2" asp-action="ExportAuditLogs"><i class="fas fa-history me-2 text-info"></i> Audit Logs CSV</a></li>
            </ul>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase mb-1">Total Revenue</div>
                            <div class="h3 mb-0 fw-bold">$@ViewBag.TotalRevenue.ToString("N2")</div>
                        </div>
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle">
                            <i class="fas fa-dollar-sign fa-xl"></i>
                        </div>
                    </div>
                    <div class="mt-3 small">
                        <span class="text-white-50"><i class="fas fa-arrow-up me-1"></i> 12.5%</span> 
                        <span class="text-white-50 opacity-75">since last month</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-success small fw-bold text-uppercase mb-1">Total Order Value</div>
                            <div class="h3 mb-0 fw-bold text-dark">$@ViewBag.TotalOrderValue.ToString("N2")</div>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fas fa-shopping-cart fa-xl text-success"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        <span class="text-success fw-bold">Gross Merchandise Value</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-warning small fw-bold text-uppercase mb-1">Pending Commissions</div>
                            <div class="h3 mb-0 fw-bold text-dark">$@ViewBag.PendingCommissionsValue.ToString("N2")</div>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fas fa-clock fa-xl text-warning"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        <span class="text-warning fw-bold">Awaiting Payment</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-info small fw-bold text-uppercase mb-1">Total Payouts</div>
                            <div class="h3 mb-0 fw-bold text-dark">$@ViewBag.TotalPayouts.ToString("N2")</div>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fas fa-hand-holding-usd fa-xl text-info"></i>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        <span class="text-info fw-bold">Distributed to Suppliers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Revenue Chart -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">Revenue Trend (Last 6 Months)</h6>
                    <div class="badge bg-light text-primary border px-3 py-2 rounded-pill">Platform Fees</div>
                </div>
                <div class="card-body px-4 pb-4">
                    <canvas id="revenueChart" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Distribution -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-0">
                    <h6 class="mb-0 fw-bold text-dark">Revenue Distribution</h6>
                </div>
                <div class="card-body px-4 text-center d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <div class="h1 fw-bold text-primary mb-1">@((ViewBag.TotalRevenue / (ViewBag.TotalOrderValue > 0 ? ViewBag.TotalOrderValue : 1) * 100).ToString("N1"))%</div>
                        <div class="text-muted small fw-bold text-uppercase">Effective Commission Rate</div>
                    </div>
                    <div class="progress rounded-pill mb-4" style="height: 12px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 70%" title="Paid"></div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 30%" title="Pending"></div>
                    </div>
                    <div class="d-flex justify-content-around text-start">
                        <div>
                            <div class="small text-muted mb-1"><i class="fas fa-circle text-primary me-2"></i>Paid</div>
                            <div class="fw-bold">$@ViewBag.TotalRevenue.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="small text-muted mb-1"><i class="fas fa-circle text-warning me-2"></i>Pending</div>
                            <div class="fw-bold">$@ViewBag.PendingCommissionsValue.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">Recent Financial Movements</h6>
                    <a asp-action="Transactions" class="btn btn-sm btn-light rounded-pill px-3 fw-bold">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-4 py-3">Reference</th>
                                    <th class="py-3">Supplier</th>
                                    <th class="py-3">Type</th>
                                    <th class="py-3 text-end">Amount</th>
                                    <th class="py-3">Status</th>
                                    <th class="pe-4 text-end py-3">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comm in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@comm.Id</div>
                                            <div class="text-muted x-small">Order: @comm.Order?.OrderNumber</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@comm.Supplier?.CompanyName</div>
                                            <div class="text-muted small">@comm.Supplier?.BusinessType</div>
                                        </td>
                                        <td>
                                            <span class="text-muted small fw-bold">@comm.PaymentType</span>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            $@comm.CommissionAmount.ToString("N2")
                                        </td>
                                        <td>
                                            <span class="badge bg-@(comm.Status == "Paid" ? "success" : "warning") rounded-pill px-3">
                                                @comm.Status
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end text-muted small">
                                            @comm.CreatedAt.ToString("MMM dd, yyyy")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .x-small { font-size: 0.7rem; }
    .card { transition: transform 0.2s ease-in-out; }
    .card:hover { transform: translateY(-3px); }

    @@media print {
        .btn, .dropdown, .sidebar, .navbar, .card-header .btn, .dropdown-menu {
            display: none !important;
        }
        .container-fluid {
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .card {
            border: 1px solid #eee !important;
            box-shadow: none !important;
            break-inside: avoid;
        }
        body {
            background: white !important;
        }
        .text-white {
            color: black !important;
        }
        .bg-primary, .bg-success, .bg-warning, .bg-info {
            background-color: transparent !important;
            color: black !important;
            border: 1px solid #ccc !important;
        }
        canvas {
            max-width: 100% !important;
            height: auto !important;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function handlePdfExport() {
            window.print();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(78, 115, 223, 0.2)');
            gradient.addColorStop(1, 'rgba(78, 115, 223, 0)');

            const revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(labels),
                    datasets: [{
                        label: 'Platform Revenue ($)',
                        data: @Html.Raw(data),
                        borderColor: '#4e73df',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#4e73df',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { 
                                callback: function(value) { return '$' + value.toLocaleString(); },
                                font: { size: 11 }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });
        });

    </script>
}
