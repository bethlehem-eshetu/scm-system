@model SCM_System.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Overview & Analytics";
    Layout = "_DashboardLayout";
}

<style>
    /* Welcome Section */
    .welcome-section {
        margin-top: 0;
        margin-bottom: 32px;
    }
    
    .welcome-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 24px;
        font-weight: 700;
        color: #1A5C4A;
        margin: 0;
    }
    
    .dark-mode .welcome-heading { color: #6AD4B5; }
    
    .welcome-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #2E9C7A;
    }
    
    .dark-mode .welcome-dot { background-color: #4BC0A0; }
    
    .welcome-subtext {
        font-size: 15px;
        color: #5A7A6E;
        margin: 4px 0 0 20px;
    }
    
    .dark-mode .welcome-subtext { color: #B8C5BE; }
    
    .welcome-underline {
        width: 60px;
        height: 3px;
        background: linear-gradient(90deg, #2E9C7A, transparent);
        margin-top: 12px;
        margin-left: 20px;
        border-radius: 2px;
    }

    .dark-mode .welcome-underline {
        background: linear-gradient(90deg, #4BC0A0, transparent);
    }

    /* KPI Cards */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid var(--border-color);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    
    .dark-mode .kpi-card {
        box-shadow: none;
    }
    
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.06);
        background: var(--hover-state);
    }

    .kpi-info h2 {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-color);
        margin: 8px 0 4px 0;
    }

    .kpi-info p {
        font-size: 14px;
        color: var(--text-muted);
        margin: 0;
        font-weight: 600;
    }

    .kpi-trend {
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .kpi-trend.up { color: #2E9C7A; }
    .kpi-trend.down { color: #E05A5A; }

    .kpi-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }
    
    .btn-action-btn {
        height: 36px;
        padding: 0 16px;
        border-radius: 10px;
        background: #2E9C7A;
        color: white;
        font-size: 14px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        transition: background 0.2s;
        border: none;
    }
    .btn-action-btn:hover {
        background: #278A6B;
        color: white;
    }
    .icon-blue { background: rgba(30, 136, 168, 0.1); color: #1E88A8; }
    .icon-green { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .icon-amber { background: rgba(230, 126, 34, 0.1); color: #E67E22; }
    .icon-indigo { background: rgba(11, 59, 47, 0.1); color: #0B3B2F; }

    /* Chart Layout */
    .chart-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .card-panel {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }
    
    .card-panel:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.06);
    }
    
    .dark-mode .card-panel {
        box-shadow: none;
    }
    
    .dark-mode .card-panel:hover {
        border-color: #4BC0A0;
    }

    /* Section Titles */
    .section-header {
        margin-bottom: 20px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.3px;
        margin-bottom: 6px;
        transition: transform 0.2s ease;
    }

    .section-title i {
        font-size: 14px;
        color: #2E9C7A;
    }

    .section-title span {
        color: #0B3B2F;
        transition: transform 0.2s ease;
    }

    .dark-mode .section-title span {
        color: #4BC0A0;
    }

    .section-underline {
        width: 40px;
        height: 2px;
        background: #2E9C7A;
        border-radius: 2px;
        transition: width 0.3s ease;
    }
    
    .card-panel:hover .section-title span {
        transform: translateX(4px);
    }
    
    .card-panel:hover .section-underline {
        width: 60px;
    }

    /* Alerts and Activity Layout */
    .bottom-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 40px;
    }

    /* Lists */
    .activity-list, .alert-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }
    
    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(11, 59, 47, 0.05);
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .activity-text p {
        margin: 0;
        font-size: 14px;
        color: var(--text-color);
        font-weight: 500;
    }

    .activity-text span {
        font-size: 12px;
        color: var(--text-muted);
    }

    /* Global Status Bar */
    .global-status {
        background: rgba(46, 156, 122, 0.1);
        border: 1px solid rgba(46, 156, 122, 0.2);
        border-radius: 8px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        color: #2E9C7A;
        font-weight: 600;
        font-size: 14px;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        background: #16A34A;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    /* Removed localized table CSS / badge styling -> Migrated to Global */
    
    @@media (max-width: 1024px) {
        .chart-layout { grid-template-columns: 1fr; }
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    
    @@media (max-width: 768px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .bottom-layout { grid-template-columns: 1fr; }
    }
    
    @@media (max-width: 480px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>

<!-- Welcome Section -->
<div class="welcome-section">
    <div class="welcome-heading">
        <div class="welcome-dot"></div>
        Welcome back, @(Context.Session.GetString("UserName") ?? "System Administrator")
    </div>
    <div class="welcome-subtext">Here's what's happening with your marketplace today.</div>
    <div class="welcome-underline"></div>
</div>

<!-- KPI Section -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-info">
            <p>Orders</p>
            <h2>@Model.TotalOrders</h2>
            <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> 12% <span>vs last week</span></div>
        </div>
        <div class="kpi-icon icon-blue"><i class="fas fa-box"></i></div>
    </div>
    
    <div class="kpi-card">
        <div class="kpi-info">
            <p>Total Revenue</p>
            <h2>ETB @((Model.TotalRevenue / 1000m).ToString("N1"))K</h2>
            <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> 8.4% <span>vs last week</span></div>
        </div>
        <div class="kpi-icon icon-green"><i class="fas fa-coins"></i></div>
    </div>

    <div class="kpi-card">
        <div class="kpi-info">
            <p>Suppliers</p>
            <h2>@Model.TotalSuppliers</h2>
            <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> @Model.PendingSuppliersCount pending</div>
        </div>
        <div class="kpi-icon icon-amber"><i class="fas fa-industry"></i></div>
    </div>

    <div class="kpi-card">
        <div class="kpi-info">
            <p>Retailers</p>
            <h2>@Model.TotalRetailers</h2>
            <div class="kpi-trend up"><i class="fas fa-arrow-up"></i> @Model.PendingRetailersCount pending</div>
        </div>
        <div class="kpi-icon icon-indigo"><i class="fas fa-shopping-bag"></i></div>
    </div>
</div>

<!-- Charts Section -->
<div class="chart-layout">
    <div class="card-panel">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="section-header mb-0">
                <div class="section-title">
                    <i class="fas fa-gem"></i>
                    <span>Orders vs Revenue</span>
                </div>
                <div class="section-underline"></div>
            </div>
            <select id="rangeFilter" class="form-select border-0 fw-medium shadow-sm" style="width:140px; font-size:13px; border-radius:6px; cursor:pointer; background-color: var(--bg-color); color: var(--text-color);">
                <option value="7" selected>Last 7 Days</option>
                <option value="14">Last 14 Days</option>
                <option value="30">Last 30 Days</option>
            </select>
        </div>
        <div style="height: 300px; width: 100%;">
            <canvas id="platformActivityChart"></canvas>
        </div>
    </div>

    <div class="card-panel">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="section-header mb-0">
                <div class="section-title">
                    <i class="fas fa-gem"></i>
                    <span>Top Categories</span>
                </div>
                <div class="section-underline"></div>
            </div>
            <a href="/Admin/CategoriesReport" class="text-decoration-none text-primary" style="font-size:13px; font-weight:600;">View All</a>
        </div>
        <div style="height: 300px; width: 100%;">
            <canvas id="categoryDistributionChart"></canvas>
        </div>
    </div>
</div>

<!-- Alerts & Activity Section -->
<div class="bottom-layout">
    <div class="card-panel">
        <div class="section-header">
            <div class="section-title">
                <i class="fas fa-gem"></i>
                <span>Recent Activity</span>
            </div>
            <div class="section-underline"></div>
        </div>
        <ul class="activity-list">
            <li class="activity-item">
                <div class="activity-icon"><i class="fas fa-store"></i></div>
                <div class="activity-text">
                    <p>New supplier registration: Unity Auto Parts</p>
                    <span>2 hours ago</span>
                </div>
            </li>
            <li class="activity-item">
                <div class="activity-icon"><i class="fas fa-check-circle text-success"></i></div>
                <div class="activity-text">
                    <p>Order #10294 marked as completed</p>
                    <span>4 hours ago</span>
                </div>
            </li>
            <li class="activity-item">
                <div class="activity-icon"><i class="fas fa-exchange-alt text-primary"></i></div>
                <div class="activity-text">
                    <p>Commission payout processed: ETB 12,500</p>
                    <span>Yesterday at 14:30</span>
                </div>
            </li>
            <li class="activity-item">
                <div class="activity-icon"><i class="fas fa-store"></i></div>
                <div class="activity-text">
                    <p>Retailer profile updated: Fresh Foods Co.</p>
                    <span>Yesterday at 09:15</span>
                </div>
            </li>
        </ul>
    </div>

    <div class="card-panel">
        <div class="section-header">
            <div class="section-title">
                <i class="fas fa-gem"></i>
                <span>Priority Alerts</span>
            </div>
            <div class="section-underline"></div>
        </div>
        <ul class="alert-list">
            <li class="activity-item">
                <div class="activity-icon" style="background: rgba(220, 38, 38, 0.1); color: #DC2626;"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="activity-text">
                    <p>2 delayed deliveries in Central Hub</p>
                    <div class="mt-1"><span class="badge-soft badge-danger"><i class="fas fa-circle" style="font-size: 6px;"></i> Requires attention</span></div>
                </div>
                <div class="ms-auto pt-2"><a href="#" class="btn btn-sm btn-outline-card fw-medium px-3 text-decoration-none" style="border-radius:8px;">View</a></div>
            </li>
            <li class="activity-item">
                <div class="activity-icon" style="background: rgba(245, 158, 11, 0.1); color: #D97706;"><i class="fas fa-user-clock"></i></div>
                <div class="activity-text">
                    <p>@Model.PendingSuppliersCount pending supplier approvals</p>
                    <div class="mt-1"><span class="badge-soft badge-warning"><i class="fas fa-circle" style="font-size: 6px;"></i> Action needed</span></div>
                </div>
                <div class="ms-auto pt-2"><a asp-action="PendingUsers" class="btn btn-sm btn-outline-card fw-medium px-3 text-decoration-none" style="border-radius:8px;">Review</a></div>
            </li>
        </ul>
<!-- Stats Footer -->
<div class="card-panel mt-4 mb-4 d-flex justify-content-center align-items-center flex-wrap gap-4 shadow-sm" style="padding: 16px; border-radius: 12px; margin-top: 0;">
    <div class="text-center px-4">
        <span class="text-muted d-block text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight:600;">Total Orders This Month</span>
        <strong style="color: var(--text-color); font-size: 18px;">@Model.TotalOrders</strong>
    </div>
    <div style="width: 1px; height: 32px; background: var(--border-color);"></div>
    <div class="text-center px-4">
        <span class="text-muted d-block text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight:600;">Avg Order Value</span>
        <strong style="color: var(--text-color); font-size: 18px;">ETB @Model.AvgOrderValue.ToString("N1")</strong>
    </div>
    <div style="width: 1px; height: 32px; background: var(--border-color);"></div>
    <div class="text-center px-4">
        <span class="text-muted d-block text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight:600;">Conversion Rate</span>
        <strong style="color: var(--text-color); font-size: 18px;">3.2%</strong>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data from Backend
        const categoryLabels = @Html.Raw(Json.Serialize(ViewBag.CategoryLabels));
        const categoryData = @Html.Raw(Json.Serialize(ViewBag.CategoryData));

        // Chart defaults
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = '#64748B';

        // Initialize Activity Chart
        let activityChart;
        const ctxActivity = document.getElementById('platformActivityChart').getContext('2d');
        
        function initActivityChart() {
            activityChart = new Chart(ctxActivity, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: 'Orders',
                            data: [],
                            borderColor: '#2E9C7A',
                            backgroundColor: 'rgba(46, 156, 122, 0.1)',
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'yOrders'
                        },
                        {
                            label: 'Revenue (ETB)',
                            data: [],
                            borderColor: '#1E88A8',
                            backgroundColor: 'rgba(30, 136, 168, 0.1)',
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'yRevenue'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { position: 'top', align: 'end' },
                        tooltip: {
                            backgroundColor: '#0B3B2F',
                            padding: 12,
                            titleFont: { size: 13 },
                            bodyFont: { size: 14, weight: 'bold' },
                            cornerRadius: 8,
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        yOrders: { 
                            type: 'linear', 
                            display: true, 
                            position: 'left',
                            grid: { color: 'rgba(111, 126, 120, 0.1)' }
                        },
                        yRevenue: { 
                            type: 'linear', 
                            display: true, 
                            position: 'right',
                            grid: { drawOnChartArea: false }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
            window.activityChartInstance = activityChart;
        }

        // Fetch Dynamic Stats
        function loadChart(range) {
            fetch(`/Admin/GetDashboardStats?range=${range}`)
                .then(res => res.json())
                .then(data => {
                    activityChart.data.labels = data.map(x => x.date);
                    activityChart.data.datasets[0].data = data.map(x => x.orders);
                    activityChart.data.datasets[1].data = data.map(x => x.revenue);
                    activityChart.update();
                    updateChartTheme(); // Ensure colors match current theme
                })
                .catch(err => console.error("Error loading stats", err));
        }

        document.getElementById("rangeFilter").addEventListener("change", function () {
            loadChart(this.value);
        });

        // Initialize and load default
        initActivityChart();
        loadChart(7);

        // Top Categories (Horizontal Bar Chart)
        const ctxCategory = document.getElementById('categoryDistributionChart').getContext('2d');
        const categoryChartInstance = new Chart(ctxCategory, {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Volume %',
                    data: categoryData,
                    backgroundColor: [
                        '#2E9C7A', '#5B8FF9', '#E67E22', '#0B3B2F', '#A3B3AC'
                    ],
                    borderWidth: 0,
                    borderRadius: 4,
                    barThickness: 16
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0B3B2F',
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: { max: 100, display: false },
                    y: { grid: { display: false }, ticks: { font: { weight: 'bold' } } }
                }
            }
        });
        window.categoryChartInstance = categoryChartInstance;

        // Auto-Theme Synchronizer for Chart.js
        const updateChartTheme = () => {
             const isDark = document.body.classList.contains('dark-mode');
             const gridColor = isDark ? '#2A3530' : '#E2E8E4';
             const tooltipBg = isDark ? '#1E2421' : '#0B3B2F';
             const axisText = isDark ? '#B8C5BE' : '#7C8F86';
             const tooltipText = '#FFFFFF';

             if(window.activityChartInstance) {
                 window.activityChartInstance.options.scales.yOrders.grid.color = gridColor;
                 window.activityChartInstance.options.scales.x.grid.color = gridColor;
                 window.activityChartInstance.options.plugins.tooltip.backgroundColor = tooltipBg;
                 window.activityChartInstance.options.scales.x.ticks.color = axisText;
                 window.activityChartInstance.options.scales.yOrders.ticks.color = axisText;
                 window.activityChartInstance.options.scales.yRevenue.ticks.color = axisText;
                 
                 // Deep Green & Light Blue variables based on user spec
                 window.activityChartInstance.data.datasets[0].borderColor = isDark ? '#4BC0A0' : '#2E9C7A';
                 window.activityChartInstance.data.datasets[0].backgroundColor = isDark ? 'rgba(75, 192, 160, 0.2)' : 'rgba(46, 156, 122, 0.1)';
                 window.activityChartInstance.data.datasets[1].borderColor = isDark ? '#7BA3FF' : '#5B8FF9';
                 window.activityChartInstance.data.datasets[1].backgroundColor = isDark ? 'rgba(123, 163, 255, 0.2)' : 'rgba(91, 143, 249, 0.1)';
                 window.activityChartInstance.update();
             }

             if(window.categoryChartInstance) {
                 window.categoryChartInstance.options.plugins.tooltip.backgroundColor = tooltipBg;
                 window.categoryChartInstance.options.scales.y.ticks.color = axisText;
                 window.categoryChartInstance.update();
             }
        };

        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.attributeName === 'class') updateChartTheme();
            });
        });
        observer.observe(document.body, { attributes: true });
        
        // Trigger initial theme layout match
        setTimeout(updateChartTheme, 50);
    </script>
}
