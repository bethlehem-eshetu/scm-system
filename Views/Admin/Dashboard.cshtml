@model SCM_System.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Overview & Analytics";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5 px-4">
    <!-- Page Header with Shimmer Effect (Themed Green) -->
    <!-- Welcome Section (Restored Original Design) -->
    <div class="welcome-section mb-5 animate-slide-up">
        <div class="welcome-icon">●</div>
        <div>
            <h1 class="text-dark-green fw-bold">Welcome back, @(Context.Session.GetString("UserName") ?? "System Administrator")</h1>
            <p class="text-muted fs-5 mb-1">Here's what's happening with your marketplace today.</p>
            <div class="welcome-underline"></div>
        </div>
    </div>


    <!-- KPI Section (SCM Style) -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Total Orders</p>
                        <h2 class="fw-bold mb-0 text-dark-green">@Model.TotalOrders</h2>
                    </div>
                    <div class="bg-faint-green p-3 rounded-4 text-dark-green">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
                <div class="kpi-trend up text-success small fw-bold">
                    <i class="fas fa-arrow-up me-1"></i> 12% <span class="text-muted fw-normal">vs last week</span>
                </div>
            </div>
        </div>
        
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-dark-green text-white shadow-premium h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-white-50 small text-uppercase fw-bold ls-1 mb-1">Revenue</p>
                        <h2 class="fw-bold mb-0 text-accent-green">@((Model.TotalRevenue / 1000m).ToString("N1"))K</h2>
                    </div>
                    <div class="bg-white bg-opacity-10 p-3 rounded-4 text-accent-green">
                        <i class="fas fa-coins"></i>
                    </div>
                </div>
                <div class="kpi-trend up text-accent-green small fw-bold">
                    <i class="fas fa-arrow-up me-1"></i> 8.4% <span class="text-white-50 fw-normal">Growth</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Suppliers</p>
                        <h2 class="fw-bold mb-0 text-dark-green">@Model.TotalSuppliers</h2>
                    </div>
                    <div class="bg-faint-green p-3 rounded-4 text-dark-green">
                        <i class="fas fa-industry"></i>
                    </div>
                </div>
                <div class="text-warning small fw-bold">
                    <i class="fas fa-clock me-1"></i> @Model.PendingSuppliersCount <span class="text-muted fw-normal">pending</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Retailers</p>
                        <h2 class="fw-bold mb-0 text-dark-green">@Model.TotalRetailers</h2>
                    </div>
                    <div class="bg-faint-green p-3 rounded-4 text-dark-green">
                        <i class="fas fa-shopping-bag"></i>
                    </div>
                </div>
                <div class="text-warning small fw-bold">
                    <i class="fas fa-clock me-1"></i> @Model.PendingRetailersCount <span class="text-muted fw-normal">pending</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-5">
        <div class="col-xl-8">
            <div class="card border-0 rounded-5 bg-white shadow-premium p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1 text-dark-green">Activity Analytics</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">Orders vs Revenue</h4>
                    </div>
                    <select id="rangeFilter" class="form-select form-select-sm border-0 bg-faint-green fw-bold rounded-pill px-3" style="width:140px;">
                        <option value="7" selected>Last 7 Days</option>
                        <option value="14">Last 14 Days</option>
                        <option value="30">Last 30 Days</option>
                    </select>
                </div>
                <div style="height: 320px; width: 100%;">
                    <canvas id="platformActivityChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 rounded-5 bg-white shadow-premium p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1 text-dark-green">Distribution</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">Top Categories</h4>
                    </div>
                    <a href="/Admin/CategoriesReport" class="text-decoration-none text-dark-green small fw-bold">View All</a>
                </div>
                <div style="height: 320px; width: 100%;">
                    <canvas id="categoryDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts & Activity Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 rounded-5 bg-white shadow-premium overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-0 border-bottom border-faint">
                    <h5 class="fw-bold mb-0 text-dark-green">Recent Activity</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-faint p-4 bg-transparent">
                            <div class="d-flex gap-3">
                                <div class="bg-faint-green text-dark-green rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-store"></i>
                                </div>
                                <div>
                                    <p class="fw-bold text-dark-green mb-1">New supplier registration: Unity Auto Parts</p>
                                    <span class="extra-small text-muted fw-bold">2 hours ago</span>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item border-faint p-4 bg-transparent">
                            <div class="d-flex gap-3">
                                <div class="bg-soft-success text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <div>
                                    <p class="fw-bold text-dark-green mb-1">Order #10294 marked as completed</p>
                                    <span class="extra-small text-muted fw-bold">4 hours ago</span>
                                </div>
                            </div>
                        </div>
                         <div class="list-group-item border-faint p-4 bg-transparent">
                            <div class="d-flex gap-3">
                                <div class="bg-soft-primary text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <div>
                                    <p class="fw-bold text-dark-green mb-1">Commission payout processed: ETB 12,500</p>
                                    <span class="extra-small text-muted fw-bold">Yesterday at 14:30</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 rounded-5 bg-white shadow-premium overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-0 border-bottom border-faint">
                    <h5 class="fw-bold mb-0 text-dark-green">Priority Alerts</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                         <div class="list-group-item border-faint p-4 bg-transparent">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex gap-3">
                                    <div class="bg-soft-danger text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </div>
                                    <div>
                                        <p class="fw-bold text-dark-green mb-1">2 delayed deliveries in Central Hub</p>
                                        <span class="status-badge bg-soft-danger text-danger">Requires attention</span>
                                    </div>
                                </div>
                                <a href="#" class="btn btn-faint-green text-dark-green rounded-pill px-3 py-1 fw-bold extra-small">View</a>
                            </div>
                        </div>
                        <div class="list-group-item border-faint p-4 bg-transparent">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex gap-3">
                                    <div class="bg-soft-warning text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fas fa-user-clock"></i>
                                    </div>
                                    <div>
                                        <p class="fw-bold text-dark-green mb-1">@Model.PendingSuppliersCount pending supplier approvals</p>
                                        <span class="status-badge bg-soft-warning text-warning">Action needed</span>
                                    </div>
                                </div>
                                <a asp-action="PendingUsers" class="btn btn-faint-green text-dark-green rounded-pill px-3 py-1 fw-bold extra-small">Review</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }

        /* Welcome Section Premium Fixes */
        .welcome-section {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .welcome-icon {
            color: #2E9C7A;
            font-size: 28px;
            line-height: 1;
            margin-top: 5px;
        }

        .welcome-underline {
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #2E9C7A 0%, transparent 100%);
            border-radius: 2px;
            margin-top: 12px;
        }
        
        .welcome-banner { position: relative; border-radius: 40px !important; }
        .banner-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.05; z-index: 1; }
        .banner-glow { position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(212, 240, 109, 0.1) 0%, transparent 70%); filter: blur(50px); z-index: 1; }
        .btn-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); color: white; border-radius: 20px; transition: all 0.3s; }
        .btn-glass:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }

        .shimmer-text { background: linear-gradient(135deg, #ffffff 0%, #d4f06d 50%, #ffffff 100%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shimmer 3s ease-in-out infinite; }
        .gradient-shimmer { background: linear-gradient(90deg, #fff, #d4f06d, #fff); background-size: 300% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shimmer 4s linear infinite; font-weight: 700; }
        @@keyframes shimmer { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }
        .extra-small { font-size: 0.7rem; }
        .tracking-wider { letter-spacing: 1px; }

        .status-badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }

        .animate-slide-up { animation: slideUp 0.6s ease-out; }
        @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748B';

            let activityChart;
            const ctxActivity = document.getElementById('platformActivityChart').getContext('2d');
            
            function initActivityChart() {
                activityChart = new Chart(ctxActivity, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [
                            {
                                label: 'Orders',
                                data: [],
                                borderColor: '#2E9C7A',
                                backgroundColor: 'rgba(46, 156, 122, 0.1)',
                                fill: true,
                                tension: 0.4,
                                yAxisID: 'yOrders'
                            },
                            {
                                label: 'Revenue (ETB)',
                                data: [],
                                borderColor: '#4da699',
                                backgroundColor: 'rgba(77, 166, 153, 0.1)',
                                fill: true,
                                tension: 0.4,
                                yAxisID: 'yRevenue'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top', align: 'end' } },
                        scales: {
                            yOrders: { type: 'linear', display: true, position: 'left', grid: { color: 'rgba(0,0,0,0.05)' } },
                            yRevenue: { type: 'linear', display: true, position: 'right', grid: { display: false } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            function loadChart(range) {
                $.get(`/Admin/GetDashboardStats?range=${range}`, function(data) {
                    activityChart.data.labels = data.map(x => x.date);
                    activityChart.data.datasets[0].data = data.map(x => x.orders);
                    activityChart.data.datasets[1].data = data.map(x => x.revenue);
                    activityChart.update();
                });
            }

            initActivityChart();
            loadChart(7);

            $('#rangeFilter').on('change', function() { loadChart($(this).val()); });

            const ctxCategory = document.getElementById('categoryDistributionChart').getContext('2d');
            new Chart(ctxCategory, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                    datasets: [{
                        label: 'Volume %',
                        data: @Html.Raw(Json.Serialize(ViewBag.CategoryData)),
                        backgroundColor: ['#1a3d31', '#d4f06d', '#4da699', '#122921', '#a3b3ac'],
                        borderWidth: 0,
                        borderRadius: 8,
                        barThickness: 20
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                        y: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}
