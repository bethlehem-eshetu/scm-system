@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
}

<!-- Page Header with Shimmer Effect -->
<div class="container-fluid py-5 position-relative overflow-hidden mb-4" style="background: linear-gradient(135deg, #0a1a2f 0%, #0d2b3e 100%); border-bottom: 1px solid rgba(59, 130, 246, 0.2);">
    <div class="container position-relative z-1">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <!-- Welcome Message with Shimmer Effect -->
                <div class="welcome-shimmer mb-2">
                    <h1 class="text-white mb-2 shimmer-text">
                        <i class="fas fa-user-shield me-2"></i>Welcome back, <span class="gradient-shimmer">@(Context.Session.GetString("UserName") ?? "System Administrator")</span>!
                    </h1>
                </div>
                <p class="text-white-70 mb-0">
                    <i class="fas fa-calendar-alt me-2"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </p>
            </div>
            <div class="stats-badge bg-white bg-opacity-10 rounded-3 px-4 py-2">
                <span class="text-white">
                    <i class="fas fa-chart-line me-2"></i>Live Dashboard
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <style>
        /* Shimmer Effect Styles */
        .shimmer-text {
            background: linear-gradient(135deg, #ffffff 0%, #60a5fa 50%, #ffffff 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer-gold 3s ease-in-out infinite;
        }
        
        .gradient-shimmer {
            background: linear-gradient(90deg, #fff, #3b82f6, #60a5fa, #fff);
            background-size: 300% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 4s linear infinite;
            font-weight: 700;
        }
        
        @@keyframes shimmer {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 200% 50%; }
        }
        
        @@keyframes shimmer-gold {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 200% 50%; }
        }
        
        .welcome-shimmer {
            position: relative;
        }
        
        .welcome-shimmer::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shine 3s infinite;
        }
        
        @@keyframes shine {
            0% { left: -100%; }
            20% { left: 100%; }
            100% { left: 100%; }
        }
        
        /* Stat Card Styles */
        .stat-card {
            border-radius: 20px;
            border: none;
            overflow: hidden;
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1;
        }
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }
        .bg-gradient-primary { background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); color: white; }
        .bg-gradient-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
        .bg-gradient-warning { background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%); color: white; }
        .bg-gradient-info { background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; }
        
        .stat-card .text-muted {
            color: rgba(255, 255, 255, 0.8) !important;
        }
        
        .stat-icon-wrapper {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        }
        
        .stat-card .progress {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }
        
        .stat-card .progress-bar {
            background-color: #ffffff;
            border-radius: 10px;
        }
        
        .stat-badge {
            background: rgba(255, 255, 255, 0.15);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            backdrop-filter: blur(5px);
        }
        
        /* Glass Card Styles */
        .glass-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            border: 1px solid rgba(59, 130, 246, 0.2);
            transition: all 0.3s ease;
        }
        
        .glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }
        
        /* Stats Badge */
        .stats-badge {
            backdrop-filter: blur(10px);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
    </style>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Suppliers Card -->
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card bg-gradient-primary mb-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h6 class="text-white text-opacity-75 mb-1 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Suppliers</h6>
                            <h2 class="mb-0 fw-bold text-white display-6">@ViewBag.TotalSuppliers</h2>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-building fa-2x text-white"></i>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="stat-badge text-white">
                            <i class="fas fa-check-circle me-1"></i>@ViewBag.VerifiedSuppliers Verified
                        </span>
                        <span class="stat-badge text-white">
                            <i class="fas fa-times-circle me-1"></i>@ViewBag.RejectedSuppliers Rejected
                        </span>
                    </div>

                    <div class="mt-auto">
                        <a asp-action="AllSuppliers" class="stretched-link"></a>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-white text-opacity-75 fw-medium">Pending: @ViewBag.PendingSuppliers</small>
                            <small class="text-white fw-bold">@(ViewBag.TotalSuppliers > 0 ? (ViewBag.VerifiedSuppliers * 100 / ViewBag.TotalSuppliers) : 0)%</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar" style="width: @(ViewBag.TotalSuppliers > 0 ? (ViewBag.VerifiedSuppliers * 100 / ViewBag.TotalSuppliers) : 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Retailers Card -->
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card bg-gradient-success mb-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h6 class="text-white text-opacity-75 mb-1 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Retailers</h6>
                            <h2 class="mb-0 fw-bold text-white display-6">@ViewBag.TotalRetailers</h2>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-store fa-2x text-white"></i>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="stat-badge text-white">
                            <i class="fas fa-check-circle me-1"></i>@ViewBag.ApprovedRetailers Approved
                        </span>
                        <span class="stat-badge text-white">
                            <i class="fas fa-times-circle me-1"></i>@ViewBag.RejectedRetailers Rejected
                        </span>
                    </div>

                    <div class="mt-auto">
                        <a asp-action="AllRetailers" class="stretched-link"></a>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-white text-opacity-75 fw-medium">Pending: @ViewBag.PendingRetailers</small>
                            <small class="text-white fw-bold">@(ViewBag.TotalRetailers > 0 ? (ViewBag.ApprovedRetailers * 100 / ViewBag.TotalRetailers) : 0)%</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar" style="width: @(ViewBag.TotalRetailers > 0 ? (ViewBag.ApprovedRetailers * 100 / ViewBag.TotalRetailers) : 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Approvals Card -->
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card bg-gradient-warning mb-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h6 class="text-white text-opacity-75 mb-1 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Pending Apps</h6>
                            <h2 class="mb-0 fw-bold text-white display-6">@(ViewBag.PendingSuppliers + ViewBag.PendingRetailers)</h2>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-user-clock fa-2x text-white"></i>
                        </div>
                    </div>
                    
                    <div class="mt-auto">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3 mb-2 backdrop-blur">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-white"><i class="fas fa-building me-2"></i>Suppliers</span>
                                <span class="badge bg-white text-warning rounded-pill px-3 py-1">@ViewBag.PendingSuppliers</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-white"><i class="fas fa-store me-2"></i>Retailers</span>
                                <span class="badge bg-white text-warning rounded-pill px-3 py-1">@ViewBag.PendingRetailers</span>
                            </div>
                        </div>
                    </div>
                    <a asp-action="PendingUsers" class="stretched-link"></a>
                </div>
            </div>
        </div>

        <!-- Total Products Card -->
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card bg-gradient-info mb-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h6 class="text-white text-opacity-75 mb-1 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Products</h6>
                            <h2 class="mb-0 fw-bold text-white display-6">@ViewBag.TotalProducts</h2>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-box-open fa-2x text-white"></i>
                        </div>
                    </div>
                    
                    <div class="mt-auto">
                        <div class="d-flex align-items-center justify-content-between bg-white bg-opacity-25 rounded-3 p-3">
                            <div class="d-flex align-items-center text-white">
                                <i class="fas fa-shopping-cart fa-lg me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">@ViewBag.TotalOrders</h6>
                                    <small class="text-white text-opacity-75">Total Orders</small>
                                </div>
                            </div>
                            <i class="fas fa-chevron-right text-white text-opacity-50"></i>
                        </div>
                    </div>
                    <a href="#" class="stretched-link"></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-5">
        <div class="col-md-8">
            <div class="glass-card p-4 h-100">
                <h5 class="mb-4 fw-bold"><i class="fas fa-chart-line me-2 text-primary"></i>Platform Activity</h5>
                <canvas id="platformActivityChart" height="100"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <h5 class="mb-4 fw-bold"><i class="fas fa-list-alt me-2 text-success"></i>Top Categories</h5>
                <canvas id="topCategoriesChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="row g-4">
        <!-- Recent Suppliers -->
        <div class="col-md-6 mb-4">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-building me-2 text-primary"></i>Recent Suppliers</h5>
                    <a asp-action="AllSuppliers" class="btn btn-sm btn-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentSuppliers != null && ((IEnumerable<dynamic>)ViewBag.RecentSuppliers).Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var supplier in ViewBag.RecentSuppliers)
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">@supplier.CompanyName</h6>
                                            <small class="text-muted">
                                                <i class="fas fa-user me-1"></i>@(supplier.User?.FullName ?? "N/A") |
                                                <i class="fas fa-calendar me-1"></i>@supplier.CreatedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                        <div>
                                            <span class="badge bg-@(supplier.VerificationStatus == "Verified" ? "success" : supplier.VerificationStatus == "Pending" ? "warning" : "danger") me-2">
                                                @supplier.VerificationStatus
                                            </span>
                                            <a asp-action="SupplierDetails" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-building fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No suppliers found</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Retailers -->
        <div class="col-md-6 mb-4">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-store me-2 text-success"></i>Recent Retailers</h5>
                    <a asp-action="AllRetailers" class="btn btn-sm btn-success">View All</a>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentRetailers != null && ((IEnumerable<dynamic>)ViewBag.RecentRetailers).Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var retailer in ViewBag.RecentRetailers)
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">@retailer.BusinessName</h6>
                                            <small class="text-muted">
                                                <i class="fas fa-user me-1"></i>@(retailer.User?.FullName ?? "N/A") |
                                                <i class="fas fa-calendar me-1"></i>@retailer.CreatedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                        <div>
                                            @if (retailer.User != null)
                                            {
                                                if (retailer.User.IsApproved)
                                                {
                                                    <span class="badge bg-success me-2">Approved</span>
                                                }
                                                else if (retailer.User.AccountStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger me-2">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark me-2">Pending</span>
                                                }
                                            }
                                            <a asp-action="RetailerDetails" asp-route-id="@retailer.Id" class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-store fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No retailers found</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Platform Activity Chart
        const ctxActivity = document.getElementById('platformActivityChart').getContext('2d');
        new Chart(ctxActivity, {
            type: 'line',
            data: {
                labels: ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr'],
                datasets: [{
                    label: 'Orders',
                    data: [15, 20, 35, 40, 25, 52],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: 'rgba(255,255,255,0.7)' }
                    }
                },
                scales: {
                    y: {
                        grid: { color: 'rgba(255,255,255,0.1)' },
                        ticks: { color: 'rgba(255,255,255,0.7)' }
                    },
                    x: {
                        grid: { color: 'rgba(255,255,255,0.1)' },
                        ticks: { color: 'rgba(255,255,255,0.7)' }
                    }
                }
            }
        });

        // Top Categories Chart
        const ctxCategories = document.getElementById('topCategoriesChart').getContext('2d');
        new Chart(ctxCategories, {
            type: 'doughnut',
            data: {
                labels: ['Electronics', 'Furniture', 'Clothing', 'Industrial'],
                datasets: [{
                    data: [45, 25, 20, 10],
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ec4899'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: 'rgba(255,255,255,0.7)', padding: 15 }
                    }
                }
            }
        });
    </script>
}