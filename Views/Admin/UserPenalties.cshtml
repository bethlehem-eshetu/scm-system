@model List<SCM_System.Models.Entities.Penalty>

@{
    ViewData["Title"] = $"Penalties for {ViewBag.UserName}";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-user-circle me-2 text-primary"></i>
            Penalties: @ViewBag.UserName
            <small class="text-muted fs-6">(@ViewBag.UserRole)</small>
        </h1>
        <a asp-action="Penalties" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to All Penalties
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-history me-2 text-primary"></i>Penalty History
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h5 class="text-muted">No penalties for this user</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Penalty Type</th>
                                <th>Reason</th>
                                <th>Date</th>
                                <th>Expires</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var penalty in Model)
                            {
                                bool isExpired = penalty.ExpiresAt.HasValue && penalty.ExpiresAt.Value < DateTime.Now;
                                bool isActive = penalty.IsActive && !isExpired;
                                
                                <tr>
                                    <td>#@penalty.Id</td>
                                    <td>
                                        @if (penalty.PenaltyType == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">Warning</span>
                                        }
                                        else if (penalty.PenaltyType == "Message Restriction")
                                        {
                                            <span class="badge bg-info">Restricted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Suspended</span>
                                        }
                                    </td>
                                    <td>@penalty.Reason</td>
                                    <td>@penalty.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (penalty.ExpiresAt.HasValue)
                                        {
                                            @penalty.ExpiresAt.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-danger">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>