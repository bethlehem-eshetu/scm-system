@model SCM_System.Models.Entities.User
@{
    ViewData["Title"] = "User Details";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>User Details</h1>
        <a asp-action="AllUsers" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-3 text-center mb-4 mb-md-0">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 120px; height: 120px; font-size: 3rem;">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <h4 class="fw-bold">@Model.FullName</h4>
                    <span class="badge bg-secondary">@(string.IsNullOrEmpty(Model.Role) ? "No Role Assigned" : Model.Role)</span>
                    
                    <div class="mt-3">
                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">Account Active</span>
                        }
                        else if (Model.AccountStatus == "Suspended")
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill">Account Suspended</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">Account Pending/Rejected</span>
                        }
                    </div>
                </div>
                
                <div class="col-md-9">
                    <h5 class="border-bottom pb-2 mb-3">Account Information</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Email Address</label>
                            <p class="fw-medium">@Model.Email</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Phone Number</label>
                            <p class="fw-medium">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Joined Date</label>
                            <p class="fw-medium">@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Fayda ID Number</label>
                            <p class="fw-medium font-monospace">@(string.IsNullOrEmpty(Model.FAN) ? "N/A" : Model.FAN)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Fayda Verification Status</label>
                            <div>
                                @if (Model.IsFaydaVerified)
                                {
                                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                }
                                else if (Model.FaydaStatus == "Rejected")
                                {
                                    <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i>Rejected</span>
                                }
                                else
                                {
                                    <span class="text-secondary fw-bold"><i class="fas fa-clock me-1"></i>Pending</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <form asp-action="SuspendUser" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning rounded-pill px-4" onclick="return confirm('Suspend this user?');">
                                <i class="fas fa-ban me-2"></i>Suspend User
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
