@model IEnumerable<SCM_System.Models.Entities.Warehouse>
@{
    ViewData["Title"] = "Logistics Hubs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 logistics-hubs-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-1"><i class="fas fa-warehouse me-2"></i>Logistics Hubs</h4>
            <p class="text-muted small mb-0">Monitor storage nodes and inventory distribution points</p>
        </div>
        <a asp-action="CreateWarehouse" class="btn btn-primary rounded-pill px-3 py-2 fw-bold shadow-sm small">
            <i class="fas fa-plus me-2"></i> Create New Hub
        </a>
    </div>

    <!-- Filters & Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-premium rounded-5 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="warehouseSearch" class="form-control border-0 bg-transparent" placeholder="Search by hub name, code or city...">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-premium rounded-5 bg-primary text-white h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small opacity-75 fw-bold text-uppercase">Total Fleet Capacity</div>
                        <h4 class="fw-bold mb-0">@Model.Sum(w => w.MaxCapacity).ToString("N0") <span class="small font-weight-normal">Units</span></h4>
                    </div>
                    <i class="fas fa-chart-area fa-2x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Hub Grid -->
    <div class="row g-3" id="warehouseGrid">
        @foreach (var warehouse in Model)
        {
            <div class="col-xl-4 col-md-6 warehouse-card" data-name="@warehouse.Name.ToLower()" data-city="@warehouse.City.ToLower()">
                <div class="card h-100 border-0 shadow-premium rounded-5 overflow-hidden hover-lift card-hub">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="avatar-lg bg-primary bg-opacity-10 text-primary rounded-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fas fa-building fs-4"></i>
                            </div>
                            <div class="text-end">
                                <span class="badge @(warehouse.Status == SCM_System.Models.Enums.WarehouseStatus.Active ? "bg-success" : "bg-warning") rounded-pill px-3 py-2 mb-2">
                                    <i class="fas fa-circle fs-xs me-1"></i> @warehouse.Status
                                </span>
                                <div class="text-muted small fw-bold">ID: #@warehouse.WarehouseCode</div>
                            </div>
                        </div>

                        <h4 class="fw-bold mb-1 text-truncate">@warehouse.Name</h4>
                        <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt me-2 text-danger opacity-75"></i>@warehouse.City, @warehouse.Region</p>

                        <div class="mb-4 small">
                            @{
                                var managerAssignment = warehouse.Assignments?.FirstOrDefault(a => a.IsActive && a.IsPrimary);
                                var managerName = managerAssignment?.SupplierEmployee?.User?.FullName;
                                var managerPhone = managerAssignment?.SupplierEmployee?.Phone ?? managerAssignment?.SupplierEmployee?.User?.PhoneNumber;
                            }
                            @if (!string.IsNullOrEmpty(managerName))
                            {
                                <div class="mb-1"><i class="fas fa-user-tie text-muted me-2" style="width:16px;text-align:center;"></i>@managerName <span class="badge bg-light text-dark border ms-1 extra-small">Manager</span></div>
                            }
                            else
                            {
                                <div class="mb-1"><i class="fas fa-exclamation-triangle text-warning me-2" style="width:16px;text-align:center;"></i><span class="text-warning small fw-bold">Unassigned</span></div>
                            }
                            @if (!string.IsNullOrEmpty(managerPhone))
                            {
                                <div class="mb-1"><i class="fas fa-phone text-muted me-2" style="width:16px;text-align:center;"></i>@managerPhone</div>
                            }
                            @if (warehouse.OperatingHoursFrom.HasValue && warehouse.OperatingHoursTo.HasValue)
                            {
                                <div><i class="fas fa-clock text-muted me-2" style="width:16px;text-align:center;"></i>@warehouse.OperatingHoursFrom.Value.ToString(@"hh\:mm") - @warehouse.OperatingHoursTo.Value.ToString(@"hh\:mm")</div>
                            }
                        </div>

                        <div class="storage-metrics mb-4">
                            <div class="d-flex justify-content-between small fw-bold mb-2">
                                <span class="text-muted">Storage Capacity</span>
                                <span class="text-primary">@warehouse.MaxCapacity.ToString("N0") Units</span>
                            </div>
                            @{
                                var totalStock = warehouse.Inventories?.Sum(i => i.QuantityOnHand) ?? 0;
                                var utilPercent = warehouse.MaxCapacity > 0 ? (int)((totalStock * 100.0) / warehouse.MaxCapacity) : 0;
                                utilPercent = Math.Min(100, utilPercent);
                                var progressColor = utilPercent > 90 ? "bg-danger" : utilPercent > 70 ? "bg-warning" : "bg-primary";
                            }
                            <div class="progress rounded-pill" style="height: 10px;">
                                <div class="progress-bar rounded-pill @progressColor" role="progressbar" style="width: @utilPercent%" aria-valuenow="@utilPercent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span class="extra-small text-muted">@totalStock.ToString("N0") Units Stored</span>
                                <span class="extra-small fw-bold @progressColor.Replace("bg-", "text-")">@utilPercent% Full</span>
                            </div>
                        </div>

                        <div class="row g-2 pt-3 border-top mt-auto">
                            <div class="col-6">
                                <a asp-action="EditWarehouse" asp-route-id="@warehouse.Id" class="btn btn-light w-100 rounded-pill fw-bold text-primary border">
                                    <i class="fas fa-edit me-2"></i> Configure
                                </a>
                            </div>
                            <div class="col-6">
                                <form asp-action="DeleteWarehouse" asp-route-id="@warehouse.Id" method="post" onsubmit="return confirm('Wipe hub from records?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">
                                        <i class="fas fa-trash me-2"></i> Decommission
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 bg-white shadow-sm rounded-4 d-inline-block">
                <i class="fas fa-warehouse fa-4x text-muted opacity-25 mb-4 d-block"></i>
                <h4 class="fw-bold">No Hubs Registered</h4>
                <p class="text-muted mb-4">Register your first warehouse node to start fulfilling orders.</p>
                <a asp-action="CreateWarehouse" class="btn btn-primary rounded-pill px-5 fw-bold">Register Primary Hub</a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
    .logistics-hubs-container {
        zoom: 0.92;
        max-width: 1450px;
        margin: auto;
    }

    .warehouse-card {
        transition: all 0.3s ease;
    }
</style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#warehouseSearch').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#warehouseGrid .warehouse-card').filter(function() {
                    var text = $(this).data('name') + " " + $(this).data('city');
                    $(this).toggle(text.indexOf(value) > -1);
                });
            });
        });
    </script>
}
