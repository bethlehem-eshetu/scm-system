@model SCM_System.Models.Entities.Retailer
@using SCM_System.Models.Entities

@{
    ViewData["Title"] = "Retailer Account Settings";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header & KPIs -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="glass-panel p-4 mb-0 position-relative overflow-hidden" style="background: var(--hero-bg);">
                <div class="animated-bg" style="opacity: 0.05;"></div>
                <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h1 class="text-white mb-1 fw-bold"><i class="fas fa-store-alt me-2"></i>Control Center</h1>
                        <p class="text-white-50 mb-0">Manage your business profile, preferences, and security</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-glass btn-sm rounded-pill" onclick="location.reload()">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-4 border-primary">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                        <i class="fas fa-shopping-cart fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Orders</p>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalOrders</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-4 border-success">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="fas fa-money-bill-wave fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Spent</p>
                        <h4 class="fw-bold mb-0">$@ViewBag.TotalSpent.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-4 border-info">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                        <i class="fas fa-truck-loading fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">On-Time Rate</p>
                        <h4 class="fw-bold mb-0">@ViewBag.OnTimeDeliveryRate%</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-4 border-warning">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                        <i class="fas fa-star fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Avg Rating Given</p>
                        <h4 class="fw-bold mb-0">@ViewBag.AverageRatingGiven.ToString("F1") / 5.0</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="glass-card sticky-top" style="top: 100px;">
                <div class="p-4 text-center border-bottom border-light">
                    <div class="position-relative d-inline-block mb-3">
                        <img id="profile-preview" src="@(string.IsNullOrEmpty(Model.BusinessLogo) ? "/img/default-store.png" : Model.BusinessLogo)" 
                             class="rounded-circle border border-4 border-white shadow-sm" 
                             style="width: 120px; height: 120px; object-fit: cover;" />
                        <label for="profilePicture" class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 p-2 shadow" style="cursor: pointer;">
                            <i class="fas fa-camera"></i>
                        </label>
                        <form id="profilePicForm" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="d-none">
                            <input type="file" id="profilePicture" name="profilePicture" onchange="previewImage(this); document.getElementById('profilePicForm').submit();" />
                        </form>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.BusinessName</h5>
                    <p class="text-muted small mb-0">Member since @Model.CreatedAt.ToString("MMM yyyy")</p>
                </div>
                <div class="p-2">
                    <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist">
                        <button class="nav-link active text-start mb-1" id="tab-business" data-bs-toggle="pill" data-bs-target="#panel-business">
                            <i class="fas fa-briefcase me-2 w-20px"></i>Business Info
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-contact" data-bs-toggle="pill" data-bs-target="#panel-contact">
                            <i class="fas fa-id-card me-2 w-20px"></i>Contact Details
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-addresses" data-bs-toggle="pill" data-bs-target="#panel-addresses">
                            <i class="fas fa-map-marked-alt me-2 w-20px"></i>Address Book
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-payment" data-bs-toggle="pill" data-bs-target="#panel-payment">
                            <i class="fas fa-credit-card me-2 w-20px"></i>Payment Methods
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-procurement" data-bs-toggle="pill" data-bs-target="#panel-procurement">
                            <i class="fas fa-cog me-2 w-20px"></i>Procurement Defaults
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-preferences" data-bs-toggle="pill" data-bs-target="#panel-preferences">
                            <i class="fas fa-bell me-2 w-20px"></i>Preferences
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-suppliers" data-bs-toggle="pill" data-bs-target="#panel-suppliers">
                            <i class="fas fa-handshake me-2 w-20px"></i>Supplier Preferences
                        </button>
                        <button class="nav-link text-start mb-1" id="tab-security" data-bs-toggle="pill" data-bs-target="#panel-security">
                            <i class="fas fa-shield-alt me-2 w-20px"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-1 text-danger" id="tab-danger" data-bs-toggle="pill" data-bs-target="#panel-danger">
                            <i class="fas fa-exclamation-triangle me-2 w-20px"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Panels -->
        <div class="col-lg-9">
            <div class="tab-content" id="settings-tabContent">
                <!-- Panel: Business Information -->
                <div class="tab-pane fade show active" id="panel-business">
                    <div class="glass-card">
                        <div class="p-4 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-primary">Business Profile</h5>
                        </div>
                        <div class="p-4">
                            <form id="businessInfoForm" class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Business Name</label>
                                    <input type="text" name="BusinessName" class="form-control rounded-pill" value="@Model.BusinessName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Business Type</label>
                                    <select name="BusinessType" class="form-select rounded-pill">
                                        <option value="Retail Shop" selected="@(Model.BusinessType == "Retail Shop")">Retail Shop</option>
                                        <option value="Supermarket" selected="@(Model.BusinessType == "Supermarket")">Supermarket</option>
                                        <option value="Distributor" selected="@(Model.BusinessType == "Distributor")">Distributor</option>
                                        <option value="Wholesaler" selected="@(Model.BusinessType == "Wholesaler")">Wholesaler</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">License Number</label>
                                    <input type="text" name="BusinessLicenseNumber" class="form-control rounded-pill" value="@Model.BusinessLicenseNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">TIN (Tax ID)</label>
                                    <input type="text" name="TaxIdentificationNumber" class="form-control rounded-pill" value="@Model.TaxIdentificationNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Store Size</label>
                                    <select name="StoreSize" class="form-select rounded-pill">
                                        <option value="Small" selected="@(Model.StoreSize == "Small")">Small (< 50sqm)</option>
                                        <option value="Medium" selected="@(Model.StoreSize == "Medium")">Medium (50-200sqm)</option>
                                        <option value="Large" selected="@(Model.StoreSize == "Large")">Large (> 200sqm)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">City / Location</label>
                                    <input type="text" name="City" class="form-control rounded-pill" value="@Model.City" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Region</label>
                                    <input type="text" name="Region" class="form-control rounded-pill" value="@Model.Region" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">Registered Address</label>
                                    <textarea name="BusinessAddress" class="form-control rounded-3" rows="2">@Model.BusinessAddress</textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">Business Description</label>
                                    <textarea name="Description" class="form-control rounded-3" rows="3">@Model.Description</textarea>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveSettings('UpdateBusinessInfo', 'businessInfoForm')">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Panel: Contact Details -->
                <div class="tab-pane fade" id="panel-contact">
                    <div class="glass-card">
                        <div class="p-4 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-success">Contact Information</h5>
                        </div>
                        <div class="p-4">
                            <form id="contactDetailsForm" class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-muted">Primary Contact Person</label>
                                    <input type="text" name="contactPersonName" class="form-control rounded-pill" value="@(Model.ContactPersonName ?? Model.User?.FullName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Business Email</label>
                                    <input type="email" name="contactPersonEmail" class="form-control rounded-pill" value="@(Model.ContactPersonEmail ?? Model.User?.Email)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Business Phone</label>
                                    <input type="tel" name="contactPersonPhone" class="form-control rounded-pill" value="@(Model.ContactPersonPhone ?? Model.User?.PhoneNumber)" />
                                </div>
                                <div class="col-12 mt-4">
                                    <div class="alert alert-soft-info d-flex align-items-center rounded-4 border-0">
                                        <i class="fas fa-info-circle me-3 fa-lg"></i>
                                        <div class="small">
                                            Updating these details will also update your primary account login information if applicable.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-success rounded-pill px-4" onclick="saveSettings('UpdateContactDetails', 'contactDetailsForm')">Update Contacts</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Panel: Address Book -->
                <div class="tab-pane fade" id="panel-addresses">
                    <div class="glass-card mb-4">
                        <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-info">Address Book</h5>
                            <button class="btn btn-sm btn-info rounded-pill text-white" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="fas fa-plus me-1"></i> Add Address
                            </button>
                        </div>
                        <div class="p-4">
                            <div class="row g-3">
                                @if (Model.Addresses != null && Model.Addresses.Any())
                                {
                                    @foreach (var addr in Model.Addresses)
                                    {
                                        <div class="col-md-6">
                                            <div class="card bg-light border-0 rounded-4 p-3 h-100 position-relative">
                                                @if (addr.IsDefault)
                                                {
                                                    <span class="badge bg-primary rounded-pill position-absolute top-0 end-0 mt-3 me-3">Default @addr.AddressType</span>
                                                }
                                                <h6 class="fw-bold mb-2">@addr.AddressType Address</h6>
                                                <p class="small text-muted mb-3">
                                                    @addr.AddressLine<br />
                                                    @addr.City, @addr.Region<br />
                                                    @addr.Country @addr.PostalCode
                                                </p>
                                                <div class="mt-auto d-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill" onclick="deleteItem('DeleteAddress', @addr.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                    @if (!addr.IsDefault)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="setDefault('SetDefaultAddress', @addr.Id)">Set Default</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center py-4">
                                        <img src="/img/empty-address.svg" style="width: 80px; opacity: 0.3;" class="mb-3" />
                                        <p class="text-muted">No additional addresses saved.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel: Payment Methods -->
                <div class="tab-pane fade" id="panel-payment">
                    <div class="glass-card mb-4">
                        <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-primary">Payment Methods</h5>
                            <button class="btn btn-sm btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                                <i class="fas fa-plus me-1"></i> Add Method
                            </button>
                        </div>
                        <div class="p-4">
                            <div class="row g-3">
                                @if (Model.PaymentMethods != null && Model.PaymentMethods.Any())
                                {
                                    @foreach (var pay in Model.PaymentMethods)
                                    {
                                        <div class="col-md-6">
                                            <div class="card border rounded-4 p-3 h-100 d-flex flex-row align-items-center shadow-sm">
                                                <div class="icon-shape bg-light rounded-3 p-3 me-3">
                                                    @if (pay.MethodType == "Bank Transfer") { <i class="fas fa-university text-primary"></i> }
                                                    else if (pay.MethodType == "Chapa") { <i class="fas fa-bolt text-warning"></i> }
                                                    else { <i class="fas fa-wallet text-secondary"></i> }
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold mb-0">@pay.MethodType</h6>
                                                    <p class="small text-muted mb-0">@pay.Details</p>
                                                </div>
                                                <div class="ms-2">
                                                    @if (pay.IsDefault) { <span class="badge bg-soft-success text-success rounded-pill">Preferred</span> }
                                                    <button class="btn btn-link text-danger p-1 ms-2" onclick="deleteItem('DeletePaymentMethod', @pay.Id)"><i class="fas fa-times"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center py-4">
                                        <p class="text-muted">No payment methods saved.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel: Procurement Defaults -->
                <div class="tab-pane fade" id="panel-procurement">
                    <div class="glass-card">
                        <div class="p-4 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-info">Procurement & Order Settings</h5>
                        </div>
                        <div class="p-4">
                            <form id="procurementForm" class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Default Tender Closing Days</label>
                                    <div class="input-group">
                                        <input type="number" name="defaultTenderClosingDays" class="form-control rounded-start-pill" value="@Model.DefaultTenderClosingDays" />
                                        <span class="input-group-text rounded-end-pill">days</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Preferred Delivery Timeline</label>
                                    <div class="input-group">
                                        <input type="number" name="preferredDeliveryTimeline" class="form-control rounded-start-pill" value="@Model.PreferredDeliveryTimeline" />
                                        <span class="input-group-text rounded-end-pill">days</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Monthly Budget Range (Min - Max)</label>
                                    <div class="input-group">
                                        <input type="number" name="budgetMin" class="form-control rounded-start-pill" placeholder="Min" value="@Model.BudgetMin" />
                                        <input type="number" name="budgetMax" class="form-control rounded-end-pill" placeholder="Max" value="@Model.BudgetMax" />
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-muted">Preferred Product Categories</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var cat in (IEnumerable<ProductCategory>)ViewBag.AllCategories)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="preferredCategories" value="@cat.Id" id="cat-@cat.Id" 
                                                       @(Model.PreferredCategories != null && Model.PreferredCategories.Split(',').Contains(cat.Id.ToString()) ? "checked" : "")>
                                                <label class="form-check-label small" for="cat-@cat.Id">@cat.CategoryName</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-info text-white rounded-pill px-4" onclick="saveSettings('UpdateProcurementDefaults', 'procurementForm')">Save Procurement Defaults</button>
                                </div>
                            </form>
                            
                            <hr class="my-4 border-light" />
                            
                            <form id="orderPrefsForm" class="row g-3">
                                <h6 class="fw-bold mb-0">Shipping & Logistics</h6>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Default Shipping Method</label>
                                    <select name="defaultShippingMethod" class="form-select rounded-pill">
                                        <option value="Standard" selected="@(Model.DefaultShippingMethod == "Standard")">Standard Freight</option>
                                        <option value="Express" selected="@(Model.DefaultShippingMethod == "Express")">Express Logistics</option>
                                        <option value="Self Pickup" selected="@(Model.DefaultShippingMethod == "Self Pickup")">Self Pickup</option>
                                    </select>
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="proofOfDeliveryRequired" id="podSwitch" @(Model.ProofOfDeliveryRequired ? "checked" : "")>
                                        <label class="form-check-label small fw-bold" for="podSwitch">Require Proof of Delivery (POD)</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="deliveryNotifications" id="delNotifySwitch" @(Model.DeliveryNotifications ? "checked" : "")>
                                        <label class="form-check-label small fw-bold" for="delNotifySwitch">Real-time Delivery SMS Notifications</label>
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-outline-info rounded-pill px-4" onclick="saveSettings('UpdateOrderPreferences', 'orderPrefsForm')">Update Preferences</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Panel: Notifications Preferences -->
                <div class="tab-pane fade" id="panel-preferences">
                    <div class="glass-card">
                        <div class="p-4 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-warning">Notification & Appearance</h5>
                        </div>
                        <div class="p-4">
                            <partial name="_ThemeToggle" />
                            <hr class="my-4 border-light" />
                            <form id="notificationForm">
                                <div class="list-group list-group-flush rounded-4 overflow-hidden">
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <div>
                                            <h6 class="mb-0 fw-bold">New Tender Matches</h6>
                                            <p class="small text-muted mb-0">Get notified when a new tender matches your preferred categories.</p>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="newTenderMatchAlert" @(Model.NewTenderMatchAlert ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <div>
                                            <h6 class="mb-0 fw-bold">Bid Status Updates</h6>
                                            <p class="small text-muted mb-0">Notifications for when your bids are accepted or rejected.</p>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="bidAcceptedAlert" @(Model.BidAcceptedAlert ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <div>
                                            <h6 class="mb-0 fw-bold">Order Shipment & Delivery</h6>
                                            <p class="small text-muted mb-0">Track your orders from warehouse to doorstep.</p>
                                        </div>
                                        <div class="d-flex gap-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="orderShippedAlert" @(Model.OrderShippedAlert ? "checked" : "")>
                                                <label class="small text-muted">Shipped</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="orderDeliveredAlert" @(Model.OrderDeliveredAlert ? "checked" : "")>
                                                <label class="small text-muted">Delivered</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <div>
                                            <h6 class="mb-0 fw-bold">Inventory & Price Alerts</h6>
                                            <p class="small text-muted mb-0">Alerts for low stock on favorite items or price drops.</p>
                                        </div>
                                        <div class="d-flex gap-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="lowStockAlert" @(Model.LowStockAlert ? "checked" : "")>
                                                <label class="small text-muted">Low Stock</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="priceDropAlert" @(Model.PriceDropAlert ? "checked" : "")>
                                                <label class="small text-muted">Price Drop</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 text-end mt-4">
                                    <button type="button" class="btn btn-warning text-white rounded-pill px-4" onclick="saveSettings('UpdateNotificationPreferences', 'notificationForm')">Update Alerts</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Panel: Supplier Preferences -->
                <div class="tab-pane fade" id="panel-suppliers">
                    <div class="glass-card">
                        <div class="p-4 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-primary">Supplier Relationships</h5>
                        </div>
                        <div class="p-4">
                            <form id="supplierPrefsForm" class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">Favorite Suppliers (IDs)</label>
                                    <input type="text" name="favoriteSuppliers" class="form-control rounded-pill" value="@Model.FavoriteSuppliers" placeholder="Enter supplier IDs separated by commas" />
                                    <div class="form-text">Suppliers in this list will be prioritized in your catalog views.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">Blocked Suppliers (IDs)</label>
                                    <input type="text" name="blockedSuppliers" class="form-control rounded-pill" value="@Model.BlockedSuppliers" placeholder="Enter supplier IDs separated by commas" />
                                    <div class="form-text text-danger">You will not see tenders or products from these suppliers.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Minimum Supplier Rating</label>
                                    <select name="supplierRatingThreshold" class="form-select rounded-pill">
                                        <option value="0" selected="@(Model.SupplierRatingThreshold == 0)">No Minimum</option>
                                        <option value="3" selected="@(Model.SupplierRatingThreshold == 3)">3.0 Stars & Above</option>
                                        <option value="4" selected="@(Model.SupplierRatingThreshold == 4)">4.0 Stars & Above</option>
                                        <option value="5" selected="@(Model.SupplierRatingThreshold == 5)">5.0 Stars Only</option>
                                    </select>
                                </div>
                                <div class="col-12 text-end mt-4">
                                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveSettings('UpdateSupplierPreferences', 'supplierPrefsForm')">Save Supplier Preferences</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Panel: Security Hub -->
                <div class="tab-pane fade" id="panel-security">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="glass-card h-100">
                                <div class="p-4 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-lock me-2"></i>Account Security</h5>
                                </div>
                                <div class="p-4">
                                    <div class="d-flex align-items-center justify-content-between mb-4">
                                        <div>
                                            <h6 class="fw-bold mb-1">Two-Factor Authentication</h6>
                                            <p class="small text-muted mb-0">Enhance your account security</p>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="2faSwitch" @(Model.User?.TwoFactorEnabled == true ? "checked" : "") onchange="toggle2FA()">
                                        </div>
                                    </div>
                                    
                                    @if (Model.User?.TwoFactorEnabled == true)
                                    {
                                        <div class="text-center p-3 bg-light rounded-4 mb-3">
                                            <i class="fas fa-check-circle text-success fa-3x mb-2"></i>
                                            <p class="small fw-bold mb-0">2FA is currently ACTIVE</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="2faSetup" class="d-none">
                                            <p class="small text-muted">Scan this QR code with Google Authenticator:</p>
                                            <div class="text-center mb-3">
                                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=OTPAuth:totp/SCM_System:Retailer?secret=MOCKSECRET123" class="img-fluid border p-2 bg-white" />
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" class="form-control rounded-start-pill" placeholder="Enter 6-digit code">
                                                <button class="btn btn-primary rounded-end-pill px-3">Verify</button>
                                            </div>
                                        </div>
                                    }

                                    <hr class="my-4 border-light" />
                                    <button class="btn btn-outline-dark w-100 rounded-pill mb-2" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                        <i class="fas fa-key me-2"></i> Change Password
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="glass-card h-100">
                                <div class="p-4 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-history me-2"></i>Active Sessions</h5>
                                </div>
                                <div class="p-4">
                                    <div class="list-group list-group-flush rounded-4">
                                    @foreach (var session in (ViewBag.ActiveSessions as IEnumerable<UserSession>) ?? Enumerable.Empty<UserSession>())
                                        {
                                            <div class="list-group-item px-0 bg-transparent py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="icon-shape bg-soft-primary rounded-pill p-2 me-3">
                                                        <i class="fas fa-desktop text-primary"></i>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="small fw-bold mb-0">@(session.UserAgent?.Length > 40 ? session.UserAgent.Substring(0, 40) + "..." : session.UserAgent ?? "Unknown Device")</h6>
                                                        <p class="small text-muted mb-0">IP: @session.IpAddress • @session.LastActivityTime.ToString("g")</p>
                                                    </div>
                                                    <button class="btn btn-sm btn-link text-danger" onclick="revokeSession(@session.Id)">Revoke</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <div class="glass-card">
                                <div class="p-4 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list me-2"></i>Login History</h5>
                                </div>
                                <div class="p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="px-4 py-3 border-0 small text-muted">Timestamp</th>
                                                    <th class="px-4 py-3 border-0 small text-muted">Action</th>
                                                    <th class="px-4 py-3 border-0 small text-muted">Result</th>
                                                    <th class="px-4 py-3 border-0 small text-muted">Details</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var log in (ViewBag.LoginHistory as IEnumerable<AuditLog>) ?? Enumerable.Empty<AuditLog>())
                                                {
                                                    <tr>
                                                        <td class="px-4 small">@log.PerformedAtUtc.ToLocalTime().ToString("g")</td>
                                                        <td class="px-4 small">@log.ActionType</td>
                                                        <td class="px-4"><span class="badge bg-soft-success text-success rounded-pill">Success</span></td>
                                                        <td class="px-4 small text-muted">@log.Notes</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel: Danger Zone -->
                <div class="tab-pane fade" id="panel-danger">
                    <div class="glass-card border-danger">
                        <div class="p-4 border-bottom border-danger bg-danger bg-opacity-10">
                            <h5 class="mb-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Danger Zone</h5>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <h6 class="fw-bold mb-1">Export Business Data</h6>
                                <p class="small text-muted mb-3">Download a CSV of all your orders, tenders, and profile data for your records.</p>
                                <a href="/Retailer/ExportData" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="fas fa-file-export me-2"></i> Download CSV Export
                                </a>
                            </div>
                            
                            <hr class="my-4 border-light" />
                            
                            <div class="mb-0">
                                <h6 class="fw-bold text-danger mb-1">Deactivate Retailer Account</h6>
                                <p class="small text-muted mb-3">Temporarily suspend your business operations on the platform. You can reactivate by logging in later.</p>
                                <button class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                    <i class="fas fa-user-slash me-2"></i> Deactivate Account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom-0 p-4">
                <h5 class="modal-title fw-bold">Add New Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addAddressForm">
                <div class="modal-body p-4 pt-0">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Address Type</label>
                        <select name="AddressType" class="form-select rounded-pill">
                            <option value="Shipping">Shipping</option>
                            <option value="Billing">Billing</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Address Line</label>
                        <input type="text" name="AddressLine" class="form-control rounded-pill" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">City</label>
                            <input type="text" name="City" class="form-control rounded-pill" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Region</label>
                            <input type="text" name="Region" class="form-control rounded-pill" />
                        </div>
                    </div>
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="isDefaultAddr">
                        <label class="form-check-label small" for="isDefaultAddr">Set as default address</label>
                    </div>
                </div>
                <div class="modal-footer border-top-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveModal('AddAddress', 'addAddressForm')">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-0 p-4">
                <h5 class="modal-title fw-bold text-danger">Confirm Deactivation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-0 text-center">
                <i class="fas fa-exclamation-circle text-danger fa-4x mb-3"></i>
                <p>Are you sure you want to deactivate your account? Your active tenders will be hidden.</p>
                <input type="password" id="confirmPass" class="form-control rounded-pill mb-3" placeholder="Enter your password to confirm">
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" onclick="confirmDeactivation()">Deactivate Now</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tab Persistence
            var activeTab = localStorage.getItem('retailerSettingsTab');
            if (activeTab) {
                var tabTrigger = new bootstrap.Tab(document.querySelector('#' + activeTab));
                tabTrigger.show();
            }

            $('button[data-bs-toggle="pill"]').on('shown.bs.tab', function(e) {
                localStorage.setItem('retailerSettingsTab', e.target.id);
            });

            // Unsaved Changes Warning
            let hasUnsavedChanges = false;
            $('form input, form select, form textarea').on('change', function() {
                hasUnsavedChanges = true;
            });

            window.onbeforeunload = function() {
                if (hasUnsavedChanges) {
                    return "You have unsaved changes. Are you sure you want to leave?";
                }
            };
        });

        function saveSettings(action, formId) {
            const form = $('#' + formId);
            const data = form.serialize();
            
            $.post('/Retailer/' + action, data, function(res) {
                if (res.success) {
                    toastr.success(res.message || 'Settings updated successfully!');
                    hasUnsavedChanges = false;
                } else {
                    toastr.error(res.message || 'An error occurred.');
                }
            });
        }

        function saveModal(action, formId) {
            const data = $('#' + formId).serialize();
            $.post('/Retailer/' + action, data, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    toastr.error('Failed to save.');
                }
            });
        }

        function deleteItem(action, id) {
            if (confirm('Are you sure you want to delete this item?')) {
                $.post('/Retailer/' + action, { id: id }, function(res) {
                    if (res.success) location.reload();
                });
            }
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#profile-preview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function toggle2FA() {
            const isChecked = $('#2faSwitch').is(':checked');
            if (isChecked) {
                $('#2faSetup').removeClass('d-none');
            } else {
                $('#2faSetup').addClass('d-none');
                toastr.warning('2FA disabled (MOCK)');
            }
        }

        function revokeSession(id) {
            $.post('/Retailer/RevokeSession', { sessionId: id }, function(res) {
                if (res.success) location.reload();
            });
        }

        function confirmDeactivation() {
            const pass = $('#confirmPass').val();
            if (!pass) {
                toastr.error('Please enter your password.');
                return;
            }
            $.post('/Retailer/DeactivateAccount', { password: pass }, function(res) {
                if (res.success) {
                    window.location.href = '/Account/Logout';
                } else {
                    toastr.error(res.message);
                }
            });
        }
    </script>
}

