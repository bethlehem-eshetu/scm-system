@model SCM_System.Models.ViewModels.DeliveryRatingViewModel
@{
    ViewData["Title"] = "Rate Delivery Experience";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-5 px-4 bg-light-green-subtle min-vh-100">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <!-- Header Section -->
            <div class="text-center mb-5 animate-fade-in">
                <div class="d-inline-flex p-3 rounded-circle bg-white shadow-sm mb-3">
                    <i class="fas fa-truck-loading fa-3x text-dark-green"></i>
                </div>
                <h1 class="h2 fw-bold text-dark-green mb-2">How was your delivery?</h1>
                <p class="text-muted">Your feedback helps us maintain professional logistics standards.</p>
            </div>

            <!-- Delivery Info Card -->
            <div class="card border-0 shadow-premium rounded-20 mb-5 overflow-hidden animate-slide-up">
                <div class="bg-dark-green p-4 text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 fw-bold">Order #@Model.PONumber</h5>
                        <p class="small mb-0 opacity-75"><i class="fas fa-calendar-check me-2"></i>Delivered Today</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-accent-green text-dark-green px-3 py-2 rounded-pill fw-bold">DELIVERED</span>
                    </div>
                </div>
                <div class="card-body p-4 bg-white">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-6 border-end">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-sm rounded-circle bg-faint-green d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user-tie text-dark-green"></i>
                                </div>
                                <div>
                                    <label class="small text-muted d-block">Delivery Agent</label>
                                    <span class="fw-bold text-dark-green">@Model.DriverName</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-sm rounded-circle bg-faint-green d-flex align-items-center justify-content-center">
                                    <i class="fas fa-truck text-dark-green"></i>
                                </div>
                                <div>
                                    <label class="small text-muted d-block">Vehicle Plate</label>
                                    <span class="fw-bold text-dark-green">@Model.VehiclePlate</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rating Form Card -->
            <div class="card border-0 shadow-premium rounded-20 animate-slide-up" style="animation-delay: 0.1s;">
                <div class="card-body p-5">
                    <form asp-action="SubmitDeliveryRating" method="post" id="ratingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PurchaseOrderId" />

                        <div class="row g-5">
                            <!-- Category 1 -->
                            <div class="col-md-6">
                                <div class="rating-category mb-4">
                                    <label class="h6 fw-bold text-dark-green mb-3">
                                        <i class="fas fa-clock me-2 text-accent-green"></i>Timeliness
                                    </label>
                                    <div class="star-rating d-flex gap-2" data-category="Timeliness">
                                        @for(int i = 1; i <= 5; i++) {
                                            <i class="far fa-star fa-2x cursor-pointer star-btn" data-value="@i"></i>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="Timeliness" class="rating-input" required />
                                    <p class="small text-muted mt-2">Was the delivery within the promised window?</p>
                                </div>
                            </div>

                            <!-- Category 2 -->
                            <div class="col-md-6">
                                <div class="rating-category mb-4">
                                    <label class="h6 fw-bold text-dark-green mb-3">
                                        <i class="fas fa-user-shield me-2 text-accent-green"></i>Professionalism
                                    </label>
                                    <div class="star-rating d-flex gap-2" data-category="Professionalism">
                                        @for(int i = 1; i <= 5; i++) {
                                            <i class="far fa-star fa-2x cursor-pointer star-btn" data-value="@i"></i>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="Professionalism" class="rating-input" required />
                                    <p class="small text-muted mt-2">Agent courtesy and identification protocols.</p>
                                </div>
                            </div>

                            <!-- Category 3 -->
                            <div class="col-md-6">
                                <div class="rating-category mb-4">
                                    <label class="h6 fw-bold text-dark-green mb-3">
                                        <i class="fas fa-box me-2 text-accent-green"></i>Vehicle Condition
                                    </label>
                                    <div class="star-rating d-flex gap-2" data-category="VehicleCondition">
                                        @for(int i = 1; i <= 5; i++) {
                                            <i class="far fa-star fa-2x cursor-pointer star-btn" data-value="@i"></i>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="VehicleCondition" class="rating-input" required />
                                    <p class="small text-muted mt-2">Was the vehicle clean and appropriate for logistics?</p>
                                </div>
                            </div>

                            <!-- Category 4 -->
                            <div class="col-md-6">
                                <div class="rating-category mb-4">
                                    <label class="h6 fw-bold text-dark-green mb-3">
                                        <i class="fas fa-comments me-2 text-accent-green"></i>Communication
                                    </label>
                                    <div class="star-rating d-flex gap-2" data-category="Communication">
                                        @for(int i = 1; i <= 5; i++) {
                                            <i class="far fa-star fa-2x cursor-pointer star-btn" data-value="@i"></i>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="Communication" class="rating-input" required />
                                    <p class="small text-muted mt-2">Did the agent communicate status effectively?</p>
                                </div>
                            </div>
                        </div>

                        <!-- Comment Area -->
                        <div class="mt-5 pt-4 border-top">
                            <label class="h6 fw-bold text-dark-green mb-3">Additional Comments</label>
                            <textarea asp-for="Comment" class="form-control border-0 shadow-sm rounded-15 p-4" rows="4" 
                                      placeholder="Share more details about your experience (optional)..."></textarea>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex flex-column flex-sm-row gap-3 mt-5">
                            <button type="submit" class="btn btn-dark-green rounded-pill px-5 py-3 fw-bold shadow-premium flex-grow-1">
                                <i class="fas fa-paper-plane me-2"></i>Submit Detailed Rating
                            </button>
                            <a asp-action="Dashboard" class="btn btn-soft-green rounded-pill px-4 py-3 fw-bold flex-grow-1 text-center">
                                Maybe Later
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .star-btn { transition: all 0.2s ease; color: #dee2e6; }
    .star-btn.active { color: #ffc107 !important; transform: scale(1.1); }
    .star-btn:hover { color: #ffca2c; }
    
    .shadow-premium { box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important; }
    .rounded-20 { border-radius: 20px !important; }
    .rounded-15 { border-radius: 15px !important; }
    .bg-light-green-subtle { background-color: #f8fbf9 !important; }
    .bg-dark-green { background-color: #1a4d2e !important; }
    .bg-accent-green { background-color: #ccff00 !important; }
    .text-dark-green { color: #1a4d2e !important; }
    .btn-dark-green { background-color: #1a4d2e !important; color: white !important; }
    .btn-soft-green { background-color: rgba(26, 77, 46, 0.05); color: #1a4d2e !important; border: none; }
    .avatar-sm { width: 40px; height: 40px; }
    .bg-faint-green { background-color: rgba(26, 77, 46, 0.1); }

    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    .animate-slide-up { animation: slideUp 0.6s ease-out forwards; opacity: 0; transform: translateY(20px); }
    
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const starContainers = document.querySelectorAll('.star-rating');
        
        starContainers.forEach(container => {
            const stars = container.querySelectorAll('.star-btn');
            const input = container.parentElement.querySelector('.rating-input');

            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const value = parseInt(this.dataset.value);
                    input.value = value;
                    updateStars(stars, value);
                });

                star.addEventListener('mouseenter', function() {
                    const value = parseInt(this.dataset.value);
                    highlightStars(stars, value);
                });

                star.addEventListener('mouseleave', function() {
                    updateStars(stars, parseInt(input.value) || 0);
                });
            });
        });

        function updateStars(stars, value) {
            stars.forEach((s, idx) => {
                if (idx < value) {
                    s.classList.remove('far');
                    s.classList.add('fas', 'active');
                } else {
                    s.classList.remove('fas', 'active');
                    s.classList.add('far');
                }
            });
        }

        function highlightStars(stars, value) {
            stars.forEach((s, idx) => {
                if (idx < value) {
                    s.style.color = '#ffc107';
                } else {
                    s.style.color = '#dee2e6';
                }
            });
        }

        // Form Validation
        document.getElementById('ratingForm').addEventListener('submit', function(e) {
            const inputs = document.querySelectorAll('.rating-input');
            let valid = true;
            inputs.forEach(input => {
                if (!input.value || input.value === "0") {
                    valid = false;
                    input.parentElement.classList.add('animate-shake');
                    setTimeout(() => input.parentElement.classList.remove('animate-shake'), 500);
                }
            });

            if (!valid) {
                e.preventDefault();
                alert('Please provide a rating for all 4 categories.');
            }
        });
    });
</script>
