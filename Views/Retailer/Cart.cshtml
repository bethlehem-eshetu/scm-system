}

@section Scripts {
    <script>
        $(document).on('click', '.update-qty', function() {
            const btn = $(this);
            const id = btn.data('id');
            const delta = btn.data('delta');
            const input = btn.closest('td').find('.qty-input');
            let newQty = parseInt(input.val()) + delta;
            
            if (newQty < 1) return;
            
            updateCartItem(id, newQty);
        });

        $(document).on('change', '.qty-input', function() {
            const input = $(this);
            const id = input.data('id');
            let newQty = parseInt(input.val());
            
            if (isNaN(newQty) || newQty < 1) {
                newQty = 1;
                input.val(1);
            }
            
            updateCartItem(id, newQty);
        });

        function updateCartItem(id, quantity) {
            $.post('/Retailer/UpdateCartItem', { cartItemId: id, quantity: quantity }, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message || 'Error updating cart');
                }
            });
        }
    </script>
}