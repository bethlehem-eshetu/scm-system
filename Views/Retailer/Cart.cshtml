            }
        
        body.dark-mode .dark-mode-image-bg {
            background-color: #334155 !important;
        }
        
        body.dark-mode .dark-mode-qty-group {
            background-color: #334155 !important;
            border-color: #475569 !important;
        }
        
        body.dark-mode .dark-mode-remove-btn {
            background-color: #334155 !important;
