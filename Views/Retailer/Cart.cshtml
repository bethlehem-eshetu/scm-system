@model SCM_System.Models.Entities.Cart

@{
    ViewData["Title"] = "My Shopping Cart";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">Shopping Cart</h2>
        <a asp-action="BrowseCatalog" class="btn btn-outline-primary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Continue Shopping
        </a>
    </div>

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="glass-card p-5 text-center border-0 shadow-sm">
            <div class="mb-4">
                <i class="fas fa-shopping-cart fa-5x text-muted opacity-25"></i>
            </div>
            <h3 class="fw-bold">Your cart is empty</h3>
            <p class="text-muted mb-4">You haven't added any products to your cart yet.</p>
            <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-5 py-2">
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="glass-card p-0 border-0 overflow-hidden shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light opacity-75">
                                <tr>
                                    <th class="ps-4 py-3 border-0">Product</th>
                                    <th class="py-3 border-0">Price</th>
                                    <th class="py-3 border-0">Quantity</th>
                                    <th class="py-3 border-0">Total</th>
                                    <th class="pe-4 py-3 border-0 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 avatar-lg rounded-3 bg-light d-flex align-items-center justify-content-center overflow-hidden" style="width: 70px; height: 70px;">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" class="w-100 h-100" style="object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-image text-muted"></i>
                                                    }
                                                </div>
                                                <div class="ms-3">
                                                    <h6 class="fw-bold mb-1">@item.Product.ProductName</h6>
                                                    <div class="small text-muted">@item.Product.Supplier.CompanyName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4">@item.Product.BasePrice.ToString("C")</td>
                                        <td class="py-4">
                                            <div class="input-group input-group-sm rounded-pill border bg-white overflow-hidden" style="width: 120px;">
                                                <button class="btn btn-link text-dark text-decoration-none px-2 update-qty" data-id="@item.Id" data-delta="-1">
                                                    <i class="fas fa-minus small"></i>
                                                </button>
                                                <input type="text" class="form-control border-0 text-center fw-bold bg-transparent px-0 qty-input" value="@item.Quantity" readonly>
                                                <button class="btn btn-link text-dark text-decoration-none px-2 update-qty" data-id="@item.Id" data-delta="1">
                                                    <i class="fas fa-plus small"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="py-4 fw-bold">@((item.Quantity * item.Product.BasePrice).ToString("C"))</td>
                                        <td class="pe-4 py-4 text-end">
                                            <form asp-action="RemoveFromCart" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2 border-0 shadow-none hover-shadow">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Checkout Summary -->
            <div class="col-lg-4">
                <div class="glass-card p-4 border-0 shadow-sm sticky-top" style="top: 1.5rem;">
                    <h5 class="fw-bold mb-4">Order Summary</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold">@Model.CartItems.Sum(i => i.Quantity * i.Product.BasePrice).ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Processing Fee</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <hr class="my-4 opacity-50">
                    <div class="d-flex justify-content-between mb-4">
                        <h5 class="fw-bold mb-0">Total</h5>
                        <h4 class="fw-bold text-primary mb-0">@Model.CartItems.Sum(i => i.Quantity * i.Product.BasePrice).ToString("C")</h4>
                    </div>

                    <form asp-action="Checkout" method="post" id="checkoutForm">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Delivery Address</label>
                            <textarea name="deliveryAddress" class="form-control rounded-3 border-light bg-light bg-opacity-50" rows="3" placeholder="Enter full delivery address..." required></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted">Requested Delivery Date</label>
                            <input type="date" name="expectedDeliveryDate" class="form-control rounded-pill border-light bg-light bg-opacity-50" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mb-3 shadow">
                            <i class="fas fa-lock me-2"></i> Proceed to Checkout
                        </button>
                    </form>
                    
                    <div class="text-center">
                        <span class="small text-muted"><i class="fas fa-shield-alt me-1"></i> Secure SCM Transaction</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).on('click', '.update-qty', function() {
            const btn = $(this);
            const id = btn.data('id');
            const delta = btn.data('delta');
            const input = btn.closest('td').find('.qty-input');
            let newQty = parseInt(input.val()) + delta;
            
            if (newQty < 1) return;
            
            $.post('/Retailer/UpdateCartItem', { cartItemId: id, quantity: newQty }, function(res) {
                if (res.success) {
                    location.reload();
                }
            });
        });
    </script>
}
