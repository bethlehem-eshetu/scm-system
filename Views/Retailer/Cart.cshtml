@model SCM_System.Models.Entities.Cart

@{
    ViewData["Title"] = "My Shopping Cart";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0 dark-mode-text">Shopping Cart</h2>
        <a asp-action="BrowseCatalog" class="btn btn-outline-primary rounded-pill px-4 dark-mode-btn">
            <i class="fas fa-arrow-left me-2"></i> Continue Shopping
        </a>
    </div>

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="glass-card p-5 text-center border-0 shadow-sm dark-mode-card">
            <div class="mb-4">
                <i class="fas fa-shopping-cart fa-5x text-muted opacity-25"></i>
            </div>
            <h3 class="fw-bold dark-mode-text">Your cart is empty</h3>
            <p class="text-muted mb-4 dark-mode-text">You haven't added any products to your cart yet.</p>
            <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-5 py-2">
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="glass-card p-0 border-0 overflow-hidden shadow-sm dark-mode-card">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 dark-mode-table">
                            <thead class="bg-light opacity-75 dark-mode-thead">
                                <tr>
                                    <th class="ps-4 py-3 border-0 dark-mode-text">Product</th>
                                    <th class="py-3 border-0 dark-mode-text">Price</th>
                                    <th class="py-3 border-0 dark-mode-text">Quantity</th>
                                    <th class="py-3 border-0 dark-mode-text">Total</th>
                                    <th class="pe-4 py-3 border-0 text-end dark-mode-text">Action</th>
                                </tr>
                            </thead>
                            <tbody class="dark-mode-tbody">
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 avatar-lg rounded-3 bg-light d-flex align-items-center justify-content-center overflow-hidden dark-mode-image-bg" style="width: 70px; height: 70px;">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" class="w-100 h-100" style="object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-image text-muted"></i>
                                                    }
                                                </div>
                                                <div class="ms-3">
                                                    <h6 class="fw-bold mb-1 dark-mode-text">@item.Product.ProductName</h6>
                                                    <div class="small text-muted dark-mode-text">@item.Product.Supplier.CompanyName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 dark-mode-text">ETB @item.Product.BasePrice.ToString("#,##0.00")</td>
                                        <td class="py-4">
                                            <div class="input-group input-group-sm rounded-pill border bg-white overflow-hidden dark-mode-qty-group" style="width: 120px;">
                                                <button class="btn btn-link text-dark text-decoration-none px-2 update-qty" data-id="@item.Id" data-delta="-1">
                                                    <i class="fas fa-minus small"></i>
                                                </button>
                                                <input type="number" class="form-control border-0 text-center fw-bold bg-transparent px-0 qty-input dark-mode-text" 
                                                       value="@item.Quantity" data-id="@item.Id" min="1">
                                                <button class="btn btn-link text-dark text-decoration-none px-2 update-qty" data-id="@item.Id" data-delta="1">
                                                    <i class="fas fa-plus small"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="py-4 fw-bold">
                                            @{
                                                var itemNet = item.Quantity * item.Product.BasePrice;
                                                var itemVat = Math.Round(itemNet * 0.15m, 2);
                                                var itemTotal = itemNet + itemVat;
                                            }
                                            <div class="text-dark dark-mode-text">ETB @itemTotal.ToString("#,##0.00")</div>
                                            <div class="text-muted smaller fw-normal dark-mode-text">Net: ETB @itemNet.ToString("#,##0.00")</div>
                                        </td>
                                        <td class="pe-4 py-4 text-end">
                                            <form asp-action="RemoveFromCart" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2 border-0 shadow-none hover-shadow dark-mode-remove-btn">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Checkout Summary -->
            <div class="col-lg-4">
                <div class="glass-card p-4 border-0 shadow-sm sticky-top dark-mode-card" style="top: 1.5rem;">
                    <h5 class="fw-bold mb-4 dark-mode-text">Order Summary</h5>
        
                    @{
                        var netTotal = Model.CartItems.Sum(i => i.Quantity * i.Product.BasePrice);
                        var vatTotal = Math.Round(netTotal * 0.15m, 2);
                        var grandTotal = netTotal + vatTotal + 50.00m;
                        var depositAmount = grandTotal * 0.5m;
                        var remainingAmount = grandTotal - depositAmount;
                    }
        
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted dark-mode-text">Subtotal</span>
                        <span class="fw-bold dark-mode-text">ETB @netTotal.ToString("#,##0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted dark-mode-text">VAT (15%)</span>
                        <span class="fw-bold text-info dark-mode-text">ETB @vatTotal.ToString("#,##0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted dark-mode-text">Delivery Fee</span>
                        <span class="fw-bold dark-mode-text">ETB 50.00</span>
                    </div>
                    <hr class="my-4 opacity-50 dark-mode-border">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold dark-mode-text">Total Order Value</span>
                        <h5 class="fw-bold text-primary mb-0 dark-mode-text">ETB @grandTotal.ToString("#,##0.00")</h5>
                    </div>
        
                    <!-- Deposit Breakdown -->
                    <div class="bg-light rounded-3 p-3 mb-4 dark-mode-payment-box">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-bold dark-mode-text">💰 You Pay Now (50% Deposit)</span>
                            <span class="fw-bold text-success dark-mode-text">ETB @depositAmount.ToString("#,##0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="small text-muted dark-mode-text">📦 Pay on Delivery (50%)</span>
                            <span class="fw-bold text-warning dark-mode-text">ETB @remainingAmount.ToString("#,##0.00")</span>
                        </div>
                    </div>
        
                    <div class="alert alert-info rounded-3 mb-4 p-3 dark-mode-deposit-alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-shield-alt fa-2x me-3 text-info"></i>
                            <div>
                                <strong class="dark-mode-text">Secure 50% Deposit Required</strong>
                                <p class="small text-muted mb-0 dark-mode-text">Pay 50% now via Chapa. Remaining 50% due upon delivery.</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Checkout" method="post" id="checkoutForm">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted dark-mode-text">Delivery Address</label>
                            <textarea name="deliveryAddress" class="form-control rounded-3 border-light bg-light bg-opacity-50 dark-mode-input" rows="3" placeholder="Enter full delivery address..." required></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted dark-mode-text">Expected Delivery Date</label>
                            <input type="date" name="expectedDeliveryDate" class="form-control rounded-pill border-light bg-light bg-opacity-50 dark-mode-input" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required>
                        </div>
            
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="termsCheckbox" required>
                                <label class="form-check-label small text-muted dark-mode-text" for="termsCheckbox">
                                    I understand that I must pay 50% deposit now, and the remaining 50% upon delivery
                                </label>
                            </div>
                        </div>
            
                        <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-bold mb-3 shadow">
                            <i class="fas fa-credit-card me-2"></i> Pay ETB @depositAmount.ToString("#,##0.00") (50% Deposit)
                        </button>
                    </form>
        
                    <div class="text-center">
                        <span class="small text-muted dark-mode-text">
                            <i class="fas fa-lock me-1"></i> Secured by Chapa Payment Gateway
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Dark Mode Styles for Cart */
        body.dark-mode .dark-mode-text {
            color: #e2e8f0 !important;
        }
        
        body.dark-mode .dark-mode-card {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }
        
        body.dark-mode .dark-mode-table {
            background-color: #1e293b !important;
        }
        
        body.dark-mode .dark-mode-thead {
            background-color: #334155 !important;
        }
        
            body.dark-mode .dark-mode-thead th {
                color: #cbd5e1 !important;
                background-color: #334155 !important;
            }
        
        body.dark-mode .dark-mode-tbody tr {
            border-bottom-color: #334155 !important;
        }
        
            body.dark-mode .dark-mode-tbody tr:hover {
