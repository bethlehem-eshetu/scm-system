@model IEnumerable<SCM_System.Models.Entities.Notification>
@{
    ViewData["Title"] = "Operations Feed - SCM";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-5 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="text-white mb-1 fw-bold"><i class="fas fa-satellite text-accent-green me-3"></i>Operational Feed</h2>
                            <p class="text-white-50 mb-0 opacity-75">Tracking orders, tender status, and procurement alerts in real-time.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-accent-green text-dark-green rounded-pill px-4 py-2 shadow-sm fw-bold border-0" id="markAllReadBtn">
                                <i class="fas fa-check-double me-2"></i> Sync All Signals
                            </button>
                        </div>
                    </div>
                    <!-- Background Decoration -->
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-wave-square fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtration & Controls -->
    <div class="row mb-4 justify-content-center">
        <div class="col-xl-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white p-3 rounded-pill shadow-sm border px-4">
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted extra-small fw-bold me-2 ls-1 uppercase">Feed Filter:</span>
                    <button class="btn btn-dark-green btn-sm rounded-pill px-3 fw-bold filter-btn active" data-filter="all">All</button>
                    <button class="btn btn-soft-success btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Success">Success</button>
                    <button class="btn btn-soft-danger btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Error">Errors</button>
                    <button class="btn btn-soft-info btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Info">System</button>
                </div>
                <div class="search-mini position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted extra-small"></i>
                    <input type="text" id="retailerSignalSearch" class="form-control form-control-sm border-0 bg-faint-green rounded-pill ps-5" placeholder="Search signals..." style="width: 200px;">
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications Feed -->
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                <div class="card-header bg-faint-green py-4 px-5 border-0">
                    <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-history text-accent-green me-2"></i>Activity History</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="list-group list-group-flush border-0">
                            @foreach (var note in Model)
                            {
                                <div class="list-group-item px-5 py-4 border-faint transition-all notification-item @(!note.IsRead ? "bg-signal-unread" : "opacity-75")" data-type="@note.Type">
                                    <div class="d-flex align-items-start gap-4">
                                        <div class="signal-icon rounded-4 d-flex align-items-center justify-content-center flex-shrink-0 @(note.Type == "Success" ? "bg-soft-success text-success" : (note.Type == "Error" ? "bg-soft-danger text-danger" : "bg-soft-info text-info"))" style="width: 54px; height: 54px;">
                                            <i class="fas @(note.Type == "Success" ? "fa-check-circle" : (note.Type == "Error" ? "fa-exclamation-circle" : "fa-broadcast-tower")) fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <h6 class="fw-bold text-dark-green mb-0">@note.Title</h6>
                                                    @if (!note.IsRead) { <span class="signal-dot"></span> }
                                                </div>
                                                <span class="extra-small text-muted fw-bold text-uppercase ls-1">@note.CreatedAt.ToString("MMM dd | HH:mm")</span>
                                            </div>
                                            <p class="text-muted small fw-bold mb-3 opacity-75">@note.Message</p>
                                            
                                            @if (!string.IsNullOrEmpty(note.ActionUrl))
                                            {
                                                <a href="@note.ActionUrl" class="btn btn-dark-green btn-sm rounded-pill px-4 fw-bold extra-small text-accent-green">
                                                    INVESTIGATE <i class="fas fa-arrow-right ms-2 small"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 my-5">
                            <div class="bg-faint-green text-dark-green rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                                <i class="fas fa-bell-slash fa-3x opacity-25"></i>
                            </div>
                            <h4 class="fw-bold text-dark-green">Zero Signals Detected</h4>
                            <p class="text-muted small fw-bold opacity-50">Your operational channel is currently clear.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .btn-dark-green { background-color: var(--dark-green); color: white; }
        .btn-accent-green { background-color: var(--accent-green); color: var(--dark-green); }
        .btn-accent-green:hover { background-color: #c4e05d; transform: translateY(-2px); }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.65rem; }
        .uppercase { text-transform: uppercase; }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        .bg-signal-unread { background-color: rgba(212, 240, 109, 0.05); }
        .signal-dot { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; box-shadow: 0 0 10px var(--accent-green); }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.05); color: #198754; }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.05); color: #0dcaf0; }

        .fa-spin-slow { animation: fa-spin 25s infinite linear; }
    </style>
}

@section Scripts {
    <script>
        // Filtration Logic
        $('.filter-btn').click(function() {
            var filter = $(this).data('filter');
            $('.filter-btn').removeClass('btn-dark-green active').addClass('btn-light');
            $(this).removeClass('btn-light').addClass('btn-dark-green active');

            if (filter === 'all') {
                $('.notification-item').fadeIn();
            } else {
                $('.notification-item').hide();
                $('.notification-item[data-type="' + filter + '"]').fadeIn();
            }
        });

        // Search Logic
        $('#retailerSignalSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.notification-item').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        $('#markAllReadBtn').click(function() {
            $.post('/Notification/MarkAllAsRead', function(res) {
                if(res.success) {
                    toastr.success('Operational channel synchronized');
                    location.reload();
                }
            });
        });
    </script>
}
