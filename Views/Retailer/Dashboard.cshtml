@model SCM_System.Models.Entities.Retailer
@{
    ViewData["Title"] = "Retailer Dashboard";
    Layout = "_DashboardLayout";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<SCM_System.Models.Entities.Order>;
    var recentNotes = ViewBag.RecentNotifications as IEnumerable<SCM_System.Models.Entities.Notification>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Hello, <span class="text-primary">@Model.BusinessName</span> 👋</h2>
            <p class="text-muted">Welcome back to your procurement control center.</p>
        </div>
        <div class="d-flex gap-3">
            <a asp-action="Notifications" class="btn btn-white border rounded-pill px-3 shadow-sm position-relative">
                <i class="fas fa-bell text-warning"></i>
                @if (recentNotes != null && recentNotes.Any(n => !n.IsRead))
                {
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                }
            </a>
            <div class="dropdown">
                <button class="btn btn-primary rounded-pill px-4 shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-plus me-2"></i>Quick Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow p-2">
                    <li><a class="dropdown-item rounded-3" asp-controller="Tender" asp-action="Create"><i class="fas fa-gavel me-2 text-primary"></i>Create Tender</a></li>
                    <li><a class="dropdown-item rounded-3" asp-action="BrowseCatalog"><i class="fas fa-search me-2 text-primary"></i>Browse Products</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item rounded-3" asp-action="OrderTracking"><i class="fas fa-truck-loading me-2 text-primary"></i>Track Orders</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Stat Cards Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-gradient-brand">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="p-3 bg-white bg-opacity-20 rounded-4 text-white">
                            <i class="fas fa-shopping-basket fa-lg"></i>
                        </div>
                        <div class="text-end">
                            <div class="text-white text-opacity-75 small">Total Orders</div>
                            <div class="text-white h3 fw-bold mb-0">@ViewBag.TotalOrders</div>
                        </div>
                    </div>
                    <div class="progress bg-white bg-opacity-20" style="height: 6px;">
                        <div class="progress-bar bg-white" style="width: 70%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="p-3 bg-primary bg-opacity-10 rounded-4 text-primary">
                            <i class="fas fa-box fa-lg"></i>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Active Orders</div>
                            <div class="h3 fw-bold mb-0">@ViewBag.ActiveOrders</div>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar bg-primary" style="width: 45%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="p-3 bg-info bg-opacity-10 rounded-4 text-info">
                            <i class="fas fa-file-invoice-dollar fa-lg"></i>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Purchase Orders</div>
                            <div class="h3 fw-bold mb-0">@ViewBag.TotalPurchaseOrders</div>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar bg-info" style="width: 80%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="p-3 bg-success bg-opacity-10 rounded-4 text-success">
                            <i class="fas fa-truck fa-lg"></i>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Deliveries</div>
                            <div class="h3 fw-bold mb-0">@ViewBag.DeliveriesInProgress</div>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar bg-success" style="width: 25%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Overview Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
        <h6 class="fw-bold mb-4">Order Status Overview</h6>
        <div class="row g-3 text-center">
            <div class="col">
                <div class="p-3 rounded-4 bg-light border-bottom border-warning border-4">
                    <div class="h4 fw-bold mb-1">@ViewBag.StatusPending</div>
                    <div class="text-muted small">Pending</div>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-4 bg-light border-bottom border-primary border-4">
                    <div class="h4 fw-bold mb-1">@ViewBag.StatusProcessing</div>
                    <div class="text-muted small">Processing</div>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-4 bg-light border-bottom border-info border-4">
                    <div class="h4 fw-bold mb-1">@ViewBag.StatusInTransit</div>
                    <div class="text-muted small">In Transit</div>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-4 bg-light border-bottom border-success border-4">
                    <div class="h4 fw-bold mb-1">@ViewBag.StatusDelivered</div>
                    <div class="text-muted small">Delivered</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Orders -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white p-4 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Orders</h5>
                    <a asp-action="OrderTracking" class="btn btn-sm btn-link text-decoration-none p-0">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="ps-4">Order #</th>
                                <th>Supplier</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var o in recentOrders)
                                {
                                    <tr style="cursor: pointer" onclick="window.location.href='/Retailer/OrderTrackingDetails/@o.Id'">
                                        <td class="ps-4 fw-bold">#@o.OrderNumber</td>
                                        <td>@o.Supplier?.CompanyName</td>
                                        <td>
                                            <span class="badge rounded-pill bg-primary-soft text-primary px-3">@o.OrderStatus</span>
                                        </td>
                                        <td class="text-end pe-4 fw-bold">@o.TotalAmount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <p class="text-muted mb-0">No recent orders found.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Activity / Notifications Feed -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white p-4 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Activity</h5>
                    <a asp-action="Notifications" class="btn btn-sm btn-link text-decoration-none p-0 text-muted">See All</a>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="notification-feed">
                        @if (recentNotes != null && recentNotes.Any())
                        {
                            foreach (var n in recentNotes)
                            {
                                <div class="d-flex mb-4 gap-3">
                                    <div class="flex-shrink-0">
                                        <div class="rounded-circle p-2 @(n.Type == "Success" ? "bg-success-soft text-success" : (n.Type == "Error" ? "bg-danger-soft text-danger" : "bg-primary-soft text-primary"))">
                                            <i class="fas @(n.Type == "Success" ? "fa-check" : (n.Type == "Error" ? "fa-times" : "fa-bell")) small"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="fw-bold small mb-0 text-dark">@n.Title</div>
                                        <div class="extra-small text-muted line-clamp-2">@n.Message</div>
                                        <div class="extra-small text-muted opacity-50 mt-1" style="font-size: 0.7rem;">@n.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-stream fa-2x mb-3 text-muted opacity-25"></i>
                                <p class="text-muted mb-0">No recent activity.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-brand {
        background: linear-gradient(135deg, #4f46e5 0%, #0ea5e9 100%);
    }
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    
    .extra-small { font-size: 0.8rem; }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>