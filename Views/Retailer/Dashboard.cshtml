@model SCM_System.Models.Entities.Retailer
@{
    ViewData["Title"] = "Retailer Procurement Control";
    Layout = "_DashboardLayout";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<SCM_System.Models.Entities.Order>;
    var recentNotes = ViewBag.RecentNotifications as IEnumerable<SCM_System.Models.Entities.Notification>;
}

<div class="py-2">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "bg-dark-green" : "bg-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass text-white border-0 rounded-5 shadow-premium mb-5 p-4 animate-slide-up d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3 d-none d-sm-block">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div class="text-center text-sm-start">
                    <h6 class="fw-bold mb-0">Account Update</h6>
                    <p class="mb-0 small opacity-75">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white position-static" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Premium Enhanced Header (SCM Style) -->
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-premium border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1a3d31 0%, #0a2e24 100%);">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-lg-7 mb-4 mb-lg-0 text-white">
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#" class="text-white text-opacity-50 text-decoration-none small fw-bold text-uppercase tracking-widest">Retailer</a></li>
                                <li class="breadcrumb-item active small fw-bold text-uppercase tracking-widest text-white" aria-current="page">Overview</li>
                            </ol>
                        </nav>
                        <h1 class="display-5 fw-bold mb-2">
                            Hello, <span class="text-accent-green">@Model.BusinessName</span> 👋
                            @if (Model.User.IsFaydaVerified) { 
                                <span class="verified-badge ms-2" title="Fayda Verified Business">
                                    <i class="fas fa-check-circle text-accent-green"></i>
                                </span>
                            }
                        </h1>
                        <p class="text-white text-opacity-75 mb-0 fs-5">
                            <i class="fas fa-map-marker-alt me-2 text-accent-green"></i>@Model.City, @Model.Region 
                            <span class="mx-2 opacity-25">|</span>
                            <i class="fas fa-sync-alt me-2 text-success"></i>System synced at @DateTime.Now.ToString("HH:mm")
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <a href="@Url.Action("Cart", "Retailer")" class="btn btn-glass px-4 py-3 fw-bold d-flex align-items-center gap-3">
                                <div class="btn-icon bg-white bg-opacity-10 rounded-3">
                                    <i class="fas fa-shopping-cart text-white"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-white text-opacity-50 text-uppercase">Your Cart</div>
                                    <div class="text-white">View Items</div>
                                </div>
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-accent-green px-4 py-3 fw-bold d-flex align-items-center gap-3 shadow-lg border-0" type="button" data-bs-toggle="dropdown" style="color: #1a3d31;">
                                    <div class="btn-icon bg-black bg-opacity-10 rounded-3">
                                        <i class="fas fa-bolt"></i>
                                    </div>
                                    <div class="text-start">
                                        <div class="extra-small text-black text-opacity-50 text-uppercase">Actions</div>
                                        <div class="text-black">Quick Hub</div>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-premium p-2 mt-2" style="border-radius: 20px; min-width: 240px;">
                                    <li><h6 class="dropdown-header text-uppercase tracking-widest fw-bold py-3">Procurement</h6></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Retailer" asp-action="BrowseCatalog"><i class="fas fa-search me-2 text-dark-green"></i> Browse Marketplace</a></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Tender" asp-action="Create"><i class="fas fa-plus-circle me-2 text-warning"></i> Initiate New Tender</a></li>
                                    <li><hr class="dropdown-divider opacity-10"></li>
                                    <li><h6 class="dropdown-header text-uppercase tracking-widest fw-bold py-3">Logistics</h6></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4" asp-action="OrderTracking"><i class="fas fa-truck-loading me-2 text-success"></i> Active Shipments</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat Cards Section (SCM Style) -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-faint-green p-3 rounded-4 text-dark-green">
                            <i class="fas fa-shopping-basket fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Total Orders</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.TotalOrders</h3>
                        </div>
                    </div>
                    <div class="progress bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-dark-green" style="width: 70%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-warning p-3 rounded-4 text-warning">
                            <i class="fas fa-clock fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Active</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.ActiveOrders</h3>
                        </div>
                    </div>
                    <div class="progress bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: 45%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-info p-3 rounded-4 text-info">
                            <i class="fas fa-file-invoice-dollar fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">POs</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.TotalPurchaseOrders</h3>
                        </div>
                    </div>
                    <div class="progress bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width: 80%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-soft-success p-3 rounded-4 text-success">
                            <i class="fas fa-truck fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small text-uppercase fw-bold ls-1 mb-0">Deliveries</p>
                            <h3 class="fw-bold mb-0 text-dark-green">@ViewBag.DeliveriesInProgress</h3>
                        </div>
                    </div>
                    <div class="progress bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 25%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Activity Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1 text-dark-green">Spend Analytics</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">Purchasing Trends</h4>
                    </div>
                    <select id="spendRangeFilter" class="form-select form-select-sm border-0 bg-faint-green fw-bold rounded-pill px-3" style="width: 140px;">
                        <option value="6" selected>Last 6 Months</option>
                        <option value="12">Last 12 Months</option>
                    </select>
                </div>
                <div style="height: 300px; width: 100%;">
                    <canvas id="spendAnalyticsChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Order Distribution</h6>
                <div style="height: 250px; width: 100%;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
                <div class="mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted"><i class="fas fa-circle me-2" style="font-size: 8px; color: #06261E;"></i> Delivered</span>
                        <span class="small fw-bold text-dark-green">@ViewBag.StatusDelivered</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted"><i class="fas fa-circle me-2" style="font-size: 8px; color: #1A4D3A;"></i> Pending Settlement</span>
                        <span class="small fw-bold text-dark-green">@ViewBag.StatusPending</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><i class="fas fa-circle me-2" style="font-size: 8px; color: #2E9C7A;"></i> In Transit</span>
                        <span class="small fw-bold text-dark-green">@ViewBag.DeliveriesInProgress</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Delivery Performance</h6>
                <div class="d-flex align-items-center mb-4">
                    <div class="display-5 fw-bold text-dark-green">@ViewBag.OnTimeDeliveryRate%</div>
                    <div class="ms-3">
                        <div class="fw-bold text-dark-green">Success Rate</div>
                        <div class="small text-muted">On-time fulfillment</div>
                    </div>
                </div>
                <div class="progress rounded-pill bg-faint-green mb-3" style="height: 10px;">
                    <div class="progress-bar bg-dark-green rounded-pill" style="width: @ViewBag.OnTimeDeliveryRate%;"></div>
                </div>
                <p class="small text-muted mb-0">Calculated based on the last @ViewBag.TotalOrders orders completed.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Procurement Mix</h6>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-bold text-dark-green"><i class="fas fa-circle text-warning me-2" style="font-size: 8px;"></i>Direct Purchase</div>
                        <div class="small fw-bold text-dark-green">75%</div>
                    </div>
                    <div class="progress rounded-pill bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-warning rounded-pill" style="width: 75%;"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-bold text-dark-green"><i class="fas fa-circle text-info me-2" style="font-size: 8px;"></i>Tenders</div>
                        <div class="small fw-bold text-dark-green">25%</div>
                    </div>
                    <div class="progress rounded-pill bg-faint-green" style="height: 6px;">
                        <div class="progress-bar bg-info rounded-pill" style="width: 25%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Supplier Loyalty</h6>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-faint-green text-dark-green p-3">
                        <i class="fas fa-star fa-2x"></i>
                    </div>
                    <div>
                        <div class="h4 fw-bold mb-0 text-dark-green">@ViewBag.AverageRatingGiven.ToString("F1") / 5.0</div>
                        <div class="small text-muted">Avg Rating Given</div>
                    </div>
                </div>
                <div class="mt-auto">
                    <button class="btn btn-dark-green w-100 py-2 fw-bold rounded-pill" style="border-radius: 10px;">Review Recent Orders</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Procurements Table -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
                <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark-green">Recent Procurements</h5>
                        <p class="x-small text-muted mb-0">Track your ongoing orders and historical acquisitions</p>
                    </div>
                    <a asp-action="OrderTracking" class="btn btn-faint-green text-dark-green rounded-pill px-4 py-2 fw-bold small">View Full History</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="bg-faint-green">
                            <tr>
                                <th class="ps-4 py-3 text-muted x-small text-uppercase fw-bold ls-1">Order Details</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Supplier</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1">Status</th>
                                <th class="py-3 text-muted x-small text-uppercase fw-bold ls-1 text-end">Total Amount</th>
                                <th class="pe-4 py-3 text-muted x-small text-uppercase fw-bold ls-1 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var o in recentOrders)
                                {
                                    var (badgeClass, textColor) = o.OrderStatus switch
                                    {
                                        "Pending" => ("bg-soft-warning", "text-warning"),
                                        "Processing" => ("bg-soft-info", "text-info"),
                                        "In Transit" => ("bg-soft-primary", "text-primary"),
                                        "Delivered" => ("bg-soft-success", "text-success"),
                                        "Completed" => ("bg-soft-success", "text-success"),
                                        "Rejected" => ("bg-soft-danger", "text-danger"),
                                        _ => ("bg-soft-secondary", "text-secondary")
                                    };
                                    
                                    <tr onclick="window.location.href='/Order/Details/@o.Id'" style="cursor: pointer;">
                                        <td class="ps-4 py-4">
                                            <div class="fw-bold text-dark-green">#@o.OrderNumber</div>
                                            <div class="x-small text-muted">@o.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark-green">@o.Supplier?.CompanyName</div>
                                            <div class="x-small text-muted">@o.Supplier?.City</div>
                                        </td>
                                        <td>
                                            <span class="status-badge @badgeClass @textColor">
                                                <i class="fas fa-circle me-1" style="font-size: 6px;"></i> @o.OrderStatus
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-dark-green">
                                            @o.TotalAmount.ToString("N2") <span class="x-small">ETB</span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-faint-green text-dark-green rounded-circle" style="width: 32px; height: 32px; padding: 0;">
                                                <i class="fas fa-arrow-right x-small"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 opacity-50">
                                        <i class="fas fa-shopping-basket fa-3x mb-3 text-dark-green"></i>
                                        <h5 class="fw-bold text-dark-green">No Recent Procurements</h5>
                                        <a asp-action="BrowseCatalog" class="btn btn-dark-green rounded-pill px-5 py-2 fw-bold mt-3">Browse Catalog</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .welcome-banner { position: relative; border-radius: 40px !important; }
        .banner-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.05; z-index: 1; }
        .banner-glow { position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(212, 240, 109, 0.1) 0%, transparent 70%); filter: blur(50px); z-index: 1; }
        .btn-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); color: white; border-radius: 20px; transition: all 0.3s; }
        .btn-glass:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }
        .tracking-widest { letter-spacing: 2px; }

        .status-badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }

        .animate-slide-up { animation: slideUp 0.6s ease-out; }
        @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748B';

            const ctxSpend = document.getElementById('spendAnalyticsChart').getContext('2d');
            const accentColor = '#1a3d31';
            const gradient = ctxSpend.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(26, 61, 49, 0.1)');
            gradient.addColorStop(1, 'rgba(26, 61, 49, 0)');

            new Chart(ctxSpend, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Spend (ETB)',
                        data: [12000, 19000, 15000, 25000, 22000, 30000],
                        borderColor: accentColor,
                        backgroundColor: gradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: accentColor,
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            const ctxStatus = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'polarArea',
                data: {
                    labels: ['Delivered', 'Pending', 'In Transit'],
                    datasets: [{
                        data: [@ViewBag.StatusDelivered, @ViewBag.StatusPending, @ViewBag.DeliveriesInProgress],
                        backgroundColor: [
                            '#06261E', // Deepest Green
                            '#1A4D3A', // Medium Forest
                            '#2E9C7A'  // Vibrant Emerald
                        ],
                        hoverBackgroundColor: [
                            '#0B3B2F',
                            '#1E5A48',
                            '#3BAE86'
                        ],
                        borderWidth: 0,
                        spacing: 8 // This creates the separated "petal" effect
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    startAngle: -0.5 * Math.PI,
                    scales: {
                        r: {
                            display: false,
                            ticks: { display: false },
                            grid: { display: false },
                            suggestedMin: 0
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(6, 38, 30, 0.95)',
                            padding: 15,
                            cornerRadius: 15,
                            displayColors: false,
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 }
                        }
                    },
                    layout: {
                        padding: 10
                    }
                }
            });
        });
    </script>
}
