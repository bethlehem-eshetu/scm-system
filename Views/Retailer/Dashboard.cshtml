@model SCM_System.Models.Entities.Retailer
@{
    ViewData["Title"] = "Retailer Dashboard";
    Layout = "_DashboardLayout";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<SCM_System.Models.Entities.Order>;
    var recentNotes = ViewBag.RecentNotifications as IEnumerable<SCM_System.Models.Entities.Notification>;
}

<div class="container-fluid py-4 pb-5">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "alert-success" : "alert-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4 p-4 animate-slide-up" role="alert" style="border-left: 5px solid @(ViewBag.ApprovalStatusType == "Approved" ? "#2E9C7A" : "#E05A5A") !important;">
            <div class="d-flex align-items-center">
                <div class="alert-icon-container me-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Account Update</h5>
                    <p class="mb-0 opacity-90">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Premium Enhanced Header -->
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden">
                <!-- Background Decorative Elements -->
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#" class="text-white text-opacity-50 text-decoration-none small fw-bold text-uppercase tracking-widest">Retailer</a></li>
                                <li class="breadcrumb-item active small fw-bold text-uppercase tracking-widest text-white" aria-current="page">Overview</li>
                            </ol>
                        </nav>
                        <h1 class="display-5 fw-bold text-white mb-2">
                            Welcome back, <span class="text-gradient-gold">@Model.BusinessName</span>
                            @if (Model.User.IsFaydaVerified) { 
                                <span class="verified-badge ms-2" title="Fayda Verified Business">
                                    <i class="fas fa-check-circle"></i>
                                </span>
                            }
                        </h1>
                        <p class="text-white text-opacity-75 mb-0 fs-5">
                            <i class="fas fa-map-marker-alt me-2 text-info"></i>@Model.City, @Model.Region 
                            <span class="mx-2 opacity-25">|</span>
                            <i class="fas fa-sync-alt me-2 text-success"></i>System synced at @DateTime.Now.ToString("HH:mm")
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <a href="@Url.Action("Cart", "Retailer")" class="btn btn-glass px-4 py-3 fw-bold d-flex align-items-center gap-3">
                                <div class="btn-icon bg-white bg-opacity-10 rounded-3">
                                    <i class="fas fa-shopping-cart text-white"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-white text-opacity-50 text-uppercase">Your Cart</div>
                                    <div class="text-white">View Items</div>
                                </div>
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-gold px-4 py-3 fw-bold d-flex align-items-center gap-3 shadow-lg" type="button" data-bs-toggle="dropdown">
                                    <div class="btn-icon bg-black bg-opacity-20 rounded-3">
                                        <i class="fas fa-bolt"></i>
                                    </div>
                                    <div class="text-start">
                                        <div class="extra-small text-black text-opacity-50 text-uppercase">Actions</div>
                                        <div class="text-black">Quick Hub</div>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-2xl p-2 mt-2" style="border-radius: 20px; min-width: 240px;">
                                    <li><h6 class="dropdown-header text-uppercase tracking-widest fw-bold py-3">Procurement</h6></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Retailer" asp-action="BrowseCatalog"><i class="fas fa-search me-2 text-primary"></i> Browse Marketplace</a></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Tender" asp-action="Create"><i class="fas fa-plus-circle me-2 text-warning"></i> Initiate New Tender</a></li>
                                    <li><hr class="dropdown-divider opacity-10"></li>
                                    <li><h6 class="dropdown-header text-uppercase tracking-widest fw-bold py-3">Logistics</h6></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4" asp-action="OrderTracking"><i class="fas fa-truck-loading me-2 text-success"></i> Active Shipments</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main KPI Grid -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-primary-soft text-primary">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Total Orders</div>
                    <div class="kpi-value">@ViewBag.TotalOrders</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-success fw-bold"><i class="fas fa-caret-up me-1"></i>12%</span>
                    <span class="ms-1">from last month</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-warning-soft text-warning">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Active Orders</div>
                    <div class="kpi-value">@ViewBag.ActiveOrders</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted">@ViewBag.StatusPending pending start</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-info-soft text-info">
                    <i class="fas fa-truck-loading"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">In Transit</div>
                    <div class="kpi-value">@ViewBag.DeliveriesInProgress</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-info fw-bold">Live tracking active</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-success-soft text-success">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Total Spent</div>
                    <div class="kpi-value" style="font-size: 1.5rem;">@ViewBag.TotalSpent.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
        </div>
    </div>

    <!-- Analytics Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1">Spending Trend</h6>
                        <p class="extra-small text-muted mb-0">Monthly procurement expenditure (Last 6 months)</p>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light rounded-pill px-3 extra-small fw-bold border" type="button" data-bs-toggle="dropdown">
                            Last 6 Months <i class="fas fa-chevron-down ms-1 opacity-50"></i>
                        </button>
                    </div>
                </div>
                <div style="height: 300px;">
                    <canvas id="spendingChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark-card h-100">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Order Status Distribution</h6>
                <div style="height: 220px;" class="position-relative">
                    <canvas id="statusChart"></canvas>
                    <div class="chart-center-text">
                        <div class="h3 fw-bold mb-0">@ViewBag.TotalOrders</div>
                        <div class="extra-small text-muted">Total</div>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted"><i class="fas fa-circle text-warning me-2" style="font-size: 8px;"></i>Pending</span>
                        <span class="small fw-bold">@ViewBag.StatusPending</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted"><i class="fas fa-circle text-info me-2" style="font-size: 8px;"></i>Processing</span>
                        <span class="small fw-bold">@ViewBag.StatusProcessing</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small text-muted"><i class="fas fa-circle text-success me-2" style="font-size: 8px;"></i>Delivered</span>
                        <span class="small fw-bold">@ViewBag.StatusDelivered</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Procurement Mix</h6>
                <div style="height: 200px;">
                    <canvas id="procurementMixChart"></canvas>
                </div>
                <div class="d-flex justify-content-around mt-3">
                    <div class="text-center">
                        <div class="extra-small text-muted">Direct</div>
                        <div class="fw-bold">@(ViewBag.ProcurementMixData[0].ToString("F1"))%</div>
                    </div>
                    <div class="text-center">
                        <div class="extra-small text-muted">Tenders</div>
                        <div class="fw-bold">@(ViewBag.ProcurementMixData[1].ToString("F1"))%</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Delivery Performance</h6>
                <div class="d-flex align-items-center mb-4">
                    <div class="display-5 fw-bold text-primary">@ViewBag.OnTimeDeliveryRate%</div>
                    <div class="ms-3">
                        <div class="fw-bold text-dark">Success Rate</div>
                        <div class="small text-muted">On-time fulfillment</div>
                    </div>
                </div>
                <div class="progress rounded-pill bg-light mb-3" style="height: 10px;">
                    <div class="progress-bar bg-primary rounded-pill" style="width: @ViewBag.OnTimeDeliveryRate%;"></div>
                </div>
                <p class="small text-muted mb-0">Calculated based on the last @ViewBag.TotalOrders orders completed.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Supplier Loyalty</h6>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="fas fa-star fa-2x"></i>
                    </div>
                    <div>
                        <div class="h4 fw-bold mb-0">@ViewBag.AverageRatingGiven.ToString("F1") / 5.0</div>
                        <div class="small text-muted">Avg Rating Given</div>
                    </div>
                </div>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-card w-100 py-2 fw-bold" style="border-radius: 10px;">Review Recent Orders</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Orders Table -->
        <div class="col-lg-8">
            <div class="section-card">
                <div class="d-flex justify-content-between align-items-center p-4">
                    <h5 class="fw-bold mb-0">Recent Procurements</h5>
                    <a asp-action="OrderTracking" class="btn btn-sm btn-outline-card px-3 fw-bold" style="border-radius: 8px;">View History</a>
                </div>
                <div class="table-responsive">
                    <table class="admin-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Supplier</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var o in recentOrders)
                                {
                                    var statusBadge = o.OrderStatus switch
                                    {
                                        "Pending" => "badge-soft-warning",
                                        "Processing" => "badge-soft-info",
                                        "In Transit" => "badge-soft-primary",
                                        "Partially Delivered" => "badge-soft-info",
                                        "Delivered" => "badge-soft-success",
                                        "Completed" => "badge-soft-success",
                                        "Rejected" => "badge-soft-danger",
                                        _ => "badge-soft-secondary"
                                    };
                                    
                                    <tr onclick="window.location.href='/Order/Details/@o.Id'">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@o.OrderNumber</div>
                                            <div class="extra-small text-muted">@o.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@o.Supplier?.CompanyName</div>
                                            <div class="extra-small text-muted">@o.Supplier?.City</div>
                                        </td>
                                        <td>
                                            <span class="badge-soft @statusBadge">
                                                <i class="fas fa-circle me-1" style="font-size: 6px;"></i> @o.OrderStatus
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold">@o.TotalAmount.ToString("N2") <span class="extra-small">ETB</span></td>
                                        <td class="pe-4 text-end">
                                            <a href="/Order/Details/@o.Id" class="btn btn-sm btn-icon-sm btn-outline-card">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="empty-state">
                                            <i class="fas fa-shopping-cart opacity-25 fa-3x mb-3"></i>
                                            <h5>No Orders Yet</h5>
                                            <p>Start sourcing products from our catalog.</p>
                                            <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4">Browse Products</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Activity & Support Sidebar -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Recent Activity Feed -->
                <div class="section-card p-4">
                    <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Live Activity Feed</h6>
                    <div class="activity-timeline">
                        @if (recentNotes != null && recentNotes.Any())
                        {
                            foreach (var n in recentNotes)
                            {
                                <div class="timeline-item d-flex gap-3 mb-4">
                                    <div class="timeline-icon bg-@(n.Type == "Success" ? "success" : (n.Type == "Error" ? "danger" : "primary"))-soft">
                                        <i class="fas @(n.Type == "Success" ? "fa-check" : (n.Type == "Error" ? "fa-times" : "fa-bell")) small"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <div class="fw-bold small text-dark">@n.Title</div>
                                        <div class="extra-small text-muted line-clamp-2">@n.Message</div>
                                        <div class="extra-small text-muted opacity-50 mt-1">@n.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-stream opacity-25 mb-3"></i>
                                <p class="small text-muted">No recent activities.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recent Conversations -->
                <div class="section-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-0">Active Conversations</h6>
                        <a href="@Url.Action("Inbox", "Message")" class="extra-small text-primary text-decoration-none fw-bold">INBOX</a>
                    </div>
                    @if (ViewBag.RecentConversations != null && ViewBag.RecentConversations.Count > 0)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var conv in ViewBag.RecentConversations)
                            {
                                <a href="@Url.Action("Conversation", "Message", new { id = conv.OtherUserId })" class="text-decoration-none">
                                    <div class="conversation-item p-3 rounded-4 border transition">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                @conv.OtherUserName.Substring(0, 1)
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="fw-bold small text-dark text-truncate">@conv.OtherUserName</div>
                                                    <div class="extra-small text-muted">@conv.LastMessageAt.ToString("MMM dd")</div>
                                                </div>
                                                <div class="extra-small text-muted text-truncate">@conv.LastMessage</div>
                                            </div>
                                            @if (conv.UnreadCount > 0)
                                            {
                                                <span class="badge bg-danger rounded-circle p-1" style="width: 18px; height: 18px; font-size: 10px;">@conv.UnreadCount</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-4 border-dashed">
                            <i class="fas fa-comments opacity-25 mb-2"></i>
                            <p class="extra-small text-muted mb-2">No active chats</p>
                            <a href="@Url.Action("SelectRecipient", "Message")" class="btn btn-sm btn-primary rounded-pill px-3 py-1 extra-small fw-bold">Start Chat</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Enhanced Header Styles */
    .welcome-banner {
        background: linear-gradient(135deg, #0B3B2F 0%, #1A4D3A 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .banner-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: url('https://www.transparenttextures.com/patterns/cubes.png');
        opacity: 0.05; z-index: 1;
    }
    .banner-glow {
        position: absolute; top: -50%; right: -20%; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(46, 156, 122, 0.2) 0%, transparent 70%);
        filter: blur(50px); z-index: 1;
    }
    .text-gradient-gold {
        background: linear-gradient(to right, #f1c40f, #f39c12);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
    .verified-badge {
        color: #3498db;
        font-size: 1.5rem;
        filter: drop-shadow(0 0 5px rgba(52, 152, 219, 0.3));
    }
    .btn-glass {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        transition: all 0.3s ease;
        border-radius: 16px;
    }
    .btn-glass:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: translateY(-2px);
        color: white;
    }
    .btn-gold {
        background: linear-gradient(135deg, #f1c40f 0%, #f39c12 100%);
        border: none;
        color: #000;
        transition: all 0.3s ease;
        border-radius: 16px;
    }
    .btn-gold:hover {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(243, 156, 18, 0.3);
    }
    .btn-icon {
        width: 38px; height: 38px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
    }
    .z-index-2 { z-index: 2; }
    .tracking-widest { letter-spacing: 2px; }

    /* Premium Dashboard Styles */
    .kpi-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .kpi-icon-box {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }
    .kpi-label {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }
    .kpi-value {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--text-color);
        line-height: 1.2;
    }
    .kpi-footer {
        width: 100%;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        font-size: 12px;
        color: var(--text-muted);
    }
    
    .section-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        overflow: hidden;
    }

    .bg-primary-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-warning-soft { background: rgba(230, 126, 34, 0.1); color: #E67E22; }
    .bg-info-soft { background: rgba(91, 143, 249, 0.1); color: #5B8FF9; }
    .bg-success-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-danger-soft { background: rgba(224, 90, 90, 0.1); color: #E05A5A; }

    .timeline-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .conversation-item:hover {
        background: var(--hover-state);
        border-color: var(--primary-color) !important;
    }
    
    .extra-small { font-size: 0.75rem; }
    .tracking-wider { letter-spacing: 1px; }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Dark Mode specific overrides */
    .dark-mode .section-card, .dark-mode .kpi-card {
        box-shadow: none;
    }
    .dark-mode .bg-light {
        background-color: var(--hover-state) !important;
    }
    .chart-center-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }
</style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // Load live counts
            loadCounts();
            setInterval(loadCounts, 30000);

            // Initialize Charts
            initSpendingChart();
            initStatusChart();
            initProcurementMixChart();
        });

        function initSpendingChart() {
            const ctx = document.getElementById('spendingChart').getContext('2d');
            const labels = @Html.Raw(Json.Serialize(ViewBag.MonthlySpendingLabels));
            const data = @Html.Raw(Json.Serialize(ViewBag.MonthlySpendingData));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Spending (ETB)',
                        data: data,
                        borderColor: '#2E9C7A',
                        backgroundColor: 'rgba(46, 156, 122, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#2E9C7A',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false },
                            ticks: { font: { size: 10 } }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        function initStatusChart() {
            const ctx = document.getElementById('statusChart').getContext('2d');
            const data = @Html.Raw(Json.Serialize(ViewBag.OrderStatusData));

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Processing', 'In Transit', 'Delivered'],
                    datasets: [{
                        data: data,
                        backgroundColor: ['#f1c40f', '#3498db', '#9b59b6', '#2ecc71'],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        function initProcurementMixChart() {
            const ctx = document.getElementById('procurementMixChart').getContext('2d');
            const data = @Html.Raw(Json.Serialize(ViewBag.ProcurementMixData));

            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Direct', 'Tenders'],
                    datasets: [{
                        data: data,
                        backgroundColor: ['#e67e22', '#3498db'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20,
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });
        }

        function loadCounts() {
            $.get('/Notification/GetUnreadCount', function (data) {
                if (data.count > 0) $('#notificationBadge').text(data.count).show();
                else $('#notificationBadge').hide();
            });
            $.get('/Message/GetUnreadCount', function (data) {
                if (data > 0) $('#messageBadge').text(data).show();
                else $('#messageBadge').hide();
            });
        }
    </script>
}
