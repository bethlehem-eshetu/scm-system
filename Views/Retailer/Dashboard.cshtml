@model SCM_System.Models.Entities.Retailer
@{
    ViewData["Title"] = "Retailer Dashboard";
    Layout = "_DashboardLayout";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<SCM_System.Models.Entities.Order>;
    var recentNotes = ViewBag.RecentNotifications as IEnumerable<SCM_System.Models.Entities.Notification>;
}

<div class="container-fluid py-4 pb-5">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "alert-success" : "alert-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4 p-4 animate-slide-up" role="alert" style="border-left: 5px solid @(ViewBag.ApprovalStatusType == "Approved" ? "#2E9C7A" : "#E05A5A") !important;">
            <div class="d-flex align-items-center">
                <div class="alert-icon-container me-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Account Update</h5>
                    <p class="mb-0 opacity-90">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none small fw-bold text-uppercase tracking-wider opacity-50">Retailer</a></li>
                    <li class="breadcrumb-item active small fw-bold text-uppercase tracking-wider text-primary" aria-current="page">Dashboard</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1 display-6">
                Welcome, <span class="text-primary">@Model.BusinessName</span>
                @if (Model.User.IsFaydaVerified) { <i class="fas fa-certificate text-info ms-1" style="font-size: 1.2rem;" title="Verified Business"></i> }
            </h2>
            <p class="text-muted mb-0"><i class="fas fa-map-marker-alt me-1 opacity-50"></i> @Model.City, @Model.Region | <i class="fas fa-calendar-alt me-1 opacity-50"></i> Last sync: @DateTime.Now.ToString("HH:mm")</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Cart", "Retailer")" class="btn btn-outline-card px-4 py-2 fw-bold d-flex align-items-center gap-2" style="border-radius: 12px;">
                <i class="fas fa-shopping-cart text-primary"></i> View Cart
            </a>
            <div class="dropdown">
                <button class="btn btn-primary px-4 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm" type="button" data-bs-toggle="dropdown" style="border-radius: 12px;">
                    <i class="fas fa-bolt"></i> Quick Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2" style="border-radius: 16px; min-width: 200px;">
                    <li><a class="dropdown-item py-2 rounded-3" asp-controller="Retailer" asp-action="BrowseCatalog"><i class="fas fa-search me-2 opacity-50"></i> Browse Products</a></li>
                    <li><a class="dropdown-item py-2 rounded-3" asp-controller="Tender" asp-action="Create"><i class="fas fa-plus-circle me-2 opacity-50"></i> Create Tender</a></li>
                    <li><hr class="dropdown-divider opacity-50"></li>
                    <li><a class="dropdown-item py-2 rounded-3" asp-action="OrderTracking"><i class="fas fa-route me-2 opacity-50"></i> Track Deliveries</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Main KPI Grid -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-primary-soft text-primary">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Total Orders</div>
                    <div class="kpi-value">@ViewBag.TotalOrders</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-success fw-bold"><i class="fas fa-caret-up me-1"></i>12%</span>
                    <span class="ms-1">from last month</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-warning-soft text-warning">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Active Orders</div>
                    <div class="kpi-value">@ViewBag.ActiveOrders</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted">@ViewBag.StatusPending pending start</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-info-soft text-info">
                    <i class="fas fa-truck-loading"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">In Transit</div>
                    <div class="kpi-value">@ViewBag.DeliveriesInProgress</div>
                </div>
                <div class="kpi-footer">
                    <span class="text-info fw-bold">Live tracking active</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-success-soft text-success">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Total Spent</div>
                    <div class="kpi-value" style="font-size: 1.5rem;">@ViewBag.TotalSpent.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted">Avg: @ViewBag.AverageOrderValue.ToString("N0") / order</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Delivery Performance</h6>
                <div class="d-flex align-items-center mb-4">
                    <div class="display-5 fw-bold text-primary">@ViewBag.OnTimeDeliveryRate%</div>
                    <div class="ms-3">
                        <div class="fw-bold text-dark">Success Rate</div>
                        <div class="small text-muted">On-time fulfillment</div>
                    </div>
                </div>
                <div class="progress rounded-pill bg-light mb-3" style="height: 10px;">
                    <div class="progress-bar bg-primary rounded-pill" style="width: @ViewBag.OnTimeDeliveryRate%;"></div>
                </div>
                <p class="small text-muted mb-0">Calculated based on the last @ViewBag.TotalOrders orders completed.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Procurement Mix</h6>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-bold"><i class="fas fa-circle text-warning me-2" style="font-size: 8px;"></i>Direct Purchase</div>
                        <div class="small fw-bold">75%</div>
                    </div>
                    <div class="progress rounded-pill bg-light" style="height: 6px;">
                        <div class="progress-bar bg-warning rounded-pill" style="width: 75%;"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-bold"><i class="fas fa-circle text-info me-2" style="font-size: 8px;"></i>Tenders</div>
                        <div class="small fw-bold">25%</div>
                    </div>
                    <div class="progress rounded-pill bg-light" style="height: 6px;">
                        <div class="progress-bar bg-info rounded-pill" style="width: 25%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Supplier Loyalty</h6>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="fas fa-star fa-2x"></i>
                    </div>
                    <div>
                        <div class="h4 fw-bold mb-0">@ViewBag.AverageRatingGiven.ToString("F1") / 5.0</div>
                        <div class="small text-muted">Avg Rating Given</div>
                    </div>
                </div>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-card w-100 py-2 fw-bold" style="border-radius: 10px;">Review Recent Orders</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Orders Table -->
        <div class="col-lg-8">
            <div class="section-card">
                <div class="d-flex justify-content-between align-items-center p-4">
                    <h5 class="fw-bold mb-0">Recent Procurements</h5>
                    <a asp-action="OrderTracking" class="btn btn-sm btn-outline-card px-3 fw-bold" style="border-radius: 8px;">View History</a>
                </div>
                <div class="table-responsive">
                    <table class="admin-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Supplier</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var o in recentOrders)
                                {
                                    var statusBadge = o.OrderStatus switch
                                    {
                                        "Pending" => "badge-soft-warning",
                                        "Processing" => "badge-soft-info",
                                        "In Transit" => "badge-soft-primary",
                                        "Partially Delivered" => "badge-soft-info",
                                        "Delivered" => "badge-soft-success",
                                        "Completed" => "badge-soft-success",
                                        "Rejected" => "badge-soft-danger",
                                        _ => "badge-soft-secondary"
                                    };
                                    
                                    <tr onclick="window.location.href='/Order/Details/@o.Id'">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@o.OrderNumber</div>
                                            <div class="extra-small text-muted">@o.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@o.Supplier?.CompanyName</div>
                                            <div class="extra-small text-muted">@o.Supplier?.City</div>
                                        </td>
                                        <td>
                                            <span class="badge-soft @statusBadge">
                                                <i class="fas fa-circle me-1" style="font-size: 6px;"></i> @o.OrderStatus
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold">@o.TotalAmount.ToString("N2") <span class="extra-small">ETB</span></td>
                                        <td class="pe-4 text-end">
                                            <a href="/Order/Details/@o.Id" class="btn btn-sm btn-icon-sm btn-outline-card">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="empty-state">
                                            <i class="fas fa-shopping-cart opacity-25 fa-3x mb-3"></i>
                                            <h5>No Orders Yet</h5>
                                            <p>Start sourcing products from our catalog.</p>
                                            <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4">Browse Products</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Activity & Support Sidebar -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Recent Activity Feed -->
                <div class="section-card p-4">
                    <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Live Activity Feed</h6>
                    <div class="activity-timeline">
                        @if (recentNotes != null && recentNotes.Any())
                        {
                            foreach (var n in recentNotes)
                            {
                                <div class="timeline-item d-flex gap-3 mb-4">
                                    <div class="timeline-icon bg-@(n.Type == "Success" ? "success" : (n.Type == "Error" ? "danger" : "primary"))-soft">
                                        <i class="fas @(n.Type == "Success" ? "fa-check" : (n.Type == "Error" ? "fa-times" : "fa-bell")) small"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <div class="fw-bold small text-dark">@n.Title</div>
                                        <div class="extra-small text-muted line-clamp-2">@n.Message</div>
                                        <div class="extra-small text-muted opacity-50 mt-1">@n.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-stream opacity-25 mb-3"></i>
                                <p class="small text-muted">No recent activities.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recent Conversations -->
                <div class="section-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-0">Active Conversations</h6>
                        <a href="@Url.Action("Inbox", "Message")" class="extra-small text-primary text-decoration-none fw-bold">INBOX</a>
                    </div>
                    @if (ViewBag.RecentConversations != null && ViewBag.RecentConversations.Count > 0)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var conv in ViewBag.RecentConversations)
                            {
                                <a href="@Url.Action("Conversation", "Message", new { id = conv.OtherUserId })" class="text-decoration-none">
                                    <div class="conversation-item p-3 rounded-4 border transition">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                @conv.OtherUserName.Substring(0, 1)
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="fw-bold small text-dark text-truncate">@conv.OtherUserName</div>
                                                    <div class="extra-small text-muted">@conv.LastMessageAt.ToString("MMM dd")</div>
                                                </div>
                                                <div class="extra-small text-muted text-truncate">@conv.LastMessage</div>
                                            </div>
                                            @if (conv.UnreadCount > 0)
                                            {
                                                <span class="badge bg-danger rounded-circle p-1" style="width: 18px; height: 18px; font-size: 10px;">@conv.UnreadCount</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-4 border-dashed">
                            <i class="fas fa-comments opacity-25 mb-2"></i>
                            <p class="extra-small text-muted mb-2">No active chats</p>
                            <a href="@Url.Action("SelectRecipient", "Message")" class="btn btn-sm btn-primary rounded-pill px-3 py-1 extra-small fw-bold">Start Chat</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Dashboard Styles */
    .kpi-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .kpi-icon-box {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }
    .kpi-label {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }
    .kpi-value {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--text-color);
        line-height: 1.2;
    }
    .kpi-footer {
        width: 100%;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        font-size: 12px;
        color: var(--text-muted);
    }
    
    .section-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        overflow: hidden;
    }

    .bg-primary-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-warning-soft { background: rgba(230, 126, 34, 0.1); color: #E67E22; }
    .bg-info-soft { background: rgba(91, 143, 249, 0.1); color: #5B8FF9; }
    .bg-success-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-danger-soft { background: rgba(224, 90, 90, 0.1); color: #E05A5A; }

    .timeline-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .conversation-item:hover {
        background: var(--hover-state);
        border-color: var(--primary-color) !important;
    }
    
    .extra-small { font-size: 0.75rem; }
    .tracking-wider { letter-spacing: 1px; }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Dark Mode specific overrides */
    .dark-mode .section-card, .dark-mode .kpi-card {
        box-shadow: none;
    }
    .dark-mode .bg-light {
        background-color: var(--hover-state) !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load live counts
            loadCounts();
            setInterval(loadCounts, 30000);
        });

        function loadCounts() {
            $.get('/Notification/GetUnreadCount', function (data) {
                if (data.count > 0) $('#notificationBadge').text(data.count).show();
                else $('#notificationBadge').hide();
            });
            $.get('/Message/GetUnreadCount', function (data) {
                if (data > 0) $('#messageBadge').text(data).show();
                else $('#messageBadge').hide();
            });
        }
    </script>
}
