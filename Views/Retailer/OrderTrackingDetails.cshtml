@model SCM_System.Models.Entities.Order
@{
    ViewData["Title"] = "Order Tracking Details";
    Layout = "_DashboardLayout";
    
    // Status Flow for Retailer
    var statuses = new[] { "Pending", "Processing", "Picked", "Packed", "In Transit", "Delivered", "Completed" };
    
    // ✅ FIX: Determine correct status based on Purchase Orders
    var totalPOs = Model.PurchaseOrders?.Count() ?? 0;
    var deliveredPOs = Model.PurchaseOrders?.Count(po => po.Status == "Delivered" || po.Status == "Completed") ?? 0;
    var inTransitPOs = Model.PurchaseOrders?.Count(po => po.Status == "In Transit") ?? 0;
    
    string displayStatus = Model.OrderStatus;
    
    // If all POs are delivered but order status not updated
    if (deliveredPOs == totalPOs && totalPOs > 0 && Model.OrderStatus != "Delivered" && Model.OrderStatus != "Completed")
    {
        displayStatus = "Delivered";
    }
    // If any PO is In Transit but not delivered
    else if (inTransitPOs > 0 && deliveredPOs < totalPOs && Model.OrderStatus != "In Transit")
    {
        displayStatus = "In Transit";
    }
    // If some POs are delivered
    else if (deliveredPOs > 0 && deliveredPOs < totalPOs && Model.OrderStatus != "Partially Delivered")
    {
        displayStatus = "Partially Delivered";
    }
    
    int currentIdx = Array.IndexOf(statuses, displayStatus);
    if (currentIdx == -1 && displayStatus == "Partially Processing") currentIdx = 1;
    if (currentIdx == -1 && displayStatus == "Partially Delivered") currentIdx = 4;

    var latestPO = Model.PurchaseOrders?.OrderByDescending(p => p.UpdatedAt).FirstOrDefault();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Track Order #@Model.OrderNumber</h2>
            <p class="text-muted mb-0">Real-time logistics monitoring for your procurement</p>
        </div>
        <div class="text-end d-flex align-items-center gap-3">
            @if (displayStatus != "Picked" && displayStatus != "Packed" && displayStatus != "Shipped" && displayStatus != "In Transit" && displayStatus != "Delivered" && displayStatus != "Completed" && displayStatus != "Cancelled")
            {
                <form asp-controller="Retailer" asp-action="CancelOrder" method="post" onsubmit="return confirm('Are you sure you want to cancel this order? Stock will be immediately returned to the supplier.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4 py-2 fs-6 fw-bold"><i class="fas fa-times-circle me-2"></i>Cancel Order</button>
                </form>
            }
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-4 py-2 fs-6 border border-primary border-opacity-10">@displayStatus</span>
        </div>
    </div>

    <!-- High-Fidelity Timeline Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 order-status-container" data-order-id="@Model.Id">
        <div class="d-flex justify-content-between mb-4">
            <h5 class="fw-bold">Procurement Journey</h5>
            <span class="text-muted small fw-bold status-text">LATEST UPDATE: @(latestPO?.UpdatedAt.ToString("HH:mm") ?? "N/A")</span>
        </div>

        <div class="d-flex justify-content-between position-relative px-2 mb-4" style="min-width: 800px;">
            <div class="position-absolute top-50 start-0 translate-middle-y w-100 bg-light" style="height: 6px; border-radius: 3px; z-index: 0; margin-top: -15px;"></div>
            <div class="position-absolute top-50 start-0 translate-middle-y bg-primary" style="height: 6px; border-radius: 3px; z-index: 1; margin-top: -15px; width: @(currentIdx * 14.28)%; transition: width 1.5s cubic-bezier(0.34, 1.56, 0.64, 1);"></div>

            @for (int i = 0; i < statuses.Length; i++)
            {
                var icon = i switch { 0 => "fa-clock", 1 => "fa-sync", 2 => "fa-hand-holding-box", 3 => "fa-box", 4 => "fa-truck-fast", 5 => "fa-home", _ => "fa-check-double" };
                var activeClass = i <= currentIdx ? "bg-primary text-white shadow" : "bg-white text-muted border border-light";
                var labelClass = i <= currentIdx ? "text-dark fw-bold" : "text-muted";

                <div class="text-center position-relative" style="z-index: 2; width: 60px;">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle @activeClass" style="width: 50px; height: 50px; transition: all 0.5s ease;">
                        <i class="fas @icon fa-lg"></i>
                    </div>
                    <div class="smaller @labelClass">@statuses[i]</div>
                    @if (i == 0) { <div class="extra-small text-muted">@Model.CreatedAt.ToString("MMM dd")</div> }
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Delivery Agent & Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-10">
                    <i class="fas fa-shipping-fast fa-4x"></i>
                </div>
                <h6 class="fw-bold text-uppercase text-muted mb-4">Delivery Intelligence</h6>
                
                <div class="mb-4">
                    <label class="smaller text-muted d-block">ESTIMATED ARRIVAL</label>
                    <span class="fs-5 fw-bold text-primary">@Model.ExpectedDeliveryDate?.ToString("ddd, MMM dd")</span>
                </div>

                <div class="mb-4 d-flex align-items-center">
                    <div class="flex-shrink-0 bg-light rounded-circle p-3 me-3">
                        <i class="fas fa-user-tie text-primary fa-lg"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">LOGISTICS AGENT</label>
                        <span class="fw-bold text-dark">@(latestPO?.DeliveryAgent?.User?.FullName ?? "Assigning soon...")</span>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-3 small">
                    <i class="fas fa-info-circle me-2"></i> Our agent will notify you upon arrival at your business location.
                </div>
                
                @if (displayStatus == "Delivered")
                {
                    <form asp-controller="Order" asp-action="UpdateStatus" method="post" class="mt-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="Completed" />
                        <input type="hidden" name="comments" value="Order confirmed by Retailer." />
                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm py-2">
                            <i class="fas fa-check-double me-2"></i> Confirm Final Receipt
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Items Overview -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 border-start border-4 border-primary">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h6 class="fw-bold mb-0">Shipment Contents</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 smaller text-muted text-uppercase">Product</th>
                                    <th class="smaller text-muted text-uppercase">Quantity</th>
                                    <th class="text-end pe-4 smaller text-muted text-uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                            <div class="extra-small text-muted">SKU: @item.Product?.Id.ToString("D5")</div>
                                         </td
                                        <td><span class="badge bg-light text-dark border">x @item.Quantity @item.Product?.Unit</span></td
                                        <td class="text-end pe-4">
                                            <span class="badge @(displayStatus == "Delivered" || displayStatus == "Completed" ? "bg-success" : "bg-primary") bg-opacity-10 @(displayStatus == "Delivered" || displayStatus == "Completed" ? "text-success" : "text-primary") rounded-pill px-3">
                                                @(displayStatus == "Delivered" || displayStatus == "Completed" ? "Delivered" : "Fulfillment Active")
                                            </span>
                                        </td
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PROOF OF DELIVERY SECTION -->
    @if (Model.PurchaseOrders != null && Model.PurchaseOrders.Any(po => !string.IsNullOrEmpty(po.ProofOfDelivery)))
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold">
                            <i class="fas fa-camera me-2 text-primary"></i>Proof of Delivery
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        @foreach (var po in Model.PurchaseOrders.Where(po => !string.IsNullOrEmpty(po.ProofOfDelivery)))
                        {
                            <div class="mb-4 pb-3 border-bottom">
                                <label class="fw-bold mb-2">PO #@po.PONumber</label>
                                @if (po.ProofOfDelivery.StartsWith("/uploads/"))
                                {
                                    <div class="mt-2">
                                        <img src="@po.ProofOfDelivery" alt="Proof of Delivery" class="img-fluid rounded border shadow-sm" style="max-height: 250px; max-width: 100%;" />
                                        <div class="mt-2">
                                            <a href="@po.ProofOfDelivery" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="fas fa-external-link-alt me-1"></i> View Full Image
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info bg-light border-0 rounded-3 mt-2">
                                        <i class="fas fa-signature me-2 text-primary"></i>
                                        <strong>Signature / Receipt Code:</strong> @po.ProofOfDelivery
                                    </div>
                                }
                                @if (po.DeliveredAt.HasValue)
                                {
                                    <small class="text-muted d-block mt-2">
                                        <i class="far fa-clock me-1"></i> Delivered on: @po.DeliveredAt.Value.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .smaller { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }
    .extra-small { font-size: 0.65rem; }
    .status-text { letter-spacing: 1px; }
</style>

@section Scripts {
    <script>
        // Polling for status updates every 10 seconds
        setInterval(function() {
            const container = document.querySelector('.order-status-container');
            if (container) {
                const orderId = container.dataset.orderId;
                fetch(`/Order/GetStatus/${orderId}`)
                    .then(response => response.json())
                    .then(data => {
                        const currentStatusBadge = document.querySelector('.badge.bg-primary');
                        if (currentStatusBadge && currentStatusBadge.innerText.trim() !== data.status) {
                            location.reload(); 
                        }
                    })
                    .catch(error => console.log('Status check failed:', error));
            }
        }, 10000);
    </script>
}