@model IEnumerable<SCM_System.Models.Entities.Order>
@{
    ViewData["Title"] = "Live Order Tracking";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Live Order <span class="text-primary">Tracking</span></h2>
            <p class="text-muted mb-0">Real-time status updates and delivery tracking</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>New Order
            </a>
        </div>
    </div>



    <!-- Order Cards -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                // Calculate progress based on Purchase Orders
                var totalPOs = order.PurchaseOrders?.Count() ?? 0;
                var deliveredPOs = order.PurchaseOrders?.Count(po => po.Status == "Delivered" || po.Status == "Completed") ?? 0;
                var inTransitPOs = order.PurchaseOrders?.Count(po => po.Status == "In Transit") ?? 0;
                var progress = totalPOs > 0 ? (deliveredPOs * 100 / totalPOs) : 0;
                
                // Determine the actual display status
                string displayStatus = order.OrderStatus;
                
                if (deliveredPOs == totalPOs && totalPOs > 0 && order.OrderStatus != "Delivered" && order.OrderStatus != "Completed")
                {
                    displayStatus = "Delivered";
                }
                else if (inTransitPOs > 0 && deliveredPOs < totalPOs && order.OrderStatus != "In Transit")
                {
                    displayStatus = "In Transit";
                }
                else if (deliveredPOs > 0 && deliveredPOs < totalPOs && order.OrderStatus != "Partially Delivered")
                {
                    displayStatus = "Partially Delivered";
                }
                
                var statusColor = displayStatus switch
                {
                    "Pending" => "warning",
                    "Processing" => "info",
                    "In Transit" => "primary",
                    "Partially Delivered" => "info",
                    "Delivered" => "success",
                    "Completed" => "success",
                    _ => "secondary"
                };
                
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white py-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold mb-0">
                                        Order #@order.OrderNumber
                                        <span class="badge bg-@statusColor ms-2">@displayStatus</span>
                                    </h5>
                                    <small class="text-muted">Placed on @order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-primary">@order.TotalAmount.ToString("C")</div>
                                    <small class="text-muted">@order.Supplier?.CompanyName</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <!-- Progress Bar -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold">Delivery Progress</span>
                                    <span class="small fw-bold text-primary">@progress% Complete</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-@statusColor" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- Status Timeline -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3"><i class="fas fa-history me-2"></i>Order Timeline</h6>
                                <div class="timeline-horizontal d-flex justify-content-between">
                                    <div class="timeline-step @(displayStatus != "Pending" ? "completed" : "active")">
                                        <div class="timeline-icon bg-warning">
                                            <i class="fas fa-shopping-cart text-white"></i>
                                        </div>
                                        <div class="timeline-label">Order Placed</div>
                                        <small class="text-muted">@order.CreatedAt.ToString("MMM dd")</small>
                                    </div>
                                    <div class="timeline-step @(displayStatus == "Processing" || displayStatus == "Accepted" ? "active" : (displayStatus == "In Transit" || displayStatus == "Delivered" || displayStatus == "Completed" ? "completed" : ""))">
                                        <div class="timeline-icon bg-info">
                                            <i class="fas fa-check-circle text-white"></i>
                                        </div>
                                        <div class="timeline-label">Accepted</div>
                                    </div>
                                    <div class="timeline-step @(displayStatus == "In Transit" ? "active" : (displayStatus == "Delivered" || displayStatus == "Completed" ? "completed" : ""))">
                                        <div class="timeline-icon bg-primary">
                                            <i class="fas fa-truck text-white"></i>
                                        </div>
                                        <div class="timeline-label">In Transit</div>
                                    </div>
                                    <div class="timeline-step @(displayStatus == "Delivered" || displayStatus == "Completed" ? "completed" : "")">
                                        <div class="timeline-icon bg-success">
                                            <i class="fas fa-flag-checkered text-white"></i>
                                        </div>
                                        <div class="timeline-label">Delivered</div>
                                    </div>
                                </div>
                            </div>


                            @if (displayStatus == "In Transit")
                            {
                                var inTransitPO = order.PurchaseOrders?.FirstOrDefault(po => po.Status == "In Transit");
                                if (inTransitPO != null)
                                {
                                    <div class="alert alert-primary bg-primary bg-opacity-10 border-0 rounded-4 mb-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="pulse-animation">
                                                <i class="fas fa-truck fa-2x text-primary"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <strong class="d-block">Your order is on the way!</strong>
                                                <small>Delivery agent is en route to your location</small>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold">Est. Delivery</div>
                                                <small>@order.ExpectedDeliveryDate?.ToString("MMM dd, yyyy")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (displayStatus == "Delivered" || displayStatus == "Completed")
                            {
                                <div class="alert alert-success rounded-4 mb-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fas fa-check-circle fa-2x"></i>
                                        <div>
                                            <strong class="d-block">Order Delivered Successfully!</strong>
                                            <small>Thank you for shopping with us</small>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- ✅ IMPROVED Shipment Details Section -->
                            @if (order.PurchaseOrders != null && order.PurchaseOrders.Any())
                            {
                                <div class="mt-3">
                                    <h6 class="fw-bold mb-3"><i class="fas fa-boxes me-2 text-primary"></i>Shipment Details</h6>
                                    <div class="row g-3">
                                        @foreach (var po in order.PurchaseOrders)
                                        {
                                            <div class="col-md-6 col-lg-4">
                                                <div class="card border bg-light rounded-3 h-100">
                                                    <div class="card-body p-3">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <span class="fw-bold text-primary">@po.PONumber</span>
                                                            @if (po.Status == "Delivered")
                                                            {
                                                                <span class="badge bg-success rounded-pill">
                                                                    <i class="fas fa-check-circle me-1"></i>Delivered
                                                                </span>
                                                            }
                                                            else if (po.Status == "In Transit")
                                                            {
                                                                <span class="badge bg-primary rounded-pill">
                                                                    <i class="fas fa-truck me-1"></i>In Transit
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary rounded-pill">@po.Status</span>
                                                            }
                                                        </div>
                                                        
                                                        <div class="mb-2">
                                                            <small class="text-muted d-block">
                                                                <i class="fas fa-warehouse me-1"></i> 
                                                                @(!string.IsNullOrEmpty(po.Warehouse?.Name) ? po.Warehouse.Name : "Warehouse")
                                                            </small>
                                                            <small class="text-muted d-block">
                                                                <i class="fas fa-user me-1"></i> 
                                                                @(!string.IsNullOrEmpty(po.DeliveryAgent?.User?.FullName) ? po.DeliveryAgent.User.FullName : "Awaiting assignment")
                                                            </small>
                                                            @if (po.DeliveredAt.HasValue)
                                                            {
                                                                <small class="text-success d-block mt-1">
                                                                    <i class="fas fa-calendar-check me-1"></i> 
                                                                    Delivered: @po.DeliveredAt.Value.ToString("MMM dd, yyyy")
                                                                </small>
                                                            }
                                                        </div>
                                                        
                                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" 
                                                           class="btn btn-primary rounded-pill w-100 mt-2">
                                                            <i class="fas fa-eye me-1"></i> Track Shipment
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light text-center py-3 rounded-4">
                                    <i class="fas fa-box-open fa-2x text-muted mb-2 d-block"></i>
                                    <span class="text-muted">No shipment details available yet</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm text-center py-5">
                    <i class="fas fa-search-location fa-4x text-muted mb-3 opacity-25"></i>
                    <h5 class="text-muted">No orders to track</h5>
                    <p class="text-muted">Start browsing and place your first order</p>
                    <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4">Browse Catalog</a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .timeline-horizontal {
        display: flex;
        justify-content: space-between;
        position: relative;
        flex-wrap: wrap;
    }
    
    .timeline-step {
        text-align: center;
        flex: 1;
        position: relative;
    }
    
    .timeline-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        position: relative;
        z-index: 2;
    }
    
    .timeline-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 20px;
        left: 50%;
        width: 100%;
        height: 2px;
        background: #e9ecef;
        z-index: 1;
    }
    
    .timeline-step.completed:not(:last-child)::after {
        background: #198754;
    }
    
    .timeline-step.active .timeline-icon {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.3);
    }
    
    .timeline-label {
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .pulse-animation {
        animation: pulse 1.5s infinite;
    }
    
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    
    @@media (max-width: 768px) {
        .timeline-label { font-size: 0.6rem; }
        .timeline-icon { width: 30px; height: 30px; font-size: 0.75rem; }
        .timeline-step:not(:last-child)::after { top: 15px; }
    }
</style>
