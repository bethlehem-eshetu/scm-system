@model IEnumerable<SCM_System.Models.Entities.Order>
@{
    ViewData["Title"] = "Order Tracking";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Order <span class="text-primary">Tracking</span></h2>
            <p class="text-muted mb-0">Monitor the real-time status of your fulfillment pipeline</p>
        </div>
        <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>New Order
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Order ID</th>
                        <th>Supplier</th>
                        <th>Date Placed</th>
                        <th>Amount</th>
                        <th>Current Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">#@order.OrderNumber</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-2" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-store small"></i>
                                        </div>
                                        <span class="fw-medium">@order.Supplier?.CompanyName</span>
                                    </div>
                                </td>
                                <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="fw-bold">@order.TotalAmount.ToString("C")</td>
                                <td>
                                    @{
                                        var statusClass = order.OrderStatus switch {
                                            "Pending" => "bg-warning-soft text-warning",
                                            "Accepted" => "bg-info-soft text-info",
                                            "Partially Processing" => "bg-primary-soft text-primary",
                                            "Processing" => "bg-primary-soft text-primary",
                                            "Delivered" => "bg-success-soft text-success",
                                            "Completed" => "bg-success-soft text-success",
                                            "Rejected" => "bg-danger-soft text-danger",
                                            "Cancelled" => "bg-secondary-soft text-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge rounded-pill px-3 py-2 @statusClass">
                                        @order.OrderStatus
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="OrderTrackingDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View Timeline <i class="fas fa-chevron-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="opacity-50 mb-3">
                                    <i class="fas fa-search-location fa-4x"></i>
                                </div>
                                <h5 class="text-muted">No orders found to track</h5>
                                <p class="text-muted small">Start by browsing the catalog and placing an order.</p>
                                <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4 mt-2">Browse Catalog</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    .bg-secondary-soft { background-color: rgba(108, 117, 125, 0.1); }
</style>
