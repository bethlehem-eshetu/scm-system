@model SCM_System.Models.Entities.AddressUpdateRequest
@{
    ViewData["Title"] = "Request Delivery Address Change";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="bg-faint-green p-2 rounded-circle me-3 text-dark-green hover-shadow transition" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-arrow-left small"></i>
                </a>
                <div>
                    <h1 class="h2 fw-bold text-dark-green mb-1">Update Delivery Address</h1>
                    <p class="text-muted small mb-0">Order #@Model.OrderId</p>
                </div>
            </div>

            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="RequestAddressUpdate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />
                        <input type="hidden" asp-for="RetailerId" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase ls-1">Current Address</label>
                            <div class="p-3 bg-faint-green rounded-4 text-muted small border border-light">
                                <i class="fas fa-map-marker-alt me-2"></i> @Model.OldAddress
                                <input type="hidden" asp-for="OldAddress" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase ls-1">New Delivery Address</label>
                            <textarea asp-for="NewAddress" class="form-control border-0 bg-faint-green rounded-4 p-4 shadow-none fw-medium" rows="3" required placeholder="Enter the full new delivery address..."></textarea>
                            <span asp-validation-for="NewAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase ls-1">Reason for Update (Optional)</label>
                            <input asp-for="Reason" class="form-control border-0 bg-faint-green rounded-pill px-4 py-3 shadow-none fw-medium" placeholder="Brief explanation..." />
                        </div>

                        <div class="alert bg-soft-warning text-warning border-0 rounded-4 mb-4 small p-3">
                            <div class="d-flex">
                                <i class="fas fa-info-circle mt-1 me-2"></i>
                                <span>Note: For security reasons, address changes must be reviewed by our logistics team. Your delivery may be slightly delayed.</span>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark-green btn-lg rounded-pill py-3 shadow-premium fw-bold">
                                <i class="fas fa-paper-plane me-2"></i> Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .shadow-premium { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important; }
    .rounded-5 { border-radius: 24px !important; }
    .ls-1 { letter-spacing: 1px; }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.08); }
    .transition { transition: all 0.2s ease; }
    .hover-shadow:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.05) !important; }
</style>
