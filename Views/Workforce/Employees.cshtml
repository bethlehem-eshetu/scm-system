@model IEnumerable<SCM_System.Models.Entities.SupplierEmployee>
@{
    ViewData["Title"] = "Employee Directory";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header & Stats -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="fas fa-users-cog me-2"></i>Employee Directory</h2>
            <p class="text-muted mb-0">Manage your workforce hierarchy and operational assignments</p>
        </div>
        <a asp-action="AddEmployee" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus me-2"></i> Add New Employee
        </a>
    </div>

    <!-- Filters & Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="employeeSearch" class="form-control border-start-0 ps-0" placeholder="Search by name, email or role...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-3" id="roleFilter">
                        <option value="">All Roles</option>
                        <option value="WarehouseManager">Warehouse Managers</option>
                        <option value="DeliveryAgent">Delivery Agents</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex gap-2 justify-content-md-end">
                    <div class="stats-badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-industry me-1"></i> @Model.Count(e => e.EmployeeRole == "WarehouseManager") Managers
                    </div>
                    <div class="stats-badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-truck me-1"></i> @Model.Count(e => e.EmployeeRole == "DeliveryAgent") Agents
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Grid -->
    <div class="row g-4" id="employeeGrid">
        @foreach (var emp in Model)
        {
            var isManager = emp.EmployeeRole == "WarehouseManager";
            <div class="col-xl-3 col-lg-4 col-md-6 employee-card" data-role="@emp.EmployeeRole" data-name="@emp.User.FullName.ToLower()">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift card-employee @(emp.IsActive ? "" : "opacity-75")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="avatar-md @(isManager ? "bg-primary" : "bg-success") bg-opacity-10 @(isManager ? "text-primary" : "text-success") rounded-circle d-flex align-items-center justify-content-center overflow-hidden" style="width: 56px; height: 56px;">
                                @if (!string.IsNullOrEmpty(emp.ProfilePhotoPath))
                                {
                                    <img src="@emp.ProfilePhotoPath" class="w-100 h-100" style="object-fit: cover;" alt="Profile" />
                                }
                                else
                                {
                                    <i class="fas @(isManager ? "fa-user-tie" : "fa-shuttle-van") fs-4"></i>
                                }
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-h fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" asp-action="EditEmployee" asp-route-id="@emp.Id"><i class="fas fa-edit me-2 text-primary"></i> Edit Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="DeleteEmployee" asp-route-id="@emp.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger" onclick="return confirm('Archive this employee?')">
                                                <i class="fas fa-user-slash me-2"></i> Deactivate
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="fw-bold mb-0 text-truncate">@emp.User.FullName</h5>
                            <span class="text-xs text-muted fw-bold">@emp.EmployeeDisplayId</span>
                        </div>
                        
                        <div class="d-flex align-items-center mb-3">
                            @{
                                var statusClass = emp.Status switch {
                                    SCM_System.Models.Enums.EmployeeStatus.Active => "bg-success",
                                    SCM_System.Models.Enums.EmployeeStatus.OnLeave => "bg-warning",
                                    SCM_System.Models.Enums.EmployeeStatus.Suspended => "bg-danger",
                                    SCM_System.Models.Enums.EmployeeStatus.Inactive => "bg-secondary",
                                    _ => "bg-dark"
                                };
                            }
                            <span class="badge @(isManager ? "bg-primary-soft text-primary" : "bg-success-soft text-success") rounded-pill px-2 py-1 extra-small">
                                @(isManager ? "👷 Manager" : "🚚 Driver")
                            </span>
                            <span class="badge @statusClass bg-opacity-10 text-@statusClass.Replace("bg-", "") rounded-pill ms-2 extra-small">
                                @emp.Status
                            </span>
                        </div>

                        <div class="employee-meta small text-muted mb-4">
                            <div class="mb-2"><i class="fas fa-building me-2 opacity-50"></i>@emp.Department</div>
                            <div class="mb-2"><i class="fas fa-envelope me-2 opacity-50"></i>@emp.User.Email</div>
                            <div class="mb-3 text-dark fw-bold"><i class="fas fa-phone me-2 text-primary opacity-75"></i>@emp.User.PhoneNumber</div>
                            
                            @if (isManager)
                            {
                                <div class="mt-3 p-3 bg-light rounded-4 border-start border-primary border-4">
                                    <div class="fw-bold text-dark small mb-1"><i class="fas fa-warehouse me-2 text-primary"></i> Hub Assignment</div>
                                    <div class="ps-4 text-primary fw-bold">@(emp.WarehouseAssignments?.FirstOrDefault(w => w.IsActive)?.Warehouse?.Name ?? "Unassigned")</div>
                                    <div class="ps-4 extra-small text-muted">Full Control & Oversight</div>
                                </div>
                            }
                            else
                            {
                                <div class="mt-3 p-3 bg-light rounded-4 border-start border-success border-4 mb-2">
                                    <div class="fw-bold text-dark small mb-1"><i class="fas fa-truck me-2 text-success"></i> Fleet Assignment</div>
                                    <div class="ps-4 text-success fw-bold">@(emp.VehicleAssignments?.FirstOrDefault(v => v.IsActive)?.Vehicle?.LicensePlate ?? "No Vehicle")</div>
                                    <div class="ps-4 extra-small text-muted">@(emp.WarehouseAssignments?.FirstOrDefault(w => w.IsActive)?.Warehouse?.Name ?? "Awaiting Station")</div>
                                </div>
                                
                                <div class="p-2 border rounded-3 mb-2">
                                    @{
                                        var medicalUrgent = emp.DriverProfile?.MedicalFitnessExpiry.HasValue == true && (emp.DriverProfile.MedicalFitnessExpiry.Value - DateTime.Now).TotalDays < 30;
                                        var medicalExpired = emp.DriverProfile?.MedicalFitnessExpiry.HasValue == true && emp.DriverProfile.MedicalFitnessExpiry.Value < DateTime.Now;
                                    }
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small fw-bold text-muted text-uppercase">Medical Certificate</span>
                                        <span class="badge @(medicalExpired ? "bg-danger" : medicalUrgent ? "bg-warning" : "bg-success") bg-opacity-10 text-@(medicalExpired ? "danger" : medicalUrgent ? "warning" : "success") extra-small">
                                            @(medicalExpired ? "Expired" : medicalUrgent ? "Expiring" : "Valid")
                                        </span>
                                    </div>
                                    <div class="extra-small fw-bold @(medicalExpired ? "text-danger" : "text-dark")">
                                        <i class="fas fa-heartbeat me-1"></i> @(emp.DriverProfile?.MedicalFitnessExpiry?.ToString("MMM dd, yyyy") ?? "Not Recorded")
                                    </div>
                                </div>

                                <div class="p-2 bg-success bg-opacity-5 border border-success border-opacity-10 rounded-3">
                                    <span class="extra-small fw-bold text-muted text-uppercase d-block mb-1">Operational Coverage</span>
                                    <div class="extra-small fw-bold text-dark">
                                        <i class="fas fa-map-marked-alt me-1 text-success"></i> @(string.IsNullOrEmpty(emp.DriverProfile?.CoverageArea) ? (emp.DriverProfile?.CityCoverage ?? "Not Defined") : emp.DriverProfile.CoverageArea)
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-grid mt-auto">
                            <a asp-action="EditEmployee" asp-route-id="@emp.Id" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">Manage Profile</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 bg-white shadow-sm rounded-4 d-inline-block">
                <i class="fas fa-users-slash fa-4x text-muted opacity-25 mb-4"></i>
                <h4 class="fw-bold">No Employees Found</h4>
                <p class="text-muted mb-4">Start building your team by adding your first employee.</p>
                <a asp-action="AddEmployee" class="btn btn-primary rounded-pill px-5 fw-bold">Add New Employee</a>
            </div>
        </div>
    }
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .extra-small { font-size: 0.75rem; }
    .fs-xs { font-size: 0.5rem; }
    
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }

    #employeeGrid .employee-card {
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            function filterEmployees() {
                var searchText = $('#employeeSearch').val().toLowerCase();
                var roleFilter = $('#roleFilter').val();

                $('.employee-card').each(function() {
                    var name = $(this).data('name');
                    var role = $(this).data('role');
                    
                    var matchesSearch = name.includes(searchText);
                    var matchesRole = roleFilter === "" || role === roleFilter;

                    if (matchesSearch && matchesRole) {
                        $(this).fadeIn(200);
                    } else {
                        $(this).fadeOut(200);
                    }
                });
            }

            $('#employeeSearch').on('keyup', filterEmployees);
            $('#roleFilter').on('change', filterEmployees);
        });
    </script>
}
