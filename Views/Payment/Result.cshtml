@{
    ViewData["Title"] = "Payment Result";
    Layout = "_DashboardLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="card border-success shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
                        <h3 class="text-success">Payment Successful!</h3>
                        <p class="text-muted">@TempData["SuccessMessage"]</p>
                        <a href="@Url.Action("MyCommissions", "Commission")" class="btn btn-primary mt-3">
                            View My Commissions
                        </a>
                    </div>
                </div>
            }
            else if (TempData["ErrorMessage"] != null)
            {
                <div class="card border-danger shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-times-circle text-danger fa-5x mb-3"></i>
                        <h3 class="text-danger">Payment Failed</h3>
                        <p class="text-muted">@TempData["ErrorMessage"]</p>
                        <a href="@Url.Action("MyCommissions", "Commission")" class="btn btn-primary mt-3">
                            Try Again
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-spinner fa-spin text-primary fa-5x mb-3"></i>
                        <h3>Processing Payment...</h3>
                        <p class="text-muted">Please wait while we verify your payment.</p>
                        <a href="@Url.Action("MyCommissions", "Commission")" class="btn btn-outline-primary mt-3">
                            Back to Commissions
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>