@model SCM_System.Models.Entities.Commission
@{
    ViewData["Title"] = "Payment Receipt";
    Layout = "_DashboardLayout";
    
    var masterPayment = ViewBag.MasterPayment as SCM_System.Models.Entities.Payment;
    
    // Unified Financial Values (Single Source of Truth with Fallback)
    var subtotal = Model.Order.Subtotal > 0 ? Math.Round(Model.Order.Subtotal, 2) : Math.Round(Model.Order.OrderItems.Sum(item => item.Quantity * item.UnitPrice), 2);
    var vat = Model.Order.VAT > 0 ? Math.Round(Model.Order.VAT, 2) : Math.Round(subtotal * 0.15m, 2);
    var totalPaid = Model.Order.TotalAmount > (subtotal + vat - 1) ? Math.Round(Model.Order.TotalAmount, 2) : (subtotal + vat);

    // Commission Logic (Snapshot from Transaction if available)
    var rate = Model.CommissionRateAtTransaction > 0 ? Model.CommissionRateAtTransaction : (Model.CommissionRate * 100);
    var platformCommission = Math.Round(totalPaid * (rate / 100), 2);
    var supplierPayout = Math.Round(totalPaid - platformCommission, 2);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow rounded-4 border-0">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top-4">
                    <h3 class="mb-0 fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i>EthioChain SCM - Payment Receipt</h3>
                </div>
                <div class="card-body p-5">
                    <!-- HEADER -->
                    <div class="row mb-4 border-bottom pb-4">
                        <div class="col-md-6">
                            <h5 class="fw-bold mb-3">Transaction Summary</h5>
                            <p class="mb-1"><strong>Transaction ID:</strong> @(masterPayment?.Id ?? Model.Id)</p>
                            @if(Model.Order != null) {
                                <p class="mb-1"><strong>Order:</strong> @Model.Order.OrderNumber</p>
                            }
                            <p class="mb-1"><strong>Date:</strong> @(masterPayment?.PaidAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? Model.PaidAt?.ToString("MMM dd, yyyy HH:mm") ?? Model.CreatedAt.ToString("MMM dd, yyyy HH:mm"))</p>
                            <p class="mb-1"><strong>Status:</strong> <span class="badge bg-success">PAID</span> <i class="fas fa-check-circle text-primary ms-2" title="Verified Payment"></i> Official Receipt</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <h6 class="text-muted mb-2 text-uppercase fw-bold">Platform Info</h6>
                            <h5 class="fw-bold mb-1">EthioChain SCM</h5>
                            <p class="text-muted mb-0 small">Addis Ababa, Ethiopia</p>
                            <p class="text-muted mb-0 small">TIN: 0001234567</p>
                        </div>
                    </div>

                    <!-- PARTIES -->
                    <div class="row mb-5 border-bottom pb-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted mb-2 text-uppercase fw-bold">From (Retailer)</h6>
                            @if (Model.Retailer != null)
                            {
                                <h5 class="fw-bold mb-1">@Model.Retailer.BusinessName</h5>
                                <p class="text-muted mb-0 small"><strong>Email:</strong> @(Model.Retailer.User?.Email ?? "N/A")</p>
                                <p class="mb-1 small"><strong>TIN:</strong> @(Model.Retailer.TaxIdentificationNumber ?? "Not Provided")</p>
                            }
                            else
                            {
                                <h5 class="fw-bold mb-1">Retailer Not Linked</h5>
                            }
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <h6 class="text-muted mb-2 text-uppercase fw-bold">Settled To (Supplier)</h6>
                            @if (Model.Supplier != null)
                            {
                                <h5 class="fw-bold mb-1">@Model.Supplier.CompanyName</h5>
                                <p class="text-muted mb-0 small"><strong>Email:</strong> @(Model.Supplier.User?.Email ?? "N/A")</p>
                                <p class="mb-1 small"><strong>TIN:</strong> @(Model.Supplier.TaxIdentificationNumber ?? "Not Provided")</p>
                            }
                            else
                            {
                                <h5 class="fw-bold mb-1">System Entity</h5>
                            }
                        </div>
                    </div>

                    <!-- PAYMENT DETAILS -->
                    <div class="row mb-5">
                        <div class="col-12">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-receipt me-2"></i>Financial Breakdown</h5>
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0">
                                    <tbody>
                                        <tr class="border-bottom border-light">
                                            <td class="py-3 text-muted">Net Product Value (Subtotal)</td>
                                            <td class="text-end py-3 fw-bold">@subtotal.ToString("N2") ETB</td>
                                        </tr>
                                        <tr class="border-bottom border-light">
                                            <td class="py-3 text-muted">Value Added Tax (VAT 15%)</td>
                                            <td class="text-end py-3 text-info fw-bold">@vat.ToString("N2") ETB</td>
                                        </tr>
                                        <tr class="bg-success bg-opacity-10 border-top border-success border-opacity-25">
                                            <td class="py-4 fw-bold fs-5">TOTAL AMOUNT PAID</td>
                                            <td class="text-end py-4 fw-bold fs-4 text-success">@totalPaid.ToString("N2") ETB</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- PAYMENT FLOW VISUALIZATION (Enterprise Look) -->
                    <div class="bg-light rounded-4 p-4 mb-5 border border-primary border-opacity-10 shadow-sm">
                        <h6 class="text-uppercase fw-bold text-muted smaller mb-4">
                            <i class="fas fa-project-diagram me-2 text-primary"></i>Payment Settlement Flow
                        </h6>
                        <div class="d-flex justify-content-between align-items-center position-relative px-3">
                            <!-- Flow Line -->
                            <div class="position-absolute w-100 border-top border-primary border-opacity-10" style="top: 25px; left: 0; z-index: 0;"></div>
                            
                            <!-- Node 1: Gross -->
                            <div class="text-center position-relative bg-light px-2" style="z-index: 1;">
                                <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                    <i class="fas fa-shopping-cart text-white"></i>
                                </div>
                                <div class="mt-2 fw-bold" style="font-size: 0.75rem;">Retailer Paid</div>
                                <div class="text-primary small fw-bold">@totalPaid.ToString("N2")</div>
                            </div>

                            <i class="fas fa-chevron-right text-muted opacity-25" style="z-index: 1;"></i>

                            <!-- Node 2: Commission -->
                            <div class="text-center position-relative bg-light px-2" style="z-index: 1;">
                                <div class="bg-danger rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                    <i class="fas fa-percentage text-white"></i>
                                </div>
                                <div class="mt-2 fw-bold" style="font-size: 0.75rem;">Platform Fee (@rate.ToString("0")%)</div>
                                <div class="text-danger small fw-bold">-@platformCommission.ToString("N2")</div>
                            </div>

                            <i class="fas fa-chevron-right text-muted opacity-25" style="z-index: 1;"></i>

                            <!-- Node 3: Net Payout -->
                            <div class="text-center position-relative bg-light px-2" style="z-index: 1;">
                                <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                    <i class="fas fa-hand-holding-usd text-white"></i>
                                </div>
                                <div class="mt-2 fw-bold" style="font-size: 0.75rem;">Supplier Earns</div>
                                <div class="text-success small fw-bold">@supplierPayout.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <!-- TRANSACTION SECURE DATA -->
                    <div class="bg-white border rounded-4 p-4 mb-4 border-light shadow-sm">
                        <div class="row text-center text-sm-start">
                            <div class="col-sm-6 mb-3 mb-sm-0">
                                <p class="text-muted smaller text-uppercase fw-bold mb-1">External Payment Reference</p>
                                <p class="family-monospace small fw-bold text-dark mb-0">@(masterPayment?.TxRef ?? Model.ChapaTransactionId ?? "PAY-N/A")</p>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <p class="text-muted smaller text-uppercase fw-bold mb-1">Gateway Authorization</p>
                                <p class="small fw-bold text-dark mb-0">
                                    <span class="text-success"><i class="fas fa-shield-alt me-1"></i> Verified by Chapa</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-5 mb-2 d-print-none">
                        <button onclick="window.print()" class="btn btn-dark rounded-pill px-5 py-2 shadow-sm fw-bold">
                            <i class="fas fa-print me-2"></i>Print Official Receipt
                        </button>
                        <div class="mt-3">
                            <a href="/Payment/MyPayments" class="text-decoration-none text-muted small hover-primary">
                                <i class="fas fa-arrow-left me-1"></i> Back to Transaction List
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-4 border-0 rounded-bottom-4">
                    <p class="text-muted small mb-1">ETHIO-CHAIN SCM PLATFORM | SECURE DIGITAL SETTLEMENT</p>
                    <p class="text-muted extra-small mb-0 opacity-75">This document serves as proof of payment and fund allocation for the specified order.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.70rem; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .family-monospace { font-family: 'Courier New', Courier, monospace; }
    .hover-primary:hover { color: #3b82f6 !important; }
    
    @@media print {
        .d-print-none { display: none !important; }
        .card { border: 1px solid #eee !important; box-shadow: none !important; margin: 0 !important; }
        body { background: white !important; padding: 0 !important; }
        .container { max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }
    }
</style>
