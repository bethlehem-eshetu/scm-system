        }

        body.dark-mode .dark-mode-row td {
            color: #e2e8f0 !important;
            background-color: transparent !important;
            border-bottom-color: #334155 !important;
        }

        /* Reference badge dark mode */
        body.dark-mode .dark-mode-ref-badge {
            background-color: #334155 !important;
            color: #a5f3c3 !important;
            border-color: #475569 !important;
        }

        /* Status badge dark mode overrides */
        body.dark-mode .dark-mode-status {
            background-color: rgba(100, 116, 139, 0.3) !important;
            color: #cbd5e1 !important;
        }

        body.dark-mode .dark-mode-status.bg-soft-primary {
            background-color: rgba(37, 99, 235, 0.2) !important;
            color: #93c5fd !important;
        }

        body.dark-mode .dark-mode-status.bg-soft-success {
            background-color: rgba(74, 222, 128, 0.2) !important;
            color: #4ade80 !important;
        }

        body.dark-mode .dark-mode-status.bg-soft-danger {
            background-color: rgba(248, 113, 113, 0.2) !important;
            color: #f87171 !important;
        }

        /* Status badge for table */
        body.dark-mode .dark-mode-status-badge {
            background-color: rgba(100, 116, 139, 0.3) !important;
            color: #cbd5e1 !important;
        }

        body.dark-mode .dark-mode-status-badge.bg-soft-success {
            background-color: rgba(74, 222, 128, 0.15) !important;
            color: #4ade80 !important;
        }

        body.dark-mode .dark-mode-status-badge.bg-soft-info {
            background-color: rgba(13, 202, 240, 0.15) !important;
            color: #67e8f9 !important;
        }

        body.dark-mode .dark-mode-status-badge.bg-soft-danger {
            background-color: rgba(248, 113, 113, 0.15) !important;
            color: #f87171 !important;
        }

        body.dark-mode .dark-mode-status-badge.bg-soft-warning {
            background-color: rgba(251, 191, 36, 0.15) !important;
            color: #fbbf24 !important;
        }

        /* Amount colors */
        body.dark-mode .dark-mode-fee {
            color: #f87171 !important;
        }

        body.dark-mode .dark-mode-earning {
            color: #4ade80 !important;
        }

        /* Action buttons */
        body.dark-mode .dark-mode-action-btn {
            background-color: #0f172a !important;
            color: #a5f3c3 !important;
        }

        body.dark-mode .dark-mode-view-btn {
            background-color: #334155 !important;
            color: #a5f3c3 !important;
        }

        body.dark-mode .dark-mode-view-btn:hover {
            background-color: #475569 !important;
        }

        /* Empty state */
        body.dark-mode .dark-mode-empty-state {
            background-color: #334155 !important;
            border-color: #475569 !important;
        }

        /* Border colors */
        body.dark-mode .custom-nexus-table tbody td {
            border-bottom-color: #334155 !important;
        }

        body.dark-mode .text-muted {
            color: #9ca3af !important;
        }

        body.dark-mode .text-success {
            color: #4ade80 !important;
        }

        body.dark-mode .text-danger {
            color: #f87171 !important;
        }

        body.dark-mode .text-warning {
            color: #fbbf24 !important;
        }
    </style>
}