@model IEnumerable<SCM_System.Models.Entities.SupportTicket>
@{
    ViewData["Title"] = "Support Tickets";
    Layout = "_DashboardLayout";
    var userRole = Context.Session.GetString("UserRole");
}

<style>
    :root {
        --bg-page: #F1F5F9;
        --bg-card: #FFFFFF;
        --bg-sidebar: #0B3B2F;
        --bg-input: #FFFFFF;
        --bg-table-header: #F8FAFC;
        --bg-hover: #F0F4F2;
        --text-primary: #1A2C26;
        --text-secondary: #4A5C55;
        --text-muted: #6F7E78;
        --text-white: #FFFFFF;
        --border-light: #E2E8E4;
        --border-medium: #CDD6D1;
        --success: #2E9C7A;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    body.dark-mode {
        --bg-page: #0A0F0D;
        --bg-card: #1A1F1D;
        --bg-sidebar: #06261E;
        --bg-input: #252B28;
        --bg-table-header: #252B28;
        --bg-hover: #252B28;
        --text-primary: #EDEDED;
        --text-secondary: #B8C5BE;
        --text-muted: #8A9B92;
        --border-light: #2A3530;
        --border-medium: #3A4840;
        --shadow-sm: none;
    }

    .support-page-wrapper {
        background-color: var(--bg-page);
        min-height: 100vh;
        padding: 24px;
        color: var(--text-primary);
        transition: background-color 0.3s ease;
    }

    .page-title {
        color: var(--text-primary);
        font-weight: 700;
    }

    .ticket-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-light) !important;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
        color: var(--text-secondary) !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .custom-table thead th {
        background-color: var(--bg-table-header) !important;
        color: var(--text-primary) !important;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
        padding: 16px;
        border-bottom: 1px solid var(--border-light) !important;
    }

    .custom-table tbody td {
        padding: 16px;
        background-color: var(--bg-card) !important;
        color: var(--text-secondary) !important;
        border-bottom: 1px solid var(--border-light) !important;
        vertical-align: middle;
    }

    .custom-table tbody tr:last-child td {
        border-bottom: none !important;
    }

    /* Hover effect override */
    .custom-table tbody tr:hover td {
        background-color: var(--bg-hover) !important;
        color: var(--text-primary) !important;
    }

    .btn-new-ticket {
        background-color: var(--success) !important;
        border: none !important;
        color: white !important;
        padding: 10px 24px;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.2s;
    }

    .btn-new-ticket:hover {
        background-color: #247A5E !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(46, 156, 122, 0.2);
    }

    .ticket-id {
        color: var(--text-muted);
        font-family: 'Monaco', 'Consolas', monospace;
        font-size: 13px;
    }

    .status-badge {
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    /* Override any bootstrap text-muted in dark mode */
    body.dark-mode .text-muted {
        color: var(--text-muted) !important;
    }
</style>

<div class="support-page-wrapper">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-0">Support Tickets</h2>
            <p class="text-muted">@(userRole == "Admin" ? "Manage all user support tickets and feedback." : "View the status of your feedback and support requests.")</p>
        </div>
        @if (userRole != "Admin")
        {
            <button class="btn btn-new-ticket" onclick="$('#chatbot-toggle').click()">
                <i class="fas fa-plus me-2"></i>New Ticket
            </button>
        }
    </div>

    <div class="ticket-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 custom-table">
                <thead>
                    <tr>
                        <th class="ps-4">Ticket ID</th>
                        @if (userRole == "Admin")
                        {
                            <th>User</th>
                        }
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Date Submitted</th>
                        @if (userRole == "Admin")
                        {
                            <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ticket in Model)
                        {
                            var statusBadge = ticket.Status switch
                            {
                                "Open" => "bg-warning text-dark",
                                "InProgress" => "bg-info text-dark",
                                "Resolved" => "bg-success text-white",
                                "Closed" => "bg-secondary text-white",
                                _ => "bg-primary text-white"
                            };

                            <tr style="cursor: pointer;" onclick="showTicketDetails('@ticket.Id', '@(ticket.User?.FullName ?? "Unknown")', '@ticket.Subject', '@Html.Raw(ticket.Message.Replace("'", "\\'").Replace("\n", "<br/>"))', '@ticket.Status', '@ticket.CreatedAt.ToString("MMM dd, yyyy HH:mm")')">
                                <td class="ps-4 ticket-id">#TKT-@ticket.Id.ToString("D4")</td>
                                @if (userRole == "Admin")
                                {
                                    <td>
                                        <div class="fw-bold">@ticket.User?.FullName</div>
                                        <div class="small text-muted">@ticket.User?.Role</div>
                                    </td>
                                }
                                <td class="fw-bold">@ticket.Subject</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 300px;">
                                        @ticket.Message
                                    </div>
                                </td>
                                <td>
                                    <span class="badge status-badge @statusBadge">@ticket.Status</span>
                                </td>
                                <td class="text-end pe-4 text-muted small">
                                    @ticket.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                @if (userRole == "Admin")
                                {
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-success" onclick="event.stopPropagation(); updateStatus('@ticket.Id', 'Resolved')" title="Mark Resolved">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(userRole == "Admin" ? "7" : "5")" class="text-center py-5">
                                <i class="fas fa-ticket-alt fa-3x text-muted opacity-25 mb-3"></i>
                                <h5 class="fw-bold text-muted">No Support Tickets</h5>
                                <p class="text-muted mb-0">@(userRole == "Admin" ? "There are no open support tickets at this time." : "You haven't submitted any support tickets yet.")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Ticket Detail Modal -->
<div class="modal fade" id="ticketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="modalTicketId">Ticket Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold mb-1">Subject</label>
                    <div id="modalSubject" class="fw-bold fs-5 text-dark"></div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold mb-1">From</label>
                    <div id="modalUser" class="text-dark"></div>
                </div>
                <div class="mb-4">
                    <label class="small text-muted text-uppercase fw-bold mb-1">Message</label>
                    <div id="modalMessage" class="p-3 bg-light rounded-3 text-dark border" style="white-space: pre-wrap; min-height: 100px;"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span id="modalStatus" class="badge rounded-pill px-3"></span>
                        <span id="modalDate" class="small text-muted ms-2"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                @if (userRole == "Admin")
                {
                    <button type="button" id="modalResolveBtn" class="btn btn-success rounded-pill px-4">Resolve Ticket</button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTicketDetails(id, user, subject, message, status, date) {
            $('#modalTicketId').text('Ticket #TKT-' + id.padStart(4, '0'));
            $('#modalSubject').text(subject);
            $('#modalUser').text(user);
            $('#modalMessage').html(message);
            $('#modalDate').text('Submitted on ' + date);
            
            // Set status badge
            let badgeClass = 'bg-primary';
            switch(status) {
                case 'Open': badgeClass = 'bg-warning text-dark'; break;
                case 'InProgress': badgeClass = 'bg-info text-dark'; break;
                case 'Resolved': badgeClass = 'bg-success'; break;
                case 'Closed': badgeClass = 'bg-secondary'; break;
            }
            $('#modalStatus').text(status).removeClass().addClass('badge rounded-pill px-3 ' + badgeClass);
            
            // Resolve button logic
            if ($('#modalResolveBtn').length) {
                if (status === 'Resolved' || status === 'Closed') {
                    $('#modalResolveBtn').hide();
                } else {
                    $('#modalResolveBtn').show().off('click').on('click', function() {
                        updateStatus(id, 'Resolved');
                    });
                }
            }
            
            new bootstrap.Modal(document.getElementById('ticketModal')).show();
        }

        function updateStatus(id, status) {
            if (confirm('Are you sure you want to mark this ticket as ' + status + '?')) {
                // In a real app, this would be an AJAX call. 
                // For now, we'll just show a success message and reload.
                alert('Ticket status updated to ' + status);
                location.reload();
            }
        }
    </script>
}
