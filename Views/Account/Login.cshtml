@model SCM_System.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login - EthioChain SCM";
    Layout = "_Layout";
}

<div class="login-page-wrapper">
    <!-- Left Section: Illustration & Organic Blobs -->
    <div class="left-section">
        <div class="blobs">
            <div class="blob blob-lg"></div>
            <div class="blob blob-md"></div>
            <div class="blob blob-sm"></div>
            <div class="blob blob-xs"></div>
        </div>

        <img src="/images/login-illustration.png" alt="Illustration" class="illustration bounce-effect" />

        <div class="wave-divider">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M100,0 C80,10 60,30 60,50 C60,70 80,90 100,100 Z" fill="#0b2e24"></path>
            </svg>
        </div>
    </div>

    <!-- Right Section: Dark Form -->
    <div class="right-section">
        <div class="login-card">
            <h1>LOGIN</h1>


            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                
                <div class="form-group">
                    <label asp-for="Email">Username</label>
                    <div class="input-pill">
                        <div class="icon-box">
                            <i class="fas fa-user"></i>
                        </div>
                        <input asp-for="Email" placeholder="Username" required />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <div class="input-pill">
                        <div class="icon-box">
                            <i class="fas fa-lock"></i>
                        </div>
                        <input asp-for="Password" type="password" placeholder="Password" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between px-3 mt-2" style="font-size: 0.8rem;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                        <label class="form-check-label text-white-50" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#" class="text-white-50 text-decoration-none" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">Forgot?</a>
                </div>

                <div class="btn-submit-container">
                    <button type="submit" class="btn-login">LOGIN</button>
                </div>

                <div class="extra-links">
                    Don't have an account? <a asp-action="Register">Create Account</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Forgot Password Modal -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-5 shadow-lg" style="background: #0b2e24;">
            <div class="modal-body p-5">
                <h3 class="text-white fw-bold mb-4">Reset Password</h3>
                <div id="forgotPasswordMessage" class="alert d-none mb-4"></div>
                <form id="forgotPasswordForm">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-4">
                        <label class="text-white-50 ms-3">Email Address</label>
                        <div class="input-pill">
                            <div class="icon-box"><i class="fas fa-envelope"></i></div>
                            <input type="email" name="Email" placeholder="Enter email" required />
                        </div>
                    </div>
                    <button type="submit" id="forgotPasswordSubmit" class="btn-login w-100">SEND LINK</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        :root {
            --deep-dark-green: #0b2e24;
            --mid-green: #1a3d31;
            --accent-teal: #4da699;
            --blob-light: #e0f2ef;
            --blob-mid: #a3d8d1;
            --text-white: #ffffff;
            --font-main: 'Plus Jakarta Sans', sans-serif;
        }

        /* Adjust Layout conflicts */
        main { padding: 0 !important; }
        .footer { margin-top: 0 !important; }

        .login-page-wrapper {
            display: flex;
            min-height: 85vh;
            width: 100%;
            position: relative;
            background: white;
            overflow: hidden;
            margin-top: 70px; /* Offset for layout navbar */
        }

        /* Left Section */
        .left-section {
            flex: 1.2;
            background-color: #ffffff;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 40px;
        }

        .blob { position: absolute; border-radius: 50%; z-index: 1; opacity: 0.6; }
        .blob-lg { width: 450px; height: 450px; background: var(--blob-mid); top: 5%; left: -10%; border-radius: 40% 60% 60% 40% / 40% 40% 60% 60%; }
        .blob-md { width: 280px; height: 280px; background: var(--blob-light); bottom: -5%; left: 15%; border-radius: 50% 50% 30% 70% / 50% 50% 70% 30%; }
        .blob-sm { width: 120px; height: 120px; background: var(--blob-mid); top: 40%; left: 60%; }
        .blob-xs { width: 60px; height: 60px; background: var(--blob-light); top: 15%; left: 45%; }

        .illustration {
            position: relative;
            z-index: 5;
            max-width: 75%;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));
        }

        /* Bounce Animation */
        .bounce-effect {
            animation: floatBounce 4s ease-in-out infinite;
        }

        @@keyframes floatBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .wave-divider {
            position: absolute;
            top: 0;
            right: -1px;
            height: 100%;
            width: 200px;
            z-index: 8;
            pointer-events: none;
        }
        .wave-divider svg { height: 100%; width: 100%; }

        /* Right Section */
        .right-section {
            flex: 1;
            background-color: var(--deep-dark-green);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px;
            z-index: 9;
        }

        .login-card { width: 100%; max-width: 320px; }
        .login-card h1 {
            color: white;
            font-size: 2.5rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 40px;
            letter-spacing: 4px;
        }

        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block;
            color: rgba(255,255,255,0.7);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 8px;
            margin-left: 15px;
        }

        .input-pill {
            background: rgba(255,255,255,0.08);
            border-radius: 50px;
            display: flex;
            align-items: center;
            padding: 5px;
            transition: all 0.3s;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .input-pill:focus-within {
            background: rgba(255,255,255,0.12);
            border-color: var(--accent-teal);
        }

        .icon-box {
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.5);
            margin-right: 10px;
        }

        .input-pill input {
            background: none;
            border: none;
            color: white;
            padding: 8px 5px;
            width: 100%;
            outline: none;
            font-size: 0.95rem;
        }
        .input-pill input::placeholder { color: rgba(255,255,255,0.2); }

        .btn-submit-container { text-align: center; margin-top: 30px; }
        .btn-login {
            background-color: var(--mid-green);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 50px;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }
        .btn-login:hover {
            background-color: var(--accent-teal);
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        }

        .extra-links {
            margin-top: 30px;
            text-align: center;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.4);
        }
        .extra-links a { color: white; text-decoration: none; font-weight: 700; margin-left: 5px; }

        @@media (max-width: 992px) {
            .wave-divider { display: none; }
            .left-section { display: none; }
            .right-section { flex: 1; width: 100%; padding: 60px 20px; }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const forgotForm = document.getElementById('forgotPasswordForm');
            const forgotMessage = document.getElementById('forgotPasswordMessage');
            const forgotSubmit = document.getElementById('forgotPasswordSubmit');

            forgotForm?.addEventListener('submit', async function(e) {
                e.preventDefault();
                forgotMessage.classList.add('d-none');
                forgotSubmit.disabled = true;
                const formData = new FormData(this);
                try {
                    const response = await fetch('/Account/ForgotPassword', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();
                    forgotMessage.innerText = result.message;
                    forgotMessage.classList.remove('d-none');
                    forgotMessage.className = `alert mb-4 ${result.success ? 'alert-success' : 'alert-danger'}`;
                    if (result.success) this.reset();
                } catch (error) {
                    forgotMessage.innerText = 'Error occurred. Try again.';
                    forgotMessage.classList.remove('d-none');
                    forgotMessage.className = 'alert alert-danger mb-4';
                } finally {
                    forgotSubmit.disabled = false;
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}