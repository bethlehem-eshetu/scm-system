@model SCM_System.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Secure Login";
    Layout = "_Layout"; // Use standard layout for auth pages
}

<div class="container-fluid p-0 overflow-hidden">
    <div class="row g-0 min-vh-100">
        <!-- Left Column: Branding & Illustration -->
        <div class="col-lg-6 d-none d-lg-flex bg-light align-items-center justify-content-center p-5 position-relative">
            <div class="z-index-1 text-center" style="max-width: 500px;">
                <div class="mb-5" data-aos="fade-down">
                    <img src="~/images/hero-illustration.png" alt="EthioChain SCM" class="img-fluid rounded-4 shadow-premium mb-4" />
                    <h2 class="fw-bold text-dark">EthioChain Command Center</h2>
                    <p class="text-muted">Access your professional SCM dashboard and manage your supply chain with precision.</p>
                </div>
                
                <div class="row g-3 text-start">
                    <div class="col-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light">
                            <i class="fas fa-truck-fast text-primary mb-2"></i>
                            <h6 class="fw-bold small mb-1">Live Tracking</h6>
                            <p class="extra-small text-muted mb-0">High-fidelity shipment updates.</p>
                        </div>
                    </div>
                    <div class="col-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light">
                            <i class="fas fa-warehouse text-success mb-2"></i>
                            <h6 class="fw-bold small mb-1">Stock Control</h6>
                            <p class="extra-small text-muted mb-0">Real-time inventory sync.</p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Decorative blobs -->
            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background: radial-gradient(circle at 10% 10%, #0d6efd 0%, transparent 50%);"></div>
        </div>

        <!-- Right Column: Login Form -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center p-5 bg-white">
            <div class="w-100" style="max-width: 400px;" data-aos="fade-left">
                <div class="text-center mb-5">
                    <div class="avatar-lg bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="fas fa-user-shield fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Welcome Back</h3>
                    <p class="text-muted">Securely sign in to your corporate account</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 rounded-4 mb-4 small shadow-sm">
                        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Login" method="post" class="needs-validation">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control border-0 bg-light rounded-4 px-4 shadow-none" placeholder="name@example.com" required />
                        <label asp-for="Email" class="ps-4">Email address</label>
                        <span asp-validation-for="Email" class="text-danger extra-small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control border-0 bg-light rounded-4 px-4 shadow-none" placeholder="Password" required />
                        <label asp-for="Password" class="ps-4">Password</label>
                        <span asp-validation-for="Password" class="text-danger extra-small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input rounded-2 shadow-none" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                        </div>
                        <a href="#" class="small text-primary fw-bold text-decoration-none">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-4">
                        <i class="fas fa-sign-in-alt me-2"></i> Sign In to Dashboard
                    </button>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Don't have an enterprise account? 
                            <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">Create Account</a>
                        </p>
                    </div>
                </form>

                <div class="mt-5 text-center">
                    <p class="extra-small text-muted mb-0">© 2026 EthioChain SCM. All data is encrypted and secure.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            opacity: .65;
            transform: scale(.85) translateY(-.5rem) translateX(.15rem);
            color: var(--brand-primary);
        }
        .extra-small { font-size: 0.75rem; }
        .shadow-premium { box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
    <partial name="_ValidationScriptsPartial" />
}