@model SCM_System.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Secure Portal Access";
    Layout = "_Layout";
}

<div class="login-wrapper d-flex min-vh-100 position-relative overflow-hidden">
    <!-- Video Background -->
    <video class="video-bg" autoplay muted loop playsinline>
        <source src="~/videos/HOME.mp4" type="video/mp4">
        </video>
        <div class="overlay"></div>

        <!-- Two Column Layout with proper spacing -->
        <div class="container-fluid position-relative z-3">
            <div class="row g-0 min-vh-100">
            
                <!-- LEFT COLUMN - Hero (simplified) -->
                <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center px-5 text-white">
                    <div>
                       
                    
                        <!-- Headline -->
                        <h1 class="display-5 fw-bold mb-4">Digital Backbone for<br><span class="text-warning">African Supply Chains</span></h1>
                    
                        <!-- Features -->
                        <div class="mb-4">
                            <div class="d-flex gap-3 mb-3">
                                <i class="fas fa-shield-alt text-warning fs-5 mt-1"></i>
                                <div><strong>Fayda Verified</strong><br><small class="text-white-50">Legally vetted businesses</small></div>
                            </div>
                            <div class="d-flex gap-3">
                                <i class="fas fa-route text-warning fs-5 mt-1"></i>
                                <div><strong>Live Tracking</strong><br><small class="text-white-50">Real-time visibility</small></div>
                            </div>
                        </div>
                    </div>
                </div>
            
                <!-- RIGHT COLUMN - Login Form -->
                <div class="col-lg-6 d-flex align-items-center justify-content-center p-4">
                    <div class="card border-0 rounded-4 shadow-xxl" style="max-width: 440px; width: 100%;">
                        <div class="card-body p-4 p-md-5">
                        
                            <!-- Mobile Logo -->
                            <div class="d-lg-none text-center mb-4">
                                <img src="~/images/ethiochain-logo.jpg" alt="EthioChain" style="width: 50px; height: 50px; object-fit: contain; border-radius: 12px;" />
                                <h3 class="fw-bold mt-2">Welcome Back</h3>
                            </div>
                        
                            <!-- Desktop Title -->
                            <div class="text-center mb-4">
                                <h3 class="fw-bold mb-1">Welcome Back</h3>
                                <p class="text-muted small">Sign in to continue</p>
                            </div>

                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="alert alert-danger bg-danger bg-opacity-10 border-0 rounded-3 mb-4">
                                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                                </div>
                            }

                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success bg-success bg-opacity-10 border-0 rounded-3 mb-4">
                                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                                </div>
                            }

                            <form asp-action="Login" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                            
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold mb-1">Email</label>
                                    <input asp-for="Email" class="form-control form-control-lg rounded-3"
                                           placeholder="name@company.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold mb-1">Password</label>
                                    <div class="position-relative">
                                        <input asp-for="Password" id="password" type="password"
                                               class="form-control form-control-lg rounded-3 pe-5"
                                               placeholder="••••••••" />
                                        <button type="button" class="btn p-0 position-absolute end-0 top-50 translate-middle-y me-3"
                                                id="togglePassword" style="background: none; border: none;">
                                            <i class="fas fa-eye-slash text-muted"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" />
                                        <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                                    </div>
                                    <a href="#" class="small text-decoration-none" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
                                        Forgot password?
                                    </a>
                                </div>

                                <button type="submit" class="btn w-100 py-3 fw-bold rounded-3 mb-3" style="background: #0b3d60; color: white;">
                                    Sign In
                                </button>

                                <div class="text-center">
                                    <span class="small text-muted">New user?</span>
                                    <a asp-action="Register" class="small fw-bold text-decoration-none ms-1">Create Account</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Forgot Password Modal -->
    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Reset Your Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">
                        Enter your email address and we'll send you a link to reset your password.
                    </p>
                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <input type="email" name="Email" id="resetEmail" class="form-control form-control-lg rounded-3"
                                   placeholder="name@company.com" required />
                        </div>
                        <div id="resetMessage" class="alert d-none mb-3"></div>
                        <button type="submit" class="btn w-100 py-3 fw-bold rounded-3" style="background: #0b3d60; color: white;">
                            <i class="fas fa-paper-plane me-2"></i> Send Reset Link
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section Styles {
        <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
        <style>
            .video-bg {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
            }
    
            .overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba(7, 37, 59, 0.88) 0%, rgba(11, 61, 96, 0.8) 100%);
                z-index: 1;
            }
    
            .z-3 {
                z-index: 3;
            }
    
            .shadow-xxl {
                box-shadow: 0 30px 50px -20px rgba(0, 0, 0, 0.4);
            }
    
            .form-control {
                border: 1px solid #e9ecef;
                background: #f8f9fa;
            }
    
                .form-control:focus {
                    border-color: #0b3d60;
                    background: white;
                    box-shadow: 0 0 0 3px rgba(11, 61, 96, 0.1);
                }
    
            .btn:hover {
                transform: translateY(-2px);
                transition: all 0.2s;
                filter: brightness(1.05);
            }
    
            .text-white-50 {
                color: rgba(255, 255, 255, 0.6);
            }
        
            .modal-content {
                border: none;
            }
        </style>
    }

    @section Scripts {
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
        <script>
            AOS.init({ duration: 600, once: true });
    
            const toggleBtn = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');
    
            if (toggleBtn && passwordInput) {
            toggleBtn.addEventListener('click', function() {
            const type = passwordInput.type === 'password' ? 'text' : 'password';
            passwordInput.type = type;
            const icon = this.querySelector('i');
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
            });
            }
        
            // Forgot Password Form Submission with AJAX
            const forgotForm = document.getElementById('forgotPasswordForm');
            const resetMessage = document.getElementById('resetMessage');
        
            if (forgotForm) {
            forgotForm.addEventListener('submit', async function(e) {
            e.preventDefault();
                
            const email = document.getElementById('resetEmail').value;
            const submitBtn = forgotForm.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
                
            // Disable button and show loading
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Sending...';
                
            try {
            const response = await fetch('/Account/ForgotPassword', {
            method: 'POST',
            headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ email: email })
            });
                    
            const result = await response.json();
                    
            resetMessage.classList.remove('d-none', 'alert-danger', 'alert-success');
                    
            if (result.success) {
            resetMessage.classList.add('alert-success');
            resetMessage.innerHTML = '<i class="fas fa-check-circle me-2"></i> ' + result.message;
            document.getElementById('resetEmail').value = '';
            // Close modal after 3 seconds
            setTimeout(() => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('forgotPasswordModal'));
            if (modal) modal.hide();
            resetMessage.classList.add('d-none');
            }, 3000);
            } else {
            resetMessage.classList.add('alert-danger');
            resetMessage.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i> ' + result.message;
            }
            } catch (error) {
            resetMessage.classList.remove('d-none');
            resetMessage.classList.add('alert-danger');
            resetMessage.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i> Something went wrong. Please try again.';
            } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            }
            });
            }
        </script>
        <partial name="_ValidationScriptsPartial" />
    }