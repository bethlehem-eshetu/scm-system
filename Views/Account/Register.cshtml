@model SCM_System.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account - EthioChain SCM";
    Layout = "_Layout";
}

<div class="register-page">
    <div class="register-card">
        <!-- Left Side: Illustration -->
        <div class="register-left">
            <div class="blobs-container">
                <div class="blob b-1"></div>
                <div class="blob b-2"></div>
            </div>
            <img src="/images/anime-warehouse.png" alt="Join EthioChain" class="anime-img bounce-soft" />
            <div class="left-content">
                <h2>Join the Network</h2>
                <p>Verify your identity and start trading securely across the supply chain.</p>
            </div>
        </div>

        <!-- Right Side: Form Content -->
        <div class="register-right">
            <div class="form-scroll-area">
                <div class="brand-header">
                    <img src="/images/ethiochain-logo.jpg" alt="Logo" />
                    <span>EthioChain</span>
                </div>

                <div class="step-progress">
                    <div class="progress-bar-inspo">
                        <div class="progress-fill" id="progressFill" style="width: 33%"></div>
                    </div>
                    <div class="step-labels">
                        <span class="active" id="label-1">Identity</span>
                        <span id="label-2">Account</span>
                        <span id="label-3">Business</span>
                    </div>
                </div>

                <h1 class="card-title">Create account</h1>
                <p class="card-subtitle">Fill in your details to get started.</p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert custom-alert-danger">
                        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" id="RoleHidden" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert custom-alert-danger small">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <!-- STEP 1: Fayda Verification -->
                    <div id="step-1" class="registration-step">
                        <div class="input-group-inspo">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" id="EmailInput" placeholder="john@company.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div id="fanSection">
                            <div class="input-group-inspo">
                                <label>Fayda Account Number (FAN)</label>
                                <div class="otp-input-wrapper">
                                    <input asp-for="FAN" id="FANInput" placeholder="16-digit FAN" maxlength="16" />
                                    <button class="btn-otp" type="button" id="btnRequestOtp">Get OTP</button>
                                </div>
                                <span id="fanError" class="text-danger small"></span>
                            </div>
                        </div>

                        <div id="otpSection" style="display: none;">
                            <div class="input-group-inspo">
                                <label>Verification Code (OTP)</label>
                                <div class="otp-input-wrapper">
                                    <input type="text" id="OTPInput" placeholder="••••••" maxlength="6" />
                                    <button class="btn-otp verify" type="button" id="btnVerifyOtp">Verify</button>
                                </div>
                                <div class="timer-resend">
                                    <span id="expiryTimerDisplay">Expires in: 05:00</span>
                                    <button type="button" id="btnResendOtp" disabled>Resend in <span id="resendTimer">60</span>s</button>
                                </div>
                                <span id="otpError" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: Account Essentials -->
                    <div id="step-2" class="registration-step" style="display: none;">
                        <div class="alert alert-success small mb-3" style="border-radius: 12px;">
                            <i class="fas fa-check-circle me-2"></i> Identity Verified! Your name and date of birth are confirmed via Fayda.
                        </div>

                        <div class="input-group-inspo">
                            <label>Full Name (Verified)</label>
                            <input asp-for="FullName" id="FullNameInput" readonly placeholder="Verified via Fayda" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="input-group-inspo">
                            <label>Register As</label>
                            <select id="RoleSelect" name="RoleSelectDummy" class="inspo-select" required>
                                <option value="">Select Role</option>
                                <option value="Supplier">Supplier (Sell Products)</option>
                                <option value="Retailer">Retailer (Buy Products)</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group-inspo">
                                    <label>Password</label>
                                    <input asp-for="Password" type="password" id="regPassword" placeholder="••••••••" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group-inspo">
                                    <label>Confirm</label>
                                    <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" placeholder="••••••••" />
                                </div>
                            </div>
                        </div>

                        <div class="input-group-inspo">
                            <label>Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" id="DateOfBirth" />
                        </div>

                        <div class="btn-nav-group">
                            <button type="button" class="btn-back btnBackToStep1">Back</button>
                            <button type="button" class="btn-next" id="btnNextToStep3">Continue</button>
                        </div>
                    </div>

                    <!-- STEP 3: Business Profile -->
                    <div id="step-3" class="registration-step" style="display: none;">
                        <!-- Business Name (Dynamic based on role) -->
                        <div class="input-group-inspo">
                            <label id="lblBusinessName">Company Name</label>
                            <input asp-for="BusinessName" id="BusinessNameInput" placeholder="Eco Distribution Ltd." />
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>

                        <!-- Supplier Categories Section (Visible only for Suppliers) -->
                        <div id="SupplierCategoriesSection" style="display: none;">
                            <div class="input-group-inspo">
                                <label class="fw-bold">Business Categories / What do you supply? <span class="text-danger">*</span></label>
                                <div class="category-container" style="max-height: 350px; overflow-y: auto; background: var(--brand-gray); border-radius: 16px; padding: 16px;">
                                    <div class="category-hierarchy">
                                        @if (ViewBag.Categories != null)
                                        {
                                            @foreach (var category in (IEnumerable<SCM_System.Models.Entities.ProductCategory>)ViewBag.Categories)
                                            {
                                                <div class="category-group mb-3">
                                                    <div class="form-check p-3 rounded-3 border bg-white d-flex align-items-center mb-2 shadow-sm">
                                                        <input class="form-check-input parent-category me-3" type="checkbox" name="SelectedCategoryIds" value="@category.Id" id="cat_@category.Id" style="width: 18px; height: 18px;">
                                                        <label class="form-check-label fw-bold text-dark" for="cat_@category.Id">
                                                            <i class="fas fa-folder-open me-2 text-primary"></i> @category.CategoryName
                                                        </label>
                                                    </div>
                                                    @if (category.SubCategories != null && category.SubCategories.Any())
                                                    {
                                                        <div class="subcategories-container ms-4 ps-3 border-start border-2 border-primary border-opacity-25 row g-2">
                                                            @foreach (var sub in category.SubCategories)
                                                            {
                                                                <div class="col-md-4 col-sm-6">
                                                                    <div class="form-check p-2 rounded-3 border bg-white h-100 d-flex align-items-center">
                                                                        <input class="form-check-input sub-category me-2" type="checkbox" name="SelectedCategoryIds" value="@sub.Id" id="cat_@sub.Id" data-parent="cat_@category.Id">
                                                                        <label class="form-check-label small text-muted" for="cat_@sub.Id">
                                                                            @sub.CategoryName
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="alert alert-info py-2 px-3 rounded-3 small mt-2">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Matching Rule:</strong> Selecting a Main Category automatically qualifies you for all its subcategories.
                                </div>
                                <span id="categoryError" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Address Fields -->
                        <div class="input-group-inspo">
                            <label>Physical Address</label>
                            <input asp-for="Address" placeholder="Bole, Addis Ababa" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="input-group-inspo">
                            <label>Contact Number</label>
                            <input asp-for="PhoneNumber" placeholder="+251..." />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- License Upload -->
                        <div class="input-group-inspo">
                            <label id="lblLicense">Business License (PDF/Image)</label>
                            <input type="file" name="LicenseFile" id="LicenseFile" class="file-input-custom" accept=".pdf,.jpg,.jpeg,.png" />
                            <p class="file-hint">Max size: 5MB. Accepted formats: PDF, JPG, JPEG, PNG</p>
                        </div>

                        <div class="btn-nav-group">
                            <button type="button" class="btn-back btnBackToStep2">Back</button>
                            <button type="submit" class="btn-next" id="btnSubmit">Create Account</button>
                        </div>
                    </div>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a asp-action="Login">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --brand-green: #4da699;
            --brand-green-dark: #1a3d31;
            --brand-green-light: #d4f06d;
            --brand-white: #ffffff;
            --brand-gray: #f2f6f6;
            --text-main: #1a3d31;
            --text-muted: #64748b;
        }

        body {
            background-color: var(--brand-gray);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow: hidden;
        }

        .register-page {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-card {
            width: 100%;
            max-width: 1200px;
            height: 90vh;
            background: var(--brand-white);
            border-radius: 40px;
            display: flex;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }

        /* Left Side Illustration */
        .register-left {
            flex: 1;
            background-color: var(--brand-green-dark);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            overflow: hidden;
        }

        .blobs-container {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .blob {
            position: absolute;
            background: var(--brand-green);
            filter: blur(80px);
            opacity: 0.2;
            border-radius: 50%;
        }

        .b-1 { width: 400px; height: 400px; top: -100px; left: -100px; }
        .b-2 { width: 300px; height: 300px; bottom: -50px; right: -50px; background: var(--brand-green-light); }

        .anime-img {
            width: 100%;
            max-width: 350px;
            z-index: 2;
            position: relative;
        }

        .bounce-soft {
            animation: bounceSoft 4s infinite ease-in-out;
        }

        @@keyframes bounceSoft {
            0%, 100% { transform: translateY(0) rotate(0); }
            50% { transform: translateY(-20px) rotate(2deg); }
        }

        .left-content {
            z-index: 2;
            text-align: center;
            margin-top: 30px;
            color: var(--brand-white);
        }

        .left-content h2 { font-size: 2rem; font-weight: 800; margin-bottom: 10px; }
        .left-content p { font-size: 1rem; opacity: 0.8; }

        /* Right Side Form */
        .register-right {
            flex: 1.2;
            padding: 30px;
            background: var(--brand-white);
            position: relative;
        }

        .form-scroll-area {
            height: 100%;
            overflow-y: auto;
            padding-right: 15px;
        }

        .form-scroll-area::-webkit-scrollbar { width: 6px; }
        .form-scroll-area::-webkit-scrollbar-track { background: transparent; }
        .form-scroll-area::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .brand-header img { width: 28px; height: 28px; border-radius: 8px; }
        .brand-header span { font-weight: 800; color: var(--brand-green-dark); font-size: 1.1rem; }

        .step-progress { margin-bottom: 30px; }
        .progress-bar-inspo { height: 6px; background: #f1f5f9; border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
        .progress-fill { height: 100%; background: var(--brand-green); transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .step-labels { display: flex; justify-content: space-between; }
        .step-labels span { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #cbd5e1; letter-spacing: 0.5px; }
        .step-labels span.active { color: var(--brand-green); }

        .card-title { font-size: 1.8rem; font-weight: 800; color: var(--brand-green-dark); margin-bottom: 5px; }
        .card-subtitle { color: var(--text-muted); margin-bottom: 25px; font-size: 0.9rem; }

        .input-group-inspo { margin-bottom: 18px; }
        .input-group-inspo label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--brand-green-dark); margin-bottom: 8px; }
        .input-group-inspo input, .inspo-select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--brand-gray);
            border-radius: 16px;
            background: var(--brand-gray);
            color: var(--text-main);
            font-weight: 500;
            transition: all 0.2s;
        }

        .input-group-inspo input:focus, .inspo-select:focus {
            outline: none;
            border-color: var(--brand-green);
            background: var(--brand-white);
            box-shadow: 0 0 0 4px rgba(77, 166, 153, 0.1);
        }

        .otp-input-wrapper { display: flex; gap: 10px; }
        .btn-otp {
            padding: 0 20px;
            background: var(--brand-green-dark);
            color: white;
            border: none;
            border-radius: 16px;
            font-weight: 700;
            font-size: 0.85rem;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .btn-otp:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        .btn-otp.verify { background: var(--brand-green); }

        .timer-resend { display: flex; justify-content: space-between; margin-top: 8px; }
        .timer-resend span { font-size: 0.7rem; color: var(--text-muted); font-weight: 600; }
        .timer-resend button { background: none; border: none; font-size: 0.7rem; font-weight: 700; color: var(--brand-green); cursor: pointer; }
        .timer-resend button:disabled { color: #cbd5e1; cursor: default; }

        .btn-nav-group { display: flex; gap: 15px; margin-top: 30px; }
        .btn-next {
            flex: 2;
            padding: 14px;
            background: var(--brand-green);
            color: white;
            border: none;
            border-radius: 18px;
            font-weight: 800;
            font-size: 1rem;
            box-shadow: 0 10px 20px -5px rgba(77, 166, 153, 0.3);
            transition: all 0.3s;
        }

        .btn-next:hover { transform: translateY(-3px); box-shadow: 0 20px 25px -5px rgba(77, 166, 153, 0.4); }

        .btn-back {
            flex: 1;
            padding: 14px;
            background: var(--brand-gray);
            color: var(--brand-green-dark);
            border: none;
            border-radius: 18px;
            font-weight: 800;
            transition: all 0.2s;
        }

        .btn-back:hover { background: #e2e8f0; }

        .auth-footer { margin-top: 25px; text-align: center; }
        .auth-footer p { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }
        .auth-footer a { color: var(--brand-green); text-decoration: none; font-weight: 800; }

        .custom-alert-danger {
            background: #fef2f2;
            border: 2px solid #fee2e2;
            color: #b91c1c;
            border-radius: 16px;
            padding: 12px;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .file-input-custom { padding: 10px !important; font-size: 0.8rem; }
        .file-hint { font-size: 0.7rem; color: var(--text-muted); margin-top: 5px; }

        .category-container {
            background: #f8fafc;
            border-radius: 16px;
        }

        .category-group {
            border-radius: 12px;
        }

        @@media (max-width: 992px) {
            .register-left { display: none; }
            .register-card { max-width: 550px; height: auto; max-height: 95vh; }
            .register-right { padding: 25px; }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentStep = 1;
            let isVerified = false;
            let expiryTimer = null;
            let resendTimer = null;

            function updateUI() {
                $('.registration-step').hide();
                $(`#step-${currentStep}`).fadeIn(400);
                $('#progressFill').css('width', (currentStep * 33.33) + '%');
                $('.step-labels span').removeClass('active');
                for (let i = 1; i <= currentStep; i++) {
                    $(`#label-${i}`).addClass('active');
                }
            }

            // --- OTP Flow ---
            function startTimers() {
                let expiryCountdown = 300;
                let resendCountdown = 60;

                $('#btnResendOtp').prop('disabled', true).text(`Resend in ${resendCountdown}s`);
                $('#expiryTimerDisplay').removeClass('text-danger').text('Expires in: 05:00');

                if (expiryTimer) clearInterval(expiryTimer);
                if (resendTimer) clearInterval(resendTimer);

                expiryTimer = setInterval(function() {
                    expiryCountdown--;
                    const mins = Math.floor(expiryCountdown / 60);
                    const secs = expiryCountdown % 60;
                    const timeStr = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
                    $('#expiryTimerDisplay').text('Expires in: ' + timeStr);
                    if (expiryCountdown < 60) $('#expiryTimerDisplay').addClass('text-danger');
                    if (expiryCountdown <= 0) {
                        clearInterval(expiryTimer);
                        $('#otpError').text('OTP has expired. Please request a new one.');
                        $('#btnVerifyOtp').prop('disabled', true);
                    }
                }, 1000);

                resendTimer = setInterval(function() {
                    resendCountdown--;
                    if (resendCountdown <= 0) {
                        clearInterval(resendTimer);
                        $('#btnResendOtp').prop('disabled', false).text('Resend OTP');
                    } else {
                        $('#btnResendOtp').text(`Resend in ${resendCountdown}s`);
                    }
                }, 1000);
            }

            $('#btnRequestOtp').click(function () {
                const fan = $('#FANInput').val();
                const email = $('#EmailInput').val();
                
                if (fan.length !== 16) {
                    $('#fanError').text('Please enter a valid 16-digit FAN.');
                    return;
                }
                if (!email) {
                    $('#fanError').text('Please enter your email first.');
                    return;
                }

                const $btn = $(this);
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Sending...').prop('disabled', true);
                $('#fanError').text('');
                
                $.ajax({
                    url: '/Account/RequestFaydaOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ fan: fan, email: email }),
                    success: function (response) {
                        if (response.success) {
                            $('#fanSection').fadeOut(300, () => {
                                $('#otpSection').fadeIn(300);
                                startTimers();
                            });
                        } else {
                            $('#fanError').text(response.message || 'Error sending OTP.');
                            $btn.html('Get OTP').prop('disabled', false);
                        }
                    },
                    error: function () {
                        $('#fanError').text('Service unavailable. Please try again later.');
                        $btn.html('Get OTP').prop('disabled', false);
                    }
                });
            });

            $('#btnVerifyOtp').click(function () {
                const otp = $('#OTPInput').val();
                const fan = $('#FANInput').val();

                if (otp.length !== 6) {
                    $('#otpError').text('Please enter the 6-digit code.');
                    return;
                }
                
                const $btn = $(this);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);
                $('#otpError').text('');

                $.ajax({
                    url: '/Account/VerifyFaydaOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ fan: fan, otp: otp }),
                    success: function (response) {
                        if (response.success) {
                            isVerified = true;
                            $('#FullNameInput').val(response.fullName);
                            if (response.dateOfBirth) {
                                const dob = new Date(response.dateOfBirth);
                                const year = dob.getFullYear();
                                const month = String(dob.getMonth() + 1).padStart(2, '0');
                                const day = String(dob.getDate()).padStart(2, '0');
                                $('#DateOfBirth').val(`${year}-${month}-${day}`);
                            }
                            if (response.phoneNumber) {
                                $('#PhoneNumber').val(response.phoneNumber);
                            }
                            $('#otpSection, #fanSection').remove();
                            currentStep = 2;
                            updateUI();
                        } else {
                            $('#otpError').text(response.message || 'Verification failed.');
                            $btn.html('Verify').prop('disabled', false);
                        }
                    },
                    error: function () {
                        $('#otpError').text('Service unavailable. Please try again.');
                        $btn.html('Verify').prop('disabled', false);
                    }
                });
            });

            $('#btnResendOtp').click(function() {
                const fan = $('#FANInput').val();
                const email = $('#EmailInput').val();
                const $btn = $(this);
                $btn.prop('disabled', true).text('Sending...');
                $('#otpError').text('');

                $.ajax({
                    url: '/Account/RequestFaydaOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ fan: fan, email: email }),
                    success: function (response) {
                        if (response.success) {
                            startTimers();
                            $('#otpError').text('New OTP sent!').css('color', 'green');
                            setTimeout(() => $('#otpError').text(''), 3000);
                        } else {
                            $('#otpError').text(response.message || 'Error resending OTP.');
                            $btn.prop('disabled', false).text('Resend OTP');
                        }
                    },
                    error: function () {
                        $('#otpError').text('Service unavailable.');
                        $btn.prop('disabled', false).text('Resend OTP');
                    }
                });
            });

            // --- Step Navigation ---
            $('#btnNextToStep3').click(function () {
                const role = $('#RoleSelect').val();
                if (!role) {
                    alert('Please select a role.');
                    return;
                }
                $('#RoleHidden').val(role);
                
                // Update UI labels based on role
                if (role === 'Supplier') {
                    $('#lblBusinessName').text('Supplier/Company Name');
                    $('#lblLicense').text('Commercial Registration Certificate');
                    $('#SupplierCategoriesSection').show();
                    // Make Business Name required for Supplier
                    $('#BusinessNameInput').prop('required', true);
                } else {
                    $('#lblBusinessName').text('Retail Store Name');
                    $('#lblLicense').text('Retail Trade License');
                    $('#SupplierCategoriesSection').hide();
                    $('#BusinessNameInput').prop('required', true);
                }

                currentStep = 3;
                updateUI();
            });

            $('.btnBackToStep1').click(() => { currentStep = 1; updateUI(); });
            $('.btnBackToStep2').click(() => { currentStep = 2; updateUI(); });

            // --- Category Selection Logic ---
            $(document).on('change', '.parent-category', function() {
                const isChecked = $(this).is(':checked');
                const parentId = $(this).attr('id');
                $(`.sub-category[data-parent="${parentId}"]`).prop('checked', isChecked);
                
                if (isChecked) {
                    $(this).closest('.category-group').addClass('bg-primary bg-opacity-10');
                } else {
                    $(this).closest('.category-group').removeClass('bg-primary bg-opacity-10');
                }
            });

            $(document).on('change', '.sub-category', function() {
                const parentId = $(this).data('parent');
                const $parent = $(`#${parentId}`);
                const $allSubs = $(`.sub-category[data-parent="${parentId}"]`);
                const $checkedSubs = $(`.sub-category[data-parent="${parentId}"]:checked`);

                if ($checkedSubs.length === $allSubs.length && $allSubs.length > 0) {
                    $parent.prop('checked', true);
                } else {
                    $parent.prop('checked', false);
                }
            });

            // --- Form Validation before Submit ---
            $('#registerForm').on('submit', function(e) {
                const role = $('#RoleHidden').val();

                if (role === 'Supplier') {
                    if ($('input[name="SelectedCategoryIds"]:checked').length === 0) {
                        $('#categoryError').text('Please select at least one business category.');
                        e.preventDefault();
                        return false;
                    } else {
                        $('#categoryError').text('');
                    }
                }
                return true;
            });
        });
    </script>
}