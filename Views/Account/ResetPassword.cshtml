@model SCM_System.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password - EthioChain SCM";
    Layout = "_Layout";
}

<div class="reset-page">
    <div class="reset-container">
        <div class="reset-card">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle" style="width: 70px; height: 70px;">
                    <img src="~/images/ethiochain-logo.jpg" alt="EthioChain" style="width: 45px; height: 45px; object-fit: contain;" />
                </div>
                <h2 class="fw-bold text-white">Reset Password</h2>
                <p class="text-light opacity-75 small">Create a new secure password for your account</p>
            </div>


            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="input-group-custom">
                    <label asp-for="NewPassword">New Password</label>
                    <div class="password-wrapper">
                        <input asp-for="NewPassword" type="password" id="NewPassword" placeholder="Enter new password" required />
                        <button type="button" class="toggle-password-btn" onclick="togglePassword('NewPassword', this)">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="input-group-custom">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <div class="password-wrapper">
                        <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" placeholder="Confirm your password" required />
                        <button type="button" class="toggle-password-btn" onclick="togglePassword('ConfirmPassword', this)">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="reset-submit-btn">
                    <i class="fas fa-key me-2"></i> Save New Password
                </button>

                <div class="text-center mt-4">
                    <a asp-action="Login" class="back-link">← Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #5e9e94;
            --input-bg: rgba(255, 255, 255, 0.1);
        }

        .reset-page {
            background-color: var(--dark-green);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-container {
            width: 100%;
            max-width: 450px;
        }

        .reset-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            padding: 40px;
            border-radius: 30px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .input-group-custom {
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
        }

        .input-group-custom label {
            color: #ccc;
            font-size: 0.9rem;
            margin-bottom: 8px;
        }

        .input-group-custom input {
            background: var(--input-bg);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 12px 16px;
            color: white;
            outline: none;
            transition: all 0.3s ease;
            width: 100%;
        }

        .input-group-custom input:focus {
            background: rgba(255,255,255,0.15);
            border-color: var(--accent-green);
        }

        .password-wrapper {
            position: relative;
            display: flex;
        }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255,255,255,0.5);
            cursor: pointer;
        }

        .reset-submit-btn {
            width: 100%;
            background-color: var(--accent-green);
            color: white;
            border: none;
            border-radius: 25px;
            padding: 14px;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 14px rgba(94, 158, 148, 0.4);
        }

        .reset-submit-btn:hover {
            background-color: #4f8b82;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(94, 158, 148, 0.6);
        }

        .back-link {
            color: #ccc;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .back-link:hover {
            color: white;
        }

        .custom-alert {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.2);
            color: #ff8e9a;
            border-radius: 12px;
            padding: 12px;
            font-size: 0.85rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId, button) {
            const input = document.getElementById(fieldId);
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }
    </script>
}