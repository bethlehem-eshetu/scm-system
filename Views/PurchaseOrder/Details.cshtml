@model SCM_System.Models.Entities.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="fas fa-file-invoice me-2"></i>PO: @Model.PONumber</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Items Card -->
            <div class="glass-card mb-4 overflow-hidden">
                <div class="p-4 border-bottom bg-light bg-opacity-50">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2"></i>Ordered Items</h5>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Product</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th class="text-end pe-4">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
                                {
                                    foreach (var item in Model.PurchaseOrderItems)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@item.Product?.ProductName</div>
                                                <small class="text-muted">ID: #@item.ProductId</small>
                                            </td>
                                            <td>@item.Quantity</td>
                                            <td>@item.UnitPrice.ToString("C")</td>
                                            <td class="text-end pe-4 fw-bold text-primary">
                                                @((item.Quantity * item.UnitPrice).ToString("C"))
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No items found in this order.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light bg-opacity-50">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold ps-4">Grand Total:</td>
                                    <td class="text-end pe-4 fw-bold h5 text-primary">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Delivery Info -->
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-truck me-2"></i>Delivery Information</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small d-block">Expected Delivery</label>
                        <span class="fw-bold">@Model.ExpectedDeliveryDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="col-md-12">
                        <label class="text-muted small d-block">Delivery Address</label>
                        <p class="fw-bold mb-0">@Model.DeliveryAddress</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Summary Info -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-4">Order Summary</h5>
                <div class="mb-3">
                    <label class="text-muted small d-block">Status</label>
                    <span class="badge rounded-pill p-2 px-3 @(Model.Status == "Pending" ? "bg-warning text-dark" : (Model.Status == "Accepted" ? "bg-success" : "bg-danger"))">
                        @Model.Status
                    </span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">@(User.IsInRole("Supplier") ? "Retailer" : "Supplier")</label>
                    <div class="fw-bold">
                        <i class="fas fa-building me-1 text-muted"></i>
                        @(User.IsInRole("Supplier") ? Model.Retailer?.BusinessName : Model.Supplier?.CompanyName)
                    </div>
                </div>
                <div class="mb-4">
                    <label class="text-muted small d-block">Order Date</label>
                    <div class="fw-bold">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
                </div>

                @if (User.IsInRole("Supplier") && Model.Status == "Pending")
                {
                    <div class="d-grid gap-2 border-top pt-4">
                        <form asp-action="StatusAction" method="post" class="d-grid gap-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" name="actionType" value="Accept" class="btn btn-success rounded-pill py-2">
                                <i class="fas fa-check-circle me-1"></i> Accept Order Request
                            </button>
                            <button type="submit" name="actionType" value="Reject" class="btn btn-outline-danger rounded-pill py-2">
                                <i class="fas fa-times-circle me-1"></i> Reject Request
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Status == "Accepted")
                {
                    <div class="alert alert-success d-flex align-items-center mb-0">
                        <i class="fas fa-check-double me-2"></i>
                        <div>This order request has been accepted.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
