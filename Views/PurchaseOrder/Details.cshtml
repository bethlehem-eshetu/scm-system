@model SCM_System.Models.Entities.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
    Layout = "_DashboardLayout";
    bool isRetailer = User.IsInRole("Retailer");
    bool isSupplier = User.IsInRole("Supplier") || User.IsInRole("WarehouseManager");
    
    // Status Flow Logic for Timeline
    var statuses = new[] { "PO Issued", "Processing", "Picked", "Packed", "In Transit", "Delivered", "Completed" };
    int currentIdx = Array.IndexOf(statuses, Model.Status);
    if (currentIdx == -1 && Model.Status == "Accepted") currentIdx = 1; // Map Accepted to Processing
    if (currentIdx == -1 && Model.Status == "Ready for Pickup") currentIdx = 3; // Map Ready to Packed
}

<div class="container-fluid py-4">
    <!-- Header Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4 bg-primary text-white">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1">Purchase Order</h6>
                    <h2 class="fw-bold mb-0">#@Model.PONumber</h2>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="badge bg-white text-primary rounded-pill px-4 py-2 fs-6 shadow-sm">@Model.Status</span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white border-0 p-4">
            <div class="row g-4">
                <div class="col-md-3 border-end">
                    <label class="smaller text-muted d-block">SUPPLIER</label>
                    <span class="fw-bold text-dark">@Model.Order?.Supplier?.CompanyName</span>
                </div>
                <div class="col-md-3 border-end">
                    <label class="smaller text-muted d-block">RETAILER</label>
                    <span class="fw-bold text-dark">@Model.Order?.Retailer?.BusinessName</span>
                </div>
                <div class="col-md-3 border-end">
                    <label class="smaller text-muted d-block">ISSUED DATE</label>
                    <span class="fw-bold text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="col-md-3">
                    <label class="smaller text-muted d-block">TOTAL AMOUNT</label>
                    <span class="fw-bold text-success">@((Model.TotalAmount * 1.15m).ToString("C"))</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Tracking Timeline -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 overflow-hidden">
        <h5 class="fw-bold mb-4">Fulfillment Journey</h5>
        <div class="d-flex justify-content-between position-relative px-2 mb-2" style="min-width: 800px;">
            <div class="position-absolute top-50 start-0 translate-middle-y w-100 bg-light" style="height: 4px; z-index: 0;"></div>
            <div class="position-absolute top-50 start-0 translate-middle-y bg-primary" style="height: 4px; z-index: 1; width: @(currentIdx * 16.66)%; transition: width 1s ease;"></div>
            
            @for (int i = 0; i < statuses.Length; i++)
            {
                var icon = i switch { 0 => "fa-file-invoice", 1 => "fa-sync", 2 => "fa-hand-holding-box", 3 => "fa-box", 4 => "fa-truck", 5 => "fa-check-circle", _ => "fa-flag-checkered" };
                var color = i <= currentIdx ? "bg-primary text-white" : "bg-white text-muted border border-light";
                
                <div class="text-center position-relative" style="z-index: 2; width: 50px;">
                    <div class="mx-auto mb-2 shadow-sm d-flex align-items-center justify-content-center rounded-circle @color" style="width: 40px; height: 40px;">
                        <i class="fas @icon small"></i>
                    </div>
                    <div class="smaller fw-bold @(i <= currentIdx ? "text-dark" : "text-muted")">@statuses[i]</div>
                    @if (i == 0) { <div class="extra-small text-muted">@Model.CreatedAt.ToString("HH:mm")</div> }
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Items Table -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold mb-0">Order Items</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 text-uppercase smaller text-muted">Product</th>
                                <th class="text-uppercase smaller text-muted">Quantity</th>
                                <th class="text-uppercase smaller text-muted">Unit Price</th>
                                <th class="text-end pe-4 text-uppercase smaller text-muted">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PurchaseOrderItems)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                    </td>
                                    <td><span class="badge bg-secondary-subtle text-secondary border">x @item.Quantity</span></td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end pe-4 fw-bold text-primary">@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Logistics Info -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h6 class="fw-bold text-uppercase text-muted mb-4">Logistics Details</h6>
                <div class="mb-4 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3">
                        <i class="fas fa-warehouse text-primary"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">WAREHOUSE</label>
                        <span class="fw-bold text-dark">@(Model.Warehouse?.Name ?? "Pending Assignment")</span>
                        <div class="small text-muted">@Model.Warehouse?.Address</div>
                    </div>
                </div>
                <div class="mb-4 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3">
                        <i class="fas fa-user-tie text-primary"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">DELIVERY AGENT</label>
                        <span class="fw-bold text-dark">@(Model.DeliveryAgent?.User?.FullName ?? "Queueing for Agent")</span>
                    </div>
                </div>
                <div class="mb-0 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3">
                        <i class="fas fa-map-pin text-primary"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">DESTINATION</label>
                        <span class="fw-bold text-dark">@Model.Retailer?.BusinessName</span>
                        <div class="small text-muted">@Model.DeliveryAddress</div>
                    </div>
                </div>
            </div>

            @if (isSupplier && Model.Status != "Delivered" && Model.Status != "Completed")
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-warning">
                    <h6 class="fw-bold text-uppercase text-muted mb-3">Operational Action</h6>
                    <form asp-action="UpdateStatus" method="post" class="d-grid shadow-sm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <select name="status" class="form-select rounded-pillar">
                                <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                                <option value="Picked" selected="@(Model.Status == "Picked")">Picked</option>
                                <option value="Packed" selected="@(Model.Status == "Packed")">Packed</option>
                                <option value="Ready for Pickup" selected="@(Model.Status == "Ready for Pickup")">Ready Dispatch</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning rounded-pill fw-bold">Update Logistics Stage</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1); }
</style>
