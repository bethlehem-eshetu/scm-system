@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "SCM Fulfillment Pipeline";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 fulfillment-pipeline-container">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark-green mb-1 dark-mode-text">
                <i class="fas fa-clipboard-list me-2"></i>
                Fulfillment Pipeline
            </h4>
            <p class="text-muted extra-small mb-0 dark-mode-text">Track and manage all your purchase orders</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <div class="search-bar-premium position-relative">
                <form asp-action="SupplierIndex" method="get" class="d-flex w-100">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted dark-mode-text"></i>
                    <input type="text" name="searchTerm" class="form-control border-0 bg-white rounded-pill ps-5 shadow-sm dark-mode-input extra-small" placeholder="Search PO# or Client..." value="@ViewBag.SearchTerm" style="width: 240px; height: 38px;">
                </form>
            </div>
            <button class="btn btn-white rounded-pill px-3 py-2 shadow-premium fw-bold d-flex align-items-center dark-mode-btn small">
                <i class="fas fa-file-export me-2 text-dark-green"></i> Export
            </button>
        </div>
    </div>

    <!-- Supplier KPI Workspace -->
    @{
        var activePOs = Model.Where(p => p.Status != "Completed" && p.Status != "Rejected" && p.Status != "Cancelled");
        var totalReceivable = activePOs.Sum(p => p.TotalAmount);
        var pendingDispatch = activePOs.Count(p => p.Status == "Issued" || p.Status == "Accepted" || p.Status == "Picked" || p.Status == "Packed" || p.Status == "Ready Dispatch");
        var completionRate = Model.Any() ? (Model.Count(p => p.Status == "Delivered" || p.Status == "Completed") * 100 / Model.Count()) : 0;
    }
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-3 bg-white hover-lift dark-mode-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="bg-faint-green text-dark-green p-2 rounded-4 dark-mode-icon-bg">
                        <i class="fas fa-wallet fs-5"></i>
                    </div>
                    <span class="badge bg-soft-success text-success rounded-pill px-2 small fw-bold dark-mode-badge">+12%</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1 dark-mode-text">Total Receivables</label>
                <h5 class="fw-bold text-dark-green mb-0 dark-mode-text">@totalReceivable.ToString("N0") <span class="extra-small opacity-50 fw-normal">ETB</span></h5>
                <div class="progress mt-3 rounded-pill dark-mode-progress" style="height: 6px; background-color: rgba(0,0,0,0.05);">
                    <div class="progress-bar bg-dark-green rounded-pill" style="width: 85%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-3 bg-white hover-lift dark-mode-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="bg-faint-green text-dark-green p-2 rounded-4 dark-mode-icon-bg">
                        <i class="fas fa-truck-loading fs-5"></i>
                    </div>
                    <span class="badge bg-soft-info text-info rounded-pill px-2 small fw-bold dark-mode-badge">Live</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1 dark-mode-text">Active Pipeline</label>
                <h5 class="fw-bold text-dark-green mb-0 dark-mode-text">@activePOs.Count() <span class="extra-small opacity-50 fw-normal">POs</span></h5>
                <span class="extra-small text-dark-green fw-bold opacity-75 dark-mode-text">@pendingDispatch Pending Dispatch</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-3 bg-white hover-lift dark-mode-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="bg-faint-green text-dark-green p-2 rounded-4 dark-mode-icon-bg">
                        <i class="fas fa-chart-line fs-5"></i>
                    </div>
                    <span class="badge bg-soft-warning text-warning rounded-pill px-2 small fw-bold dark-mode-badge">OTIF</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1 dark-mode-text">Fulfillment Health</label>
                <h5 class="fw-bold text-dark-green mb-0 dark-mode-text">@completionRate%</h5>
                <span class="extra-small text-muted opacity-75 fw-bold dark-mode-text">On-Time Completion</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-3 bg-dark-green text-white shadow-lg hover-lift dark-mode-dark-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="bg-white bg-opacity-10 text-accent-green p-2 rounded-4">
                        <i class="fas fa-shield-alt fs-5"></i>
                    </div>
                    <span class="badge bg-accent-green text-dark-green rounded-pill px-2 small fw-bold">SECURE</span>
                </div>
                <label class="extra-small text-white-50 text-uppercase fw-bold ls-1 d-block mb-1">Guaranteed Escrow</label>
                <h5 class="fw-bold mb-0 text-accent-green">@Model.Where(p => p.PaymentStatus == "Escrow").Sum(p => p.TotalAmount).ToString("N0")</h5>
                <span class="extra-small opacity-50 fw-bold">Risk-Free Revenue</span>
            </div>
        </div>
    </div>

    <!-- PO Workspace Pipeline -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white dark-mode-card">
        <div class="card-header bg-white py-3 px-4 border-0 dark-mode-header">
            <div class="row align-items-center">
                <div class="col">
                    <h6 class="fw-bold text-dark-green mb-0 dark-mode-text text-uppercase ls-1">Order Workflow Pipeline</h6>
                </div>
            </div>
        </div>
        <div class="table-responsive px-3 pb-3 dark-mode-table-wrapper">
            <table class="table table-hover align-middle mb-0 custom-nexus-table dark-mode-table">
                <thead>
                    <tr class="extra-small text-muted text-uppercase ls-1 dark-mode-thead">
                        <th class="ps-4 dark-mode-text">Order Identification</th>
                        <th class="dark-mode-text">Client / Merchant</th>
                        <th class="dark-mode-text">Money Value</th>
                        <th class="text-center dark-mode-text">Assigned Node</th>
                        <th class="text-center dark-mode-text">Workflow Status</th>
                        <th class="text-end pe-4 dark-mode-text">Operations</th>
                    </tr>
                </thead>
                <tbody class="dark-mode-tbody">
                    @foreach (var po in Model.OrderByDescending(p => p.CreatedAt))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-faint-green text-dark-green rounded-4 p-2 me-2 shadow-sm dark-mode-icon-bg">
                                        <i class="fas fa-file-invoice fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark-green mb-0 dark-mode-text">#@po.PONumber</div>
                                        <div class="extra-small text-muted fw-bold dark-mode-text">Issued: @po.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark-green mb-0 dark-mode-text">@po.Retailer?.BusinessName</div>
                                <div class="extra-small text-muted fw-bold dark-mode-text"><i class="fas fa-map-marker-alt me-1"></i> @po.Retailer?.City</div>
                             </td>
                            <td>
                                <div class="fw-bold text-dark-green mb-0 dark-mode-text">@po.TotalAmount.ToString("N2") <span class="extra-small opacity-50">ETB</span></div>
                                <div class="extra-small text-muted fw-bold dark-mode-text">@po.PurchaseOrderItems?.Count() Items in Parcel</div>
                             </td>
                            <td class="text-center">
                                @if(po.Warehouse != null) {
                                    <span class="badge bg-faint-green text-dark-green rounded-pill px-3 py-2 fw-bold small dark-mode-warehouse-badge">
                                        <i class="fas fa-warehouse me-2 opacity-50"></i>@po.Warehouse.Name
                                    </span>
                                } else {
                                    <span class="badge bg-soft-secondary text-secondary border rounded-pill px-3 py-2 fw-bold extra-small dark-mode-unassigned">UNASSIGNED</span>
                                }
                             </td>
                            <td class="text-center">
                                <span class="status-badge @GetPOStatusClass(po.Status) dark-mode-status">@po.Status</span>
                             </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-faint-green text-dark-green rounded-pill px-4 fw-bold shadow-sm py-2 dark-mode-action-btn">
                                    Workspace <i class="fas fa-arrow-right ms-2 opacity-50"></i>
                                </a>
                             </td>
                         </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="bg-faint-green rounded-5 p-5 border-dashed-custom dark-mode-empty-state">
                                    <i class="fas fa-inbox fa-4x text-dark-green opacity-10 mb-4"></i>
                                    <h5 class="fw-bold text-dark-green dark-mode-text">No Orders Pipeline</h5>
                                    <p class="text-muted small mb-0 dark-mode-text">Your fulfillment stream is currently empty.</p>
                                </div>
                             </td>
                         </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-4 px-5 dark-mode-footer">
                <nav>
                    <ul class="pagination pagination-premium justify-content-center gap-3 mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle border-0 d-flex align-items-center justify-content-center shadow-sm @(i == ViewBag.CurrentPage ? "bg-dark-green text-white" : "bg-white text-dark-green dark-mode-page-link")" 
                                   style="width: 45px; height: 45px;"
                                   asp-action="SupplierIndex" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string GetPOStatusClass(string status)
    {
        return status switch
        {
            "Delivered" or "Completed" => "bg-soft-success text-success",
            "In Transit" => "bg-soft-primary text-primary",
            "Processing" or "Accepted" or "Picking" or "Packed" => "bg-soft-info text-info",
            "Issued" => "bg-soft-warning text-warning",
            "Rejected" or "Cancelled" or "Expired" => "bg-soft-danger text-danger",
            _ => "bg-soft-secondary text-secondary"
        };
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .fulfillment-pipeline-container {
            zoom: 0.92;
            max-width: 1450px;
            margin: auto;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 10px;
            font-size: 0.6rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1); }
        .bg-soft-secondary { background-color: rgba(0, 0, 0, 0.05); }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .nexus-filter-btn { border: none; transition: all 0.3s ease; }
        .nexus-filter-btn.active { background-color: var(--dark-green) !important; color: var(--accent-green) !important; }

        .custom-nexus-table thead th { border-bottom: none; padding: 12px 0; }
        .custom-nexus-table tbody td { padding: 12px 0; border-bottom: 1px solid rgba(0,0,0,0.02); }
        .custom-nexus-table tbody tr:last-child td { border-bottom: none; }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
        
        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-white:hover { background-color: var(--faint-green); }

        /* ============================================ */
        /* DARK MODE STYLES */
        /* ============================================ */
        body.dark-mode .dark-mode-text {
            color: #e2e8f0 !important;
        }

        body.dark-mode .dark-mode-card {
            background-color: #1e2a3a !important;
            border-color: #334155 !important;
        }

        body.dark-mode .dark-mode-dark-card {
            background-color: #0f2c24 !important;
        }

        body.dark-mode .dark-mode-header {
            background-color: #1e2a3a !important;
            border-bottom-color: #334155 !important;
        }

        body.dark-mode .dark-mode-footer {
            background-color: #1e2a3a !important;
            border-top-color: #334155 !important;
        }

        body.dark-mode .dark-mode-input {
            background-color: #334155 !important;
            color: #e2e8f0 !important;
        }

        body.dark-mode .dark-mode-input::placeholder {
            color: #94a3b8 !important;
        }

        body.dark-mode .dark-mode-btn {
            background-color: #334155 !important;
            color: #e2e8f0 !important;
            border-color: #475569 !important;
        }

        body.dark-mode .dark-mode-btn i {
            color: #a5f3c3 !important;
        }

        body.dark-mode .dark-mode-icon-bg {
            background-color: #334155 !important;
            color: #a5f3c3 !important;
        }

        body.dark-mode .dark-mode-badge {
            background-color: rgba(74, 222, 128, 0.15) !important;
            color: #4ade80 !important;
        }

        body.dark-mode .dark-mode-progress {
            background-color: #334155 !important;
        }

        /* Table dark mode styles */
        body.dark-mode .dark-mode-table {
            background-color: #1e2a3a !important;
        }

        body.dark-mode .dark-mode-thead th {
            color: #cbd5e1 !important;
            background-color: transparent !important;
        }

        body.dark-mode .dark-mode-tbody tr {
            border-bottom-color: #334155 !important;
        }

        body.dark-mode .dark-mode-tbody tr:hover {
            background-color: #2d3a4a !important;
        }

        body.dark-mode .dark-mode-tbody td {
            color: #e2e8f0 !important;
            background-color: transparent !important;
        }

        /* Badge dark mode overrides */
        body.dark-mode .status-badge.bg-soft-success {
            background-color: rgba(74, 222, 128, 0.15) !important;
            color: #4ade80 !important;
        }

        body.dark-mode .status-badge.bg-soft-warning {
            background-color: rgba(251, 191, 36, 0.15) !important;
            color: #fbbf24 !important;
        }

        body.dark-mode .status-badge.bg-soft-info {
            background-color: rgba(13, 202, 240, 0.15) !important;
            color: #67e8f9 !important;
        }

        body.dark-mode .status-badge.bg-soft-primary {
            background-color: rgba(37, 99, 235, 0.15) !important;
            color: #93c5fd !important;
        }

        body.dark-mode .status-badge.bg-soft-danger {
            background-color: rgba(248, 113, 113, 0.15) !important;
            color: #f87171 !important;
        }

        body.dark-mode .status-badge.bg-soft-secondary {
            background-color: rgba(100, 116, 139, 0.3) !important;
            color: #cbd5e1 !important;
        }

        /* Warehouse badge dark mode */
        body.dark-mode .dark-mode-warehouse-badge {
            background-color: #334155 !important;
            color: #a5f3c3 !important;
        }

        body.dark-mode .dark-mode-unassigned {
            background-color: rgba(100, 116, 139, 0.2) !important;
            color: #94a3b8 !important;
        }

        /* Action button dark mode */
        body.dark-mode .dark-mode-action-btn {
            background-color: #334155 !important;
            color: #a5f3c3 !important;
        }

        /* Empty state dark mode */
        body.dark-mode .dark-mode-empty-state {
            background-color: #334155 !important;
            border-color: #475569 !important;
        }

        /* Pagination dark mode */
        body.dark-mode .dark-mode-page-link {
            background-color: #334155 !important;
            color: #e2e8f0 !important;
        }

        body.dark-mode .page-item.active .dark-mode-page-link {
            background-color: var(--dark-green) !important;
            color: #a5f3c3 !important;
        }

        /* Table wrapper */
        body.dark-mode .dark-mode-table-wrapper {
            background-color: #1e2a3a !important;
        }

        /* Border colors */
        body.dark-mode .custom-nexus-table tbody td {
            border-bottom-color: #334155 !important;
        }
    </style>
}