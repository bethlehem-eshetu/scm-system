@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "SCM Fulfillment Pipeline";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-file-invoice-dollar me-2 text-accent-green"></i>Fulfillment Pipeline
            </h1>
            <p class="text-muted small mb-0 mt-1">Manage incoming purchase orders, dispatch logistics, and track financial settlements.</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="search-bar-premium position-relative">
                <form asp-action="SupplierIndex" method="get" class="d-flex w-100">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="searchTerm" class="form-control border-0 bg-white rounded-pill ps-5 shadow-sm" placeholder="Search PO# or Client..." value="@ViewBag.SearchTerm" style="width: 280px; height: 45px;">
                </form>
            </div>
            <button class="btn btn-white rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
                <i class="fas fa-file-export me-2 text-dark-green"></i> Export
            </button>
        </div>
    </div>

    <!-- Supplier KPI Workspace -->
    @{
        var activePOs = Model.Where(p => p.Status != "Completed" && p.Status != "Rejected" && p.Status != "Cancelled");
        var totalReceivable = activePOs.Sum(p => p.TotalAmount);
        var pendingDispatch = activePOs.Count(p => p.Status == "Issued" || p.Status == "Accepted" || p.Status == "Picked" || p.Status == "Packed" || p.Status == "Ready Dispatch");
        var completionRate = Model.Any() ? (Model.Count(p => p.Status == "Delivered" || p.Status == "Completed") * 100 / Model.Count()) : 0;
    }
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-faint-green text-dark-green p-3 rounded-4">
                        <i class="fas fa-wallet fs-4"></i>
                    </div>
                    <span class="badge bg-soft-success text-success rounded-pill px-2 small fw-bold">+12%</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1">Total Receivables</label>
                <h3 class="fw-bold text-dark-green mb-0">@totalReceivable.ToString("N0") <span class="extra-small opacity-50 fw-normal">ETB</span></h3>
                <div class="progress mt-3 rounded-pill" style="height: 6px; background-color: rgba(0,0,0,0.05);">
                    <div class="progress-bar bg-dark-green rounded-pill" style="width: 85%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-faint-green text-dark-green p-3 rounded-4">
                        <i class="fas fa-truck-loading fs-4"></i>
                    </div>
                    <span class="badge bg-soft-info text-info rounded-pill px-2 small fw-bold">Live</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1">Active Pipeline</label>
                <h3 class="fw-bold text-dark-green mb-0">@activePOs.Count() <span class="extra-small opacity-50 fw-normal">POs</span></h3>
                <span class="extra-small text-dark-green fw-bold opacity-75">@pendingDispatch Pending Dispatch</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-faint-green text-dark-green p-3 rounded-4">
                        <i class="fas fa-chart-line fs-4"></i>
                    </div>
                    <span class="badge bg-soft-warning text-warning rounded-pill px-2 small fw-bold">OTIF</span>
                </div>
                <label class="extra-small text-muted text-uppercase fw-bold ls-1 d-block mb-1">Fulfillment Health</label>
                <h3 class="fw-bold text-dark-green mb-0">@completionRate%</h3>
                <span class="extra-small text-muted opacity-75 fw-bold">On-Time Completion</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-dark-green text-white shadow-lg hover-lift">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-white bg-opacity-10 text-accent-green p-3 rounded-4">
                        <i class="fas fa-shield-alt fs-4"></i>
                    </div>
                    <span class="badge bg-accent-green text-dark-green rounded-pill px-2 small fw-bold">SECURE</span>
                </div>
                <label class="extra-small text-white-50 text-uppercase fw-bold ls-1 d-block mb-1">Guaranteed Escrow</label>
                <h3 class="fw-bold mb-0 text-accent-green">@Model.Where(p => p.PaymentStatus == "Escrow").Sum(p => p.TotalAmount).ToString("N0")</h3>
                <span class="extra-small opacity-50 fw-bold">Risk-Free Revenue</span>
            </div>
        </div>
    </div>

    <!-- PO Workspace Pipeline -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
        <div class="card-header bg-white py-4 px-5 border-0">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="fw-bold text-dark-green mb-0">Order Workflow Intelligence</h5>
                </div>
                <div class="col-auto">
                    <div class="btn-group p-1 bg-faint-green rounded-pill">
                        <button class="btn btn-white nexus-filter-btn active rounded-pill px-4 py-2 small fw-bold">Active Stream</button>
                        <button class="btn btn-white nexus-filter-btn rounded-pill px-4 py-2 small fw-bold">Historical</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive px-4 pb-4">
            <table class="table table-hover align-middle mb-0 custom-nexus-table">
                <thead>
                    <tr class="extra-small text-muted text-uppercase ls-1">
                        <th class="ps-4">Order Identification</th>
                        <th>Client / Merchant</th>
                        <th>Fiscal Value</th>
                        <th class="text-center">Assigned Node</th>
                        <th class="text-center">Workflow Status</th>
                        <th class="text-end pe-4">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in Model.OrderByDescending(p => p.CreatedAt))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-faint-green text-dark-green rounded-4 p-3 me-3 shadow-sm">
                                        <i class="fas fa-file-invoice fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark-green mb-0">#@po.PONumber</div>
                                        <div class="extra-small text-muted fw-bold">Issued: @po.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark-green mb-0">@po.Retailer?.BusinessName</div>
                                <div class="extra-small text-muted fw-bold"><i class="fas fa-map-marker-alt me-1"></i> @po.Retailer?.City</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark-green mb-0">@po.TotalAmount.ToString("N2") <span class="extra-small opacity-50">ETB</span></div>
                                <div class="extra-small text-muted fw-bold">@po.PurchaseOrderItems?.Count() Items in Parcel</div>
                            </td>
                            <td class="text-center">
                                @if(po.Warehouse != null) {
                                    <span class="badge bg-faint-green text-dark-green rounded-pill px-3 py-2 fw-bold small">
                                        <i class="fas fa-warehouse me-2 opacity-50"></i>@po.Warehouse.Name
                                    </span>
                                } else {
                                    <span class="badge bg-soft-secondary text-secondary border rounded-pill px-3 py-2 fw-bold extra-small">UNASSIGNED</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="status-badge @GetPOStatusClass(po.Status)">@po.Status</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-faint-green text-dark-green rounded-pill px-4 fw-bold shadow-sm py-2">
                                    Workspace <i class="fas fa-arrow-right ms-2 opacity-50"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="bg-faint-green rounded-5 p-5 border-dashed-custom">
                                    <i class="fas fa-inbox fa-4x text-dark-green opacity-10 mb-4"></i>
                                    <h5 class="fw-bold text-dark-green">No Orders Pipeline</h5>
                                    <p class="text-muted small mb-0">Your fulfillment stream is currently empty.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-4 px-5">
                <nav>
                    <ul class="pagination pagination-premium justify-content-center gap-3 mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle border-0 d-flex align-items-center justify-content-center shadow-sm @(i == ViewBag.CurrentPage ? "bg-dark-green text-white" : "bg-white text-dark-green")" 
                                   style="width: 45px; height: 45px;"
                                   asp-action="SupplierIndex" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string GetPOStatusClass(string status)
    {
        return status switch
        {
            "Delivered" or "Completed" => "bg-soft-success text-success",
            "In Transit" => "bg-soft-primary text-primary",
            "Processing" or "Accepted" or "Picking" or "Packed" => "bg-soft-info text-info",
            "Issued" => "bg-soft-warning text-warning",
            "Rejected" or "Cancelled" or "Expired" => "bg-soft-danger text-danger",
            _ => "bg-soft-secondary text-secondary"
        };
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .status-badge {
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1); }
        .bg-soft-secondary { background-color: rgba(0, 0, 0, 0.05); }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .nexus-filter-btn { border: none; transition: all 0.3s ease; }
        .nexus-filter-btn.active { background-color: var(--dark-green) !important; color: var(--accent-green) !important; }

        .custom-nexus-table thead th { border-bottom: none; padding: 20px 0; }
        .custom-nexus-table tbody td { padding: 24px 0; border-bottom: 1px solid rgba(0,0,0,0.02); }
        .custom-nexus-table tbody tr:last-child td { border-bottom: none; }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
        
        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-white:hover { background-color: var(--faint-green); }
    </style>
}
