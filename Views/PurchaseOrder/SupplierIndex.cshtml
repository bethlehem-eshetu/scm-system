@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Supplier Fulfillment Hub";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-file-invoice-dollar text-success me-2"></i>Fulfillment Hub</h2>
            <p class="text-muted mb-0 small">Manage incoming orders, dispatch shipments, and track inventory velocity.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="input-group shadow-sm" style="width: 300px;">
                <form asp-action="SupplierIndex" method="get" class="d-flex w-100">
                    <input type="text" name="searchTerm" class="form-control border-0 rounded-start-pill px-3" placeholder="Search PO# or Client..." value="@ViewBag.SearchTerm">
                    <button type="submit" class="btn btn-white bg-white border-0 rounded-end-pill"><i class="fas fa-search text-muted"></i></button>
                </form>
            </div>
            <button class="btn btn-white border rounded-pill px-3 shadow-sm bg-white">
                <i class="fas fa-download me-2"></i> Export
            </button>
        </div>
    </div>

    <!-- Supplier KPI Bar -->
    @{
        var activePOs = Model.Where(p => p.Status != "Completed" && p.Status != "Rejected" && p.Status != "Cancelled");
        var totalReceivable = activePOs.Sum(p => p.TotalAmount);
        var pendingDispatch = activePOs.Count(p => p.Status == "Issued" || p.Status == "Accepted" || p.Status == "Picked" || p.Status == "Packed" || p.Status == "Ready Dispatch");
        var completionRate = Model.Any() ? (Model.Count(p => p.Status == "Delivered" || p.Status == "Completed") * 100 / Model.Count()) : 0;
    }
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-success">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Total Receivables</label>
                <h3 class="fw-bold text-dark mb-0">@totalReceivable.ToString("N0") <span class="smaller font-normal">ETB</span></h3>
                <div class="progress mt-2" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 85%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-primary">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Orders in Queue</label>
                <h3 class="fw-bold text-dark mb-0">@activePOs.Count() <span class="smaller font-normal">POs</span></h3>
                <span class="smaller text-primary fw-bold">@pendingDispatch Pending Dispatch</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-info">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Operations Health</label>
                <h3 class="fw-bold text-info mb-0">@completionRate%</h3>
                <span class="smaller text-muted">OTIF Fulfillment Rate</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white shadow">
                <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-1">Secured in Escrow</label>
                <h3 class="fw-bold mb-0">@Model.Where(p => p.PaymentStatus == "Escrow").Sum(p => p.TotalAmount).ToString("N0")</h3>
                <span class="smaller opacity-75">Guaranteed Revenue</span>
            </div>
        </div>
    </div>

    <!-- PO Workspace -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 border-light">
                    <div class="row align-items-center">
                        <div class="col">
                            <h6 class="fw-bold mb-0">Order Workflow Pipeline</h6>
                        </div>
                        <div class="col-auto">
                            <div class="btn-group btn-group-sm rounded-pill overflow-hidden border">
                                <button class="btn btn-light active px-3">Active</button>
                                <button class="btn btn-light px-3">Completed</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="smaller text-muted text-uppercase">
                                <th class="ps-4">Order Ref</th>
                                <th>Retailer Client</th>
                                <th>Value & Items</th>
                                <th class="text-center">Fulfillment Hub</th>
                                <th class="text-center">Workflow Stage</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in Model.OrderByDescending(p => p.CreatedAt))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-3 p-2 me-3 text-success">
                                                <i class="fas fa-file-invoice"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark mb-0">#@po.PONumber</div>
                                                <div class="smaller text-muted">Issued: @po.CreatedAt.ToString("MMM dd, yyyy")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@po.Retailer?.BusinessName</div>
                                        <div class="smaller text-muted"><i class="fas fa-map-marker-alt me-1"></i> @po.Retailer?.City</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@po.TotalAmount.ToString("N2") ETB</div>
                                        <div class="smaller text-muted">@po.PurchaseOrderItems?.Count() Line Items</div>
                                    </td>
                                    <td class="text-center">
                                        @if(po.Warehouse != null) {
                                            <div class="fw-bold smaller text-dark">@po.Warehouse.Name</div>
                                            <div class="extra-small text-muted">@po.Warehouse.City</div>
                                        } else {
                                            <span class="badge bg-light text-muted border rounded-pill px-3">Unassigned</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GetPOStatusClass(po.Status) rounded-pill px-3 py-2">@po.Status</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm fw-bold">
                                            Workspace <i class="fas fa-chevron-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="opacity-25 mb-3">
                                            <i class="fas fa-inbox fa-4x"></i>
                                        </div>
                                        <h5 class="fw-bold text-muted">No Orders Found</h5>
                                        <p class="text-muted small">You don't have any purchase orders in your pipeline right now.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination Footer -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top border-light py-3">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link rounded-circle mx-1 border-0 @(i == ViewBag.CurrentPage ? "bg-primary text-white" : "text-dark bg-light")" 
                                           asp-action="SupplierIndex" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetPOStatusClass(string status)
    {
        return status switch
        {
            "Delivered" or "Completed" => "bg-success text-white shadow-sm",
            "In Transit" => "bg-primary text-white shadow-sm",
            "Processing" or "Accepted" or "Picking" or "Packed" => "bg-info text-white shadow-sm",
            "Issued" => "bg-warning text-dark shadow-sm",
            "Rejected" or "Cancelled" or "Expired" => "bg-danger text-white shadow-sm",
            _ => "bg-secondary text-white shadow-sm"
        };
    }
}

<style>
    .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .font-normal { font-weight: 400; }
    .btn-white { background: white; }
    .bg-glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); }
</style>
