@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Received Purchase Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <h2>Received Purchase Orders</h2>
    <table class="table table-bordered table-hover mt-3 bg-white shadow-sm rounded">
        <thead class="table-dark">
            <tr>
                <th>PO Number</th>
                <th>Retailer</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var po in Model) {
            <tr>
                <td class="fw-bold">@po.PONumber</td>
                <td>@po.Retailer?.BusinessName</td>
                <td class="text-success fw-bold">@po.TotalAmount.ToString("C")</td>
                <td>
                    <span class="badge p-2 @(po.Status == "Pending" ? "bg-warning text-dark" : (po.Status == "Accepted" ? "bg-success" : "bg-danger"))">@po.Status</span>
                </td>
                <td>@po.OrderDate.ToString("MMM dd, yyyy")</td>
                <td><a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-primary">View Details</a></td>
            </tr>
        }
        @if(!Model.Any()) {
            <tr><td colspan="6" class="text-center">No purchase orders received yet.</td></tr>
        }
        </tbody>
    </table>
</div>
