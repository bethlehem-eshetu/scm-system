@using SCM_System.Models.Entities
@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "My Purchase Orders";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-file-invoice text-primary me-2"></i>My Purchase Orders 
        </h1>
        <a asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-shopping-cart me-2"></i> Continue Shopping
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">PO Number</th>
                            <th>Supplier</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Payment Status</th>
                            <th>Order Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in Model)
                        {
                            var needsPayment = po.Status == "Delivered" && po.Commission != null && po.Commission.Status == "Pending" && po.PaymentStatus != "Paid";
                            var isPaid = (po.Commission != null && po.Commission.Status == "Paid") || po.PaymentStatus == "Paid";
                            

                            // Check if already rated
                            var hasRated = po.Rating != null;
                            
                            // Check if return request already exists (safe null check)
                            var hasReturnRequest = po.ReturnRequests != null && po.ReturnRequests.Any(r => r.Status != ReturnStatus.Cancelled);
                            
                            <tr>
                                <td class="ps-4 fw-bold">@po.PONumber</td>
                                <td>@po.Supplier?.CompanyName</td>
                                <td class="fw-bold">@po.TotalAmount.ToString("C")</td>
                                <td>
                                    @if (po.Status == "Delivered")
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Delivered</span>
                                    }
                                    else if (po.Status == "In Transit")
                                    {
                                        <span class="badge bg-primary rounded-pill px-3">In Transit</span>
                                    }
                                    else if (po.Status == "Processing")
                                    {
                                        <span class="badge bg-info rounded-pill px-3">Processing</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3">@po.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (needsPayment)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">
                                            <i class="fas fa-exclamation-triangle me-1"></i>Payment Required
                                        </span>
                                    }
                                    else if (isPaid)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">
                                            <i class="fas fa-check-circle me-1"></i>Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3">Pending</span>
                                    }
                                </td>
                                <td>@po.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        @if (needsPayment && po.Commission != null)
                                        {
                                            <form asp-controller="Payment" asp-action="InitializePayment" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="commissionId" value="@po.Commission.Id" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                    <i class="fas fa-credit-card me-1"></i> Pay Now
                                                </button>
                                            </form>
                                        }

                                        @if (po.Status == "Delivered" && !hasReturnRequest)
                                        {
                                            <a asp-controller="Return" asp-action="Create" asp-route-purchaseOrderId="@po.Id"
                                                   class="btn btn-sm btn-warning rounded-pill px-3">
                                                <i class="fas fa-undo-alt me-1"></i> Request Return
                                            </a>
                                        }
                                        
                                        @if (po.Status == "Delivered" && !hasRated)
                                        {
                                            <a asp-controller="Rating" asp-action="RateOrder" asp-route-purchaseOrderId="@po.Id"
                                                   class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="fas fa-star me-1"></i> Rate Order
                                            </a>
                                        }
                                        
                                        @if (hasRated)
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="fas fa-check me-1"></i> Rated
                                            </span>
                                        }
                                        
                                        @if (hasReturnRequest)
                                        {
                                            <span class="badge bg-info rounded-pill px-3 py-2">
                                                <i class="fas fa-undo-alt me-1"></i> Return Requested
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>