@using SCM_System.Models.Entities
@model IEnumerable<SCM_System.Models.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "Procurement Control Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-file-contract text-success me-2"></i>Procurement Control</h2>
            <p class="text-muted mb-0 small">Manage commercial commitments, escrow payments, and fulfillment health.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="search-input-wrapper shadow-sm" style="width: 300px;">
                <i class="fas fa-search text-muted"></i>
                <input type="text" id="poSearch" class="form-control page-search-input border-0 rounded-pill" placeholder="Live search POs..." value="@ViewBag.SearchTerm">
            </div>
            <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-shopping-basket me-2"></i> New
            </a>
        </div>
    </div>

    <!-- Executive KPI Bar -->
    @{
        var activePOs = Model.Where(p => p.Status != "Completed" && p.Status != "Rejected" && p.Status != "Cancelled");
        var committedCapital = activePOs.Sum(p => p.TotalAmount);
        var pendingFulfillment = activePOs.Count(p => p.Status != "Delivered");
        var healthRate = Model.Any() ? (Model.Count(p => p.Status == "Delivered" || p.Status == "Completed") * 100 / Model.Count()) : 0;
    }
    <div class="row g-4 mb-5 procurement-card">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-success">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Committed Capital</label>
                <h3 class="fw-bold text-dark mb-0">@committedCapital.ToString("N0") <span class="smaller font-normal">ETB</span></h3>
                <div class="progress mt-2" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 70%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-warning">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">In Pipeline</label>
                <h3 class="fw-bold text-dark mb-0">@activePOs.Count() <span class="smaller font-normal">POs</span></h3>
                <span class="smaller text-warning fw-bold">@pendingFulfillment Pending Delivery</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-success">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Fulfillment Health</label>
                <h3 class="fw-bold text-success mb-0">@healthRate%</h3>
                <span class="smaller text-muted">Successful Completions</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white shadow">
                <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-1">Escrow Balance</label>
                <h3 class="fw-bold mb-0">@Model.Where(p => p.PaymentStatus == "Escrow").Sum(p => p.TotalAmount).ToString("N0")</h3>
                <span class="smaller opacity-75">Secured Commitments</span>
            </div>
        </div>
    </div>

    <!-- PO Workspace -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 border-light">
                    <div class="row align-items-center">
                        <div class="col">
                            <h6 class="fw-bold mb-0">Commercial Registry</h6>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="poTable">
                        <thead class="bg-light">
                            <tr class="smaller text-muted text-uppercase">
                                <th class="ps-4">Document ID</th>
                                <th>Supplier & Terms</th>
                                <th>Financials</th>
                                <th class="text-center">Lifecycle Status</th>
                                <th class="text-center">Escrow / Pay</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in Model.OrderByDescending(p => p.CreatedAt))
                            {
                                var needsPayment = po.Status == "Delivered" && po.Commission != null && po.Commission.Status == "Pending" && po.PaymentStatus != "Paid";
                                var isPaid = (po.Commission != null && po.Commission.Status == "Paid") || po.PaymentStatus == "Paid";

                                <tr class="po-row">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark mb-0 po-number">#@po.PONumber</div>
                                        <div class="smaller text-muted">Issued: @po.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark supplier-name">@po.Supplier?.CompanyName</div>
                                        <div class="smaller text-muted"><i class="fas fa-truck-loading me-1"></i> Delivery to @po.DeliveryAddress</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success">@po.TotalAmount.ToString("N2") ETB</div>
                                        <div class="smaller text-muted">@po.PurchaseOrderItems?.Count() Items</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GetPOStatusClass(po.Status) rounded-pill px-3 py-2">@po.Status</span>
                                    </td>
                                    <td class="text-center">
                                        @if (po.PaymentStatus == "Escrow")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info rounded-pill px-3">
                                                <i class="fas fa-shield-alt me-1"></i> In Escrow
                                            </span>
                                        }
                                        else if (isPaid)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3">
                                                <i class="fas fa-check-double me-1"></i> Disbursed
                                            </span>
                                        }
                                        else if (needsPayment)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 animate-pulse">
                                                <i class="fas fa-exclamation-circle me-1"></i> Action Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-3">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm fw-bold">
                                                Workspace <i class="fas fa-chevron-right ms-1"></i>
                                            </a>
                                            @if (po.Status == "Delivered" || po.Status == "Completed")
                                            {
                                                <a asp-controller="Return" asp-action="Create" asp-route-purchaseOrderId="@po.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm fw-bold">
                                                    <i class="fas fa-undo me-1"></i> Return
                                                </a>
                                            }
                                            @if (needsPayment && po.Commission != null)
                                            {
                                                <form asp-controller="Payment" asp-action="InitializePayment" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="commissionId" value="@po.Commission.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm fw-bold">
                                                        Disburse Funds
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination Footer -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top border-light py-3" id="paginationFooter">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link rounded-circle mx-1 border-0 @(i == ViewBag.CurrentPage ? "bg-success text-white" : "text-dark bg-light")" 
                                           asp-action="RetailerIndex" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetPOStatusClass(string status)
    {
        return status switch
        {
            "Delivered" => "bg-success text-white shadow-sm",
            "In Transit" => "bg-success text-white shadow-sm", // Changed from primary
            "Processing" => "bg-info text-white shadow-sm",
            "Accepted" => "bg-success text-white shadow-sm opacity-75", // Changed from indigo
            "Issued" => "bg-warning text-dark shadow-sm",
            "Rejected" => "bg-danger text-white shadow-sm",
            _ => "bg-secondary text-white shadow-sm"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#poSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#poTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
                
                // Hide pagination if searching
                if(value.length > 0) {
                    $("#paginationFooter").hide();
                } else {
                    $("#paginationFooter").show();
                }
            });
        });
    </script>
}

<style>
    .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.5px; }
    .font-normal { font-weight: 400; }
    .bg-indigo { background-color: #6610f2; }
    .bg-success-subtle { background-color: #e9f7ef; }
    .bg-info-subtle { background-color: #eaf2f8; }
    .bg-danger-subtle { background-color: #fceae9; }
    .btn-white { background: white; }
    .animate-pulse { animation: pulse 2s infinite; }
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }
    .search-input-wrapper {
        position: relative;
    }
    .search-input-wrapper i {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
    }
    .page-search-input {
        padding-left: 35px !important;
    }

    /* Force card text to be dark in light mode, white in dark mode */
    .procurement-card .card label,
    .procurement-card .card h3,
    .procurement-card .card span {
        color: #212529 !important;
    }
    
    body.dark-mode .procurement-card .card label,
    body.dark-mode .procurement-card .card h3,
    body.dark-mode .procurement-card .card span {
        color: #ffffff !important;
    }

    /* Specific overrides for color-coded text */
    .procurement-card .card h3.text-success { color: #198754 !important; }
    body.dark-mode .procurement-card .card h3.text-success { color: #4ade80 !important; }
    
    .procurement-card .card .text-warning { color: #ffc107 !important; }
    body.dark-mode .procurement-card .card .text-warning { color: #fbbf24 !important; }
</style>