@model SCM_System.Models.Entities.InventoryTransfer
@{
    ViewData["Title"] = "Request Stock Movement";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="InventoryTransfers">Inventory Transfers</a></li>
                    <li class="breadcrumb-item active">New Request</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-primary mb-0"><i class="fas fa-truck-loading me-2"></i>Initiate Stock Transfer</h2>
        </div>
        <a asp-action="InventoryTransfers" class="btn btn-outline-secondary rounded-pill px-4 border shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Cancel
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <form asp-action="CreateTransfer" method="post" id="transferForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 border-0 shadow-sm mb-4"></div>

                <!-- Step 1: Route Selection -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white p-4 border-bottom-0">
                        <h5 class="fw-bold mb-0"><i class="fas fa-map-marked-alt me-2 text-primary"></i>1. Movement Route</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="row g-4">
                            <div class="col-md-5">
                                <label asp-for="SourceWarehouseId" class="form-label text-muted small fw-bold text-uppercase">Source Hub</label>
                                <select asp-for="SourceWarehouseId" asp-items="ViewBag.Warehouses" class="form-select p-3 bg-light border-0 rounded-3 shadow-sm" required>
                                    <option value="">-- ORIGIN --</option>
                                </select>
                                <span asp-validation-for="SourceWarehouseId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-2 d-flex align-items-center justify-content-center pt-4">
                                <i class="fas fa-arrow-right fs-3 text-primary opacity-25"></i>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="DestinationWarehouseId" class="form-label text-muted small fw-bold text-uppercase">Destination Hub</label>
                                <select asp-for="DestinationWarehouseId" asp-items="ViewBag.Warehouses" class="form-select p-3 bg-light border-0 rounded-3 shadow-sm" required>
                                    <option value="">-- DESTINATION --</option>
                                </select>
                                <span asp-validation-for="DestinationWarehouseId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Item Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white p-4 border-bottom-0">
                        <h5 class="fw-bold mb-0"><i class="fas fa-box me-2 text-primary"></i>2. Item Selection</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="ProductId" class="form-label text-muted small fw-bold text-uppercase">Product SKU</label>
                                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select p-3 bg-light border-0 rounded-3 shadow-sm" required>
                                    <option value="">-- CHOOSE PRODUCT --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label text-muted small fw-bold text-uppercase">Transfer Quantity</label>
                                <input asp-for="Quantity" type="number" class="form-control p-3 bg-light border-0 rounded-3 shadow-sm" min="1" placeholder="0" required>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="alert alert-info border-0 rounded-3 w-100 mb-0 py-2 small shadow-sm">
                                    <i class="fas fa-info-circle me-1"></i> Stock availability will be verified upon submission.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Logistics Remarks -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white p-4 border-bottom-0">
                        <h5 class="fw-bold mb-0"><i class="fas fa-comment-alt me-2 text-primary"></i>3. Logistics Remarks</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <textarea asp-for="Remarks" class="form-control bg-light border-0 rounded-3 p-3 shadow-sm" rows="3" placeholder="Reason for movement, handling instructions, etc."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold shadow-lg">
                        <i class="fas fa-check-circle me-2"></i> Confirm Movement Request
                    </button>
                    <p class="text-center text-muted small mt-2">Request will require manager approval from the <strong>Source Hub</strong>.</p>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        box-shadow: 0 10px 15px -3px rgba(13, 110, 253, 0.1) !important;
        border: 1px solid rgba(13, 110, 253, 0.2) !important;
    }
</style>
