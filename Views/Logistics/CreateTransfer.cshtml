@model SCM_System.Models.Entities.InventoryTransfer
@{
    ViewData["Title"] = "Strategic Asset Rebalancing";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 extra-small fw-bold text-uppercase ls-1">
                    <li class="breadcrumb-item"><a asp-action="InventoryTransfers" class="text-dark-green opacity-50 text-decoration-none">Asset Movements</a></li>
                    <li class="breadcrumb-item active text-dark-green" aria-current="page">Initiate Rebalancing</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-truck-loading me-2 text-accent-green"></i>Initiate Stock Transfer
            </h1>
            <p class="text-muted small mb-0 mt-1">Configure cross-hub inventory relocation to optimize regional stock availability.</p>
        </div>
        <a asp-action="InventoryTransfers" class="btn btn-white rounded-pill px-4 py-2 shadow-sm fw-bold text-dark-green border">
            <i class="fas fa-arrow-left me-2"></i> Return to Pipeline
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <form asp-action="CreateTransfer" method="post" id="transferForm" class="animate-slide-up">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert bg-soft-danger text-danger border-0 rounded-5 shadow-premium mb-5 p-4 d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fs-4 me-3"></i>
                        <div asp-validation-summary="ModelOnly" class="fw-bold"></div>
                    </div>
                }

                <!-- Step 1: Route Intelligence -->
                <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden">
                    <div class="card-header bg-faint-green p-4 border-0">
                        <h5 class="fw-bold mb-0 text-dark-green"><i class="fas fa-map-marked-alt me-2 text-dark-green opacity-50"></i>1. Movement Route Configuration</h5>
                    </div>
                    <div class="card-body p-5">
                        <div class="row g-4 align-items-center">
                            <div class="col-md-5 text-center">
                                <div class="bg-faint-green rounded-circle p-4 mb-3 d-inline-flex mx-auto shadow-sm">
                                    <i class="fas fa-warehouse fs-3 text-dark-green"></i>
                                </div>
                                <label asp-for="SourceWarehouseId" class="form-label text-dark-green fw-bold extra-small text-uppercase ls-1 d-block mb-3">Origin Hub</label>
                                <select asp-for="SourceWarehouseId" asp-items="ViewBag.Warehouses" class="form-select nexus-input border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green shadow-sm" required>
                                    <option value="">-- SELECT ORIGIN --</option>
                                </select>
                                <span asp-validation-for="SourceWarehouseId" class="text-danger extra-small fw-bold mt-2 d-block"></span>
                            </div>
                            <div class="col-md-2 text-center py-4">
                                <div class="bg-dark-green text-accent-green rounded-circle p-3 d-inline-flex shadow-premium animate-pulse">
                                    <i class="fas fa-arrow-right fs-4"></i>
                                </div>
                            </div>
                            <div class="col-md-5 text-center">
                                <div class="bg-dark-green text-accent-green rounded-circle p-4 mb-3 d-inline-flex mx-auto shadow-sm">
                                    <i class="fas fa-warehouse fs-3"></i>
                                </div>
                                <label asp-for="DestinationWarehouseId" class="form-label text-dark-green fw-bold extra-small text-uppercase ls-1 d-block mb-3">Target Hub</label>
                                <select asp-for="DestinationWarehouseId" asp-items="ViewBag.Warehouses" class="form-select nexus-input border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green shadow-sm" required>
                                    <option value="">-- SELECT DESTINATION --</option>
                                </select>
                                <span asp-validation-for="DestinationWarehouseId" class="text-danger extra-small fw-bold mt-2 d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Asset Details -->
                <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden">
                    <div class="card-header bg-faint-green p-4 border-0">
                        <h5 class="fw-bold mb-0 text-dark-green"><i class="fas fa-box me-2 text-dark-green opacity-50"></i>2. Inventory Specification</h5>
                    </div>
                    <div class="card-body p-5">
                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="ProductId" class="form-label text-dark-green fw-bold extra-small text-uppercase ls-1 mb-2">Product SKU / Name</label>
                                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select nexus-input border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green shadow-sm" required>
                                    <option value="">-- SEARCH PRODUCT ENTITY --</option>
                                </select>
                                <span asp-validation-for="ProductId" class="text-danger extra-small fw-bold mt-2 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label text-dark-green fw-bold extra-small text-uppercase ls-1 mb-2">Unit Quantity</label>
                                <div class="input-group">
                                    <span class="input-group-text border-0 bg-faint-green text-dark-green opacity-50"><i class="fas fa-sort-numeric-up"></i></span>
                                    <input asp-for="Quantity" type="number" class="form-control nexus-input border-0 bg-faint-green py-3 fw-bold text-dark-green" min="1" placeholder="0" required>
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger extra-small fw-bold mt-2 d-block"></span>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="alert bg-soft-info text-info border-0 rounded-4 w-100 mb-0 py-3 px-4 extra-small fw-bold shadow-sm d-flex align-items-center">
                                    <i class="fas fa-shield-alt fs-5 me-3 opacity-50"></i>
                                    <div>AI-driven stock verification will validate hub capacity upon submission.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Contextual Remarks -->
                <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden">
                    <div class="card-header bg-faint-green p-4 border-0">
                        <h5 class="fw-bold mb-0 text-dark-green"><i class="fas fa-comment-alt-lines me-2 text-dark-green opacity-50"></i>3. Logistics Rationale</h5>
                    </div>
                    <div class="card-body p-5">
                        <textarea asp-for="Remarks" class="form-control nexus-input border-0 bg-faint-green rounded-4 p-4 fw-bold text-dark-green shadow-sm" rows="4" placeholder="Describe the strategic reason for this movement or specific handling protocols..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger extra-small fw-bold mt-2 d-block"></span>
                    </div>
                </div>

                <div class="d-grid gap-3 mb-5">
                    <button type="submit" class="btn btn-dark-green rounded-pill py-3 fw-bold shadow-premium ls-1">
                        <i class="fas fa-check-double me-2 text-accent-green"></i> COMMIT REBALANCING REQUEST
                    </button>
                    <p class="text-center text-muted extra-small fw-bold text-uppercase ls-1 mt-2">
                        <i class="fas fa-lock me-1"></i> Requires Multi-Hub Manager Authorization
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }

        .nexus-input:focus { background-color: #fff !important; box-shadow: 0 10px 20px -5px rgba(26, 61, 49, 0.1) !important; border: 1px solid var(--accent-green) !important; }

        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; transform: translateY(-2px); }
        .btn-white { background: white; border: none; color: var(--dark-green); }

        .animate-slide-up { animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
        @@keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

        .animate-pulse { animation: pulse 2s infinite; }
        @@keyframes pulse { 0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212, 240, 109, 0.4); } 70% { transform: scale(1.05); box-shadow: 0 0 0 15px rgba(212, 240, 109, 0); } 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212, 240, 109, 0); } }
    </style>
}
