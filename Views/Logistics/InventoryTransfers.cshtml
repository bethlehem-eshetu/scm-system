@model IEnumerable<SCM_System.Models.Entities.InventoryTransfer>
@{
    ViewData["Title"] = "Inventory Movement Strategy";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-exchange-alt me-2 text-accent-green"></i>Inventory Movement
            </h1>
            <p class="text-muted small mb-0 mt-1">Inter-hub stock movement and strategic fulfillment balancing across the network.</p>
        </div>
        <a asp-action="CreateTransfer" class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
            <i class="fas fa-plus me-2 text-accent-green"></i> Request Movement
        </a>
    </div>

    <!-- Nexus KPI Summary -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="bg-faint-green text-dark-green p-3 rounded-4 mb-3 d-inline-flex">
                    <i class="fas fa-clock fs-4"></i>
                </div>
                <div class="extra-small text-muted fw-bold text-uppercase ls-1 mb-1">Pending Approval</div>
                <div class="h3 fw-bold text-dark-green mb-0">@ViewBag.PendingCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="bg-faint-green text-dark-green p-3 rounded-4 mb-3 d-inline-flex">
                    <i class="fas fa-truck-loading fs-4"></i>
                </div>
                <div class="extra-small text-muted fw-bold text-uppercase ls-1 mb-1">In Transit</div>
                <div class="h3 fw-bold text-dark-green mb-0">@ViewBag.InTransitCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-white hover-lift">
                <div class="bg-faint-green text-dark-green p-3 rounded-4 mb-3 d-inline-flex">
                    <i class="fas fa-check-double fs-4"></i>
                </div>
                <div class="extra-small text-muted fw-bold text-uppercase ls-1 mb-1">Completed Cycle</div>
                <div class="h3 fw-bold text-dark-green mb-0">@ViewBag.CompletedCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-premium rounded-5 p-4 bg-dark-green text-white shadow-lg hover-lift">
                <div class="bg-white bg-opacity-10 text-accent-green p-3 rounded-4 mb-3 d-inline-flex">
                    <i class="fas fa-sync fs-4"></i>
                </div>
                <div class="extra-small text-white-50 fw-bold text-uppercase ls-1 mb-1">Units Rebalanced</div>
                <div class="h3 fw-bold text-accent-green mb-0">@ViewBag.UnitsRebalanced</div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert bg-accent-green text-dark-green border-0 rounded-5 shadow-premium mb-5 p-4 animate-slide-up d-flex align-items-center">
            <i class="fas fa-check-circle fs-4 me-3"></i>
            <div class="fw-bold">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Transfer Pipeline Workspace -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
        <div class="card-header bg-white py-4 px-5 border-0">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="fw-bold text-dark-green mb-0">Live Movement Stream</h5>
                </div>
                <div class="col-auto">
                    <div class="p-1 bg-faint-green rounded-pill d-flex gap-1">
                        <button class="btn btn-white nexus-filter-btn active rounded-pill px-4 py-2 small fw-bold shadow-sm">All Streams</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive px-4 pb-4">
            <table class="table table-hover align-middle mb-0 custom-nexus-table">
                <thead>
                    <tr class="extra-small text-muted text-uppercase ls-1">
                        <th class="ps-4">Transfer Reference</th>
                        <th>Product Entity</th>
                        <th class="text-center">Strategic Route</th>
                        <th class="text-center">Asset Quantity</th>
                        <th class="text-center">Stream Status</th>
                        <th class="text-end pe-4">Management</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-faint-green text-dark-green rounded-4 p-3 me-3 shadow-sm">
                                            <i class="fas fa-shipping-fast fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark-green mb-0">#TRF-@item.Id.ToString("D4")</div>
                                            <div class="extra-small text-muted fw-bold">Issued: @item.RequestedDate?.ToString("MMM dd, yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark-green mb-0">@item.Product?.ProductName</div>
                                    <div class="extra-small text-muted fw-bold">SKU: @item.Product?.SKU</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-center">
                                        <div class="text-center">
                                            <span class="badge bg-faint-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small border">@item.SourceWarehouse?.Name</span>
                                        </div>
                                        <i class="fas fa-chevron-right mx-3 text-dark-green opacity-25"></i>
                                        <div class="text-center">
                                            <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 fw-bold extra-small shadow-sm">@item.DestinationWarehouse?.Name</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="h5 fw-bold text-dark-green mb-0">@item.Quantity</div>
                                    <div class="extra-small text-muted fw-bold">@item.Product?.Unit</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            SCM_System.Models.Enums.TransferStatus.Requested => "bg-soft-warning text-warning",
                                            SCM_System.Models.Enums.TransferStatus.Approved => "bg-soft-info text-info",
                                            SCM_System.Models.Enums.TransferStatus.InTransit => "bg-soft-primary text-primary",
                                            SCM_System.Models.Enums.TransferStatus.Received => "bg-soft-success text-success",
                                            SCM_System.Models.Enums.TransferStatus.Cancelled => "bg-soft-danger text-danger",
                                            _ => "bg-soft-secondary text-secondary"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@item.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        @if (item.Status == SCM_System.Models.Enums.TransferStatus.Requested)
                                        {
                                            <form asp-action="ApproveTransfer" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-soft-success rounded-pill px-3 py-2 fw-bold extra-small shadow-sm">
                                                    <i class="fas fa-check me-1"></i> Approve
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == SCM_System.Models.Enums.TransferStatus.Approved)
                                        {
                                            <form asp-action="ShipTransfer" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-dark-green rounded-pill px-3 py-2 fw-bold extra-small shadow-premium">
                                                    <i class="fas fa-truck me-1"></i> Ship Dispatch
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == SCM_System.Models.Enums.TransferStatus.InTransit)
                                        {
                                            <form asp-action="ReceiveTransfer" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-accent-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small shadow-sm">
                                                    <i class="fas fa-hand-holding me-1"></i> Confirm Receipt
                                                </button>
                                            </form>
                                        }
                                        <a href="#" class="btn btn-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                            <i class="fas fa-eye text-dark-green"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="bg-faint-green rounded-5 p-5 border-dashed-custom">
                                    <i class="fas fa-truck-loading fa-4x text-dark-green opacity-10 mb-4"></i>
                                    <h5 class="fw-bold text-dark-green">No Movement Streams</h5>
                                    <p class="text-muted small mb-0">Hub balance is currently optimized across your fulfillment network.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .status-badge {
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .btn-soft-success { background-color: rgba(25, 135, 84, 0.1); color: #198754; border: none; }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1); }
        .bg-soft-secondary { background-color: rgba(0, 0, 0, 0.05); }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .nexus-filter-btn { border: none; transition: all 0.3s ease; }
        .nexus-filter-btn.active { background-color: var(--dark-green) !important; color: var(--accent-green) !important; }

        .custom-nexus-table thead th { border-bottom: none; padding: 20px 0; }
        .custom-nexus-table tbody td { padding: 24px 0; border-bottom: 1px solid rgba(0,0,0,0.02); }
        .custom-nexus-table tbody tr:last-child td { border-bottom: none; }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
        
        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-white:hover { background-color: var(--faint-green); }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }

        .animate-slide-up { animation: slideUp 0.5s ease-out; }
        @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
}
