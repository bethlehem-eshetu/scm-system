@model IEnumerable<SCM_System.Models.Entities.DispatchTask>
@{
    ViewData["Title"] = "Logistics Intelligence Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-tower-broadcast me-2 text-accent-green"></i>Fulfillment Command Center
            </h1>
            <p class="text-muted small mb-0 mt-1">Global oversight of multi-hub logistical performance and fleet deployment status.</p>
        </div>
        <div class="d-flex gap-3">
            <button class="btn btn-white rounded-pill px-4 py-2 shadow-sm fw-bold text-dark-green border">
                <i class="fas fa-file-chart-line me-2"></i> Logistics Report
            </button>
            <button class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
                <i class="fas fa-plus me-2 text-accent-green"></i> Deploy New Dispatch
            </button>
        </div>
    </div>

    <!-- Nexus Intelligence KPIs -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-start">
                        <div class="bg-faint-green text-dark-green rounded-4 p-3 shadow-sm">
                            <i class="fas fa-box-open fs-4"></i>
                        </div>
                        <span class="badge bg-soft-success text-success rounded-pill px-3 py-1 extra-small fw-bold border border-success border-opacity-10">Optimized</span>
                    </div>
                    <h2 class="fw-bold text-dark-green mb-1">@ViewBag.ReadyForDispatch</h2>
                    <p class="text-muted extra-small text-uppercase fw-bold ls-1 mb-0">Units Ready for Dispatch</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-start">
                        <div class="bg-faint-green text-dark-green rounded-4 p-3 shadow-sm">
                            <i class="fas fa-shipping-fast fs-4"></i>
                        </div>
                        <span class="badge bg-soft-info text-info rounded-pill px-3 py-1 extra-small fw-bold border border-info border-opacity-10">Live Flow</span>
                    </div>
                    <h2 class="fw-bold text-dark-green mb-1">@ViewBag.ActiveDeliveries</h2>
                    <p class="text-muted extra-small text-uppercase fw-bold ls-1 mb-0">Active Stream (In Transit)</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-white hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-start">
                        <div class="bg-faint-green text-dark-green rounded-4 p-3 shadow-sm">
                            <i class="fas fa-truck-container fs-4"></i>
                        </div>
                        <span class="badge bg-soft-success text-success rounded-pill px-3 py-1 extra-small fw-bold">92% Readiness</span>
                    </div>
                    <h2 class="fw-bold text-dark-green mb-1">@ViewBag.VehiclesAvailable</h2>
                    <p class="text-muted extra-small text-uppercase fw-bold ls-1 mb-0">Fleet Capacity Readiness</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-premium rounded-5 h-100 bg-dark-green text-white shadow-lg hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-start">
                        <div class="bg-white bg-opacity-10 text-accent-green rounded-4 p-3">
                            <i class="fas fa-user-clock fs-4"></i>
                        </div>
                        <span class="badge bg-accent-green text-dark-green rounded-pill px-3 py-1 extra-small fw-bold">Critical Path</span>
                    </div>
                    <h2 class="fw-bold text-accent-green mb-1">@ViewBag.DriverAvailability</h2>
                    <p class="text-white-50 extra-small text-uppercase fw-bold ls-1 mb-0">Agent Utilization Rate</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Live Dispatch Intelligence Stream -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
                <div class="card-header bg-white py-4 px-5 border-0">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="fw-bold text-dark-green mb-0">Live Dispatch Pipeline</h5>
                        </div>
                        <div class="col-auto">
                            <div class="p-1 bg-faint-green rounded-pill d-flex gap-1">
                                <button class="btn btn-white nexus-filter-btn active rounded-pill px-4 py-2 small fw-bold">Live Streams</button>
                                <button class="btn btn-white nexus-filter-btn rounded-pill px-4 py-2 small fw-bold">Exceptions</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive px-4 pb-4">
                    <table class="table table-hover align-middle mb-0 custom-nexus-table">
                        <thead>
                            <tr class="extra-small text-muted text-uppercase ls-1">
                                <th class="ps-4">Asset Reference</th>
                                <th>Assignment Entity</th>
                                <th class="text-center">Active Hub</th>
                                <th class="text-center">SLA Compliance</th>
                                <th class="text-center">Priority Tier</th>
                                <th class="text-end pe-4">Operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var task in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark-green mb-0">#ORD-@task.Order?.OrderNumber</div>
                                            <div class="extra-small text-muted fw-bold">Ref: #DT-@task.Id</div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-faint-green text-dark-green rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; flex-shrink: 0;">
                                                    <i class="fas fa-user-astronaut small"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark-green small mb-0">@(task.DeliveryAgent?.User?.FullName ?? "Unassigned")</div>
                                                    <div class="extra-small text-muted fw-bold">Fleet Agent</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-faint-green text-dark-green rounded-pill px-3 py-1 fw-bold extra-small border">CENTRAL-HUB</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-badge bg-soft-success text-success px-3 py-1">On Schedule</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-badge bg-soft-danger text-danger px-3 py-1 fw-bold">High Priority</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-faint-green text-dark-green rounded-pill px-4 py-2 fw-bold small shadow-sm">
                                                Adjust Stream
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="bg-faint-green rounded-5 p-5 border-dashed-custom mx-4">
                                            <i class="fas fa-radar fa-4x text-dark-green opacity-10 mb-4 animate-pulse"></i>
                                            <h5 class="fw-bold text-dark-green">No Active Deployments</h5>
                                            <p class="text-muted small mb-0">Fulfillment network is currently in a steady state.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Strategic Insights Column -->
        <div class="col-lg-4">
            <!-- Alert Intelligence -->
            <div class="card border-0 shadow-premium rounded-5 mb-4 bg-white overflow-hidden">
                <div class="card-header bg-soft-danger p-4 border-0">
                    <h6 class="fw-bold mb-0 text-danger d-flex align-items-center">
                        <i class="fas fa-shield-exclamation me-2 fs-5"></i>Operational Bottlenecks
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="alert bg-faint-green text-dark-green border-0 rounded-4 shadow-sm mb-3 p-3">
                        <div class="d-flex">
                            <div class="bg-warning text-white rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                            <div>
                                <div class="fw-bold small mb-1">Late Stage Pickups (Hub-04)</div>
                                <div class="extra-small opacity-75 fw-bold">5 critical units awaiting deployment in South Zone.</div>
                            </div>
                        </div>
                    </div>
                    <div class="alert bg-soft-danger text-danger border-0 rounded-4 shadow-sm mb-0 p-3">
                        <div class="d-flex">
                            <div class="bg-danger text-white rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <i class="fas fa-snowflake"></i>
                            </div>
                            <div>
                                <div class="fw-bold small mb-1">Cold-Chain Capacity Deficit</div>
                                <div class="extra-small opacity-75 fw-bold">Zero active refrigerated assets available in Central Hub.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Network Analytics -->
            <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                <div class="card-header bg-faint-green p-4 border-0">
                    <h6 class="fw-bold mb-0 text-dark-green">Network Analytics Hub</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between extra-small fw-bold text-uppercase text-muted ls-1 mb-2">
                            <span>Fleet Fuel Optimization</span>
                            <span class="text-dark-green">92%</span>
                        </div>
                        <div class="progress rounded-pill shadow-sm" style="height: 6px; background-color: rgba(0,0,0,0.05);">
                            <div class="progress-bar bg-dark-green rounded-pill" style="width: 92%"></div>
                        </div>
                    </div>
                    <div class="mb-5">
                        <div class="d-flex justify-content-between extra-small fw-bold text-uppercase text-muted ls-1 mb-2">
                            <span>Hub Capacity Index</span>
                            <span class="text-dark-green">78%</span>
                        </div>
                        <div class="progress rounded-pill shadow-sm" style="height: 6px; background-color: rgba(0,0,0,0.05);">
                            <div class="progress-bar bg-accent-green rounded-pill" style="width: 78%"></div>
                        </div>
                    </div>
                    
                    <div class="pt-4 border-top border-faint">
                        <div class="row text-center g-0">
                            <div class="col-4 border-end border-faint">
                                <div class="h5 fw-bold text-dark-green mb-0">14</div>
                                <div class="extra-small text-muted fw-bold">READY</div>
                            </div>
                            <div class="col-4 border-end border-faint">
                                <div class="h5 fw-bold text-danger mb-0">3</div>
                                <div class="extra-small text-muted fw-bold">EXCEPTIONS</div>
                            </div>
                            <div class="col-4">
                                <div class="h5 fw-bold text-dark-green mb-0">45</div>
                                <div class="extra-small text-muted fw-bold">AGENTS</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .status-badge {
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }
        .border-faint { border-color: rgba(0,0,0,0.03) !important; }

        .nexus-filter-btn { border: none; transition: all 0.3s ease; }
        .nexus-filter-btn.active { background-color: var(--dark-green) !important; color: var(--accent-green) !important; box-shadow: 0 4px 12px rgba(26,61,49,0.2); }

        .custom-nexus-table thead th { border-bottom: none; padding: 20px 0; }
        .custom-nexus-table tbody td { padding: 20px 0; border-bottom: 1px solid rgba(0,0,0,0.02); }
        .custom-nexus-table tbody tr:last-child td { border-bottom: none; }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
        
        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-white:hover { background-color: var(--faint-green); }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }
        .btn-faint-green { background-color: var(--faint-green); color: var(--dark-green); border: none; }

        .animate-pulse { animation: pulse 2s infinite; }
        @@keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }
    </style>
}
