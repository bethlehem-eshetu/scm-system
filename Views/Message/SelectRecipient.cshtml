@using SCM_System.Models.ViewModels
@model List<SelectRecipientViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = ViewBag.Title;
    string role = ViewBag.Role;
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-@(role == "Supplier" ? "building" : "store") me-2 text-accent-green"></i>
                @ViewBag.Title
            </h1>
            <p class="text-muted small mb-0 mt-1">Select a verified business entity to establish a secure communication channel.</p>
        </div>
        <a href="@Url.Action("Inbox")" class="btn btn-white rounded-pill px-4 py-2 shadow-sm fw-bold text-dark-green">
            <i class="fas fa-arrow-left me-2"></i> Back to Inbox
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
            <div class="card-body text-center py-5">
                <div class="bg-faint-green rounded-circle p-5 mb-4 d-inline-flex mx-auto align-items-center justify-content-center" style="width: 120px; height: 120px;">
                    <i class="fas fa-@(role == "Supplier" ? "building" : "store") fa-3x text-dark-green opacity-25"></i>
                </div>
                <h4 class="fw-bold text-dark-green">No Verified @(role)s</h4>
                <p class="text-muted small fw-bold">There are no verified @(role.ToLower())s in the network at this time.</p>
                <a href="@Url.Action("Inbox")" class="btn btn-dark-green mt-3 rounded-pill px-5 py-2 fw-bold shadow-premium">
                    <i class="fas fa-inbox me-2 text-accent-green"></i> Return to Inbox
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var recipient in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card border-0 shadow-premium rounded-5 h-100 hover-lift bg-white overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-nexus rounded-circle text-white me-3 d-flex align-items-center justify-content-center fw-bold @(role == "Supplier" ? "bg-dark-green" : "bg-accent-green text-dark-green")" style="width: 56px; height: 56px; flex-shrink: 0; font-size: 1.4rem; shadow: 0 4px 12px rgba(0,0,0,0.1);">
                                    @recipient.Initial
                                </div>
                                <div class="overflow-hidden">
                                    <h6 class="fw-bold text-dark-green mb-0 text-truncate">@recipient.BusinessName</h6>
                                    <div class="extra-small text-muted fw-bold">
                                        <i class="fas fa-user-tie me-1"></i> @recipient.ContactPerson
                                    </div>
                                </div>
                            </div>
                            
                            <div class="bg-faint-green rounded-4 p-3 mb-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-map-marker-alt text-dark-green opacity-50 me-2 extra-small"></i>
                                    <span class="extra-small text-dark-green fw-bold">@recipient.City, Ethiopia</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-shield-check text-success me-2 extra-small"></i>
                                    <span class="badge bg-soft-success text-success rounded-pill px-2 py-1 extra-small fw-bold">Verified Partner</span>
                                </div>
                            </div>
                            
                            <a asp-action="SendMessage" asp-route-receiverId="@recipient.UserId"
                                   class="btn btn-dark-green w-100 rounded-pill py-3 fw-bold shadow-premium extra-small ls-1">
                                <i class="fas fa-comment-alt-dots me-2 text-accent-green"></i> INITIATE CHAT
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }
        .btn-white { background: white; border: none; color: var(--dark-green); }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }
        
        .avatar-nexus { shadow: 0 4px 15px rgba(26,61,49,0.15); }
    </style>
}