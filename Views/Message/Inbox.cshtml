@using SCM_System.Models.ViewModels
@model List<ConversationViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Business Messages";
    string currentUserType = Context.Session.GetString("UserRole") ?? "Retailer";
}

<link href="~/css/chat.css" rel="stylesheet" />

<div class="container-fluid py-4">
    <!-- Premium Messaging Center Layout -->
    <div class="messaging-center list-active shadow border-0">
        
        <!-- LEFT PANEL: Conversation List -->
        <div class="conversation-list">
            <div class="conversation-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-comment-dots text-primary me-2"></i>Messages</h5>
                    <a href="@Url.Action("SelectRecipient")" class="btn btn-sm btn-light rounded-circle shadow-sm" title="New Message">
                        <i class="fas fa-plus text-primary"></i>
                    </a>
                </div>
            </div>
            
            <div class="conversation-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search chats..." id="chatSearch">
                </div>
            </div>

            <div class="conversation-items">
                @if (!Model.Any())
                {
                    <div class="text-center p-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3 opacity-50"></i>
                        <p class="text-muted small">No conversations yet.</p>
                        <a href="@Url.Action("SelectRecipient")" class="btn btn-sm btn-outline-primary rounded-pill">Start a Chat</a>
                    </div>
                }
                else
                {
                    foreach (var conversation in Model)
                    {
                        <a href="@Url.Action("Conversation", new { id = conversation.OtherUserId })" class="conversation-item">
                            <div class="conversation-avatar @(conversation.OtherUserType == "Supplier" ? "bg-warning" : "bg-info") shadow-sm">
                                @(conversation.OtherUserName.Length > 0 ? conversation.OtherUserName.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <div class="conversation-info">
                                <div class="d-flex justify-content-between">
                                    <div class="conversation-name">
                                        @conversation.OtherUserName
                                        @if (conversation.UnreadCount > 0)
                                        {
                                            <span class="badge bg-primary ms-1" style="font-size: 0.6rem;">@conversation.UnreadCount</span>
                                        }
                                    </div>
                                    <div class="conversation-time">@conversation.TimeSpanDisplay</div>
                                </div>
                                <div class="conversation-preview @(conversation.UnreadCount > 0 ? "fw-bold text-dark" : "")">
                                    @conversation.LastMessage
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- RIGHT PANEL: Chat Area (Empty State for Inbox) -->
        <div class="chat-area d-none d-lg-flex bg-light align-items-center justify-content-center">
            <div class="text-center opacity-50">
                <div class="mb-4">
                    <i class="fas fa-comments fa-5x text-secondary"></i>
                </div>
                <h4 class="text-muted">Business Communication Center</h4>
                <p class="text-muted">Select a conversation from the sidebar or start a new one.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simple front-end filtering
            $('#chatSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('.conversation-item').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}