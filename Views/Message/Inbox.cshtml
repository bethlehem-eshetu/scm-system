@using SCM_System.Models.ViewModels
@model List<ConversationViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Business Intelligence Messaging";
    string currentUserType = Context.Session.GetString("UserRole") ?? "Retailer";
}

<link href="~/css/chat.css" rel="stylesheet" />

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1"><i class="fas fa-comment-dots me-2 text-accent-green"></i>Secure Messages</h1>
            <p class="text-muted small mb-0 mt-1">Direct encrypted communication with your supply chain partners and logistics agents.</p>
        </div>
        <a href="@Url.Action("SelectRecipient")" class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
            <i class="fas fa-plus me-2 text-accent-green"></i> Start Intelligence Chat
        </a>
    </div>

    <!-- Nexus Messaging Center Layout -->
    <div class="messaging-center list-active shadow-premium border-0 rounded-5 overflow-hidden bg-white d-flex" style="height: 75vh;">
        
        <!-- LEFT PANEL: Conversation List -->
        <div class="conversation-list border-end border-light" style="width: 400px; flex-shrink: 0;">
            <div class="conversation-header p-4 bg-faint-green">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark-green">Active Conversations</h6>
                </div>
            </div>
            
            <div class="conversation-search p-3">
                <div class="search-bar-premium position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted extra-small"></i>
                    <input type="text" class="form-control border-0 bg-faint-green rounded-pill ps-5 small fw-bold text-dark-green" placeholder="Search chats..." id="chatSearch" style="height: 40px;">
                </div>
            </div>

            <div class="conversation-items overflow-auto" style="height: calc(100% - 130px);">
                @if (!Model.Any())
                {
                    <div class="text-center p-5">
                        <i class="fas fa-inbox fa-3x text-dark-green opacity-10 mb-4"></i>
                        <p class="text-muted small fw-bold">No active streams found.</p>
                        <a href="@Url.Action("SelectRecipient")" class="btn btn-faint-green btn-sm rounded-pill px-4 text-dark-green fw-bold">Open Connection</a>
                    </div>
                }
                else
                {
                    foreach (var conversation in Model)
                    {
                        <a href="@Url.Action("Conversation", new { id = conversation.OtherUserId })" class="conversation-item d-flex align-items-center p-3 border-bottom border-faint text-decoration-none transition-all">
                            <div class="conversation-avatar rounded-circle shadow-sm d-flex align-items-center justify-content-center fw-bold text-white me-3 @(conversation.OtherUserType == "Supplier" ? "bg-dark-green" : "bg-accent-green text-dark-green")" style="width: 48px; height: 48px; flex-shrink: 0;">
                                @(conversation.OtherUserName.Length > 0 ? conversation.OtherUserName.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <div class="conversation-info flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="conversation-name fw-bold text-dark-green text-truncate small pe-2">
                                        @conversation.OtherUserName
                                    </div>
                                    <div class="conversation-time extra-small text-muted fw-bold">@conversation.TimeSpanDisplay</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="conversation-preview extra-small text-muted text-truncate pe-3 @(conversation.UnreadCount > 0 ? "fw-bold text-dark-green" : "")">
                                        @conversation.LastMessage
                                    </div>
                                    @if (conversation.UnreadCount > 0)
                                    {
                                        <span class="badge bg-dark-green text-accent-green rounded-pill extra-small px-2">@conversation.UnreadCount</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- RIGHT PANEL: Chat Area (Empty State for Inbox) -->
        <div class="chat-area flex-grow-1 d-none d-lg-flex bg-faint-green align-items-center justify-content-center p-5">
            <div class="text-center opacity-75">
                <div class="bg-white rounded-circle shadow-premium p-5 mb-4 d-inline-flex mx-auto align-items-center justify-content-center" style="width: 140px; height: 140px;">
                    <i class="fas fa-comments fa-4x text-dark-green opacity-25"></i>
                </div>
                <h4 class="fw-bold text-dark-green mb-2">Nexus Intelligence Hub</h4>
                <p class="text-muted small fw-bold">Select a supply chain partner to initiate a secure data stream.</p>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <span class="badge bg-soft-success text-success rounded-pill px-3 py-2 extra-small fw-bold border border-success border-opacity-10"><i class="fas fa-shield-alt me-1"></i> End-to-End Encrypted</span>
                    <span class="badge bg-soft-info text-info rounded-pill px-3 py-2 extra-small fw-bold border border-info border-opacity-10"><i class="fas fa-bolt me-1"></i> Real-time Sync</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        
        .conversation-item:hover { background-color: var(--faint-green) !important; }
        .conversation-item.active { background-color: rgba(212, 240, 109, 0.1) !important; border-left: 4px solid var(--dark-green) !important; }

        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }
        .btn-faint-green { background-color: var(--faint-green); color: var(--dark-green); border: none; }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        
        .scrollbar-hidden::-webkit-scrollbar { width: 6px; }
        .scrollbar-hidden::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.05); border-radius: 10px; }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#chatSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('.conversation-item').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}