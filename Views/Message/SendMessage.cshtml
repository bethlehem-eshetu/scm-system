@using SCM_System.Models.ViewModels
@model SendMessageViewModel

@{
    ViewData["Title"] = $"Send Message to {Model.ReceiverName}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-paper-plane me-2"></i>
                        New Message to @Model.ReceiverName
                    </h4>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Send" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReceiverId" />
                        <input type="hidden" asp-for="ConversationId" />
                        
                        <div class="mb-4">
                            <label asp-for="Content" class="form-label fw-bold">Your Message</label>
                            <textarea asp-for="Content" class="form-control" rows="6"
                                      placeholder="Type your message here..." required></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                            <small class="text-muted">Maximum 5000 characters</small>
                        </div>
                        
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Important:</strong> Sharing contact information (phone numbers, emails,
                            Telegram, WhatsApp, social media handles) is strictly prohibited.
                        </div>
                        
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-paper-plane me-2"></i>Send Message
                            </button>
                            <a asp-action="SelectRecipient" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-arrow-left me-2"></i>Back to Recipients
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Character counter
        document.getElementById('Content')?.addEventListener('input', function(e) {
            var length = e.target.value.length;
            var counter = document.getElementById('charCounter');
            if (!counter) {
                counter = document.createElement('small');
                counter.id = 'charCounter';
                counter.className = 'text-muted float-end';
                e.target.parentNode.appendChild(counter);
            }
            counter.textContent = length + '/5000';
            
            if (length > 4500) {
                counter.classList.add('text-warning');
            } else {
                counter.classList.remove('text-warning');
            }
        });
    </script>
}