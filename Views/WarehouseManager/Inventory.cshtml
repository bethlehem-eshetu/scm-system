@model IEnumerable<SCM_System.Models.Entities.Inventory>
@{
    ViewData["Title"] = "Warehouse Inventory";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Inventory Management</h2>
            <p class="text-muted"><i class="fas fa-warehouse me-2"></i>Location: <span class="fw-bold text-primary">@ViewBag.WarehouseName</span></p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm bg-white" onclick="window.print()">
                <i class="fas fa-print me-2"></i>Print Stock Report
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="glass-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light bg-opacity-50">
                    <tr>
                        <th class="ps-4">Product Details</th>
                        <th>Category</th>
                        <th>On Hand</th>
                        <th>Reserved</th>
                        <th>Available</th>
                        <th class="text-end pe-4">Stock Adjustment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isLow = item.QuantityOnHand < 20;
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@item.Product?.ProductName</div>
                                <div class="small text-muted">SKU: @item.Product?.SKU</div>
                            </td>
                            <td>@item.Product?.Category?.CategoryName</td>
                            <td>
                                <span class="fw-bold @(isLow ? "text-danger" : "text-dark")">@item.QuantityOnHand</span>
                                @if (isLow) 
                                {
                                    <span class="badge bg-danger-soft text-danger ms-2 small">LOW STOCK</span>
                                }
                            </td>
                            <td><span class="text-muted">@item.QuantityReserved</span></td>
                            <td>
                                <span class="badge rounded-pill bg-light text-primary border px-3">
                                    @(item.QuantityOnHand - item.QuantityReserved) Available
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="UpdateInventory" method="post" class="d-inline-flex gap-2">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <div class="input-group input-group-sm" style="width: 140px;">
                                        <button type="submit" name="action" value="sub" class="btn btn-outline-danger border-end-0"><i class="fas fa-minus"></i></button>
                                        <input type="number" name="change" class="form-control text-center border-danger border-start-0 border-end-0" value="1" min="1" />
                                        <button type="submit" name="action" value="add" class="btn btn-outline-success border-start-0"><i class="fas fa-plus"></i></button>
                                    </div>
                                    @Html.AntiForgeryToken()
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
</style>
