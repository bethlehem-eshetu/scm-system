<div id="toast-container" class="toast-container"></div>

<style>
    .toast-container {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .toast-notification {
        min-width: 320px;
        max-width: 400px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: slideInRight 0.3s ease forwards;
        border-left: 4px solid;
        position: relative;
        overflow: hidden;
    }

    .toast-notification.success {
        border-left-color: #2E9C7A;
    }

    .toast-notification.error {
        border-left-color: #E05A5A;
    }

    .toast-notification.warning {
        border-left-color: #E67E22;
    }

    .toast-notification.info {
        border-left-color: #5B8FF9;
    }

    .toast-icon {
        font-size: 24px;
    }

    .toast-content {
        flex: 1;
    }

    .toast-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 4px;
        color: #1a3d31;
    }

    .toast-message {
        font-size: 13px;
        color: #64748b;
    }

    .toast-close {
        background: none;
        border: none;
        font-size: 16px;
        cursor: pointer;
        color: #64748b;
        opacity: 0.6;
        transition: opacity 0.2s;
    }

    .toast-close:hover {
        opacity: 1;
    }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: #2E9C7A;
        animation: progressShrink 4s linear forwards;
    }

    @Html.Raw("@")keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @Html.Raw("@")keyframes progressShrink {
        from {
            width: 100%;
        }
        to {
            width: 0%;
        }
    }

    .toast-notification.fade-out {
        animation: fadeOut 0.3s ease forwards;
    }

    @Html.Raw("@")keyframes fadeOut {
        to {
            opacity: 0;
            transform: translateX(100%);
        }
    }

    /* Dark mode adjustments (using .dark-mode if present) */
    .dark-mode .toast-notification {
        background: #1A1F1D;
        border: 1px solid #2A3530;
    }

    @Html.Raw("@")media (max-width: 576px) {
        .toast-notification {
            min-width: 280px;
            max-width: 90vw;
            padding: 12px 16px;
        }
    }
</style>

<script>
    function showToast(message, type = 'success', title = '') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const titles = {
            success: 'Success',
            error: 'Error',
            warning: 'Warning',
            info: 'Info'
        };

        const icons = {
            success: '✅',
            error: '❌',
            warning: '⚠️',
            info: 'ℹ️'
        };

        const toast = document.createElement('div');
        toast.className = `toast-notification ${type}`;
        toast.innerHTML = `
            <div class="toast-icon">${icons[type] || icons.info}</div>
            <div class="toast-content">
                <div class="toast-title">${title || titles[type]}</div>
                <div class="toast-message">${message}</div>
            </div>
            <button class="toast-close" onclick="this.closest('.toast-notification').remove()">✕</button>
            <div class="toast-progress"></div>
        `;

        container.appendChild(toast);

        // Auto remove after 4 seconds
        setTimeout(() => {
            toast.classList.add('fade-out');
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }
</script>
