@model SCM_System.Models.ViewModels.NotificationBellViewModel

<div class="nav-item dropdown notification-bell-wrapper">
    <a class="nav-link dropdown-toggle position-relative p-2" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-bell fs-5"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge" style="font-size: 0.6rem; padding: 0.35em 0.65em;">
                @(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)
            </span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end notification-dropdown animate-slide-up" aria-labelledby="notificationDropdown">
        <div class="notification-header">
            <h6>Notifications</h6>
            @if (Model.UnreadCount > 0)
            {
                <button class="btn btn-link btn-sm p-0 text-decoration-none extra-small fw-bold text-primary" onclick="markAllNotificationsAsRead()">Mark all as read</button>
            }
        </div>
        <div class="notification-list custom-scrollbar">
            @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
            {
                @foreach (var note in Model.RecentNotifications)
                {
                    <div class="notification-item @(note.IsRead ? "" : "unread")" onclick="handleNotificationClick(@note.Id, '@note.ActionUrl')">
                        <div class="notification-icon bg-info text-white">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div class="notification-content">
                            <div class="notification-title">@note.Title</div>
                            <div class="notification-message">@note.Message</div>
                            <div class="notification-time">
                                <i class="far fa-clock me-1"></i>@note.TimeAgo
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="fas fa-bell-slash fa-2x mb-3 opacity-20"></i>
                    <p class="mb-0 extra-small fw-bold">All caught up!</p>
                </div>
            }
        </div>
        <div class="notification-footer">
            <a href="/Notification" class="uppercase">View Intelligence Center</a>
        </div>
    </div>
</div>
