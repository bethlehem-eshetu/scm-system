@model SCM_System.Models.ViewModels.NotificationBellViewModel

<div class="nav-item dropdown notification-bell-wrapper">
    <a class="nav-link dropdown-toggle position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-bell"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationBadge">
                @(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)
            </span>
        }
        else
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationBadge" style="display: none;">0</span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end shadow-lg py-0" aria-labelledby="notificationDropdown" style="min-width: 350px; border: none; border-radius: 12px; overflow: hidden;">
        <div class="dropdown-header d-flex justify-content-between align-items-center py-3 bg-light border-bottom">
            <h6 class="mb-0 fw-bold text-dark">Notifications</h6>
            @if (Model.UnreadCount > 0)
            {
                <button class="btn btn-link btn-sm p-0 text-decoration-none" onclick="markAllNotificationsAsRead(event)">Mark all as read</button>
            }
        </div>
        <div id="notificationList" class="notification-list" style="max-height: 400px; overflow-y: auto;">
            @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
            {
                @foreach (var note in Model.RecentNotifications)
                {
                    <div class="notification-item @(note.IsRead ? "" : "unread") p-3 border-bottom position-relative" onclick="handleNotificationClick(event, @note.Id, '@note.ActionUrl')">
                        <div class="d-flex align-items-start">
                            <div class="notification-icon me-3">
                                <span class="fs-4">@note.Icon</span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="notification-title mb-1 small">@note.Title</h6>
                                    <span class="notification-time text-muted small">@note.TimeAgo</span>
                                </div>
                                <p class="notification-message mb-0 text-muted small">@note.Message</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-0">No new notifications</p>
                </div>
            }
        </div>
        <div class="dropdown-footer p-2 text-center bg-light border-top">
            <a href="/Notification" class="text-decoration-none small text-primary fw-bold">View All Notifications</a>
        </div>
    </div>
</div>
