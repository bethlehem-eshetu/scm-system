<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SCM System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .navbar {
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.3);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 1rem 2rem;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 700;
            color: var(--primary-color) !important;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-link {
            color: var(--text-secondary) !important;
            font-weight: 500;
            margin: 0 0.5rem;
            transition: color 0.3s;
            position: relative;
        }

        .nav-link:hover {
            color: var(--primary-color) !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 50%;
            background-color: var(--primary-color);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover::after {
            width: 80%;
        }

        .footer {
            background: #0f172a; /* Dark blue/slate background */
            color: #94a3b8;
            padding: 5rem 0 2rem 0;
            margin-top: 4rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer-brand {
            color: #f8fafc;
            font-weight: 700;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            text-decoration: none;
        }

        .footer-heading {
            color: #f8fafc;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-links li {
            margin-bottom: 0.75rem;
        }

        .footer-links a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.3s ease, padding-left 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--primary-color);
            padding-left: 5px;
        }

        .footer-social {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .footer-social a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            color: #f8fafc;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .footer-social a:hover {
            background: var(--primary-color);
            transform: translateY(-3px);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 2rem;
            margin-top: 4rem;
            font-size: 0.875rem;
        }

        main {
            min-height: 100vh;
            padding: 0;
        }

        .btn-primary {
            background: var(--primary-color);
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(37,99,235,0.3);
        }

        .btn-outline-primary {
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
            background: transparent;
        }

        .btn-outline-primary:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(37,99,235,0.2);
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container-fluid px-lg-5">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ethiochain-logo.jpg" alt="Logo" style="height: 32px; width: 32px; border-radius: 8px;" />
                    <span class="fw-bold text-primary">EthioChain SCM</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navRes" aria-controls="navRes" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu Structure -->
                <div class="collapse navbar-collapse" id="navRes">
                    <ul class="navbar-nav ms-auto align-items-center gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                        <li class="nav-item">
                            <a class="nav-link" href="#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#how-it-works">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>

                        @if (Context.Session.GetString("UserRole") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="dashboardDrop" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-th-large me-1"></i> Dashboard
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    @if (Context.Session.GetString("UserRole") == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-chart-line me-2"></i>Admin Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingUsers"><i class="fas fa-user-check me-2"></i>User Verifications</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AllUsers"><i class="fas fa-users me-2"></i>Manage Users</a></li>
                                    }
                                    else if (Context.Session.GetString("UserRole") == "Supplier")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Dashboard"><i class="fas fa-warehouse me-2"></i>Supplier Dashboard</a></li>
                                    }
                                    else if (Context.Session.GetString("UserRole") == "Retailer")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Retailer" asp-action="Dashboard"><i class="fas fa-store me-2"></i>Retailer Dashboard</a></li>
                                    }
                                    else if (Context.Session.GetString("UserRole") == "Warehouse")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Warehouse" asp-action="Dashboard"><i class="fas fa-boxes me-2"></i>Warehouse Dashboard</a></li>
                                    }
                                    else if (Context.Session.GetString("UserRole") == "Delivery")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Delivery" asp-action="Dashboard"><i class="fas fa-truck me-2"></i>Delivery Dashboard</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary px-4 rounded-pill" asp-controller="Account" asp-action="Register">Register Now</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container" style="padding-top: 100px;">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container" style="padding-top: 100px;">
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <a href="/" class="footer-brand">
                        <img src="~/images/ethiochain-logo.jpg" alt="EthioChain Logo" style="height: 36px; width: 36px; border-radius: 8px;" />
                        EthioChain SCM

                    </a>
                    <p class="mt-3 pe-lg-4 text-sm" style="line-height: 1.6;">
                        The definitive digital standard for supply chain operations. Powering next-generation procurement, smart bidding, and transparent logistics across Ethiopia.
                    </p>
                    <div class="footer-social">
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-github"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Solutions</h5>
                    <ul class="footer-links">
                        <li><a href="#">Smart Bidding</a></li>
                        <li><a href="#">Warehouse Network</a></li>
                        <li><a href="#">Logistics Pulse</a></li>
                        <li><a href="#">Fayda Integration</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Resources</h5>
                    <ul class="footer-links">
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">API Reference</a></li>
                        <li><a href="#">Supplier Guidelines</a></li>
                        <li><a href="#">System Status</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading">Join The Network</h5>
                    <p class="text-sm mb-4">Subscribe to platform updates, system upgrades, and new procurement opportunities.</p>
                    <form class="d-flex" onsubmit="event.preventDefault();">
                        <input type="email" class="form-control bg-light border-0 me-2" placeholder="Your email address" style="border-radius: 6px;">
                        <button class="btn btn-primary" type="button" style="border-radius: 6px;">Subscribe</button>
                    </form>
                </div>
            </div>

            <div class="row footer-bottom align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <p class="mb-0">&copy; @DateTime.Now.Year EthioChain SCM. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item me-4"><a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: #94a3b8; text-decoration: none;">Privacy Policy</a></li>
                        <li class="list-inline-item me-4"><a asp-area="" asp-controller="Home" asp-action="Terms" style="color: #94a3b8; text-decoration: none;">Terms of Service</a></li>
                        <li class="list-inline-item"><a href="#" style="color: #94a3b8; text-decoration: none;">Cookie Settings</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
