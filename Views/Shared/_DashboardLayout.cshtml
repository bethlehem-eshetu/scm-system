                </button>

                <div class="d-flex align-items-center">
                    @if (Context.Session.GetString("UserRole") == "Retailer")
                    {
                        <!-- Global Cart Toggle -->
                        <button class="btn btn-light position-relative rounded-circle me-3 border-0 shadow-sm p-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" id="cartToggleButton" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-shopping-cart text-primary"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="globalCartCount" style="display:none; font-size: 0.65em;">
                                0
                            </span>
                        </button>
                    }
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-medium">
