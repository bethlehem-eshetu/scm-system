@using SCM_System.Models.Entities
@model IEnumerable<OrderStatusHistory>

<div class="activity-timeline">
    @if (Model != null && Model.Any())
    {
        <ul class="timeline">
            @foreach (var entry in Model.OrderByDescending(h => h.ChangedAt))
            {
                <li class="timeline-item">
                    <div class="timeline-badge @GetStatusColorClass(entry.Status)">
                        <i class="@GetStatusIcon(entry.Status)"></i>
                    </div>
                    <div class="timeline-panel shadow-sm border rounded-3 p-3 mb-3 bg-white">
                        <div class="timeline-heading d-flex justify-content-between align-items-center">
                            <h6 class="timeline-title fw-bold mb-0">@entry.Status</h6>
                            <small class="text-muted"><i class="far fa-clock me-1"></i> @entry.ChangedAt.ToString("MMM dd, HH:mm")</small>
                        </div>
                        <div class="timeline-body mt-2">
                            <p class="mb-1 smaller text-dark">@entry.Comments</p>
                            <div class="d-flex align-items-center mt-2 pt-2 border-top">
                                <div class="bg-light rounded-circle p-1 me-2" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user extra-small text-muted"></i>
                                </div>
                                <span class="extra-small text-muted font-normal">Updated by @(entry.ChangedByUser?.FullName ?? "System")</span>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="text-center py-4 opacity-50">
            <i class="fas fa-history fa-2x mb-2"></i>
            <p class="smaller font-normal">No activity history recorded yet.</p>
        </div>
    }
</div>

@functions {
    string GetStatusColorClass(string status)
    {
        return status switch
        {
            "Created" or "Issued" => "bg-warning",
            "Accepted" or "Approved" or "Processing" => "bg-primary",
            "Picking" or "Packed" or "Ready Dispatch" => "bg-info",
            "In Transit" => "bg-indigo",
            "Delivered" or "Completed" or "Received" => "bg-success",
            "Rejected" or "Cancelled" or "Failed" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Created" or "Issued" => "fas fa-plus",
            "Accepted" or "Approved" => "fas fa-check",
            "Processing" => "fas fa-cog fa-spin",
            "Picking" => "fas fa-box-open",
            "Packed" => "fas fa-box",
            "Ready Dispatch" => "fas fa-clipboard-check",
            "In Transit" => "fas fa-truck",
            "Delivered" or "Completed" or "Received" => "fas fa-flag-checkered",
            "Rejected" or "Cancelled" or "Failed" => "fas fa-times",
            _ => "fas fa-info-circle"
        };
    }
}

<style>
    .timeline { list-style: none; padding: 20px 0 20px; position: relative; }
    .timeline:before { top: 0; bottom: 0; position: absolute; content: " "; width: 2px; background-color: #e9ecef; left: 20px; margin-right: -1.5px; }
    .timeline > li { margin-bottom: 5px; position: relative; padding-left: 55px; }
    .timeline > li:before, .timeline > li:after { content: " "; display: table; }
    .timeline > li:after { clear: both; }
    .timeline > li > .timeline-badge { color: #fff; width: 32px; height: 32px; line-height: 32px; font-size: 0.9em; text-align: center; position: absolute; top: 5px; left: 5px; z-index: 100; border-radius: 50%; box-shadow: 0 0 0 4px #fff; }
    .bg-indigo { background-color: #6610f2; }
    .smaller { font-size: 0.85rem; }
    .extra-small { font-size: 0.75rem; }
</style>
