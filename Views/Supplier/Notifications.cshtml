@model List<SCM_System.Models.Entities.Notification>
@{
    ViewData["Title"] = "Intelligence Hub - SCM";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/verification-hub.css" asp-append-version="true" />
}

<div class="notifications-container min-vh-100">
    <div class="page-header d-flex justify-content-between align-items-end">
        <div>
            <h1>Strategic Signals</h1>
            <p>Operational alerts, procurement signals, and fulfillment intelligence</p>
        </div>
        <div>
            <button type="button" class="btn btn-review" onclick="markAllAsRead()">
                <i class="fas fa-check-double me-2"></i> Sync All Signals
            </button>
        </div>
    </div>

    <div class="results-count">
        <i class="fas fa-bell"></i> Showing @(Model?.Count ?? 0) results
    </div>

    <div class="signals-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var notification in Model)
            {
                <div class="signal-card @(!notification.IsRead ? "unread" : "opacity-75")" id="notif-@notification.Id">
                    <div class="signal-card-content">
                        <div class="signal-info">
                            <div class="signal-title">@notification.Title</div>
                            <div class="signal-message">@notification.Message</div>
                            <div class="signal-meta">
                                <span><i class="far fa-calendar-alt"></i> @notification.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <span class="time-ago"><i class="far fa-clock"></i> @GetTimeAgo(notification.CreatedAt)</span>
                            </div>
                        </div>
                        <div class="signal-actions d-flex flex-column gap-2">
                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                            {
                                <button class="btn-review" onclick="location.href='@notification.ActionUrl'">
                                    Process Action →
                                </button>
                            }
                            @if (!notification.IsRead)
                            {
                                <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="markAsRead(@notification.Id)" style="font-size: 11px;">
                                    Acknowledge
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-bell-slash fa-3x text-muted opacity-25 mb-3"></i>
                <h4 class="text-muted">System Synchronized</h4>
                <p class="text-muted small">No new signals detected in your sector.</p>
            </div>
        }
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{diff.Days}d ago";
    }
}

@section Scripts {
    <script>
        function markAsRead(id) {
            $.post('/Notification/MarkAsRead', { id: id }, function(res) {
                if(res.success) {
                    $(`#notif-${id}`).removeClass('unread').addClass('opacity-75');
                    $(`#notif-${id} button[onclick^="markAsRead"]`).fadeOut();
                    toastr.success('Signal acknowledged');
                }
            });
        }

        function markAllAsRead() {
            $.post('/Notification/MarkAllAsRead', function(res) {
                if(res.success) {
                    toastr.success('All signals synchronized');
                    location.reload();
                }
            });
        }
    </script>
}
