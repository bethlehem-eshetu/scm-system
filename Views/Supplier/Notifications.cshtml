@model List<SCM_System.Models.Entities.Notification>

@{
    ViewData["Title"] = "Intelligence Hub - SCM";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 min-vh-100 supplier-notifications-container">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-4 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h3 class="text-white mb-1 fw-bold"><i class="fas fa-radar text-accent-green me-3"></i>Strategic Signals</h3>
                            <p class="text-white-50 mb-0 opacity-75 small">Operational alerts, procurement signals, and fulfillment intelligence.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-accent-green text-dark-green rounded-pill px-3 py-2 small shadow-sm fw-bold border-0" onclick="markAllAsRead()">
                                <i class="fas fa-check-double me-2"></i> Sync All Signals
                            </button>
                        </div>
                    </div>
                    <!-- Background Decoration -->
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-satellite-dish fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtration & Controls -->
    <div class="row mb-4">
        <div class="col-xl-9 mx-auto">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white p-3 rounded-pill shadow-sm border px-4">
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted extra-small fw-bold me-2 ls-1 uppercase">Sector Filter:</span>
                    <button class="btn btn-dark-green btn-sm rounded-pill px-3 fw-bold filter-btn active" data-filter="all">All</button>
                    <button class="btn btn-soft-success btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Success">Success</button>
                    <button class="btn btn-soft-warning btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Warning">Warnings</button>
                    <button class="btn btn-soft-danger btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Error">Errors</button>
                </div>
                <div class="search-mini position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted extra-small"></i>
                    <input type="text" id="signalSearch" class="form-control form-control-sm border-0 bg-faint-green rounded-pill ps-5" placeholder="Search signals..." style="width: 200px;">
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications List -->
    <div class="row g-4">
        <div class="col-xl-9 mx-auto">
            <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                <div class="card-header bg-faint-green py-3 px-4 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-stream text-accent-green me-2"></i>Live Feed</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5 my-5">
                            <div class="bg-faint-green text-dark-green rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                                <i class="fas fa-bell-slash fa-3x opacity-25"></i>
                            </div>
                            <h4 class="fw-bold text-dark-green">System Synchronized</h4>
                            <p class="text-muted small fw-bold opacity-50">No new signals detected in your sector.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var n in Model)
                            {
                                <div class="list-group-item px-4 py-3 border-faint transition-all notification-item @(!n.IsRead ? "bg-signal-unread" : "")" id="notif-@n.Id" data-type="@n.Type">
                                    <div class="d-flex gap-4">
                                        <div class="signal-icon rounded-4 d-flex align-items-center justify-content-center flex-shrink-0 @(n.Type == "Success" ? "bg-soft-success text-success" : n.Type == "Error" ? "bg-soft-danger text-danger" : n.Type == "Warning" ? "bg-soft-warning text-warning" : "bg-soft-info text-info")" style="width: 44px; height: 44px;">
                                            @if (n.Type == "Success") { <i class="fas fa-check-circle"></i> }
                                            else if (n.Type == "Error") { <i class="fas fa-times-circle"></i> }
                                            else if (n.Type == "Warning") { <i class="fas fa-exclamation-triangle"></i> }
                                            else { <i class="fas fa-info-circle"></i> }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <h6 class="fw-bold text-dark-green mb-0">@n.Title</h6>
                                                    @if (!n.IsRead) { <span class="signal-dot"></span> }
                                                </div>
                                                <span class="extra-small text-muted fw-bold text-uppercase ls-1">@GetTimeAgo(n.CreatedAt)</span>
                                            </div>
                                            <p class="text-muted small fw-bold mb-3 opacity-75">@n.Message</p>
                                            <div class="d-flex gap-2">
                                                @if (!string.IsNullOrEmpty(n.ActionUrl))
                                                {
                                                    <a href="@n.ActionUrl" class="btn btn-dark-green btn-sm rounded-pill px-4 fw-bold extra-small text-accent-green">
                                                        PROCESS ACTION
                                                    </a>
                                                }
                                                @if (!n.IsRead)
                                                {
                                                    <button class="btn btn-faint-green btn-sm rounded-pill px-4 fw-bold extra-small text-dark-green" onclick="markAsRead(@n.Id)">
                                                        ACKNOWLEDGE
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}M AGO";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}H AGO";
        return dt.ToString("MMM dd").ToUpper();
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .btn-dark-green { background-color: var(--dark-green); color: white; }
        .btn-accent-green { background-color: var(--accent-green); color: var(--dark-green); }
        .btn-accent-green:hover { background-color: #c4e05d; transform: translateY(-2px); }

        .rounded-5 { border-radius: 16px !important; }
        .shadow-premium { box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 0.5px; }
        .extra-small { font-size: 0.62rem; }

        .supplier-notifications-container {
            zoom: 0.92;
            max-width: 1450px;
            margin: auto;
        }

        .btn {
            font-size: 0.85rem;
        }

        body {
            font-size: 0.92rem;
        }

        h1, .h1 { font-size: 1.75rem; }
        h2, .h2 { font-size: 1.5rem; }
        h3, .h3 { font-size: 1.25rem; }
        h4, .h4 { font-size: 1.1rem; }
        h5, .h5 { font-size: 1rem; }
        h6, .h6 { font-size: 0.85rem; }
        .uppercase { text-transform: uppercase; }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .border-faint { border-color: rgba(0,0,0,0.06) !important; }
        .bg-signal-unread { background-color: rgba(26, 61, 49, 0.04); }
        .signal-dot { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; box-shadow: 0 0 10px var(--accent-green); }

        /* Fix invisible words by making muted text darker in light mode */
        .text-muted { color: #4b5563 !important; }
        .text-white-50 { color: rgba(255, 255, 255, 0.7) !important; }
        .opacity-75 { opacity: 0.9 !important; }
        .opacity-50 { opacity: 0.7 !important; }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.08); color: #198754; }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.08); color: #dc3545; }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.08); color: #856404; }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.08); color: #0c5460; }

        .fa-spin-slow { animation: fa-spin 20s infinite linear; }
        .btn-faint-green { background-color: var(--faint-green); border: none; }
        .btn-faint-green:hover { background-color: #e2e6e6; }
    </style>
}

@section Scripts {
    <script>
        // Filtration Logic
        $('.filter-btn').click(function() {
            var filter = $(this).data('filter');
            $('.filter-btn').removeClass('btn-dark-green active').addClass('btn-light');
            $(this).removeClass('btn-light').addClass('btn-dark-green active');

            if (filter === 'all') {
                $('.notification-item').fadeIn();
            } else {
                $('.notification-item').hide();
                $('.notification-item[data-type="' + filter + '"]').fadeIn();
            }
        });

        // Search Logic
        $('#signalSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.notification-item').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        function markAsRead(id) {
            $.post('/Notification/MarkAsRead', { id: id }, function(res) {
                if(res.success) {
                    $(`#notif-${id}`).removeClass('bg-signal-unread');
                    $(`#notif-${id} .signal-dot`).fadeOut();
                    $(`#notif-${id} button[onclick^="markAsRead"]`).fadeOut();
                    toastr.success('Signal acknowledged');
                }
            });
        }

        function markAllAsRead() {
            $.post('/Notification/MarkAllAsRead', function(res) {
                if(res.success) {
                    toastr.success('All signals synchronized');
                    location.reload();
                }
            });
        }
    </script>
}
