@model SCM_System.Models.ViewModels.SupplierSettingsViewModel
@{
    ViewData["Title"] = "Supplier Account Settings";
    Layout = "_SupplierLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-panel p-4 mb-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #0d6efd 100%); border-radius: 1rem;">
                <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="text-white mb-1 fw-bold"><i class="fas fa-user-cog me-2"></i>Control Center</h2>
                        <p class="text-white-50 mb-0">Manage your business profile, security protocols, and operational preferences.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" onclick="location.reload()">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-3 fa-lg"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="p-4 text-center border-bottom border-light">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100px; height: 100px; border: 3px solid #fff; margin: 0 auto;">
                            @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                            {
                                <img src="@Model.ExistingLogo" id="sidebarLogoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                            }
                            else
                            {
                                <i class="fas fa-building fa-2x text-muted"></i>
                            }
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@User.Identity.Name</h5>
                    <div class="d-flex justify-content-center gap-2 mb-0">
                        <span class="badge bg-soft-primary text-primary rounded-pill px-3">Supplier</span>
                        <span class="badge bg-soft-warning text-warning rounded-pill px-3"><i class="fas fa-star me-1"></i>@Model.AverageRating.ToString("F1")</span>
                    </div>
                </div>
                <div class="p-3">
                    <div class="nav flex-column nav-pills nav-pills-custom" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab">
                            <i class="fas fa-id-card me-2 w-20px text-center"></i>Business Profile
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-banking-tab" data-bs-toggle="pill" data-bs-target="#v-pills-banking" type="button" role="tab">
                            <i class="fas fa-university me-2 w-20px text-center"></i>Banking Info
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-employees-tab" data-bs-toggle="pill" data-bs-target="#v-pills-employees" type="button" role="tab">
                            <i class="fas fa-users me-2 w-20px text-center"></i>Employee Hub
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                            <i class="fas fa-shield-alt me-2 w-20px text-center"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-notifications-tab" data-bs-toggle="pill" data-bs-target="#v-pills-notifications" type="button" role="tab">
                            <i class="fas fa-bell me-2 w-20px text-center"></i>Notifications
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-performance-tab" data-bs-toggle="pill" data-bs-target="#v-pills-performance" type="button" role="tab">
                            <i class="fas fa-chart-line me-2 w-20px text-center"></i>Performance
                        </button>
                        <button class="nav-link text-start mb-2 text-danger" id="v-pills-danger-tab" data-bs-toggle="pill" data-bs-target="#v-pills-danger" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle me-2 w-20px text-center"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div class="tab-content" id="v-pills-tabContent">
                
                <!-- 1. Business Profile -->
                <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-primary">Business Profile</h5>
                        </div>
                        <div class="card-body p-4">
                            <form id="mainSettingsForm" asp-action="Settings" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <input type="hidden" asp-for="SupplierId" />
                                <input type="hidden" asp-for="ExistingLogo" />

                                <div class="row g-4">
                                    <!-- Logo Upload -->
                                    <div class="col-12 text-center mb-2">
                                        <div class="position-relative d-inline-block">
                                            <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 120px; height: 120px; border: 4px solid #fff;">
                                                @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                                                {
                                                    <img src="@Model.ExistingLogo" id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                                                }
                                                else
                                                {
                                                    <i class="fas fa-building fa-3x text-muted" id="logoPlaceholder"></i>
                                                    <img id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover d-none" alt="Logo" />
                                                }
                                            </div>
                                            <label for="CompanyLogoFile" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow-sm p-2" style="cursor: pointer;">
                                                <i class="fas fa-camera"></i>
                                            </label>
                                            <input asp-for="CompanyLogoFile" type="file" class="d-none" accept="image/*" onchange="previewImage(this)" />
                                        </div>
                                        <p class="text-muted small mt-2 mb-0">Company Logo (Click camera to change)</p>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="form-label small fw-bold text-muted">Legal Representative Name</label>
                                        <input asp-for="FullName" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label small fw-bold text-muted">Business Email</label>
                                        <input asp-for="Email" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label small fw-bold text-muted">Contact Phone</label>
                                        <input asp-for="Phone" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="WebsiteUrl" class="form-label small fw-bold text-muted">Website URL</label>
                                        <input asp-for="WebsiteUrl" class="form-control rounded-pill bg-light border-0 px-4" placeholder="https://" />
                                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="PickupAddress" class="form-label small fw-bold text-muted">Primary Pickup Address</label>
                                        <input asp-for="PickupAddress" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="PickupAddress" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="CompanyDescription" class="form-label small fw-bold text-muted">Company Description</label>
                                        <textarea asp-for="CompanyDescription" class="form-control rounded-4 bg-light border-0 p-4" rows="4"></textarea>
                                        <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="text-end mt-4 pt-3 border-top border-light">
                                    <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm py-2 fw-bold">
                                        <i class="fas fa-save me-2"></i>Update Profile
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. Banking Information -->
                <div class="tab-pane fade" id="v-pills-banking" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-success">Bank Accounts</h5>
                            <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#bankAccountModal" onclick="resetBankModal()">
                                <i class="fas fa-plus me-1"></i> Add Account
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border-0" id="bankAccountsTable">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase">Bank Name</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Holder</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Account No.</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Status</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in Model.BankAccounts)
                                        {
                                            <tr>
                                                <td class="px-4 fw-bold">@account.BankName</td>
                                                <td>@account.AccountHolderName</td>
                                                <td><code class="text-dark">@account.AccountNumber</code></td>
                                                <td>
                                                    @if (account.IsPrimary)
                                                    {
                                                        <span class="badge bg-soft-success text-success rounded-pill px-3">Primary</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-soft-primary rounded-pill me-1" onclick="editBankAccount(@Json.Serialize(account))">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-soft-danger rounded-pill" onclick="deleteBankAccount(@account.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Employee Management -->
                <div class="tab-pane fade" id="v-pills-employees" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-info">Employee Management</h5>
                            <button type="button" class="btn btn-info text-white btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#employeeModal" onclick="resetEmployeeModal()">
                                <i class="fas fa-plus me-1"></i> Add Employee
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border-0" id="employeesTable">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase">Employee</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Role</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Warehouse</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase">Status</th>
                                            <th class="border-0 py-3 small text-muted text-uppercase text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var emp in Model.Employees)
                                        {
                                            <tr>
                                                <td class="px-4">
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-soft-info text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                                            <i class="fas fa-user small"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold mb-0">@emp.User.FullName</div>
                                                            <small class="text-muted">@emp.Email</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td><span class="small fw-bold">@emp.EmployeeRole</span></td>
                                                <td><span class="small">@(emp.Warehouse?.Name ?? "General")</span></td>
                                                <td>
                                                    <span class="badge @(emp.IsActive ? "bg-soft-success text-success" : "bg-soft-secondary text-secondary") rounded-pill px-3">
                                                        @(emp.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-soft-info rounded-pill me-1" onclick="editEmployee(@Json.Serialize(new { id = emp.Id, fullName = emp.User.FullName, email = emp.Email, phone = emp.Phone, role = emp.EmployeeRole, warehouseId = emp.WarehouseId, isActive = emp.IsActive }))">
                                                        <i class="fas fa-edit text-info"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-soft-danger rounded-pill" onclick="deleteEmployee(@emp.Id)">
                                                        <i class="fas fa-trash text-danger"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Security Hub -->
                <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                    <div class="row g-4">
                        <!-- Password & Appearance -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-header bg-white py-3 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-dark">Password & Preferences</h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="mb-4">
                                        <partial name="_ThemeToggle" />
                                    </div>
                                    <hr class="my-4 border-light">
                                    <h6 class="fw-bold mb-3"><i class="fas fa-key me-2 text-primary"></i>Update Password</h6>
                                    <form asp-action="Settings" method="post">
                                        <div class="row g-3">
                                            <div class="col-md-12">
                                                <label asp-for="CurrentPassword" class="form-label small fw-bold text-muted">Current Password</label>
                                                <input asp-for="CurrentPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" placeholder="Enter current password to verify changes" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="NewPassword" class="form-label small fw-bold text-muted">New Password</label>
                                                <input asp-for="NewPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Confirm New Password</label>
                                                <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                            </div>
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-outline-primary rounded-pill px-4">Update Security</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- 2FA -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white py-3 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-shield-alt me-2"></i>Two-Factor Auth</h5>
                                </div>
                                <div class="card-body p-4 text-center">
                                    <div class="mb-3">
                                        <div class="icon-shape bg-soft-primary text-primary rounded-circle p-3 mb-3 d-inline-flex">
                                            <i class="fas fa-lock fa-2x"></i>
                                        </div>
                                        <p class="text-muted small">Enhance security by requiring a verification code from Google Authenticator.</p>
                                    </div>
                                    <div class="form-check form-switch d-inline-block mb-3">
                                        <input class="form-check-input" type="checkbox" id="twoFactorToggle" @(Model.TwoFactorEnabled ? "checked" : "") onchange="toggle2FA(this)" style="width: 3rem; height: 1.5rem;">
                                        <label class="form-check-label fw-bold ms-2 mt-1" for="twoFactorToggle" id="twoFactorLabel">
                                            @(Model.TwoFactorEnabled ? "2FA Enabled" : "Enable 2FA")
                                        </label>
                                    </div>
                                    <div id="qrCodeContainer" class="d-none mt-3 p-3 bg-light rounded-4 border border-light">
                                        <p class="small fw-bold">Scan with Google Authenticator</p>
                                        <img id="qrCodeImage" src="" alt="QR Code" class="img-fluid mb-2 border rounded shadow-sm" style="max-width: 150px;">
                                        <p class="extra-small text-muted mb-1">Manual entry key:</p>
                                        <code id="manualCodeText" class="d-block bg-white p-2 rounded text-primary fw-bold mb-0"></code>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sessions -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white py-3 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-info"><i class="fas fa-desktop me-2"></i>Active Sessions</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush rounded-bottom-4">
                                        @if (Model.ActiveSessions.Any())
                                        {
                                            @foreach (var session in Model.ActiveSessions)
                                            {
                                                <div class="list-group-item border-0 px-4 py-3 bg-transparent">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center">
                                                            <div class="icon-shape bg-soft-info text-info rounded-pill p-2 me-3">
                                                                <i class="fas fa-laptop small"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold small mb-0">@session.IpAddress</div>
                                                                <small class="text-muted extra-small">Active since @session.LoginTime.ToString("MMM dd, HH:mm")</small>
                                                            </div>
                                                        </div>
                                                        <button class="btn btn-sm btn-soft-danger rounded-pill px-2 py-0" onclick="revokeSession(@session.Id)" title="Terminate session">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="p-4 text-center text-muted small">No other active sessions.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Login History -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-header bg-white py-3 border-bottom border-light">
                                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-history me-2"></i>Recent Logins</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="px-4 py-3 border-0 small text-muted text-uppercase">Time (UTC)</th>
                                                    <th class="py-3 border-0 small text-muted text-uppercase">IP Address</th>
                                                    <th class="py-3 border-0 small text-muted text-uppercase">Device / Browser</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (ViewBag.LoginHistory != null)
                                                {
                                                    foreach (var log in (IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.LoginHistory)
                                                    {
                                                        <tr>
                                                            <td class="px-4 small">@log.PerformedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                                                            <td class="small fw-bold">@log.IpAddress</td>
                                                            <td><span class="extra-small text-muted text-truncate d-inline-block" style="max-width: 300px;" title="@log.UserAgent">@log.UserAgent</span></td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Notifications -->
                <div class="tab-pane fade" id="v-pills-notifications" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-warning">Notification Preferences</h5>
                        </div>
                        <div class="card-body p-4">
                            <form id="notificationsForm">
                                <div class="row g-4">
                                    <div class="col-md-7">
                                        <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">Order Alerts</h6>
                                                    <p class="extra-small text-muted mb-0">Instant notification when you receive new orders.</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="notifyOrderAlert" name="notifyOrderAlert" value="true" @(Model.NotifyOrderAlert ? "checked" : "")>
                                                </div>
                                            </div>
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">Tender Updates</h6>
                                                    <p class="extra-small text-muted mb-0">Get notified when there's activity on your bids.</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="notifyBidAlert" name="notifyBidAlert" value="true" @(Model.NotifyBidAlert ? "checked" : "")>
                                                </div>
                                            </div>
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">Inventory Alerts</h6>
                                                    <p class="extra-small text-muted mb-0">Warnings when stock levels fall below thresholds.</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="notifyLowStockAlert" name="notifyLowStockAlert" value="true" @(Model.NotifyLowStockAlert ? "checked" : "")>
                                                </div>
                                            </div>
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">Payment Status</h6>
                                                    <p class="extra-small text-muted mb-0">Confirmations of disbursements and payouts.</p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="notifyPaymentAlert" name="notifyPaymentAlert" value="true" @(Model.NotifyPaymentAlert ? "checked" : "")>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="card bg-light border-0 rounded-4 h-100">
                                            <div class="card-body p-4">
                                                <h6 class="fw-bold mb-3">Delivery Channel</h6>
                                                <div class="mb-4">
                                                    <select class="form-select rounded-pill border-0 shadow-sm px-4" name="notifyChannel" id="notifyChannel">
                                                        <option value="Email" selected="@(Model.NotifyChannel == "Email")">Email Only</option>
                                                        <option value="SMS" selected="@(Model.NotifyChannel == "SMS")">SMS Only</option>
                                                        <option value="Both" selected="@(Model.NotifyChannel == "Both")">Both Email & SMS</option>
                                                    </select>
                                                </div>
                                                <div class="alert alert-soft-warning border-0 small rounded-4">
                                                    <i class="fas fa-info-circle me-2"></i> Ensure your phone number is verified for SMS delivery.
                                                </div>
                                                <div class="text-end mt-4">
                                                    <button type="submit" class="btn btn-warning text-white rounded-pill px-4 shadow-sm">Save Preferences</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 6. Performance Overview -->
                <div class="tab-pane fade" id="v-pills-performance" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-primary">Key Performance Indicators</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4 text-center">
                                <div class="col-md-3 col-6">
                                    <div class="p-4 bg-soft-primary rounded-4 border-0 shadow-none h-100 d-flex flex-column justify-content-center">
                                        <div class="icon-shape bg-white text-primary rounded-circle p-3 mb-3 mx-auto shadow-sm">
                                            <i class="fas fa-shopping-basket fa-lg"></i>
                                        </div>
                                        <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
                                        <span class="text-muted extra-small fw-bold text-uppercase">Total Orders</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-4 bg-soft-success rounded-4 border-0 shadow-none h-100 d-flex flex-column justify-content-center">
                                        <div class="icon-shape bg-white text-success rounded-circle p-3 mb-3 mx-auto shadow-sm">
                                            <i class="fas fa-coins fa-lg"></i>
                                        </div>
                                        <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("C0")</h3>
                                        <span class="text-muted extra-small fw-bold text-uppercase">Revenue</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-4 bg-soft-info rounded-4 border-0 shadow-none h-100 d-flex flex-column justify-content-center">
                                        <div class="icon-shape bg-white text-info rounded-circle p-3 mb-3 mx-auto shadow-sm">
                                            <i class="fas fa-shipping-fast fa-lg"></i>
                                        </div>
                                        <h3 class="fw-bold mb-0">@Model.OnTimeDeliveryRate.ToString("0")%</h3>
                                        <span class="text-muted extra-small fw-bold text-uppercase">On-Time Rate</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-4 bg-soft-warning rounded-4 border-0 shadow-none h-100 d-flex flex-column justify-content-center">
                                        <div class="icon-shape bg-white text-warning rounded-circle p-3 mb-3 mx-auto shadow-sm">
                                            <i class="fas fa-star fa-lg"></i>
                                        </div>
                                        <h3 class="fw-bold mb-0">@Model.AverageRating.ToString("0.0")</h3>
                                        <span class="text-muted extra-small fw-bold text-uppercase">Avg Rating</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. Danger Zone -->
                <div class="tab-pane fade" id="v-pills-danger" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 border-top border-danger border-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Critical Actions</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-4 border-bottom border-light gap-3">
                                <div>
                                    <h6 class="fw-bold mb-1">Export Business Archive</h6>
                                    <p class="text-muted small mb-0">Download a full CSV export of your orders, staff, and financial records.</p>
                                </div>
                                <form asp-action="ExportData" method="post">
                                    <button type="submit" class="btn btn-outline-dark rounded-pill px-4">
                                        <i class="fas fa-download me-2"></i>Export All Data
                                    </button>
                                </form>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <h6 class="text-danger fw-bold mb-1">Deactivate Provider Account</h6>
                                    <p class="text-muted small mb-0">Temporarily suspend your presence on the platform. This action is sensitive.</p>
                                </div>
                                <button class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                    Deactivate Account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modals (Kept mostly as is for functional consistency) -->

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deactivation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="icon-shape bg-soft-danger text-danger rounded-circle p-4 mb-4 d-inline-flex">
                    <i class="fas fa-user-slash fa-3x"></i>
                </div>
                <h5 class="fw-bold text-danger">Wait! Are you sure?</h5>
                <p class="text-muted">Deactivating your account will hide your products and pause all current operations.</p>
                <div class="mb-4 text-start">
                    <label class="form-label small fw-bold text-muted">Confirm with Password</label>
                    <input type="password" id="deactivatePassword" class="form-control rounded-pill bg-light border-0 px-4" placeholder="Enter your password" />
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-pill flex-grow-1 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-pill flex-grow-1 py-2 fw-bold" onclick="confirmDeactivation()">Deactivate Now</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bank Account Modal -->
<div class="modal fade" id="bankAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form id="bankAccountForm">
                <input type="hidden" name="Id" id="bank_id" />
                <div class="modal-header bg-success text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="bankModalTitle">Add Bank Account</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Bank Name</label>
                            <input type="text" name="BankName" id="bank_name" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Account Holder Name</label>
                            <input type="text" name="AccountHolderName" id="bank_holder" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Account Number</label>
                            <input type="text" name="AccountNumber" id="bank_number" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Branch Name</label>
                            <input type="text" name="Branch" id="bank_branch" class="form-control rounded-pill bg-light border-0 px-4" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">SWIFT / BIC Code</label>
                            <input type="text" name="SwiftCode" id="bank_swift" class="form-control rounded-pill bg-light border-0 px-4" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="IsPrimary" value="true" id="bank_primary">
                                <label class="form-check-label small fw-bold ms-2" for="bank_primary">Set as Primary Settlement Account</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4 p-3">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold me-auto" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Employee Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form id="employeeForm">
                <input type="hidden" name="id" id="emp_id" />
                <div class="modal-header bg-info text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="empModalTitle">Add Staff Member</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Full Name</label>
                            <input type="text" name="fullName" id="emp_name" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <input type="email" name="email" id="emp_email" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Phone Number</label>
                            <input type="text" name="phone" id="emp_phone" class="form-control rounded-pill bg-light border-0 px-4" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Designated Role</label>
                            <select name="role" id="emp_role" class="form-select rounded-pill bg-light border-0 px-4" required>
                                <option value="warehouse_manager">Warehouse Manager</option>
                                <option value="delivery_agent">Delivery Agent</option>
                                <option value="support">Support Staff</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Warehouse Assignment</label>
                            <select name="warehouseId" id="emp_warehouse" class="form-select rounded-pill bg-light border-0 px-4" asp-items="ViewBag.Warehouses">
                                <option value="">Global / Head Office</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="emp_active" checked>
                                <label class="form-check-label small fw-bold ms-2" for="emp_active">Grant Active System Access</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4 p-3">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold me-auto" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 shadow-sm">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

