@model SCM_System.Models.ViewModels.SupplierSettingsViewModel
@{
    ViewData["Title"] = "SCM Account Control Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 min-vh-100 supplier-settings-container">
    <!-- Premium Strategic Header (SCM Style) -->
    <div class="row mb-4 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-4 rounded-5 shadow-premium border-0 position-relative overflow-hidden dark-mode-banner">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="position-relative z-index-2 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="text-white">
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-user-cog me-2 text-accent-green"></i>Account <span class="text-accent-green">Control Center</span>
                        </h2>
                        <p class="text-white text-opacity-75 mb-0 small">Manage your business profile, security protocols, and operational preferences.</p>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-glass rounded-pill px-4 py-2 shadow-sm fw-bold d-flex align-items-center gap-2 dark-mode-glass-btn" onclick="location.reload()">
                            <i class="fas fa-sync-alt"></i> Refresh Data
                        </button>
                    </div>
                </div>
                <div class="position-absolute top-0 end-0 p-5 opacity-10 text-white">
                    <i class="fas fa-cog fa-10x fa-spin-slow"></i>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert bg-dark-green text-white alert-dismissible fade show shadow-premium border-0 rounded-4 mb-5 p-4 dark-mode-alert" role="alert">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-10 text-accent-green rounded-circle p-3 me-3">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <div class="fw-bold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-premium rounded-5 sticky-top bg-white overflow-hidden dark-mode-sidebar" style="top: 20px;">
                <div class="p-4 text-center border-bottom border-faint bg-faint-green dark-mode-sidebar-header">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-white rounded-circle shadow-premium d-flex align-items-center justify-content-center overflow-hidden border border-4 border-white dark-mode-avatar" style="width: 100px; height: 100px; margin: 0 auto;">
                            <img src="@(string.IsNullOrEmpty(Model.ExistingLogo) ? "/img/default-company.png" : Model.ExistingLogo)" 
                                 id="sidebarLogoPreview" 
                                 class="img-fluid h-100 w-100 object-fit-cover" 
                                 alt="Logo" />
                        </div>
                        <div class="position-absolute bottom-0 end-0 bg-accent-green text-dark-green rounded-circle p-2 shadow-sm border border-white">
                            <i class="fas fa-check-circle extra-small"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark-green mb-1 dark-mode-text">@Model.FullName</h5>
                    <div class="d-flex justify-content-center gap-2 mb-0">
                        <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 extra-small ls-1 uppercase fw-bold dark-mode-badge">Active Supplier</span>
                    </div>
                </div>
                <div class="p-3 bg-white dark-mode-sidebar-body">
                    <div class="nav flex-column nav-pills scm-pills small" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2 rounded-pill px-4 py-2 fw-bold transition-all dark-mode-nav-link" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab">
                            <i class="fas fa-id-card me-3 text-center opacity-75"></i>Business Profile
                        </button>
                        <button class="nav-link text-start mb-2 rounded-pill px-4 py-2 fw-bold transition-all dark-mode-nav-link" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                            <i class="fas fa-shield-alt me-3 text-center opacity-75"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-2 rounded-pill px-4 py-2 fw-bold transition-all text-danger dark-mode-nav-link-danger" id="v-pills-danger-tab" data-bs-toggle="pill" data-bs-target="#v-pills-danger" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle me-3 text-center opacity-75"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div class="tab-content" id="v-pills-tabContent">
                
                <!-- 1. Business Profile -->
                <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
                    <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden dark-mode-card">
                        <div class="card-header bg-faint-green py-3 px-4 border-0 dark-mode-card-header">
                            <h6 class="mb-0 fw-bold text-dark-green dark-mode-text text-uppercase ls-1"><i class="fas fa-briefcase text-accent-green me-2"></i>Business Identity</h6>
                        </div>
                        <div class="card-body p-4 dark-mode-card-body">
                            <form id="mainSettingsForm" asp-action="Settings" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-soft-danger rounded-4 extra-small fw-bold"></div>
                                <input type="hidden" asp-for="SupplierId" />
                                <input type="hidden" asp-for="ExistingLogo" />

                                <div class="row g-4">
                                    <!-- Logo Upload -->
                                    <div class="col-12 text-center mb-5">
                                        <div class="position-relative d-inline-block">
                                            <div class="rounded-circle shadow-inner d-flex align-items-center justify-content-center overflow-hidden border border-4 dark-mode-logo-box" style="width: 140px; height: 140px; background-color: var(--table-header-bg); border-color: var(--table-border) !important;">
                                                @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                                                {
                                                    <img src="@Model.ExistingLogo" id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                                                }
                                                else
                                                {
                                                    <i class="fas fa-building fa-3x text-muted opacity-25 dark-mode-icon" id="logoPlaceholder"></i>
                                                    <img id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover d-none" alt="Logo" />
                                                }
                                            </div>
                                            <label for="profilePictureInput" class="btn btn-dark-green btn-sm position-absolute bottom-0 end-0 rounded-circle shadow-premium p-3 border border-3 border-white dark-mode-upload-btn" style="cursor: pointer;">
                                                <i class="fas fa-camera text-accent-green"></i>
                                            </label>
                                            <form id="profilePicForm" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="d-none">
                                                <input type="file" id="profilePictureInput" name="profilePicture" accept="image/*" onchange="previewImage(this); document.getElementById('profilePicForm').submit();" />
                                            </form>
                                        </div>
                                        <p class="text-muted small mt-3 fw-bold opacity-75 text-dark-green dark-mode-text">Corporate Identity Asset</p>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Legal Representative</label>
                                        <input asp-for="FullName" class="form-control scm-input dark-mode-input" placeholder="Representative Name" />
                                        <span asp-validation-for="FullName" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Business Email</label>
                                        <input asp-for="Email" class="form-control scm-input dark-mode-input" placeholder="corporate@domain.com" />
                                        <span asp-validation-for="Email" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Primary Contact</label>
                                        <input asp-for="Phone" class="form-control scm-input dark-mode-input" placeholder="+251 ..." />
                                        <span asp-validation-for="Phone" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="WebsiteUrl" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Web Portal</label>
                                        <input asp-for="WebsiteUrl" class="form-control scm-input dark-mode-input" placeholder="https://www.yourbusiness.com" />
                                        <span asp-validation-for="WebsiteUrl" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="PickupAddress" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Primary Logistics Hub</label>
                                        <input asp-for="PickupAddress" class="form-control scm-input dark-mode-input" placeholder="Detailed Warehouse Address" />
                                        <span asp-validation-for="PickupAddress" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="CompanyDescription" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Strategic Overview</label>
                                        <textarea asp-for="CompanyDescription" class="form-control scm-input rounded-5 p-4 dark-mode-textarea" rows="4" placeholder="Briefly describe your market position and supply capabilities..."></textarea>
                                        <span asp-validation-for="CompanyDescription" class="text-danger extra-small fw-bold"></span>
                                    </div>
                                </div>

                                <div class="text-end mt-4 pt-4 border-top border-faint dark-mode-border">
                                    <button type="submit" class="btn btn-dark-green px-5 rounded-pill shadow-premium py-2 fw-bold dark-mode-primary-btn small">
                                        <i class="fas fa-save me-2 text-accent-green"></i>Commit Profile Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. Financial Setup -->
                <div class="tab-pane fade" id="v-pills-finance" role="tabpanel">
                    <div class="card border-0 shadow-premium rounded-5 overflow-hidden theme-card">
                        <div class="card-header py-4 px-5 border-0 d-flex justify-content-between align-items-center dark-mode-card-header" style="background-color: var(--table-header-bg);">
                            <h5 class="mb-0 fw-bold text-dark-green dark-mode-text"><i class="fas fa-university text-accent-green me-2"></i>Treasury & Banking</h5>
                            <button type="button" class="btn btn-dark-green btn-sm rounded-pill px-4 py-2 shadow-sm fw-bold extra-small dark-mode-primary-btn" data-bs-toggle="modal" data-bs-target="#bankAccountModal">
                                <i class="fas fa-plus me-2 text-accent-green"></i> Register Account
                            </button>
                        </div>
                        <div class="card-body p-5 dark-mode-card-body">
                             <!-- Financial Setup Content -->
                             <div class="table-responsive">
                                <table class="table table-hover align-middle border-0 dark-mode-table">
                                    <thead>
                                        <tr class="dark-mode-thead" style="background-color: var(--table-header-bg);">
                                            <th class="border-0 rounded-start-pill ps-4 py-3 extra-small fw-bold text-muted uppercase dark-mode-text">Bank Entity</th>
                                            <th class="border-0 py-3 extra-small fw-bold text-muted uppercase dark-mode-text">Account Holder</th>
                                            <th class="border-0 py-3 extra-small fw-bold text-muted uppercase dark-mode-text">Ledger Number</th>
                                            <th class="border-0 py-3 extra-small fw-bold text-muted uppercase dark-mode-text">Status</th>
                                            <th class="border-0 rounded-end-pill pe-4 py-3 extra-small fw-bold text-muted uppercase dark-mode-text">Control</th>
                                        </tr>
                                    </thead>
                                    <tbody class="border-0 dark-mode-tbody">
                                        @foreach (var account in Model.BankAccounts)
                                        {
                                            <tr class="border-bottom border-faint dark-mode-row">
                                                <td class="ps-4 py-4 fw-bold text-dark-green dark-mode-text">
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-faint-green p-2 rounded-3 me-3 text-dark-green shadow-sm dark-mode-icon-box">
                                                            <i class="fas fa-landmark small"></i>
                                                        </div>
                                                        @account.BankName
                                                    </div>
                                                </td>
                                                <td class="fw-bold opacity-75 dark-mode-text">@account.AccountHolderName</td>
                                                <td><code class="bg-faint-green p-2 rounded-3 text-dark-green fw-bold dark-mode-ref-badge">@account.AccountNumber</code></td>
                                                <td>
                                                    @if (account.IsPrimary)
                                                    {
                                                        <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 extra-small fw-bold dark-mode-badge">Primary</span>
                                                    }
                                                    else {
                                                        <span class="badge bg-soft-primary text-primary rounded-pill px-3 py-2 extra-small fw-bold dark-mode-status">Secondary</span>
                                                    }
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <button class="btn btn-sm btn-faint-green rounded-circle shadow-sm dark-mode-view-btn" onclick="editBankAccount(@Json.Serialize(account))">
                                                        <i class="fas fa-edit text-dark-green"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Security Hub -->
                <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                    <div class="card border-0 shadow-premium rounded-5 overflow-hidden theme-card">
                        <div class="card-header py-4 px-5 border-0 dark-mode-card-header" style="background-color: var(--table-header-bg);">
                            <h5 class="mb-0 fw-bold text-dark-green dark-mode-text"><i class="fas fa-key text-accent-green me-2"></i>Access & Appearance</h5>
                        </div>
                        <div class="card-body p-5 dark-mode-card-body">
                            <div class="mb-5 p-4 rounded-5 d-flex align-items-center justify-content-between shadow-inner dark-mode-security-box" style="background-color: var(--table-header-bg);">
                                <div class="d-flex align-items-center">
                                    <div class="bg-white p-3 rounded-circle shadow-sm me-4 text-dark-green dark-mode-icon-box">
                                        <i class="fas fa-moon"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark-green mb-1 dark-mode-text">Visual Mode</h6>
                                        <p class="text-muted extra-small mb-0 fw-bold dark-mode-text">Toggle between Light and Deep Space themes</p>
                                    </div>
                                </div>
                                <partial name="_ThemeToggle" />
                            </div>
                            <!-- Password Change Form -->
                            <form asp-action="Settings" method="post">
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <label asp-for="CurrentPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Current Identity Verification</label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control scm-input dark-mode-input" placeholder="Verify current password" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">New Access Code</label>
                                        <input asp-for="NewPassword" type="password" class="form-control scm-input dark-mode-input" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmPassword" class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Confirm New Access Code</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control scm-input dark-mode-input" />
                                    </div>
                                    <div class="col-12 text-end mt-4">
                                        <button type="submit" class="btn btn-dark-green rounded-pill px-5 py-3 fw-bold shadow-premium dark-mode-primary-btn">
                                            Update Security Protocol
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 3. Danger Zone -->
                <div class="tab-pane fade" id="v-pills-danger" role="tabpanel">
                    <div class="card border-0 shadow-premium rounded-5 border-top border-5 border-danger overflow-hidden theme-card">
                        <div class="card-header bg-soft-danger py-4 px-5 border-0 dark-mode-danger-header">
                            <h5 class="mb-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Strategic Termination</h5>
                        </div>
                        <div class="card-body p-5 dark-mode-card-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 pb-5 border-bottom border-faint gap-4 dark-mode-border">
                                <div class="max-w-500">
                                    <h6 class="fw-bold text-dark-green mb-2 dark-mode-text">Corporate Data Export</h6>
                                    <p class="text-muted small mb-0 fw-bold opacity-75 dark-mode-text">Generate a complete encrypted archive of your transaction history, staff logs, and financial ledgers.</p>
                                </div>
                                <form asp-action="ExportData" method="post">
                                    <button type="submit" class="btn btn-white border border-faint rounded-pill px-5 py-3 shadow-sm fw-bold text-dark-green dark-mode-export-btn">
                                        <i class="fas fa-download me-2 text-accent-green"></i>Secure Export
                                    </button>
                                </form>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
                                <div class="max-w-500">
                                    <h6 class="text-danger fw-bold mb-2">Account Deactivation</h6>
                                    <p class="text-muted small mb-0 fw-bold opacity-75 dark-mode-text">Suspend your platform presence. Your catalog and profile will be hidden from retail entities until reactivation.</p>
                                </div>
                                <button class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow-premium dark-mode-deactivate-btn" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                    Deactivate Access
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Deactivation -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden dark-mode-modal">
            <div class="modal-header border-0 p-5 pb-0">
                <h5 class="modal-title fw-bold text-danger dark-mode-text">Identity Verification Required</h5>
                <button type="button" class="btn-close dark-mode-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-5 text-center dark-mode-modal-body">
                <div class="bg-soft-danger text-danger rounded-circle p-4 mb-4 d-inline-flex shadow-inner">
                    <i class="fas fa-user-shield fa-3x"></i>
                </div>
                <p class="fw-bold text-dark-green mb-4 dark-mode-text">Please enter your master password to authorize account deactivation.</p>
                <input type="password" id="deactivatePassword" class="form-control scm-input text-center dark-mode-input" placeholder="Master Password" />
            </div>
            <div class="modal-footer border-0 p-5 pt-0 dark-mode-modal-footer">
                <button type="button" class="btn btn-white rounded-pill px-4 py-2 border fw-bold text-muted dark-mode-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm dark-mode-confirm-btn" onclick="confirmDeactivation()">Authorize Deactivation</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .welcome-banner { position: relative; border-radius: 40px !important; }
        .banner-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.05; z-index: 1; }
        .banner-glow { position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(212, 240, 109, 0.1) 0%, transparent 70%); filter: blur(50px); z-index: 1; }
        .btn-glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); color: white; border-radius: 20px; transition: all 0.3s; }
        .btn-glass:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }

        .rounded-5 { border-radius: 16px !important; }
        .shadow-premium { box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 0.5px; }
        .extra-small { font-size: 0.62rem; }

        .supplier-settings-container {
            zoom: 0.92;
            max-width: 1450px;
            margin: auto;
        }

        .btn {
            font-size: 0.85rem;
        }

        body {
            font-size: 0.92rem;
        }

        h1, .h1 { font-size: 1.75rem; }
        h2, .h2 { font-size: 1.5rem; }
        h3, .h3 { font-size: 1.25rem; }
        h4, .h4 { font-size: 1.1rem; }
        h5, .h5 { font-size: 1rem; }
        h6, .h6 { font-size: 0.85rem; }

        .shadow-inner { box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .scm-pills .nav-link { color: var(--dark-green); border: 1px solid transparent; opacity: 0.7; }
        .scm-pills .nav-link:hover { background-color: var(--faint-green); opacity: 1; }
        .scm-pills .nav-link.active { background-color: var(--dark-green); color: var(--accent-green); opacity: 1; box-shadow: 0 5px 15px rgba(26, 61, 49, 0.2); }

        .scm-input { background-color: var(--table-header-bg); border: 2px solid transparent; border-radius: 100px; padding: 0.8rem 1.5rem; font-weight: 600; color: var(--table-text); transition: all 0.3s ease; }
        .scm-input:focus { background-color: var(--card-bg); border-color: var(--accent-green); box-shadow: 0 5px 20px rgba(212, 240, 109, 0.15); outline: none; }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.05); color: #198754; }

        .btn-white { background: white; color: var(--dark-green); border: 1px solid #eee; }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }

        .fa-spin-slow { animation: fa-spin 10s infinite linear; }
        .max-w-500 { max-width: 500px; }
        .object-fit-cover { object-fit: cover; }
