@model SCM_System.Models.ViewModels.SupplierSettingsViewModel
@{
    ViewData["Title"] = "Supplier Account Settings";
    Layout = "_SupplierLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-panel p-4 mb-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #0d6efd 100%); border-radius: 1rem;">
                <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="text-white mb-1 fw-bold"><i class="fas fa-user-cog me-2"></i>Control Center</h2>
                        <p class="text-white-50 mb-0">Manage your business profile, security protocols, and operational preferences.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-3 fa-lg"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="p-4 text-center border-bottom border-light">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100px; height: 100px; border: 3px solid #fff; margin: 0 auto;">
                            @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                            {
                                <img src="@Model.ExistingLogo" id="sidebarLogoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                            }
                            else
                            {
                                <i class="fas fa-building fa-2x text-muted"></i>
                            }
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@User.Identity.Name</h5>
                    <div class="d-flex justify-content-center gap-2 mb-0">
                        <span class="badge bg-soft-primary text-primary rounded-pill px-3">Supplier</span>
                    </div>
                </div>
                <div class="p-3">
                    <div class="nav flex-column nav-pills nav-pills-custom" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab">
                            <i class="fas fa-id-card me-2 w-20px text-center"></i>Business Profile
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-finance-tab" data-bs-toggle="pill" data-bs-target="#v-pills-finance" type="button" role="tab">
                            <i class="fas fa-university me-2 w-20px text-center"></i>Financial Setup
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                            <i class="fas fa-shield-alt me-2 w-20px text-center"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-2 text-danger" id="v-pills-danger-tab" data-bs-toggle="pill" data-bs-target="#v-pills-danger" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle me-2 w-20px text-center"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div class="tab-content" id="v-pills-tabContent">
                
                <!-- 1. Business Profile -->
                <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-primary">Business Profile</h5>
                        </div>
                        <div class="card-body p-4">
                            <form id="mainSettingsForm" asp-action="Settings" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <input type="hidden" asp-for="SupplierId" />
                                <input type="hidden" asp-for="ExistingLogo" />

                                <div class="row g-4">
                                    <div class="col-12 text-center mb-2">
                                        <div class="position-relative d-inline-block">
                                            <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 120px; height: 120px; border: 4px solid #fff;">
                                                @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                                                {
                                                    <img src="@Model.ExistingLogo" id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                                                }
                                                else
                                                {
                                                    <i class="fas fa-building fa-3x text-muted" id="logoPlaceholder"></i>
                                                    <img id="logoPreview" class="img-fluid h-100 w-100 object-fit-cover d-none" alt="Logo" />
                                                }
                                            </div>
                                            <label for="CompanyLogoFile" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow-sm p-2" style="cursor: pointer;">
                                                <i class="fas fa-camera"></i>
                                            </label>
                                            <input asp-for="CompanyLogoFile" type="file" class="d-none" accept="image/*" onchange="previewImage(this)" />
                                        </div>
                                        <p class="text-muted small mt-2 mb-0">Company Logo</p>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="form-label small fw-bold text-muted">Legal Representative Name</label>
                                        <input asp-for="FullName" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label small fw-bold text-muted">Business Email</label>
                                        <input asp-for="Email" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label small fw-bold text-muted">Contact Phone</label>
                                        <input asp-for="Phone" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="WebsiteUrl" class="form-label small fw-bold text-muted">Website URL</label>
                                        <input asp-for="WebsiteUrl" class="form-control rounded-pill bg-light border-0 px-4" placeholder="https://" />
                                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="PickupAddress" class="form-label small fw-bold text-muted">Primary Pickup Address</label>
                                        <input asp-for="PickupAddress" class="form-control rounded-pill bg-light border-0 px-4" />
                                        <span asp-validation-for="PickupAddress" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="CompanyDescription" class="form-label small fw-bold text-muted">Company Description</label>
                                        <textarea asp-for="CompanyDescription" class="form-control rounded-4 bg-light border-0 p-4" rows="4"></textarea>
                                        <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="text-end mt-4 pt-3 border-top border-light">
                                    <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm py-2 fw-bold">
                                        <i class="fas fa-save me-2"></i>Update Profile
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. Financial Setup -->
                <div class="tab-pane fade" id="v-pills-finance" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-success">Bank Accounts</h5>
                            <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#bankAccountModal" onclick="resetBankModal()">
                                <i class="fas fa-plus me-1"></i> Add Account
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Bank Name</th>
                                            <th>Account Holder</th>
                                            <th>Account Number</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in Model.BankAccounts)
                                        {
                                            <tr>
                                                <td class="fw-bold">@account.BankName</td>
                                                <td>@account.AccountHolderName</td>
                                                <td><code>@account.AccountNumber</code></td>
                                                <td>
                                                    @if (account.IsPrimary)
                                                    {
                                                        <span class="badge bg-soft-success text-success rounded-pill px-3">Primary</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-soft-primary rounded-circle me-1" onclick="editBankAccount(@Json.Serialize(account))">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Security Hub -->
                <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-dark">Password & Preferences</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-4">
                                <partial name="_ThemeToggle" />
                            </div>
                            <hr class="my-4 border-light">
                            <form asp-action="Settings" method="post">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label asp-for="CurrentPassword" class="form-label small fw-bold text-muted">Current Password</label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NewPassword" class="form-label small fw-bold text-muted">New Password</label>
                                        <input asp-for="NewPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Confirm New Password</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill bg-light border-0 px-4" />
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-outline-primary rounded-pill px-4">Update Security</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 4. Danger Zone -->
                <div class="tab-pane fade" id="v-pills-danger" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 border-top border-danger border-4">
                        <div class="card-header bg-white py-3 border-bottom border-light">
                            <h5 class="mb-0 fw-bold text-danger">Critical Actions</h5>
                        </div>
                        <div class="card-body p-4 text-center">
                            <div class="mb-5">
                                <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                                <h5>Be careful here</h5>
                                <p class="text-muted">These actions cannot be easily undone.</p>
                            </div>
                            <button class="btn btn-danger rounded-pill px-5 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                Deactivate Account
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-soft-primary { background-color: rgba(13, 110, 253, 0.1); }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .nav-pills-custom .nav-link { border-radius: 0.75rem; padding: 0.8rem 1.2rem; color: #6c757d; transition: all 0.3s ease; border: none; background: none; }
        .nav-pills-custom .nav-link.active { background-color: #0d6efd; color: white; }
        .glass-panel { border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#logoPreview').attr('src', e.target.result).removeClass('d-none');
                    $('#logoPlaceholder').addClass('d-none');
                    $('#sidebarLogoPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
