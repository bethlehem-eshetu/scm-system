@model SCM_System.Models.ViewModels.SupplierSettingsViewModel
@{
    ViewData["Title"] = "Supplier Account Settings";
    Layout = "_SupplierLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-panel p-4 mb-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #0d6efd 100%); border-radius: 1rem;">
                <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="text-white mb-1 fw-bold"><i class="fas fa-user-cog me-2"></i>Control Center</h2>
                        <p class="text-white-50 mb-0">Manage your business profile, security protocols, and operational preferences.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" onclick="location.reload()">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-3 fa-lg"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="p-4 text-center border-bottom border-light">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100px; height: 100px; border: 3px solid #fff; margin: 0 auto;">
                            @if (!string.IsNullOrEmpty(Model.ExistingLogo))
                            {
                                <img src="@Model.ExistingLogo" id="sidebarLogoPreview" class="img-fluid h-100 w-100 object-fit-cover" alt="Logo" />
                            }
                            else
                            {
                                <i class="fas fa-building fa-2x text-muted"></i>
                            }
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@User.Identity.Name</h5>
                    <div class="d-flex justify-content-center gap-2 mb-0">
                        <span class="badge bg-soft-primary text-primary rounded-pill px-3">Supplier</span>
                    </div>
                </div>
                <div class="p-3">
                    <div class="nav flex-column nav-pills nav-pills-custom" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab">
                            <i class="fas fa-id-card me-2 w-20px text-center"></i>Business Profile
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-finance-tab" data-bs-toggle="pill" data-bs-target="#v-pills-finance" type="button" role="tab">
                            <i class="fas fa-university me-2 w-20px text-center"></i>Financial Setup
                        </button>
                        <button class="nav-link text-start mb-2" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab">
                            <i class="fas fa-shield-alt me-2 w-20px text-center"></i>Security Hub
                        </button>
                        <button class="nav-link text-start mb-2 text-danger" id="v-pills-danger-tab" data-bs-toggle="pill" data-bs-target="#v-pills-danger" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle me-2 w-20px text-center"></i>Danger Zone
                        </button>
                    </div>
                </div>
            </div>
        </div>

