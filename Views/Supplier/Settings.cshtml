@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#logoPreview').attr('src', e.target.result).removeClass('d-none');
                    $('#logoPlaceholder').addClass('d-none');
                    $('#sidebarLogoPreview').attr('src', e.target.result);
                    toastr.info("Logo preview updated. Syncing with server...");
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function confirmDeactivation() {
            var password = document.getElementById('deactivatePassword').value;
            if (!password) {
                alert('Please enter your password to deactivate your account.');
                return;
            }
            // Add your deactivation logic here
            if (confirm('Are you sure you want to deactivate your account? This action can be reversed.')) {
                window.location.href = '/Account/Deactivate?password=' + encodeURIComponent(password);
            }
        }
    </script>
}