@model SCM_System.Models.ViewModels.SupplierDashboardViewModel

@{
    ViewData["Title"] = "Supplier Financial Command Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "alert-success" : "alert-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4 p-4 animate-slide-up" role="alert">
            <div class="d-flex align-items-center">
                <div class="alert-icon-container me-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fas @alertIcon fs-4 text-white"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Account Update</h5>
                    <p class="mb-0 text-white">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Marketplace Financial Pulse</h1>
            <p class="text-muted small mb-0">Real-time earnings, commission settlement, and payout tracking.</p>
        </div>
        <div class="d-flex gap-2">
             <button class="btn btn-white shadow-sm border rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                <i class="fas fa-wallet me-2 text-primary"></i>Withdraw Earnings
            </button>
            <div class="dropdown">
                <button class="btn btn-primary shadow-sm rounded-pill px-4 dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fas fa-plus me-2"></i>Quick Actions
                </button>
                <ul class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Create">Add New Product</a></li>
                    <li><a class="dropdown-item" asp-controller="Workforce" asp-action="AddEmployee">Register Employee</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Tier 1 KPIs: Financial Liquidity -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-primary h-100" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Lifetime</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Gross Marketplace Sales</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.GrossSales.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-success h-100" style="background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-hand-holding-usd fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Net Profit</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Total Net Earnings</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.NetEarnings.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-info h-100" style="background: linear-gradient(135deg, #36b9cc 0%, #258391 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-university fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">In Clearance</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Pending Payouts</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.PendingPayouts.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg rounded-4 bg-gradient-danger h-100" style="background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="fas fa-percent fa-lg"></i>
                        </div>
                        <span class="badge bg-white bg-opacity-20 text-white rounded-pill small">Fees Paid</span>
                    </div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase mb-1">Platform Commission</div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.CommissionsPaid.ToString("C")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 2: Earnings Analytics & Intelligence -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">Net Earnings Trend (6-Month Dynamics)</h5>
                    <div class="d-flex gap-2">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">+15.2% vs Last Month</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <canvas id="earningsTrendChart" style="min-height: 320px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0 text-dark">Payout Health</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                    <div style="max-width: 250px; width: 100%;">
                        <canvas id="payoutPieChart"></canvas>
                    </div>
                    <div class="mt-4 w-100">
                        <div class="d-flex justify-content-between small mb-1 text-muted fw-bold">
                            <span>Available to Withdraw</span>
                            <span class="text-success">@ViewBag.NetEarnings.ToString("C0")</span>
                        </div>
                        <div class="progress rounded-pill mb-3" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: 80%"></div>
                        </div>
                        <div class="d-flex justify-content-between small mb-1 text-muted fw-bold">
                            <span>Pending Processing</span>
                            <span class="text-warning">@ViewBag.PendingPayouts.ToString("C0")</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 6px;">
                            <div class="progress-bar bg-warning" style="width: 20%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 3: Operation & Financial Ledger -->
    <div class="row g-4 mb-4">
        <!-- Left: Per-Order Financial Ledger -->
        <div class="col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">Financial Settlement Ledger</h5>
                    <a asp-action="Payments" class="btn btn-sm btn-light rounded-pill border">View History</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 text-muted small fw-bold">ORDER</th>
                                <th class="text-muted small fw-bold text-end">GROSS AMOUNT</th>
                                <th class="text-muted small fw-bold text-end">COMMISSION</th>
                                <th class="text-muted small fw-bold text-end">NET EARNINGS</th>
                                <th class="text-muted small fw-bold text-center">PAYOUT STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in (dynamic)ViewBag.FinancialLedger)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#@entry.OrderNumber</div>
                                        <small class="text-muted">Retailer: @entry.Retailer</small>
                                    </td>
                                    <td class="text-end fw-bold">@entry.Amount.ToString("C")</td>
                                    <td class="text-end text-danger">-@entry.Commission.ToString("C")</td>
                                    <td class="text-end text-success fw-bold">+@entry.Net.ToString("C")</td>
                                    <td class="text-center">
                                        @if (entry.PayoutStatus == "Paid") { <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Released</span> }
                                        else if (entry.PayoutStatus == "Pending") { <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Pending</span> }
                                        else { <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">@entry.PayoutStatus</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Recent Activity / Logistics -->
        <div class="col-xl-3">
             <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">Top Retailers</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var r in (dynamic)ViewBag.TopRetailers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom mx-2">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3">
                                        <i class="fas fa-store"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold small">@r.Name</h6>
                                        <small class="text-muted extra-small">Key Partner</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-primary small">@r.Amount.ToString("C0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Logistics Block (Existing functionality) -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <i class="fas fa-truck-moving"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Active Fleet</p>
                        <h4 class="fw-bold mb-0">@Model.ActiveVehiclesCount</h4>
                    </div>
                </div>
            </div>
        </div>
         <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-shape bg-info bg-opacity-10 text-info rounded-3 me-3">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Hub Usage</p>
                        <h4 class="fw-bold mb-0">@Model.HubUtilizationPercent%</h4>
                    </div>
                </div>
            </div>
        </div>
        <!-- ... other legacy operational cards ... -->
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Request Payout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-4 bg-light rounded-4 text-center mb-4 border border-dashed">
                    <p class="text-muted small mb-1">Available for Withdrawal</p>
                    <h2 class="fw-bold text-success">@ViewBag.NetEarnings.ToString("C")</h2>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Withdrawal Amount</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-light fw-bold">$</span>
                        <input type="number" class="form-control border-0 bg-light fw-bold" value="@ViewBag.NetEarnings" readonly>
                    </div>
                </div>
                <div class="alert alert-info border-0 rounded-3 small">
                    <i class="fas fa-info-circle me-2"></i> Payouts are processed to your linked bank account within 2-3 business days.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="alert('Payout request submitted successfully!'); $('#withdrawModal').modal('hide');">Submit Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Earnings Trend Chart
        const trendCtx = document.getElementById('earningsTrendChart').getContext('2d');
        const trendGradient = trendCtx.createLinearGradient(0, 0, 0, 400);
        trendGradient.addColorStop(0, 'rgba(28, 200, 138, 0.2)');
        trendGradient.addColorStop(1, 'rgba(28, 200, 138, 0)');

        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendLabels)),
                datasets: [{
                    label: 'Net Earnings',
                    data: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendValues)),
                    borderColor: '#1cc88a',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: trendGradient,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#1cc88a'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [5, 5], drawBorder: false } },
                    x: { grid: { display: false } }
                }
            }
        });

        // Payout Status Chart
        new Chart(document.getElementById('payoutPieChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.PayoutStatusLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.PayoutStatusValues)),
                    backgroundColor: ['#1cc88a', '#f6c23e'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                }
            }
        });
    </script>
}

<style>
    .bg-gradient-primary { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
    .bg-gradient-success { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); }
    .bg-gradient-info { background: linear-gradient(135deg, #36b9cc 0%, #258391 100%); }
    .bg-gradient-danger { background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%); }
    
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
    
    .extra-small { font-size: 0.7rem; }
    .icon-shape { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; }
    .border-dashed { border-style: dashed !important; }
</style>