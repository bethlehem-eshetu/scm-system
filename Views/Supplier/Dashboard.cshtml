@model SCM_System.Models.ViewModels.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Financial Pulse";
    Layout = "_DashboardLayout";
}

<div class="py-2 supplier-dashboard-container">
    <!-- Premium Header (SCM Style) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark-green mb-1">Welcome back, @(Context.Session.GetString("UserName") ?? "Supplier")</h1>
            <p class="text-muted small mb-0">Your business growth and order metrics at a glance.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center">
            <div class="search-bar-premium position-relative flex-grow-1 flex-md-grow-0">
                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" class="form-control border-0 bg-white rounded-pill ps-5 shadow-sm w-100 dark-mode-bg" placeholder="Search orders..." style="min-width: 250px; height: 45px;">
            </div>
        </div>
    </div>

    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "bg-dark-green" : "bg-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass text-white border-0 rounded-5 shadow-premium mb-4 p-4 animate-slide-up d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3 d-none d-sm-block">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div class="text-center text-sm-start">
                    <h6 class="fw-bold mb-0">Account Update</h6>
                    <p class="mb-0 small opacity-75">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white position-static" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tier 1: KPI Cards (SCM Style) -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-dark-green text-white shadow-premium h-100 overflow-hidden">
                <div class="card-body p-3 p-md-4 position-relative">
                    <div class="bg-white bg-opacity-10 rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3">
                        <i class="fas fa-shopping-cart text-accent-green"></i>
                    </div>
                    <p class="text-white-50 small text-uppercase fw-bold ls-1 mb-1">Gross Sales</p>
                    <h4 class="fw-bold mb-0">@ViewBag.GrossSales.ToString("C0")</h4>
                    <div class="mt-2 mt-md-3 d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-accent-green text-dark-green rounded-pill x-small">+12.5%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 dark-mode-card">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green dark-mode-icon-bg">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1 dark-mode-text">Net Profit</p>
                    <h4 class="text-dark-green fw-bold mb-0 dark-mode-text">@ViewBag.NetEarnings.ToString("C0")</h4>
                    <div class="mt-2 mt-md-3 d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-soft-success text-success rounded-pill x-small">+8.2%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 dark-mode-card">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green dark-mode-icon-bg">
                        <i class="fas fa-university"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1 dark-mode-text">Pending</p>
                    <h4 class="text-dark-green fw-bold mb-0 dark-mode-text">@ViewBag.PendingPayouts.ToString("C0")</h4>
                    <div class="mt-2 mt-md-3">
                        <span class="badge bg-soft-warning text-warning rounded-pill x-small">In Review</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 dark-mode-card">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green dark-mode-icon-bg">
                        <i class="fas fa-percent"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1 dark-mode-text">Fees</p>
                    <h4 class="text-dark-green fw-bold mb-0 dark-mode-text">@ViewBag.CommissionsPaid.ToString("C0")</h4>
                    <div class="mt-2 mt-md-3">
                        <span class="badge bg-soft-danger text-danger rounded-pill x-small">Platform Fee</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 2: Analytics & Insights Row (Merged from Dev) -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-3 dark-mode-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1 dark-mode-text">Earnings Analytics</h6>
                        <h4 class="fw-bold mb-0 text-dark-green dark-mode-text">Financial Performance</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-soft-success text-success rounded-pill px-3 py-2 fw-bold x-small">@(ViewBag.GrowthRate)% growth</span>
                    </div>
                </div>
                <div style="height: 320px; width: 100%;">
                    <canvas id="earningsTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-3 dark-mode-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green dark-mode-text">Retailer Distribution</h6>
                <div style="height: 220px; width: 100%;" class="mb-4">
                    <canvas id="retailerDistributionChart"></canvas>
                </div>
                <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 180px;">
                    @if (ViewBag.TopRetailers != null)
                    {
                        foreach (var r in (dynamic)ViewBag.TopRetailers)
                        {
                            <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded-4 bg-faint-green border-0 dark-mode-retailer-item mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-white text-dark-green p-1 px-2 rounded-2 shadow-sm dark-mode-icon-box x-small">
                                        <i class="fas fa-store"></i>
                                    </div>
                                    <div class="fw-bold x-small text-dark-green dark-mode-text text-truncate" style="max-width: 100px;">@r.Name</div>
                                </div>
                                <div class="fw-bold text-dark-green x-small dark-mode-text">@r.Amount.ToString("N0")</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 3: Operation Status & Settlement Ledger -->
    <div class="row g-4 mb-4">
        <div class="col-xl-12">
            <div class="card border-0 rounded-5 bg-white shadow-premium overflow-hidden dark-mode-card">
                <div class="card-header bg-white py-2 px-4 border-0 d-flex justify-content-between align-items-center dark-mode-header">
                    <h5 class="mb-0 fw-bold text-dark-green dark-mode-text">Settlement Ledger</h5>
                    <a asp-action="Payments" class="btn btn-faint-green text-dark-green rounded-pill px-3 py-2 small fw-bold shadow-sm dark-mode-btn">View All</a>
                </div>
                <div class="table-responsive dark-mode-table-wrapper">
                    <table class="table align-middle mb-0 dark-mode-table">
                        <thead class="bg-faint-green dark-mode-thead">
                            <tr>
                                <th class="ps-4 py-3 text-muted small text-uppercase fw-bold ls-1 dark-mode-text">Order Details</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end dark-mode-text">Gross</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end dark-mode-text">Fees</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end dark-mode-text">Net</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-center dark-mode-text" style="width: 150px;">Revenue Mix</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-center dark-mode-text">Status</th>
                            </tr>
                        </thead>
                                               <tbody class="dark-mode-tbody">
                            @if (ViewBag.FinancialLedger != null)
                            {
                                foreach (var entry in (dynamic)ViewBag.FinancialLedger)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark-green dark-mode-text">#@entry.OrderNumber</div>
                                            <div class="x-small text-muted dark-mode-text">@entry.Retailer</div>
                                        </td>
                                        <td class="py-3 text-end fw-bold text-dark-green dark-mode-text">@entry.Amount.ToString("N0")</td>
                                        <td class="py-3 text-end text-danger x-small dark-mode-fee">-@entry.Commission.ToString("N0")</td>
                                        <td class="py-3 text-end text-success fw-bold dark-mode-net">+@entry.Net.ToString("N0")</td>
                                        <td class="py-3 px-4">
                                            @{
                                                var percentage = entry.Amount > 0 ? (entry.Net * 100 / entry.Amount) : 0;
                                            }
                                            <div class="progress bg-faint-green rounded-pill" style="height: 6px; min-width: 100px;">
                                                <div class="progress-bar bg-dark-green rounded-pill" style="width: @percentage%;"></div>
                                            </div>
                                            <div class="d-flex justify-content-between mt-1">
                                                <span class="x-small text-muted">@percentage% yield</span>
                                            </div>
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (entry.PayoutStatus == "Paid") 
                                            { 
                                                <span class="status-badge bg-soft-success text-success dark-mode-badge">Released</span> 
                                            }
                                            else if (entry.PayoutStatus == "Pending") 
                                            { 
                                                <span class="status-badge bg-soft-warning text-warning dark-mode-badge">Pending</span> 
                                            }
                                            else 
                                            { 
                                                <span class="status-badge bg-soft-secondary text-secondary dark-mode-badge">@entry.PayoutStatus</span> 
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="opacity-50">
                                            <i class="fas fa-receipt fa-3x mb-3"></i>
                                            <p class="mb-0 dark-mode-text">No transactions found</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden dark-mode-modal">
            <div class="modal-header bg-dark-green text-white py-4 px-4 border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-wallet me-2"></i> Request Payout</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center dark-mode-modal-body">
                <div class="bg-faint-green rounded-5 p-4 mb-4 border-dashed-custom dark-mode-modal-box">
                    <p class="text-muted small mb-1 dark-mode-text">Available for Withdrawal</p>
                    <h3 class="fw-bold text-dark-green dark-mode-text">@ViewBag.NetEarnings.ToString("C")</h3>
                </div>
                
                <div class="alert bg-soft-info text-info border-0 rounded-4 x-small mb-4 text-start dark-mode-alert">
                    <i class="fas fa-info-circle me-2"></i> Funds will be transferred to your primary bank account within 48 hours.
                </div>
                
                <button class="btn btn-dark-green w-100 rounded-pill py-2 fw-bold shadow-premium dark-mode-btn" onclick="alert('Payout request submitted!'); $('#withdrawModal').modal('hide');">
                    Confirm Payout
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .supplier-dashboard-container {
            zoom: 0.92;
            max-width: 1450px;
            margin: auto;
        }

        .border-dashed-custom { border: 2px dashed #e2e8f0; }

        .search-bar-premium input:focus {
            background-color: var(--faint-green) !important;
            box-shadow: none;
            border: 1px solid var(--accent-green) !important;
        }

        .tracking-wider { letter-spacing: 1px; }

        /* Page-specific Dark Mode Overrides */
        body.dark-mode .dark-mode-icon-box { background-color: #1e2a3a !important; color: #a5f3c3 !important; }
        body.dark-mode .dark-mode-retailer-item { background-color: #334155 !important; }
        body.dark-mode .dark-mode-fleet-item { background-color: #334155 !important; }
        body.dark-mode .dark-mode-info { background-color: rgba(37, 99, 235, 0.15) !important; color: #93c5fd !important; }
        body.dark-mode .dark-mode-fee { color: #f87171 !important; }
        body.dark-mode .dark-mode-net { color: #4ade80 !important; }
        body.dark-mode .dark-mode-alert { background-color: rgba(13, 202, 240, 0.1) !important; color: #67e8f9 !important; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748B';

            // Earnings Trend Chart (Merged from Dev)
            const trendCtx = document.getElementById('earningsTrendChart').getContext('2d');
            const accentColor = '#4da699';
            
            const trendGradient = trendCtx.createLinearGradient(0, 0, 0, 320);
            trendGradient.addColorStop(0, 'rgba(77, 166, 153, 0.2)');
            trendGradient.addColorStop(1, 'rgba(77, 166, 153, 0)');

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendLabels)),
                    datasets: [{
                        label: 'Net Earnings',
                        data: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendValues)),
                        borderColor: accentColor,
                        backgroundColor: trendGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: accentColor,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a3d31',
                            padding: 12,
                            cornerRadius: 10,
                            titleFont: { size: 12 },
                            bodyFont: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { font: { size: 11 } }
                        },
                        x: { 
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });

            // Retailer Distribution Chart (Polar Area)
            const retailerCtx = document.getElementById('retailerDistributionChart').getContext('2d');
            const topRetailersData = @Html.Raw(Json.Serialize(ViewBag.TopRetailers));
            
            new Chart(retailerCtx, {
                type: 'polarArea',
                data: {
                    labels: topRetailersData.map(r => r.name || r.Name),
                    datasets: [{
                        data: topRetailersData.map(r => r.amount || r.Amount),
                        backgroundColor: [
                            '#1a3d31', // Deep Forest
                            '#2d5a4a', // Muted Forest
                            '#4a8a75', // Sage
                            '#6fb39d', // Mint
                            '#9ed9c5'  // Pale Mint
                        ],
                        borderWidth: 0,
                        spacing: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            display: false,
                            ticks: { display: false },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(26, 61, 49, 0.9)',
                            padding: 10,
                            cornerRadius: 8
                        }
                    }
                }
            });
        });
    </script>
}