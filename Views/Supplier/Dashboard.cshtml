@model SCM_System.Models.ViewModels.SupplierDashboardViewModel

@{
    ViewData["Title"] = "Supplier Control Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "alert-success" : "alert-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4 p-4 animate-slide-up" role="alert">
            <div class="d-flex align-items-center">
                <div class="alert-icon-container me-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Account Update</h5>
                    <p class="mb-0">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="glass-header p-4 mb-4 rounded-4 shadow-sm position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.1) 0%, rgba(13, 110, 253, 0.05) 100%); border: 1px solid rgba(13, 110, 253, 0.2);">
        <div class="d-flex justify-content-between align-items-center position-relative z-1">
            <div>
                <h4 class="text-primary fw-bold mb-1">
                    Operational Control Center
                    @if (Model.IsFaydaVerified)
                    {
                        <span class="badge bg-success rounded-pill ms-2" style="font-size: 0.7rem;">
                            <i class="fas fa-check-circle me-1"></i> Fayda Verified
                        </span>
                    }
                    else if (Model.FaydaStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark rounded-pill ms-2" style="font-size: 0.7rem;">
                            <i class="fas fa-clock me-1"></i> Fayda Pending
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.7rem;">
                            <i class="fas fa-times-circle me-1"></i> Fayda Rejected
                        </span>
                    }
                </h4>
                <p class="text-muted mb-0">Real-time performance metrics and logistics overview</p>
            </div>
 <div class="d-flex gap-2">
    <!-- Notification Bell Button -->
    <a href="@Url.Action("Index", "Notification")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 position-relative">
        <i class="fas fa-bell"></i>
        <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
            0
        </span>
    </a>
    
    <!-- Message Inbox Button -->
    <a href="@Url.Action("Inbox", "Message")" class="btn btn-outline-primary btn-sm rounded-pill px-3 position-relative">
        <i class="fas fa-envelope me-1"></i> Messages
        @if (ViewBag.UnreadMessagesCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @ViewBag.UnreadMessagesCount
            </span>
        }
    </a>
    
    <a asp-action="ArchivedAssets" class="btn btn-outline-warning btn-sm rounded-pill px-3">
        <i class="fas fa-shield-alt me-1"></i> Continuity Hub
    </a>
    
    <button class="btn btn-white btn-sm shadow-sm border rounded-pill px-3">
        <i class="fas fa-download me-1"></i> Export Data
    </button>
    
    <div class="dropdown">
        <button class="btn btn-primary btn-sm rounded-pill px-3 dropdown-toggle" data-bs-toggle="dropdown">
            <i class="fas fa-plus me-1"></i> Quick Action
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3">
            <li><a class="dropdown-item" asp-controller="Product" asp-action="Create">Add New Product</a></li>
            <li><a class="dropdown-item" asp-controller="Workforce" asp-action="AddEmployee">Register Employee</a></li>
            <li><a class="dropdown-item" asp-controller="Hub" asp-action="CreateWarehouse">Add Warehouse</a></li>
            <li><a class="dropdown-item" asp-controller="Fleet" asp-action="CreateVehicle">Register Vehicle</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Reports">View All Reports</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="@Url.Action("Index", "Penalty")">
                <i class="fas fa-gavel me-2"></i>My Penalties
                @if (ViewBag.ActivePenalties > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.ActivePenalties</span>
                }
            </a></li>
  
        </ul>
    </div>
</div>
        </div>
    </div>

    <!-- Top KPI Cards -->
    </div>

    <!-- Logistics 2.0 Operational KPIs -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <i class="fas fa-truck-loading fs-1 opacity-25 position-absolute end-0 bottom-0 mb-n3 me-n3"></i>
                        <div>
                            <p class="small fw-bold text-uppercase mb-0 opacity-75">Active Fleet</p>
                            <h3 class="fw-bold mb-0">@Model.ActiveVehiclesCount</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-2">
                            <i class="fas fa-truck"></i>
                        </div>
                    </div>
                    <div class="small fw-medium">
                        <i class="fas fa-arrow-up me-1"></i> @Model.GrowthPercent.ToString("F1")% Growth
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-info text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <i class="fas fa-warehouse fs-1 opacity-25 position-absolute end-0 bottom-0 mb-n3 me-n3"></i>
                        <div>
                            <p class="small fw-bold text-uppercase mb-0 opacity-75">Hub Utilization</p>
                            <h3 class="fw-bold mb-0">@Model.HubUtilizationPercent%</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-2">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                    </div>
                    <div class="progress bg-white bg-opacity-25 mt-2" style="height: 4px;">
                        <div class="progress-bar bg-white" style="width: @Model.HubUtilizationPercent%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-warning text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <i class="fas fa-clock fs-1 opacity-25 position-absolute end-0 bottom-0 mb-n3 me-n3"></i>
                        <div>
                            <p class="small fw-bold text-uppercase mb-0 opacity-75">Delayed Shipments</p>
                            <h3 class="fw-bold mb-0">@Model.DelayedShipmentsCount</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-2 text-dark">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                    </div>
                    <div class="small fw-medium text-dark">Impacts SLA Performance</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-dark text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <i class="fas fa-user-friends fs-1 opacity-25 position-absolute end-0 bottom-0 mb-n3 me-n3"></i>
                        <div>
                            <p class="small fw-bold text-uppercase mb-0 opacity-75">Active Workforce</p>
                            <h3 class="fw-bold mb-0">@Model.TotalPersonnelCount</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-2">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                    <div class="small fw-medium">Across all logistics hubs</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Section -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Revenue & Order Volume</h5>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary px-3">Weekly</button>
                        <button class="btn btn-primary px-3">Monthly</button>
                    </div>
                </div>
                <div class="card-body p-4 pt-0">
                    <canvas id="revenueChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4">
                    <h5 class="fw-bold mb-0">Warehouse Distribution</h5>
                </div>
                <div class="card-body p-4 pt-0 d-flex flex-column justify-content-center">
                    <canvas id="warehouseChart" style="max-height: 250px;"></canvas>
                    <div class="mt-4 pt-2 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Avg Completion:</span>
                            <span class="fw-bold">@Model.CompletionRate.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success rounded-pill" style="width: @Model.CompletionRate%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Overview & Activity -->
    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <!-- Recent Conversations Section -->
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="fas fa-comments me-2 text-primary"></i>Recent Conversations
                    </h5>
                    <a href="@Url.Action("Inbox", "Message")" class="btn btn-sm btn-outline-primary">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-4 pt-0">
                    @if (ViewBag.RecentConversations != null && ((dynamic)ViewBag.RecentConversations).Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var conv in ViewBag.RecentConversations)
                            {
                                <a href="@Url.Action("Conversation", "Message", new { id = conv.OtherUserId })" 
                                   class="list-group-item list-group-item-action border-0 px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="mb-1">
                                                <span class="fw-bold">@conv.OtherUserName</span>
                                                <span class="badge bg-secondary ms-2 small">@conv.OtherUserRole</span>
                                                @if (conv.UnreadCount > 0)
                                                {
                                                    <span class="badge bg-primary ms-2">@conv.UnreadCount new</span>
                                                }
                                            </div>
                                            <p class="mb-0 small text-muted">@conv.LastMessage</p>
                                        </div>
                                        <small class="text-muted">@conv.LastMessageAt.ToString("MMM dd")</small>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-comments fa-3x text-muted mb-3 opacity-25"></i>
                            <p class="text-muted mb-0">No conversations yet</p>
                            <a href="@Url.Action("SelectRecipient", "Message")" class="btn btn-sm btn-primary mt-2">
                                Start New Conversation
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="fas fa-history me-2 text-primary"></i>Audit Trail (Live)
                    </h5>
                    <a asp-action="Notifications" class="small text-decoration-none">Operational Log</a>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="timeline-container">
                        @if (ViewBag.RecentLogs != null && ((IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.RecentLogs).Any())
                        {
                            foreach (var log in (IEnumerable<SCM_System.Models.Entities.AuditLog>)ViewBag.RecentLogs)
                            {
                                <div class="activity-item d-flex mb-4">
                                    <div class="activity-icon-container me-3">
                                        <div class="activity-icon bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="fas @GetAuditIcon(log.ActionType)"></i>
                                        </div>
                                        <div class="activity-line"></div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1 fw-bold">@log.ActionType - @log.EntityType</h6>
                                            <small class="text-muted">@log.PerformedAtUtc.ToLocalTime().ToString("HH:mm")</small>
                                        </div>
                                        <p class="text-muted small mb-0">@log.Notes</p>
                                        <div class="small text-info mt-1">
                                            <i class="fas fa-user-shield me-1"></i> System Verified
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-list fa-3x mb-3 opacity-25"></i>
                                <p>No audit records available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Accepted" => "bg-info",
            "Processing" => "bg-primary",
            "Packed" => "bg-purple",
            "In Transit" => "bg-indigo",
            "Delivered" => "bg-success",
            "Completed" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    string GetAuditIcon(string action)
    {
        return action switch
        {
            "Create" => "fa-plus-circle",
            "Update" => "fa-edit",
            "Delete" => "fa-trash-alt",
            "Dispatch" => "fa-shipping-fast",
            "StatusUpdate" => "fa-sync",
            _ => "fa-fingerprint"
        };
    }

    string GetActivityIcon(string type)
    {
        return type switch
        {
            "Success" => "fa-check",
            "Warning" => "fa-exclamation",
            "Danger" => "fa-times",
            "Info" => "fa-info",
            _ => "fa-bell"
        };
    }
}

@section Styles {
    <style>
        .bg-purple { background-color: #6f42c1 !important; }
        .bg-indigo { background-color: #6610f2 !important; }
        .text-purple { color: #6f42c1 !important; }
        
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(0,0,0,0.05);
        }

        .activity-item { position: relative; }
        .activity-line {
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: -20px;
            width: 2px;
            background: #f3f4f6;
            z-index: 0;
        }
        .activity-item:last-child .activity-line { display: none; }
        
        .glass-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 70%);
            transform: rotate(30deg);
            pointer-events: none;
        }
        
        .icon-shape {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Revenue Chart
            const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRevenue, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(d => d.Label))),
                    datasets: [{
                        label: 'Revenue',
                        data: @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(d => d.Value))),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#0d6efd',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }, {
                        label: 'Orders',
                        type: 'bar',
                        data: @Html.Raw(Json.Serialize(Model.OrderVolumeTrend.Select(d => d.Value))),
                        backgroundColor: 'rgba(108, 117, 125, 0.1)',
                        borderRadius: 5,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { display: false }
                        },
                        y1: {
                            position: 'right',
                            beginAtZero: true,
                            grid: { display: false }
                        },
                        x: {
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Warehouse Chart
            const ctxWarehouse = document.getElementById('warehouseChart').getContext('2d');
            new Chart(ctxWarehouse, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.WarehousePerformance.Select(d => d.Label))),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.WarehousePerformance.Select(d => d.Value))),
                        backgroundColor: [
                            '#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#6610f2'
                        ],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20,
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });
        });

        // Add this inside your existing script section
function loadNotificationCount() {
    $.get('@Url.Action("GetUnreadCount", "Notification")', function(data) {
        if (data.count > 0) {
            $('#notificationBadge').text(data.count).show();
        } else {
            $('#notificationBadge').hide();
        }
    });
}

// Load on page load
loadNotificationCount();
// Refresh every 30 seconds
setInterval(loadNotificationCount, 30000);
    </script>
}