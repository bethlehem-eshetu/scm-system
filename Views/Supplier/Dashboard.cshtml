@model SCM_System.Models.ViewModels.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 pb-5">
    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "alert-success" : "alert-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4 p-4 animate-slide-up" role="alert" style="border-left: 5px solid @(ViewBag.ApprovalStatusType == "Approved" ? "#2E9C7A" : "#E05A5A") !important;">
            <div class="d-flex align-items-center">
                <div class="alert-icon-container me-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Account Update</h5>
                    <p class="mb-0 opacity-90">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Premium Enhanced Header -->
    <div class="row mb-5 animate-slide-up">
        <div class="col-12">
            <div class="welcome-banner p-4 p-lg-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden">
                <div class="banner-overlay"></div>
                <div class="banner-glow"></div>
                
                <div class="row align-items-center position-relative z-index-2">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#" class="text-white text-opacity-50 text-decoration-none small fw-bold text-uppercase tracking-widest">Supplier</a></li>
                                <li class="breadcrumb-item active small fw-bold text-uppercase tracking-widest text-white" aria-current="page">Overview</li>
                            </ol>
                        </nav>
                        <h1 class="display-5 fw-bold text-white mb-2">
                            Financial <span class="text-gradient-gold">Command Center</span>
                        </h1>
                        <p class="text-white text-opacity-75 mb-0 fs-5">
                            <i class="fas fa-chart-line me-2 text-success"></i>Real-time earnings, commission settlement, and payout tracking.
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <button class="btn btn-glass px-4 py-3 fw-bold d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                                <div class="btn-icon bg-white bg-opacity-10 rounded-3">
                                    <i class="fas fa-wallet text-white"></i>
                                </div>
                                <div class="text-start">
                                    <div class="extra-small text-white text-opacity-50 text-uppercase">Withdraw</div>
                                    <div class="text-white">Earnings</div>
                                </div>
                            </button>
                            <div class="dropdown">
                                <button class="btn btn-gold px-4 py-3 fw-bold d-flex align-items-center gap-3 shadow-lg" type="button" data-bs-toggle="dropdown">
                                    <div class="btn-icon bg-black bg-opacity-20 rounded-3">
                                        <i class="fas fa-bolt"></i>
                                    </div>
                                    <div class="text-start">
                                        <div class="extra-small text-black text-opacity-50 text-uppercase">Actions</div>
                                        <div class="text-black">Quick Hub</div>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-2xl p-2 mt-2" style="border-radius: 20px; min-width: 240px;">
                                    <li><h6 class="dropdown-header text-uppercase tracking-widest fw-bold py-3">Inventory</h6></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Product" asp-action="Create"><i class="fas fa-plus me-2 text-primary"></i> Add New Product</a></li>
                                    <li><a class="dropdown-item py-2 px-3 rounded-4 mb-1" asp-controller="Workforce" asp-action="AddEmployee"><i class="fas fa-user-plus me-2 text-warning"></i> Register Employee</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main KPI Grid -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-primary-soft text-primary">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Gross Sales</div>
                    <div class="kpi-value">@ViewBag.GrossSales.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
                    <span class="text-success fw-bold"><i class="fas fa-caret-up me-1"></i>15%</span>
                    <span class="ms-1">Lifetime Marketplace Volume</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-success-soft text-success">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Net Earnings</div>
                    <div class="kpi-value">@ViewBag.NetEarnings.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
                    <span class="text-success fw-bold">Available to Withdraw</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-warning-soft text-warning">
                    <i class="fas fa-university"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Pending Payouts</div>
                    <div class="kpi-value">@ViewBag.PendingPayouts.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted">In Clearance Process</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-icon-box bg-danger-soft text-danger">
                    <i class="fas fa-percent"></i>
                </div>
                <div class="ms-auto text-end">
                    <div class="kpi-label">Fees Paid</div>
                    <div class="kpi-value">@ViewBag.CommissionsPaid.ToString("N0") <span class="small">ETB</span></div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted">Platform Commission</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Health Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1">Earnings Analytics</h6>
                        <h4 class="fw-bold mb-0">Financial Performance</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold small">+15.2% growth</span>
                    </div>
                </div>
                <div style="height: 320px; width: 100%;">
                    <canvas id="earningsTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Payout Health</h6>
                <div style="height: 250px; width: 100%;">
                    <canvas id="payoutPieChart"></canvas>
                </div>
                <div class="mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted"><i class="fas fa-circle text-success me-2" style="font-size: 8px;"></i> Available</span>
                        <span class="small fw-bold">@ViewBag.NetEarnings.ToString("N0") ETB</span>
                    </div>
                    <div class="progress rounded-pill bg-light mb-3" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 80%"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted"><i class="fas fa-circle text-warning me-2" style="font-size: 8px;"></i> Pending</span>
                        <span class="small fw-bold">@ViewBag.PendingPayouts.ToString("N0") ETB</span>
                    </div>
                    <div class="progress rounded-pill bg-light" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: 20%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Settlement Ledger Table -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="section-card">
                <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                    <h5 class="fw-bold mb-0">Financial Settlement Ledger</h5>
                    <a asp-action="Payments" class="btn btn-sm btn-outline-card px-3 fw-bold" style="border-radius: 8px;">View Full History</a>
                </div>
                <div class="table-responsive">
                    <table class="admin-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Order Details</th>
                                <th class="text-end">Gross Amount</th>
                                <th class="text-end">Commission</th>
                                <th class="text-end">Net Earnings</th>
                                <th class="text-center">Payout Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.FinancialLedger != null)
                            {
                                foreach (var entry in (dynamic)ViewBag.FinancialLedger)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">#@entry.OrderNumber</div>
                                            <div class="extra-small text-muted">Retailer: @entry.Retailer</div>
                                        </td>
                                        <td class="text-end fw-bold">@entry.Amount.ToString("N2") <span class="extra-small">ETB</span></td>
                                        <td class="text-end text-danger">-@entry.Commission.ToString("N2") <span class="extra-small">ETB</span></td>
                                        <td class="text-end text-success fw-bold">+@entry.Net.ToString("N2") <span class="extra-small">ETB</span></td>
                                        <td class="text-center">
                                            @if (entry.PayoutStatus == "Paid") { <span class="badge-soft badge-soft-success">Released</span> }
                                            else if (entry.PayoutStatus == "Pending") { <span class="badge-soft badge-soft-warning">Pending</span> }
                                            else { <span class="badge-soft badge-soft-secondary">@entry.PayoutStatus</span> }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Insights Row -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Top Performing Retailers</h6>
                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.TopRetailers != null)
                    {
                        foreach (var r in (dynamic)ViewBag.TopRetailers)
                        {
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 border-dashed border-opacity-10 border-dark">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-soft text-primary p-2 rounded-3">
                                        <i class="fas fa-store"></i>
                                    </div>
                                    <div class="fw-bold small">@r.Name</div>
                                </div>
                                <div class="fw-bold text-primary small">@r.Amount.ToString("N0") ETB</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
             <div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark-card">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small">Operational Fleet Status</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-light text-center border">
                            <i class="fas fa-truck-moving fa-2x text-primary mb-2 opacity-75"></i>
                            <div class="h4 fw-bold mb-0">@Model.ActiveVehiclesCount</div>
                            <div class="extra-small text-muted">Active Fleet</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-light text-center border">
                            <i class="fas fa-warehouse fa-2x text-info mb-2 opacity-75"></i>
                            <div class="h4 fw-bold mb-0">@Model.HubUtilizationPercent%</div>
                            <div class="extra-small text-muted">Hub Usage</div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 p-3 bg-primary bg-opacity-10 rounded-4 text-primary small">
                    <i class="fas fa-info-circle me-2"></i> Your fleet efficiency has increased by 8% this week.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-5 overflow-hidden">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold fs-4">Request Payout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-5 bg-success bg-opacity-10 rounded-5 text-center mb-4 border border-success border-opacity-25 shadow-sm">
                    <p class="text-muted small text-uppercase tracking-widest fw-bold mb-2">Available for Withdrawal</p>
                    <h1 class="display-5 fw-bold text-success mb-0">@ViewBag.NetEarnings.ToString("N0") <span class="fs-5">ETB</span></h1>
                </div>
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold text-uppercase tracking-wider">Settlement Amount</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text border-0 bg-light fw-bold text-muted">ETB</span>
                        <input type="number" class="form-control border-0 bg-light fw-bold text-dark fs-4" value="@ViewBag.NetEarnings" readonly>
                    </div>
                </div>
                <div class="alert alert-info border-0 rounded-4 p-3 d-flex align-items-center gap-3">
                    <div class="alert-icon bg-white bg-opacity-25 rounded-circle p-2">
                        <i class="fas fa-university"></i>
                    </div>
                    <div class="small fw-medium">Payouts are processed to your linked bank account within 2-3 business days.</div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4 py-2 fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-lg" onclick="alert('Payout request submitted successfully!'); $('#withdrawModal').modal('hide');">
                    Confirm & Withdraw
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Chart.js Globals
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748B';

            // 1. Earnings Trend Chart
            const trendCtx = document.getElementById('earningsTrendChart').getContext('2d');
            const accentColor = '#1cc88a';
            const isDark = $('html').hasClass('dark-mode');

            let earningsChart = new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendLabels)),
                    datasets: [{
                        label: 'Net Earnings',
                        data: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendValues)),
                        borderColor: accentColor,
                        backgroundColor: 'rgba(28, 200, 138, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: accentColor,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isDark ? '#1A1F1D' : '#0B3B2F',
                            padding: 12,
                            cornerRadius: 10,
                            titleFont: { size: 12 },
                            bodyFont: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true,
                            grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' },
                            ticks: { font: { size: 11 } }
                        },
                        x: { 
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });

            // 2. Payout Status Chart
            const ctxPayout = document.getElementById('payoutPieChart').getContext('2d');
            new Chart(ctxPayout, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.PayoutStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(ViewBag.PayoutStatusValues)),
                        backgroundColor: ['#1cc88a', '#f6c23e'],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } },
                        tooltip: { backgroundColor: '#0B3B2F', cornerRadius: 8 }
                    }
                }
            });

            // Theme Sync
            const observer = new MutationObserver(function() {
                const isDarkNow = $('html').hasClass('dark-mode');
                if(earningsChart) {
                    earningsChart.options.scales.y.grid.color = isDarkNow ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
                    earningsChart.options.plugins.tooltip.backgroundColor = isDarkNow ? '#1A1F1D' : '#0B3B2F';
                    earningsChart.update();
                }
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        });
    </script>
}

<style>
    /* Reuse global tokens from Retailer Dashboard */
    .welcome-banner {
        background: linear-gradient(135deg, #0B3B2F 0%, #1A4D3A 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .banner-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: url('https://www.transparenttextures.com/patterns/cubes.png');
        opacity: 0.05; z-index: 1;
    }
    .banner-glow {
        position: absolute; top: -50%; right: -20%; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(46, 156, 122, 0.2) 0%, transparent 70%);
        filter: blur(50px); z-index: 1;
    }
    .text-gradient-gold {
        background: linear-gradient(to right, #f1c40f, #f39c12);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
    .z-index-2 { z-index: 2; }
    .tracking-widest { letter-spacing: 2px; }
    
    .kpi-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .kpi-icon-box {
        width: 54px; height: 54px;
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
    }
    .kpi-label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }
    .kpi-value { font-size: 1.85rem; font-weight: 700; color: var(--text-color); line-height: 1.2; }
    .kpi-footer {
        width: 100%; margin-top: 16px; padding-top: 16px;
        border-top: 1px solid var(--border-color);
        font-size: 12px; color: var(--text-muted);
    }
    
    .section-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        overflow: hidden;
    }

    .bg-primary-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-warning-soft { background: rgba(230, 126, 34, 0.1); color: #E67E22; }
    .bg-success-soft { background: rgba(46, 156, 122, 0.1); color: #2E9C7A; }
    .bg-danger-soft { background: rgba(224, 90, 90, 0.1); color: #E05A5A; }
    
    .btn-glass {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        transition: all 0.3s ease;
        border-radius: 16px;
    }
    .btn-glass:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); color: white; }
    .btn-gold {
        background: linear-gradient(135deg, #f1c40f 0%, #f39c12 100%);
        border: none; color: #000; transition: all 0.3s ease; border-radius: 16px;
    }
    .btn-gold:hover {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        transform: translateY(-2px); box-shadow: 0 10px 20px rgba(243, 156, 18, 0.3);
    }
    .btn-icon { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
    
    .extra-small { font-size: 0.75rem; }
    .tracking-wider { letter-spacing: 1px; }
    .border-dashed { border-style: dashed !important; }
</style>