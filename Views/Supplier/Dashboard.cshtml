@model SCM_System.Models.ViewModels.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Financial Pulse";
    Layout = "_DashboardLayout";
}

<div class="py-2">
    <!-- Premium Header (SCM Style) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">Welcome back, @(Context.Session.GetString("UserName") ?? "Supplier")</h1>
            <p class="text-muted small mb-0">Your financial command center is updated and ready.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center">
            <div class="search-bar-premium position-relative flex-grow-1 flex-md-grow-0">
                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" class="form-control border-0 bg-white rounded-pill ps-5 shadow-sm w-100" placeholder="Search transactions..." style="min-width: 250px; height: 45px;">
            </div>
            <button class="btn btn-white rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 45px; height: 45px;" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                <i class="fas fa-wallet text-dark-green"></i>
            </button>
        </div>
    </div>

    @if (ViewBag.ApprovalStatusMessage != null)
    {
        var alertClass = ViewBag.ApprovalStatusType == "Approved" ? "bg-dark-green" : "bg-danger";
        var alertIcon = ViewBag.ApprovalStatusType == "Approved" ? "fa-check-circle" : "fa-exclamation-triangle";
        
        <div class="alert @alertClass text-white border-0 rounded-5 shadow-premium mb-5 p-4 animate-slide-up d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3 d-none d-sm-block">
                    <i class="fas @alertIcon fs-4"></i>
                </div>
                <div class="text-center text-sm-start">
                    <h6 class="fw-bold mb-0">Account Update</h6>
                    <p class="mb-0 small opacity-75">@ViewBag.ApprovalStatusMessage</p>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white position-static" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tier 1: KPI Cards (SCM Style) -->
    <div class="row g-3 g-md-4 mb-5">
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-dark-green text-white shadow-premium h-100 overflow-hidden">
                <div class="card-body p-3 p-md-4 position-relative">
                    <div class="bg-white bg-opacity-10 rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3">
                        <i class="fas fa-shopping-cart text-accent-green"></i>
                    </div>
                    <p class="text-white-50 small text-uppercase fw-bold ls-1 mb-1">Gross Sales</p>
                    <h3 class="fw-bold mb-0">@ViewBag.GrossSales.ToString("C0")</h3>
                    <div class="mt-2 mt-md-3 d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-accent-green text-dark-green rounded-pill x-small">+12.5%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Net Profit</p>
                    <h3 class="text-dark-green fw-bold mb-0">@ViewBag.NetEarnings.ToString("C0")</h3>
                    <div class="mt-2 mt-md-3 d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-soft-success text-success rounded-pill x-small">+8.2%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green">
                        <i class="fas fa-university"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Pending</p>
                    <h3 class="text-dark-green fw-bold mb-0">@ViewBag.PendingPayouts.ToString("C0")</h3>
                    <div class="mt-2 mt-md-3">
                        <span class="badge bg-soft-warning text-warning rounded-pill x-small">In Review</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="bg-faint-green rounded-4 p-2 p-md-3 d-inline-flex mb-2 mb-md-3 text-dark-green">
                        <i class="fas fa-percent"></i>
                    </div>
                    <p class="text-muted small text-uppercase fw-bold ls-1 mb-1">Fees</p>
                    <h3 class="text-dark-green fw-bold mb-0">@ViewBag.CommissionsPaid.ToString("C0")</h3>
                    <div class="mt-2 mt-md-3">
                        <span class="badge bg-soft-danger text-danger rounded-pill x-small">Platform Fee</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 2: Analytics & Insights Row (Merged from Dev) -->
    <div class="row g-4 mb-5">
        <div class="col-xl-8">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold text-uppercase tracking-wider opacity-75 small mb-1">Earnings Analytics</h6>
                        <h4 class="fw-bold mb-0 text-dark-green">Financial Performance</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-soft-success text-success rounded-pill px-3 py-2 fw-bold x-small">+15.2% growth</span>
                    </div>
                </div>
                <div style="height: 320px; width: 100%;">
                    <canvas id="earningsTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 rounded-5 bg-white shadow-premium h-100 p-4">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Top Performing Retailers</h6>
                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.TopRetailers != null)
                    {
                        foreach (var r in (dynamic)ViewBag.TopRetailers)
                        {
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-faint-green border-0">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white text-dark-green p-2 rounded-3 shadow-sm">
                                        <i class="fas fa-store"></i>
                                    </div>
                                    <div class="fw-bold small text-dark-green">@r.Name</div>
                                </div>
                                <div class="fw-bold text-dark-green small">@r.Amount.ToString("N0") ETB</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 opacity-50">
                            <i class="fas fa-users-slash fa-2x mb-2"></i>
                            <p class="x-small mb-0">No data available yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tier 3: Operation Status & Settlement Ledger -->
    <div class="row g-4 mb-5">
        <div class="col-xl-4">
             <div class="card border-0 rounded-5 bg-white shadow-premium p-4 h-100">
                <h6 class="fw-bold mb-4 text-uppercase tracking-wider opacity-75 small text-dark-green">Operational Fleet Status</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-faint-green text-center border-0">
                            <i class="fas fa-truck-moving fa-2x text-dark-green mb-2 opacity-75"></i>
                            <div class="h4 fw-bold mb-0 text-dark-green">@Model.ActiveVehiclesCount</div>
                            <div class="x-small text-muted">Active Fleet</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-4 bg-faint-green text-center border-0">
                            <i class="fas fa-warehouse fa-2x text-accent-green mb-2 opacity-75"></i>
                            <div class="h4 fw-bold mb-0 text-dark-green">@Model.HubUtilizationPercent%</div>
                            <div class="x-small text-muted">Hub Usage</div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 p-3 bg-dark-green bg-opacity-10 rounded-4 text-dark-green x-small">
                    <i class="fas fa-info-circle me-2"></i> Fleet efficiency increased by 8% this week.
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card border-0 rounded-5 bg-white shadow-premium overflow-hidden">
                <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark-green">Settlement Ledger</h5>
                    <a asp-action="Payments" class="btn btn-faint-green text-dark-green rounded-pill px-4 fw-bold small shadow-sm">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="bg-faint-green">
                            <tr>
                                <th class="ps-4 py-3 text-muted small text-uppercase fw-bold ls-1">Order Details</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end">Gross</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end">Fees</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-end">Net</th>
                                <th class="py-3 text-muted small text-uppercase fw-bold ls-1 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.FinancialLedger != null)
                            {
                                foreach (var entry in (dynamic)ViewBag.FinancialLedger)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark-green">#@entry.OrderNumber</div>
                                            <div class="x-small text-muted">@entry.Retailer</div>
                                        </td>
                                        <td class="py-3 text-end fw-bold text-dark-green">@entry.Amount.ToString("N0")</td>
                                        <td class="py-3 text-end text-danger x-small">-@entry.Commission.ToString("N0")</td>
                                        <td class="py-3 text-end text-success fw-bold">+@entry.Net.ToString("N0")</td>
                                        <td class="py-3 text-center">
                                            @if (entry.PayoutStatus == "Paid") { <span class="status-badge bg-soft-success text-success">Released</span> }
                                            else if (entry.PayoutStatus == "Pending") { <span class="status-badge bg-soft-warning text-warning">Pending</span> }
                                            else { <span class="status-badge bg-soft-secondary text-secondary">@entry.PayoutStatus</span> }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
            <div class="modal-header bg-dark-green text-white py-4 px-4 border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-wallet me-2"></i> Request Payout</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="bg-faint-green rounded-5 p-4 mb-4 border-dashed-custom">
                    <p class="text-muted small mb-1">Available for Withdrawal</p>
                    <h2 class="fw-bold text-dark-green">@ViewBag.NetEarnings.ToString("C")</h2>
                </div>
                
                <div class="alert bg-soft-info text-info border-0 rounded-4 x-small mb-4 text-start">
                    <i class="fas fa-info-circle me-2"></i> Funds will be transferred to your primary bank account within 48 hours.
                </div>
                
                <button class="btn btn-dark-green w-100 rounded-pill py-3 fw-bold shadow-premium" onclick="alert('Payout request submitted!'); $('#withdrawModal').modal('hide');">
                    Confirm Payout
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .x-small { font-size: 0.75rem; }

        .status-badge {
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-secondary { background-color: rgba(108, 117, 125, 0.1); }

        .border-dashed-custom { border: 2px dashed #e2e8f0; }

        .search-bar-premium input:focus {
            background-color: var(--faint-green) !important;
            box-shadow: none;
            border: 1px solid var(--accent-green) !important;
        }

        .animate-slide-up {
            animation: slideUp 0.5s ease-out;
        }

        @@keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        
        .tracking-wider { letter-spacing: 1px; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748B';

            // Earnings Trend Chart (Merged from Dev)
            const trendCtx = document.getElementById('earningsTrendChart').getContext('2d');
            const accentColor = '#4da699';
            
            const trendGradient = trendCtx.createLinearGradient(0, 0, 0, 320);
            trendGradient.addColorStop(0, 'rgba(77, 166, 153, 0.2)');
            trendGradient.addColorStop(1, 'rgba(77, 166, 153, 0)');

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendLabels)),
                    datasets: [{
                        label: 'Net Earnings',
                        data: @Html.Raw(Json.Serialize(ViewBag.EarningsTrendValues)),
                        borderColor: accentColor,
                        backgroundColor: trendGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: accentColor,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a3d31',
                            padding: 12,
                            cornerRadius: 10,
                            titleFont: { size: 12 },
                            bodyFont: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { font: { size: 11 } }
                        },
                        x: { 
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });
        });
    </script>
}
