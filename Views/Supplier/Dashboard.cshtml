@model SCM_System.Models.ViewModels.SupplierDashboardViewModel

@{
    ViewData["Title"] = "Supplier Control Center";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="glass-header p-4 mb-4 rounded-4 shadow-sm position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.1) 0%, rgba(13, 110, 253, 0.05) 100%); border: 1px solid rgba(13, 110, 253, 0.2);">
        <div class="d-flex justify-content-between align-items-center position-relative z-1">
            <div>
                <h4 class="text-primary fw-bold mb-1">Operational Control Center</h4>
                <p class="text-muted mb-0">Real-time performance metrics and logistics overview</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-white btn-sm shadow-sm border rounded-pill px-3">
                    <i class="fas fa-download me-1"></i> Export Data
                </button>
                <div class="dropdown">
                    <button class="btn btn-primary btn-sm rounded-pill px-3 dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-plus me-1"></i> Quick Action
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3">
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Create">Add New Product</a></li>
                        <li><a class="dropdown-item" asp-controller="Supplier" asp-action="AddEmployee">Register Employee</a></li>
                        <li><a class="dropdown-item" asp-controller="Supplier" asp-action="CreateWarehouse">Add Warehouse</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Reports">View All Reports</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Top KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                            <i class="fas fa-dollar-sign fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small fw-bold text-uppercase mb-0">Total Revenue</p>
                            <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("C0")</h3>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="text-success small fw-bold"><i class="fas fa-arrow-up me-1"></i>12.5%</span>
                        <span class="text-muted small ms-2">vs last month</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                            <i class="fas fa-shopping-bag fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small fw-bold text-uppercase mb-0">Active Orders</p>
                            <h3 class="fw-bold mb-0">@Model.ActiveOrders</h3>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width: 70%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                            <i class="fas fa-truck fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small fw-bold text-uppercase mb-0">In Delivery</p>
                            <h3 class="fw-bold mb-0">@Model.OrdersInDelivery</h3>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small">Critical Logistics</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                            <i class="fas fa-exclamation-triangle fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small fw-bold text-uppercase mb-0">Low Stock Issues</p>
                            <h3 class="fw-bold mb-0">@Model.LowStockItems</h3>
                        </div>
                    </div>
                    <a asp-controller="Supplier" asp-action="Reports" class="text-danger small fw-bold text-decoration-none">View Alerts <i class="fas fa-chevron-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Section -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Revenue & Order Volume</h5>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary px-3">Weekly</button>
                        <button class="btn btn-primary px-3">Monthly</button>
                    </div>
                </div>
                <div class="card-body p-4 pt-0">
                    <canvas id="revenueChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4">
                    <h5 class="fw-bold mb-0">Warehouse Distribution</h5>
                </div>
                <div class="card-body p-4 pt-0 d-flex flex-column justify-content-center">
                    <canvas id="warehouseChart" style="max-height: 250px;"></canvas>
                    <div class="mt-4 pt-2 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Avg Completion:</span>
                            <span class="fw-bold">@Model.CompletionRate.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success rounded-pill" style="width: @Model.CompletionRate%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Overview & Activity -->
    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4">
                    <h5 class="fw-bold mb-0">Order Status Summary</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="list-group list-group-flush border-top-0">
                        @foreach (var status in new[] { "Pending", "Accepted", "Processing", "Packed", "In Transit", "Delivered", "Completed" })
                        {
                            int count = Model.StatusCounts.ContainsKey(status) ? Model.StatusCounts[status] : 0;
                            <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="status-indicator me-3 @GetStatusClass(status)"></div>
                                    <span class="fw-bold">@status</span>
                                </div>
                                <span class="badge bg-light text-dark rounded-pill px-3 py-2 border">@count</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Activity</h5>
                    <a asp-action="Notifications" class="small text-decoration-none">View All</a>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="timeline-container">
                        @if (Model.RecentActivity.Any())
                        {
                            foreach (var activity in Model.RecentActivity)
                            {
                                <div class="activity-item d-flex mb-4">
                                    <div class="activity-icon-container me-3">
                                        <div class="activity-icon bg-@activity.Type.ToLower() bg-opacity-10 text-@activity.Type.ToLower() rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="fas @GetActivityIcon(activity.Type)"></i>
                                        </div>
                                        <div class="activity-line"></div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold">@activity.Title</h6>
                                        <p class="text-muted small mb-1">@activity.Description</p>
                                        <div class="d-flex align-items-center">
                                            <span class="text-muted" style="font-size: 0.75rem;"><i class="far fa-clock me-1"></i>@activity.Time.ToString("MMM dd, HH:mm")</span>
                                            @if (!string.IsNullOrEmpty(activity.ActionUrl))
                                            {
                                                <a href="@activity.ActionUrl" class="ms-3 text-primary fw-bold" style="font-size: 0.75rem;">Take Action</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-bell-slash fa-3x mb-3 opacity-25"></i>
                                <p>No recent activity detected</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Accepted" => "bg-info",
            "Processing" => "bg-primary",
            "Packed" => "bg-purple",
            "In Transit" => "bg-indigo",
            "Delivered" => "bg-success",
            "Completed" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    string GetActivityIcon(string type)
    {
        return type switch
        {
            "Success" => "fa-check",
            "Warning" => "fa-exclamation",
            "Danger" => "fa-times",
            "Info" => "fa-info",
            _ => "fa-bell"
        };
    }
}

@section Styles {
    <style>
        .bg-purple { background-color: #6f42c1 !important; }
        .bg-indigo { background-color: #6610f2 !important; }
        .text-purple { color: #6f42c1 !important; }
        
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(0,0,0,0.05);
        }

        .activity-item { position: relative; }
        .activity-line {
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: -20px;
            width: 2px;
            background: #f3f4f6;
            z-index: 0;
        }
        .activity-item:last-child .activity-line { display: none; }
        
        .glass-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 70%);
            transform: rotate(30deg);
            pointer-events: none;
        }
        
        .icon-shape {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Revenue Chart
            const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRevenue, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(d => d.Label))),
                    datasets: [{
                        label: 'Revenue',
                        data: @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(d => d.Value))),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#0d6efd',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }, {
                        label: 'Orders',
                        type: 'bar',
                        data: @Html.Raw(Json.Serialize(Model.OrderVolumeTrend.Select(d => d.Value))),
                        backgroundColor: 'rgba(108, 117, 125, 0.1)',
                        borderRadius: 5,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { display: false }
                        },
                        y1: {
                            position: 'right',
                            beginAtZero: true,
                            grid: { display: false }
                        },
                        x: {
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Warehouse Chart
            const ctxWarehouse = document.getElementById('warehouseChart').getContext('2d');
            new Chart(ctxWarehouse, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.WarehousePerformance.Select(d => d.Label))),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.WarehousePerformance.Select(d => d.Value))),
                        backgroundColor: [
                            '#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#6610f2'
                        ],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20,
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });
        });
    </script>
}