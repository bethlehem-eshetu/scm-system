@model IEnumerable<SCM_System.Models.Entities.SupplierEmployee>
@{
    ViewData["Title"] = "Employee Directory";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header & Stats -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="fas fa-users-cog me-2"></i>Employee Directory</h2>
            <p class="text-muted mb-0">Manage your workforce hierarchy and operational assignments</p>
        </div>
        <a asp-action="AddEmployee" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus me-2"></i> Add New Employee
        </a>
    </div>

    <!-- Filters & Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="employeeSearch" class="form-control border-start-0 ps-0" placeholder="Search by name, email or role...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-3" id="roleFilter">
                        <option value="">All Roles</option>
                        <option value="WarehouseManager">Warehouse Managers</option>
                        <option value="DeliveryAgent">Delivery Agents</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex gap-2 justify-content-md-end">
                    <div class="stats-badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-industry me-1"></i> @Model.Count(e => e.EmployeeRole == "WarehouseManager") Managers
                    </div>
                    <div class="stats-badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-truck me-1"></i> @Model.Count(e => e.EmployeeRole == "DeliveryAgent") Agents
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Grid -->
    <div class="row g-4" id="employeeGrid">
        @foreach (var emp in Model)
        {
            var isManager = emp.EmployeeRole == "WarehouseManager";
            <div class="col-xl-3 col-lg-4 col-md-6 employee-card" data-role="@emp.EmployeeRole" data-name="@emp.User.FullName.ToLower()">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift card-employee @(emp.IsActive ? "" : "opacity-75")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="avatar-md @(isManager ? "bg-primary" : "bg-success") bg-opacity-10 @(isManager ? "text-primary" : "text-success") rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                <i class="fas @(isManager ? "fa-user-tie" : "fa-shuttle-van") fs-4"></i>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-h fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                    <li><a class="dropdown-item py-2" asp-action="EditEmployee" asp-route-id="@emp.Id"><i class="fas fa-edit me-2 text-primary"></i> Edit Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="DeleteEmployee" asp-route-id="@emp.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger" onclick="return confirm('Archive this employee?')">
                                                <i class="fas fa-user-slash me-2"></i> Deactivate
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-1 text-truncate">@emp.User.FullName</h5>
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge @(isManager ? "bg-primary-soft text-primary" : "bg-success-soft text-success") rounded-pill px-2 py-1 extra-small">
                                @(isManager ? "👷 Warehouse Manager" : "🚚 Delivery Agent")
                            </span>
                            @if (emp.IsActive)
                            {
                                <span class="ms-2 small text-success"><i class="fas fa-circle fs-xs me-1"></i> Active</span>
                            }
                        </div>

                        <div class="employee-meta small text-muted mb-4">
                            <div class="mb-2"><i class="fas fa-envelope me-2 opacity-50"></i>@emp.User.Email</div>
                            <div class="mb-2"><i class="fas fa-phone me-2 opacity-50"></i>@emp.User.PhoneNumber</div>
                            @if (isManager)
                            {
                                <div class="mt-3 p-2 bg-light rounded-3">
                                    <div class="fw-bold text-dark small"><i class="fas fa-warehouse me-2 text-primary"></i> Node Assignment</div>
                                    <div class="ps-4">@(emp.Warehouse?.Name ?? "Unassigned")</div>
                                </div>
                            }
                            else
                            {
                                <div class="mt-3 p-2 bg-light rounded-3">
                                    <div class="fw-bold text-dark small"><i class="fas fa-id-card me-2 text-success"></i> Fleet & License</div>
                                    <div class="ps-4">@(emp.Vehicle?.LicensePlate ?? "No Vehicle") | @(emp.DrivingLicenseNumber ?? "No License")</div>
                                </div>
                            }
                        </div>

                        <div class="d-grid mt-auto">
                            <a asp-action="EditEmployee" asp-route-id="@emp.Id" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">View Performance</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 bg-white shadow-sm rounded-4 d-inline-block">
                <i class="fas fa-users-slash fa-4x text-muted opacity-25 mb-4"></i>
                <h4 class="fw-bold">No Employees Found</h4>
                <p class="text-muted mb-4">Start building your team by adding your first employee.</p>
                <a asp-action="AddEmployee" class="btn btn-primary rounded-pill px-5 fw-bold">Add New Employee</a>
            </div>
        </div>
    }
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .extra-small { font-size: 0.75rem; }
    .fs-xs { font-size: 0.5rem; }
    
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }

    #employeeGrid .employee-card {
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            function filterEmployees() {
                var searchText = $('#employeeSearch').val().toLowerCase();
                var roleFilter = $('#roleFilter').val();

                $('.employee-card').each(function() {
                    var name = $(this).data('name');
                    var role = $(this).data('role');
                    
                    var matchesSearch = name.includes(searchText);
                    var matchesRole = roleFilter === "" || role === roleFilter;

                    if (matchesSearch && matchesRole) {
                        $(this).fadeIn(200);
                    } else {
                        $(this).fadeOut(200);
                    }
                });
            }

            $('#employeeSearch').on('keyup', filterEmployees);
            $('#roleFilter').on('change', filterEmployees);
        });
    </script>
}
