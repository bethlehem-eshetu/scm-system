@section Scripts {
    <script>
        // ============================================
        // RESTOCK MODAL SCRIPT - Pass product data to modal
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const restockModal = document.getElementById('restockModal');
            
            if (restockModal) {
                restockModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const productName = button.getAttribute('data-product-name');
                    const currentStock = button.getAttribute('data-current-stock');
                    
                    document.getElementById('modalProductDisplay').textContent = productName;
                    document.getElementById('modalProductNameField').value = productName;
                    
                    const stockWarning = document.getElementById('modalStockWarning');
                    if (currentStock <= 5) {
                        stockWarning.innerHTML = `⚠️ Only ${currentStock} units left! Order urgently.`;
                        stockWarning.style.color = '#fca5a5';
                    } else if (currentStock <= 20) {
                        stockWarning.innerHTML = `⚠️ Only ${currentStock} units remaining. Order soon.`;
                        stockWarning.style.color = '#fbbf24';
                    } else {
                        stockWarning.innerHTML = `Current stock: ${currentStock} units. Reorder to avoid running out.`;
                        stockWarning.style.color = '#9ca3af';
                    }
                    
                    const qtyInput = document.getElementById('orderQuantity');
                    if (currentStock <= 10) {
                        qtyInput.value = 200;
                    } else if (currentStock <= 30) {
                        qtyInput.value = 100;
                    } else {
                        qtyInput.value = 50;
                    }
                });
            }
        });
        
        function incrementQty() {
            const qtyInput = document.getElementById('orderQuantity');
            let currentVal = parseInt(qtyInput.value);
            if (isNaN(currentVal)) currentVal = 0;
            qtyInput.value = currentVal + 10;
        }
        
        function decrementQty() {
            const qtyInput = document.getElementById('orderQuantity');
            let currentVal = parseInt(qtyInput.value);
            if (isNaN(currentVal)) currentVal = 0;
            if (currentVal > 1) {
                qtyInput.value = currentVal - 10;
            }
        }
        
        const restockForm = document.getElementById('restockForm');
        if (restockForm) {
            restockForm.addEventListener('submit', function(e) {
                const quantity = document.getElementById('orderQuantity').value;
                if (!quantity || parseInt(quantity) < 1) {
                    e.preventDefault();
                    alert('Please enter a valid quantity (at least 1)');
                }
            });
        }
    </script>
}