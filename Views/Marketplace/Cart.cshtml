@model SCM_System.Models.Entities.Cart

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-shopping-cart text-primary me-2"></i> Shopping Cart</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Continue Shopping
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="card shadow text-center py-5">
            <div class="card-body">
                <i class="fas fa-shopping-basket fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">Your cart is empty</h4>
                <p class="mb-4">Looks like you haven't added any products to your cart yet.</p>
                <a asp-action="Index" class="btn btn-primary btn-lg px-4">Browse Marketplace</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Cart Items</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Supplier</th>
                                        <th>Price</th>
                                        <th style="width: 15%">Quantity</th>
                                        <th>Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@item.Product.ProductName</div>
                                                <small class="text-muted">SKU: @item.Product.SKU</small>
                                            </td>
                                            <td>@item.Product.Supplier?.CompanyName</td>
                                            <td>@item.Product.BasePrice.ToString("C")</td>
                                            <td>
                                                <form asp-action="UpdateCartItem" method="post" class="d-flex">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <input type="number" name="quantity" class="form-control form-control-sm me-1" value="@item.Quantity" min="1" max="@item.Product.Quantity" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Update"><i class="fas fa-sync-alt"></i></button>
                                                </form>
                                            </td>
                                            <td class="fw-bold">
                                                @((item.Quantity * item.Product.BasePrice).ToString("C"))
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="RemoveFromCart" method="post">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow">
                    <div class="card-header py-3 bg-light">
                        <h6 class="m-0 font-weight-bold text-primary">Order Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal:</span>
                            <span class="fw-bold">@Model.CartItems.Sum(i => i.Quantity * i.Product.BasePrice).ToString("C")</span>
                        </div>
                        <hr />
                        
                        <form asp-action="Checkout" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Delivery Address <span class="text-danger">*</span></label>
                                <textarea name="deliveryAddress" class="form-control" rows="3" required placeholder="Enter full delivery address..."></textarea>
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-bold">Expected Delivery Date <span class="text-danger">*</span></label>
                                <input type="date" name="expectedDeliveryDate" class="form-control" required min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" />
                            </div>
                            
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i> This will generate Direct Purchase Orders to the respective suppliers.
                            </div>
                            
                            <button type="submit" class="btn btn-success w-100 btn-lg">
                                <i class="fas fa-check-circle me-2"></i> Generate Purchase Order(s)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
