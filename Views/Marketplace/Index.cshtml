@model IEnumerable<SCM_System.Models.Entities.Product>

@{
    ViewData["Title"] = "Marketplace";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Direct Purchase Marketplace</h2>
        <a asp-action="Cart" class="btn btn-primary position-relative">
            <i class="fas fa-shopping-cart me-2"></i> View Cart
            @if (ViewBag.CartItemCount != null && ViewBag.CartItemCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @ViewBag.CartItemCount
                </span>
            }
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-md-3 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-filter me-2"></i> Filters</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="get">
                        <div class="mb-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="searchString" class="form-control" placeholder="Product name or description..." value="@Context.Request.Query["searchString"]" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select name="categoryId" class="form-select">
                                <option value="">All Categories</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id" selected="@(Context.Request.Query["categoryId"] == cat.Id.ToString())">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Min Price</label>
                            <input type="number" step="0.01" name="minPrice" class="form-control" placeholder="0.00" value="@Context.Request.Query["minPrice"]" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Max Price</label>
                            <input type="number" step="0.01" name="maxPrice" class="form-control" placeholder="10000.00" value="@Context.Request.Query["maxPrice"]" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Supplier Location</label>
                            <select name="supplierCity" class="form-select">
                                <option value="">All Locations</option>
                                @if (ViewBag.Cities != null)
                                {
                                    foreach (var city in ViewBag.Cities)
                                    {
                                        <option value="@city" selected="@(Context.Request.Query["supplierCity"] == city)">@city</option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Clear</a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Product Listings -->
        <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @if (!Model.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-info">
                            No products found matching your criteria.
                        </div>
                    </div>
                }
                else
                {
                    foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: contain; padding: 10px;">
                                }
                                else
                                {
                                    <div class="bg-light text-center py-5">
                                        <i class="fas fa-box fa-4x text-muted"></i>
                                    </div>
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate" title="@product.ProductName">@product.ProductName</h5>
                                    <h6 class="text-primary mb-2">@product.BasePrice.ToString("C")</h6>
                                    
                                    <div class="mb-2 small text-muted">
                                        <div><i class="fas fa-store me-1"></i> @product.Supplier?.CompanyName</div>
                                        <div><i class="fas fa-map-marker-alt me-1"></i> @product.Supplier?.City</div>
                                        <div><i class="fas fa-tag me-1"></i> @product.Category?.CategoryName</div>
                                    </div>
                                    
                                    <p class="card-text small text-truncate-2 flex-grow-1">@product.Description</p>
                                    
                                    <form asp-action="AddToCart" method="post" class="mt-auto">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <div class="input-group">
                                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="@product.Quantity" required />
                                            <button type="submit" class="btn btn-outline-primary">
                                                <i class="fas fa-cart-plus"></i> Add
                                            </button>
                                        </div>
                                        <div class="form-text mt-1 text-end">Stock: @product.Quantity @product.Unit</div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
.text-truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;  
    overflow: hidden;
}
</style>
