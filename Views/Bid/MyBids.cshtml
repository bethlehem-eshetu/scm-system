@model IEnumerable<SCM_System.Models.Entities.TenderBid>
<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header Logic -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-chart-line text-primary me-2"></i>Bid Performance Dashboard</h2>
            <p class="text-muted mb-0 small">Executive overview of active proposals and commercial exposure.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tender" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New Proposal
            </a>
            <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm bg-white">
                <i class="fas fa-download me-2"></i> Export Report
            </button>
        </div>
    </div>

    <!-- Executive KPI Bar -->
    @{
        var totalBids = Model.Count();
        var wonBids = Model.Count(b => b.Status == "Accepted");
        var activeValue = Model.Where(b => b.Status == "Pending").Sum(b => b.ProposedTotalAmount);
        var winRate = totalBids > 0 ? (wonBids * 100 / totalBids) : 0;
    }
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white border-bottom border-4 border-primary">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-2">Total Proposals</label>
                <h2 class="fw-bold text-dark mb-0">@totalBids</h2>
                <span class="smaller text-primary fw-bold">Commercial Engagements</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white border-bottom border-4 border-success">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-2">Win Rate</label>
                <div class="d-flex align-items-center justify-content-center">
                    <h2 class="fw-bold text-success mb-0">@winRate%</h2>
                    <i class="fas fa-arrow-up text-success ms-2 small"></i>
                </div>
                <span class="smaller text-muted">@wonBids Awarded Contracts</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white border-bottom border-4 border-warning">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-2">Portfolio Value</label>
                <h2 class="fw-bold text-dark mb-0">@activeValue.ToString("N0")</h2>
                <span class="smaller text-muted">ETB in Pending Bids</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-primary text-white shadow">
                <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-2">Avg Tech Score</label>
                <h2 class="fw-bold mb-0">@(totalBids > 0 ? Model.Average(b => b.Score).ToString("N1") : "0.0")</h2>
                <span class="smaller opacity-75">Compliance Quality</span>
            </div>
        </div>
    </div>

    <!-- Bid Control Center -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Active & Historical Proposals</h6>
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <input type="text" class="form-control rounded-pill-start" placeholder="Search references...">
                        <button class="btn btn-outline-secondary rounded-pill-end"><i class="fas fa-search"></i></button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="smaller text-muted text-uppercase">
                                <th class="ps-4">Tender Reference</th>
                                <th>Bid Value</th>
                                <th class="text-center">Lead Time</th>
                                <th class="text-center">Score</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-4">Workspace</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bid in Model.OrderByDescending(b => b.SubmittedAt))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="p-2 bg-light rounded-3 me-3"><i class="fas fa-file-invoice text-primary"></i></div>
                                            <div>
                                                <div class="fw-bold text-dark">@bid.Tender?.Title</div>
                                                <div class="smaller text-muted">Ref: @bid.Tender?.ReferenceNumber &bull; @bid.SubmittedAt.ToString("MMM dd")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@bid.ProposedTotalAmount.ToString("N2")</div>
                                        <div class="smaller text-muted">ETB (VAT Incl)</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="fw-bold">@bid.DeliveryLeadTimeDays Days</div>
                                        <div class="smaller text-muted">Fulfillment</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="badge bg-primary-subtle text-primary border rounded-pill">@bid.Score.ToString("N1")</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GetBidStatusClass(bid.Status) rounded-pill px-3 py-2 shadow-sm">@bid.Status</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-controller="Tender" asp-action="Details" asp-route-id="@bid.TenderId" class="btn btn-sm btn-white border px-3 rounded-pill me-2 shadow-sm">
                                                <i class="fas fa-eye me-1"></i> Original
                                            </a>
                                            <button type="button" onclick="viewFeedback(@bid.Id)" class="btn btn-sm btn-primary px-3 rounded-pill shadow-sm fw-bold">
                                                Performance <i class="fas fa-chart-line ms-1"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if(!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="opacity-50 mb-3"><i class="fas fa-folder-open fa-3x"></i></div>
                                        <h6 class="fw-bold text-muted">No proposals found in your history.</h6>
                                        <a asp-controller="Tender" asp-action="Index" class="btn btn-link text-primary text-decoration-none fw-bold">Start bidding now</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBidStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning-subtle text-warning border-warning",
            "Accepted" => "bg-success-subtle text-success border-success",
            "Rejected" => "bg-danger-subtle text-danger border-danger",
            _ => "bg-light text-muted border"
        };
    }
}

<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="feedbackModalLabel">Bid Performance Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="feedbackModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Analyzing your proposal...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewFeedback(bidId) {
            const modalBody = document.getElementById('feedbackModalBody');
            modalBody.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Analyzing your proposal...</p>
                </div>`;
            
            const modal = new bootstrap.Modal(document.getElementById('feedbackModal'));
            modal.show();

            fetch(`/Bid/GetFeedback?bidId=${bidId}`)
                .then(response => response.text())
                .then(html => {
                    modalBody.innerHTML = html;
                })
                .catch(error => {
                    modalBody.innerHTML = '<div class="alert alert-danger m-3">Error loading feedback details.</div>';
                    console.error('Error:', error);
                });
        }
    </script>
}

<style>
    .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.5px; }
    .bg-success-subtle { background-color: #e9f7ef; border: 1px solid rgba(40, 167, 69, 0.2); }
    .bg-warning-subtle { background-color: #fef9e7; border: 1px solid rgba(255, 193, 7, 0.2); }
    .bg-danger-subtle { background-color: #fceae9; border: 1px solid rgba(220, 53, 69, 0.2); }
    .bg-primary-subtle { background-color: #e7f1ff; border: 1px solid rgba(0, 123, 255, 0.2); }
    .rounded-4 { border-radius: 1rem !important; }
    .rounded-pill-start { border-top-left-radius: 50rem !important; border-bottom-left-radius: 50rem !important; }
    .rounded-pill-end { border-top-right-radius: 50rem !important; border-bottom-right-radius: 50rem !important; }
    .btn-white { background: white; }
</style>
