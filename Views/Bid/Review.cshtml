@model IEnumerable<SCM_System.Models.Entities.TenderBid>
@{
    ViewData["Title"] = "Review Bids";
    Layout = "_DashboardLayout";
    var tender = ViewBag.Tender as SCM_System.Models.Entities.Tender;
    var bestScore = Model.Any() ? Model.Max(b => b.Score) : 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Review Bids: <span class="text-primary">@tender?.Title</span></h2>
            <p class="text-muted">Reference: <span class="fw-bold">@tender?.ReferenceNumber</span> | Deadline: @tender?.SubmissionDeadline.ToString("MMM dd")</p>
        </div>
        <a asp-controller="Tender" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 bg-white shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Back to Tenders
        </a>
    </div>

    <!-- Evaluation Summary Card -->
    <div class="glass-card p-4 mb-4 border-primary border-opacity-10">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h5 class="fw-bold mb-3"><i class="fas fa-chart-pie me-2 text-primary"></i>Evaluation Weights</h5>
                <div class="d-flex gap-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                        <span class="small fw-bold">Price: @tender?.PriceWeight%</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="bg-info rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                        <span class="small fw-bold">Technical: @tender?.TechnicalWeight%</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="bg-warning rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                        <span class="small fw-bold">Delivery: @tender?.DeliveryWeight%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <div class="badge bg-primary bg-opacity-10 text-primary p-3 rounded-4">
                    <div class="small fw-bold text-uppercase">Total Bids</div>
                    <div class="h3 fw-bold mb-0">@Model.Count()</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var bid in Model.OrderByDescending(b => b.Score))
        {
            var isBest = bid.Score == bestScore && bid.Score > 0;
            <div class="col-xl-6">
                <div class="glass-card overflow-hidden h-100 position-relative @(bid.Status == "Accepted" ? "border-success border-2 shadow-lg" : "")">
                    @if (isBest && bid.Status != "Accepted")
                    {
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge bg-warning text-dark p-2 rounded-pill shadow-sm">
                                <i class="fas fa-star me-1"></i>SYSTEM RECOMMENDED
                            </span>
                        </div>
                    }

                    <div class="p-4 border-bottom bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center">
                                <div class="bg-white rounded-4 p-3 shadow-sm me-3 border text-center" style="width: 70px;">
                                    <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.6rem;">Score</div>
                                    <div class="h4 fw-bold mb-0 text-primary">@bid.Score.ToString("0")%</div>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">@bid.Supplier?.CompanyName</h5>
                                    <div class="small text-muted"><i class="fas fa-calendar-alt me-1"></i>Submitted: @bid.SubmittedAt.ToString("MMM dd, HH:mm")</div>
                                </div>
                            </div>
                            <span class="badge @(bid.Status == "Accepted" ? "bg-success" : (bid.Status == "Rejected" ? "bg-danger" : "bg-primary")) rounded-pill px-3 py-2">
                                @bid.Status
                            </span>
                        </div>
                    </div>

                    <div class="p-4">
                        <div class="row g-4">
                            <!-- Financial -->
                            <div class="col-md-6 border-end">
                                <h6 class="fw-bold small text-uppercase text-muted mb-3"><i class="fas fa-dollar-sign me-2"></i>Financial Proposal</h6>
                                <div class="mb-2">
                                    <div class="small text-muted">Total Bid Amount</div>
                                    <div class="h5 fw-bold text-success mb-0">$@bid.ProposedTotalAmount.ToString("N2")</div>
                                </div>
                                <div class="small mb-1">Unit Price: <strong>$@bid.UnitPrice.ToString("N2")</strong></div>
                                <div class="small">Lead Time: <strong>@bid.DeliveryLeadTimeDays Days</strong></div>
                            </div>

                            <!-- Logistics & Technical -->
                            <div class="col-md-6">
                                <h6 class="fw-bold small text-uppercase text-muted mb-3"><i class="fas fa-info-circle me-2"></i>Logistics & Quality</h6>
                                <div class="small mb-2">Method: <strong>@bid.DeliveryMethod</strong></div>
                                <div class="small mb-2">Inspection: <strong>@bid.InspectionCompliance</strong></div>
                                <div class="small">Packaging: <strong>@bid.PackagingPlan</strong></div>
                            </div>
                        </div>

                        <hr class="my-4 opacity-10">

                        <div class="mb-3">
                            <h6 class="fw-bold small text-muted mb-2">Technical Proposal Extract:</h6>
                            <p class="small text-dark bg-light p-3 rounded-4 mb-0 border">
                                @(string.IsNullOrEmpty(bid.TechnicalProposal) ? "No technical proposal provided." : bid.TechnicalProposal)
                            </p>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(bid.Notes))
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold small text-muted mb-2">Additional Notes:</h6>
                                <div class="alert alert-info border-0 rounded-4 p-2 small mb-0">
                                    <i class="fas fa-comment-alt me-2"></i>@bid.Notes
                                </div>
                            </div>
                        }
                    </div>

                    @if (tender?.Status == "Published" && bid.Status == "Pending")
                    {
                        <div class="p-4 bg-light bg-opacity-50 border-top">
                            <form asp-action="Accept" method="post">
                                <input type="hidden" name="id" value="@bid.Id" />
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <input type="text" name="deliveryAddress" class="form-control rounded-pill border-primary" placeholder="Set Final Delivery Address..." required value="@tender.DeliveryLocation" />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold" onclick="return confirm('Accept this bid? This will automatically generate the Purchase Order and assign warehouses.')">
                                            <i class="fas fa-check-circle me-1"></i>Accept Bid
                                        </button>
                                    </div>
                                </div>
                                @Html.AntiForgeryToken()
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
</style>
