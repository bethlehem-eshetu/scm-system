@model IEnumerable<SCM_System.Models.Entities.TenderBid>
@{
    ViewData["Title"] = "Review Bids";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tender = ViewBag.Tender as SCM_System.Models.Entities.Tender;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Review Bids for @tender?.Title</h2>
        <a asp-controller="Tender" asp-action="MyTenders" class="btn btn-secondary">Back to Tenders</a>
    </div>
    
    <div class="row">
        @foreach(var bid in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 @(bid.Status == "Accepted" ? "border-success border-2" : (bid.Status == "Rejected" ? "opacity-75 bg-light" : ""))">
                    <div class="card-header @(bid.Status == "Accepted" ? "bg-success text-white" : "bg-light")">
                        <h5 class="mb-0">Supplier: @bid.Supplier?.CompanyName</h5>
                    </div>
                    <div class="card-body">
                        <p class="fs-4 fw-bold text-success mb-2">@bid.ProposedTotalAmount.ToString("C")</p>
                        <ul class="list-unstyled">
                            <li><strong>Lead Time:</strong> @bid.DeliveryLeadTimeDays Days</li>
                            <li><strong>Validity:</strong> @bid.ValidityPeriodDays Days</li>
                            <li><strong>Status:</strong> <span class="badge @(bid.Status == "Accepted" ? "bg-success" : "bg-secondary")">@bid.Status</span></li>
                        </ul>
                        @if(!string.IsNullOrEmpty(bid.Notes)) {
                            <div class="alert alert-secondary mt-2 mb-0 p-2"><small>@bid.Notes</small></div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0">
                        @if(tender?.Status == "Open" && bid.Status == "Pending")
                        {
                            <form asp-action="Accept" method="post" class="mt-2">
                                <input type="hidden" name="id" value="@bid.Id" />
                                <div class="input-group">
                                    <input type="text" name="deliveryAddress" class="form-control" placeholder="Enter Delivery Address" required />
                                    <button type="submit" class="btn btn-success">Accept & Generate PO</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
        @if(!Model.Any()) {
            <div class="col-12"><div class="alert alert-info">No bids received yet for this tender.</div></div>
        }
    </div>
</div>
