@model SCM_System.Models.Entities.TenderBid
@{
    ViewData["Title"] = "Proposal Review";
    Layout = "_DashboardLayout";
    var tender = Model.Tender;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 text-dark">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Tender" asp-action="Index">Tenders</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Tender" asp-action="Details" asp-route-id="@tender.Id">@tender.ReferenceNumber</a></li>
                    <li class="breadcrumb-item active">Proposal from @Model.Supplier?.CompanyName</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-dark">Review Proposal: <span class="text-primary">@Model.Supplier?.CompanyName</span></h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Review" asp-route-tenderId="@tender.Id" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Back to All Bids
            </a>
            @if (tender.Status == "Published" && Model.Status == "Pending")
            {
                <form asp-action="Accept" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="deliveryAddress" value="@tender.DeliveryLocation" />
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow" onclick="return confirm('Award this tender to @Model.Supplier?.CompanyName?')">
                        <i class="fas fa-award me-2"></i> Award Contract
                    </button>
                    @Html.AntiForgeryToken()
                </form>
            }
        </div>
    </div>

    <div class="row g-4 text-dark">
        <!-- Left Column: Detailed Proposal -->
        <div class="col-lg-8">
            <!-- 1. Technical Proposal & Quality -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-info">
                        <i class="fas fa-vial me-2"></i>1. Quality & Technical Compliance
                    </h5>
                </div>
                <div class="card-body p-4 text-dark">
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-2">Technical Specification Match</label>
                        <div class="p-3 bg-light rounded-4 border">
                            <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.TechnicalProposal</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6 text-dark">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Warranty Details</label>
                            <div class="d-flex align-items-center">
                                <div class="bg-info bg-opacity-10 text-info p-2 rounded-3 me-3">
                                    <i class="fas fa-shield-alt fa-lg"></i>
                                </div>
                                <div class="text-dark">
                                    <div class="fw-bold">@(string.IsNullOrEmpty(Model.WarrantyPeriod) ? "No Warranty Offered" : Model.WarrantyPeriod)</div>
                                    <div class="small text-muted text-dark">Type: @(string.IsNullOrEmpty(Model.WarrantyType) ? "N/A" : Model.WarrantyType)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-dark">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Packaging Plan</label>
                            <p class="fw-medium text-dark"><i class="fas fa-box me-2 text-secondary"></i>@Model.PackagingPlan</p>
                        </div>
                        <div class="col-md-6 text-dark">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Inspection Compliance</label>
                            <p class="fw-medium text-dark">
                                @if(Model.InspectionCompliance == "Accept") {
                                    <span class="text-success"><i class="fas fa-check-circle me-1"></i> Pre-shipment Inspection Accepted</span>
                                } else {
                                    <span class="text-danger"><i class="fas fa-times-circle me-1"></i> Inspection Declined</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Commercial & Experience -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-success">
                        <i class="fas fa-briefcase me-2"></i>2. Experience & Commercial Terms
                    </h5>
                </div>
                <div class="card-body p-4 text-dark">
                    <div class="mb-4 text-dark">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-2">Supplier Previous Experience</label>
                        <div class="p-3 bg-light rounded-4 border text-dark">
                            <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(Model.PreviousExperience) ? "No experience history provided with this proposal." : Model.PreviousExperience)</p>
                        </div>
                    </div>

                    <div class="mb-4 text-dark">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-2">Proposed Payment Plan</label>
                        <div class="p-3 border-start border-4 border-success bg-success bg-opacity-10 text-dark">
                            <p class="mb-0 fw-bold text-dark">@Model.PaymentTerms</p>
                        </div>
                    </div>

                    <div class="row g-4 text-dark">
                        <div class="col-md-6 text-dark">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Lead Time</label>
                            <p class="h5 fw-bold text-dark"><i class="fas fa-clock me-2 text-warning"></i>@Model.DeliveryLeadTimeDays Days</p>
                        </div>
                        <div class="col-md-6 text-dark">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Delivery Method</label>
                            <p class="fw-medium text-dark"><i class="fas fa-truck me-2 text-muted"></i>@Model.DeliveryMethod</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Commitment & Notes -->
            <div class="card border-0 shadow-sm rounded-4 text-dark">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-clipboard-check me-2"></i>3. Commitments & Additional Notes
                    </h5>
                </div>
                <div class="card-body p-4 text-dark">
                    <div class="mb-3 d-flex align-items-center text-dark">
                        @if(Model.PenaltyAcceptance) {
                            <div class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle me-3"><i class="fas fa-check"></i></div>
                            <div>
                                <div class="fw-bold text-dark">Delay Penalties Accepted</div>
                                <div class="small text-muted text-dark">Supplier agrees to liquidated damages for late delivery.</div>
                            </div>
                        } else {
                            <div class="badge bg-danger bg-opacity-10 text-danger p-2 rounded-circle me-3"><i class="fas fa-times"></i></div>
                            <div>
                                <div class="fw-bold text-dark">Delay Penalties Declined</div>
                                <div class="small text-muted text-dark">Supplier has not accepted standard penalty clauses.</div>
                            </div>
                        }
                    </div>
                    <hr class="my-3 text-dark">
                    <div class="text-dark">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-2">Additional Remarks</label>
                        <p class="small text-dark italic">@(string.IsNullOrEmpty(Model.Notes) ? "No additional notes." : Model.Notes)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Financial & Score -->
        <div class="col-lg-4 text-dark">
            <!-- Score Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white text-dark">
                <div class="card-body p-4 text-center text-dark">
                    <div class="small text-white text-opacity-75 text-uppercase fw-bold mb-2">Composite Evaluation Score</div>
                    <div class="display-3 fw-bold mb-1">@Model.Score.ToString("0")%</div>
                    <div class="small text-white text-opacity-75">based on @tender.PriceWeight/@tender.TechnicalWeight/@tender.DeliveryWeight split</div>
                </div>
            </div>

            <!-- Financial Summary Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 text-dark">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">Financial Summary</h5>
                </div>
                <div class="card-body p-4 text-dark">
                    <div class="d-flex justify-content-between mb-2 text-dark">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold text-dark">@Model.Subtotal.ToString("N2") ETB</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-danger text-dark">
                        <span class="small">Discount (@Model.DiscountPercentage%)</span>
                        <span class="small fw-bold text-dark">-@((Model.Subtotal * Model.DiscountPercentage / 100).ToString("N2")) ETB</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-dark">
                        <span class="small">VAT (@Model.VATPercentage%)</span>
                        <span class="small fw-bold text-dark">+@((Model.ProposedTotalAmount - (Model.Subtotal * (1 - Model.DiscountPercentage / 100))).ToString("N2")) ETB</span>
                    </div>
                    <hr class="text-dark">
                    <div class="d-flex justify-content-between align-items-center mb-0 text-dark">
                        <span class="h5 mb-0 fw-bold text-dark">Total Proposal</span>
                        <span class="h4 mb-0 fw-bold text-success text-dark">@Model.ProposedTotalAmount.ToString("N2") ETB</span>
                    </div>
                </div>
            </div>

            <!-- Tender Context Card -->
            <div class="card border-0 shadow-sm rounded-4 text-dark">
                <div class="card-body p-4 text-dark">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Tender Context</h6>
                    <div class="mb-3 text-dark">
                        <label class="text-muted small text-uppercase d-block fw-bold">Budget Limit</label>
                        <div class="fw-bold text-dark">@tender.BudgetMax?.ToString("N0") ETB</div>
                    </div>
                    <div class="mb-3 text-dark">
                        <label class="text-muted small text-uppercase d-block fw-bold">Required Delivery</label>
                        <div class="text-dark">@tender.ExpectedDeliveryDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="mb-0 text-dark">
                        <label class="text-muted small text-uppercase d-block fw-bold">Compliance Required</label>
                        <span class="badge @(Model.InspectionCompliance == tender.InspectionRequirement ? "bg-success" : "bg-warning")">
                            @(Model.InspectionCompliance == tender.InspectionRequirement ? "Fully Compliant" : "Review Required")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
