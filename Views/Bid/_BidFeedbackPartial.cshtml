@model SCM_System.Models.ViewModels.BidFeedbackViewModel

<div class="bid-score-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="text-muted small fw-bold">Your Bid Score</span>
            <div class="h3 fw-bold text-primary">@Model.Score<span class="small text-muted">/100</span></div>
        </div>
        <div class="text-end">
            <span class="badge @(Model.Rank == 1 ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2 shadow-sm fs-6">
                Rank #@Model.Rank of @Model.TotalBids
            </span>
        </div>
    </div>
    
    <div class="mb-4">
        <label class="text-muted small text-uppercase fw-bold d-block mb-2">Score Breakdown</label>
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
                <span class="small">Price Score</span>
                <span class="small fw-bold">@Model.PriceScore/100</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PriceScore%"></div>
            </div>
        </div>
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
                <span class="small">Technical Compliance</span>
                <span class="small fw-bold">@Model.TechnicalScore/100</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.TechnicalScore%"></div>
            </div>
        </div>
        <div class="mb-0">
            <div class="d-flex justify-content-between mb-1">
                <span class="small">Logistics & Delivery</span>
                <span class="small fw-bold">@Model.DeliveryScore/100</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: @Model.DeliveryScore%"></div>
            </div>
        </div>
    </div>

    @if (Model.Improvements != null && Model.Improvements.Any())
    {
        <div class="mt-3">
            <label class="text-muted small text-uppercase fw-bold d-block mb-2">📊 Improvement Suggestions</label>
            <div class="list-group list-group-flush border rounded-3 bg-light">
                @foreach (var tip in Model.Improvements)
                {
                    <div class="list-group-item bg-transparent py-2 small">
                        <i class="fas fa-lightbulb text-warning me-2"></i> @tip
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Score >= 85)
    {
        <div class="alert alert-success mt-3 py-2 small shadow-sm border-0">
            <i class="fas fa-trophy me-1"></i> 
            <strong>Strong proposal!</strong> You are well-positioned to win. Keep up the good performance!
        </div>
    }
</div>
