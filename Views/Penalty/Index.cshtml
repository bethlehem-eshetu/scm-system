@model List<SCM_System.Models.Entities.Penalty>

@{
    ViewData["Title"] = "My Penalties";
    Layout = "_DashboardLayout";
    int violationCount = ViewBag.ViolationCount ?? 0;
    bool canSendMessage = ViewBag.CanSendMessage ?? true;
    string userRole = ViewBag.UserRole ?? "User";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-gavel text-danger me-2"></i>My Penalties
        </h1>
        <a asp-action="Dashboard" asp-controller="@(userRole == "Supplier" ? "Supplier" : "Retailer")"
               class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Total Violations</h6>
                            <h3 class="mb-0 fw-bold">@violationCount</h3>
                            <small class="text-muted">Last 30 days</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="fas fa-clock fa-2x text-warning"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Active Penalties</h6>
                            <h3 class="mb-0 fw-bold">@Model.Count(p => p.IsActive && (p.ExpiresAt == null || p.ExpiresAt > DateTime.Now))</h3>
                            <small class="text-muted">Currently active</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="fas fa-check-circle fa-2x text-success"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Message Status</h6>
                            <h3 class="mb-0 fw-bold">@(canSendMessage ? "Active" : "Restricted")</h3>
                            <small class="text-muted">@(canSendMessage ? "You can send messages" : "Sending disabled")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Warning Banner if restricted -->
    @if (!canSendMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-ban me-2"></i>
            <strong>Account Restricted!</strong> Due to multiple violations, your ability to send messages has been restricted.
            @if (Model.Any(p => p.PenaltyType == "Account Suspension" && p.ExpiresAt > DateTime.Now))
            {
                var suspension = Model.First(p => p.PenaltyType == "Account Suspension" && p.ExpiresAt > DateTime.Now);
                <span>Your account is suspended until <strong>@suspension.ExpiresAt?.ToString("MMMM dd, yyyy")</strong>.</span>
            }
            else if (Model.Any(p => p.PenaltyType == "Message Restriction" && p.ExpiresAt > DateTime.Now))
            {
                var restriction = Model.First(p => p.PenaltyType == "Message Restriction" && p.ExpiresAt > DateTime.Now);
                <span>You can only send 1 message per day until <strong>@restriction.ExpiresAt?.ToString("MMMM dd, yyyy")</strong>.</span>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Penalty History -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-history me-2 text-primary"></i>Penalty History
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-shield-alt fa-4x text-success mb-3"></i>
                    <h4 class="text-muted">No Penalties</h4>
                    <p class="text-muted">You have no violations. Keep following platform guidelines!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Penalty Type</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Expires</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var penalty in Model)
                            {
                                bool isExpired = penalty.ExpiresAt.HasValue && penalty.ExpiresAt.Value < DateTime.Now;
                                bool isActive = penalty.IsActive && !isExpired;
                                
                                <tr class="@(isActive ? "table-warning" : "")">
                                    <td>
                                        @penalty.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (penalty.PenaltyType == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-exclamation-triangle me-1"></i>Warning
                                            </span>
                                        }
                                        else if (penalty.PenaltyType == "Message Restriction")
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-ban me-1"></i>Restricted
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle me-1"></i>Suspended
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (penalty.Reason.Length > 50)
                                        {
                                            @(penalty.Reason.Substring(0, 50) + "...")
                                        }
                                        else
                                        {
                                            @penalty.Reason
                                        }
                                    </td>
                                    <td>
                                        @if (!penalty.IsActive)
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Active</span>
                                        }
                                    </td>
                                    <td>
                                        @if (penalty.ExpiresAt.HasValue)
                                        {
                                            if (penalty.ExpiresAt.Value > DateTime.Now)
                                            {
                                                <span>@penalty.ExpiresAt.Value.ToString("MMM dd, yyyy")</span>
                                                <br>
                                                <small class="text-muted">(@((penalty.ExpiresAt.Value - DateTime.Now).Days) days left)</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Expired</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive && penalty.PenaltyType != "Account Suspension")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#appealModal"
                                                    data-penalty-id="@penalty.Id">
                                                <i class="fas fa-file-signature me-1"></i>Appeal
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Platform Rules Card -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2 text-info"></i>Platform Communication Rules
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-success">
                        <i class="fas fa-check-circle me-1"></i> Allowed:
                    </h6>
                    <ul class="text-success">
                        <li>Product inquiries and specifications</li>
                        <li>Order details and tracking information</li>
                        <li>Delivery coordination</li>
                        <li>Pricing and quantity negotiations</li>
                        <li>Quality discussions</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6 class="text-danger">
                        <i class="fas fa-times-circle me-1"></i> Not Allowed:
                    </h6>
                    <ul class="text-danger">
                        <li>Phone numbers (Ethiopian or international)</li>
                        <li>Email addresses</li>
                        <li>Telegram, WhatsApp, or other messaging apps</li>
                        <li>Social media handles (Facebook, Instagram, Twitter, etc.)</li>
                        <li>External website URLs</li>
                    </ul>
                </div>
            </div>
            <hr>
            <div class="alert alert-info mb-0">
                <i class="fas fa-gavel me-2"></i>
                <strong>Penalty Progression:</strong>
                1st-2nd violation: Warning → 3rd-4th violation: Message Restriction (1 per day) → 5+ violations: Account Suspension (30 days)
            </div>
        </div>
    </div>
</div>

<!-- Appeal Modal -->
<div class="modal fade" id="appealModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-file-signature me-2"></i>Appeal Penalty
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Appeal" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="penaltyId" id="appealPenaltyId" />
                    <div class="mb-3">
                        <label class="form-label">Reason for Appeal</label>
                        <textarea name="appealReason" class="form-control" rows="4"
                                  placeholder="Explain why you believe this penalty should be reviewed or removed..." required></textarea>
                        <small class="text-muted">Please provide a detailed explanation for your appeal.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Appeal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Set penalty ID in modal
    document.getElementById('appealModal')?.addEventListener('show.bs.modal', function(event) {
        var button = event.relatedTarget;
        var penaltyId = button.getAttribute('data-penalty-id');
        document.getElementById('appealPenaltyId').value = penaltyId;
        console.log('Appeal modal opened for penalty ID:', penaltyId); // Debug
    });
</script>
}