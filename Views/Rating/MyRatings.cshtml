@model List<SCM_System.Models.Entities.Rating>

@{
    ViewData["Title"] = "My Ratings";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-star me-2 text-accent-green"></i>My Experience Portfolio
            </h1>
            <p class="text-muted small mb-0 mt-1">Review your historical ratings, feedback contributions, and supplier performance evaluations.</p>
        </div>
        <div class="d-flex gap-3">
            <a asp-action="Dashboard" asp-controller="Retailer" class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
                <i class="fas fa-home me-2 text-accent-green"></i> Home
            </a>
        </div>
    </div>

    <!-- Ratings Content -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden" style="background-color: var(--card-bg);">
        <div class="card-header py-4 px-5 d-flex justify-content-between align-items-center border-0" style="background-color: var(--card-bg);">
            <h5 class="fw-bold mb-0 text-dark-green">Supplier Feedback History</h5>
            <span class="badge rounded-pill px-4 py-2 fw-bold border small" style="background-color: var(--table-header-bg); color: var(--table-text) !important;">@Model.Count() Reviews Published</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-faint-green rounded-5 p-5 border-dashed-custom mx-4">
                        <i class="fas fa-star fa-4x text-dark-green opacity-10 mb-4"></i>
                        <h5 class="fw-bold text-dark-green">No Ratings Published</h5>
                        <p class="text-muted small mb-0">You haven't shared your experience with any suppliers yet.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var rating in Model)
                    {
                        <div class="list-group-item border-0 p-5 hover-bg-faint transition-all border-bottom-faint">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-3 rounded-4" style="background-color: var(--table-header-bg); color: var(--table-text) !important;">
                                        <i class="fas fa-store fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark-green mb-1">@rating.Supplier?.CompanyName</h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-soft-success text-success extra-small fw-bold px-2 py-1">PO #@rating.PurchaseOrder?.PONumber</span>
                                            @if (!string.IsNullOrEmpty(rating.Category))
                                            {
                                                <span class="badge bg-faint-green text-dark-green extra-small fw-bold border px-2 py-1">@rating.Category</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-accent-dark-green fs-5 mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= rating.RatingValue)
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-muted opacity-25"></i>
                                            }
                                        }
                                    </div>
                                    <small class="text-muted extra-small fw-bold text-uppercase ls-1">@rating.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(rating.Comment))
                            {
                                <div class="rounded-4 p-4 mt-3 border-start border-4 border-success" style="background-color: var(--table-header-bg);">
                                    <p class="mb-0 text-dark-green italic fst-italic">"@rating.Comment"</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
            --accent-dark-green: #2E9C7A;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .text-accent-dark-green { color: var(--accent-dark-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .rounded-4 { border-radius: 16px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }
        .border-bottom-faint { border-bottom: 1px solid rgba(0,0,0,0.03) !important; }
        .border-bottom-faint:last-child { border-bottom: none !important; }

        .hover-bg-faint { transition: all 0.2s ease; }
        .hover-bg-faint:hover { background-color: rgba(242, 246, 246, 0.5); }
        
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }

        .bg-soft-success { background-color: rgba(46, 156, 122, 0.1); }
        .transition-all { transition: all 0.3s ease; }
    </style>
}