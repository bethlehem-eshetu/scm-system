@model SCM_System.Models.ViewModels.RatingViewModel

@{
    ViewData["Title"] = "Rate Your Experience";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white p-4 border-bottom-0">
                    <h2 class="fw-bold mb-0 text-dark-green" style="color: #0B3B2F;">
                        <i class="fas fa-star text-warning me-2"></i>Rate Your Experience
                    </h2>
                    <p class="text-muted mt-2">Order #@Model.OrderNumber | PO #@Model.PONumber</p>
                </div>

                @if (Model.IsRated)
                {
                    <div class="card-body p-5 text-center">
                        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                        <h4 class="fw-bold">Thank You for Your Feedback!</h4>
                        <p class="text-muted">You have already rated this delivery.</p>
                        <a asp-action="MyPurchaseOrders" asp-controller="Retailer" class="btn btn-primary rounded-pill px-4 mt-3">
                            Back to Orders
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="SubmitRating" asp-controller="Rating" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PurchaseOrderId" />
                        <input type="hidden" asp-for="SupplierId" />
                        <input type="hidden" asp-for="DeliveryAgentId" />

                        <div class="card-body p-4">
                            <!-- Delivery Agent Section -->
                            <div class="rating-section mb-5 p-4 rounded-4" style="background: #f0fdf4; border: 1px solid rgba(34, 197, 94, 0.1);">
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="delivery-icon rounded-circle p-3" style="background: rgba(34, 197, 94, 0.1);">
                                        <i class="fas fa-truck fs-3 text-success"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold mb-0">@Model.DeliveryAgentName</h4>
                                        <p class="text-muted small mb-0">Vehicle: @Model.VehiclePlate</p>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Timeliness</label>
                                        <div class="star-rating" data-target="DeliveryTimeliness">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.DeliveryTimeliness ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="DeliveryTimeliness" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Professionalism</label>
                                        <div class="star-rating" data-target="DeliveryProfessionalism">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.DeliveryProfessionalism ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="DeliveryProfessionalism" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Vehicle Condition</label>
                                        <div class="star-rating" data-target="VehicleCondition">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.VehicleCondition ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="VehicleCondition" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Communication</label>
                                        <div class="star-rating" data-target="Communication">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.Communication ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="Communication" />
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label class="form-label fw-bold">Delivery Comments (Optional)</label>
                                    <textarea asp-for="DeliveryComments" class="form-control bg-white border-0 rounded-3" rows="2" placeholder="Share your experience with the delivery agent..."></textarea>
                                </div>
                            </div>

                            <!-- Supplier Rating Section -->
                            <div class="rating-section mb-4 p-4 rounded-4" style="background: #f8fafc; border: 1px solid rgba(46, 156, 122, 0.1);">
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="supplier-icon rounded-circle p-3" style="background: rgba(46, 156, 122, 0.1);">
                                        <i class="fas fa-building fs-3" style="color: #2E9C7A;"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold mb-0">@Model.SupplierName</h4>
                                        <p class="text-muted small mb-0">Supplier Performance</p>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Product Quality</label>
                                        <div class="star-rating" data-target="ProductQuality">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.ProductQuality ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="ProductQuality" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Packaging Quality</label>
                                        <div class="star-rating" data-target="PackagingQuality">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.PackagingQuality ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="PackagingQuality" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Shipping Speed</label>
                                        <div class="star-rating" data-target="ShippingSpeed">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.ShippingSpeed ? "text-warning" : "text-muted")" data-value="@i" style="cursor: pointer; font-size: 24px; margin-right: 5px;"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="ShippingSpeed" />
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label class="form-label fw-bold">Supplier Comments (Optional)</label>
                                    <textarea asp-for="SupplierComments" class="form-control bg-white border-0 rounded-3" rows="2" placeholder="Share your experience with the supplier..."></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-4 text-center">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
                                <i class="fas fa-paper-plane me-2"></i>Submit Ratings
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .star-rating i {
        transition: all 0.2s;
    }
    .star-rating i:hover {
        transform: scale(1.2);
        color: #fbbf24 !important;
    }
    .dark-mode .rating-section {
        background: #1A1F1D !important;
        border-color: #2A3530 !important;
    }
    .dark-mode .bg-white {
        background-color: #1A1F1D !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.star-rating i').on('click', function() {
                var value = $(this).data('value');
                var $container = $(this).parent();
                var $input = $container.siblings('input[type="hidden"]');
                
                $input.val(value);
                
                $container.find('i').each(function() {
                    var starValue = $(this).data('value');
                    if (starValue <= value) {
                        $(this).addClass('text-warning').removeClass('text-muted');
                    } else {
                        $(this).addClass('text-muted').removeClass('text-warning');
                    }
                });
            });
        });
    </script>
}
