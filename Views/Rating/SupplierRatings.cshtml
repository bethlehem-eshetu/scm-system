@model List<SCM_System.Models.Entities.Rating>
@{
    ViewData["Title"] = "My Ratings";
    Layout = "_DashboardLayout";
    var summary = ViewBag.Summary as SCM_System.Services.SupplierRatingSummary;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-star text-warning me-2"></i>My Ratings & Reviews
        </h1>
        <a asp-action="Dashboard" asp-controller="Supplier" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    @if (summary != null && summary.TotalRatings > 0)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="mb-0">@summary.AverageRating.ToString("F1")</h3>
                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(summary.AverageRating))
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else if (i - 0.5 <= summary.AverageRating)
                                {
                                    <i class="fas fa-star-half-alt"></i>
                                }
                                else
                                {
                                    <i class="far fa-star"></i>
                                }
                            }
                        </div>
                        <small>@summary.TotalRatings ratings</small>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="card shadow-sm">
                    <div class="card-body">
                        @for (int i = 5; i >= 1; i--)
                        {
                            int count = i == 5 ? summary.FiveStarCount :
                                       i == 4 ? summary.FourStarCount :
                                       i == 3 ? summary.ThreeStarCount :
                                       i == 2 ? summary.TwoStarCount : summary.OneStarCount;
                            int percentage = summary.TotalRatings > 0 ? (count * 100 / summary.TotalRatings) : 0;
                            
                            <div class="d-flex align-items-center mb-2">
                                <div class="me-2" style="width: 60px;">@i star</div>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                </div>
                                <div class="ms-2" style="width: 40px;">@count</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="fas fa-comments me-2 text-primary"></i>Customer Reviews
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-star fa-4x text-muted mb-3 opacity-25"></i>
                    <h5 class="text-muted">No ratings yet</h5>
                    <p class="text-muted">Ratings will appear here once customers review your products.</p>
                </div>
            }
            else
            {
                @foreach (var rating in Model)
                {
                    <div class="border-bottom p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-warning mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rating.RatingValue)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star"></i>
                                        }
                                    }
                                </div>
                                <h6 class="mb-1">@rating.Retailer?.User?.FullName</h6>
                                <small class="text-muted">Order #@rating.Order?.OrderNumber</small>
                                @if (!string.IsNullOrEmpty(rating.Category))
                                {
                                    <span class="badge bg-secondary ms-2">@rating.Category</span>
                                }
                            </div>
                            <small class="text-muted">@rating.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </div>
                        @if (!string.IsNullOrEmpty(rating.Comment))
                        {
                            <p class="mb-0 mt-2">"@rating.Comment"</p>
                        }
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="fas fa-thumbs-up me-1"></i>@rating.HelpfulCount helpful
                                <i class="fas fa-thumbs-down ms-2 me-1"></i>@rating.NotHelpfulCount not helpful
                            </small>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>