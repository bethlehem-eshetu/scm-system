@using SCM_System.Models.Entities
@model IEnumerable<ReturnRequest>
@{
    ViewData["Title"] = "Customer Support & Returns";
    Layout = "_DashboardLayout";
    
    var activeRequests = Model.Count(r => r.Status != ReturnStatus.Completed && r.Status != ReturnStatus.Rejected);
    var totalRefunded = Model.Where(r => r.Status == ReturnStatus.Completed).Sum(r => r.RefundAmount);
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-headset text-primary me-2"></i>Support & Returns</h2>
            <p class="text-muted mb-0 small">Track your return requests, refunds, and resolution status.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="input-group shadow-sm" style="width: 300px;">
                <form asp-action="MyReturns" method="get" class="d-flex w-100">
                    <input type="text" name="searchTerm" class="form-control border-0 rounded-start-pill px-3" placeholder="Search Case # or Order..." value="@ViewBag.SearchTerm">
                    <button type="submit" class="btn btn-white bg-white border-0 rounded-end-pill"><i class="fas fa-search text-muted"></i></button>
                </form>
            </div>
            <a asp-controller="PurchaseOrder" asp-action="RetailerIndex" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-plus me-2"></i> New Return Request
            </a>
        </div>
    </div>

    <!-- Returns KPI Strip -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-soft-warning p-3 me-3">
                        <i class="fas fa-clock text-warning fa-lg"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted text-uppercase fw-bold d-block mb-0">Active Requests</label>
                        <h3 class="fw-bold text-dark mb-0">@activeRequests</h3>
                    </div>
                </div>
                <div class="extra-small text-muted border-top pt-2">Awaiting supplier investigation</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-soft-success p-3 me-3">
                        <i class="fas fa-check-circle text-success fa-lg"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted text-uppercase fw-bold d-block mb-0">Recovered Funds</label>
                        <h3 class="fw-bold text-dark mb-0">@totalRefunded.ToString("N0") <span class="smaller font-normal">ETB</span></h3>
                    </div>
                </div>
                <div class="extra-small text-muted border-top pt-2">Total refunds successfully processed</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-white bg-opacity-10 p-3 me-3">
                        <i class="fas fa-shield-alt text-white fa-lg"></i>
                    </div>
                    <div>
                        <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-0">Protection Status</label>
                        <h3 class="fw-bold text-white mb-0">Escrow Secured</h3>
                    </div>
                </div>
                <div class="extra-small text-white-50 border-top border-white border-opacity-10 pt-2">Funds held until resolution</div>
            </div>
        </div>
    </div>

    <!-- Smart Table Workspace -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-light">
            <h6 class="fw-bold mb-0">Return History & Tracking</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="smaller text-muted text-uppercase">
                        <th class="ps-4">Return ID</th>
                        <th>Associated Tools</th>
                        <th>Partner</th>
                        <th>Issue Category</th>
                        <th class="text-center">Est. Refund</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark font-mono">#@r.ReturnNumber</div>
                                <div class="extra-small text-muted">@r.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div class="extra-small text-dark fw-bold mb-0">PO: @(r.PurchaseOrder?.PONumber ?? "Direct")</div>
                                <div class="extra-small text-muted">Order: @r.Order?.OrderNumber</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark smaller">@r.Supplier?.CompanyName</div>
                                <div class="extra-small text-muted">Main Warehouse</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-2 smaller">@r.Reason</span>
                            </td>
                            <td class="text-center">
                                <div class="fw-bold text-dark">@r.RefundAmount.ToString("N2")</div>
                                <div class="extra-small text-muted font-normal">ETB</div>
                            </td>
                            <td class="text-center">
                                <span class="badge @GetStatusClass(r.Status) rounded-pill px-3 py-1 shadow-sm">@r.Status</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm fw-bold">
                                    Track Case <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="opacity-25 mb-3">
                                    <i class="fas fa-history fa-4x text-muted"></i>
                                </div>
                                <h5 class="fw-bold text-muted font-normal">No activity found</h5>
                                <p class="text-muted small">You haven't initiated any return requests in this period.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top border-light py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 border-0 @(i == ViewBag.CurrentPage ? "bg-primary text-white" : "text-dark bg-light")" 
                                   asp-action="MyReturns" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusClass(ReturnStatus status)
    {
        return status switch
        {
            ReturnStatus.Pending => "bg-warning text-dark",
            ReturnStatus.Approved => "bg-info text-white",
            ReturnStatus.Rejected => "bg-danger text-white",
            ReturnStatus.Processing => "bg-primary text-white",
            ReturnStatus.Completed => "bg-success text-white",
            _ => "bg-secondary text-white"
        };
    }
}

<style>
    .smaller { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .font-normal { font-weight: 400; }
    .font-mono { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; }
    .btn-white { background: white; }
    .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
    .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
</style>