@using SCM_System.Models.Entities
@model IEnumerable<ReturnRequest>
@{
    ViewData["Title"] = "Returns Resolution Center";
    Layout = "_DashboardLayout";
    
    var pendingCount = Model.Count(r => r.Status == ReturnStatus.Pending);
    var approvedToday = Model.Count(r => r.Status == ReturnStatus.Approved && r.ApprovedAt?.Date == DateTime.Today);
    var refundExposure = Model.Where(r => r.Status != ReturnStatus.Completed && r.Status != ReturnStatus.Rejected).Sum(r => r.RefundAmount);
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-undo-alt text-warning me-2"></i>Returns & Resolution Center</h2>
            <p class="text-muted mb-0 small">Investigate claims, authorize refunds, and manage reverse logistics.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="input-group shadow-sm" style="width: 300px;">
                <form asp-action="SupplierReturns" method="get" class="d-flex w-100">
                    <input type="text" name="searchTerm" class="form-control border-0 rounded-start-pill px-3" placeholder="Search Return # or Client..." value="@ViewBag.SearchTerm">
                    <button type="submit" class="btn btn-white bg-white border-0 rounded-end-pill"><i class="fas fa-search text-muted"></i></button>
                </form>
            </div>
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-file-export me-2"></i> Report
            </button>
        </div>
    </div>

    <!-- Returns KPI Strip -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-warning">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Pending Review</label>
                <h3 class="fw-bold text-dark mb-0">@pendingCount <span class="smaller font-normal">Cases</span></h3>
                <div class="extra-small text-warning mt-2 fw-bold"><i class="fas fa-clock me-1"></i> Immediate action required</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-success">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Approved Today</label>
                <h3 class="fw-bold text-dark mb-0">@approvedToday</h3>
                <span class="smaller text-muted">Authorized resolutions</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-bottom border-4 border-primary">
                <label class="smaller text-muted text-uppercase fw-bold d-block mb-1">Refund Exposure</label>
                <h3 class="fw-bold text-primary mb-0">@refundExposure.ToString("N0") <span class="smaller font-normal">ETB</span></h3>
                <span class="smaller text-muted">Projected settlement total</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white shadow">
                <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-1">SLA Health</label>
                <h3 class="fw-bold mb-0">94.8%</h3>
                <span class="smaller opacity-75">Target: 24h Response</span>
            </div>
        </div>
    </div>

    <!-- Smart Table Workspace -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-light d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">Resolution Pipeline</h6>
            <div class="btn-group btn-group-sm border rounded-pill overflow-hidden">
                <button class="btn btn-light px-3 active">All</button>
                <button class="btn btn-light px-3">Damage</button>
                <button class="btn btn-light px-3">Wrong Item</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="smaller text-muted text-uppercase">
                        <th class="ps-4">Case #</th>
                        <th>Retailer Client</th>
                        <th>Reference Docs</th>
                        <th>Claim Details</th>
                        <th class="text-center">Value</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Investigation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark mb-0">#@r.ReturnNumber</div>
                                <div class="extra-small text-muted">Created: @r.CreatedAt.ToString("MMM dd")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@r.Retailer?.BusinessName</div>
                                <div class="extra-small text-muted"><i class="fas fa-map-marker-alt me-1"></i> @r.Retailer?.City</div>
                            </td>
                            <td>
                                <div class="smaller text-dark fw-bold mb-0">PO: @(r.PurchaseOrder?.PONumber ?? "Direct")</div>
                                <div class="extra-small text-muted">Order: @r.Order?.OrderNumber</div>
                            </td>
                            <td>
                                <span class="badge bg-soft-info text-info rounded-pill px-2 smaller mb-1">@r.Reason</span>
                                <div class="extra-small text-muted text-truncate" style="max-width: 150px;">@r.Description</div>
                            </td>
                            <td class="text-center">
                                <div class="fw-bold text-dark">@r.RefundAmount.ToString("N2")</div>
                                <div class="extra-small text-muted">ETB</div>
                            </td>
                            <td class="text-center">
                                <span class="badge @GetStatusClass(r.Status) rounded-pill px-3 py-1">@r.Status</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm fw-bold">
                                    Analyze <i class="fas fa-chevron-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="opacity-25 mb-3">
                                    <i class="fas fa-inbox fa-4x"></i>
                                </div>
                                <h5 class="fw-bold text-muted">No Resolution Requests</h5>
                                <p class="text-muted small">All customer claims have been processed or none exist.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top border-light py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 border-0 @(i == ViewBag.CurrentPage ? "bg-primary text-white" : "text-dark bg-light")" 
                                   asp-action="SupplierReturns" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusClass(ReturnStatus status)
    {
        return status switch
        {
            ReturnStatus.Pending => "bg-warning text-dark",
            ReturnStatus.Approved => "bg-info text-white",
            ReturnStatus.Rejected => "bg-danger text-white",
            ReturnStatus.Processing => "bg-primary text-white",
            ReturnStatus.Completed => "bg-success text-white",
            _ => "bg-secondary text-white"
        };
    }
}

<style>
    .smaller { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .font-normal { font-weight: 400; }
    .btn-white { background: white; }
    .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
</style>