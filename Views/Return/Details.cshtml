@using SCM_System.Models.Entities
@model SCM_System.Models.Entities.ReturnRequest
@{
    ViewData["Title"] = $"Investigation: {Model.ReturnNumber}";
    Layout = "_DashboardLayout";
    var userRole = User.IsInRole("Supplier") ? "Supplier" : "Retailer";
    
    // SLA Calculation (24h internal policy)
    var timeRemaining = TimeSpan.FromHours(24) - (DateTime.Now - Model.CreatedAt);
    var isUrgent = timeRemaining.TotalHours < 6 && Model.Status == ReturnStatus.Pending;
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="@(userRole == "Supplier" ? "SupplierReturns" : "MyReturns")">Returns Hub</a></li>
            <li class="breadcrumb-item active">@Model.ReturnNumber</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-microscope text-primary me-2"></i>Returns Resolution Center
            </h2>
            <div class="d-flex align-items-center gap-3">
                <span class="badge @GetStatusClass(Model.Status) rounded-pill px-3 py-2">@Model.Status</span>
                <span class="text-muted small border-start ps-3">Submitted @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                @if (Model.Status == ReturnStatus.Pending)
                {
                    <span class="badge bg-soft-@(isUrgent ? "danger" : "info") text-@(isUrgent ? "danger" : "info") rounded-pill px-2">
                        <i class="fas fa-hourglass-half me-1"></i> SLA: @(timeRemaining.TotalHours > 0 ? $"{(int)timeRemaining.TotalHours}h remaining" : "SLA EXPIRED")
                    </span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-white border rounded-pill shadow-sm px-3"><i class="fas fa-print me-1"></i> Print Case</button>
            <button class="btn btn-white border rounded-pill shadow-sm px-3"><i class="fas fa-envelope me-1"></i> Message @(userRole == "Supplier" ? "Retailer" : "Supplier")</button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Investigation Details -->
        <div class="col-lg-8">
            <!-- Commercial Linkage Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-light">
                    <h6 class="fw-bold mb-0 text-uppercase smaller tracking-widest text-muted">Commercial References</h6>
                </div>
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-4 border-end border-light p-4">
                            <label class="extra-small text-muted text-uppercase fw-bold d-block mb-1">Order Relationship</label>
                            <div class="fw-bold mb-1">@Model.Order?.OrderNumber</div>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-link p-0 extra-small fw-bold text-primary">View Commercial Order</a>
                        </div>
                        <div class="col-md-4 border-end border-light p-4">
                            <label class="extra-small text-muted text-uppercase fw-bold d-block mb-1">Execution Document</label>
                            <div class="fw-bold mb-1">@(Model.PurchaseOrder?.PONumber ?? "Direct Marketplace")</div>
                            @if(Model.PurchaseOrder != null) {
                                <a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@Model.PurchaseOrderId" class="btn btn-link p-0 extra-small fw-bold text-primary">View Fulfillment Details</a>
                            }
                        </div>
                        <div class="col-md-4 p-4">
                            <label class="extra-small text-muted text-uppercase fw-bold d-block mb-1">Trading Entities</label>
                            <div class="extra-small mb-1"><span class="text-muted">Retailer:</span> <span class="fw-bold">@Model.Retailer?.BusinessName</span></div>
                            <div class="extra-small"><span class="text-muted">Supplier:</span> <span class="fw-bold">@Model.Supplier?.CompanyName</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Evidence & Reason Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-light">
                    <h6 class="fw-bold mb-0 text-uppercase smaller tracking-widest text-muted">Evidence Center</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <h6 class="fw-bold mb-2">Reported Reason: <span class="text-primary">@Model.Reason</span></h6>
                            <div class="p-3 bg-light rounded-3 italic text-muted mb-3" style="min-height: 80px;">
                                "@(string.IsNullOrEmpty(Model.Description) ? "No additional description provided." : Model.Description)"
                            </div>
                            
                            <div class="row g-2">
                                <div class="col-auto">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill smaller">
                                        <i class="fas fa-tag me-1"></i> @Model.Reason
                                    </span>
                                </div>
                                <div class="col-auto">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill smaller">
                                        <i class="fas fa-boxes me-1"></i> Full Quantity Return
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="extra-small text-muted text-uppercase fw-bold d-block mb-2">Photo Evidence</label>
                            @if (!string.IsNullOrEmpty(Model.Images))
                            {
                                <div class="position-relative group overflow-hidden rounded-3 border">
                                    <img src="@Model.Images" class="img-fluid transition-transform" style="width: 100%; height: 180px; object-fit: cover;" />
                                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center opacity-0 group-hover-opacity-100 transition-opacity">
                                        <a href="@Model.Images" target="_blank" class="btn btn-sm btn-light rounded-pill px-3 shadow">
                                            <i class="fas fa-search-plus me-1"></i> Inspect
                                        </a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="bg-light border rounded-3 d-flex flex-column align-items-center justify-content-center text-muted p-4" style="height: 180px;">
                                    <i class="fas fa-camera fa-2x mb-2 opacity-25"></i>
                                    <span class="smaller">No images uploaded</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Decision Audit Trail -->
            @if (Model.Status == ReturnStatus.Rejected || Model.Status == ReturnStatus.Approved || Model.Status == ReturnStatus.Completed)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 @(Model.Status == ReturnStatus.Rejected ? "border-start border-4 border-danger" : "border-start border-4 border-success")">
                    <div class="card-header bg-white py-3 border-light">
                        <h6 class="fw-bold mb-0 text-uppercase smaller tracking-widest text-muted">Decision Audit Trail</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row align-items-start">
                            <div class="col-auto">
                                <div class="rounded-circle p-3 @(Model.Status == ReturnStatus.Rejected ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success")">
                                    <i class="fas @(Model.Status == ReturnStatus.Rejected ? "fa-times-circle" : "fa-check-circle") fa-2x"></i>
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold mb-1">Supplier Decision: @Model.Status</h6>
                                    <span class="smaller text-muted">@(Model.ApprovedAt?.ToString("MMM dd, yyyy") ?? "Decision Recorded")</span>
                                </div>
                                <p class="text-muted mb-3 italic">
                                    "@(Model.Status == ReturnStatus.Rejected ? Model.RejectionReason : Model.AdminNotes ?? "Request has been approved based on submitted evidence.")"
                                </p>
                                <div class="extra-small text-muted font-normal border-top pt-2">
                                    <i class="fas fa-user-shield me-1"></i> Authorized by @Model.Supplier?.CompanyName (Representative)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Action Panel for Role-Based Controls -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-light">
                    <h6 class="fw-bold mb-0 text-uppercase smaller tracking-widest text-muted">Resolution Actions</h6>
                </div>
                <div class="card-body p-4">
                    @if (userRole == "Supplier" && Model.Status == ReturnStatus.Pending)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <form asp-action="Approve" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <label class="smaller text-muted fw-bold mb-2">Approval Note (To Client)</label>
                                    <textarea name="adminNotes" class="form-control mb-3" rows="3" placeholder="Explain the next steps or approval criteria..."></textarea>
                                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm">
                                        Authorize Return & Refund
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <label class="smaller text-muted fw-bold mb-2">Rejection Justification *</label>
                                    <textarea name="rejectionReason" class="form-control mb-3 border-danger" rows="3" placeholder="Must provide a valid reason for rejection..." required></textarea>
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">
                                        Decline Resolution Request
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else if (userRole == "Retailer" && Model.Status == ReturnStatus.Approved && !Model.ItemsShippedAt.HasValue)
                    {
                        <div class="alert bg-soft-primary text-primary border-primary border-opacity-25 rounded-4 p-4">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="fw-bold mb-1">Next Step: Shipping Instructions</h6>
                                    <p class="smaller mb-0 opacity-75">Your return is approved. Please print the manifest and drop items at the nearest hub. Enter tracking below to continue.</p>
                                </div>
                                <div class="col-md-5">
                                    <form asp-action="MarkAsShipped" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="text" name="trackingNumber" class="form-control rounded-pill form-control-sm" placeholder="Tracking #" required />
                                        <button type="submit" class="btn btn-primary rounded-pill btn-sm px-4 fw-bold">Submit</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else if (userRole == "Supplier" && Model.Status == ReturnStatus.Processing && !Model.CompletedAt.HasValue)
                    {
                        <div class="text-center py-3">
                            <h6 class="fw-bold">Items Reported Shipped</h6>
                            <p class="text-muted smaller mb-4">Once you receive the items at your warehouse, authorize the refund release.</p>
                            <form asp-action="ProcessRefund" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow">
                                    <i class="fas fa-donate me-2"></i> Finalize & Release Funds
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted border border-dashed rounded-4">
                            <i class="fas fa-lock fa-2x mb-2 opacity-25"></i>
                            <p class="smaller font-normal mb-0">No active manual actions available for this case state.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Financials & Timeline -->
        <div class="col-lg-4">
            <!-- Finance Panel -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-dark text-white shadow-lg overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fas fa-money-check-alt fa-4x rotate-12"></i>
                    </div>
                    <label class="smaller text-white-50 text-uppercase fw-bold d-block mb-1">Projected Refund</label>
                    <h2 class="fw-bold mb-4">@Model.RefundAmount.ToString("N2") <span class="smaller font-normal">ETB</span></h2>
                    
                    <div class="border-top border-white border-opacity-10 pt-3 mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="smaller text-white-50">Settlement Method</span>
                            <span class="smaller fw-bold text-success">@Model.RefundMethod</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="smaller text-white-50">Chapa Verification</span>
                            <span class="smaller fw-bold">@(Model.Status == ReturnStatus.Completed ? "Verified" : "Pending")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Activity Log Component -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-light">
                    <h6 class="fw-bold mb-0 text-uppercase smaller tracking-widest text-muted">Investigation Timeline</h6>
                </div>
                <div class="card-body p-4">
                    <!-- Standardized Activity Timeline Component -->
                    @await Html.PartialAsync("_ActivityTimeline", Model.Order?.StatusHistory?.ToList() ?? new List<OrderStatusHistory>())
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(ReturnStatus status)
    {
        return status switch
        {
            ReturnStatus.Pending => "bg-warning text-dark shadow-sm",
            ReturnStatus.Approved => "bg-info text-white shadow-sm",
            ReturnStatus.Rejected => "bg-danger text-white shadow-sm",
            ReturnStatus.Processing => "bg-primary text-white shadow-sm",
            ReturnStatus.Completed => "bg-success text-white shadow-sm",
            _ => "bg-secondary text-white shadow-sm"
        };
    }
}

<style>
    .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .font-normal { font-weight: 400; }
    .tracking-widest { letter-spacing: 1.5px; }
    .bg-white { background: white !important; }
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.1); }
    .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
    .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
    .italic { font-style: italic; }
    .transition-transform { transition: transform 0.3s ease; }
    .group:hover .transition-transform { transform: scale(1.05); }
    .rotate-12 { transform: rotate(12deg); }
    .border-dashed { border-style: dashed !important; }
</style>