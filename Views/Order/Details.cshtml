@using SCM_System.Models.Entities
@using SCM_System.Models.Constants
@model Order
@{
    ViewData["Title"] = "Fulfillment Command Center";
    Layout = "_DashboardLayout";
    bool isRetailer = User.IsInRole("Retailer");
    bool isSupplier = User.IsInRole("Supplier") || User.IsInRole("WarehouseManager");
    bool isWarehouseRole = User.IsInRole("WarehouseManager");

    // Primary PO context for fulfillment tracking
    var po = ViewBag.PrimaryPO as PurchaseOrder;
    
    // Status Flow Logic for Timeline (Must match POStatus.cs)
    var statuses = new[] { "Pending", "Issued", "Accepted", "Picking", "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed" };
    string currentStatus = po?.Status ?? Model.OrderStatus;
    int currentIdx = Array.IndexOf(statuses, currentStatus);
    if (currentIdx == -1) currentIdx = 0;

    bool isTerminal = new[] { "Rejected", "Expired", "Completed" }.Contains(currentStatus);

    // ✅ FIXED: show panel whenever warehouse missing and PO is still active
    bool showAssignPanel = (isSupplier || isWarehouseRole) && 
                          po != null && 
                          !po.WarehouseId.HasValue && 
                          !new[] { "Rejected", "Completed", "Delivered", "Expired" }.Contains(po.Status);

    bool isDelivered = currentStatus == "Delivered" || currentStatus == "Completed";

    var requiredQty = Model.OrderItems?.Sum(x => x.Quantity) ?? 0;
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb extra-small fw-bold text-uppercase ls-1 mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-dark-green opacity-50 text-decoration-none">Operational Hub</a></li>
                    <li class="breadcrumb-item active text-dark-green" aria-current="page">Execution #@Model.OrderNumber</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark-green mb-1"><i class="fas fa-file-contract text-accent-green me-2"></i>Fulfillment Command Center</h1>
            <p class="text-muted small mb-0 mt-1">Real-time oversight of the order execution lifecycle and logistics chain.</p>
        </div>
        <div class="d-flex gap-3">
            <button onclick="window.print()" class="btn btn-white rounded-pill px-4 py-2 shadow-sm fw-bold text-dark-green border">
                <i class="fas fa-print me-2"></i> Generate Manifest
            </button>
            @if (isSupplier)
            {
                <a asp-controller="Message" asp-action="Conversation" asp-route-id="@(Model.Retailer?.UserId ?? 0)" class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
                    <i class="fas fa-comment-dots me-2 text-accent-green"></i> Stream to Retailer
                </a>
            }
        </div>
    </div>

    <!-- Executive Intelligence Summary -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden mb-5 bg-white">
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-xl-3 bg-dark-green p-5 text-center d-flex flex-column justify-content-center">
                    <span class="text-white-50 extra-small fw-bold text-uppercase ls-1 d-block mb-3">Deployment Status</span>
                    <h2 class="fw-bold text-white mb-3">#@Model.OrderNumber</h2>
                    <div class="status-pill-nexus @GetBadgeClass(currentStatus) rounded-pill py-2 shadow-lg">@currentStatus</div>
                </div>
                <div class="col-xl-9 p-5">
                    <div class="row g-4">
                        <div class="col-md-3 border-end border-faint">
                            @{
                                var topNet = Model.Subtotal > 0 ? Model.Subtotal : Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                                var topVat = Model.VAT > 0 ? Model.VAT : Math.Round(topNet * 0.15m, 2);
                                var topTotal = Model.TotalAmount > (topNet + topVat - 1) ? Model.TotalAmount : (topNet + topVat);
                            }
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Contract Value</label>
                            <h3 class="fw-bold text-dark-green mb-1">@topTotal.ToString("N2") <small class="extra-small opacity-50">ETB</small></h3>
                            <span class="extra-small text-success fw-bold"><i class="fas fa-shield-check me-1"></i>Secure Escrow</span>
                        </div>
                        <div class="col-md-3 border-end border-faint">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Issue Timestamp</label>
                            <h4 class="fw-bold text-dark-green mb-1">@Model.CreatedAt.ToString("MMM dd, yyyy")</h4>
                            <span class="extra-small text-muted fw-bold">ID: #SYS-@Model.Id</span>
                        </div>
                        <div class="col-md-3 border-end border-faint">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Execution Hub</label>
                            @if (po?.WarehouseId.HasValue == true)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="bg-faint-green text-dark-green rounded-circle p-2 me-3">
                                        <i class="fas fa-warehouse small"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark-green mb-0 text-truncate" style="max-width: 140px;">@(po?.Warehouse?.Name ?? "PENDING")</h6>
                                        <span class="extra-small text-muted fw-bold">@po.Warehouse?.City Hub</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <h4 class="fw-bold text-warning mb-1">UNASSIGNED</h4>
                                <span class="extra-small text-danger fw-bold animate-pulse"><i class="fas fa-exclamation-triangle me-1"></i> HUB ALLOCATION REQ</span>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2">Target Delivery</label>
                            <h4 class="fw-bold text-danger mb-1">@(Model.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "TBD")</h4>
                            <span class="extra-small text-muted fw-bold">SLA Compliance: 100%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Multi-Stage Fulfillment Pipeline -->
    <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden">
        <div class="card-body p-5">
            <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-5">Workflow Lifecycle Progression</h6>
            <div class="nexus-stepper position-relative">
                <div class="stepper-track bg-faint-green rounded-pill"></div>
                <div class="stepper-progress bg-dark-green rounded-pill shadow-premium" style="width: @(currentIdx * (100.0 / (statuses.Length - 1)))%;"></div>
                
                <div class="d-flex justify-content-between position-relative" style="z-index: 2; margin-top: -18px;">
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isActive = i <= currentIdx;
                        var isCurrent = i == currentIdx;
                        var icon = i switch { 0 => "fa-clock", 1 => "fa-file-invoice", 2 => "fa-check", 3 => "fa-dolly", 4 => "fa-clipboard-check", 5 => "fa-box-open", 6 => "fa-box", 7 => "fa-shipping-fast", 8 => "fa-truck-moving", 9 => "fa-house-user", _ => "fa-flag-checkered" };
                        
                        <div class="step-node-nexus d-flex flex-column align-items-center" style="width: 40px;">
                            <div class="node-circle rounded-circle d-flex align-items-center justify-content-center shadow-sm @(isActive ? "bg-dark-green text-accent-green" : "bg-white text-muted border border-faint")" 
                                 style="width: 36px; height: 36px; transition: all 0.5s ease; @(isCurrent ? "transform: scale(1.3); box-shadow: 0 0 15px rgba(212, 240, 109, 0.4);" : "")">
                                <i class="fas @icon extra-small"></i>
                            </div>
                            <div class="node-label extra-small fw-bold mt-3 text-center text-truncate @(isActive ? "text-dark-green" : "text-muted opacity-50")" 
                                 style="width: 80px; @(isCurrent ? "transform: scale(1.1);" : "")">@statuses[i]</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <!-- Main Data Workspace -->
        <div class="col-lg-8">
            <!-- Order Manifest (Deep Dark Green Card) -->
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden mb-5 bg-dark-green text-white">
                <div class="card-header bg-white bg-opacity-10 border-0 py-4 px-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-white"><i class="fas fa-boxes text-accent-green me-2"></i>Strategic Manifest</h5>
                        <span class="badge bg-accent-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small">@Model.OrderItems.Count LINE ITEMS</span>
                    </div>
                </div>
                <div class="card-body p-5">
                    <div class="manifest-nexus">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="manifest-row d-flex justify-content-between align-items-center mb-4 pb-4 border-bottom border-white border-opacity-10">
                                <div class="d-flex align-items-center">
                                    <div class="bg-white bg-opacity-10 rounded-4 p-3 me-4 text-accent-green shadow-sm">
                                        <i class="fas fa-box fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold fs-5 text-white mb-1">@item.ProductName</div>
                                        <div class="extra-small text-white-50 fw-bold tracking-widest uppercase">SKU: @(item.Product?.SKU ?? "GENERIC-ASSET")</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="extra-small text-white-50 fw-bold mb-1">@item.Quantity UNITS × @item.UnitPrice.ToString("N2")</div>
                                    <div class="fw-bold text-accent-green fs-4">@((item.Quantity * item.UnitPrice).ToString("N2")) <small class="extra-small">ETB</small></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-5 p-4 bg-black bg-opacity-20 rounded-5 border border-white border-opacity-10 shadow-inner">
                        @{
                            var netSubtotal = Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                            var vatTotal = Math.Round(netSubtotal * 0.15m, 2);
                            var grandTotal = netSubtotal + vatTotal;
                        }
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50 fw-bold extra-small">NET ASSET VALUE</span>
                            <span class="fw-bold text-white">@netSubtotal.ToString("N2") ETB</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 pb-4 border-bottom border-white border-opacity-10">
                            <span class="text-white-50 fw-bold extra-small">VAT (15%)</span>
                            <span class="text-accent-green fw-bold">@vatTotal.ToString("N2") ETB</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0 text-white ls-1">FINAL CONTRACT TOTAL</h5>
                            <div class="text-end">
                                <h3 class="fw-bold mb-0 text-accent-green">@grandTotal.ToString("N2") <small class="extra-small opacity-50">ETB</small></h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Trail -->
            <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden">
                <div class="card-header bg-faint-green py-4 px-5 border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark-green mb-0">Operational Lifecycle Audit</h6>
                    <span class="badge bg-white text-dark-green rounded-pill px-3 py-1 extra-small fw-bold border">Full Traceability</span>
                </div>
                <div class="card-body p-5">
                    @await Html.PartialAsync("_ActivityTimeline", Model.StatusHistory?.OrderByDescending(h => h.ChangedAt).ToList() ?? new List<OrderStatusHistory>())
                </div>
            </div>
        </div>

        <!-- Strategic Intelligence Column -->
        <div class="col-lg-4">
            <!-- Dynamic Action Console -->
            @if (isRetailer && !new[] { "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed", "Cancelled" }.Contains(currentStatus))
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-danger">
                    <h5 class="fw-bold text-dark-green mb-2">Strategic Interruption</h5>
                    <p class="text-muted small mb-4 fw-bold">Administrative termination of this deployment.</p>
                    
                    <button class="btn btn-soft-danger w-100 rounded-pill fw-bold py-3 shadow-sm cancel-order-btn" data-id="@Model.Id" data-total="@grandTotal.ToString("N2") ETB">
                        <i class="fas fa-ban me-2"></i> ABORT FULFILLMENT
                    </button>
                    <p class="extra-small text-muted mt-3 fw-bold text-center">Safety Protocol: Only available pre-picking phase.</p>
                </div>
            }
            @if (showAssignPanel)
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-dark-green">
                    <h5 class="fw-bold text-dark-green mb-2">Fulfillment Activation</h5>
                    <p class="text-muted small mb-4 fw-bold">Commit resources to the execution hub.</p>
                    
                    <form asp-controller="Order" asp-action="AcceptPO" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="poId" value="@po.Id" />
                        
                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-3">Primary Logistics Hub</label>
                        <select name="warehouseId" class="form-select border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green mb-4 shadow-sm" required>
                            <option value="-1">-- AUTO-ALLOCATE LOAD --</option>
                            @if (ViewBag.Warehouses != null)
                            {
                                foreach (dynamic w in ViewBag.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name Hub (@w.City)</option>
                                }
                            }
                        </select>
                        
                        <button type="submit" class="btn btn-dark-green w-100 rounded-pill fw-bold py-3 shadow-premium mb-3">
                            <i class="fas fa-bolt me-2 text-accent-green"></i> ACTIVATE FULFILLMENT
                        </button>
                    </form>

                    <form asp-controller="Order" asp-action="StatusAction" method="post" onsubmit="return confirm('Abort this deployment?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="actionType" value="Reject" />
                        <input type="hidden" name="rejectionReason" value="Rejected by fulfillment manager" />
                        <button type="submit" class="btn btn-white w-100 rounded-pill fw-bold py-2 text-danger border border-danger border-opacity-10 small">
                            Reject Contract
                        </button>
                    </form>
                </div>
            }

            <!-- Intelligence Cards -->
            <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white">
                <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-4">Strategic Partners</h6>
                <div class="d-flex align-items-center mb-4 p-3 bg-faint-green rounded-4">
                    <div class="avatar shadow-sm rounded-circle bg-dark-green text-accent-green d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="fas fa-store extra-small"></i>
                    </div>
                    <div class="overflow-hidden">
                        <label class="extra-small text-muted d-block fw-bold opacity-75">RETAIL ENTITY</label>
                        <span class="fw-bold text-dark-green text-truncate d-block">@Model.Retailer?.BusinessName</span>
                    </div>
                </div>
                <div class="d-flex align-items-center p-3 bg-dark-green text-white rounded-4 shadow-premium">
                    <div class="avatar shadow-sm rounded-circle bg-white bg-opacity-20 text-accent-green d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="fas fa-industry extra-small"></i>
                    </div>
                    <div class="overflow-hidden">
                        <label class="extra-small text-white-50 d-block fw-bold opacity-75">SUPPLY HUB</label>
                        <span class="fw-bold text-white text-truncate d-block">@Model.Supplier?.CompanyName</span>
                    </div>
                </div>
            </div>

            <!-- Logistics Intel -->
            <div class="card border-0 shadow-premium rounded-5 p-5 bg-white">
                <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-4">Logistics Stream</h6>
                <div class="mb-4 d-flex align-items-center p-3 bg-faint-green rounded-4">
                    <div class="bg-white rounded-circle p-2 me-3 text-dark-green shadow-sm"><i class="fas fa-map-marker-alt extra-small"></i></div>
                    <div>
                        <label class="extra-small text-muted d-block fw-bold opacity-75">DESTINATION</label>
                        <span class="extra-small fw-bold text-dark-green">@Model.DeliveryCity, Ethiopia</span>
                    </div>
                </div>
                <div class="mb-4 d-flex align-items-center p-3 bg-faint-green rounded-4">
                    <div class="bg-white rounded-circle p-2 me-3 text-dark-green shadow-sm"><i class="fas fa-user-astronaut extra-small"></i></div>
                    <div>
                        <label class="extra-small text-muted d-block fw-bold opacity-75">CARRIER AGENT</label>
                        <span class="extra-small fw-bold text-dark-green">@(po?.DeliveryAgent?.User?.FullName ?? "PENDING ALLOCATION")</span>
                    </div>
                </div>
                
                @if (isRetailer && currentStatus == "In Transit")
                {
                    <div class="mt-4 pt-4 border-top border-faint text-center">
                        <h6 class="extra-small fw-bold text-dark-green mb-3 uppercase tracking-widest"><i class="fas fa-qrcode me-2 text-accent-green"></i>Verification Identity</h6>
                        <div id="retailer-qrcode" class="d-inline-block bg-white p-3 rounded-5 shadow-premium border border-faint mb-4"></div>
                        <p class="extra-small text-muted fw-bold mb-0">SCAN TO VERIFY POSSESSION</p>
                    </div>
                }

                @if (isDelivered)
                {
                    <div class="mt-4 pt-4 border-top border-faint">
                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 mb-4">Verification Artifacts</label>
                        
                        @if (!string.IsNullOrEmpty(po.SignaturePath))
                        {
                            <div class="mb-4">
                                <span class="extra-small text-muted fw-bold d-block mb-2">AUTHENTICATED SIGNATURE</span>
                                <div class="border rounded-4 p-3 bg-faint-green shadow-inner">
                                    <img src="@po.SignaturePath" class="img-fluid" style="max-height: 80px;" alt="Signature">
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(po.ProofOfDelivery))
                        {
                            <div class="mb-4">
                                <span class="extra-small text-muted fw-bold d-block mb-2">POSSESSION PROOF PHOTO</span>
                                <a href="@po.ProofOfDelivery" target="_blank" class="d-block rounded-4 overflow-hidden shadow-premium">
                                    <img src="@po.ProofOfDelivery" class="img-fluid" style="width: 100%;" alt="Photo Proof">
                                </a>
                            </div>
                        }
                        
                        <div class="d-flex align-items-center p-2 bg-soft-success text-success rounded-pill extra-small fw-bold mb-2">
                            <i class="fas fa-shield-check mx-2"></i> IDENTITY QR VERIFIED
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch {
            "Pending" or "Issued" => "bg-soft-info text-info",
            "Accepted" => "bg-soft-primary text-primary",
            "Delivered" => "bg-soft-success text-success",
            "Completed" => "bg-accent-green text-dark-green fw-bold",
            "Rejected" or "Expired" or "Cancelled" => "bg-soft-danger text-danger",
            _ => "bg-soft-warning text-warning"
        };
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .status-pill-nexus {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-primary { background-color: rgba(26, 61, 49, 0.05); }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }

        .nexus-stepper .stepper-track { height: 6px; width: 100%; position: absolute; top: 0; }
        .nexus-stepper .stepper-progress { height: 6px; position: absolute; top: 0; transition: width 1s ease; }

        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; transform: translateY(-2px); }
        .btn-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.1); }
        .btn-soft-danger:hover { background-color: #dc3545; color: white; }

        .animate-pulse { animation: pulse 2s infinite; }
        @@keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }

        .shadow-inner { box-shadow: inset 0 2px 10px rgba(0,0,0,0.2); }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const qrContainer = document.getElementById('retailer-qrcode');
            if (qrContainer) {
                new QRCode(qrContainer, {
                    text: "ORDER-@Model.OrderNumber",
                    width: 140,
                    height: 140,
                    colorDark : "#1a3d31",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.H
                });
            }
        });
    </script>
}
