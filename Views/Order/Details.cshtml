@using SCM_System.Models.Entities
@using SCM_System.Models.Constants
@model Order
@{
    ViewData["Title"] = "Fulfillment Command Center";
    Layout = "_DashboardLayout";
    bool isRetailer = User.IsInRole("Retailer");
    bool isSupplier = User.IsInRole("Supplier") || User.IsInRole("WarehouseManager");
    bool isWarehouseRole = User.IsInRole("WarehouseManager");

    // Primary PO context for fulfillment tracking
    var po = ViewBag.PrimaryPO as PurchaseOrder;
    
    // Status Flow Logic for Timeline (Must match POStatus.cs)
    var statuses = new[] { "Pending", "Issued", "Accepted", "Picking", "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed" };
    string currentStatus = po?.Status ?? Model.OrderStatus;
    int currentIdx = Array.IndexOf(statuses, currentStatus);
    if (currentIdx == -1) currentIdx = 0;

    bool isTerminal = new[] { "Cancelled", "Rejected", "Expired", "Completed" }.Contains(currentStatus);

    // ✅ FIXED: show panel whenever warehouse missing and PO is still active
    bool showAssignPanel = (isSupplier || isWarehouseRole) && 
                          po != null && 
                          !po.WarehouseId.HasValue && 
                          !new[] { "Cancelled", "Rejected", "Completed", "Delivered", "Expired" }.Contains(po.Status);

    bool isDelivered = currentStatus == "Delivered" || currentStatus == "Completed";

    var requiredQty = Model.OrderItems?.Sum(x => x.Quantity) ?? 0;
}

<div class="container-fluid py-4 min-vh-100 bg-light">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Orders</a></li>
                    <li class="breadcrumb-item active">#@Model.OrderNumber</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-file-contract text-primary me-2"></i>Fulfillment Command Center</h2>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm bg-white fw-bold">
                <i class="fas fa-print me-2"></i> Print Order
            </button>
            @if (isSupplier)
            {
                <a asp-controller="Message" asp-action="SendMessage" asp-route-receiverId="@(Model.Retailer?.UserId ?? 0)" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                    <i class="fas fa-comment-dots me-2"></i> Message Retailer
                </a>
            }
            else if (isRetailer)
            {
                <a asp-controller="Message" asp-action="SendMessage" asp-route-receiverId="@(Model.Supplier?.UserId ?? 0)" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                    <i class="fas fa-comment-dots me-2"></i> Message Supplier
                </a>
                @if (Model.OrderStatus == "Delivered" || Model.OrderStatus == "Completed")
                {
                    <a asp-controller="Return" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i> Raise Claim
                    </a>
                }
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center">
            <i class="fas fa-check-circle me-3 fs-4"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center">
            <i class="fas fa-exclamation-circle me-3 fs-4"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Executive Summary Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4 border-top border-4 border-primary">
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-md-3 bg-glass border-end p-4 text-center">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-2">Order Identification</span>
                    <h4 class="fw-bold text-primary mb-1">#@Model.OrderNumber</h4>
                    <span class="badge @GetBadgeClass(currentStatus) rounded-pill px-3 py-2 shadow-sm">@currentStatus</span>
                </div>
                <div class="col-md-9 p-4">
                    <div class="row g-4 text-center text-md-start">
                        <div class="col-md-3 border-end">
                            @{
                                // Ensure top card matches manifest footer exactly
                                var topNet = Model.Subtotal > 0 ? Model.Subtotal : Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                                var topVat = Model.VAT > 0 ? Model.VAT : Math.Round(topNet * 0.15m, 2);
                                var topTotal = Model.TotalAmount > (topNet + topVat - 1) ? Model.TotalAmount : (topNet + topVat);
                            }
                            <label class="smaller text-muted d-block mb-1">CONTRACT VALUE</label>
                            <h5 class="fw-bold text-dark mb-0">@topTotal.ToString("N2") <small class="text-muted">ETB</small></h5>
                            <span class="smaller text-success">Total Payable (inc. VAT)</span>
                        </div>
                        <div class="col-md-3 border-end">
                            <label class="smaller text-muted d-block mb-1">ISSUE DATE</label>
                            <h5 class="fw-bold text-dark mb-0">@Model.CreatedAt.ToString("MMM dd, yyyy")</h5>
                            <span class="smaller text-muted">Status: @Model.OrderStatus</span>
                        </div>
                        <div class="col-md-3 border-end">
                            <label class="smaller text-muted d-block mb-1">FULFILLMENT HUB</label>
                            @if (po?.WarehouseId.HasValue == true)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-success-subtle rounded-circle p-2 me-3">
                                        <i class="fas fa-warehouse text-success"></i>
                                    </div>
                                    <div>
                                        <p class="extra-small text-muted mb-0 text-uppercase fw-bold">Fulfillment Hub</p>
                                        <h6 class="fw-bold text-dark mb-0">@(po?.Warehouse?.Name ?? "PENDING ASSIGNMENT")</h6>
                                        <span class="extra-small text-muted">@po.Warehouse?.City, @po.Warehouse?.Region</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <h5 class="fw-bold text-warning mb-0">Unassigned</h5>
                                @if (isSupplier)
                                {
                                    <span class="smaller text-danger fw-bold blinking"><i class="fas fa-exclamation-triangle me-1"></i> Action Required</span>
                                }
                                else
                                {
                                    <span class="smaller text-muted">Awaiting Acceptance</span>
                                }
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="smaller text-muted d-block mb-1">ESTIMATED DELIVERY</label>
                            <h5 class="fw-bold text-danger mb-0">@(Model.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "TBD")</h5>
                            <span class="smaller text-muted">Ref: @Model.Id</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Fulfillment Stepper -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4 pt-5 pb-5">
            <div class="fulfillment-stepper shadow-sm rounded-pill p-2 bg-light mx-2 position-relative">
                <div class="stepper-progress bg-primary" style="width: @(currentIdx * 10)%; height: 8px; border-radius: 10px; position: absolute; top: 50%; margin-top: -4px; z-index: 1; left: 20px; transition: width 0.8s ease;"></div>
                <div class="d-flex justify-content-between position-relative px-2" style="z-index: 2;">
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isActive = i <= currentIdx;
                        var icon = i switch { 0 => "fa-clock", 1 => "fa-file-invoice", 2 => "fa-check", 3 => "fa-dolly", 4 => "fa-clipboard-check", 5 => "fa-box-open", 6 => "fa-box", 7 => "fa-shipping-fast", 8 => "fa-truck-moving", 9 => "fa-house-user", _ => "fa-flag-checkered" };
                        <div class="step-node text-center" style="width: 80px;">
                            <div class="mx-auto shadow-sm rounded-circle d-flex align-items-center justify-content-center @(isActive ? "bg-primary text-white border-2 border-primary" : "bg-white text-muted border-2 border-secondary")" style="width: 45px; height: 45px; font-size: 1.1rem; border-style: solid;">
                                <i class="fas @icon"></i>
                            </div>
                            <div class="step-label smaller fw-bold mt-2 d-none d-lg-block @(isActive ? "text-primary" : "text-muted opacity-75")" style="line-height:1.2">@statuses[i]</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Workspace -->
        <div class="col-lg-8">


            <!-- Items List (High-Visibility Dark Theme) -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4 bg-dark text-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 text-white"><i class="fas fa-boxes text-success me-2"></i>Order Manifest</h5>
                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-50 px-3">@Model.OrderItems.Count Line Items</span>
                </div>

                <div class="manifest-list px-2">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-white border-opacity-10">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 rounded-3 p-2 me-3">
                                    <i class="fas fa-box text-success"></i>
                                </div>
                                <div style="color: #ffffff;">
                                    <div class="fw-bold fs-6 mb-0">@item.ProductName</div>
                                    <div class="smaller opacity-50 text-uppercase tracking-wider" style="font-size: 0.65rem;">SKU: @(item.Product?.SKU ?? "GENERIC")</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="small opacity-75 mb-0">@item.Quantity x @item.UnitPrice.ToString("N2")</div>
                                <div class="fw-bold" style="color: #10b981; font-size: 1.1rem;">ETB @((item.Quantity * item.UnitPrice).ToString("N2"))</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-3 bg-black bg-opacity-40 rounded-4 p-4 border border-white border-opacity-10">
                    @{
                        var netSubtotal = Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                        var vatTotal = Math.Round(netSubtotal * 0.15m, 2);
                        var grandTotal = netSubtotal + vatTotal;
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color: rgba(255,255,255,0.6);" class="small">Net Value</span>
                        <span class="fw-bold">@netSubtotal.ToString("N2") ETB</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom border-white border-opacity-10">
                        <span style="color: rgba(255,255,255,0.6);" class="small">VAT (15%)</span>
                        <span class="text-info fw-bold">@vatTotal.ToString("N2") ETB</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-white">TOTAL PAYABLE</h5>
                        <div class="text-end">
                            <h4 class="fw-bold mb-0" style="color: #10b981;">@grandTotal.ToString("N2") <small class="fs-6 opacity-75">ETB</small></h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Workflow Activity Log -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Workflow Activity Log</h6>
                    <span class="extra-small text-muted">Lifecycle Audit Trail</span>
                </div>
                <div class="card-body p-4">
                    @await Html.PartialAsync("_ActivityTimeline", Model.StatusHistory?.OrderByDescending(h => h.ChangedAt).ToList() ?? new List<OrderStatusHistory>())
                </div>
            </div>
        </div>

        <!-- Role-Based Action Panel Sidebar -->
        <div class="col-lg-4">
            @if (showAssignPanel)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border border-primary border-opacity-25" style="border-width: 2px !important; border-color: #0d6efd !important;">
                    <h5 class="fw-bold text-dark mb-1">Actions</h5>
                    <p class="text-muted small mb-3">Process order fulfillment</p>
                    
                    <form asp-controller="Order" asp-action="AcceptPO" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="poId" value="@po.Id" />
                        
                        <label class="small text-dark fw-bold mb-2">Default Fulfillment Warehouse</label>
                        <select name="warehouseId" class="form-select bg-light border-0 py-2 mb-2" required>
                            <option value="-1">-- Let system auto-allocate --</option>
                            @if (ViewBag.Warehouses != null)
                            {
                                foreach (dynamic w in ViewBag.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            }
                        </select>
                        <p class="extra-small text-muted mb-4 mt-2" style="font-size: 0.70rem; line-height: 1.4;">System will prioritize this warehouse if selected, otherwise it splits automatically.</p>
                        
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm mb-3">
                            <i class="fas fa-check-circle me-1"></i> ACCEPT ORDER
                        </button>
                    </form>

                    <form asp-controller="Order" asp-action="StatusAction" method="post" onsubmit="return confirm('Are you sure you want to reject this order?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="actionType" value="Reject" />
                        <input type="hidden" name="rejectionReason" value="Rejected by fulfillment manager" />
                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold py-2 shadow-sm border-2">
                            <i class="fas fa-times-circle me-1"></i> REJECT ORDER
                        </button>
                    </form>
                </div>
            }

            <!-- Contracting Parties -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h6 class="fw-bold text-uppercase text-muted smaller mb-4">Contracting Parties</h6>
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar shadow-sm rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                        <i class="fas fa-store"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">RETAILER (SHIP TO)</label>
                        <span class="fw-bold text-dark">@Model.Retailer?.BusinessName</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-0">
                    <div class="avatar shadow-sm rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                        <i class="fas fa-industry"></i>
                    </div>
                    <div>
                        <label class="smaller text-muted d-block">SUPPLIER (BILL FROM)</label>
                        <span class="fw-bold text-dark">@Model.Supplier?.CompanyName</span>
                    </div>
                </div>
            </div>

            <!-- Warehouse Execution Diagnostics -->
            @if(po != null && po.WarehouseId.HasValue)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light border border-secondary border-opacity-10">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fas fa-warehouse text-primary fs-4 me-2"></i>
                        <h6 class="fw-bold text-dark mb-0">Warehouse Diagnostics</h6>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <span class="small text-muted d-block">Assigned Hub</span>
                            <span class="small fw-bold">@po.Warehouse?.Name</span>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Region</span>
                            <span class="small fw-bold">@po.Warehouse?.Region</span>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Stock Lock</span>
                            <span class="small fw-bold text-success"><i class="fas fa-lock me-1"></i>Reserved</span>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Pick Queue</span>
                            <span class="small fw-bold badge bg-secondary px-2">Live #@((Model.Id % 10) + 1)</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Operational Workspace (For Warehouse Role) -->
            @if (isWarehouseRole && po != null && currentIdx >= 2 && currentIdx <= 7)
            {
                <div class="card border-0 shadow-lg rounded-4 p-4 mb-4 bg-glass border-top border-4 border-warning">
                    <h6 class="fw-bold text-dark mb-3"><i class="fas fa-tools me-2 text-warning"></i> Operations Console</h6>
                    <form asp-controller="PurchaseOrder" asp-action="UpdateStatus" method="post" class="d-grid gap-3">
                        <input type="hidden" name="id" value="@po.Id" />
                        <div>
                            <label class="smaller fw-bold text-muted text-uppercase mb-2">Stage Progression</label>
                            <select name="status" class="form-select border-2 py-2">
                                @if (po.Status == "Accepted") { <option value="Picking">🚀 Transition to Picking</option> }
                                @if (po.Status == "Picking") { <option value="Picked">✅ Mark as Picked</option> }
                                @if (po.Status == "Picked") { <option value="Packing">📦 Transition to Packing</option> }
                                @if (po.Status == "Packing") { <option value="Packed">📦 Mark as Packed</option> }
                                @if (po.Status == "Packed") { <option value="Ready Dispatch">🚢 Ready Dispatch</option> }
                                @if (po.Status == "Ready Dispatch") { <option value="In Transit">🚚 Dispatch Shipment</option> }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning rounded-pill fw-bold py-3 shadow">
                            Update Phase
                        </button>
                    </form>
                </div>
            }

            @if (isSupplier && po?.Status == POStatus.Failed)
            {
                <div class="card border-0 shadow-lg rounded-4 p-4 mb-4 bg-danger bg-opacity-10 border border-danger shadow-danger-sm">
                    <h5 class="fw-bold text-danger mb-1"><i class="fas fa-exclamation-triangle me-2"></i> Delivery Failure Recovery</h5>
                    <p class="text-muted small mb-4 font-monospace">Case #@po.PONumber: <span class="badge bg-danger rounded-pill">@po.FailureReason</span></p>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <form asp-controller="Delivery" asp-action="RetryDelivery" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@po.Id" />
                                <button type="submit" class="btn btn-outline-dark w-100 rounded-pill fw-bold py-2 shadow-sm text-truncate">
                                    <i class="fas fa-redo me-1"></i> RETRY
                                </button>
                            </form>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-danger w-100 rounded-pill fw-bold py-2 shadow-sm text-truncate" data-bs-toggle="modal" data-bs-target="#reassignModal">
                                <i class="fas fa-user-plus me-1"></i> REASSIGN
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Logistics Intelligence -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h6 class="fw-bold text-uppercase text-muted smaller mb-4">Logistics Intelligence</h6>
                <div class="mb-4 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3"><i class="fas fa-map-marker-alt text-primary"></i></div>
                    <div>
                        <label class="smaller text-muted d-block">DESTINATION</label>
                        <span class="fw-bold text-dark">@Model.DeliveryAddress, @Model.DeliveryCity</span>
                    </div>
                </div>
                <div class="mb-4 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3"><i class="fas fa-truck-loading text-primary"></i></div>
                    <div>
                        <label class="smaller text-muted d-block">CARRIER AGENT</label>
                        <span class="fw-bold text-dark">@(po?.DeliveryAgent?.User?.FullName ?? "Unassigned")</span>
                    </div>
                </div>
                <div class="mb-0 d-flex align-items-start">
                    <div class="bg-light rounded-3 p-2 me-3"><i class="fas fa-id-card text-primary"></i></div>
                    <div>
                        <label class="smaller text-muted d-block">VEHICLE PLATE</label>
                        <span class="fw-bold text-dark">@(po?.Vehicle?.LicensePlate ?? "N/A")</span>
                    </div>
                </div>

                @if (isDelivered)
                {
                    <div class="mt-4 pt-4 border-top">
                        <label class="smaller text-muted d-block mb-3 text-uppercase fw-bold">Proof of Delivery</label>
                        
                        @if (!string.IsNullOrEmpty(po.SignaturePath))
                        {
                            <div class="mb-3">
                                <span class="smaller text-muted d-block mb-1">Customer Signature</span>
                                <div class="border rounded-3 p-2 bg-white">
                                    <img src="@po.SignaturePath" class="img-fluid" style="max-height: 80px;" alt="Signature">
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(po.ProofOfDelivery))
                        {
                            <div class="mb-3">
                                <span class="smaller text-muted d-block mb-1">Delivery Photo</span>
                                <a href="@po.ProofOfDelivery" target="_blank">
                                    <img src="@po.ProofOfDelivery" class="img-fluid rounded-3 border" style="max-height: 120px;" alt="Photo Proof">
                                </a>
                            </div>
                        }

                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-qrcode text-success me-2"></i>
                            <span class="small">QR Verification: <strong>@(po.IsQRVerified ? "VERIFIED" : "Not Performed")</strong></span>
                        </div>
                        
                        <div class="d-flex align-items-center">
                            <i class="fas fa-clipboard-check text-success me-2"></i>
                            <span class="small">Checklist: <strong>@(po.ChecklistVerified ? "COMPLETED" : "N/A")</strong></span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(po.DeliveryNotes))
                        {
                            <div class="mt-3 p-3 bg-white bg-opacity-10 rounded-3 small italic">
                                <i class="fas fa-quote-left text-white-50 me-2"></i> @po.DeliveryNotes
                            </div>
                        }
                    </div>
                }
                <div class="bg-white bg-opacity-10 rounded-3 p-3 mt-3 border border-white border-opacity-25">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-white"><i class="fas fa-shield-alt text-success me-2"></i>Security:</span>
                        <span class="badge bg-success text-white px-2">Chapa Secured</span>
                    </div>
                    <div class="text-white-50 extra-small">Funds are secured via Chapa and will be released upon delivery confirmation.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reassign Modal -->
<div class="modal fade" id="reassignModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">Reassign Delivery Agent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Delivery" asp-action="ReassignDelivery" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(po?.Id ?? 0)" />
                <div class="modal-body p-4">
                    <div class="alert alert-warning small border-0 mb-4">
                        <i class="fas fa-info-circle me-1"></i> Reassigning will reset the PO to <strong>Ready Dispatch</strong> for the new agent.
                    </div>
                    <label class="form-label fw-bold small mb-2 text-uppercase ls-1 text-muted">Select Replacement Professional</label>
                    <select name="agentId" class="form-select border-0 bg-light py-2" required>
                        <option value="">-- Select Agent --</option>
                        @if (ViewBag.Agents != null)
                        {
                            foreach (var agent in (IEnumerable<SCM_System.Models.Entities.SupplierEmployee>)ViewBag.Agents)
                            {
                                <option value="@agent.Id">@agent.User?.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div class="modal-footer border-0 pb-4 pe-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Confirm Reassignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch {
            "Pending" or "Issued" => "bg-info-subtle text-info",
            "Accepted" => "bg-primary-subtle text-primary",
            "Delivered" => "bg-success-subtle text-success",
            "Completed" => "bg-success text-white",
            "Rejected" or "Cancelled" or "Expired" => "bg-danger-subtle text-danger",
            _ => "bg-warning-subtle text-warning"
        };
    }
}

<style>
    .smaller { font-size: 0.70rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1); }
    .bg-glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); }
    .fulfillment-stepper { border: 1px solid rgba(0,0,0,0.05); }
    .step-node { z-index: 3; }
</style>
