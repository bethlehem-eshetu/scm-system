@using SCM_System.Models.Entities
@using SCM_System.Models.Constants
@model Order
@{
    ViewData["Title"] = "Fulfillment Command Center";
    Layout = "_DashboardLayout";
    bool isRetailer = User.IsInRole("Retailer");
    bool isSupplier = User.IsInRole("Supplier") || User.IsInRole("WarehouseManager");
    bool isWarehouseRole = User.IsInRole("WarehouseManager");

    // Primary PO context for fulfillment tracking
    var po = ViewBag.PrimaryPO as PurchaseOrder;
    
    // Status Flow Logic for Timeline (Must match POStatus.cs)
    var statuses = new[] { "Pending", "Issued", "Accepted", "Picking", "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed" };
    string currentStatus = po?.Status ?? Model.OrderStatus;
    int currentIdx = Array.IndexOf(statuses, currentStatus);
    if (currentIdx == -1) currentIdx = 0;

    bool isTerminal = new[] { "Rejected", "Expired", "Completed" }.Contains(currentStatus);

    // ✅ FIXED: show panel whenever warehouse missing and PO is still active
    bool showAssignPanel = (isSupplier || isWarehouseRole) && 
                          po != null && 
                          !po.WarehouseId.HasValue && 
                          !new[] { "Rejected", "Completed", "Delivered", "Expired" }.Contains(po.Status);

    bool isDelivered = currentStatus == "Delivered" || currentStatus == "Completed";

    var requiredQty = Model.OrderItems?.Sum(x => x.Quantity) ?? 0;
    
    // Calculate deposit and remaining amounts
    var depositAmount = Model.TotalAmount * 0.5m;
    var remainingAmount = Model.TotalAmount - depositAmount;
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb extra-small fw-bold text-uppercase ls-1 mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-dark-green opacity-50 text-decoration-none dark-mode-text">Operational Hub</a></li>
                    <li class="breadcrumb-item active text-dark-green dark-mode-text" aria-current="page">Execution #@Model.OrderNumber</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark-green mb-1 dark-mode-text"><i class="fas fa-file-contract text-accent-green me-2"></i>Fulfillment Command Center</h1>
            <p class="text-muted small mb-0 mt-1 dark-mode-text">Real-time oversight of the order execution lifecycle and logistics chain.</p>
        </div>
        <div class="d-flex gap-3">
            <button onclick="window.print()" class="btn btn-white rounded-pill px-4 py-2 shadow-sm fw-bold text-dark-green border dark-mode-btn">
                <i class="fas fa-print me-2"></i> Export
            </button>
            @if (isSupplier)
            {
                <a asp-controller="Message" asp-action="Conversation" asp-route-id="@(Model.Retailer?.UserId ?? 0)" class="btn btn-dark-green rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center dark-mode-primary-btn">
                    <i class="fas fa-comment-dots me-2 text-accent-green"></i> Message to Retailer
                </a>
            }
        </div>
    </div>

    <!-- Executive Intelligence Summary -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden mb-5 bg-white dark-mode-card">
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-xl-3 bg-dark-green p-5 text-center d-flex flex-column justify-content-center dark-mode-dark-section">
                    <span class="text-white-50 extra-small fw-bold text-uppercase ls-1 d-block mb-3">Deployment Status</span>
                    <h2 class="fw-bold text-white mb-3">#@Model.OrderNumber</h2>
                    <div class="status-pill-nexus @GetBadgeClass(currentStatus) rounded-pill py-2 shadow-lg dark-mode-status-pill">@currentStatus</div>
                    @if (Model.PaymentStatus == "PartialPaid")
                    {
                        <div class="mt-3">
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 extra-small fw-bold">
                                <i class="fas fa-percent me-1"></i> 50% Deposit Paid
                            </span>
                        </div>
                    }
                </div>
                <div class="col-xl-9 p-5 dark-mode-summary-section">
                    <div class="row g-4">
                        <div class="col-md-3 border-end border-faint dark-mode-border">
                            @{
                                var topNet = Model.Subtotal > 0 ? Model.Subtotal : Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                                var topVat = Model.VAT > 0 ? Model.VAT : Math.Round(topNet * 0.15m, 2);
                                var topTotal = Model.TotalAmount > (topNet + topVat - 1) ? Model.TotalAmount : (topNet + topVat);
                            }
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Contract Value</label>
                            <h3 class="fw-bold text-dark-green mb-1 dark-mode-text">@topTotal.ToString("N2") <small class="extra-small opacity-50">ETB</small></h3>
                        </div>
                        <div class="col-md-3 border-end border-faint dark-mode-border">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Payment Status</label>
                            <h4 class="fw-bold mb-1 dark-mode-text">
                                @if (Model.PaymentStatus == "PartialPaid")
                                {
                                    <span class="text-warning">50% Paid</span>
                                }
                                else if (Model.PaymentStatus == "Paid")
                                {
                                    <span class="text-success">Fully Paid</span>
                                }
                                else
                                {
                                    <span class="text-muted">@Model.PaymentStatus</span>
                                }
                            </h4>
                            @if (Model.PaymentStatus == "PartialPaid")
                            {
                                <span class="extra-small text-muted fw-bold dark-mode-text">Remaining: @remainingAmount.ToString("N2") ETB</span>
                            }
                        </div>
                        <div class="col-md-3 border-end border-faint dark-mode-border">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Execution Hub</label>
                            @if (po?.WarehouseId.HasValue == true)
                            {
                                <div class="d-flex align-items-center mt-1">
                                    <div class="bg-faint-green text-dark-green rounded-circle p-2 me-3 dark-mode-icon-bg">
                                        <i class="fas fa-warehouse small"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark-green mb-0 text-truncate dark-mode-text" style="max-width: 140px;">@(po?.Warehouse?.Name ?? "PENDING")</h6>
                                        <span class="extra-small text-muted fw-bold dark-mode-text">@po.Warehouse?.City Hub</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <h4 class="fw-bold text-warning mb-1">UNASSIGNED</h4>
                                <span class="extra-small text-danger fw-bold animate-pulse"><i class="fas fa-exclamation-triangle me-1"></i> HUB ALLOCATION REQ</span>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Target Delivery</label>
                            <h4 class="fw-bold text-danger mb-1">@(Model.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "TBD")</h4>
                            <span class="extra-small text-muted fw-bold dark-mode-text">SLA Compliance: 100%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Multi-Stage Fulfillment Pipeline -->
    <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden dark-mode-card">
        <div class="card-body p-5">
            <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-5 dark-mode-text">Workflow Lifecycle Progression</h6>
            <div class="nexus-stepper position-relative">
                <div class="stepper-track bg-faint-green rounded-pill dark-mode-track"></div>
                <div class="stepper-progress bg-dark-green rounded-pill shadow-premium" style="width: @(currentIdx * (100.0 / (statuses.Length - 1)))%;"></div>
                
                <div class="d-flex justify-content-between position-relative" style="z-index: 2; margin-top: -18px;">
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isActive = i <= currentIdx;
                        var isCurrent = i == currentIdx;
                        var icon = i switch { 0 => "fa-clock", 1 => "fa-file-invoice", 2 => "fa-check", 3 => "fa-dolly", 4 => "fa-clipboard-check", 5 => "fa-box-open", 6 => "fa-box", 7 => "fa-shipping-fast", 8 => "fa-truck-moving", 9 => "fa-house-user", _ => "fa-flag-checkered" };
                        
                        <div class="step-node-nexus d-flex flex-column align-items-center" style="width: 40px;">
                            <div class="node-circle rounded-circle d-flex align-items-center justify-content-center shadow-sm @(isActive ? "bg-dark-green text-accent-green" : "bg-white text-muted border border-faint dark-mode-inactive-circle")" 
                                 style="width: 36px; height: 36px; transition: all 0.5s ease; @(isCurrent ? "transform: scale(1.3); box-shadow: 0 0 15px rgba(212, 240, 109, 0.4);" : "")">
                                <i class="fas @icon extra-small"></i>
                            </div>
                            <div class="node-label extra-small fw-bold mt-3 text-center text-truncate @(isActive ? "text-dark-green dark-mode-active-label" : "text-muted opacity-50 dark-mode-inactive-label")" 
                                 style="width: 80px; @(isCurrent ? "transform: scale(1.1);" : "")">@statuses[i]</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <!-- Main Data Workspace -->
        <div class="col-lg-8">
            <!-- Order Manifest (Deep Dark Green Card) -->
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden mb-5 bg-dark-green text-white dark-mode-manifest-card">
                <div class="card-header bg-white bg-opacity-10 border-0 py-4 px-5 dark-mode-manifest-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-white"><i class="fas fa-boxes text-accent-green me-2"></i>Strategic Manifest</h5>
                        <span class="badge bg-accent-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small">@Model.OrderItems.Count LINE ITEMS</span>
                    </div>
                </div>
                <div class="card-body p-5 dark-mode-manifest-body">
                    <div class="manifest-nexus">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="manifest-row d-flex justify-content-between align-items-center mb-4 pb-4 border-bottom border-white border-opacity-10">
                                <div class="d-flex align-items-center">
                                    <div class="bg-white bg-opacity-10 rounded-4 p-3 me-4 text-accent-green shadow-sm">
                                        <i class="fas fa-box fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold fs-5 text-white mb-1">@item.ProductName</div>
                                        <div class="extra-small text-white-50 fw-bold tracking-widest uppercase">SKU: @(item.Product?.SKU ?? "GENERIC-ASSET")</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="extra-small text-white-50 fw-bold mb-1">@item.Quantity UNITS × @item.UnitPrice.ToString("N2")</div>
                                    <div class="fw-bold text-accent-green fs-4">@((item.Quantity * item.UnitPrice).ToString("N2")) <small class="extra-small">ETB</small></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-5 p-4 bg-black bg-opacity-20 rounded-5 border border-white border-opacity-10 shadow-inner dark-mode-total-box">
                        @{
                            var netSubtotal = Model.OrderItems.Sum(item => item.Quantity * item.UnitPrice);
                            var vatTotal = Math.Round(netSubtotal * 0.15m, 2);
                            var grandTotal = netSubtotal + vatTotal;
                        }
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50 fw-bold extra-small">NET ASSET VALUE</span>
                            <span class="fw-bold text-white">@netSubtotal.ToString("N2") ETB</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 pb-4 border-bottom border-white border-opacity-10">
                            <span class="text-white-50 fw-bold extra-small">VAT (15%)</span>
                            <span class="text-accent-green fw-bold">@vatTotal.ToString("N2") ETB</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0 text-white ls-1">FINAL CONTRACT TOTAL</h5>
                            <div class="text-end">
                                <h3 class="fw-bold mb-0 text-accent-green">@grandTotal.ToString("N2") <small class="extra-small opacity-50">ETB</small></h3>
                            </div>
                        </div>
                        @if (Model.PaymentStatus == "PartialPaid")
                        {
                            <div class="mt-3 pt-3 border-top border-white border-opacity-10">
                                <div class="d-flex justify-content-between">
                                    <span class="text-white-50 extra-small">Deposit Paid (50%)</span>
                                    <span class="text-accent-green fw-bold">@depositAmount.ToString("N2") ETB</span>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <span class="text-white-50 extra-small">Remaining Balance (50%)</span>
                                    <span class="text-warning fw-bold">@remainingAmount.ToString("N2") ETB</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Audit Trail -->
            <div class="card border-0 shadow-premium rounded-5 mb-5 bg-white overflow-hidden dark-mode-card">
                <div class="card-header bg-faint-green py-4 px-5 border-0 d-flex justify-content-between align-items-center dark-mode-audit-header">
                    <h6 class="fw-bold text-dark-green mb-0 dark-mode-text">Operational Lifecycle Audit</h6>
                    <span class="badge bg-white text-dark-green rounded-pill px-3 py-1 extra-small fw-bold border dark-mode-badge">Full Traceability</span>
                </div>
                <div class="card-body p-5 dark-mode-audit-body">
                    @await Html.PartialAsync("_ActivityTimeline", Model.StatusHistory?.OrderByDescending(h => h.ChangedAt).ToList() ?? new List<OrderStatusHistory>())
                </div>
            </div>
        </div>

        <!-- Strategic Intelligence Column -->
        <div class="col-lg-4">
            <!-- Dynamic Action Console -->
            @if (isRetailer && !new[] { "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed", "Cancelled" }.Contains(currentStatus))
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-danger dark-mode-card dark-mode-danger-card">
                    <h5 class="fw-bold text-dark-green mb-2 dark-mode-text">Strategic Interruption</h5>
                    <p class="text-muted small mb-4 fw-bold dark-mode-text">Administrative termination of this deployment.</p>
                    
                    <button class="btn btn-soft-danger w-100 rounded-pill fw-bold py-3 shadow-sm cancel-order-btn dark-mode-danger-btn" data-id="@Model.Id" data-total="@grandTotal.ToString("N2") ETB">
                        <i class="fas fa-ban me-2"></i> ABORT FULFILLMENT
                    </button>
                    <p class="extra-small text-muted mt-3 fw-bold text-center dark-mode-text">Safety Protocol: Only available pre-picking phase.</p>
                </div>
            }
            @if (isSupplier && Model.OrderStatus == "Pending")
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-dark-green dark-mode-card">
                    <h5 class="fw-bold text-dark-green mb-2 dark-mode-text">Order Validation</h5>
                    <p class="text-muted small mb-4 fw-bold dark-mode-text">Review and validate this incoming order contract.</p>
                    
                    <form asp-controller="Order" asp-action="StatusAction" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="actionType" value="Accept" />
                        
                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-3 dark-mode-text">Assign Initial Hub (Optional)</label>
                        <select name="warehouseId" class="form-select border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green mb-4 shadow-sm dark-mode-select">
                            <option value="">-- AUTO-SELECT BEST HUB --</option>
                            @if (ViewBag.Warehouses != null)
                            {
                                foreach (dynamic w in ViewBag.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name Hub (@w.City)</option>
                                }
                            }
                        </select>
                        
                        <button type="submit" class="btn btn-dark-green w-100 rounded-pill fw-bold py-3 shadow-premium mb-3 dark-mode-primary-btn">
                            <i class="fas fa-check-circle me-2 text-accent-green"></i> ACCEPT ORDER
                        </button>
                    </form>

                    <button type="button" class="btn btn-white w-100 rounded-pill fw-bold py-2 text-danger border border-danger border-opacity-10 small dark-mode-reject-btn" data-bs-toggle="collapse" data-bs-target="#rejectOrderForm">
                        Reject Order
                    </button>

                    <div class="collapse mt-3" id="rejectOrderForm">
                        <form asp-controller="Order" asp-action="StatusAction" method="post" class="p-3 bg-light rounded-4 dark-mode-icon-bg">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="actionType" value="Reject" />
                            <label class="extra-small fw-bold text-danger mb-2">REJECTION REASON</label>
                            <textarea name="rejectionReason" class="form-control border-0 rounded-3 mb-3 small" rows="3" placeholder="Explain why this order is being rejected..." required></textarea>
                            <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold small">CONFIRM REJECTION</button>
                        </form>
                    </div>
                </div>
            }

            @if (showAssignPanel)
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-dark-green dark-mode-card">
                    <h5 class="fw-bold text-dark-green mb-2 dark-mode-text">Fulfillment Activation</h5>
                    <p class="text-muted small mb-4 fw-bold dark-mode-text">Commit resources to the execution hub.</p>
                    
                    <form asp-controller="Order" asp-action="AcceptPO" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="poId" value="@po.Id" />
                        
                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-3 dark-mode-text">Primary Logistics Hub</label>
                        <select name="warehouseId" class="form-select border-0 bg-faint-green rounded-4 py-3 px-4 fw-bold text-dark-green mb-4 shadow-sm dark-mode-select" required>
                            <option value="-1">-- AUTO-ALLOCATE LOAD --</option>
                            @if (ViewBag.Warehouses != null)
                            {
                                foreach (dynamic w in ViewBag.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name Hub (@w.City)</option>
                                }
                            }
                        </select>
                        
                        <button type="submit" class="btn btn-dark-green w-100 rounded-pill fw-bold py-3 shadow-premium mb-3 dark-mode-primary-btn">
                            <i class="fas fa-bolt me-2 text-accent-green"></i> ACTIVATE FULFILLMENT
                        </button>
                    </form>

                    <form asp-controller="Order" asp-action="StatusAction" method="post" onsubmit="return confirm('Abort this deployment?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="actionType" value="Reject" />
                        <input type="hidden" name="rejectionReason" value="Rejected by fulfillment manager" />
                        <button type="submit" class="btn btn-white w-100 rounded-pill fw-bold py-2 text-danger border border-danger border-opacity-10 small dark-mode-reject-btn">
                            Reject Contract
                        </button>
                    </form>
                </div>
            }

            @if (isRetailer && Model.PaymentStatus == "Pending" && (Model.OrderStatus == "Accepted" || Model.OrderStatus == "Picking"))
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-accent-green dark-mode-card">
                    <h5 class="fw-bold text-dark-green mb-2 dark-mode-text"><i class="fas fa-wallet me-2 text-accent-green"></i>Financial Activation</h5>
                    <p class="text-muted small mb-4 fw-bold dark-mode-text">Your order has been accepted! Please pay the 50% advanced deposit to initiate fulfillment.</p>
                    
                    <div class="text-center mb-4">
                        <div class="bg-faint-green rounded-4 p-4 dark-mode-icon-bg">
                            <span class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Initial Deposit Required</span>
                            <h2 class="fw-bold text-dark-green mb-0 dark-mode-text">@depositAmount.ToString("N2") <small class="fs-6 opacity-50">ETB</small></h2>
                        </div>
                    </div>

                    <form asp-controller="Payment" asp-action="InitializeDepositPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit" class="btn btn-dark-green w-100 rounded-pill fw-bold py-3 shadow-premium mb-3 dark-mode-primary-btn">
                            <i class="fas fa-credit-card me-2 text-accent-green"></i> PAY 50% DEPOSIT NOW
                        </button>
                    </form>
                    
                    <p class="extra-small text-muted mt-2 fw-bold text-center dark-mode-text">
                        <i class="fas fa-shield-alt me-1 text-success"></i> Secured by Chapa Gateway
                    </p>
                </div>
            }

            <!-- Remaining Balance Card (NEW for 50% deposit feature) -->
            @if (isRetailer && Model.PaymentStatus == "PartialPaid" && Model.OrderStatus != "Completed" && Model.OrderStatus != "Cancelled")
            {
                <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white border-top border-5 border-warning dark-mode-card">
                    <h5 class="fw-bold text-dark-green mb-2 dark-mode-text"><i class="fas fa-credit-card me-2 text-warning"></i>Remaining Balance</h5>
                    <p class="text-muted small mb-4 fw-bold dark-mode-text">Pay the remaining 50% when you receive your order.</p>
                    
                    <div class="text-center mb-4">
                        <div class="bg-warning bg-opacity-10 rounded-4 p-4">
                            <span class="extra-small text-muted fw-bold text-uppercase ls-1 d-block mb-2 dark-mode-text">Amount Due on Delivery</span>
                            <h2 class="fw-bold text-warning mb-0">@remainingAmount.ToString("C")</h2>
                        </div>
                    </div>
                    
                    <div class="alert alert-info border-0 rounded-4 small dark-mode-alert">
                        <i class="fas fa-info-circle me-2"></i>
                        The remaining balance will be collected when your order is delivered to you.
                    </div>
                    
                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar bg-success" style="width: 50%">50% Paid</div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Deposit Paid ✅</span>
                        <span>Due on Delivery ⏳</span>
                    </div>
                </div>
            }

            <!-- Intelligence Cards -->
            <div class="card border-0 shadow-premium rounded-5 p-5 mb-5 bg-white dark-mode-card">
                <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-4 dark-mode-text">Strategic Partners</h6>
                <div class="d-flex align-items-center mb-4 p-3 bg-faint-green rounded-4 dark-mode-partner-card">
                    <div class="avatar shadow-sm rounded-circle bg-dark-green text-accent-green d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="fas fa-store extra-small"></i>
                    </div>
                    <div class="overflow-hidden">
                        <label class="extra-small text-muted d-block fw-bold opacity-75 dark-mode-text">RETAIL ENTITY</label>
                        <span class="fw-bold text-dark-green text-truncate d-block dark-mode-text">@Model.Retailer?.BusinessName</span>
                    </div>
                </div>
                <div class="d-flex align-items-center p-3 bg-dark-green text-white rounded-4 shadow-premium dark-mode-supplier-card">
                    <div class="avatar shadow-sm rounded-circle bg-white bg-opacity-20 text-accent-green d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="fas fa-industry extra-small"></i>
                    </div>
                    <div class="overflow-hidden">
                        <label class="extra-small text-white-50 d-block fw-bold opacity-75">SUPPLY HUB</label>
                        <span class="fw-bold text-white text-truncate d-block">@Model.Supplier?.CompanyName</span>
                    </div>
                </div>
            </div>

            <!-- Logistics Intel -->
            <div class="card border-0 shadow-premium rounded-5 p-5 bg-white dark-mode-card">
                <h6 class="extra-small fw-bold text-uppercase ls-1 text-muted mb-4 dark-mode-text">Logistics Stream</h6>
                <div class="mb-4 d-flex align-items-center p-3 bg-faint-green rounded-4 dark-mode-logistics-card">
                    <div class="bg-white rounded-circle p-2 me-3 text-dark-green shadow-sm dark-mode-icon-circle"><i class="fas fa-map-marker-alt extra-small"></i></div>
                    <div>
                        <label class="extra-small text-muted d-block fw-bold opacity-75 dark-mode-text">DESTINATION</label>
                        <span class="extra-small fw-bold text-dark-green dark-mode-text">@Model.DeliveryCity, Ethiopia</span>
                    </div>
                </div>
                <div class="mb-4 d-flex align-items-center p-3 bg-faint-green rounded-4 dark-mode-logistics-card">
                    <div class="bg-white rounded-circle p-2 me-3 text-dark-green shadow-sm dark-mode-icon-circle"><i class="fas fa-user-astronaut extra-small"></i></div>
                    <div>
                        <label class="extra-small text-muted d-block fw-bold opacity-75 dark-mode-text">CARRIER AGENT</label>
                        <span class="extra-small fw-bold text-dark-green dark-mode-text">@(po?.DeliveryAgent?.User?.FullName ?? "PENDING ALLOCATION")</span>
                    </div>
                </div>
                
                @if (isRetailer && currentStatus == "In Transit")
                {
                    <div class="mt-4 pt-4 border-top border-faint text-center dark-mode-border">
                        <h6 class="extra-small fw-bold text-dark-green mb-3 uppercase tracking-widest dark-mode-text"><i class="fas fa-qrcode me-2 text-accent-green"></i>Verification Identity</h6>
                        <div id="retailer-qrcode" class="d-inline-block bg-white p-3 rounded-5 shadow-premium border border-faint mb-4 dark-mode-qr"></div>
                        <p class="extra-small text-muted fw-bold mb-0 dark-mode-text">SCAN TO VERIFY POSSESSION</p>
                    </div>
                }

                @if (isDelivered)
                {
                    <div class="mt-4 pt-4 border-top border-faint dark-mode-border">
                        <label class="extra-small text-muted fw-bold text-uppercase ls-1 mb-4 dark-mode-text">Verification Artifacts</label>
                        
                        @if (!string.IsNullOrEmpty(po.SignaturePath))
                        {
                            <div class="mb-4">
                                <span class="extra-small text-muted fw-bold d-block mb-2 dark-mode-text">AUTHENTICATED SIGNATURE</span>
                                <div class="border rounded-4 p-3 bg-faint-green shadow-inner dark-mode-signature-box">
                                    <img src="@po.SignaturePath" class="img-fluid" style="max-height: 80px;" alt="Signature">
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(po.ProofOfDelivery))
                        {
                            <div class="mb-4">
                                <span class="extra-small text-muted fw-bold d-block mb-2 dark-mode-text">POSSESSION PROOF PHOTO</span>
                                <a href="@po.ProofOfDelivery" target="_blank" class="d-block rounded-4 overflow-hidden shadow-premium">
                                    <img src="@po.ProofOfDelivery" class="img-fluid" style="width: 100%;" alt="Photo Proof">
                                </a>
                            </div>
                        }
                        
                        <div class="d-flex align-items-center p-2 bg-soft-success text-success rounded-pill extra-small fw-bold mb-2 dark-mode-verified">
                            <i class="fas fa-shield-check mx-2"></i> IDENTITY QR VERIFIED
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch {
            "Pending" or "Issued" => "bg-soft-info text-info",
            "Accepted" => "bg-soft-primary text-primary",
            "Delivered" => "bg-soft-success text-success",
            "Completed" => "bg-accent-green text-dark-green fw-bold",
            "Rejected" or "Expired" or "Cancelled" => "bg-soft-danger text-danger",
            _ => "bg-soft-warning text-warning"
        };
    }
}

