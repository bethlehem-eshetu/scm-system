@model IEnumerable<SCM_System.Models.Entities.Order>
@{
    ViewData["Title"] = "Order Fulfillment Hub";
    Layout = "_DashboardLayout";
    var isSupplier = User.IsInRole("Supplier");
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1 dark-mode-text">
                <i class="fas fa-clipboard-list me-2"></i>
                @(isSupplier ? "Received Order Requests" : "My Purchase Requests")
            </h1>
            <p class="text-muted small mb-0 dark-mode-text">Manage fulfillment cycles and track transaction statuses in real-time</p>
        </div>
        <div class="d-flex gap-3 align-items-center">

            @if (!isSupplier)
            {
                <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-dark-green rounded-pill px-4 py-2 fw-bold shadow-premium dark-mode-btn">
                    <i class="fas fa-plus me-2 text-accent-green"></i> New Order
                </a>
            }
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar card p-3 mb-4 shadow-sm border-0 rounded-3 theme-card">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase dark-mode-text">Status</label>
                <select id="statusFilter" class="form-select dark-mode-select">
                    <option value="all">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase dark-mode-text">Date Range</label>
                <select id="dateRangeFilter" class="form-select dark-mode-select">
                    <option value="all">All Time</option>
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="this_month">This month</option>
                    <option value="custom">Custom range</option>
                </select>
            </div>
            <div class="col-md-3 d-none" id="customDateRange">
                <label class="form-label small fw-bold text-uppercase dark-mode-text">From</label>
                <input type="date" id="fromDate" class="form-control dark-mode-input" />
                <label class="form-label small fw-bold text-uppercase mt-2 dark-mode-text">To</label>
                <input type="date" id="toDate" class="form-control dark-mode-input" />
            </div>

            <div class="col-md-2">
                <button id="resetFilterBtn" class="btn btn-outline-secondary w-100 rounded-pill dark-mode-btn">Reset</button>
            </div>
        </div>
    </div>


    <div class="row g-4" id="ordersContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                <div class="col-xl-4 col-md-6 order-card-item order-card" data-status="@GetAggregateStatus(order.OrderStatus)" data-order-date="@order.CreatedAt.ToString("yyyy-MM-dd")">
                    <div class="card h-100 border-0 shadow-premium rounded-5 overflow-hidden hover-lift bg-white dark-mode-card">
                        <div class="card-header border-0 bg-faint-green p-4 d-flex justify-content-between align-items-center dark-mode-card-header">
                            <span class="badge bg-dark-green text-white rounded-pill px-3 py-2 fw-bold ls-1 dark-mode-badge">#@order.OrderNumber</span>
                            <span class="text-muted extra-small fw-bold dark-mode-text">@order.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="card-body p-4 dark-mode-card-body">
                            <div class="d-flex align-items-center mb-4">
                                <div class="bg-dark-green bg-opacity-10 text-dark-green rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm dark-mode-icon-circle" style="width: 54px; height: 54px;">
                                    <i class="fas @(isSupplier ? "fa-store" : "fa-building") fs-4"></i>
                                </div>
                                <div>
                                    <p class="text-muted extra-small mb-0 text-uppercase fw-bold ls-1 dark-mode-text">@(isSupplier ? "Retailer" : "Supplier")</p>
                                    <h6 class="fw-bold mb-0 text-dark-green dark-mode-text">@(isSupplier ? order.Retailer?.BusinessName : order.Supplier?.CompanyName)</h6>
                                </div>
                            </div>

                            <div class="row g-0 mb-4 py-3 bg-faint-green rounded-4 dark-mode-stats-box">
                                <div class="col-6 border-end border-light text-center dark-mode-border">
                                    @{
                                        var displayTotal = order.TotalAmount;
                                        if (order.Subtotal <= 0 && order.VAT <= 0) {
                                            var calcNet = order.OrderItems.Sum(i => i.Quantity * i.UnitPrice);
                                            if (displayTotal <= calcNet + 1) displayTotal = calcNet * 1.15m;
                                        }
                                    }
                                    <p class="text-muted extra-small mb-1 fw-bold dark-mode-text">Grand Total</p>
                                    <h5 class="fw-bold mb-0 text-dark-green dark-mode-text">@displayTotal.ToString("C0")</h5>
                                </div>
                                <div class="col-6 text-center">
                                    <p class="text-muted extra-small mb-1 fw-bold dark-mode-text">Unit Count</p>
                                    <h5 class="fw-bold mb-0 text-dark-green dark-mode-text">@order.OrderItems.Count</h5>
                                </div>
                            </div>

                            <div class="mb-4 px-1">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="extra-small fw-bold text-muted text-uppercase ls-1 dark-mode-text">Fulfillment Status</span>
                                    <span class="status-badge @GetStatusClass(order.OrderStatus) dark-mode-status fulfillment-status">@order.OrderStatus</span>
                                </div>
                                <div class="progress rounded-pill shadow-sm dark-mode-progress" style="height: 8px; background-color: rgba(0,0,0,0.05);">
                                    <div class="progress-bar @GetProgressColor(order.OrderStatus) rounded-pill" style="width: @GetProgressWidth(order.OrderStatus)%"></div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!isSupplier && !new[] { "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed", "Cancelled" }.Contains(order.OrderStatus))
                                {
                                    <button class="btn btn-white text-danger fw-bold extra-small text-uppercase ls-1 cancel-order-btn flex-grow-1 dark-mode-cancel-btn" data-id="@order.Id" data-total="@displayTotal.ToString("C0")">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 bg-faint-green rounded-5 border-dashed-custom dark-mode-empty-state">
                    <i class="fas fa-clipboard fa-4x text-dark-green opacity-10 mb-3"></i>
                    <h5 class="fw-bold text-dark-green dark-mode-text">No Orders Found</h5>
                    <p class="text-muted small dark-mode-text">You don't have any active or past orders matching your current filters.</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Cancel Confirmation Modal (Nexus Style) -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden dark-mode-modal">
            <div class="modal-header bg-danger text-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Order Cancellation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-5 text-center dark-mode-modal-body">
                <div class="bg-soft-danger text-danger rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fas fa-ban fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark-green mb-2 dark-mode-text">Confirm Cancellation?</h4>
                <p class="text-muted mb-4 small dark-mode-text">This action will return all reserved stock to inventory. This cannot be undone.</p>
                
                <div class="bg-faint-green rounded-4 p-3 mb-4 dark-mode-modal-box">
                    <p class="extra-small text-muted fw-bold text-uppercase ls-1 mb-1 dark-mode-text">Reversal Amount</p>
                    <h4 class="fw-bold text-dark-green mb-0 dark-mode-text" id="modalOrderTotal">ETB 0.00</h4>
                </div>
                
                <form id="cancelOrderForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-danger rounded-pill py-3 fw-bold shadow-sm dark-mode-danger-btn">
                            Confirm Cancellation
                        </button>
                        <button type="button" class="btn btn-faint-green rounded-pill py-3 fw-bold text-dark-green dark-mode-cancel-modal-btn" data-bs-dismiss="modal">
                            Keep Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-soft-warning text-warning",
            "Accepted" => "bg-soft-info text-info",
            "Processing" => "bg-soft-primary text-primary",
            "Delivered" => "bg-soft-success text-success",
            "Completed" => "bg-soft-dark text-dark",
            "Cancelled" => "bg-soft-danger text-danger",
            _ => "bg-soft-secondary text-secondary"
        };
    }

    string GetProgressColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Accepted" => "bg-info",
            "Processing" => "bg-primary",
            "Delivered" => "bg-success",
            "Completed" => "bg-dark-green",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    int GetProgressWidth(string status)
    {
        return status switch
        {
            "Pending" => 20,
            "Accepted" => 40,
            "Processing" => 70,
            "Delivered" => 90,
            "Completed" => 100,
            "Cancelled" => 100,
            _ => 10
        };
    }

    string GetAggregateStatus(string status)
    {
        if (status == "Pending") return "Pending";
        if (status == "Completed" || status == "Delivered") return "Completed";
        if (status == "Cancelled") return "Cancelled";
        return "Active";
    }
}

