@model IEnumerable<SCM_System.Models.Entities.Order>
@{
    ViewData["Title"] = "Order Fulfillment Hub";
    Layout = "_DashboardLayout";
    var isSupplier = User.IsInRole("Supplier");
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1">
                <i class="fas fa-clipboard-list me-2"></i>
                @(isSupplier ? "Received Order Requests" : "My Purchase Requests")
            </h1>
            <p class="text-muted small mb-0">Manage fulfillment cycles and track transaction statuses in real-time</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="btn-group shadow-premium rounded-pill overflow-hidden bg-white p-1">
                <button class="btn btn-white nexus-filter-btn active px-4 py-2 small fw-bold" data-filter="all">All</button>
                <button class="btn btn-white nexus-filter-btn px-4 py-2 small fw-bold" data-filter="Pending">Pending</button>
                <button class="btn btn-white nexus-filter-btn px-4 py-2 small fw-bold" data-filter="Active">Active</button>
                <button class="btn btn-white nexus-filter-btn px-4 py-2 small fw-bold" data-filter="Completed">Completed</button>
            </div>
            @if (!isSupplier)
            {
                <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-dark-green rounded-pill px-4 py-2 fw-bold shadow-premium">
                    <i class="fas fa-plus me-2 text-accent-green"></i> New Order
                </a>
            }
        </div>
    </div>


    <div class="row g-4" id="ordersContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                <div class="col-xl-4 col-md-6 order-card-item" data-status="@GetAggregateStatus(order.OrderStatus)">
                    <div class="card h-100 border-0 shadow-premium rounded-5 overflow-hidden hover-lift bg-white">
                        <div class="card-header border-0 bg-faint-green p-4 d-flex justify-content-between align-items-center">
                            <span class="badge bg-dark-green text-white rounded-pill px-3 py-2 fw-bold ls-1">#@order.OrderNumber</span>
                            <span class="text-muted extra-small fw-bold">@order.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="bg-dark-green bg-opacity-10 text-dark-green rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 54px; height: 54px;">
                                    <i class="fas @(isSupplier ? "fa-store" : "fa-building") fs-4"></i>
                                </div>
                                <div>
                                    <p class="text-muted extra-small mb-0 text-uppercase fw-bold ls-1">@(isSupplier ? "Retailer" : "Supplier")</p>
                                    <h6 class="fw-bold mb-0 text-dark-green">@(isSupplier ? order.Retailer?.BusinessName : order.Supplier?.CompanyName)</h6>
                                </div>
                            </div>

                            <div class="row g-0 mb-4 py-3 bg-faint-green rounded-4">
                                <div class="col-6 border-end border-light text-center">
                                    @{
                                        var displayTotal = order.TotalAmount;
                                        if (order.Subtotal <= 0 && order.VAT <= 0) {
                                            var calcNet = order.OrderItems.Sum(i => i.Quantity * i.UnitPrice);
                                            if (displayTotal <= calcNet + 1) displayTotal = calcNet * 1.15m;
                                        }
                                    }
                                    <p class="text-muted extra-small mb-1 fw-bold">Grand Total</p>
                                    <h5 class="fw-bold mb-0 text-dark-green">@displayTotal.ToString("C0")</h5>
                                </div>
                                <div class="col-6 text-center">
                                    <p class="text-muted extra-small mb-1 fw-bold">Unit Count</p>
                                    <h5 class="fw-bold mb-0 text-dark-green">@order.OrderItems.Count</h5>
                                </div>
                            </div>

                            <div class="mb-4 px-1">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="extra-small fw-bold text-muted text-uppercase ls-1">Fulfillment Status</span>
                                    <span class="status-badge @GetStatusClass(order.OrderStatus)">@order.OrderStatus</span>
                                </div>
                                <div class="progress rounded-pill shadow-sm" style="height: 8px; background-color: rgba(0,0,0,0.05);">
                                    <div class="progress-bar @GetProgressColor(order.OrderStatus) rounded-pill" style="width: @GetProgressWidth(order.OrderStatus)%"></div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!isSupplier && !new[] { "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed", "Cancelled" }.Contains(order.OrderStatus))
                                {
                                    <button class="btn btn-white text-danger fw-bold extra-small text-uppercase ls-1 cancel-order-btn flex-grow-1" data-id="@order.Id" data-total="@displayTotal.ToString("C0")">
                                        Cancel
                                    </button>
                                }
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-dark-green rounded-pill px-4 fw-bold shadow-sm flex-grow-1">
                                    Manage <i class="fas fa-arrow-right ms-2 text-accent-green"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 bg-faint-green rounded-5 border-dashed-custom">
                    <i class="fas fa-clipboard fa-4x text-dark-green opacity-10 mb-3"></i>
                    <h5 class="fw-bold text-dark-green">No Orders Found</h5>
                    <p class="text-muted small">You don't have any active or past orders matching your current filters.</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Cancel Confirmation Modal (Nexus Style) -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-5 overflow-hidden">
            <div class="modal-header bg-danger text-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Order Cancellation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-5 text-center">
                <div class="bg-soft-danger text-danger rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fas fa-ban fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark-green mb-2">Confirm Cancellation?</h4>
                <p class="text-muted mb-4 small">This action will return all reserved stock to inventory. This cannot be undone.</p>
                
                <div class="bg-faint-green rounded-4 p-3 mb-4">
                    <p class="extra-small text-muted fw-bold text-uppercase ls-1 mb-1">Reversal Amount</p>
                    <h4 class="fw-bold text-dark-green mb-0" id="modalOrderTotal">ETB 0.00</h4>
                </div>
                
                <form id="cancelOrderForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-danger rounded-pill py-3 fw-bold shadow-sm">
                            Confirm Cancellation
                        </button>
                        <button type="button" class="btn btn-faint-green rounded-pill py-3 fw-bold text-dark-green" data-bs-dismiss="modal">
                            Keep Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-soft-warning text-warning",
            "Accepted" => "bg-soft-info text-info",
            "Processing" => "bg-soft-primary text-primary",
            "Delivered" => "bg-soft-success text-success",
            "Completed" => "bg-soft-dark text-dark",
            "Cancelled" => "bg-soft-danger text-danger",
            _ => "bg-soft-secondary text-secondary"
        };
    }

    string GetProgressColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Accepted" => "bg-info",
            "Processing" => "bg-primary",
            "Delivered" => "bg-success",
            "Completed" => "bg-dark-green",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    int GetProgressWidth(string status)
    {
        return status switch
        {
            "Pending" => 20,
            "Accepted" => 40,
            "Processing" => 70,
            "Delivered" => 90,
            "Completed" => 100,
            "Cancelled" => 100,
            _ => 10
        };
    }

    string GetAggregateStatus(string status)
    {
        if (status == "Pending") return "Pending";
        if (status == "Completed" || status == "Delivered") return "Completed";
        if (status == "Cancelled") return "Cancelled";
        return "Active";
    }
}

@section Styles {
    <style>
        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .status-badge {
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .bg-soft-success { background-color: rgba(25, 135, 84, 0.1); }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.1); }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.1); }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.1); }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1); }
        .bg-soft-dark { background-color: rgba(0, 0, 0, 0.05); }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .nexus-filter-btn { border: none; transition: all 0.3s ease; }
        .nexus-filter-btn.active { background-color: var(--primary-color) !important; color: var(--accent-green) !important; box-shadow: 0 4px 12px rgba(26,61,49,0.2); }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-10px); }

        .animate-slide-up { animation: slideUp 0.5s ease-out; }
        @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterBtns = document.querySelectorAll('.nexus-filter-btn');
            const orderCards = document.querySelectorAll('.order-card-item');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.dataset.filter;
                    orderCards.forEach(card => {
                        if (filter === 'all' || card.dataset.status === filter) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            document.querySelectorAll('.cancel-order-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const orderId = this.dataset.id;
                    const total = this.dataset.total;
                    document.getElementById('modalOrderTotal').textContent = total;
                    document.getElementById('cancelOrderForm').action = `/Order/CancelOrder/${orderId}`;
                    const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
                    modal.show();
                });
            });

            document.getElementById('cancelOrderForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const form = this;
                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) { location.reload(); } else { alert(data.message); }
                });
            });
        });
    </script>
}
