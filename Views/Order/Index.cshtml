@model IEnumerable<SCM_System.Models.Entities.Order>
@{
    ViewData["Title"] = "Order Fulfillment Center";
    Layout = "_DashboardLayout";
    var isSupplier = User.IsInRole("Supplier");
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="fas fa-clipboard-list me-2"></i>
                @(isSupplier ? "Received Order Requests" : "My Purchase Requests")
            </h3>
            <p class="text-muted mb-0">Manage fulfillment cycles and track transaction statuses</p>
        </div>
        <div class="d-flex gap-3">
            <div class="btn-group shadow-sm rounded-pill overflow-hidden border bg-white">
                <button class="btn btn-white active px-3 filter-btn" data-filter="all">All</button>
                <button class="btn btn-white px-3 filter-btn" data-filter="Pending">Pending</button>
                <button class="btn btn-white px-3 filter-btn" data-filter="Active">Active</button>
                <button class="btn btn-white px-3 filter-btn" data-filter="Completed">Completed</button>
            </div>
            @if (!isSupplier)
            {
                <a asp-controller="Retailer" asp-action="BrowseCatalog" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="fas fa-plus me-2"></i> New Order
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4" id="ordersContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                <div class="col-xl-4 col-md-6 order-card-item" data-status="@GetAggregateStatus(order.OrderStatus)">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift">
                        <div class="card-header border-0 bg-light p-3 d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary rounded-pill px-3">#@order.OrderNumber</span>
                            <span class="text-muted small fw-bold">@order.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                    <i class="fas @(isSupplier ? "fa-store" : "fa-building") fs-4"></i>
                                </div>
                                <div>
                                    <p class="text-muted small mb-0">@(isSupplier ? "Retailer" : "Supplier")</p>
                                    <h6 class="fw-bold mb-0">@(isSupplier ? order.Retailer?.BusinessName : order.Supplier?.CompanyName)</h6>
                                </div>
                            </div>

                            <div class="row g-0 mb-4 py-3 border-top border-bottom">
                                <div class="col-6 border-end text-center">
                                    @{
                                        // Fallback if TotalAmount is Net for old orders
                                        var displayTotal = order.TotalAmount;
                                        if (order.Subtotal <= 0 && order.VAT <= 0) {
                                            var calcNet = order.OrderItems.Sum(i => i.Quantity * i.UnitPrice);
                                            if (displayTotal <= calcNet + 1) displayTotal = calcNet * 1.15m;
                                        }
                                    }
                                    <p class="text-muted small mb-1">Total (inc. VAT)</p>
                                    <h5 class="fw-bold mb-0 text-success">@displayTotal.ToString("C0")</h5>
                                </div>
                                <div class="col-6 text-center">
                                    <p class="text-muted small mb-1">Items</p>
                                    <h5 class="fw-bold mb-0">@order.OrderItems.Count</h5>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small fw-bold">Fulfillment Status</span>
                                    <span class="badge @GetStatusClass(order.OrderStatus) rounded-pill px-2">@order.OrderStatus</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @GetProgressColor(order.OrderStatus)" style="width: @GetProgressWidth(order.OrderStatus)%"></div>
                                </div>
                            </div>

                                <div class="d-flex align-items-center">
                                    @if (!isSupplier && !new[] { "Picked", "Packing", "Packed", "Ready Dispatch", "In Transit", "Delivered", "Completed", "Cancelled" }.Contains(order.OrderStatus))
                                    {
                                        <button class="btn btn-link text-danger text-decoration-none fw-bold me-2 cancel-order-btn" data-id="@order.Id" data-total="@displayTotal.ToString("C0")">
                                            Cancel
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                                        Manage <i class="fas fa-chevron-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 bg-light rounded-4 border-2 border-dashed">
                    <i class="fas fa-clipboard fa-4x text-muted mb-3 opacity-25"></i>
                    <h5>No Orders Found</h5>
                    <p class="text-muted">You don't have any active or past orders matching your current filters.</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Cancel Confirmation Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Cancel Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-ban fa-4x text-danger opacity-25"></i>
                </div>
                <h5 class="fw-bold mb-2">Are you sure?</h5>
                <p class="text-muted mb-4">You are about to cancel this order. Any reserved stock will be returned to inventory.</p>
                
                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Order Total:</span>
                        <span class="fw-bold text-dark" id="modalOrderTotal">ETB 0.00</span>
                    </div>
                </div>
                
                <form id="cancelOrderForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill py-2 fw-bold shadow-sm">
                            Confirm Cancellation
                        </button>
                        <button type="button" class="btn btn-light rounded-pill py-2 fw-bold" data-bs-dismiss="modal">
                            Keep Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Accepted" => "bg-info text-dark",
            "Processing" => "bg-primary text-white",
            "Delivered" => "bg-success text-white",
            "Completed" => "bg-dark text-white",
            "Cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetProgressColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Accepted" => "bg-info",
            "Processing" => "bg-primary",
            "Delivered" => "bg-success",
            "Completed" => "bg-dark",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    int GetProgressWidth(string status)
    {
        return status switch
        {
            "Pending" => 20,
            "Accepted" => 40,
            "Processing" => 70,
            "Delivered" => 90,
            "Completed" => 100,
            "Cancelled" => 100,
            _ => 10
        };
    }

    string GetAggregateStatus(string status)
    {
        if (status == "Pending") return "Pending";
        if (status == "Completed" || status == "Delivered") return "Completed";
        if (status == "Cancelled") return "Cancelled";
        return "Active";
    }
}

@section Styles {
    <style>
        .hover-lift {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
        }
        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }
        .filter-btn.active {
            background-color: var(--primary-color) !important;
            color: white !important;
            border-color: var(--primary-color) !important;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const orderCards = document.querySelectorAll('.order-card-item');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.dataset.filter;
                    orderCards.forEach(card => {
                        if (filter === 'all' || card.dataset.status === filter) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Cancel Order Logic
            document.querySelectorAll('.cancel-order-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const orderId = this.dataset.id;
                    const total = this.dataset.total;
                    
                    document.getElementById('modalOrderTotal').textContent = total;
                    document.getElementById('cancelOrderForm').action = `/Order/CancelOrder/${orderId}`;
                    
                    const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
                    modal.show();
                });
            });

            document.getElementById('cancelOrderForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const form = this;
                const url = form.action;
                const formData = new FormData(form);

                fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while cancelling the order.');
                });
            });
        });
    </script>
}
