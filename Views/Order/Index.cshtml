@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const statusFilter = document.getElementById('statusFilter');
            const dateRangeFilter = document.getElementById('dateRangeFilter');
            const customDateRange = document.getElementById('customDateRange');
            const fromDateInput = document.getElementById('fromDate');
            const toDateInput = document.getElementById('toDate');

            function applyFilters() {
                const status = statusFilter.value;
                const dateRange = dateRangeFilter.value;
                let fromDate = null, toDate = null;

                if (dateRange === 'custom') {
                    const fromStr = fromDateInput.value;
                    const toStr = toDateInput.value;
                    if (!fromStr || !toStr) {
                        // If custom is selected but dates aren't filled, show all for now or keep current view
                        return;
                    }
                    fromDate = new Date(fromStr);
                    fromDate.setHours(0,0,0,0);
                    toDate = new Date(toStr);
                    toDate.setHours(23,59,59,999);
                } else if (dateRange === 'this_month') {
                    const now = new Date();
                    fromDate = new Date(now.getFullYear(), now.getMonth(), 1);
                    toDate = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);
                } else if (dateRange !== 'all') {
                    const days = parseInt(dateRange);
                    toDate = new Date();
                    toDate.setHours(23, 59, 59, 999);
                    fromDate = new Date();
                    fromDate.setDate(fromDate.getDate() - days);
                    fromDate.setHours(0, 0, 0, 0);
                }

                document.querySelectorAll('.order-card').forEach(card => {
                    let show = true;
                    if (status !== 'all') {
                        const cardStatus = card.dataset.status;
                        if (cardStatus !== status) show = false;
                    }
                    if (show && fromDate && toDate) {
                        const orderDateStr = card.dataset.orderDate;
                        if (orderDateStr) {
                            const orderDate = new Date(orderDateStr);
                            if (orderDate < fromDate || orderDate > toDate) show = false;
                        }
                    }
                    card.style.display = show ? 'block' : 'none';
                });
            }

            // Automatic triggers
            if (statusFilter) statusFilter.addEventListener('change', applyFilters);
            
            if (dateRangeFilter) {
                dateRangeFilter.addEventListener('change', function() {
                    if (this.value === 'custom') {
                        customDateRange.classList.remove('d-none');
                    } else {
                        customDateRange.classList.add('d-none');
                        applyFilters(); // Trigger filter for presets
                    }
                });
            }

            if (fromDateInput) fromDateInput.addEventListener('input', applyFilters);
            if (toDateInput) toDateInput.addEventListener('input', applyFilters);

            const resetBtn = document.getElementById('resetFilterBtn');
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    statusFilter.value = 'all';
                    dateRangeFilter.value = 'all';
                    customDateRange.classList.add('d-none');
                    fromDateInput.value = '';
                    toDateInput.value = '';
                    applyFilters();
                });
            }

            // Initial call to ensure filters are applied if page reloads with values
            applyFilters();

            document.querySelectorAll('.cancel-order-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const orderId = this.dataset.id;
                    const total = this.dataset.total;
                    document.getElementById('modalOrderTotal').textContent = total;
                    document.getElementById('cancelOrderForm').action = `/Order/CancelOrder/${orderId}`;
                    const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
                    modal.show();
                });
            });

            document.getElementById('cancelOrderForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const form = this;
                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) { location.reload(); } else { alert(data.message); }
                });
            });
        });
    </script>
}