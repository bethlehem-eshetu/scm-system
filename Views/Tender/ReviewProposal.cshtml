@model SCM_System.Models.Entities.TenderBid
@{
    ViewData["Title"] = "Review Proposal";
    Layout = "_DashboardLayout";
    
    // Derived values for display
    var itemsCount = Model.Tender?.TenderItems?.Count ?? 0;
    var totalQuantity = Model.Tender?.TenderItems?.Sum(i => i.Quantity) ?? 0;
    var pricePerUnit = totalQuantity > 0 ? Model.ProposedTotalAmount / totalQuantity : Model.ProposedTotalAmount;
    var proposedDate = DateTime.Now.AddDays(Model.DeliveryLeadTimeDays).ToString("MMM dd, yyyy");
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Breadcrumb & Evaluation Header -->
    <div class="row align-items-end mb-4">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Procurement</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.TenderId" class="text-decoration-none">@Model.Tender?.ReferenceNumber</a></li>
                    <li class="breadcrumb-item active">Proposal Evaluation</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="fas fa-microscope text-primary me-2"></i>Evaluation Center: <span class="text-primary">@Model.Supplier?.CompanyName</span>
            </h2>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="d-inline-flex align-items-center bg-white shadow-sm rounded-pill px-4 py-2 border">
                <span class="smaller fw-bold text-muted text-uppercase me-3">System Score</span>
                <div class="fw-bold fs-4 text-primary">@Model.Score<span class="smaller text-muted">/100</span></div>
            </div>
        </div>
    </div>

    @if (Model.Status == "RevisionRequested")
    {
        <div class="alert alert-primary border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-start">
            <div class="bg-primary text-white rounded-circle p-3 me-4">
                <i class="fas fa-history fa-2x"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1">Revision Requested</h5>
                <p class="mb-0 text-dark opacity-75">@Model.Notes.Split('\n')[0]</p>
                <small class="text-muted mt-2 d-block">Supplier must update the proposal and resubmit for further evaluation.</small>
            </div>
        </div>
    }

    <!-- Executive Evaluation Pillars -->
    <div class="row g-4 mb-4">
        <!-- 1. Financial Pillar -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h6 class="fw-bold text-uppercase text-muted smaller mb-0">Financial Pillar</h6>
                        <i class="fas fa-money-bill-wave text-success fs-4"></i>
                    </div>
                    <div class="text-center py-3">
                        <h2 class="fw-bold text-dark mb-1">@Model.ProposedTotalAmount.ToString("N0")</h2>
                        <span class="text-muted small">Total Bid Amount (ETB)</span>
                    </div>
                    <hr class="opacity-10">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="smaller text-muted">UNIT COST AVG</span>
                        <span class="fw-bold small">@pricePerUnit.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="smaller text-muted">PRICE VALIDITY</span>
                        <span class="fw-bold small text-primary">@Model.ValidityPeriodDays Days</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Delivery Pillar -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-info">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h6 class="fw-bold text-uppercase text-muted smaller mb-0">Logistics Pillar</h6>
                        <i class="fas fa-shipping-fast text-info fs-4"></i>
                    </div>
                    <div class="text-center py-3">
                        <h2 class="fw-bold text-dark mb-1">@Model.DeliveryLeadTimeDays</h2>
                        <span class="text-muted small">Day Lead Time</span>
                    </div>
                    <hr class="opacity-10">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="smaller text-muted">EST. COMPLETION</span>
                        <span class="fw-bold small">@proposedDate</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="smaller text-muted">PENALTY ACCEPTANCE</span>
                        <span class="badge bg-info-subtle text-info border rounded-pill">Mandatory 5% Accepted</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Technical Pillar -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-primary">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h6 class="fw-bold text-uppercase text-muted smaller mb-0">Technical Pillar</h6>
                        <i class="fas fa-certificate text-primary fs-4"></i>
                    </div>
                    <div class="text-center py-3">
                        <h2 class="fw-bold text-dark mb-1">@(Model.WarrantyPeriod != null ? Model.WarrantyPeriod.Split(' ')[0] : "Standard")</h2>
                        <span class="text-muted small">Warranty Period</span>
                    </div>
                    <hr class="opacity-10">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="smaller text-muted">INSPECTION</span>
                        <span class="fw-bold small">Pass/Compliant</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="smaller text-muted">COMPLIANCE</span>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill">@(Model.InspectionCompliance ?? "Standard")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Product & Technical Dossier -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Proposed Goods Manifest</h6>
                    <span class="badge bg-light text-muted border">@itemsCount Items</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase smaller fw-bold text-muted">
                            <tr>
                                <th class="ps-4">Product / Specification</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Tender Target Price</th>
                                <th class="text-end pe-4">Proposed Unit Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.Tender?.TenderItems != null)
                            {
                                foreach(var item in Model.Tender.TenderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                            <div class="smaller text-muted">@item.Description</div>
                                        </td>
                                        <td class="text-center"><span class="badge bg-secondary-subtle text-secondary px-3">x @item.Quantity</span></td>
                                        <td class="text-end text-muted small">@item.EstimatedUnitPrice?.ToString("N2")</td>
                                        <td class="text-end pe-4 fw-bold text-primary">@Model.UnitPrice.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Detailed Proposal Narrative -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 px-4">
                    <h6 class="fw-bold mb-0">Technical Proposal Narrative</h6>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-4" style="white-space: pre-line; line-height: 1.7;">
                        @(string.IsNullOrEmpty(Model.TechnicalProposal) ? "The supplier has not provided a detailed technical narrative beyond the standard compliance confirmation." : Model.TechnicalProposal)
                    </div>
                    
                    @if(!string.IsNullOrEmpty(Model.Notes))
                    {
                        <h6 class="fw-bold smaller text-uppercase text-muted mb-2">Additional Remarks</h6>
                        <p class="mb-0 text-muted small border-start border-4 ps-3">@Model.Notes</p>
                    }
                </div>
            </div>
        </div>

        <!-- Contextual Outcome & Actions -->
        <div class="col-lg-4">
            <!-- Supplier Profile Info (Kept Shared) -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center">
                <div class="avatar mx-auto mb-3 shadow rounded-circle bg-primary d-flex align-items-center justify-content-center text-white" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    @(Model.Supplier?.CompanyName?.Substring(0, 1) ?? "S")
                </div>
                <h5 class="fw-bold text-dark mb-1">@Model.Supplier?.CompanyName</h5>
                <span class="badge @(Model.Supplier?.VerificationStatus == "Verified" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill mb-3">@Model.Supplier?.VerificationStatus</span>
                <div class="d-flex justify-content-center gap-4 mt-2">
                    <div class="small">
                        <div class="fw-bold text-dark">4.9 <i class="fas fa-star text-warning"></i></div>
                        <span class="smaller text-muted">RATING</span>
                    </div>
                    <div class="small">
                        <div class="fw-bold text-dark">150+</div>
                        <span class="smaller text-muted">ORDERS</span>
                    </div>
                </div>
            </div>

            @if (User.IsInRole("Supplier"))
            {
                <!-- Supplier: Bid Performance & Visibility Center -->
                var allBids = Model.Tender?.Bids?.OrderBy(b => b.ProposedTotalAmount).ToList() ?? new List<SCM_System.Models.Entities.TenderBid> { Model };
                var marketAvg = allBids.Any() ? allBids.Average(b => b.ProposedTotalAmount) : Model.ProposedTotalAmount;
                var rank = allBids.FindIndex(b => b.Id == Model.Id) + 1;
                var statusColor = Model.Status == "Pending" ? "warning" : (Model.Status == "Accepted" ? "success" : "danger");

                <div class="card border-0 shadow-lg rounded-4 p-4 bg-glass border-top border-4 border-@statusColor">
                    <h6 class="fw-bold text-dark mb-3">Proposal Status Card</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Bid Status:</span>
                        <span class="badge bg-@(statusColor)-subtle text-@statusColor rounded-pill px-2">@(Model.Status == "Pending" ? "Under Evaluation" : Model.Status)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Tender Deadline:</span>
                        <span class="small fw-bold">@Model.Tender?.SubmissionDeadline.ToString("MMM dd")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Submitted:</span>
                        <span class="small fw-bold">@Model.SubmittedAt.ToString("MMM dd")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="small text-muted">Current Rank:</span>
                        <span class="small fw-bold text-primary">#@rank of @allBids.Count</span>
                    </div>

                    <h6 class="fw-bold text-dark mb-2 mt-4">Competitive Insights</h6>
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Your Price:</span>
                            <span class="small fw-bold">@Model.ProposedTotalAmount.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Market Average:</span>
                            <span class="small fw-bold">@marketAvg.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="small text-muted">Lead Time:</span>
                            <span class="small fw-bold">@Model.DeliveryLeadTimeDays Days</span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-3">Actions</h6>
                    @if (Model.Status == "Accepted")
                    {
                        <div class="alert alert-success border-0 px-3 py-2 text-center rounded-3 mb-3">
                            <i class="fas fa-trophy fa-2x mb-2 text-success"></i>
                            <h6 class="fw-bold mb-1">Congratulations — You Won!</h6>
                            <p class="smaller mb-2">Your fulfillment order is ready.</p>
                            <a asp-controller="Tender" asp-action="AwardedContracts" class="btn btn-sm btn-success rounded-pill fw-bold w-100 shadow-sm">Open Contract Center</a>
                        </div>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <div class="alert alert-danger border-0 px-3 py-2 text-center rounded-3 mb-3">
                            <p class="small fw-bold mb-1 text-danger">Not Awarded</p>
                            <p class="smaller mb-0">Winning Bid: @allBids.First().ProposedTotalAmount.ToString("N0")</p>
                            <em class="extra-small text-muted d-block mt-2">Improve pricing next round</em>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <a asp-action="EditProposal" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill fw-bold text-dark btn-sm"><i class="fas fa-edit me-1"></i> Edit Proposal</a>
                            
                            <form asp-action="WithdrawProposal" method="post" onsubmit="return confirm('Withdraw this proposal?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger rounded-pill fw-bold text-danger btn-sm w-100"><i class="fas fa-times me-1"></i> Withdraw Proposal</button>
                            </form>
                            
                            <a asp-controller="Message" asp-action="SendMessage" asp-route-receiverId="@Model.Tender?.Retailer?.UserId" class="btn btn-light border rounded-pill fw-bold btn-sm text-primary"><i class="fas fa-comment me-1"></i> Send Clarification</a>
                        </div>
                    }
                </div>
            }
            else if (User.IsInRole("Retailer"))
            {
                <!-- Retailer: Procurement War Room -->
                var allBids = Model.Tender?.Bids?.OrderBy(b => b.ProposedTotalAmount).ToList() ?? new List<SCM_System.Models.Entities.TenderBid> { Model };
                var marketAvg = allBids.Any() ? allBids.Average(b => b.ProposedTotalAmount) : Model.ProposedTotalAmount;
                var variance = marketAvg > 0 ? ((Model.ProposedTotalAmount - marketAvg) / marketAvg) * 100 : 0;
                var varianceColor = variance > 0 ? "danger" : "success";
                
                <div class="card border-0 shadow-lg rounded-4 p-4 bg-glass border-top border-4 border-@(Model.Status == "Pending" || Model.Status == "RevisionRequested" ? "primary" : (Model.Status == "Accepted" ? "success" : "danger"))">
                    <h6 class="fw-bold text-dark mb-3">Procurement War Room</h6>
                    
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Market Avg Price:</span>
                            <span class="small fw-bold">@marketAvg.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="small text-muted">This Bid:</span>
                            <span class="small fw-bold text-@varianceColor">
                                @Model.ProposedTotalAmount.ToString("N0") 
                                (@(variance > 0 ? "+" : "")@variance.ToString("N1")%)
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Status:</span>
                            <span class="badge bg-@(Model.Status == "Pending" ? "warning" : Model.Status == "Accepted" ? "success" : "primary")-subtle text-dark rounded-pill px-2">@Model.Status</span>
                        </div>
                        @if (Model.Status == "RevisionRequested")
                        {
                             <div class="mt-2 p-2 bg-warning bg-opacity-10 border border-warning rounded small text-dark">
                                 <i class="fas fa-history me-1"></i> Revision Requested
                             </div>
                        }
                    </div>

                    @if((Model.Status == "Pending" || Model.Status == "RevisionRequested") && Model.Tender?.Status == "Published")
                    {
                        <form asp-action="Award" asp-controller="Tender" method="post" class="mb-2 d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tenderId" value="@Model.TenderId" />
                            <input type="hidden" name="bidId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2 shadow" onclick="return confirm('Award this contract? This cannot be undone.')">
                                <i class="fas fa-trophy me-2"></i> Award Supplier
                            </button>
                        </form>
                        
                        <div class="d-grid gap-2">
                            <a asp-controller="Message" asp-action="SendMessage" asp-route-receiverId="@Model.Supplier?.UserId" class="btn btn-outline-primary rounded-pill fw-bold py-2"><i class="fas fa-handshake me-1"></i> Negotiate Price</a>
                            
                            <button class="btn btn-outline-secondary rounded-pill fw-bold py-2 text-dark" data-bs-toggle="modal" data-bs-target="#revisionModal">
                                <i class="fas fa-undo me-1"></i> Request Revision
                            </button>
                            
                            <button class="btn btn-outline-danger btn-sm rounded-pill py-2 mt-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fas fa-times-circle me-1"></i> Reject Bid
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="bg-@(Model.Status == "Accepted" ? "success" : "danger")-subtle p-3 rounded-4 mb-3 d-inline-block">
                                <i class="fas fa-@(Model.Status == "Accepted" ? "check-circle" : "times-circle") text-@(Model.Status == "Accepted" ? "success" : "danger") fa-3x"></i>
                            </div>
                            <h4 class="fw-bold @(Model.Status == "Accepted" ? "text-success" : "text-danger") mb-0">Bid @Model.Status</h4>
                            @if(Model.Status == "Accepted") 
                            {
                                <p class="smaller text-muted mt-2">Contract awarded. PO has been formally generated.</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Revision Modal -->
<div class="modal fade" id="revisionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-undo me-2"></i>Request Revision</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestRevision" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body p-4">
                    <label class="form-label fw-bold">Revision Comments</label>
                    <textarea name="comments" class="form-control border-2" rows="4" placeholder="Explain what needs to be changed (e.g., lower price, faster delivery)..." required></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow">Send Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Bid Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-times-circle me-2"></i>Reject Proposal</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectBid" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Are you sure you want to reject this proposal? This action is permanent.</p>
                    <label class="form-label fw-bold">Rejection Reason</label>
                    <textarea name="reason" class="form-control border-2" rows="3" placeholder="Provide a brief reason for rejection..." required></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Go Back</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-glass { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.3); }
    .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.6px; }
    .bg-primary-subtle { background-color: #e8f1ff; }
    .bg-success-subtle { background-color: #e9f7ef; }
    .bg-info-subtle { background-color: #eafafb; }
    .bg-warning-subtle { background-color: #fef9e7; }
    .bg-danger-subtle { background-color: #fceae9; }
    .bg-secondary-subtle { background-color: #f8f9fa; }
    .rounded-4 { border-radius: 1rem !important; }
</style>
