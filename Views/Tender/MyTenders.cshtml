@model IEnumerable<SCM_System.Models.Entities.Tender>
@{
    ViewData["Title"] = "My Tenders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Tenders</h2>
        <a asp-action="Create" class="btn btn-success">Create New Tender</a>
    </div>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Reference</th>
                <th>Title</th>
                <th>Status</th>
                <th>Deadline</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var item in Model) {
            <tr>
                <td>@item.ReferenceNumber</td>
                <td>@item.Title</td>
                <td><span class="badge @(item.Status == "Open" ? "bg-primary" : "bg-secondary")">@item.Status</span></td>
                <td>@item.SubmissionDeadline.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-controller="Bid" asp-action="Review" asp-route-tenderId="@item.Id" class="btn btn-warning btn-sm">Review Bids</a>
                </td>
            </tr>
        }
        @if(!Model.Any()) {
            <tr><td colspan="5" class="text-center">You haven't created any tenders yet.</td></tr>
        }
        </tbody>
    </table>
</div>
