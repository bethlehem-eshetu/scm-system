@model IEnumerable<SCM_System.Models.Entities.Tender>
@{
    ViewData["Title"] = "Tender Management";
    Layout = "_DashboardLayout";
    
    var activeCount = Model.Count(t => t.Status == "Published" && t.SubmissionDeadline > DateTime.Now);
    var closedCount = Model.Count(t => t.Status == "Closed" || (t.Status == "Published" && t.SubmissionDeadline <= DateTime.Now));
    var awardedCount = Model.Count(t => t.Status == "Awarded");
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Tender Management</h2>
            <p class="text-muted mb-0">Monitor and award procurement contracts</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-plus me-2"></i> Create New Tender
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 text-white-50">
                        <i class="fas fa-bullhorn fa-2x"></i>
                        <span class="small fw-bold text-uppercase">Active Tenders</span>
                    </div>
                    <h2 class="fw-bold mb-0">@activeCount</h2>
                    <p class="mb-0 small opacity-75">Open for supplier bidding</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 text-warning">
                        <i class="fas fa-hourglass-end fa-2x"></i>
                        <span class="small fw-bold text-uppercase">Closed / Pending</span>
                    </div>
                    <h2 class="fw-bold mb-0">@closedCount</h2>
                    <p class="mb-0 small text-muted">Awaiting evaluation/award</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 text-success">
                        <i class="fas fa-trophy fa-2x"></i>
                        <span class="small fw-bold text-uppercase">Awarded Contracts</span>
                    </div>
                    <h2 class="fw-bold mb-0">@awardedCount</h2>
                    <p class="mb-0 small text-muted">Total contracts finalized</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tenders Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">Procurement List</h6>
            <div class="input-group input-group-sm w-auto">
                <input type="text" class="form-control" placeholder="Search reference...">
                <button class="btn btn-outline-secondary" type="button"><i class="fas fa-search"></i></button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 smaller text-muted text-uppercase">Reference & Title</th>
                        <th class="smaller text-muted text-uppercase">Status</th>
                        <th class="smaller text-muted text-uppercase">Deadline</th>
                        <th class="smaller text-muted text-uppercase">Bids Received</th>
                        <th class="text-end pe-4 smaller text-muted text-uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isClosingSoon = item.Status == "Published" && (item.SubmissionDeadline - DateTime.Now).TotalDays < 2;
                        var daysLeft = (item.SubmissionDeadline - DateTime.Now).Days;
                        var bidCount = item.Bids?.Count ?? 0;
                        var bestBid = item.Bids?.OrderBy(b => b.ProposedTotalAmount).FirstOrDefault();

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Title</div>
                                <div class="extra-small text-muted">@item.ReferenceNumber</div>
                            </td>
                            <td>
                                @{
                                    var (bg, txt) = item.Status switch {
                                        "Published" => ("bg-success-soft", "text-success"),
                                        "Closed" => ("bg-warning-soft", "text-warning"),
                                        "Awarded" => ("bg-primary-soft", "text-primary"),
                                        _ => ("bg-light", "text-muted")
                                    };
                                }
                                <span class="badge @bg @txt rounded-pill px-3">@item.Status</span>
                            </td>
                            <td>
                                <div class="@(isClosingSoon ? "text-danger fw-bold" : "text-dark")">
                                    <i class="far fa-clock me-1"></i> @item.SubmissionDeadline.ToString("MMM dd, yyyy")
                                </div>
                                @if (item.Status == "Published")
                                {
                                    <div class="extra-small @(isClosingSoon ? "text-danger" : "text-muted")">
                                        @(daysLeft > 0 ? $"{daysLeft} days left" : "Closing today")
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-light text-dark border me-2">@bidCount Bids</span>
                                    @if (bidCount > 0 && item.Status == "Published")
                                    {
                                        <span class="extra-small text-success fw-bold"><i class="fas fa-chart-line me-1"></i> Best: @bestBid?.ProposedTotalAmount.ToString("N0")</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm" title="View Details">
                                        <i class="fas fa-eye text-primary"></i>
                                    </a>
                                    <a asp-controller="Bid" asp-action="Review" asp-route-tenderId="@item.Id" class="btn btn-white btn-sm" title="Review Bids">
                                        <i class="fas fa-gavel text-warning"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="fas fa-folder-open fa-3x text-muted opacity-25 mb-3"></i>
                                <h6 class="text-muted">No tenders found in your records.</h6>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.5px; }
    .extra-small { font-size: 0.65rem; }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .btn-white { background: white; border: 1px solid #dee2e6; }
    .btn-white:hover { background: #f8f9fa; }
</style>
