@model SCM_System.Models.ViewModels.TenderCreateViewModel
@{
    ViewData["Title"] = "Create Tender";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <h2>Create New Tender</h2>
    <div class="card shadow-sm p-4 mt-3">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Title" class="form-label mb-1 fw-bold"></label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="CategoryId" class="form-label mb-1 fw-bold"></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required></select>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="SubmissionDeadline" class="form-label mb-1 fw-bold"></label>
                    <input asp-for="SubmissionDeadline" class="form-control" type="date" required />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="ExpectedDeliveryDate" class="form-label mb-1 fw-bold"></label>
                    <input asp-for="ExpectedDeliveryDate" class="form-control" type="date" required />
                </div>
                <div class="col-md-12 form-group mb-3">
                    <label asp-for="Description" class="form-label mb-1 fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
            </div>
            
            <h4 class="mt-4 mb-3 border-bottom pb-2">Requested Items</h4>
            <div class="row border p-3 bg-light rounded mb-3">
                <div class="col-md-3 form-group">
                    <label class="form-label fw-bold">Product Name</label>
                    <input asp-for="Items[0].ProductName" class="form-control" required />
                </div>
                <div class="col-md-3 form-group">
                    <label class="form-label fw-bold">Quantity</label>
                    <input asp-for="Items[0].Quantity" class="form-control" type="number" required />
                </div>
                <div class="col-md-3 form-group">
                    <label class="form-label fw-bold">Unit</label>
                    <input asp-for="Items[0].Unit" class="form-control" required />
                </div>
                <div class="col-md-3 form-group">
                    <label class="form-label fw-bold">Estimated Unit Price</label>
                    <input asp-for="Items[0].EstimatedUnitPrice" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-12 form-group mt-2">
                    <label class="form-label fw-bold">Item Description</label>
                    <input asp-for="Items[0].Description" class="form-control" />
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary px-4 mt-2">Create Tender</button>
            <a asp-action="Index" class="btn btn-secondary px-4 mt-2 ms-2">Cancel</a>
        </form>
    </div>
</div>
