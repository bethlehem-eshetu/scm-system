@model IEnumerable<SCM_System.Models.Entities.TenderBid>
@{
    ViewData["Title"] = "Bid Performance Dashboard";
    Layout = "_DashboardLayout";
    
    var totalBids = Model.Count();
    var wonBids = Model.Count(b => b.Status == "Accepted");
    var pendingBids = Model.Count(b => b.Status == "Pending");
    var lostBids = Model.Count(b => b.Status == "Rejected");
    var winRate = totalBids > 0 ? (wonBids * 100) / totalBids : 0;
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Procurement</a></li>
                    <li class="breadcrumb-item active">Performance Board</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1"><i class="fas fa-chart-line text-primary me-2"></i>Bid Performance Dashboard</h3>
            <p class="text-muted mb-0">Automated competitive tracking and proposal management</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tender" asp-action="AvailableTenders" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-search me-2"></i> Seek New Opportunities
            </a>
        </div>
    </div>

    <!-- Executive KPI Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Total Submissions</span>
                <h3 class="fw-bold text-dark mb-0">@totalBids</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center border-bottom border-success border-4">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Won Bids</span>
                <h3 class="fw-bold text-success mb-0">@wonBids</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center border-bottom border-warning border-4">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Pending Award</span>
                <h3 class="fw-bold text-warning mb-0">@pendingBids</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center border-bottom border-primary border-4">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Conversion Rate</span>
                <h3 class="fw-bold text-primary mb-0">@winRate%</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Board -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4">
                    <h6 class="fw-bold mb-0">Live Proposal Pipeline</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="smaller text-muted text-uppercase">
                                <th class="ps-4">Tender Reference / Context</th>
                                <th>Submission Details</th>
                                <th class="text-end">Proposal Value</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.Any())
                            {
                                foreach (var bid in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark mb-1">@bid.Tender?.Title</div>
                                            <div class="badge bg-secondary-subtle text-secondary px-2">@bid.Tender?.ReferenceNumber</div>
                                        </td>
                                        <td>
                                            <div class="small fw-bold">@bid.SubmittedAt.ToString("MM/dd/yyyy")</div>
                                            <div class="extra-small text-muted">Validity: @bid.ValidityPeriodDays Days</div>
                                        </td>
                                        <td class="text-end">
                                            <div class="fw-bold text-dark">@bid.ProposedTotalAmount.ToString("N0") ETB</div>
                                            <div class="extra-small text-muted">@bid.DeliveryLeadTimeDays Days SLA</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetBidStatusClass(bid.Status) rounded-pill px-3 shadow-sm border border-light">@bid.Status</span>
                                            @if (bid.Status == "RevisionRequested" && !string.IsNullOrEmpty(bid.Notes))
                                            {
                                                <div class="extra-small text-primary fw-bold mt-1" title="@bid.Notes">
                                                    <i class="fas fa-info-circle"></i> View Feedback
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="ReviewProposal" asp-route-id="@bid.Id" class="btn btn-light btn-sm rounded-circle shadow-sm border" title="View Diagnostics">
                                                <i class="fas fa-chevron-right text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">No proposals found. Start participating in the marketplace to see data here.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Smart Insights Panel -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white bg-dark mb-4 position-relative overflow-hidden">
                <!-- BG detail -->
                <i class="fas fa-lightbulb fa-5x position-absolute opacity-10" style="bottom: -20px; right: -10px;"></i>
                
                <h6 class="fw-bold text-uppercase text-white-50 smaller mb-4">Smart Insights</h6>
                
                @if(lostBids > wonBids)
                {
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-danger text-white rounded-pill me-2 px-2"><i class="fas fa-exclamation-triangle"></i></span>
                            <span class="fw-bold">Pricing Alert</span>
                        </div>
                        <p class="small text-white-50 mb-0">Your bids are frequently priced above the market average. Consider adjusting your SLA penalties or unit costs to boost conversion.</p>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-success text-white rounded-pill me-2 px-2"><i class="fas fa-check-circle"></i></span>
                            <span class="fw-bold">Competitive Edge</span>
                        </div>
                        <p class="small text-white-50 mb-0">Your proposal conversion rate is strong. Your current pricing strategy aligns well. Keep it up!</p>
                    </div>
                }

                <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-25 mt-2">
                    <span class="small d-block mb-1 text-white-50">Avg Competitor SLA Time</span>
                    <span class="fw-bold">~14 Days (<span class="text-success"><i class="fas fa-caret-down"></i> Faster than yours</span>)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBidStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Accepted" => "bg-success text-white",
            "Rejected" => "bg-danger text-white",
            "RevisionRequested" => "bg-primary text-white",
            _ => "bg-secondary text-white"
        };
    }
}

@section Styles {
    <style>
        .smaller { font-size: 0.725rem; font-weight: 700; letter-spacing: 0.5px; }
        .extra-small { font-size: 0.65rem; }
        .bg-secondary-subtle { background-color: #f8f9fa; }
    </style>
}
