@model IEnumerable<SCM_System.Models.Entities.Tender>
@{
    ViewData["Title"] = "Available Tenders";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3 bg-dark rounded-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Available Tenders</h2>
            <p class="text-secondary mb-0">Tenders matched to your business category</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-glass text-dark border-dark-10 rounded-pill px-3">
                <i class="fas fa-filter me-2"></i> Filter
            </button>
        </div>
    </div>

    <div class="card bg-glass border-0 text-dark shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead>
                        <tr class="text-secondary" style="font-size: 0.85rem; border-bottom: 1px solid rgba(0,0,0,0.1);">
                            <th class="ps-4 py-3">REFERENCE</th>
                            <th>TITLE</th>
                            <th>RETAILER</th>
                            <th>DEADLINE</th>
                            <th>DELIVERY</th>
                            <th class="text-end pe-4">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="border-bottom border-dark-05 hover-bg-light">
                                    <td class="ps-4">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">@item.ReferenceNumber</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <div class="text-secondary small text-truncate" style="max-width: 250px;">@item.Description</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-info-subtle text-info rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.7rem;">
                                                @(item.Retailer?.BusinessName?.Substring(0, 1) ?? "R")
                                            </div>
                                            <span class="small">@item.Retailer?.BusinessName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <i class="far fa-clock me-1 text-warning"></i>
                                            @item.SubmissionDeadline.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="text-secondary" style="font-size: 0.7rem;">@item.SubmissionDeadline.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <i class="fas fa-truck me-1 text-success"></i>
                                            @item.ExpectedDeliveryDate.ToString("MMM dd, yyyy")
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                <i class="fas fa-eye me-1"></i> Details
                                            </a>
                                            <a asp-controller="Bid" asp-action="Submit" asp-route-tenderId="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                                <i class="fas fa-gavel me-1"></i> Submit Bid
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="opacity-25 mb-3">
                                        <i class="fas fa-search fa-3x text-dark"></i>
                                    </div>
                                    <h5 class="text-secondary">No tenders available in your category.</h5>
                                    <p class="text-muted small">Check back later or update your business category profile.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-bg-dark:hover {
        background-color: rgba(255, 255, 255, 0.03) !important;
        transition: background-color 0.2s ease;
    }
</style>
