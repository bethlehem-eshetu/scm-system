@model IEnumerable<SCM_System.Models.Entities.Tender>
@{
    ViewData["Title"] = "Marketplace Opportunities";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold text-dark-green mb-1"><i class="fas fa-gavel me-2 text-accent-green"></i>Marketplace Tenders</h1>
            <p class="text-muted small mb-0 mt-1">Discover and bid on procurement contracts matched to your business specialization.</p>
        </div>
        <div class="d-flex gap-3">
            <button class="btn btn-white rounded-pill px-4 py-2 shadow-premium fw-bold d-flex align-items-center">
                <i class="fas fa-filter me-2 text-dark-green"></i> Smart Filter
            </button>
        </div>
    </div>

    <!-- Tenders Intelligence Pipeline -->
    <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-white">
        <div class="card-header bg-white py-4 px-5 border-0">
            <h5 class="fw-bold text-dark-green mb-0">Live Procurement Streams</h5>
        </div>
        <div class="table-responsive px-4 pb-4">
            <table class="table table-hover align-middle mb-0 custom-nexus-table">
                <thead>
                    <tr class="extra-small text-muted text-uppercase ls-1">
                        <th class="ps-4">Reference No.</th>
                        <th>Strategic Opportunity</th>
                        <th>Retailer Entity</th>
                        <th>Submission Deadline</th>
                        <th>Expected Delivery</th>
                        <th class="text-end pe-4">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-faint-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small border ls-1">@item.ReferenceNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark-green mb-1">@item.Title</div>
                                    <div class="text-muted extra-small text-truncate fw-bold" style="max-width: 280px;">@item.Description</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-dark-green text-accent-green rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 800;">
                                            @(item.Retailer?.BusinessName?.Substring(0, 1) ?? "R")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark-green small">@item.Retailer?.BusinessName</div>
                                            <div class="extra-small text-muted">Tier 1 Retailer</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark-green">
                                        <i class="far fa-clock me-1 text-warning"></i>
                                        @item.SubmissionDeadline.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="extra-small text-muted fw-bold">@item.SubmissionDeadline.ToString("HH:mm") GMT</div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark-green">
                                        <i class="fas fa-truck me-1 text-accent-green"></i>
                                        @item.ExpectedDeliveryDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-faint-green text-dark-green rounded-pill px-3 py-2 fw-bold extra-small shadow-sm">
                                            <i class="fas fa-eye me-1 opacity-50"></i> View Brief
                                        </a>
                                        <a asp-controller="Bid" asp-action="Submit" asp-route-tenderId="@item.Id" class="btn btn-dark-green rounded-pill px-4 py-2 fw-bold shadow-premium extra-small">
                                            <i class="fas fa-gavel me-2 text-accent-green"></i> Submit Proposal
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="bg-faint-green rounded-5 p-5 border-dashed-custom mx-4">
                                    <i class="fas fa-search fa-4x text-dark-green opacity-10 mb-4"></i>
                                    <h5 class="fw-bold text-dark-green">No Matched Tenders</h5>
                                    <p class="text-muted small mb-0">Update your business specialization to see more matched opportunities.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.7rem; }
        
        .custom-nexus-table thead th { border-bottom: none; padding: 20px 0; }
        .custom-nexus-table tbody td { padding: 24px 0; border-bottom: 1px solid rgba(0,0,0,0.02); }
        .custom-nexus-table tbody tr:last-child td { border-bottom: none; }

        .border-dashed-custom { border: 2px dashed rgba(26, 61, 49, 0.1); }

        .btn-white { background: white; border: none; color: var(--dark-green); }
        .btn-white:hover { background-color: var(--faint-green); }
        .btn-dark-green { background-color: var(--dark-green); color: white; border: none; }
        .btn-dark-green:hover { background-color: #244d3e; color: white; }
        .btn-faint-green { background-color: var(--faint-green); color: var(--dark-green); border: none; }

        .hover-lift { transition: all 0.3s ease; }
        .hover-lift:hover { transform: translateY(-5px); }
    </style>
}
