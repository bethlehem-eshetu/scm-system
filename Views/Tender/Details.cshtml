@model SCM_System.Models.Entities.Tender
@{
    ViewData["Title"] = "Tender Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Tenders</a></li>
                    <li class="breadcrumb-item active">@Model.ReferenceNumber</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center">
                <h2 class="fw-bold text-dark mb-0">Tender: @Model.Title</h2>
                <span class="badge ms-3 @(Model.Status == "Published" ? "bg-primary" : Model.Status == "Awarded" ? "bg-success" : "bg-secondary") rounded-pill px-3 shadow-sm">
                    @Model.Status
                </span>
            </div>
            <p class="text-muted mb-0">Issued by @Model.Retailer?.BusinessName • Category: @Model.Category?.CategoryName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-list me-2"></i> Back to List
            </a>
            @if (User.IsInRole("Retailer") && Model.Status == "Published")
            {
                <button type="button" class="btn btn-outline-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cancelTenderModal">
                    <i class="fas fa-times-circle me-2"></i> Cancel Tender
                </button>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Details & Items -->
        <div class="col-lg-8">
            <!-- General Info Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary"><i class="fas fa-info-circle me-2"></i> Tender Specifications</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Detailed Description</label>
                            <p class="text-dark mb-0 lead" style="white-space: pre-line;">@Model.Description</p>
                        </div>
                        
                        @if (User.IsInRole("Retailer") || User.IsInRole("Admin"))
                        {
                            <div class="col-md-4">
                                <label class="text-muted small text-uppercase fw-bold mb-1">Budget Range</label>
                                <p class="text-dark mb-0 fw-bold">
                                    <i class="fas fa-money-bill-wave me-1 text-success"></i> 
                                    @(Model.BudgetMin?.ToString("N0") ?? "0") - @(Model.BudgetMax?.ToString("N0") ?? "Unspecified") ETB
                                </p>
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Partial Bidding</label>
                            <p class="text-dark mb-0">
                                @if(Model.AllowPartialBids) {
                                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Allowed</span>
                                } else {
                                    <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i> Not Allowed</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Attachments</label>
                            <p class="text-dark mb-0">
                                @if(!string.IsNullOrEmpty(Model.AttachmentPath)) {
                                    <a href="/uploads/tenders/@System.IO.Path.GetFileName(Model.AttachmentPath)" class="btn btn-sm btn-link p-0 fw-bold" target="_blank">
                                        <i class="fas fa-file-pdf me-1 text-danger"></i> Specifications.pdf
                                    </a>
                                } else {
                                    <span class="text-muted small italic">No attachments</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Submission Deadline</label>
                            <p class="text-dark mb-0">
                                <i class="far fa-clock me-2 text-warning"></i> @Model.SubmissionDeadline.ToString("MMM dd, yyyy HH:mm")
                                @if (Model.SubmissionDeadline > DateTime.Now) {
                                    var daysLeft = (Model.SubmissionDeadline - DateTime.Now).Days;
                                    <span class="badge @(daysLeft < 3 ? "bg-danger" : "bg-warning text-dark") ms-2"><i class="fas fa-hourglass-half me-1"></i> @daysLeft days left</span>
                                } else {
                                    <span class="badge bg-danger ms-2">Expired</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Expected Delivery</label>
                            <p class="text-dark mb-0"><i class="fas fa-truck me-2 text-primary"></i> @Model.ExpectedDeliveryDate.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1">Preferred Language</label>
                            <p class="text-dark mb-0">@Model.Language</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requested Items Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-success"><i class="fas fa-box-open me-2"></i> Line Items Requested</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-4 py-3">Product Name</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    @if (User.IsInRole("Retailer") || User.IsInRole("Admin"))
                                    {
                                        <th>Ref. Price</th>
                                    }
                                    <th class="pe-4">Specifications</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(Model.TenderItems != null)
                                {
                                    foreach(var item in Model.TenderItems) {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@item.ProductName</div>
                                                @if(item.ProductId.HasValue) {
                                                    <span class="badge bg-info bg-opacity-10 text-info small border-0">Catalog Match</span>
                                                } else {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary small border-0">Custom Description</span>
                                                }
                                            </td>
                                            <td class="fw-bold">@item.Quantity</td>
                                            <td><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                            @if (User.IsInRole("Retailer") || User.IsInRole("Admin"))
                                            {
                                                <td class="text-primary fw-bold">@(item.EstimatedUnitPrice?.ToString("N2") ?? "---") ETB</td>
                                            }
                                            <td class="pe-4">
                                                <p class="small text-muted mb-0" style="max-width: 250px;">@(string.IsNullOrEmpty(item.Specifications) ? item.Description : item.Specifications)</p>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bids Section -->
            @if (Model.BudgetMax.HasValue && Model.Bids != null && Model.Bids.Any(b => b.Status != "Rejected") && Model.Bids.Where(b => b.Status != "Rejected").All(b => b.ProposedTotalAmount > Model.BudgetMax.Value))
            {
                <div class="alert alert-danger shadow-sm rounded-4 mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i> <strong>Over Budget Alert:</strong> All active bids exceed your target budget range.
                </div>
            }
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-warning"><i class="fas fa-hand-holding-usd me-2"></i> Received Proposals</h5>
                    <span class="badge bg-dark rounded-pill">@(Model.Bids?.Count ?? 0) Submissions</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-4">Rank</th>
                                    <th>Supplier</th>
                                    <th>Proposed Total</th>
                                    <th>Variance</th>
                                    <th>Lead Time</th>
                                    <th>Score</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var rankedBids = Model.Bids?.Select(bid => {
                                        var pScore = Model.BudgetMax.HasValue && Model.BudgetMax > 0 ? Math.Max(0, 100 - ((double)Math.Max(0, bid.ProposedTotalAmount - Model.BudgetMax.Value) / (double)Model.BudgetMax.Value * 100)) : 100;
                                        var leadTimeScore = bid.DeliveryLeadTimeDays <= 30 ? (30 - bid.DeliveryLeadTimeDays) / 30.0 * 100.0 : 0;
                                        var rScore = 100.0; // Simulated rating
                                        return new { Bid = bid, Score = (pScore * 0.4) + (leadTimeScore * 0.4) + (rScore * 0.2) };
                                    }).OrderByDescending(b => b.Score).ToList();
                                }
                                @if(rankedBids != null && rankedBids.Any())
                                {
                                    int currentRank = 1;
                                    foreach(var item in rankedBids) {
                                        var bid = item.Bid;
                                        <tr class="@(bid.IsWinningBid ? "bg-success bg-opacity-10" : "")">
                                            <td class="ps-4 fs-4">
                                                @(currentRank == 1 ? "🥇" : currentRank == 2 ? "🥈" : currentRank == 3 ? "🥉" : "#" + currentRank)
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@bid.Supplier?.CompanyName</div>
                                                <div class="text-muted small">Submitted: @bid.SubmittedAt.ToString("MMM dd, yyyy")</div>
                                            </td>
                                            <td class="fw-bold text-success">
                                                @bid.ProposedTotalAmount.ToString("N2") ETB
                                                @if (Model.BudgetMax.HasValue && bid.ProposedTotalAmount > Model.BudgetMax.Value)
                                                {
                                                    <div class="mt-1"><span class="badge bg-danger"><i class="fas fa-exclamation-triangle"></i> Over Budget</span></div>
                                                }
                                            </td>
                                            <td class="fw-bold @(Model.BudgetMax.HasValue && bid.ProposedTotalAmount > Model.BudgetMax.Value ? "text-danger" : "text-success")">
                                                @(Model.BudgetMax.HasValue ? ((bid.ProposedTotalAmount - Model.BudgetMax.Value) / Model.BudgetMax.Value * 100).ToString("+0.0;-0.0") + "%" : "N/A")
                                            </td>
                                            <td class="fw-medium">@bid.DeliveryLeadTimeDays Days</td>
                                            <td>
                                                <span class="badge bg-primary rounded-pill">@(item.Score.ToString("F1"))%</span>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill" style="background-color: @(bid.Status == "Pending" ? "#f59e0b" : bid.Status == "Reviewed" ? "#3b82f6" : bid.Status == "Awarded" || bid.Status == "Accepted" ? "#10b981" : "#ef4444"); color: white;">
                                                    @bid.Status
                                                </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex gap-2 justify-content-end">
                                                    <a asp-action="ReviewProposal" asp-route-id="@bid.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        <i class="fas fa-file-alt me-1"></i> Review
                                                    </a>
                                                    @if (User.IsInRole("Retailer") && Model.Status == "Published")
                                                    {
                                                        <form asp-action="Award" asp-controller="Tender" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="tenderId" value="@Model.Id" />
                                                            <input type="hidden" name="bidId" value="@bid.Id" />
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" onclick="return confirm('Are you sure you want to award this tender to @bid.Supplier?.CompanyName?')">
                                                                <i class="fas fa-award me-1"></i> Award
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        currentRank++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                                                <p class="mb-0">No active proposals found for this tender.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Logistics & Evaluation -->
        <div class="col-lg-4">
            <!-- Commercial Terms Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark"><i class="fas fa-balance-scale me-2"></i> Commercial Terms</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Delivery Location</label>
                        <p class="text-dark fw-bold mb-0"><i class="fas fa-map-marker-alt text-danger me-2"></i>@Model.DeliveryLocation</p>
                    </div>
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Payment Strategy</label>
                        <p class="text-dark mb-0">@Model.PaymentTerms</p>
                    </div>
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Packaging Policy</label>
                        <p class="text-dark mb-0">@Model.PackagingRequirements</p>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Quality Inspection</label>
                        <p class="text-dark mb-0">@Model.InspectionRequirement</p>
                    </div>
                </div>
            </div>

            <!-- Evaluation Criteria Card -->
            <div class="card border-0 shadow-sm rounded-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark"><i class="fas fa-tasks me-2"></i> Evaluation Weights</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small fw-bold">Commercial (Price)</span>
                            <span class="badge bg-success">@Model.PriceWeight%</span>
                        </div>
                        <div class="progress rounded-pill shadow-sm" style="height: 10px;">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: @Model.PriceWeight%;"></div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small fw-bold">Technical Compliance</span>
                            <span class="badge bg-primary">@Model.TechnicalWeight%</span>
                        </div>
                        <div class="progress rounded-pill shadow-sm" style="height: 10px;">
                            <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: @Model.TechnicalWeight%;"></div>
                        </div>
                    </div>
                    <div class="mb-0">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small fw-bold">Lead Time & Logistics</span>
                            <span class="badge bg-info">@Model.DeliveryWeight%</span>
                        </div>
                        <div class="progress rounded-pill shadow-sm" style="height: 10px;">
                            <div class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: @Model.DeliveryWeight%;"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            @if(Model.Status == "Awarded")
            {
                <div class="alert alert-success mt-4 border-0 rounded-4 shadow-sm p-4">
                    <h6 class="fw-bold"><i class="fas fa-check-circle me-2"></i> Award Concluded</h6>
                    <p class="small mb-0">This tender was awarded. A Purchase Order has been generated and the fulfillment process has started.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Cancel Tender Modal -->
<div class="modal fade" id="cancelTenderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Cancel Tender</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-0 fs-5">Are you sure? This will reject all bids and close the tender.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Go Back</button>
                <form asp-action="CancelTender" asp-controller="Tender" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirm Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
