@model SCM_System.Models.Entities.Tender
@{
    ViewData["Title"] = "Tender Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tender: @Model.ReferenceNumber</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
    
    <div class="card shadow-sm p-4 mb-4">
        <h4 class="border-bottom pb-2 mb-3">General Information</h4>
        <div class="row">
            <div class="col-md-6 mb-2"><strong>Title:</strong> @Model.Title</div>
            <div class="col-md-6 mb-2"><strong>Status:</strong> <span class="badge @(Model.Status == "Open" ? "bg-primary" : "bg-secondary")">@Model.Status</span></div>
            <div class="col-md-6 mb-2"><strong>Category:</strong> @Model.Category?.CategoryName</div>
            <div class="col-md-6 mb-2"><strong>Retailer:</strong> @Model.Retailer?.BusinessName</div>
            <div class="col-md-6 mb-2"><strong>Submission Deadline:</strong> @Model.SubmissionDeadline.ToString("MMM dd, yyyy")</div>
            <div class="col-md-6 mb-2"><strong>Expected Delivery:</strong> @Model.ExpectedDeliveryDate.ToString("MMM dd, yyyy")</div>
            <div class="col-md-12 mt-2"><strong>Description:</strong> <p>@Model.Description</p></div>
        </div>
    </div>

    <div class="card shadow-sm p-4">
        <h4 class="border-bottom pb-2 mb-3">Requested Items</h4>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th>Estimated Price</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.TenderItems != null)
                    {
                        foreach(var item in Model.TenderItems) {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Description</td>
                                <td>@item.Quantity</td>
                                <td>@item.Unit</td>
                                <td>@(item.EstimatedUnitPrice?.ToString("C") ?? "N/A")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
