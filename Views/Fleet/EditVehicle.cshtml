@model SCM_System.Models.Entities.Vehicle
@{
    ViewData["Title"] = "Update Asset Configuration";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Vehicles">Fleet Management</a></li>
                    <li class="breadcrumb-item active">Configure Asset</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-primary mb-0"><i class="fas fa-edit me-2"></i>Configure Asset</h2>
        </div>
        <a asp-action="Vehicles" class="btn btn-outline-secondary rounded-pill px-4 border shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Back to Fleet
        </a>
    </div>

    <form asp-controller="Fleet" asp-action="EditVehicle" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SupplierId" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="All" class="alert alert-danger rounded-4 border-0 shadow-sm mb-4"></div>

        <div class="row g-4">
            <!-- Left: Technical Specs -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white p-4 border-bottom-0">
                        <h5 class="fw-bold mb-0"><i class="fas fa-cogs me-2 text-primary"></i>Technical Specifications</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="LicensePlate" class="form-label text-muted small fw-bold text-uppercase">License Plate <span class="text-danger">*</span></label>
                                <input asp-for="LicensePlate" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" required>
                                <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssetCode" class="form-label text-muted small fw-bold text-uppercase">Asset Code</label>
                                <input asp-for="AssetCode" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" readonly>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VehicleType" class="form-label text-muted small fw-bold text-uppercase">Vehicle Type</label>
                                <select asp-for="VehicleType" class="form-select border-0 bg-light p-3 rounded-3 shadow-none" asp-items="Html.GetEnumSelectList<SCM_System.Models.Enums.VehicleType>()"></select>
                                <span asp-validation-for="VehicleType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Brand" class="form-label text-muted small fw-bold text-uppercase">Brand <span class="text-danger">*</span></label>
                                <input asp-for="Brand" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Model" class="form-label text-muted small fw-bold text-uppercase">Model <span class="text-danger">*</span></label>
                                <input asp-for="Model" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="ManufactureYear" class="form-label text-muted small fw-bold text-uppercase">Year</label>
                                <input asp-for="ManufactureYear" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="number" min="1990" max="@DateTime.Now.Year">
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Color" class="form-label text-muted small fw-bold text-uppercase">Color</label>
                                <input asp-for="Color" class="form-control p-3 bg-light border-0 rounded-3 shadow-none">
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxLoadCapacity" class="form-label text-muted small fw-bold text-uppercase">Max Load Capacity</label>
                                <div class="input-group">
                                    <input asp-for="MaxLoadCapacity" class="form-control p-3 bg-light border-0 rounded-start shadow-none" type="number" step="0.01" min="1" required>
                                    <span class="input-group-text bg-light border-0 text-muted small">KG</span>
                                </div>
                                <span asp-validation-for="MaxLoadCapacity" class="text-danger small"></span>
                            </div>
                             <div class="col-md-4">
                                <label asp-for="InternalVolumeM3" class="form-label text-muted small fw-bold text-uppercase">Internal Volume</label>
                                <div class="input-group">
                                    <input asp-for="InternalVolumeM3" class="form-control p-3 bg-light border-0 rounded-start shadow-none" type="number" step="0.1">
                                    <span class="input-group-text bg-light border-0 text-muted small">M³</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FuelType" class="form-label text-muted small fw-bold text-uppercase">Fuel Type</label>
                                <select asp-for="FuelType" class="form-select border-0 bg-light p-3 rounded-3 shadow-none">
                                    <option value="Diesel">Diesel</option>
                                    <option value="Petrol">Petrol</option>
                                    <option value="Electric">Electric</option>
                                    <option value="Hybrid">Hybrid</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FuelTankCapacity" class="form-label text-muted small fw-bold text-uppercase">Tank Capacity</label>
                                <div class="input-group">
                                    <input asp-for="FuelTankCapacity" class="form-control p-3 bg-light border-0 rounded-start shadow-none" type="number" step="0.1">
                                    <span class="input-group-text bg-light border-0 text-muted small">Liters</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Mileage" class="form-label text-muted small fw-bold text-uppercase">Current Mileage</label>
                                <input asp-for="Mileage" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="number" step="0.1">
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FuelEfficiency" class="form-label text-muted small fw-bold text-uppercase">Efficiency (L/100km)</label>
                                <input asp-for="FuelEfficiency" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="number" step="0.1">
                            </div>
                            <div class="col-md-12">
                                <div class="p-3 bg-light rounded-4 d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <div class="fw-bold small text-dark text-uppercase">GPS Tracking Installed</div>
                                        <div class="extra-small text-muted">Active sensors and connectivity status</div>
                                    </div>
                                    <div class="form-check form-switch fs-4">
                                        <input asp-for="GPSInstalled" class="form-check-input" type="checkbox" role="switch">
                                    </div>
                                </div>
                                <div class="p-3 bg-light rounded-4 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-bold small text-dark text-uppercase">Temperature Controlled Environment</div>
                                        <div class="extra-small text-muted">Active sensors and thermal insulation status</div>
                                    </div>
                                    <div class="form-check form-switch fs-4">
                                        <input asp-for="TemperatureControlled" class="form-check-input" type="checkbox" role="switch">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Operational Setup -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white p-4 border-bottom-0">
                        <h5 class="fw-bold mb-0"><i class="fas fa-clipboard-check me-2 text-primary"></i>Operational Insights</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label text-muted small fw-bold text-uppercase">Asset Lifecycle Status</label>
                            <select asp-for="Status" class="form-select border-0 bg-light p-3 rounded-3 shadow-none" asp-items="Html.GetEnumSelectList<SCM_System.Models.Enums.VehicleStatus>()"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DriverEligibilityType" class="form-label text-muted small fw-bold text-uppercase">Driver License Requirement</label>
                            <select asp-for="DriverEligibilityType" class="form-select border-0 bg-light p-3 rounded-3 shadow-none">
                                <option value="Class A">Class A (Motorcycle)</option>
                                <option value="Class B">Class B (Automobile)</option>
                                <option value="Heavy Duty">Heavy Duty (Trucks)</option>
                                <option value="Public Transport">Public Transport</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="WarehouseId" class="form-label text-muted small fw-bold text-uppercase">Home Hub / Station</label>
                            <select asp-for="WarehouseId" class="form-select border-0 bg-light p-3 rounded-3 shadow-none" asp-items="ViewBag.Warehouses">
                                <option value="">-- Unassigned / In Transit --</option>
                            </select>
                            <div class="extra-small text-muted mt-1">Changing the hub will update availability for local dispatchers.</div>
                        </div>
                        
                        <div class="row g-3 mt-1 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Update Registration</label>
                                <input name="registrationDoc" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="file" accept="image/*,application/pdf">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Update Insurance</label>
                                <input name="insuranceDoc" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="file" accept="image/*,application/pdf">
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="LastServiceDate" class="form-label text-muted small fw-bold text-uppercase">Last Service</label>
                                <input asp-for="LastServiceDate" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="date">
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NextServiceDueDate" class="form-label text-muted small fw-bold text-uppercase">Next Service</label>
                                <input asp-for="NextServiceDueDate" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="date">
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RegistrationExpiryDate" class="form-label text-muted small fw-bold text-uppercase">Registration Expiry</label>
                                <input asp-for="RegistrationExpiryDate" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="date">
                            </div>

                            <div class="col-12 py-2 border-bottom mt-2">
                                <h6 class="fw-bold mb-0 small text-uppercase text-primary">Financial & Registry</h6>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PurchaseDate" class="form-label text-muted small fw-bold text-uppercase">Purchase Date</label>
                                <input asp-for="PurchaseDate" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="date">
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PurchaseCost" class="form-label text-muted small fw-bold text-uppercase">Purchase Cost (ETB)</label>
                                <input asp-for="PurchaseCost" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" type="number" step="0.01">
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InsuranceProvider" class="form-label text-muted small fw-bold text-uppercase">Insurance Provider</label>
                                <input asp-for="InsuranceProvider" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" placeholder="e.g. Nyala Insurance">
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FuelCardNumber" class="form-label text-muted small fw-bold text-uppercase">Fuel Card #</label>
                                <input asp-for="FuelCardNumber" class="form-control p-3 bg-light border-0 rounded-3 shadow-none" placeholder="XXXX-XXXX-XXXX">
                            </div>
                        </div>

                        <div class="mt-4 p-4 bg-light rounded-4 border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-muted">Fleet Metadata</span>
                                <span class="badge bg-white text-dark border extra-small">Asset ID: @Model.Id</span>
                            </div>
                            <div class="small text-muted mb-1">Registration Date: @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                            <div class="small text-muted">Protocol: IoT Connectivity Active</div>
                        </div>

                        <div class="mt-5 pt-3">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-lg">
                                <i class="fas fa-save me-2"></i> Update Asset Profile
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.05);
        border: 1px solid rgba(13, 110, 253, 0.2) !important;
    }
</style>

@section Scripts {
    @* Temporarily disabled client-side validation to debug server-side reachability *@
    @* <partial name="_ValidationScriptsPartial" /> *@
}
