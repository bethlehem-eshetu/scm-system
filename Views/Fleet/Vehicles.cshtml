@model IEnumerable<SCM_System.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Fleet Management";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3 px-3 fleet-management-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-1"><i class="fas fa-truck me-2"></i>Fleet Management</h4>
            <p class="text-muted small mb-0">Manage delivery assets, maintenance cycles, and load capacities</p>
        </div>
        <a asp-action="CreateVehicle" class="btn btn-primary rounded-pill px-3 py-2 fw-bold shadow-sm small">
            <i class="fas fa-plus me-2"></i> Register New Vehicle
        </a>
    </div>

    <!-- Filters & Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-premium rounded-5 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="vehicleSearch" class="form-control border-0 bg-transparent" placeholder="Search by license plate or vehicle type...">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="row g-2">
                <div class="col-6">
                    <div class="card border-0 shadow-premium rounded-5 bg-success text-white">
                        <div class="card-body p-3 text-center">
                            <div class="small opacity-75 fw-bold">Available Fleets</div>
                            <h4 class="fw-bold mb-0">@Model.Count(v => v.Status == SCM_System.Models.Enums.VehicleStatus.Available)</h4>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-premium rounded-5 bg-warning text-dark">
                        <div class="card-body p-3 text-center">
                            <div class="small opacity-75 fw-bold font-weight-bold">In Transit</div>
                            <h4 class="fw-bold mb-0">@Model.Count(v => v.Status == SCM_System.Models.Enums.VehicleStatus.InUse)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vehicle Grid -->
    <div class="row g-3" id="vehicleGrid">
        @foreach (var vehicle in Model)
        {
            <div class="col-xl-4 col-md-6 vehicle-card" data-plate="@vehicle.LicensePlate?.ToLower()" data-type="@vehicle.VehicleType.ToString().ToLower()">
                <div class="card h-100 border-0 shadow-premium rounded-5 overflow-hidden hover-lift card-fleet">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="avatar-lg bg-info bg-opacity-10 text-info rounded-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fas fa-truck-moving fs-4"></i>
                            </div>
                            <div class="text-end">
                                @{
                                    var statusClass = vehicle.Status switch {
                                        SCM_System.Models.Enums.VehicleStatus.Available => "bg-success",
                                        SCM_System.Models.Enums.VehicleStatus.InUse => "bg-warning text-dark",
                                        _ => "bg-danger"
                                    };
                                }
                                <span class="badge @statusClass rounded-pill px-3 py-2 mb-2">
                                    <i class="fas fa-circle fs-xs me-1"></i> @vehicle.Status
                                </span>
                                <div class="text-muted small fw-bold">@vehicle.VehicleType</div>
                            </div>
                        </div>

                        <h4 class="fw-bold mb-1">@vehicle.LicensePlate</h4>
                        <div class="mb-4">
                            <span class="badge bg-light text-dark rounded-pill border small">
                                <i class="fas fa-warehouse me-1 text-primary"></i> 
                                @(vehicle.Warehouse?.Name ?? "No Hub Linked")
                            </span>
                        </div>

                        <div class="specification-grid mb-4">
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded-3 text-center">
                                        <div class="extra-small text-muted fw-bold">Utility</div>
                                        <div class="fw-bold text-dark small">@vehicle.MaxLoadCapacity kg</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded-3 text-center">
                                        <div class="extra-small text-muted fw-bold">Mileage</div>
                                        <div class="fw-bold text-dark small">@(vehicle.CurrentMileage ?? 0) km</div>
                                    </div>
                                </div>
                            </div>
                            
                            @{
                                var driverAssignment = vehicle.Assignments?.FirstOrDefault(a => a.IsActive && a.IsPrimary);
                                var driverName = driverAssignment?.SupplierEmployee?.User?.FullName;
                                var maintenanceUrgent = vehicle.NextServiceDueDate.HasValue && (vehicle.NextServiceDueDate.Value - DateTime.Now).TotalDays < 30;
                                var insuranceExpired = vehicle.InsuranceExpiryDate.HasValue && vehicle.InsuranceExpiryDate.Value < DateTime.Now;
                            }
                            
                            <div class="row g-2 mt-1">
                                <div class="col-12">
                                    <div class="p-2 bg-light rounded-3 d-flex justify-content-between align-items-center">
                                        <div class="extra-small text-muted fw-bold">Operator</div>
                                        <div class="fw-bold small @(string.IsNullOrEmpty(driverName) ? "text-warning" : "text-primary")">
                                            <i class="fas fa-user-circle me-1"></i> @(string.IsNullOrEmpty(driverName) ? "Unassigned" : driverName)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row g-2 mt-1">
                                <div class="col-12">
                                    <div class="p-2 bg-@(maintenanceUrgent ? "warning" : "light") bg-opacity-25 rounded-3 d-flex justify-content-between align-items-center">
                                        <div class="extra-small text-muted fw-bold">Service</div>
                                        <div class="fw-bold small @(maintenanceUrgent ? "text-danger" : "text-dark")">
                                            <i class="fas fa-wrench me-1"></i> @(vehicle.NextServiceDueDate?.ToString("MMM dd, yyyy") ?? "Pending")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2 mt-1">
                                <div class="col-12">
                                    <div class="p-2 bg-@(insuranceExpired ? "danger" : "light") bg-opacity-10 rounded-3 d-flex justify-content-between align-items-center">
                                        <div class="extra-small text-muted fw-bold">Insurance</div>
                                        <div class="fw-bold small @(insuranceExpired ? "text-danger" : "text-success")">
                                            <i class="fas fa-shield-alt me-1"></i> @(vehicle.InsuranceExpiryDate?.ToString("MMM dd, yyyy") ?? "Missing")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top mt-auto">
                            <a asp-action="EditVehicle" asp-route-id="@vehicle.Id" class="btn btn-primary flex-grow-1 rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-sliders-h me-2"></i> Configure
                            </a>
                            <form asp-action="DeleteVehicle" asp-route-id="@vehicle.Id" method="post" onsubmit="return confirm('Wipe vehicle from fleet record?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-icon-only rounded-circle" style="width: 44px; height: 44px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 bg-white shadow-sm rounded-4 d-inline-block">
                <i class="fas fa-truck-pickup fa-4x text-muted opacity-25 mb-4 d-block"></i>
                <h4 class="fw-bold">Empty Fleet</h4>
                <p class="text-muted mb-4">You haven't registered any vehicles yet. Fleet assets are required for delivery agents.</p>
                <a asp-action="CreateVehicle" class="btn btn-primary rounded-pill px-5 fw-bold">Register Initial Fleet</a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
    .fleet-management-container {
        zoom: 0.92;
        max-width: 1450px;
        margin: auto;
    }

    .vehicle-card {
        transition: all 0.3s ease;
    }
</style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#vehicleSearch').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#vehicleGrid .vehicle-card').filter(function() {
                    var text = $(this).data('plate') + " " + $(this).data('type');
                    $(this).toggle(text.indexOf(value) > -1);
                });
            });
        });
    </script>
}
