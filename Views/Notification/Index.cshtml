@model List<SCM_System.Models.Entities.Notification>

@{
    ViewData["Title"] = "Intelligence Feed - SCM";
    Layout = "_DashboardLayout";
    string userRole = ViewBag.UserRole ?? "User";
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-5 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="text-white mb-1 fw-bold"><i class="fas fa-broadcast-tower text-accent-green me-3"></i>Intelligence Feed</h2>
                            <p class="text-white-50 mb-0 opacity-75">Real-time platform signals, transaction alerts, and system updates.</p>
                        </div>
                        <div class="d-flex gap-3">
                            @if (Model.Any(n => !n.IsRead))
                            {
                                <button type="button" class="btn btn-accent-green text-dark-green rounded-pill px-4 py-2 shadow-sm fw-bold border-0" id="markAllReadBtn">
                                    <i class="fas fa-check-double me-2"></i> Clear All Unread
                                </button>
                            }
                            <a asp-action="Dashboard" asp-controller="@(userRole == "Supplier" ? "Supplier" : userRole == "WarehouseManager" ? "Warehouse" : userRole == "Admin" ? "Admin" : "Retailer")"
                               class="btn btn-white bg-opacity-10 text-white border-0 rounded-pill px-4 py-2 shadow-sm fw-bold">
                                <i class="fas fa-arrow-left me-2"></i> Back to Command Center
                            </a>
                        </div>
                    </div>
                    <!-- Subtle background decoration -->
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-bell fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtration & Controls -->
    <div class="row mb-4">
        <div class="col-xl-8 mx-auto">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white p-3 rounded-pill shadow-sm border px-4">
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted small fw-bold me-2 ls-1 uppercase">Filter Signals:</span>
                    <button class="btn btn-dark-green btn-sm rounded-pill px-3 fw-bold filter-btn active" data-filter="all">All</button>
                    <button class="btn btn-soft-success btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Success">Success</button>
                    <button class="btn btn-soft-warning btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Warning">Warnings</button>
                    <button class="btn btn-soft-danger btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Error">Errors</button>
                    <button class="btn btn-soft-info btn-sm rounded-pill px-3 fw-bold filter-btn" data-filter="Info">System</button>
                </div>
                <div class="search-mini position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted extra-small"></i>
                    <input type="text" id="notifSearch" class="form-control form-control-sm border-0 bg-faint-green rounded-pill ps-5" placeholder="Search signals..." style="width: 200px;">
                </div>
            </div>
        </div>
    </div>

    <!-- Main Feed -->
    <div class="row g-4">
        <div class="col-xl-8 mx-auto">
            <div class="card border-0 shadow-premium rounded-5 bg-white overflow-hidden">
                <div class="card-header bg-faint-green py-4 px-5 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark-green"><i class="fas fa-history text-accent-green me-2"></i>Signal History</h5>
                    <div class="d-flex align-items-center gap-3">
                        @if (ViewBag.UnreadCount > 0)
                        {
                            <span class="badge bg-dark-green text-accent-green rounded-pill px-3 py-2 extra-small ls-1 uppercase fw-bold" id="unreadCounter">@ViewBag.UnreadCount Pending</span>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 my-5">
                            <div class="bg-faint-green text-dark-green rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                                <i class="fas fa-bell-slash fa-3x opacity-25"></i>
                            </div>
                            <h4 class="fw-bold text-dark-green">Zero Signals Detected</h4>
                            <p class="text-muted small fw-bold opacity-50">Your intelligence feed is currently synchronized.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border-0" id="notificationsList">
                            @foreach (var notification in Model)
                            {
                                <div class="list-group-item px-5 py-4 border-faint transition-all notification-item @(!notification.IsRead ? "bg-signal-unread" : "")" data-id="@notification.Id" data-type="@notification.Type">
                                    <div class="d-flex justify-content-between align-items-start gap-4">
                                        <div class="d-flex align-items-start gap-3 flex-grow-1">
                                            <div class="signal-icon rounded-4 d-flex align-items-center justify-content-center flex-shrink-0 @(notification.Type == "Success" ? "bg-soft-success text-success" : notification.Type == "Error" ? "bg-soft-danger text-danger" : notification.Type == "Warning" ? "bg-soft-warning text-warning" : "bg-soft-info text-info")" style="width: 48px; height: 48px;">
                                                @if (notification.Type == "Success") { <i class="fas fa-check-circle"></i> }
                                                else if (notification.Type == "Error") { <i class="fas fa-exclamation-circle"></i> }
                                                else if (notification.Type == "Warning") { <i class="fas fa-exclamation-triangle"></i> }
                                                else { <i class="fas fa-info-circle"></i> }
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <h6 class="fw-bold text-dark-green mb-0">@notification.Title</h6>
                                                    @if (!notification.IsRead)
                                                    {
                                                        <span class="signal-dot bg-accent-green"></span>
                                                    }
                                                </div>
                                                <p class="text-muted small fw-bold mb-2 opacity-75">@notification.Message</p>
                                                <div class="d-flex align-items-center gap-3">
                                                    <span class="extra-small text-muted fw-bold text-uppercase ls-1"><i class="far fa-clock me-1"></i>@GetTimeAgo(notification.CreatedAt)</span>
                                                    @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                                    {
                                                        <a href="@notification.ActionUrl" class="extra-small text-dark-green fw-bold text-decoration-none hover-underline">
                                                            EXECUTE ACTION <i class="fas fa-external-link-alt ms-1"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (!notification.IsRead)
                                            {
                                                <button class="btn btn-faint-green btn-sm rounded-pill px-3 fw-bold extra-small text-dark-green mark-read-btn" data-id="@notification.Id">
                                                    MARK READ
                                                </button>
                                            }
                                            <button class="btn btn-soft-danger btn-sm rounded-circle p-2 delete-btn" data-id="@notification.Id" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-trash-alt extra-small"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd");
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #d4f06d;
            --faint-green: #f2f6f6;
        }

        .text-dark-green { color: var(--dark-green) !important; }
        .bg-dark-green { background-color: var(--dark-green) !important; }
        .bg-faint-green { background-color: var(--faint-green) !important; }
        .bg-accent-green { background-color: var(--accent-green) !important; }
        .text-accent-green { color: var(--accent-green) !important; }
        .btn-accent-green { background-color: var(--accent-green); color: var(--dark-green); }
        .btn-accent-green:hover { background-color: #c4e05d; transform: translateY(-2px); }

        .rounded-5 { border-radius: 24px !important; }
        .shadow-premium { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important; }
        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.65rem; }
        .uppercase { text-transform: uppercase; }
        .transition-all { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

        .border-faint { border-color: rgba(0,0,0,0.03) !important; }
        .notification-item:hover { background-color: var(--faint-green); }
        .bg-signal-unread { background-color: rgba(212, 240, 109, 0.03); }

        .signal-icon { font-size: 1.2rem; }
        .bg-soft-success { background-color: rgba(25, 135, 84, 0.05); color: #198754; }
        .bg-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; }
        .bg-soft-warning { background-color: rgba(255, 193, 7, 0.05); color: #ffc107; }
        .bg-soft-info { background-color: rgba(13, 202, 240, 0.05); color: #0dcaf0; }
        .btn-soft-danger { background-color: rgba(220, 53, 69, 0.05); color: #dc3545; border: none; }
        .btn-soft-danger:hover { background-color: #dc3545; color: white; }

        .signal-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .fa-spin-slow { animation: fa-spin 15s infinite linear; }
        .btn-faint-green { background-color: var(--faint-green); border: none; }
        .btn-faint-green:hover { background-color: #e2e6e6; }
        
        .hover-underline:hover { text-decoration: underline !important; }
    </style>
}

@section Scripts {
    <script>
        // Filtration Logic
        $('.filter-btn').click(function() {
            var filter = $(this).data('filter');
            $('.filter-btn').removeClass('btn-dark-green active').addClass('btn-light');
            $(this).removeClass('btn-light').addClass('btn-dark-green active');

            if (filter === 'all') {
                $('.notification-item').fadeIn();
            } else {
                $('.notification-item').hide();
                $('.notification-item[data-type="' + filter + '"]').fadeIn();
            }
        });

        // Search Logic
        $('#notifSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.notification-item').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        // Mark single notification as read
        $('.mark-read-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item');
            $.post('@Url.Action("MarkAsRead", "Notification")', { id: id }, function() {
                $item.removeClass('bg-signal-unread');
                $item.find('.signal-dot').fadeOut();
                $(this).fadeOut();
                toastr.success('Signal acknowledged');
                // Optional: update counter
                var count = parseInt($('#unreadCounter').text());
                if(count > 1) $('#unreadCounter').text((count-1) + ' Pending');
                else $('#unreadCounter').fadeOut();
            }.bind(this));
        });

        // Mark all as read
        $('#markAllReadBtn').click(function() {
            $.post('@Url.Action("MarkAllAsRead", "Notification")', function() {
                toastr.success('All signals acknowledged');
                location.reload();
            });
        });

        // Delete notification
        $('.delete-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item');
            if (confirm('Delete this intelligence signal?')) {
                $.post('@Url.Action("Delete", "Notification")', { id: id }, function() {
                    $item.fadeOut(function() { $(this).remove(); });
                    toastr.info('Signal purged');
                });
            }
        });
    </script>
}