@using SCM_System.Models.Enums
@model List<SCM_System.Models.Entities.Notification>

@{
    ViewData["Title"] = "Intelligence Feed - SCM";
    Layout = "_DashboardLayout";
    string userRole = ViewBag.UserRole ?? "User";
}

<div class="dashboard-wrapper">
    <!-- Header Section -->
    <div class="row mb-4 animate-slide-up">
        <div class="col-12">
            <div class="card bg-dark-green text-white rounded-4 shadow-premium">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="text-white mb-1 fw-bold">Intelligence Feed</h3>
                        <p class="text-white-50 mb-0 opacity-75 extra-small uppercase ls-1">Real-time platform signals & transaction alerts</p>
                    </div>
                    <div class="d-flex gap-2">
                        @if (Model.Any(n => !n.IsRead))
                        {
                            <button type="button" class="btn btn-accent-green text-dark-green rounded-pill btn-sm px-3 fw-bold border-0" id="markAllReadBtn" onclick="markAllNotificationsAsRead()">
                                <i class="fas fa-check-double me-2"></i> Mark All Read
                            </button>
                        }
                        <a asp-action="Dashboard" asp-controller="@(userRole == "Supplier" ? "Supplier" : (userRole == "WarehouseManager" || userRole == "Warehouse") ? "Warehouse" : userRole == "Admin" ? "Admin" : "Retailer")"
                           class="btn btn-white bg-opacity-20 text-white border-0 rounded-pill btn-sm px-3 fw-bold">
                            <i class="fas fa-arrow-left me-2"></i> Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var totalCount = Model.Count;
        var unreadCount = Model.Count(n => !n.IsRead);
        var successCount = Model.Count(n => n.Type == "Success" || n.Type == "Approval");
        var warningCount = Model.Count(n => n.Type == "Warning");
        var alertCount = Model.Count(n => n.Type == "Error" || n.Type == "Alert");
    }

    <!-- Filtration & Stats Bar -->
    <div class="row mb-4 animate-slide-up" style="animation-delay: 0.1s;">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex gap-2">
                        <div class="chip active filter-btn" data-filter="all">All (@totalCount)</div>
                        <div class="chip filter-btn" data-filter="Approval">Success (@successCount)</div>
                        <div class="chip filter-btn" data-filter="Warning">Warnings (@warningCount)</div>
                        <div class="chip filter-btn" data-filter="Alert">Alerts (@alertCount)</div>
                        @if (unreadCount > 0)
                        {
                            <div class="chip text-danger filter-btn" data-filter="unread">Unread (@unreadCount)</div>
                        }
                    </div>
                    <div class="search-wrapper" style="max-width: 300px; background: var(--bg-main); border-radius: 99px; padding: 4px 16px; border: 1px solid var(--border-color); display: flex; align-items: center;">
                        <i class="fas fa-search me-2 opacity-50 text-muted"></i>
                        <input type="text" id="notifSearch" class="form-control border-0 bg-transparent p-1 extra-small fw-bold" placeholder="SEARCH SIGNALS..." style="box-shadow: none; font-size: 0.65rem;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Feed -->
    <div class="row animate-slide-up" style="animation-delay: 0.2s;">
        <div class="col-12">
            <div id="notificationsList" class="d-flex flex-column gap-3">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-white dark-mode-card rounded-4 border">
                        <i class="fas fa-bell-slash fa-3x mb-3 text-muted opacity-20"></i>
                        <h5 class="fw-bold">No Signals Detected</h5>
                        <p class="text-muted extra-small">Your intelligence feed is clear.</p>
                    </div>
                }
                else
                {
                    @foreach (var note in Model.OrderByDescending(n => n.CreatedAt))
                    {
                        <div class="card notification-item-full @(note.IsRead ? "" : "unread-border") shadow-sm" 
                             data-type="@note.Type" data-read="@note.IsRead.ToString().ToLower()">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="notification-icon-large bg-faint-green">
                                            @GetIcon(note.Type)
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">@note.Title</h6>
                                            <p class="text-muted mb-0 small">@note.Message</p>
                                            <div class="mt-2 d-flex align-items-center gap-3 extra-small text-muted font-monospace">
                                                <span><i class="far fa-clock me-1"></i>@GetTimeAgo(note.CreatedAt)</span>
                                                <span><i class="fas fa-fingerprint me-1"></i>SIG-@note.Id.ToString("X4")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (!string.IsNullOrEmpty(note.ActionUrl))
                                        {
                                            <a href="@note.ActionUrl" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold extra-small">
                                                VIEW ACTION
                                            </a>
                                        }
                                        @if (!note.IsRead)
                                        {
                                            <button class="btn btn-soft-success btn-sm rounded-pill px-3 fw-bold extra-small mark-read-btn" data-id="@note.Id">
                                                MARK READ
                                            </button>
                                        }
                                        <button class="btn btn-link text-danger btn-sm p-2 delete-btn" data-id="@note.Id">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetIcon(string type)
    {
        return type switch
        {
            "Success" or "Approval" => "✅",
            "Warning" => "⚠️",
            "Finance" => "💸",
            "Order" => "🛒",
            "Delivery" => "🚚",
            "Alert" or "Error" => "📢",
            "System" => "⚙️",
            "Message" => "💬",
            _ => "ℹ️"
        };
    }

    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        if (timeSpan.TotalMinutes < 1) return "just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";
        return dateTime.ToString("MMM dd");
    }
}

@section Styles {
    <style>
        .notification-item-full {
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
            background: var(--card-bg);
            border-radius: 16px;
        }
        .notification-item-full:hover {
            transform: translateX(4px);
            border-color: var(--primary-color);
        }
        .unread-border {
            border-left: 4px solid var(--primary-color) !important;
            background: rgba(46, 156, 122, 0.02);
        }
        .notification-icon-large {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }
        .btn-soft-success {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
            border: none;
        }
        .btn-soft-success:hover {
            background: rgba(34, 197, 94, 0.2);
            color: #15803d;
        }
    </style>
}

@section Scripts {
    <script>
        $('.filter-btn').click(function() {
            var filter = $(this).data('filter');
            $('.filter-btn').removeClass('active');
            $(this).addClass('active');

            if (filter === 'all') {
                $('.notification-item-full').show();
            } else if (filter === 'unread') {
                $('.notification-item-full').hide();
                $('.notification-item-full[data-read="false"]').show();
            } else {
                $('.notification-item-full').hide();
                $('.notification-item-full[data-type="' + filter + '"]').show();
            }
        });

        $('#notifSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.notification-item-full').each(function() {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(value) > -1);
            });
        });

        $('.mark-read-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item-full');
            $.post('/Notification/MarkAsRead', { id: id }, function() {
                $item.removeClass('unread-border');
                $item.find('.mark-read-btn').fadeOut();
                toastr.success('Signal acknowledged');
            });
        });

        $('.delete-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item-full');
            if (confirm('Permanently purge this intelligence signal?')) {
                $.post('/Notification/Delete', { id: id }, function() {
                    $item.fadeOut(function() { $(this).remove(); });
                    toastr.info('Signal purged');
                });
            }
        });
    </script>
}