@model List<SCM_System.Models.Entities.Notification>

@{
    ViewData["Title"] = "Intelligence Feed - SCM";
    Layout = "_DashboardLayout";
    string userRole = ViewBag.UserRole ?? "User";
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Header Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-premium rounded-5 overflow-hidden bg-dark-green text-white">
                <div class="card-body p-5 position-relative">
                    <div class="position-relative z-index-1 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="text-white mb-1 fw-bold"><i class="fas fa-broadcast-tower text-accent-green me-3"></i>Intelligence Feed</h2>
                            <p class="text-white-50 mb-0 opacity-75">Real-time platform signals, transaction alerts, and system updates.</p>
                        </div>
                        <div class="d-flex gap-3">
                            @if (Model.Any(n => !n.IsRead))
                            {
                                <button type="button" class="btn btn-accent-green text-dark-green rounded-pill px-4 py-2 shadow-sm fw-bold border-0" id="markAllReadBtn">
                                    <i class="fas fa-check-double me-2"></i> Clear All Unread
                                </button>
                            }
                            <a asp-action="Dashboard" asp-controller="@(userRole == "Supplier" ? "Supplier" : (userRole == "WarehouseManager" || userRole == "Warehouse") ? "Warehouse" : userRole == "Admin" ? "Admin" : "Retailer")"
                               class="btn btn-white bg-opacity-10 text-white border-0 rounded-pill px-4 py-2 shadow-sm fw-bold">
                                <i class="fas fa-arrow-left me-2"></i> Back to Command Center
                            </a>
                        </div>
                    </div>
                    <!-- Subtle background decoration -->
                    <div class="position-absolute top-0 end-0 p-5 opacity-10">
                        <i class="fas fa-bell fa-10x fa-spin-slow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var totalCount = Model.Count;
        var successCount = Model.Count(n => n.Type == "Success");
        var warningCount = Model.Count(n => n.Type == "Warning");
        var errorCount = Model.Count(n => n.Type == "Error");
        var newToday = Model.Count(n => n.CreatedAt.Date == DateTime.Today);
        var successToday = Model.Count(n => n.Type == "Success" && n.CreatedAt.Date == DateTime.Today);
        var warningToday = Model.Count(n => n.Type == "Warning" && n.CreatedAt.Date == DateTime.Today);
        var errorToday = Model.Count(n => n.Type == "Error" && n.CreatedAt.Date == DateTime.Today);
    }

    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card" onclick="document.querySelector('[data-filter=\'all\']').click()">
            <div class="kpi-icon">🔔</div>
            <div class="kpi-info">
                <div class="kpi-value">@totalCount</div>
                <div class="kpi-label">Total Signals</div>
                <div class="kpi-trend up">↑ @newToday today</div>
            </div>
        </div>
        <div class="kpi-card" onclick="document.querySelector('[data-filter=\'Success\']').click()">
            <div class="kpi-icon">✅</div>
            <div class="kpi-info">
                <div class="kpi-value">@successCount</div>
                <div class="kpi-label">Success</div>
                <div class="kpi-trend up">↑ @successToday today</div>
            </div>
        </div>
        <div class="kpi-card" onclick="document.querySelector('[data-filter=\'Warning\']').click()">
            <div class="kpi-icon">⚠️</div>
            <div class="kpi-info">
                <div class="kpi-value">@warningCount</div>
                <div class="kpi-label">Warnings</div>
                <div class="kpi-trend @(warningToday > 0 ? "up" : "down")">@(warningToday > 0 ? "↑" : "↓") @warningToday today</div>
            </div>
        </div>
        <div class="kpi-card" onclick="document.querySelector('[data-filter=\'Error\']').click()">
            <div class="kpi-icon">❌</div>
            <div class="kpi-info">
                <div class="kpi-value">@errorCount</div>
                <div class="kpi-label">Errors</div>
                <div class="kpi-trend @(errorToday > 0 ? "up" : "down")">@(errorToday > 0 ? "↑" : "↓") @errorToday today</div>
            </div>
        </div>
    </div>

    <!-- Filtration & Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border px-4 filter-bar">
        <div class="filter-chips">
            <div class="filter-chip active filter-btn" data-filter="all">All</div>
            <div class="filter-chip filter-btn" data-filter="Success">Success</div>
            <div class="filter-chip filter-btn" data-filter="Warning">Warnings</div>
            <div class="filter-chip filter-btn" data-filter="Error">Errors</div>
            <div class="filter-chip filter-btn" data-filter="Info">System</div>
        </div>
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" id="notifSearch" placeholder="Search signals...">
        </div>
    </div>

    <!-- Main Feed -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                <h5 class="fw-bold text-dark-green mb-0">Signal History</h5>
                <span class="text-muted small fw-bold">Showing <span id="resultCount">@Model.Count</span> results</span>
            </div>

            <div id="notificationsList">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-white rounded-5 shadow-premium border">
                        <div class="bg-faint-green text-dark-green rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                            <i class="fas fa-bell-slash fa-3x opacity-25"></i>
                        </div>
                        <h4 class="fw-bold text-dark-green">Zero Signals Detected</h4>
                        <p class="text-muted small fw-bold opacity-50">Your intelligence feed is currently synchronized.</p>
                    </div>
                }
                else
                {
                    @foreach (var notification in Model)
                    {
                        <div class="signal-card notification-item @(!notification.IsRead ? "bg-signal-unread" : "")" data-id="@notification.Id" data-type="@notification.Type" style="display: block;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-3">
                                    <div class="signal-icon @notification.Type">
                                        @if (notification.Type == "Success") { <i class="fas fa-check-circle"></i> }
                                        else if (notification.Type == "Error") { <i class="fas fa-exclamation-circle"></i> }
                                        else if (notification.Type == "Warning") { <i class="fas fa-exclamation-triangle"></i> }
                                        else { <i class="fas fa-info-circle"></i> }
                                    </div>
                                    <div>
                                        <div class="signal-title">@notification.Title</div>
                                        <div class="signal-message">@notification.Message</div>
                                        <div class="signal-date">
                                            <i class="far fa-calendar-alt"></i>
                                            @notification.CreatedAt.ToString("MMM dd, yyyy")
                                            <span class="mx-2">•</span>
                                            <i class="far fa-clock"></i>
                                            @GetTimeAgo(notification.CreatedAt)
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex flex-column align-items-end gap-3">
                                    @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                    {
                                        <button class="btn-review" onclick="location.href='@notification.ActionUrl'">
                                            <i class="fas fa-arrow-right"></i> Review Now
                                        </button>
                                    }
                                    <div class="d-flex gap-2">
                                        @if (!notification.IsRead)
                                        {
                                            <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold extra-small mark-read-btn" data-id="@notification.Id">
                                                MARK READ
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger rounded-circle p-2 delete-btn" data-id="@notification.Id" style="width: 32px; height: 32px; display:flex; align-items:center; justify-content:center;">
                                            <i class="fas fa-trash-alt extra-small"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd");
    }
}

@section Styles {
    <style>
        :root {
            --dark-green: #1a3d31;
            --accent-green: #4BC0A0; /* Mint Green for better contrast */
            --faint-green: #f2f6f6;
            --bg-card: #FFFFFF;
            --border: #E2E8F0;
            --text-primary: #0B3B2F;
            --text-muted: #7C8F86;
        }

        /* Dark Mode - Fix White Backgrounds */
        .dark-mode {
            --bg-card: #1A1F1D;
            --border: #2A3530;
            --text-primary: #EDEDED;
            --text-muted: #9EABA5;
            --bg-color: #0A0F0D;
        }

        .dark-mode .container-fluid {
            background-color: #0A0F0D;
        }

        .dark-mode .signal-card,
        .dark-mode .kpi-card,
        .dark-mode .filter-bar {
            background-color: #1A1F1D !important;
            border-color: #2A3530 !important;
        }

        .dark-mode .signal-card:hover {
            background-color: #252B28 !important;
        }

        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border-color: #2E9C7A;
        }

        .kpi-icon {
            font-size: 24px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(46, 156, 122, 0.1);
            border-radius: 12px;
        }

        .kpi-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1;
        }

        .kpi-label {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .kpi-trend {
            font-size: 11px;
            font-weight: 600;
            margin-top: 4px;
        }

        .kpi-trend.up { color: #2E9C7A; }
        .kpi-trend.down { color: #E05A5A; }

        /* Signal Cards */
        .signal-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            border: 1px solid var(--border);
            transition: all 0.2s ease;
        }

        .signal-card:hover {
            transform: translateX(4px);
            border-left: 3px solid #2E9C7A;
        }

        /* Signal Type Indicators */
        .signal-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .signal-icon.Success { background: rgba(46, 156, 122, 0.15); color: #2E9C7A; }
        .signal-icon.Warning { background: rgba(230, 126, 34, 0.15); color: #E67E22; }
        .signal-icon.Error { background: rgba(224, 90, 90, 0.15); color: #E05A5A; }
        .signal-icon.Info { background: rgba(91, 143, 249, 0.15); color: #5B8FF9; }

        .signal-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }

        .signal-message {
            font-size: 13px;
            color: var(--text-muted);
            margin: 6px 0;
        }

        .signal-date {
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Action Button */
        .btn-review {
            background: #2E9C7A;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-review:hover {
            background: #247A5E;
            transform: scale(1.02);
            color: white;
        }

        .dark-mode .btn-review {
            background: #3BAE86;
        }

        /* Filter Chips */
        .filter-chips {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 16px 0;
        }

        .filter-chip {
            padding: 8px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text-primary);
        }

        .filter-chip:hover {
            border-color: #2E9C7A;
            color: #2E9C7A;
        }

        .filter-chip.active {
            background: #2E9C7A;
            border-color: #2E9C7A;
            color: white;
        }

        .dark-mode .filter-chip.active {
            background: #4BC0A0;
            color: #0A0F0D;
        }

        /* Search Bar */
        .search-wrapper {
            display: flex;
            align-items: center;
            background: var(--bg-card);
            border-radius: 40px;
            padding: 0 18px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 400px;
        }

        .search-wrapper i {
            color: var(--text-muted);
            margin-right: 12px;
        }

        .search-wrapper input {
            flex: 1;
            padding: 10px 0;
            background: transparent;
            border: none;
            color: var(--text-primary);
            outline: none;
        }

        .search-wrapper input::placeholder {
            color: var(--text-muted);
        }

        .ls-1 { letter-spacing: 1px; }
        .extra-small { font-size: 0.65rem; }
        .uppercase { text-transform: uppercase; }
        
        .notification-item.bg-signal-unread {
            background-color: rgba(46, 156, 122, 0.05);
        }
        .dark-mode .notification-item.bg-signal-unread {
            background-color: rgba(75, 192, 160, 0.05);
        }
    </style>
}

@section Scripts {
    <script>
        // Filtration Logic
        $('.filter-btn').click(function() {
            var filter = $(this).data('filter');
            $('.filter-btn').removeClass('active');
            $(this).addClass('active');

            if (filter === 'all') {
                $('.notification-item').show();
            } else {
                $('.notification-item').hide();
                $('.notification-item[data-type="' + filter + '"]').show();
            }
            updateResultCount();
        });

        // Search Logic
        $('#notifSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            var activeFilter = $('.filter-btn.active').data('filter');
            
            $('.notification-item').each(function() {
                var matchesSearch = $(this).text().toLowerCase().indexOf(value) > -1;
                var matchesFilter = activeFilter === 'all' || $(this).data('type') === activeFilter;
                
                $(this).toggle(matchesSearch && matchesFilter);
            });
            updateResultCount();
        });

        function updateResultCount() {
            var count = $('.notification-item:visible').length;
            $('#resultCount').text(count);
        }

        // Mark single notification as read
        $('.mark-read-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item');
            $.post('@Url.Action("MarkAsRead", "Notification")', { id: id }, function() {
                $item.removeClass('bg-signal-unread');
                $(this).fadeOut();
                toastr.success('Signal acknowledged');
            }.bind(this));
        });

        // Mark all as read
        $('#markAllReadBtn').click(function() {
            $.post('@Url.Action("MarkAllAsRead", "Notification")', function() {
                toastr.success('All signals acknowledged');
                location.reload();
            });
        });

        // Delete notification
        $('.delete-btn').click(function() {
            var id = $(this).data('id');
            var $item = $(this).closest('.notification-item');
            if (confirm('Delete this intelligence signal?')) {
                $.post('@Url.Action("Delete", "Notification")', { id: id }, function() {
                    $item.fadeOut(function() { $(this).remove(); });
                    toastr.info('Signal purged');
                });
            }
        });
    </script>
}